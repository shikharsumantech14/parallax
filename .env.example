# Parallax — environment template (committed)
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and stays on your machine.

# Anthropic API key for the agent pipeline runner (scripts/pipeline.ts) AND the
# social pipelines (scripts/evergreen, scripts/reactive — social-writer / Haiku
# classifier). Get one from: https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# ── Social pipelines (scripts/evergreen + scripts/reactive) ───────────────────
# The social pipelines write the social_posts approval queue + the promotions
# ledger in the SAME Supabase project the app/ subdomain uses. They need the
# project URL + the service-role key (server/cron only — never client-exposed).
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi-replace-me

# Canonical publication URL — used to build the issue link posted in the FIRST
# REPLY (native-first; in-body links are reach-suppressed on X).
PUBLIC_SITE_URL=https://parallaxlens.com

# ── Posting (scripts/social/post.ts — the approved→posted hop) ────────────────
# POSTER_BACKEND: 'bluesky' (free, direct via AT Protocol) or 'typefully'
# (scheduler that holds the X/LinkedIn/Threads relationship — avoids X's
# pay-per-use $0.20/link charge). Default: bluesky.
# POSTER_BACKEND=bluesky
#
# Bluesky (create an APP PASSWORD in Settings → App Passwords — not your login):
# BLUESKY_IDENTIFIER=parallaxlens.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
#
# Typefully (Settings → API). VERIFY the endpoint/auth in scripts/lib/poster.ts
# against the current Typefully API docs before relying on it.
# TYPEFULLY_API_KEY=

# ── P2/P3 RAG (scripts/rag) — fill when RAG lands ─────────────────────────────
# Voyage AI embeddings + reranker (voyage-4). https://dash.voyageai.com
# VOYAGE_API_KEY=

# Phase 5 (future — email / analytics)
# RESEND_API_KEY=
# BUTTONDOWN_API_KEY=
# PLAUSIBLE_DOMAIN=
