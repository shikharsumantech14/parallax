# Parallax — environment template (committed)
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and stays on your machine.

# Anthropic API key for the agent pipeline runner (scripts/pipeline.ts —
# `npm run pipeline:*`). Get one from: https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# Jev (TypeSafe's decision model) for the claim pre-pass before the verifier
# and the quiz grade after each panel (docs/COST-PLAN.md CP-06, scripts/README.md).
# Optional: with no key the pipeline skips both with a warning and runs on.
# The OpenRouter key, read by the default provider.
JEV_API_KEY=
# Provider switch: openrouter (default), typesafe, or compatible.
# JEV_PROVIDER=openrouter
# The TypeSafe key, read only when JEV_PROVIDER=typesafe.
# TYPESAFE_API_KEY=
# A compatible server's root (/v1/systemone is appended), when JEV_PROVIDER=compatible.
# JEV_BASE_URL=
# The "confident" line, 0.90 by default: a Jev answer below it routes to the LLM.
# JEV_THRESHOLD=0.90

# Canonical publication URL — og:image, share links, the story-mode head tags
# and every absolute link the SSR routes build.
PUBLIC_SITE_URL=https://parallaxlens.com

# ── Reader-account surfaces (merged from app/ on 2026-09-06) ─────────────────
# These drive /login, /account/welcome, /dashboard, /admin/* and /api/*. They
# are RUNTIME values for the SSR routes — the build does not need them, which
# is why `npm run build` works on a machine without them.

# From Supabase project Settings → API. The URL and the anon key are
# client-exposed and safe to publish. The service-role key is server-only (the
# admin client behind the moderation queue and the account routes) and must
# never reach a browser.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi-replace-me
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi-replace-me

# From resend.com → API Keys. Transactional email (magic links, confirmations).
RESEND_API_KEY=re_replace_me

# Same-origin since the merge. app.parallaxlens.com is kept as an ALIAS, so the
# old absolute value still resolves — the publication's islands may still use
# it until they are repointed to relative paths.
PUBLIC_APP_URL=https://parallaxlens.com

# Comma-separated emails granted moderation access at /admin/*. Lowercased
# before compare.
ADMIN_EMAILS=

# Local dev only. When set, `astro dev` treats every request as this signed-in
# user, skipping magic-link/OAuth so auth-gated pages open locally. NO EFFECT
# IN PRODUCTION: the bypass is gated on import.meta.env.DEV, which Vite inlines
# as `false` under `astro build`, so it is dead-code-eliminated from the deploy.
# DEV_ADMIN_EMAIL=

# Future (email / analytics)
# BUTTONDOWN_API_KEY=
# PLAUSIBLE_DOMAIN=

# Retired 2026-09-27 with the content engine (docs/archive/CONTENT-ENGINE.md):
# VOYAGE_API_KEY, POSTER_BACKEND, BLUESKY_IDENTIFIER, BLUESKY_APP_PASSWORD,
# TYPEFULLY_API_KEY. Nothing reads them any more — remove them from .env.local
# and from the GitHub repository secrets.
