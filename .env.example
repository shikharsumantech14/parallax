# Parallax — environment template (committed)
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and stays on your machine.

# Anthropic API key for the agent pipeline runner (scripts/pipeline.ts).
# Get one from: https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# fal.ai API key for the visual generator (scripts/generate-visual.mjs).
# Used by the illustrator pipeline phase to call Flux 1.1 Pro (~$0.04/image).
# Get one from: https://fal.ai/dashboard/keys
# Pay-as-you-go; daily $2.00 cap is enforced inside the generator script.
FAL_KEY=fal-replace-me

# Phase 5 (future — email / analytics)
# RESEND_API_KEY=
# BUTTONDOWN_API_KEY=
# PLAUSIBLE_DOMAIN=
