# Parallax app subdomain — environment template
#
# Copy to .env.local in this directory and fill real values.
# Or set them on the parent .env.local — Astro reads from .env.local
# in the project root (which is this app/ directory when running here).

# ── Supabase ──────────────────────────────────────────────────────────────────
# From Supabase project Settings → API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi-replace-me

# SERVER ONLY — never sent to the client. Used for admin operations
# (account deletion, cron jobs, migrations from this app's runtime).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi-replace-me

# ── Resend ────────────────────────────────────────────────────────────────────
# From resend.com → API Keys
RESEND_API_KEY=re_replace_me

# ── URLs ──────────────────────────────────────────────────────────────────────
# Production
PUBLIC_APP_URL=https://app.parallaxlens.com
PUBLIC_SITE_URL=https://parallaxlens.com

# Local dev (uncomment when running both projects on localhost)
# PUBLIC_APP_URL=http://localhost:4322
# PUBLIC_SITE_URL=http://localhost:4321

# ── Admin access ──────────────────────────────────────────────────────────────
# Comma-separated list of emails granted moderation access. Any signed-in user
# whose email matches gets access to /admin/comments. Lowercased before compare.
# Example: ADMIN_EMAILS=editor@parallaxlens.com,founder@parallaxlens.com
ADMIN_EMAILS=

# ── Local dev only ──────────────────────────────────────────────────────────────
# DEV_ADMIN_EMAIL: when set, a local `astro dev` session treats every request as a
# signed-in user with this email — skipping the magic-link / OAuth flow so you can
# open auth-gated pages (e.g. /admin/comments) locally. Set it to an address that
# is also in ADMIN_EMAILS to get admin access.
# NO EFFECT IN PRODUCTION: the bypass in src/middleware.ts is gated on
# import.meta.env.DEV, which Vite inlines as `false` under `astro build`, so the
# block is dead-code-eliminated from the deployed bundle. Leave unset unless you
# are locally verifying auth-gated UI.
# DEV_ADMIN_EMAIL=
