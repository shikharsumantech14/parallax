# Parallax app subdomain — environment template
#
# Copy to .env.local in this directory and fill real values.
# Or set them on the parent .env.local — Astro reads from .env.local
# in the project root (which is this app/ directory when running here).

# ── Supabase ──────────────────────────────────────────────────────────────────
# From Supabase project Settings → API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi-replace-me

# SERVER ONLY — never sent to the client. Used for admin operations
# (account deletion, cron jobs, migrations from this app's runtime).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi-replace-me

# ── Resend ────────────────────────────────────────────────────────────────────
# From resend.com → API Keys
RESEND_API_KEY=re_replace_me

# ── URLs ──────────────────────────────────────────────────────────────────────
# Production
PUBLIC_APP_URL=https://app.parallaxlens.com
PUBLIC_SITE_URL=https://parallaxlens.com

# Local dev (uncomment when running both projects on localhost)
# PUBLIC_APP_URL=http://localhost:4322
# PUBLIC_SITE_URL=http://localhost:4321
