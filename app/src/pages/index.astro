---
import AppLayout from '../layouts/AppLayout.astro';

/**
 * app.parallaxlens.com root.
 *
 * Logged in → /dashboard
 * Logged out → friendly landing with "Sign in" CTA
 */

const { user } = Astro.locals;

if (user) {
  return Astro.redirect('/dashboard');
}

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://parallaxlens.com';
---

<AppLayout title="Your reader account">
  <p class="eyebrow">Your account</p>
  <h1>Open a <em>shelf</em> for what you read.</h1>
  <p class="dek">
    Free, no ads, no trackers. One sign-in to save issues across the six topic
    worlds, follow the topics you care about, and pick up where you left off.
  </p>

  <div style="margin-top: var(--gap-md); display: flex; gap: 12px; flex-wrap: wrap;">
    <a class="btn" href="/login">Sign in</a>
    <a class="btn btn--ghost" href={siteUrl}>Browse the publication →</a>
  </div>

  <hr />

  <p class="eyebrow">What an account unlocks</p>
  <div class="row">
    <span class="row__label">Save for later</span>
    <span class="row__value">Bookmark any issue to your shelf</span>
  </div>
  <div class="row">
    <span class="row__label">Newsletter</span>
    <span class="row__value">Per-issue or weekly, your call</span>
  </div>
  <div class="row">
    <span class="row__label">Reading history</span>
    <span class="row__value">Only you can see it; never sold</span>
  </div>
  <div class="row">
    <span class="row__label">Delete any time</span>
    <span class="row__value">30-day hard delete commitment</span>
  </div>

  <a class="app-back" href={siteUrl}>← Back to the publication</a>
</AppLayout>
