---
import AppLayout from '../../layouts/AppLayout.astro';
import { requireUser } from '../../lib/auth';
import { isAdmin } from '../../lib/admin';
import { adminClient } from '../../lib/supabase';

/**
 * Social post approval queue (admin-only).
 *
 * Server-renders the social_posts list for the selected status via the
 * service-role client. Filtering is plain links (?status=…) — zero JS. The only
 * client JS is the Approve/Reject/Reset handler, which POSTs to
 * /api/admin/social/<id> and removes the card on success.
 *
 * Mirrors /admin/comments. Posts are generated by the evergreen + reactive
 * pipelines (scripts/) and start status='pending'; nothing posts without a human
 * approve here. Guard: signed in (→ /login) AND on ADMIN_EMAILS (→ /dashboard).
 */

const user = requireUser(Astro);
if (!isAdmin(user)) {
  return Astro.redirect('/dashboard');
}

const VALID_STATUSES = ['pending', 'approved', 'posted', 'rejected'] as const;
type Status = (typeof VALID_STATUSES)[number];

const statusParam = Astro.url.searchParams.get('status') ?? 'pending';
const status: Status = (VALID_STATUSES as readonly string[]).includes(statusParam)
  ? (statusParam as Status)
  : 'pending';

const admin = adminClient();
const { data: rows, error } = await admin
  .from('social_posts')
  .select(
    'id, issue_id, topic, platform, kind, variant, angle, body, thread, link_url, alt_text, image_ref, images, status, scheduled_at, permalink, error_log, created_at',
  )
  .eq('status', status)
  .order('created_at', { ascending: status === 'pending' })
  .limit(200);

if (error) {
  console.error('[admin/social] load failed:', error.message);
}

type PostRow = {
  id: string;
  issue_id: string;
  topic: string;
  platform: string;
  kind: string;
  variant: string;
  angle: string | null;
  body: string;
  thread: string[] | null;
  link_url: string | null;
  alt_text: string | null;
  image_ref: string | null;
  images: Record<string, { ref: string; alt?: string }> | null;
  status: string;
  scheduled_at: string | null;
  permalink: string | null;
  error_log: string | null;
  created_at: string;
};

const items = (rows ?? []) as unknown as PostRow[];
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://parallaxlens.com';

function fmtDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });
}

const TABS: { key: Status; label: string }[] = [
  { key: 'pending', label: 'Pending' },
  { key: 'approved', label: 'Approved' },
  { key: 'posted', label: 'Posted' },
  { key: 'rejected', label: 'Rejected' },
];

const itemNoun = items.length === 1 ? 'post' : 'posts';
---

<AppLayout
  title="Social queue"
  description="Social post approval queue."
  eyebrow="PARALLAX · SOCIAL"
>
  <p class="eyebrow">Admin</p>
  <h1>Social queue</h1>
  <p class="dek">
    Review pipeline-generated posts. Approve to release them to the scheduler, or
    reject what's off-brand. Nothing posts without your approval.
  </p>

  <nav class="sq-tabs" aria-label="Filter by status">
    {
      TABS.map((t) => (
        <a
          class={`sq-tab${t.key === status ? ' sq-tab--active' : ''}`}
          href={`/admin/social?status=${t.key}`}
          aria-current={t.key === status ? 'page' : undefined}
        >
          {t.label}
        </a>
      ))
    }
  </nav>

  {
    error && (
      <div class="notice notice--err">
        Could not load the queue. Check the server logs.
      </div>
    )
  }

  <p class="sq-count" id="sq-count" data-count={items.length}>
    {items.length} {itemNoun}
  </p>

  {
    items.length === 0 ? (
      <p class="empty">
        {status === 'pending'
          ? 'The queue is clear. Nothing waiting.'
          : `No ${status} posts.`}
      </p>
    ) : (
      <ul class="sq-list" role="list" id="sq-list">
        {items.map((row) => (
          <li class={`sq-card sq-card--${row.topic}`} data-id={row.id}>
            <div class="sq-card__head">
              <span class="sq-badges">
                <span class="sq-badge sq-badge--topic">{row.topic}</span>
                <span class="sq-badge">{row.kind}</span>
                <span class="sq-badge">{row.variant}</span>
                {row.angle && <span class="sq-badge sq-badge--angle">{row.angle}</span>}
                <span class="sq-badge">{row.platform}</span>
              </span>
              <span class="sq-card__date">{fmtDate(row.created_at)}</span>
            </div>

            <div class="sq-card__meta">
              <a
                class="sq-card__issue"
                href={`${siteUrl}/issues/${row.issue_id}/`}
                target="_blank"
                rel="noreferrer"
              >
                {row.issue_id}
              </a>
              <span class="sq-chars">{row.body.length} chars</span>
            </div>

            <p class="sq-body">{row.body}</p>

            {
              row.thread && row.thread.length > 0 && (
                <ol class="sq-thread">
                  {row.thread.map((t) => (
                    <li class="sq-thread__item">{t}</li>
                  ))}
                </ol>
              )
            }

            {
              row.link_url && (
                <p class="sq-link">
                  ↳ link (posts last):{' '}
                  <a href={row.link_url} target="_blank" rel="noreferrer">
                    {row.link_url}
                  </a>
                </p>
              )
            }

            {
              row.images && Object.keys(row.images).length > 0 ? (
                <div class="sq-imgs">
                  {Object.entries(row.images)
                    .sort((a, b) => Number(a[0]) - Number(b[0]))
                    .map(([idx, img]) => (
                      <figure class="sq-fig">
                        <img class="sq-img" src={img.ref} alt={img.alt ?? ''} loading="lazy" />
                        <figcaption class="sq-figcap">post {Number(idx) + 1}</figcaption>
                      </figure>
                    ))}
                </div>
              ) : row.image_ref ? (
                <img class="sq-img" src={row.image_ref} alt={row.alt_text ?? ''} loading="lazy" />
              ) : (
                <p class="sq-noimg">No cards yet{row.alt_text ? ` · alt: ${row.alt_text}` : ''}</p>
              )
            }

            {row.error_log && <p class="sq-errlog">⚠ {row.error_log}</p>}
            {
              row.permalink && (
                <p class="sq-permalink">
                  <a href={row.permalink} target="_blank" rel="noreferrer">{row.permalink}</a>
                </p>
              )
            }

            <div class="sq-actions">
              {status !== 'approved' && status !== 'posted' && (
                <button class="btn btn--ghost sq-act" data-action="approve" data-id={row.id} type="button">
                  Approve
                </button>
              )}
              {status !== 'rejected' && status !== 'posted' && (
                <button class="btn btn--ghost sq-act" data-action="reject" data-id={row.id} type="button">
                  Reject
                </button>
              )}
              {status !== 'pending' && status !== 'posted' && (
                <button class="btn btn--ghost sq-act" data-action="reset" data-id={row.id} type="button">
                  Reset to pending
                </button>
              )}
            </div>

            <p class="sq-error" data-error-for={row.id} aria-live="polite" hidden />
          </li>
        ))}
      </ul>
    )
  }

  <a class="app-back" href="/dashboard">← Back to dashboard</a>
</AppLayout>

<style>
  .sq-tabs {
    display: inline-flex;
    gap: 2px;
    background: color-mix(in oklab, var(--ink) 6%, transparent);
    border-radius: var(--r-pill);
    padding: 2px;
    margin: var(--gap-md) 0 var(--gap-sm);
    flex-wrap: wrap;
  }
  .sq-tab {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding: 8px 16px;
    border-radius: var(--r-pill);
    transition: color var(--t-quick) var(--ease), background var(--t-quick) var(--ease);
  }
  .sq-tab:hover { color: var(--ink); }
  .sq-tab--active {
    color: var(--ink);
    background: var(--paper);
    box-shadow: 0 1px 3px -1px color-mix(in oklab, var(--ink) 30%, transparent);
  }

  .sq-count {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--gap-sm);
  }

  .sq-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .sq-card {
    border: 1px solid var(--rule);
    background: var(--paper);
    padding: 18px 20px;
    border-radius: var(--r-tile);
    border-left: 3px solid var(--accent);
    box-shadow:
      0 1px 0 0 color-mix(in oklab, var(--ink) 6%, transparent),
      0 18px 40px -28px color-mix(in oklab, var(--ink) 40%, transparent);
    transition: box-shadow var(--t-soft) var(--ease), transform var(--t-soft) var(--ease);
  }
  .sq-card:hover {
    transform: translateY(-2px);
    box-shadow:
      0 1px 0 0 color-mix(in oklab, var(--ink) 8%, transparent),
      0 28px 56px -28px color-mix(in oklab, var(--ink) 50%, transparent);
  }

  .sq-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .sq-badges { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .sq-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--rule);
    padding: 2px 9px;
    border-radius: var(--r-pill);
  }
  .sq-badge--topic { color: var(--ink); border-color: var(--accent); }
  .sq-badge--angle { font-style: italic; }
  .sq-card__date {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .sq-card__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 8px 0 14px;
  }
  .sq-card__issue {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    word-break: break-all;
  }
  .sq-card__issue:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .sq-chars {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sq-body {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
    white-space: pre-wrap;
    max-width: none;
  }

  .sq-thread {
    margin: 0 0 12px;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sq-thread__item {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-soft);
    white-space: pre-wrap;
  }

  .sq-link {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    word-break: break-all;
  }
  .sq-link a { color: var(--ink-soft); }

  .sq-img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--r-card);
    border: 1px solid var(--rule);
    margin: 0 0 14px;
  }
  .sq-imgs { display: flex; flex-wrap: wrap; gap: 12px; margin: 0 0 14px; }
  .sq-fig { flex: 1 1 320px; margin: 0; }
  .sq-fig .sq-img { margin: 0 0 4px; }
  .sq-figcap {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sq-noimg,
  .sq-errlog,
  .sq-permalink {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    word-break: break-all;
  }
  .sq-errlog { color: var(--danger); }

  .sq-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .sq-actions .btn { padding: 9px 18px; font-size: 13px; }

  .sq-error {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--danger);
  }
</style>

<script>
  /**
   * Approve/Reject/Reset. Delegated click handler: each button POSTs to
   * /api/admin/social/<id> and, on success, removes the card + updates the count.
   */
  const list = document.getElementById('sq-list');
  const countEl = document.getElementById('sq-count');

  const updateCount = (delta: number) => {
    if (!countEl) return;
    const cur = parseInt(countEl.dataset.count ?? '0', 10) || 0;
    const next = Math.max(0, cur + delta);
    countEl.dataset.count = String(next);
    countEl.textContent = `${next} ${next === 1 ? 'post' : 'posts'}`;
  };

  list?.addEventListener('click', async (ev) => {
    const target = ev.target as HTMLElement;
    const btn = target.closest('.sq-act') as HTMLButtonElement | null;
    if (!btn) return;

    const id = btn.dataset.id;
    const action = btn.dataset.action;
    if (!id || !action) return;

    const card = btn.closest('.sq-card') as HTMLElement | null;
    const errEl = card?.querySelector('.sq-error') as HTMLElement | null;
    const buttons = Array.from(card?.querySelectorAll('.sq-act') ?? []) as HTMLButtonElement[];

    buttons.forEach((b) => (b.disabled = true));
    if (errEl) {
      errEl.hidden = true;
      errEl.textContent = '';
    }

    try {
      const res = await fetch(`/api/admin/social/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action }),
      });

      if (res.status === 401) {
        window.location.href = '/login?next=/admin/social';
        return;
      }

      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (!res.ok || !data.ok) {
        throw new Error(data.error || `Request failed (${res.status}).`);
      }

      if (card) {
        card.style.transition = 'opacity 0.15s ease';
        card.style.opacity = '0';
        window.setTimeout(() => {
          card.remove();
          if (list && list.children.length === 0) {
            const empty = document.createElement('p');
            empty.className = 'empty';
            empty.textContent = 'The queue is clear. Nothing waiting.';
            list.replaceWith(empty);
          }
        }, 150);
      }
      updateCount(-1);
    } catch (err) {
      buttons.forEach((b) => (b.disabled = false));
      if (errEl) {
        errEl.hidden = false;
        errEl.textContent = err instanceof Error ? err.message : 'Action failed.';
      }
    }
  });
</script>
