---
import AppLayout from '../layouts/AppLayout.astro';
import { safeNextPath } from '../lib/auth';

/**
 * Login page.
 *
 * Two paths in:
 *   1. Continue with Google (OAuth)
 *   2. Get a sign-in link by email (magic link)
 *
 * Both initiate from client-side JS using the browser Supabase client,
 * which knows how to handle PKCE and the redirect dance.
 *
 * If a `next` query param is set (and safe), we round-trip it through
 * the OAuth flow so the user lands where they were trying to go.
 */

const { user } = Astro.locals;

// If already logged in, skip the login page entirely.
if (user) {
  const next = safeNextPath(Astro.url.searchParams.get('next'), '/dashboard');
  return Astro.redirect(next);
}

const next = safeNextPath(Astro.url.searchParams.get('next'), '/dashboard');
---

<AppLayout title="Sign in" description="Sign in to your Parallax reader account.">
  <p class="eyebrow">Sign in</p>
  <h1>Open your <em>shelf</em>.</h1>
  <p class="dek">
    One sign-in to save issues, follow topics you care about, and pick up
    reading where you left off.
  </p>

  <div class="field">
    <button id="btn-google" class="btn btn--ghost btn--block" type="button">
      <svg class="btn__icon" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z"/>
        <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
        <path fill="#FBBC05" d="M3.964 10.706A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.706V4.962H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.038l3.007-2.332z"/>
        <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.962L3.964 7.294C4.672 5.167 6.656 3.58 9 3.58z"/>
      </svg>
      Continue with Google
    </button>
  </div>

  <div class="divider">or</div>

  <form id="magic-form" novalidate>
    <div class="field">
      <label for="email">Sign-in link by email</label>
      <input
        id="email"
        name="email"
        type="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
      <p class="field__hint">
        We'll send a one-tap link. No password to remember.
      </p>
    </div>

    <button id="btn-magic" class="btn btn--block" type="submit">
      Send the link
    </button>
  </form>

  <div id="notice" class="notice notice--info" style="display: none;"></div>

  <a class="app-back" href={import.meta.env.PUBLIC_SITE_URL ?? 'https://parallaxlens.com'}>
    ← Back to the publication
  </a>

  <span id="next-value" data-next={next} hidden></span>
</AppLayout>

<script>
  // Bundled by Astro/Vite at build time. PUBLIC_* env vars are inlined.
  import { createBrowserClient } from '@supabase/ssr';

  const supabase = createBrowserClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );

  const appUrl =
    import.meta.env.PUBLIC_APP_URL ?? `${window.location.protocol}//${window.location.host}`;
  const next = document.getElementById('next-value')?.dataset.next ?? '/dashboard';

  const noticeEl = document.getElementById('notice');
  const showNotice = (text: string, kind: 'info' | 'ok' | 'err') => {
    if (!noticeEl) return;
    noticeEl.textContent = text;
    noticeEl.className =
      'notice ' +
      (kind === 'err' ? 'notice--err' : kind === 'ok' ? 'notice--ok' : 'notice--info');
    (noticeEl as HTMLElement).style.display = 'block';
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;

  const setBusy = (busy: boolean) => {
    const ids = ['btn-google', 'btn-magic', 'email'];
    for (const id of ids) {
      const el = $(id) as HTMLButtonElement | HTMLInputElement | null;
      if (el) el.disabled = busy;
    }
  };

  // ── Google OAuth ──
  $('btn-google')?.addEventListener('click', async () => {
    setBusy(true);
    showNotice('Redirecting to Google…', 'info');
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo: `${appUrl}/auth/callback?next=${encodeURIComponent(next)}`,
      },
    });
    if (error) {
      showNotice(`Couldn’t start Google sign-in: ${error.message}`, 'err');
      setBusy(false);
    }
  });

  // ── Magic link ──
  $('magic-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = $<HTMLInputElement>('email');
    const email = emailInput?.value.trim() ?? '';
    if (!email) {
      showNotice('Please enter your email address.', 'err');
      return;
    }
    setBusy(true);
    showNotice('Sending sign-in link…', 'info');
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: {
        emailRedirectTo: `${appUrl}/auth/callback?next=${encodeURIComponent(next)}`,
        shouldCreateUser: true,
      },
    });
    if (error) {
      showNotice(`Couldn’t send the link: ${error.message}`, 'err');
      setBusy(false);
      return;
    }
    showNotice(
      'Check your inbox. The link signs you in instantly and expires in 60 minutes.',
      'ok',
    );
    const btn = $<HTMLButtonElement>('btn-magic');
    if (btn) btn.textContent = 'Sent — check your email';
  });
</script>
