---
/**
 * Viz3DRuntime — mounts the lazy WebGL runtime once per page.
 *
 * This is a BUNDLED module <script> (not is:inline) so Vite processes the
 * `import('three')` inside runtime.ts into a separate code-split chunk that
 * only downloads when a [data-viz3d] mount first scrolls into view. If a page
 * has no 3D mounts, runtime.initViz3D() returns immediately and three is never
 * fetched. Render onceper page (the layouts include it on issue pages).
 *
 * See src/scripts/viz3d/runtime.ts + scenes/ (per-scene lazy registry).
 */
---
<script>
  import { initViz3D } from '../../scripts/viz3d/runtime';
  import { builders } from '../../scripts/viz3d/scenes/index';
  initViz3D(builders);
</script>
