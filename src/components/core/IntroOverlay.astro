---
/**
 * IntroOverlay — the first-visit walkthrough on Home (the Intro, Intro-Phone
 * and Intro-Entry boards, BRIEF-8). A dialog rises over the drawn page, the
 * page behind blurs under a paper scrim, and five scenes play themselves:
 *
 *   1 What Parallax is      the house medallion built from its parts, two
 *                           eyes and their sightlines, the promise
 *   2 What you can do here  the reading system in miniature (the cover
 *                           issue's two cue sentences beside the figure they
 *                           light, the 1,330 counter), then the six desks
 *   3 What to do first      three step cards on the path rail: read an
 *                           issue, save it, tell us how it landed
 *   4 What members get      the Shelf in miniature and the four beta facts
 *   5 Where to start        the six desks as links and the three choices
 *
 * Every number is the repo's own: the cover issue's figure (`introFigure()`
 * in src/lib/stage.ts) and its title, number and read time; each shelf tile is
 * an issue's `cover` number and label; the desk counts, the issue count and
 * the source count from the published collection; the names and registers
 * are DESK_COPY's and DESK_REGISTER's; the reactions are ReactionsBar's
 * (src/lib/reactions.ts); the beta facts are the Subscribe page's. The path's
 * progress (two read, 60%, 38%) is the board's sample of a member's shelf.
 *
 * SHOWN ONCE per browser: `localStorage` `px_intro_v3` (v2 was the three-scene
 * intro of 2026-09-30; the bump shows this one once to readers who saw that),
 * set when it opens. `?intro=1` reopens it, `?intro=0` suppresses it.
 *
 * THE CLOCK. Each scene holds for HOLD ms (its build plus time to read) while
 * its stepper dot, a pill, fills; the fill is a CSS animation and its end
 * advances the scene, so hover inside the dialog (fine pointers), keyboard
 * focus on one of its controls, or Pause stops the clock in CSS alone, and it
 * resumes where it stopped. Scene 5 waits for a choice. Escape closes, the
 * arrow keys step, any dot jumps. Scene 2 lights cue 1 and then cue 2 once.
 *
 * FALLBACK. A native <dialog>, closed in the HTML: no JS, no overlay, the page
 * is the page. Each scene's markup is its final state; showing a scene
 * dispatches `px:build` on it and the one build island (src/scripts/build.ts,
 * LENS §6.4) builds it. Reduced motion: the dialog opens with every scene
 * final, no clock, no cue autoplay; Back, Next and the dots still step.
 * Print: nothing.
 *
 * Script: one is:inline island, no library (size in .claude/rules/js-budget.md).
 * Prefix: px-intro.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Mark from './Mark.astro';
import CoverMark from './CoverMark.astro';
import { TOPICS } from '../../content/config';
import { DESK_COPY, DESK_REGISTER } from '../../lib/desks';
import { ink } from '../../lib/desk-inks';
import { markBody, viewBoxFor } from '../../lib/mark';
import { introFigure } from '../../lib/stage';
import { coverModel } from '../../lib/cover';
import { formatNo, issueNumbers } from '../../lib/issue-number';
import { renderEmphasis } from '../../lib/text';
import { REACTION_KINDS } from '../../lib/reactions';

interface Props {
  issue: CollectionEntry<'issues'>;
  number?: number;
}
const { issue, number } = Astro.props;
const d = issue.data;
const desk = d.topic;
const SERIF = "font-family:'Literata',Georgia,serif";

const published = await getCollection('issues', (e) => e.data.status !== 'draft');
const numbers = await issueNumbers();
const newestFirst = [...published].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || b.slug.localeCompare(a.slug)
);
const noOf = (i: CollectionEntry<'issues'>) => {
  const n = i.slug === issue.slug ? number : numbers.get(i.slug);
  return n ? formatNo(n) : '';
};
const no = noOf(issue);

/* The autoplay holds, ms (the board's table): build plus a hold to read.
   Scene 5 waits for a choice. */
const HOLD = [8000, 11000, 9000, 9500, 0];
const NAMES = ['What Parallax is', 'What you can do here', 'What to do first', 'What members get', 'Where to start'];

/* ── Scene 1: the house medallion, one element per part so each builds. ── */
const medal = (size: number) =>
  (markBody({
    desk: 'politics', size, cut: 'mark',
    colors: { accent: ink('politics', 'mark'), ground: 'var(--paper-2)', ink: 'var(--ink)', paper: 'var(--paper-2)' },
  }).match(/<(circle|path)[^>]*\/>/g) ?? [])
    .map((p, i) => p.replace(/\/>$/, ` data-build="${i + 1}" data-build-kind="${['fade', 'drop', 'fade', 'rise'][i]}"/>`))
    .join('');
const EYE = (x: number, y: number, pupil: string) =>
  `<path d="M${x - 20} ${y} Q${x} ${y - 15} ${x + 20} ${y} Q${x} ${y + 15} ${x - 20} ${y} Z" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/><circle cx="${x}" cy="${y}" r="5" fill="${pupil}"/>`;
/* Desktop (784 x 312) and phone (318 x 352) drawings, the boards' geometry. */
const S1 = {
  wide: { w: 784, h: 312, mx: 308, my: 48, ms: 168, ey: 260, ex: [150, 634], ly: 298, dot: 'M178 260 H606', s1: 'M171.2 248.8 L310.7 175.0', s2: 'M612.8 248.8 L473.3 175.0' },
  narrow: { w: 318, h: 352, mx: 81, my: 50, ms: 156, ey: 296, ex: [44, 274], ly: 334, dot: 'M72 296 H246', s1: 'M57.6 276.2 L110.4 199.0', s2: 'M260.4 276.2 L207.6 199.0' },
};

/* ── Scene 2: the reading system, from the cover issue's own figure. ── */
const fig = introFigure({ topic: desk, title: d.title, sections: d.sections as any, cover: d.cover });
const open = fig?.open.days ?? 1;
const segs = fig ? fig.closed.spans.map((s) => +(s / open).toFixed(4)) : [];
const toNum = (v: string) => Number(String(v).replace(/[^\d.]/g, ''));
const counterOk = fig ? /^\d{1,3}(,\d{3})*$/.test(fig.cues[0].value) : false;
const caption = fig?.caption ?? coverModel(desk, d.sections as any, d.title, { cover: d.cover }).caption;
const inks = `--in-mark: ${ink(desk, 'mark')}; --in-text: ${ink(desk, 'text')}; --in-tint: ${ink(desk, 'tint')}`;

/* ── Scene 3: the first issue's card, the shelf, the reactions. ── */
const reads = published.map((i) => i.data.readTimeMinutes).filter((n): n is number => typeof n === 'number' && n > 0);
const rMin = reads.length ? Math.min(...reads) : 0;
const rMax = reads.length ? Math.max(...reads) : 0;
const readLine = !rMin ? 'A few minutes each' : rMin === rMax ? `Most take ${rMin} minutes` : rMax - rMin === 1 ? `Most take ${rMin} or ${rMax} minutes` : `Most take ${rMin} to ${rMax} minutes`;
const readMin = d.readTimeMinutes ?? rMin;

/* The sample shelf: the cover issue and two more, each by its own `cover`
   number and label; the path is the four newest after the cover. */
const others = newestFirst.filter((i) => i.slug !== issue.slug && i.data.cover?.number);
const keepN = Math.min(2, others.length);
const kept = others.slice(Math.max(0, Math.min(6, others.length) - keepN), Math.min(6, others.length)).reverse();
const tile = (i: CollectionEntry<'issues'>) => ({
  no: noOf(i),
  value: String(i.data.cover?.number ?? ''),
  label: String(i.data.cover?.label ?? ''),
  text: ink(i.data.topic, 'text'), mark: ink(i.data.topic, 'mark'), tint: ink(i.data.topic, 'tint'),
});
const shelf = [
  { ...tile(issue), value: String(d.cover?.number ?? fig?.cues[0].value ?? ''), label: String(d.cover?.label ?? fig?.cues[0].unit ?? '') },
  ...kept.map(tile),
].filter((t) => t.value);
const PROGRESS = [1, 1, 0.6, 0.38];
const trail = others.slice(0, Math.min(4, Math.max(0, others.length - keepN))).map((i, k) => ({
  no: noOf(i), mark: ink(i.data.topic, 'mark'), tint: ink(i.data.topic, 'tint'), p: PROGRESS[k],
}));
const arc = (p: number) => {
  const a = p * 2 * Math.PI;
  const x = (12 + 11 * Math.sin(a)).toFixed(2);
  const y = (12 - 11 * Math.cos(a)).toFixed(2);
  return `M12 1 A11 11 0 ${p > 0.5 ? 1 : 0} 1 ${x} ${y}`;
};
const pct = (p: number) => `${Math.round(p * 100)} percent`;

/* ── Scene 4: the Subscribe page's facts. ── */
const FACTS = [
  { v: '₹0', was: '₹149', l: 'a month, free in beta', short: 'a month in beta', key: true },
  { v: '0', l: 'analytics scripts' },
  { v: '0', l: 'trackers' },
  { v: '1', l: 'letter a week' },
];

/* ── Scene 5: the desks, counted. ── */
const WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const sources = published.reduce((s, i) => s + (i.data.sources?.length ?? 0), 0);
const desks = TOPICS.map((t) => {
  const n = published.filter((i) => i.data.topic === t).length;
  return { t, name: DESK_COPY[t].name, reg: DESK_REGISTER[t], n: `${n} ${n === 1 ? 'issue' : 'issues'}`, text: ink(t, 'text') };
});
const tally = `${WORDS[TOPICS.length] ?? TOPICS.length} desks, ${published.length} ${published.length === 1 ? 'issue' : 'issues'}, ${sources} sources so far.`;

const ARROW = '<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const BOOK = '<svg width="12" height="15" viewBox="0 0 12 15" aria-hidden="true" focusable="false"><path d="M1 1h10v13l-5-3.6L1 14z" fill="var(--ink)"/></svg>';
const CHECK = '<svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="10" fill="var(--pol-text)"/><path d="M5.5 10.2l3 3 6-6.4" fill="none" stroke="var(--paper)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<dialog class="px-intro" id="px-intro" aria-label="Welcome to Parallax" tabindex="-1" style={inks}>
  <header class="px-intro__top">
    <span class="px-intro__brand">
      <Mark size={28} tight ground="var(--paper-2)" />
      <span class="px-intro__name">Parallax</span>
    </span>
    <span class="px-intro__status px-intro__status--top">
      <button class="px-intro__hold" type="button" data-intro-hold aria-pressed="false" aria-label="Pause the intro">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><g class="px-intro__ipause"><rect x="3" y="2.5" width="2.6" height="9" rx="1" /><rect x="8.4" y="2.5" width="2.6" height="9" rx="1" /></g><path class="px-intro__iplay" d="M4 2.4l7.6 4.6L4 11.6z" /></svg>
      </button>
      <span class="px-intro__count" aria-live="polite"><span data-intro-n>1</span> / 5<span class="px-intro__paused">Paused</span></span>
    </span>
    <button class="px-intro__skip" type="button" data-intro-skip>Skip
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2 2l8 8M10 2l-8 8" /></svg>
    </button>
  </header>

  <div class="px-intro__scenes">
    {/* ── 1 · What Parallax is ─────────────────────────────────────────── */}
    <section class="px-intro__scene px-intro__s1" data-scene="1" data-build-scene data-build-delay="100" aria-labelledby="px-intro-h1">
      <div class="px-intro__head">
        <p class="px-intro__eyebrow" data-build="7" data-build-kind="rise">{NAMES[0]}</p>
        <h2 class="px-intro__h" id="px-intro-h1" data-build="7" data-build-kind="rise">Stories you think you <em>already</em> understand.</h2>
        <p class="px-intro__sub" data-build="8" data-build-kind="rise">Two eyes, one object, a second angle.</p>
      </div>
      {(['wide', 'narrow'] as const).map((k) => {
        const g = S1[k];
        return (
          <svg class={`px-intro__eyes px-intro__eyes--${k}`} width={g.w} height={g.h} viewBox={`0 0 ${g.w} ${g.h}`} role="img" focusable="false"
            aria-label="The Parallax medallion built from its parts: an oxide disc, a paper disc shifted along the dial to leave a crescent, a ring and the letter P. Two eyes look at it from two places, a first look and a second angle.">
            <path d={g.dot} fill="none" stroke="var(--hair-2)" stroke-width="1.5" stroke-dasharray="2 6" data-build="5" data-build-kind="fade" />
            <path d={g.s1} pathLength="1" fill="none" stroke="var(--ink-2)" stroke-width="1.5" stroke-linecap="round" data-build="6" data-build-kind="draw" />
            <path d={g.s2} pathLength="1" fill="none" stroke={ink('politics', 'mark')} stroke-width="1.5" stroke-linecap="round" data-build="6" data-build-kind="draw" />
            <svg x={g.mx} y={g.my} width={g.ms} height={g.ms} viewBox={viewBoxFor(7, true)} overflow="visible"><Fragment set:html={medal(g.ms)} /></svg>
            <g data-build="5" data-build-kind="rise"><Fragment set:html={EYE(g.ex[0], g.ey, 'var(--ink)')} /></g>
            <g data-build="5" data-build-kind="rise"><Fragment set:html={EYE(g.ex[1], g.ey, ink('politics', 'mark'))} /></g>
            <text x={g.ex[0]} y={g.ly} text-anchor="middle" font-size="13" font-weight="500" fill="var(--ink-2)" style={SERIF} data-build="7" data-build-kind="rise">First look</text>
            <text x={g.ex[1]} y={g.ly} text-anchor="middle" font-size="13" font-weight="600" fill={ink('politics', 'text')} style={SERIF} data-build="7" data-build-kind="rise">Second angle</text>
          </svg>
        );
      })}
    </section>

    {/* ── 2 · What you can do here ─────────────────────────────────────── */}
    <section class="px-intro__scene px-intro__s2" data-scene="2" data-build-scene aria-labelledby="px-intro-h2">
      <div class="px-intro__head">
        <p class="px-intro__eyebrow" data-build="6" data-build-kind="rise">{NAMES[1]}</p>
        <h2 class="px-intro__h" id="px-intro-h2" data-build="6" data-build-kind="rise">Six desks, one way of <em>reading</em>.</h2>
        <p class="px-intro__sub" data-build="7" data-build-kind="rise">Every sentence with a number points at its mark. Read, or look. Both work.</p>
      </div>
      <div class="px-intro__s2body">
        <div class="px-intro__read" data-lit="">
          {fig && (
            <article class="px-intro__prose" data-build="1" data-build-kind="rise">
              <span class="px-intro__kick">{[no, fig.eyebrow].filter(Boolean).join(' · ')}</span>
              {fig.cues.map((c) => (
                <p class="px-intro__cuep" data-cue-p={c.n}>
                  <button class="px-intro__cue" type="button" data-intro-cue={c.n} aria-pressed="false" aria-label={`Cue ${c.n}: light it on the figure`}>{c.n}</button>{' '}
                  <span class="px-intro__hl"><strong>{c.lead}</strong> {c.rest}</span>
                </p>
              ))}
            </article>
          )}
          <figure class="px-intro__fig" data-build="1" data-build-kind="rise">
            {fig ? (
              <>
                <div class="px-intro__ro" aria-live="polite">
                  {fig.cues.map((c, i) => (
                    <div class="px-intro__roi" data-ro={c.n}>
                      {i === 0 && counterOk
                        ? <span class="px-intro__rov" data-build="2" data-build-kind="counter" data-to={toNum(c.value)}>{c.value}</span>
                        : <span class="px-intro__rov">{c.value}</span>}
                      <span class="px-intro__rou">{c.unit}</span>
                    </div>
                  ))}
                </div>
                <div class="px-intro__rows" role="img"
                  aria-label={`Days each case has run. 1: ${fig.open.label}, ${fig.open.days.toLocaleString('en-US')} and still open. 2: ${fig.closed.label}, ${fig.closed.total} and closed.`}>
                  <div class="px-intro__row" data-lite="1">
                    <span class="px-intro__rn"><span class="px-intro__disc">1</span>{fig.open.label}</span>
                    <span class="px-intro__track">
                      <span class="px-intro__bar" data-build="2" data-build-kind="grow-x"></span>
                      <svg class="px-intro__more" width="28" height="12" viewBox="0 0 28 12" aria-hidden="true" focusable="false" data-build="3" data-build-kind="fade"><path d="M0 6H18" stroke-dasharray="3 3" /><path d="M20 0.5l6 5.5-6 5.5" /></svg>
                    </span>
                  </div>
                  <div class="px-intro__row" data-lite="2">
                    <span class="px-intro__rn"><span class="px-intro__disc">2</span>{fig.closed.label}</span>
                    <span class="px-intro__track">
                      {segs.map((s, i) => <span class:list={['px-intro__seg', { 'px-intro__seg--2': i > 0 }]} style={`--f: ${s}`} data-build="2" data-build-kind="grow-x"></span>)}
                      <span class="px-intro__closed" data-build="3" data-build-kind="fade">{fig.closed.total} days, closed</span>
                    </span>
                  </div>
                </div>
              </>
            ) : (
              <>
                <span class="px-intro__cover"><CoverMark issue={issue} /></span>
                {caption && <figcaption class="px-intro__capt">{caption}</figcaption>}
              </>
            )}
          </figure>
        </div>
        <ul class="px-intro__desks" aria-label="The six desks">
          {TOPICS.map((t) => (
            <li class="px-intro__desk" data-build="4" data-build-kind="drop">
              <Mark desk={t} size={40} tight ground="var(--paper-2)" title={`${DESK_COPY[t].name} medallion`} class="px-intro__dmark" />
              <span class="px-intro__dnames" data-build="5" data-build-kind="rise">
                <span class="px-intro__dn">{DESK_COPY[t].name}</span>
                <span class="px-intro__dr" style={`color: ${ink(t, 'text')}`}>{DESK_REGISTER[t]}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ── 3 · What to do first ─────────────────────────────────────────── */}
    <section class="px-intro__scene px-intro__s3" data-scene="3" data-build-scene aria-labelledby="px-intro-h3">
      <div class="px-intro__head">
        <p class="px-intro__eyebrow" data-build="5" data-build-kind="rise">{NAMES[2]}</p>
        <h2 class="px-intro__h" id="px-intro-h3" data-build="5" data-build-kind="rise">Three steps for your <em>first</em> issue.</h2>
        <p class="px-intro__sub" data-build="6" data-build-kind="rise">Read it, save it if it is worth keeping, then tell us how it landed.</p>
      </div>
      <div class="px-intro__path" data-build="1" data-build-kind="rise">
        <ol class="px-intro__steps">
          <li class="px-intro__step" data-build="2" data-build-kind="rise">
            <span class="px-intro__num" data-build="4" data-build-kind="fade">1</span>
            <div class="px-intro__card">
              <div class="px-intro__cfig px-intro__cfig--read">
                <span class="px-intro__ring">
                  <svg viewBox="0 0 76 76" aria-hidden="true" focusable="false"><circle cx="38" cy="38" r="30" fill="none" stroke="var(--paper-2)" stroke-width="7" /><path d="M38 8 A30 30 0 1 1 37.99 8" pathLength="1" fill="none" stroke="var(--in-mark)" stroke-width="7" stroke-linecap="round" data-build="3" data-build-kind="draw" /></svg>
                  <span class="px-intro__ringt">{readMin} min</span>
                </span>
                <span class="px-intro__cmeta" data-build="3" data-build-kind="rise">
                  {no && <span class="px-intro__cno">{no}</span>}
                  <span class="px-intro__ctitle" set:html={renderEmphasis(d.title)} />
                </span>
              </div>
              <div class="px-intro__ctext"><span class="px-intro__ct">Read an issue</span><span class="px-intro__cs">{readLine}</span></div>
            </div>
          </li>
          <li class="px-intro__step" data-build="2" data-build-kind="rise">
            <span class="px-intro__num" data-build="4" data-build-kind="fade">2</span>
            <div class="px-intro__card">
              <div class="px-intro__cfig px-intro__cfig--save">
                {shelf.map((s) => (
                  <span class="px-intro__mini" style={`--t-text: ${s.text}; --t-mark: ${s.mark}; --t-tint: ${s.tint}`} data-build="3" data-build-kind="drop">
                    <span class="px-intro__miniv">{s.value}</span>
                    <span class="px-intro__minino">{s.no}</span>
                    <span class="px-intro__book" data-build="4" data-build-kind="drop"><Fragment set:html={BOOK} /></span>
                  </span>
                ))}
              </div>
              <div class="px-intro__ctext"><span class="px-intro__ct">Save the ones worth keeping</span><span class="px-intro__cs">They wait on your shelf</span></div>
            </div>
          </li>
          <li class="px-intro__step" data-build="2" data-build-kind="rise">
            <span class="px-intro__num" data-build="4" data-build-kind="fade">3</span>
            <div class="px-intro__card">
              <div class="px-intro__cfig px-intro__cfig--land">
                {REACTION_KINDS.map((r, i) => (
                  <span class:list={['px-intro__react', { 'is-picked': i === 0 }]} data-build="3" data-build-kind="rise">
                    <span class="px-intro__box">{i === 0 && <span class="px-intro__tick" data-build="4" data-build-kind="fade"><Fragment set:html={CHECK} /></span>}</span>
                    <span class="px-intro__rl">{r.label}</span>
                    <span class="px-intro__rb" aria-hidden="true"></span>
                  </span>
                ))}
              </div>
              <div class="px-intro__ctext"><span class="px-intro__ct">Tell us how it landed</span><span class="px-intro__cs">At the end of every issue</span></div>
            </div>
          </li>
        </ol>
        <span class="px-intro__rail px-intro__rail--x" data-build="3" data-build-kind="grow-x"></span>
        <span class="px-intro__rail px-intro__rail--y" data-build="3" data-build-kind="grow-y"></span>
      </div>
    </section>

    {/* ── 4 · What members get ─────────────────────────────────────────── */}
    <section class="px-intro__scene px-intro__s4" data-scene="4" data-build-scene aria-labelledby="px-intro-h4">
      <div class="px-intro__head">
        <p class="px-intro__eyebrow" data-build="5" data-build-kind="rise">{NAMES[3]}</p>
        <h2 class="px-intro__h" id="px-intro-h4" data-build="5" data-build-kind="rise">Join free, and the shelf is <em>yours</em>.</h2>
        <p class="px-intro__sub" data-build="6" data-build-kind="rise">Free while we test. No analytics, no trackers. One letter a week.</p>
      </div>
      <div class="px-intro__s4body">
        <div class="px-intro__shelf" data-build="1" data-build-kind="rise">
          <span class="px-intro__lab">On the shelf</span>
          <ul class="px-intro__saved">
            {shelf.map((s) => (
              <li class="px-intro__tile" style={`--t-text: ${s.text}; --t-tint: ${s.tint}`} data-build="2" data-build-kind="drop">
                <span class="px-intro__tv">{s.value}</span>
                <span class="px-intro__tl">{s.label}</span>
                <span class="px-intro__tno">{s.no}</span>
                <span class="px-intro__tb"><Fragment set:html={BOOK} /></span>
              </li>
            ))}
          </ul>
          {trail.length > 0 && (
            <>
              <span class="px-intro__lab">Your path</span>
              <ol class="px-intro__trail" aria-label={`Your path across the desks: ${trail.map((t) => `${t.no} ${t.p >= 1 ? 'read' : `at ${pct(t.p)}`}`).join(', ')}.`}>
                <span class="px-intro__tline" data-build="3" data-build-kind="grow-x" aria-hidden="true"></span>
                {trail.map((t) => (
                  <li class="px-intro__stop">
                    <svg class="px-intro__pm" width="26" height="26" viewBox="-1 -1 26 26" aria-hidden="true" focusable="false" data-build="3" data-build-kind="fade">
                      {t.p >= 1 ? (
                        <>
                          <circle cx="12" cy="12" r="11" fill="var(--paper)" stroke={t.mark} stroke-width="2.5" />
                          <path d="M7.5 12.3l3 3 6-6.2" fill="none" stroke={t.mark} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </>
                      ) : (
                        <>
                          <circle cx="12" cy="12" r="11" fill="var(--paper)" stroke={t.tint} stroke-width="3" />
                          <path d={arc(t.p)} pathLength="1" fill="none" stroke={t.mark} stroke-width="3" stroke-linecap="round" data-build="4" data-build-kind="draw" />
                        </>
                      )}
                    </svg>
                    <span class="px-intro__pn">{t.no}</span>
                  </li>
                ))}
              </ol>
            </>
          )}
          <div class="px-intro__disp" data-build="3" data-build-kind="rise">
            <span class="px-intro__env"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="1.5" y="3" width="13" height="10" rx="1.5" /><path d="M2 4l6 5 6-5" /></svg></span>
            <span class="px-intro__dt">
              <span class="px-intro__dh">The dispatch</span>
              <span class="px-intro__dl">One quiet letter when an issue is worth keeping</span>
            </span>
            <span class="px-intro__dw">Weekly letter</span>
            <span class="px-intro__switch" role="img" aria-label="Weekly letter: on"><span></span></span>
          </div>
        </div>
        <ul class="px-intro__facts">
          {FACTS.map((f) => (
            <li class:list={['px-intro__fact', { 'is-key': f.key }]} data-build="4" data-build-kind="rise">
              <span class="px-intro__fv">{f.v}</span>
              <span class="px-intro__fls">
                {f.was && <s class="px-intro__was">{f.was}<span class="px-intro__strike" data-build="5" data-build-kind="grow-x" aria-hidden="true"></span></s>}
                <span class="px-intro__fl">{f.short ? <><span class="px-intro__long">{f.l}</span><span class="px-intro__short">{f.short}</span></> : f.l}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ── 5 · Where to start ───────────────────────────────────────────── */}
    <section class="px-intro__scene px-intro__s5" data-scene="5" data-build-scene aria-labelledby="px-intro-h5">
      <div class="px-intro__head">
        <p class="px-intro__eyebrow" data-build="2" data-build-kind="rise">{NAMES[4]}</p>
        <h2 class="px-intro__h" id="px-intro-h5" data-build="2" data-build-kind="rise">Where would you like to <em>begin</em>?</h2>
        <p class="px-intro__sub" data-build="3" data-build-kind="rise">{tally}</p>
      </div>
      <div class="px-intro__s5body">
        <ul class="px-intro__tiles">
          {desks.map((k) => (
            <li>
              <a class="px-intro__dtile" href={`/topics/${k.t}/`} data-intro-close aria-label={`${k.name}, ${k.n}`} style={`--t-text: ${k.text}`} data-build="1" data-build-kind="drop">
                <Mark desk={k.t} size={48} tight ground="var(--paper)" class="px-intro__tmark" />
                <span class="px-intro__tn">{k.name}</span>
                <span class="px-intro__tr">{k.reg}</span>
                <span class="px-intro__tc">{k.n}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="px-intro__ctas" data-build="4" data-build-kind="rise">
          <a class="px-intro__go" href="/#desks" data-intro-close>Start browsing<Fragment set:html={ARROW} /></a>
          <a class="px-intro__member" href="/login" data-intro-close>Sign in or become a member</a>
          <button class="px-intro__cont" type="button" data-intro-close>Continue to the home page<Fragment set:html={ARROW} /></button>
        </div>
      </div>
    </section>
  </div>

  <footer class="px-intro__foot">
    <span class="px-intro__status px-intro__status--foot">
      <button class="px-intro__hold" type="button" data-intro-hold aria-pressed="false" aria-label="Pause the intro">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><g class="px-intro__ipause"><rect x="3" y="2.5" width="2.6" height="9" rx="1" /><rect x="8.4" y="2.5" width="2.6" height="9" rx="1" /></g><path class="px-intro__iplay" d="M4 2.4l7.6 4.6L4 11.6z" /></svg>
        <span class="px-intro__holdt"><span class="px-intro__tpause">Pause</span><span class="px-intro__tplay">Play</span></span>
      </button>
    </span>
    <div class="px-intro__nav" role="group" aria-label="Intro scenes">
      <button class="px-intro__arrow" type="button" data-intro-back aria-label="Previous scene" aria-disabled="true">
        <svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M12 7H2M6 3L2 7l4 4" /></svg>
      </button>
      {NAMES.map((name, i) => (
        <button class="px-intro__dot" type="button" data-intro-go={i + 1} aria-current={i === 0 ? 'step' : 'false'} aria-label={`Scene ${i + 1} of 5, ${name}`} style={HOLD[i] ? `--hold: ${HOLD[i]}ms` : undefined} data-last={HOLD[i] ? undefined : ''}>
          <span class="px-intro__dotv"><span class="px-intro__fill"></span></span>
        </button>
      ))}
      <button class="px-intro__arrow" type="button" data-intro-next aria-label="Next scene" aria-disabled="false">
        <svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2 7h10M8 3l4 4-4 4" /></svg>
      </button>
      <span class="px-intro__count px-intro__count--foot"><span data-intro-n>1</span> / 5<span class="px-intro__paused">Paused</span></span>
    </div>
    <span></span>
  </footer>
</dialog>

<script is:inline>
(function () {
  var el = document.getElementById('px-intro'), K = 'px_intro_v3', q = location.search, D = document, R = D.documentElement, ls, seen;
  if (!el || !el.showModal) return;
  try { ls = localStorage; seen = ls.getItem(K); } catch (e) {}
  if (/[?&]intro=0/.test(q) || (seen && !/[?&]intro=1/.test(q))) return;
  var rm = matchMedia('(prefers-reduced-motion: reduce)').matches, prev = D.activeElement, cur = 0, tm = [];
  var rd = el.querySelector('[data-lit]');
  function all(s, f) { el.querySelectorAll(s).forEach(f); }
  function clear() { tm.forEach(clearTimeout); tm = []; }
  function lit(n) {
    if (rd) rd.setAttribute('data-lit', n || '');
    all('[data-intro-cue]', function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-intro-cue') == n); });
  }
  function go(n) {
    if (n < 1 || n > 5) return;
    clear(); cur = n; el.setAttribute('data-step', n); lit(0);
    all('[data-scene]', function (s) {
      var on = s.getAttribute('data-scene') == n;
      s.inert = !on;
      if (on) s.dispatchEvent(new Event('px:build', { bubbles: true }));
    });
    all('[data-intro-go]', function (b) { b.setAttribute('aria-current', b.getAttribute('data-intro-go') == n ? 'step' : 'false'); });
    all('[data-intro-n]', function (s) { s.textContent = n; });
    all('[data-intro-back]', function (b) { b.setAttribute('aria-disabled', n == 1); });
    all('[data-intro-next]', function (b) { b.setAttribute('aria-disabled', n == 5); });
    el.removeAttribute('data-auto'); void el.offsetWidth;
    if (rm) return;
    if (n < 5) el.setAttribute('data-auto', '');
    if (n == 2) tm.push(setTimeout(lit, 920, 1), setTimeout(lit, 2420, 2));
  }
  function key(e) {
    if (e.key == 'ArrowRight') go(cur + 1);
    else if (e.key == 'ArrowLeft') go(cur - 1);
  }
  function close() {
    clear(); el.removeAttribute('data-auto');
    R.classList.remove('px-intro-open');
    D.removeEventListener('keydown', key);
    el.classList.add('is-out');
    setTimeout(function () { el.close(); el.classList.remove('is-out'); if (prev && prev.focus) prev.focus(); }, rm ? 0 : 420);
  }
  el.addEventListener('cancel', function (e) { e.preventDefault(); close(); });
  el.addEventListener('animationend', function (e) { if (e.target.classList.contains('px-intro__fill')) go(cur + 1); });
  el.addEventListener('click', function (e) {
    var t = e.target.closest('a,button'), a = t && t.dataset;
    if (!t) return;
    if ('introSkip' in a || 'introClose' in a) return close();
    if (a.introGo) return go(+a.introGo);
    if ('introBack' in a) return go(cur - 1);
    if ('introNext' in a) return go(cur + 1);
    if ('introHold' in a) {
      var h = el.toggleAttribute('data-held');
      return all('[data-intro-hold]', function (b) { b.setAttribute('aria-pressed', h); });
    }
    if (a.introCue) { clear(); lit(rd.getAttribute('data-lit') == a.introCue ? 0 : a.introCue); }
  });
  try { ls.setItem(K, '1'); } catch (e) {}
  el.classList.add('is-pre');
  el.showModal(); el.focus();
  R.classList.add('px-intro-open');
  D.addEventListener('keydown', key);
  void el.offsetWidth;
  el.classList.remove('is-pre');
  go(1);
})();
</script>

<style>
  /* While it is open the page beneath does not scroll. */
  :global(html.px-intro-open), :global(html.px-intro-open body) { overflow: hidden; }
  :global(html:not(.js)) .px-intro { display: none !important; }

  /* ── The dialog: 880 x 600 on paper-2, rising over the blurred page. The
     scrim is the dialog's ::backdrop: the page behind blurs 14px under a
     paper wash at 55%. The entrance (Intro-Entry): 300ms, opacity on --ease,
     scale .92 to 1 on --ease-move; the exit: 200ms out, the page unblurs in
     420ms. ::backdrop may not inherit custom properties, so its colour is
     the paper's literal. ─────────────────────────────────────────────────── */
  .px-intro {
    box-sizing: border-box;
    width: min(880px, calc(100vw - 32px));
    height: min(600px, calc(100dvh - 32px));
    max-width: none; max-height: none;
    margin: auto; padding: 0;
    display: none;
    flex-direction: column;
    overflow: hidden;
    background: var(--paper-2);
    color: var(--ink);
    border: 1px solid var(--hair);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-2);
    outline: none;
    font-family: var(--font-ui);
    transition: opacity 300ms var(--ease), scale 300ms var(--ease-move);
  }
  .px-intro[open] { display: flex; }
  .px-intro::backdrop {
    background: rgb(245 242 235 / 0.55);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition: background-color 300ms cubic-bezier(.22, 1, .36, 1), backdrop-filter 300ms cubic-bezier(.22, 1, .36, 1), -webkit-backdrop-filter 300ms cubic-bezier(.22, 1, .36, 1);
  }
  .px-intro.is-pre { opacity: 0; scale: 0.92; transition: none; }
  .px-intro.is-pre::backdrop { background: rgb(245 242 235 / 0); -webkit-backdrop-filter: blur(0); backdrop-filter: blur(0); transition: none; }
  .px-intro.is-out { opacity: 0; scale: 0.98; transition: opacity 200ms var(--ease), scale 200ms var(--ease); }
  .px-intro.is-out::backdrop { background: rgb(245 242 235 / 0); -webkit-backdrop-filter: blur(0); backdrop-filter: blur(0); transition-duration: 420ms; }
  @media print { .px-intro, .px-intro::backdrop { display: none !important; } }

  .px-intro button { font-family: var(--font-ui); cursor: pointer; }
  .px-intro :is(a, button):focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .px-intro :is(.px-intro__skip, .px-intro__arrow, .px-intro__go, .px-intro__cont) svg path { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  /* ── The head: the lockup, the status (phones), Skip. ─────────────────── */
  .px-intro__top {
    height: 64px; flex: none; box-sizing: border-box;
    padding: 0 12px 0 28px;
    display: flex; align-items: center; gap: 8px;
    border-bottom: 1px solid var(--hair);
  }
  .px-intro__brand { display: flex; align-items: center; gap: 10px; margin-right: auto; }
  .px-intro__name { font: 700 20px/1 var(--font-display); letter-spacing: -0.02em; position: relative; top: -1px; }
  .px-intro__skip {
    height: 44px; padding: 0 14px; border: 0; border-radius: var(--r-ctl); background: transparent;
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--ink-2);
    font: 600 12px/1 var(--font-ui); letter-spacing: 0.17em; text-transform: uppercase; white-space: nowrap;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }
  .px-intro__skip:hover, .px-intro__hold:hover, .px-intro__arrow:hover { background: var(--paper-3); color: var(--ink); }

  /* ── The scenes: stacked in one cell, the current one shown. ──────────── */
  .px-intro__scenes { flex: 1; min-height: 0; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); }
  .px-intro__scene {
    grid-area: 1 / 1; min-width: 0; min-height: 0;
    box-sizing: border-box;
    padding: 28px 48px 0;
    display: flex; flex-direction: column; align-items: center; gap: 20px;
    overflow: clip;
    opacity: 0; visibility: hidden;
    transition: opacity 200ms var(--ease), visibility 0s linear 200ms;
  }
  .px-intro[data-step='1'] [data-scene='1'],
  .px-intro[data-step='2'] [data-scene='2'],
  .px-intro[data-step='3'] [data-scene='3'],
  .px-intro[data-step='4'] [data-scene='4'],
  .px-intro[data-step='5'] [data-scene='5'] { opacity: 1; visibility: visible; transition: opacity 200ms var(--ease) 200ms; }

  .px-intro__head { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 100%; text-align: center; }
  .px-intro__eyebrow {
    margin: 0; font: 600 12px/1.25 var(--font-ui); letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--pol-text);
  }
  .px-intro__h { margin: 0; font: 700 32px/1.15 var(--font-display); letter-spacing: -0.028em; color: var(--ink); text-wrap: balance; }
  .px-intro__h em { font-style: italic; font-weight: 400; color: var(--pol-text); }
  .px-intro__sub { margin: 0; font: 400 18px/1.45 var(--font-display); color: var(--muted); text-wrap: balance; }

  /* ── 1 · the medallion and the two eyes. ─────────────────────────────── */
  .px-intro__eyes { display: block; overflow: visible; flex: none; }
  .px-intro__eyes--narrow { display: none; }

  /* ── 2 · the reading system, then the desks. ─────────────────────────── */
  .px-intro__s2body { width: 784px; display: grid; grid-template-rows: 196px auto; row-gap: 16px; }
  .px-intro__read { display: grid; grid-template-columns: 330px 414px; column-gap: 40px; align-items: center; }
  .px-intro__read:has(> :only-child) { grid-template-columns: 414px; justify-content: center; }
  .px-intro__prose { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .px-intro__kick { font: 600 12px/1.25 var(--font-ui); letter-spacing: 0.18em; text-transform: uppercase; color: var(--in-text); }
  .px-intro__cuep { margin: 0; font: 400 16px/1.5 var(--font-display); color: var(--ink); }
  .px-intro__cuep strong { font-weight: 600; }
  .px-intro__cue {
    position: relative;
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; padding: 0; border: 0; border-radius: 999px;
    background: var(--in-mark); color: var(--paper);
    font: 600 12px/1 var(--font-ui); font-variant-numeric: tabular-nums;
    vertical-align: 2px;
    transition: background-color 160ms var(--ease), box-shadow 160ms var(--ease);
  }
  .px-intro__cue::after { content: ''; position: absolute; inset: -12px; }
  .px-intro__cue:hover, .px-intro__cue[aria-pressed='true'] { background: var(--in-text); box-shadow: 0 0 0 3px var(--in-tint); }
  .px-intro__hl { padding: 1px 3px; border-radius: 3px; box-decoration-break: clone; -webkit-box-decoration-break: clone; transition: background-color 160ms var(--ease); }
  .px-intro__read[data-lit='1'] [data-cue-p='1'] .px-intro__hl,
  .px-intro__read[data-lit='2'] [data-cue-p='2'] .px-intro__hl { background: var(--in-tint); }

  .px-intro__fig {
    margin: 0; min-width: 0;
    padding: 16px 20px;
    display: flex; flex-direction: column; gap: 10px;
    background: var(--paper); border: 1px solid var(--hair); border-radius: var(--r-card); box-shadow: var(--shadow-1);
  }
  .px-intro__ro { height: 40px; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); align-items: end; }
  .px-intro__roi {
    grid-area: 1 / 1; display: flex; align-items: baseline; gap: 10px; min-width: 0;
    transition: opacity 420ms var(--ease), translate 420ms var(--ease), visibility 420ms;
  }
  .px-intro__roi[data-ro='2'],
  .px-intro__read[data-lit='2'] .px-intro__roi[data-ro='1'] { opacity: 0; translate: 0 8px; visibility: hidden; }
  .px-intro__read[data-lit='2'] .px-intro__roi[data-ro='2'] { opacity: 1; translate: 0 0; visibility: visible; }
  .px-intro__rov { font: 700 40px/1 var(--font-ui); letter-spacing: -0.02em; color: var(--in-text); font-variant-numeric: tabular-nums; }
  .px-intro__rou { font: 500 14px/1.3 var(--font-ui); color: var(--ink-2); min-width: 0; }
  .px-intro__rows { display: flex; flex-direction: column; gap: 10px; }
  .px-intro__row { display: flex; flex-direction: column; gap: 6px; transition: opacity 160ms var(--ease); }
  .px-intro__read[data-lit='1'] [data-lite='2'], .px-intro__read[data-lit='2'] [data-lite='1'] { opacity: 0.35; }
  .px-intro__rn { display: flex; align-items: center; gap: 10px; font: 500 13px/1.2 var(--font-ui); color: var(--ink-2); }
  .px-intro__disc {
    width: 20px; height: 20px; flex: none; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--in-mark); color: var(--paper);
    font: 600 12px/1 var(--font-ui); font-variant-numeric: tabular-nums;
    transition: box-shadow 160ms var(--ease);
  }
  .px-intro__read[data-lit='1'] [data-lite='1'] .px-intro__disc,
  .px-intro__read[data-lit='2'] [data-lite='2'] .px-intro__disc { box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--in-mark); }
  .px-intro__track { display: flex; align-items: center; height: 16px; }
  .px-intro__bar { flex: none; width: calc(100% - 42px); height: 16px; border-radius: 2px; background: var(--in-mark); transform-origin: 0 50%; }
  .px-intro__more { flex: none; margin-left: 4px; overflow: visible; }
  .px-intro__more path { fill: none; stroke: var(--in-mark); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .px-intro__seg { flex: none; width: calc((100% - 42px) * var(--f)); min-width: 2px; height: 16px; margin-right: 1.5px; border-radius: 2px; background: var(--ink-2); transform-origin: 0 50%; }
  .px-intro__seg--2 { opacity: 0.45; }
  .px-intro__closed { margin-left: 8px; font: 600 13px/1 var(--font-ui); color: var(--ink); white-space: nowrap; }
  .px-intro__cover { display: flex; justify-content: center; padding: 12px; border-radius: var(--r-ctl); background: var(--in-tint); container-type: inline-size; }
  .px-intro__capt { font: 500 15.5px/1.3 var(--font-display); color: var(--ink-2); }

  .px-intro__desks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: 16px; }
  .px-intro__desk { display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 0; }
  .px-intro__desk :global(.px-intro__dmark) { width: 40px; height: 40px; }
  .px-intro__dnames { display: flex; flex-direction: column; align-items: center; gap: 2px; min-width: 0; text-align: center; }
  .px-intro__dn { font: 700 17px/1.15 var(--font-display); letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; }
  .px-intro__dr { font: 600 12px/1.2 var(--font-ui); letter-spacing: 0.18em; text-transform: uppercase; min-height: 30px; }

  /* ── 3 · three cards on the path rail. ───────────────────────────────── */
  .px-intro__path {
    position: relative; box-sizing: border-box;
    width: 784px; padding: 20px 24px;
    background: var(--paper-3); border-radius: var(--r-card);
  }
  .px-intro__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 20px; }
  .px-intro__step { display: flex; flex-direction: column-reverse; gap: 16px; min-width: 0; }
  .px-intro__num {
    position: relative; z-index: 1;
    align-self: center;
    width: 28px; height: 28px; margin: 10px 0; border-radius: 999px;
    display: flex; align-items: center; justify-content: center;
    background: var(--ink); color: var(--paper);
    font: 600 13px/1 var(--font-ui); font-variant-numeric: tabular-nums;
  }
  .px-intro__rail { position: absolute; display: block; background: var(--ink-2); }
  .px-intro__rail--x { height: 2px; left: calc(24px + (100% - 88px) / 6); right: calc(24px + (100% - 88px) / 6); bottom: 43px; transform-origin: 0 50%; }
  .px-intro__rail--y { display: none; transform-origin: 50% 0; }
  .px-intro__card {
    height: 204px; box-sizing: border-box;
    display: flex; flex-direction: column; overflow: hidden;
