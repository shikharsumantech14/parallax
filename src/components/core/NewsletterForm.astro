---
/**
 * The unified "Join" form (JOURNEY-SPEC fix #12).
 *
 * One email field that does two things in a single submit: subscribes the
 * reader to the dispatch AND sends a magic link that opens their free shelf on
 * click. Posts to the app subdomain at /api/join, which upserts the
 * newsletter row and sends one Resend email (confirm + sign-in in one tap).
 *
 * Handles the degraded response `{ ok: true, account: false }` — the
 * subscription saved but the sign-in link couldn't be sent — with its own copy.
 *
 * No third-party JS. Vanilla fetch from a small <script>.
 */

// Where to POST. Same-origin since the merge, so a relative path — it follows
// the reader to whatever host served the page and no redirect can make it
// cross-origin (which is what silently broke this form on 2026-09-06).
const apiUrl = '/api/join';
---

<section class="px-newsletter" data-api-url={apiUrl} aria-labelledby="px-newsletter-title">
  <div class="px-newsletter__inner">
    <h2 class="px-newsletter__title" id="px-newsletter-title">
      One email. Two things.
    </h2>
    <p class="px-newsletter__dek">
      The dispatch when each issue ships — and a free shelf that saves your
      place. One click in your inbox does both.
    </p>

    <form class="px-newsletter__form" id="px-newsletter-form" novalidate>
      <label class="px-newsletter__label" for="px-newsletter-email">Your email</label>
      <div class="px-newsletter__row">
        <input
          class="px-newsletter__input"
          id="px-newsletter-email"
          name="email"
          type="email"
          required
          placeholder="you@example.com"
          autocomplete="email"
        />
        <button class="px-newsletter__submit" type="submit">Subscribe</button>
      </div>
      <p class="px-newsletter__status" id="px-newsletter-status" aria-live="polite"></p>
    </form>
    <p class="px-newsletter__nojs">Enable JavaScript to subscribe.</p>
  </div>
</section>

<script is:inline>
  (function () {
    let root = document.currentScript ? document.currentScript.previousElementSibling : null;
    while (root && !(root.classList && root.classList.contains('px-newsletter'))) {
      root = root.previousElementSibling;
    }
    const apiUrl = (root && root.dataset && root.dataset.apiUrl) || '/api/join';
    const form = document.getElementById('px-newsletter-form');
    const input = document.getElementById('px-newsletter-email');
    const button = form?.querySelector('button[type="submit"]');
    const status = document.getElementById('px-newsletter-status');

    if (!form || !input || !button || !status) return;

    const setStatus = function (text, kind) {
      status.textContent = text;
      status.className =
        'px-newsletter__status' +
        (kind === 'err'
          ? ' px-newsletter__status--err'
          : kind === 'ok'
          ? ' px-newsletter__status--ok'
          : '');
    };

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) {
        setStatus('Please enter your email.', 'err');
        return;
      }

      input.disabled = true;
      button.disabled = true;
      setStatus('Sending…');

      try {
        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email }),
        });
        const data = await res.json().catch(function () { return {}; });

        if (res.ok && data.ok) {
          setStatus(
            data.account === false
              ? "You're subscribed. The sign-in link couldn't be sent — you can open your shelf any time from the masthead."
              : 'Check your inbox — one tap subscribes you and opens your shelf.',
            'ok',
          );
          button.textContent = 'Sent';
          input.value = '';
        } else {
          setStatus(
            data.error || 'Could not subscribe. Try again in a moment.',
            'err',
          );
          input.disabled = false;
          button.disabled = false;
        }
      } catch (err) {
        setStatus('Network error. Try again in a moment.', 'err');
        input.disabled = false;
        button.disabled = false;
      }
    });
  })();
</script>

<style>
  /* Launch design (2026-09-08): the row IS the form — a transparent field on a
     rule-2 hairline with no right border, butted against a square ink button.
     No radius, no shadow, one inherited typeface. The title and dek below are
     for the mounts that need a heading of their own (the colophon, the home
     strip); /subscribe hides them because its own h1 already says it. */
  .px-newsletter {
    margin: 72px 0 48px;
    padding: 36px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .px-newsletter__inner {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .px-newsletter__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .px-newsletter__dek {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 20px;
    max-width: 52ch;
  }

  .px-newsletter__form {
    margin: 0;
  }
  .px-newsletter__label {
    display: block;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .px-newsletter__row {
    display: flex;
    max-width: 460px;
  }
  .px-newsletter__input {
    flex: 1;
    min-width: 0;
    font-family: inherit;
    font-size: 15px;
    padding: 14px;
    border: 1px solid color-mix(in oklab, var(--ink) 26%, transparent);
    border-right: 0;
    background: transparent;
    color: var(--ink);
    border-radius: 0;
    outline: none;
    transition: border-color var(--t-quick) var(--ease);
  }
  .px-newsletter__input::placeholder { color: var(--muted); }
  .px-newsletter__input:focus {
    border-color: var(--ink);
  }
  .px-newsletter__input:disabled {
    color: var(--muted);
  }
  .px-newsletter__submit {
    font-family: inherit;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 14px 20px;
    border: 0;
    border-radius: 0;
    background: var(--ink);
    color: var(--bg);
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--t-quick) var(--ease), color var(--t-quick) var(--ease);
  }
  .px-newsletter__submit:hover {
    background: var(--accent-deep, var(--accent));
    color: var(--on-accent, var(--bg));
  }
  .px-newsletter__submit:disabled {
    background: var(--muted);
    cursor: not-allowed;
  }

  .px-newsletter__status {
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    margin: 12px 0 0;
    min-height: 1.2em;
  }
  .px-newsletter__status--ok { color: var(--accent-deep, var(--accent)); }
  .px-newsletter__status--err { color: var(--danger, #c0392b); }

  /* The form does a fetch(), so it's useless — and misleading (a native GET
     would reload with the email in the URL) — without JS. Under no-JS, hide
     the form and show a plain line instead. `html.js` is set by the inline
     head guard before this renders, so there's no flash for JS users. */
  .px-newsletter__nojs {
    display: none;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    margin: 12px 0 0;
  }
  :global(html:not(.js)) .px-newsletter__form { display: none; }
  :global(html:not(.js)) .px-newsletter__nojs { display: block; }

  /* The row stays a row on phones — both artboards draw it that way, and the
     field shrinks (min-width: 0) rather than the button wrapping. */
  @media (max-width: 768px) {
    .px-newsletter { margin: 56px 0 32px; padding: 28px 0; }
    .px-newsletter__submit { padding: 14px 16px; }
  }
</style>
