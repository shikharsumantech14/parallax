---
/**
 * ReadingToolbar — the reading strip (launch design, 2026-09-08).
 *
 * The handoff's toolbar, pinned: a flat bar on the paper with a 2px ink rule
 * on top, carrying the progress hairline (accent fill), "42% · 4 min left",
 * the square Full ⇄ Skim toggle and Save. It slides up once the reader has
 * scrolled a little, and sits above the phone's home bar (safe-area inset).
 *
 * The Full/Skim toggle drives `#px-article[data-mode]` (the skim CSS in
 * base.css is unchanged). Pressing "S" toggles it too. Progressive
 * enhancement: with no JS the bar never appears and the reader gets the full
 * article (skim was always JS-only).
 */
import SaveButton from './SaveButton.astro';

interface Props {
  readTime?: number;
  issueId: string;
  theme?: 'light' | 'dark';
}
const { readTime = 7, issueId, theme = 'light' } = Astro.props;
---

<div class="rtb" data-theme={theme} role="group" aria-label="Reading controls" data-read={readTime}>
  <span class="rtb__track" aria-hidden="true"><span class="rtb__fill"></span></span>
  <span class="rtb__meta"><b class="rtb__pct">0%</b> · <span class="rtb__left">{readTime} min left</span></span>
  <div class="rtb__seg" data-mode="full">
    <button class="rtb__seg-btn is-active" type="button" data-mode="full" aria-pressed="true">Full</button>
    <button class="rtb__seg-btn" type="button" data-mode="skim" aria-pressed="false">Skim</button>
  </div>
  <span class="rtb__hint">Press <b>S</b></span>
  <SaveButton issueId={issueId} />
</div>

<script is:inline>
  (function () {
    var bar = document.querySelector('.rtb');
    if (!bar) return;
    var fill = bar.querySelector('.rtb__fill');
    var seg = bar.querySelector('.rtb__seg');
    var pctEl = bar.querySelector('.rtb__pct');
    var leftEl = bar.querySelector('.rtb__left');
    var article = document.getElementById('px-article');
    var btns = bar.querySelectorAll('.rtb__seg-btn');
    var total = parseInt(bar.getAttribute('data-read') || '7', 10) || 7;

    function setMode(mode) {
      if (article) article.setAttribute('data-mode', mode);
      if (seg) seg.setAttribute('data-mode', mode);
      btns.forEach(function (b) {
        var on = b.getAttribute('data-mode') === mode;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () { setMode(b.getAttribute('data-mode')); });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 's' && e.key !== 'S') return;
      var t = e.target || {};
      var tag = t.tagName || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || t.isContentEditable) return;
      var cur = article ? article.getAttribute('data-mode') : 'full';
      setMode(cur === 'skim' ? 'full' : 'skim');
    });

    function onScroll() {
      var max = document.documentElement.scrollHeight - window.innerHeight;
      var p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      if (fill) fill.style.width = (p * 100).toFixed(2) + '%';
      if (pctEl) pctEl.textContent = Math.round(p * 100) + '%';
      if (leftEl) {
        var left = Math.max(0, Math.round(total * (1 - p)));
        leftEl.textContent = left <= 0 ? 'done' : left + ' min left';
      }
      bar.classList.toggle('is-shown', p > 0.04);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  })();
</script>

<style>
  /* Only JS shows it: html.js is the head guard every hidden state is gated on. */
  .rtb { display: none; }
  :global(html.js) .rtb {
    position: fixed; left: 0; right: 0; bottom: 0;
    z-index: 90;
    display: flex; align-items: center; gap: 14px;
    padding: 10px 40px calc(10px + env(safe-area-inset-bottom, 0px));
    background: var(--bg);
    border-top: 2px solid var(--ink);
    transform: translateY(100%);
    transition: transform var(--t-soft) var(--ease);
  }
  :global(html.js) .rtb.is-shown { transform: translateY(0); }

  .rtb__track { flex: 1; height: 2px; background: var(--rule); display: block; min-width: 40px; }
  .rtb__fill { display: block; height: 100%; width: 0; background: var(--accent); transition: width 80ms linear; }
  .rtb__meta, .rtb__hint {
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .rtb__meta b, .rtb__hint b { color: var(--ink); font-weight: 600; }

  .rtb__seg { display: inline-flex; border: 1px solid var(--ink); }
  .rtb__seg-btn {
    font-family: inherit;
    font-size: 10px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase;
    padding: 7px 12px;
    color: var(--muted);
    background: transparent;
    border: 0;
    cursor: pointer;
    min-height: 32px;
    transition: background var(--t-quick) var(--ease), color var(--t-quick) var(--ease);
  }
  .rtb__seg-btn.is-active { background: var(--ink); color: var(--bg); }
  .rtb__seg-btn:focus-visible { outline: 2px solid var(--accent-deep, var(--accent)); outline-offset: -2px; }

  /* Save reads as one more square control in the strip. */
  .rtb :global(.px-save__btn) { border-radius: 0; padding: 7px 12px; white-space: nowrap; min-height: 32px; }

  @media (max-width: 768px) {
    :global(html.js) .rtb { padding: 8px 20px calc(8px + env(safe-area-inset-bottom, 0px)); gap: 10px; }
    .rtb__hint { display: none; }
    .rtb__track { min-width: 24px; }
  }
  @media (max-width: 480px) {
    .rtb__meta { display: none; }
    .rtb :global(.px-save__btn) { padding: 7px 10px; font-size: 10px; letter-spacing: 0.12em; }
  }
  /* The 44px touch floor for the strip's controls (launch audit: they measured
     32px). The strip's own padding tightens so it grows by 6px, not 12. */
  @media (pointer: coarse) {
    .rtb__seg-btn, .rtb :global(.px-save__btn) { min-height: 44px; }
    :global(html.js) .rtb { padding-top: 6px; }
  }
</style>
