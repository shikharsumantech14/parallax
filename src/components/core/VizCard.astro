---
/**
 * VizCard — the shared shell the newer section kinds render inside.
 *
 * WHY THIS EXISTS (RD-01a, docs/REVAMP-PLAN.md §1): a kind that routes its
 * chrome through one file can change shell with one edit instead of markup
 * surgery on every component.
 *
 * WHERE IT SITS (Lens Phase 3, 2026-09-30). Inside the pinned figure panel of
 * core/Section.astro, the reading system (docs/design/LENS.md §5):
 *
 *   article column   eyebrow · title · intro · the kind's sentences · caption
 *   figure panel     "Figure n · k cues"  ·  VizCard [<slot/> the graphic]  ·  source
 *
 * The how-to-read panel this card used to carry is RETIRED with the plain
 * line and the expand modal (LENS §10): the cues and the one caption do that
 * work. `howToRead` is still accepted so a stray caller compiles; it renders
 * nothing. In the reading system SectionBody hands the card no caption (the
 * article column holds the one copy), so the caption row renders only in
 * story mode, where story.css hides it anyway. `source` is accepted and never
 * rendered: core/Section.astro prints it once.
 */
import { renderInline } from '../../lib/text';

interface Props {
  /** Component prefix, e.g. `px-fnl`. Joined to the shared `px-viz` root so
   *  the kit's reveal attaches. */
  prefix: string;
  /** Retired (Lens Phase 3). Accepted, never rendered. */
  howToRead?: string;
  /** The DATA claim. Inline emphasis is rendered. */
  caption?: string;
  /** Either a plain string or `{ label, date }` from the section schema. */
  source?: string | { label: string; date?: string };
  /** Optional right-hand chip in the caption row (e.g. an honesty chip). */
  chip?: string;
  /** Extra classes / inline style passthrough for per-kind animation vars. */
  class?: string;
  style?: string;
}

const { prefix, caption, chip, class: extra, style } = Astro.props;
---

<div class:list={['px-viz', prefix, extra]} data-build-scene style={style}>
  {caption && (
    <div class="px-viz__cap">
      <span set:html={renderInline(caption)} />
      {chip && <b>{chip}</b>}
    </div>
  )}

  <slot />
</div>
