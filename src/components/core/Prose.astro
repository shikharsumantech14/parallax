---
/**
 * Prose — the section is its own paragraphs (`kind: prose`).
 *
 * LENS PHASE 6 (2026-09-30), the board Lib-prose: the first paragraph opens
 * on a drop cap in the desk text colour, three lines deep; the rest is the
 * article at the reading system's 18/1.6 (base.css `.px-prose*`). The skim
 * band is SectionRenderer's (`skimCaption`). The board's pulled figure was
 * drawn from one issue's numbers; `prose` carries no number field, so none is
 * invented here. A NARRATIVE kind (LENS §5.1): no cue anchors, no figure
 * panel, in the article column.
 *
 * THE BUILD (LENS §6.4): the root is a `data-build-scene`; the paragraphs
 * rise in order, 80ms apart (src/scripts/build.ts). No JS or reduced motion:
 * the text as written.
 */
import { renderInline } from '../../lib/text';

interface Props {
  paragraphs: string[];
  lead?: string;
}
const { paragraphs, lead } = Astro.props;
---

<div class="px-prose px-prose--lens" data-build-scene>
  {lead && <p class="px-prose__lead" data-build="1" data-build-kind="rise" set:html={renderInline(lead)} />}
  {paragraphs.map((p) => (
    <p class="px-prose__p" data-build="1" data-build-kind="rise" set:html={renderInline(p)} />
  ))}
</div>

<style>
  /* The drop cap: the first letter of the first paragraph, three lines deep. */
  .px-prose--lens > p:first-child::first-letter {
    float: left;
    margin: 0.06em 0.1em 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 4.3em;
    line-height: 0.82;
    color: var(--accent-deep);
  }
</style>
