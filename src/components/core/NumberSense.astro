---
/**
 * NumberSense (`number-sense`) — one figure at the size it deserves and, beside
 * it, the one to three everyday things that are the same size, so the size is
 * felt rather than read. Blueprint: docs/design/blueprints/core/number-sense.md
 * Pure HTML/CSS, zero JS. Universal, so core/. Prefix `px-ns`.
 *
 * SHELL. `core/VizCard.astro` owns the caption row AND the `data-build-scene`
 * root (Lens Phase 5) — this component adds neither and must not add a second
 * scene. The caption and the `Source · …` line are `core/Section.astro`'s, for
 * every kind (the how-to-read panel and the plain line are gone, LENS §10).
 *
 * THE VALUE IS NOT A COUNTER, deliberately: a build counter's in-between
 * frames are grouped en-US, and this figure is often Indian-grouped
 * (15,00,000), so the tween would regroup it on the way up. It RISES instead,
 * and always shows exactly what was authored (CANON §7).
 *
 * LENS PHASE 6 (2026-09-30), the board Lib-number-sense: the figure at up to
 * 96px (LENS §7, a kind that IS a number) under its label, the note under it,
 * then each everyday equivalent as a card with its ≈ sign. The figure is
 * sized against the box (`cqi`), so it never outgrows its column.
 *
 * Cue anchors:
 *   value   the figure and its label
 *   note    the note under the figure
 *   1..n    each `equals` row, in data order
 *
 * THE BUILD (LENS §6.4, on VizCard's scene): 1 the equivalents drop in, 80ms
 * apart, 2 the label and the note rise, 3 the figure rises.
 */
import VizCard from './VizCard.astro';
import { renderInline } from '../../lib/text';

interface Equal {
  /** ≤14 words: the same amount said in a thing the reader already knows. */
  text: string;
  /** ≤12 words: the basis. A traced claim in its own right, like `text`. */
  note?: string;
}
interface Props {
  /** As authored, WITH its formatting ("15,000", "1.47"). Never reformatted. */
  value: string;
  unit?: string;
  label: string;
  equals: Equal[];
  note?: string;
  caption?: string;
  /** Accepted and ignored — Section renders it. Object form per §3's example. */
  source?: string | { label: string; date?: string };
}
const { value, unit, label, equals = [], note, caption, source } = Astro.props;

/* Build-time validation (§3). A big number with nothing beside it is a one-tile
   data-readout, not this kind — the comparison IS the component, so failing
   loudly beats publishing a figure nobody can feel. */
if (typeof value !== 'string' || !value.trim())
  throw new Error('[number-sense] `value` is required, as an authored string carrying its own formatting.');
if (typeof label !== 'string' || !label.trim())
  throw new Error('[number-sense] `label` is required — an unlabelled number states nothing.');
if (equals.length < 1 || equals.length > 3)
  throw new Error(`[number-sense] needs 1–3 \`equals\` rows, got ${equals.length}. See blueprint §3.`);
for (const e of equals)
  if (!e || typeof e.text !== 'string' || !e.text.trim())
    throw new Error('[number-sense] every `equals` row needs a non-empty `text`.');
---

<VizCard prefix="px-ns" caption={caption} source={source}>
  <div class="px-ns__box">
    <div class="px-ns__num" data-cue="value">
      <p class="px-ns__k" data-build="2" data-build-kind="rise"><span class="px-cue-tag" data-cue-tag="value" hidden></span>{label}</p>
      <p class="px-ns__v"><span class="px-ns__n" data-build="3" data-build-kind="rise">{value}</span>{unit && <span class="px-ns__u">{unit}</span>}</p>
    </div>
    {note && (
      <p class="px-ns__note" data-cue="note" data-build="2" data-build-kind="rise"><span class="px-cue-tag" data-cue-tag="note" hidden></span><span set:html={renderInline(note)} /></p>
    )}

    <ul class="px-ns__eq">
      {equals.map((e, i) => (
        <li class="px-ns__row" data-cue={i + 1} data-build="1" data-build-kind="drop">
          <span class="px-ns__sign" aria-hidden="true">≈</span>
          <p class="px-ns__t">
            <span class="px-ns__tt"><span class="px-cue-tag" data-cue-tag={i + 1} hidden></span><span set:html={renderInline(e.text)} /></span>
            {e.note && <span class="px-ns__nn"><Fragment set:html={renderInline(e.note)} /></span>}
          </p>
        </li>
      ))}
    </ul>
  </div>
</VizCard>

<style>
  .px-ns__box { container-type: inline-size; min-width: 0; }
  .px-ns__num { min-width: 0; border-radius: var(--r-ctl); }
  .px-ns__k {
    display: flex;
    align-items: center;
    margin: 0 0 10px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }
  /* The unit sits on the figure's baseline and wraps under it on a narrow box. */
  .px-ns__v {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 14px; margin: 0;
  }
  .px-ns__n {
    font-family: var(--font-ui); font-weight: 600;
    font-size: min(96px, 22cqi); line-height: 0.92; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--ink);
    overflow-wrap: anywhere;
  }
  .px-ns__u {
    font-family: var(--font-ui); font-weight: 500; font-size: 20px;
    line-height: 1.2; color: var(--ink-2);
  }
  .px-ns__note {
    display: flex;
    align-items: flex-start;
    margin: 12px 0 0;
    font-family: var(--font-ui);
    font-size: 14px; line-height: 1.5; color: var(--muted);
    border-radius: var(--r-ctl);
  }

  .px-ns__eq { margin: 18px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .px-ns__row {
    display: grid; grid-template-columns: 28px minmax(0, 1fr); align-items: baseline;
    padding: 14px 16px;
    background: var(--paper);
    border: 1px solid var(--hair);
    border-left: 3px solid var(--accent);
    border-radius: var(--r-card);
  }
  .px-ns__sign {
    font-family: var(--font-display); font-size: 24px; line-height: 1;
    color: var(--accent-deep);
  }
  .px-ns__t { margin: 0; min-width: 0; }
  .px-ns__tt {
    display: flex; align-items: baseline;
    font-family: var(--font-display);
    font-size: 20px; line-height: 1.35; color: var(--ink);
    overflow-wrap: break-word;
  }
  .px-ns__tt :global(.px-cue-tag) { align-self: center; }
  .px-ns__nn {
    display: block; margin-top: 4px;
    font-family: var(--font-ui);
    font-size: 13px; line-height: 1.45; color: var(--muted);
  }
  /* The headline number (LENS §7): 96, 72 on phones. */
  @media (max-width: 1023px) { .px-ns__n { font-size: min(72px, 24cqi); } }
  @container (max-width: 380px) {
    .px-ns__u { flex-basis: 100%; font-size: 16px; }
    .px-ns__row { padding: 12px; grid-template-columns: 24px minmax(0, 1fr); }
    .px-ns__tt { font-size: 18px; }
  }
</style>
