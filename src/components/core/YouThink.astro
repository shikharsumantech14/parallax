---
/**
 * YouThink (`you-think`) — the brand promise as a component: on the left the
 * belief the reader walked in with, on the right the number that corrects it.
 *
 * Blueprint: docs/design/blueprints/core/you-think.md
 * Pure HTML/CSS — no SVG, no JS, no WebGL. Universal kind (it wears whatever
 * theme the issue sets). Prefix `px-yt`.
 *
 * Shell is core/VizCard.astro: the caption row and the graphic slot, nothing
 * else. This component renders NO source and NO caption of its own —
 * core/Section.astro owns both (LENS §5.1; the plain line and the how-to-read
 * panel it once also owned were removed in Lens Phase 8).
 * `source` is accepted and handed on exactly as its siblings do, so the
 * dispatch line reads the same; VizCard ignores it. VizCard's root is the
 * `data-build-scene` (Lens Phase 5, LENS §6.4), so this component only
 * declares its order: 1 the belief drops in, 2 the slash fades, 3 the
 * record drops, 4 its figure counts up to the value in the HTML when it is one
 * plain number (else it rises). No motion of its own (src/scripts/build.ts).
 *
 * Cue anchors:
 *   1  the belief panel
 *   2  the record panel
 *   3  the record's figure
 */
import VizCard from './VizCard.astro';
import { renderInline } from '../../lib/text';

interface Props {
  think: { label?: string; text: string };
  actually: { label?: string; value?: string; unit?: string; text: string };
  note?: string;
  caption?: string;
  /** Accepted and ignored — core/Section.astro prints it. Never a `__src` here. */
  source?: string | { label: string; date?: string };
  /** The Lens reading system (Phase 3): the article column beside the figure
   *  carries both texts with their cues, so the figure keeps the two labels,
   *  the belief as a dashed box and the record as a ruled one with its
   *  figure. Cue anchors, in data order: "1" the belief panel, "2" the record
   *  panel, "3" the record's figure. */
  compact?: boolean;
}

const { think, actually, note, caption, source, compact = false } = Astro.props;
const tag = (k: number) => `<span class="px-cue-tag" data-cue-tag="${k}" hidden></span>`;
/* The figure counts up only when it is ONE plain number with any text around
   it ("1,330", "£120m", "28.3%"); a range or a phrase ("1 in 3") rises. */
const numOf = (v?: string) => {
  const m = /^[^\d]*?(\d{1,3}(?:,\d{3})+|\d+)(\.\d)?[^\d]*$/.exec(v ?? '');
  return m ? { n: parseFloat((m[1] + (m[2] ?? '')).replace(/,/g, '')), dp: !!m[2] } : null;
};
const num = numOf(actually?.value);
/* The figure never prints a cue button: those belong to the article. */
const noCue = (t: string) => String(t ?? '').replace(/\[\[\d+\]\]\s*/g, '');

/* A belief with no correction — or a correction with no belief — is half an
   argument, and would publish as a full panel beside an empty one. Loud at
   build time, as the rest of this wave is. */
if (!think?.text) {
  throw new Error('[you-think] think.text is required — the belief being corrected is half the component.');
}
if (!actually?.text) {
  throw new Error('[you-think] actually.text is required — a bare figure with no reading is not a correction.');
}
---

<VizCard prefix="px-yt" caption={caption} source={source} class={compact ? 'px-yt--compact' : undefined}>
  <div class="px-yt__card">
    <div class="px-yt__panel px-yt__panel--think" data-cue="1" data-build="1" data-build-kind="drop">
      <p class="px-yt__k"><Fragment set:html={tag(1)} />{think.label ?? 'What most people think'}</p>
      <p class="px-yt__t px-yt__t--struck" set:html={renderInline(noCue(think.text))} />
    </div>

    {/* The slash: the belief above, the record below, one mark between. */}
    <svg class="px-yt__slash" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" data-build="2">
      <polygon points="0,0 100,0 100,18 0,82" style="fill:var(--paper-3)" />
      <polygon points="0,82 100,18 100,100 0,100" style="fill:var(--accent-tint)" />
      <line x1="0" y1="82" x2="100" y2="18" vector-effect="non-scaling-stroke" style="stroke:var(--accent);stroke-width:5" />
      <line x1="0" y1="96" x2="100" y2="32" vector-effect="non-scaling-stroke" style="stroke:var(--accent);stroke-width:1.5" />
    </svg>

    <div class="px-yt__panel px-yt__panel--act" data-cue="2" data-build="3" data-build-kind="drop">
      <p class="px-yt__k"><Fragment set:html={tag(2)} />{actually.label ?? 'What the data shows'}</p>
      {actually.value && (
        <p class="px-yt__v" data-cue="3">
          <Fragment set:html={tag(3)} />{num ? <span class="px-yt__n" data-build="4" data-build-kind="counter" data-to={num.n} data-format={num.dp ? '1dp' : undefined}>{actually.value}</span> : <span class="px-yt__n" data-build="4" data-build-kind="rise">{actually.value}</span>}{actually.unit && <span class="px-yt__u">{actually.unit}</span>}
        </p>
      )}
      {!compact && <p class="px-yt__t" set:html={renderInline(noCue(actually.text))} />}
    </div>
  </div>

  {!compact && note && <p class="px-yt__note" set:html={renderInline(note)} />}
</VizCard>

<style>
  /* Lens Phase 6 (2026-09-30), the board Lib-you-think: ONE card cut by a
     diagonal slash. Above it, on the well, the belief, struck through; below
     it, on the desk tint, the record and its figure at up to 96px (LENS §7).
     In the reading system (`compact`) the record's sentence is the article's,
     so the figure keeps the label and the number; the belief stays, struck,
     because the strike IS the drawing. */
  .px-yt__card {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-card);
    overflow: hidden;
    container-type: inline-size;
  }
  .px-yt__panel { padding: 20px 22px; min-width: 0; }
  .px-yt__panel--think { background: var(--paper-3); padding-bottom: 6px; }
  .px-yt__panel--act { background: var(--accent-tint); padding-top: 4px; padding-left: max(22px, 30cqi); }
  .px-yt__slash { display: block; width: 100%; height: 72px; margin: 0; }
  /* The card clips its corners, so a lit panel's ring is drawn inside it. */
  :global(.px-rs > .px-fig) .px-yt__panel[data-cue] { outline-offset: -4px; }

  .px-yt__k {
    display: flex;
    align-items: center;
    margin: 0 0 10px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .px-yt__panel--act .px-yt__k { color: var(--accent-deep); }

  .px-yt__t {
    margin: 0;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink);
    overflow-wrap: break-word;
  }
  .px-yt__t--struck {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink-2);
    text-decoration: line-through;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .px-yt__panel--act .px-yt__t { font-family: var(--font-ui); font-size: 15px; margin-top: 12px; }

  .px-yt__v {
    margin: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
  }
  .px-yt__v :global(.px-cue-tag) { align-self: center; }
  .px-yt__n {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: min(96px, 21cqi);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-deep);
    overflow-wrap: anywhere;
    padding-bottom: 0.12em;
  }
  .px-yt__u {
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .px-yt__note {
    margin: 0;
    padding: 12px 0 0;
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* The record's figure is the headline number (LENS §7): 96, 72 on phones. */
  @media (max-width: 1023px) { .px-yt__n { font-size: min(72px, 22cqi); } }
  @container (max-width: 380px) {
    .px-yt__panel { padding: 16px; }
    .px-yt__panel--think { padding-bottom: 4px; }
    .px-yt__panel--act { padding-left: 16px; padding-top: 2px; }
    .px-yt__slash { height: 48px; }
    .px-yt__t--struck { font-size: 18px; }
  }
</style>
