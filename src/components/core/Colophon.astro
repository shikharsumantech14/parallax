---
/**
 * Colophon — the footer (Lens, 2026-09-30, Phase 2; the Home board's footer).
 *
 * On --paper-3 under a 1px hair, stepped out to the frame edge like the
 * masthead. Left (six of twelve columns): the lockup at 28px (the house cut,
 * tight, its ground cut from the footer's own paper), the promise "Stories you
 * think you already understand.", and the six desks as chips, each with its
 * own medallion at 20px. Right (the other six): three link columns, Read,
 * Parallax and Account. Under a hair-2 rule, the colophon line and the two
 * legal pages. Phones stack it: lockup, promise, chips, the three columns,
 * the line.
 *
 * The footer is the same on every layout that mounts it: it always carries
 * the house cut, whatever desk the page stands in (`desk` is accepted for
 * call-site compatibility and ignored). The chips use the lettered MARK cut
 * at 20px, which is below the 24px step where Mark would otherwise reverse
 * it: a reversed cut is an ink disc with no desk colour, and six identical
 * discs would not tell the desks apart.
 *
 * The optional NewsletterForm above it survives from the previous footer; the
 * home page and /subscribe carry their own form and pass `newsletter={false}`.
 *
 * Prefix: px-col. No JS of its own.
 */
import { getCollection } from 'astro:content';
import NewsletterForm from './NewsletterForm.astro';
import Mark from './Mark.astro';
import { TOPICS, type Topic } from '../../content/config';
import { DESK_COPY } from '../../lib/desks';
import { ink } from '../../lib/desk-inks';

interface Props {
  /** Accepted for call-site compatibility; the footer is the same everywhere. */
  desk?: Topic;
  newsletter?: boolean;
}
const { newsletter = true } = Astro.props;

const year = new Date().getFullYear();

/* "Latest issue" opens the newest published issue; with none yet, the archive. */
const published = await getCollection('issues', (e) => e.data.status !== 'draft');
const latest = [...published].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || b.slug.localeCompare(a.slug)
)[0];

const columns: { label: string; links: { label: string; href: string }[] }[] = [
  {
    label: 'Read',
    links: [
      { label: 'Latest issue', href: latest ? `/issues/${latest.slug}/` : '/archive/' },
      { label: 'Desks', href: '/#desks' },
      { label: 'Archive', href: '/archive/' },
    ],
  },
  {
    label: 'Parallax',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Subscribe', href: '/subscribe/' },
      { label: 'RSS', href: '/rss.xml' },
    ],
  },
  {
    label: 'Account',
    links: [
      { label: 'Sign in', href: '/login' },
      { label: 'Your shelf', href: '/dashboard' },
    ],
  },
];
---

{newsletter && <NewsletterForm />}

<footer class="px-col">
  <div class="px-col__grid">
    <div class="px-col__brand-cell">
      <a class="px-col__brand" href="/" aria-label="Parallax, home">
        <Mark size={28} ring={10} tight ground="var(--paper-3)" />
        <span class="px-col__name">Parallax</span>
      </a>
      <p class="px-col__promise">Stories you think you already understand.</p>
      <ul class="px-col__desks" aria-label="The six desks">
        {TOPICS.map((t) => (
          <li>
            <a class="px-chip px-col__desk" href={`/topics/${t}/`} style={`--dk-tint: ${ink(t, 'tint')}; --dk-text: ${ink(t, 'text')}`}>
              <Mark desk={t} size={20} cut="mark" ground={ink(t, 'tint')} />
              {DESK_COPY[t].name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="px-col__links">
      {columns.map((c) => (
        <nav aria-label={c.label}>
          <p class="px-col__h">{c.label}</p>
          <ul>
            {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="px-col__legal">
    <span>© {year} Parallax Lens™ · Registered in India · No analytics, no cookies, no trackers</span>
    <span class="px-col__legal-links">
      <a href="/about/privacy/">Privacy</a>
      <a href="/about/terms/">Terms</a>
    </span>
  </div>
</footer>

<style>
  .px-col {
    display: flex; flex-direction: column; gap: 32px;
    margin-inline: calc(-1 * var(--wrap-pad, 0px));
    padding: 40px var(--wrap-pad, 64px) 28px;
    background: var(--paper-3);
    border-top: 1px solid var(--hair);
    color: var(--ink);
  }
  .px-col__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .px-col__brand-cell {
    grid-column: span 6;
    display: flex; flex-direction: column; align-items: flex-start; gap: 16px;
    min-width: 0;
  }
  .px-col__brand {
    display: inline-flex; align-items: center; gap: 12px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .px-col__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
    letter-spacing: -0.02em;
    position: relative; top: -1px;   /* cap centre on the disc centre, as in the masthead */
  }
  .px-col__promise {
    margin: 0;
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 34ch;
    text-wrap: pretty;
  }
  .px-col__desks {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  /* The desk chip is a link, so it keeps the control chip's 44px touch height
     from base.css, but wears the label chip's colours (LENS §4.2): the desk
     tint, the desk text ink. The medallion leads it, its crescent cut from the
     tint. Hover draws the ink border every clickable surface takes. */
  .px-col__desk {
    padding: 0 16px 0 12px; gap: 8px;
    background: var(--dk-tint);
    border-color: var(--dk-tint);
    color: var(--dk-text);
    font-weight: 500;
  }
  .px-col__desk:hover { border-color: var(--ink); }
  .px-col__links {
    grid-column: span 6;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    min-width: 0;
  }
  .px-col__h {
    margin: 0 0 10px;
    font-family: var(--font-ui);
    font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    line-height: 1.4;
    color: var(--muted);
  }
  .px-col__links ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .px-col__links a,
  .px-col__legal-links a {
    font-family: var(--font-ui);
    color: var(--ink-2);
    text-decoration: none;
    text-underline-offset: 4px;
    transition: color var(--t-micro) var(--ease);
  }
  .px-col__links a { font-size: 15px; line-height: 1.4; }
  .px-col__links a:hover,
  .px-col__legal-links a:hover { color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; }
  .px-col a:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .px-col__legal {
    display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px 24px;
    padding-top: 20px;
    border-top: 1px solid var(--hair-2);
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }
  .px-col__legal-links { display: inline-flex; gap: 20px; }
  .px-col__legal-links a { font-size: 13px; }

  @media (max-width: 900px) {
    .px-col__brand-cell, .px-col__links { grid-column: 1 / -1; }
  }
  @media (max-width: 768px) {
    .px-col { padding: 32px var(--wrap-pad, 20px) 24px; }
    .px-col__links { gap: 16px; }
    .px-col__links a { font-size: 14px; }
    .px-col__legal { padding-top: 16px; }
  }
</style>
