---
/**
 * Colophon — the footer (launch design, 2026-09-08, from the canvas).
 *
 * A 4px ink rule, then four columns: the lockup with the brand promise, the
 * six desks with their dots, Read, Practical; under them a hairline and the
 * legal line — "Parallax Lens™ · Registered in India · Trademark cls. 16, 41"
 * on the left, the no-tracking promise on the right. Phones stack it two-up.
 *
 * Same lockup as the masthead (28px disc, 21px wordmark, both nudged to a
 * common cap axis), so the two ends of every page agree. The optional
 * NewsletterForm above it survives from the previous footer; the home page
 * and /subscribe carry their own form and pass `newsletter={false}`.
 *
 * Prefix: px-col. No JS of its own.
 */
import NewsletterForm from './NewsletterForm.astro';
import Mark from './Mark.astro';
import { TOPICS, type Topic } from '../../content/config';

interface Props {
  desk?: Topic;
  newsletter?: boolean;
}
const { newsletter = true, desk } = Astro.props;

const year = new Date().getFullYear();
const deskLabel: Record<Topic, string> = {
  politics: 'Politics', space: 'Space', earth: 'Earth', tech: 'Tech', travel: 'Travel', sports: 'Sports',
};
---

{newsletter && <NewsletterForm />}

<footer class="px-col">
  <div class="px-col__grid">
    <div class="px-col__brand-cell">
      <a class="px-col__brand" href="/" aria-label="Parallax — home">
        <Mark desk={desk} size={28} ring={9} tight />
        <span class="px-col__name">Parallax</span>
      </a>
      <p class="px-col__promise">
        Stories you think you already understand. Six desks, one publication, every claim sourced.
      </p>
    </div>

    <div>
      <p class="px-col__h">Desks</p>
      <ul>
        {TOPICS.map((t) => (
          <li><a href={`/topics/${t}/`}><span class="px-col__dot" style={`background: var(--topic-${t})`} aria-hidden="true"></span>{deskLabel[t]}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="px-col__h">Read</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/archive/">Archive</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/subscribe/">Subscribe</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
    <div class="px-col__practical">
      <p class="px-col__h">Practical</p>
      <ul>
        <li><a href="/dashboard">Your account</a></li>
        <li><a href="/login">Sign in</a></li>
        <li><a href="/about/privacy/">Privacy</a></li>
        <li><a href="/about/terms/">Terms</a></li>
        <li><a href="/about/#colophon">Colophon</a></li>
      </ul>
    </div>
  </div>

  <div class="px-col__legal">
    <span>© {year} Parallax Lens™ · Registered in India · Trademark cls. 16, 41</span>
    <span>No analytics · no cookies · no trackers · no ads</span>
  </div>
</footer>

<style>
  .px-col { border-top: 4px solid var(--ink); }
  .px-col__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 34px;
    padding: 36px 40px 32px;
  }
  .px-col__brand {
    display: inline-flex; align-items: center; gap: 10px;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 12px;
  }
  .px-col__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    line-height: 1;
    letter-spacing: -0.035em;
    position: relative; top: -2px;   /* cap centre on the disc centre (measured) */
  }
  .px-col__promise {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 30ch;
  }
  .px-col__h {
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule);
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ink);
  }
  .px-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .px-col li a {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--t-quick) var(--ease);
  }
  .px-col li a:hover { color: var(--ink); }
  .px-col__dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 auto; }
  .px-col__legal {
    display: flex; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap;
    padding: 14px 40px 18px;
    border-top: 1px solid var(--rule);
    font-size: 9.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    line-height: 1.8;
    color: var(--muted);
  }
  @media (max-width: 768px) {
    .px-col__grid { grid-template-columns: 1fr 1fr; gap: 22px 20px; padding: 26px 20px 24px; }
    .px-col__brand-cell, .px-col__practical { grid-column: 1 / -1; }
    .px-col__legal { padding: 14px 20px 18px; }
  }
</style>
