---
/**
 * NewsletterNotice — the home confirmation ribbon (JOURNEY-SPEC fix #11).
 *
 * After a reader confirms their newsletter subscription, the app redirects to
 * `parallaxlens.com/?newsletter=confirmed`. This slim ribbon closes that
 * previously-dead loop: it confirms the subscription and cross-sells the free
 * shelf (the one remaining click to an account).
 *
 * In-flow bar above the masthead — it occupies no space until JS reveals it on
 * the `?newsletter=confirmed` param, so no-JS / crawlers see nothing (it's a
 * post-action nicety, never content). Dismissible; cleans the URL on show.
 * Prefix: px-nnote.
 */
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.parallaxlens.com';
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://parallaxlens.com';
const shelfHref = `${appUrl}/login?next=${encodeURIComponent(siteUrl + '/')}`;
---

<div class="px-nnote" data-newsletter-notice role="status" aria-live="polite" hidden>
  <div class="px-nnote__inner">
    <span class="px-nnote__dot" aria-hidden="true"></span>
    <span class="px-nnote__msg">You're on the dispatch.</span>
    <a class="px-nnote__cta" href={shelfHref}>One more click: your free shelf →</a>
    <button class="px-nnote__close" type="button" aria-label="Dismiss">
      <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true">
        <path d="M2 2l10 10M12 2L2 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.currentScript ? document.currentScript.previousElementSibling : null;
    while (root && !(root.classList && root.classList.contains('px-nnote'))) {
      root = root.previousElementSibling;
    }
    if (!root) return;

    var params;
    try { params = new URLSearchParams(location.search); } catch (e) { return; }
    if (params.get('newsletter') !== 'confirmed') return;

    // Strip the param so a refresh / share doesn't replay the ribbon.
    try {
      params.delete('newsletter');
      var qs = params.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
    } catch (e) { /* replaceState may be blocked — ribbon still works */ }

    var reduce = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    root.hidden = false;
    void root.offsetWidth; // commit the pre-transition state so the reveal animates
    root.classList.add('is-in');

    function dismiss() {
      root.classList.remove('is-in');
      window.setTimeout(function () { root.hidden = true; }, reduce ? 0 : 320);
    }
    var close = root.querySelector('.px-nnote__close');
    if (close) close.addEventListener('click', dismiss);
  })();
</script>

<style>
  .px-nnote {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    background: color-mix(in oklab, var(--accent) 10%, var(--bg));
    border-bottom: 1px solid color-mix(in oklab, var(--accent) 28%, var(--rule));
    transition: max-height 320ms var(--ease, ease), opacity 320ms var(--ease, ease);
  }
  .px-nnote.is-in { max-height: 80px; opacity: 1; }
  .px-nnote[hidden] { display: none; }

  .px-nnote__inner {
    max-width: var(--col-wide, 1080px);
    margin: 0 auto;
    padding: 10px 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .px-nnote__dot {
    width: 8px; height: 8px; flex: none;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 22%, transparent);
  }
  .px-nnote__msg {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 14px;
    color: var(--ink);
  }
  .px-nnote__cta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-deep, var(--accent));
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);
    padding-bottom: 1px;
  }
  .px-nnote__cta:hover { border-bottom-color: var(--accent-deep, var(--accent)); }
  .px-nnote__close {
    margin-left: auto;
    display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; flex: none;
    background: none; border: 0; padding: 0;
    color: var(--muted); cursor: pointer;
    border-radius: 50%;
    transition: color var(--t-quick, 150ms) var(--ease, ease), background var(--t-quick, 150ms) var(--ease, ease);
  }
  .px-nnote__close:hover { color: var(--ink); background: color-mix(in oklab, var(--ink) 8%, transparent); }

  @media (max-width: 520px) {
    .px-nnote.is-in { max-height: 120px; }
    .px-nnote__close { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .px-nnote { transition: opacity 120ms linear; }
    .px-nnote.is-in { max-height: 200px; }
  }
</style>
