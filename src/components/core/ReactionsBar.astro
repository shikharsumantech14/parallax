---
/**
 * ReactionsBar — "How did this land?" (launch design, 2026-09-08).
 *
 * Four square cells in a 1px hairline grid, each a button: the label in small
 * capitals over its help line. A chosen cell takes the accent tint and a 4px
 * accent edge on the leading side — the handoff's "selected" state. Multi-
 * select; counts appear only after three reactions issue-wide (no "0 likes"
 * loneliness). Anonymous readers see the cells and are sent to sign in on
 * the first click.
 *
 * Root class stays `px-reactions`: core/ReadingGate.astro hides it by name
 * until the wall is passed. Same API as before (`/api/reactions/<id>`).
 */
interface Props {
  issueId: string;
}
const { issueId } = Astro.props;

const KINDS = [
  { id: 'think',     label: 'Made me think',  help: 'This sparked thought I want to sit with.' },
  { id: 'agree',     label: 'Resonates',      help: 'This matches how I read the issue.' },
  { id: 'disagree',  label: 'Challenges me',  help: 'I want to push back on this.' },
  { id: 'want_more', label: 'More like this', help: 'Send me more of this register.' },
];
---

<section class="px-reactions px-band" data-issue-id={issueId} aria-labelledby="px-reactions-title">
  <div class="px-reactions__grid">
    <div class="px-reactions__label">
      <p class="px-eyebrow">Reader signal</p>
      <h2 class="px-reactions__title" id="px-reactions-title">How did this <em>land</em>?</h2>
      <p class="px-reactions__dek">A private signal to the editor. Pick as many as apply — nobody else sees it, and it shapes what runs next.</p>
      <p class="px-reactions__status" aria-live="polite"></p>
    </div>
    <div class="px-reactions__row px-cells" role="group" aria-label="Reaction options">
      {KINDS.map((k) => (
        <button
          type="button"
          class="px-reactions__btn"
          data-kind={k.id}
          data-active="false"
          aria-pressed="false"
        >
          <span class="px-reactions__label-t"><span class="px-reactions__tick" aria-hidden="true">✓ </span>{k.label}<span class="px-reactions__count" aria-hidden="true"></span></span>
          <span class="px-reactions__help">{k.help}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.currentScript.previousElementSibling;
    while (root && !(root.classList && root.classList.contains('px-reactions'))) {
      root = root.previousElementSibling;
    }
    if (!root) return;

    var issueId = root.dataset.issueId;
    var apiUrl = '/api/reactions/' + encodeURIComponent(issueId);
    var btns = root.querySelectorAll('.px-reactions__btn');
    var statusEl = root.querySelector('.px-reactions__status');

    var state = { userKinds: [], counts: null, signedOut: true };

    function applyState() {
      btns.forEach(function (btn) {
        var kind = btn.dataset.kind;
        var active = state.userKinds.indexOf(kind) !== -1;
        btn.dataset.active = active ? 'true' : 'false';
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        var countEl = btn.querySelector('.px-reactions__count');
        if (countEl) {
          var n = state.counts && state.counts[kind] ? state.counts[kind] : 0;
          countEl.textContent = state.counts && n > 0 ? ' · ' + n : '';
        }
      });
    }

    function setStatus(text, kind) {
      statusEl.textContent = text || '';
      statusEl.className = 'px-reactions__status' + (kind === 'err' ? ' px-reactions__status--err' : '');
    }

    fetch(apiUrl, { method: 'GET', credentials: 'include' })
      .then(function (res) { state.signedOut = res.status === 401; return res.ok ? res.json() : null; })
      .then(function (data) {
        if (data && data.ok) {
          state.userKinds = Array.isArray(data.userKinds) ? data.userKinds : [];
          state.counts = data.counts || null;
        }
        applyState();
      })
      .catch(function () { applyState(); });

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var kind = btn.dataset.kind;
        if (!kind) return;
        if (state.signedOut) {
          window.location.href = '/login?next=' + encodeURIComponent(window.location.href);
          return;
        }
        var wasActive = state.userKinds.indexOf(kind) !== -1;
        if (wasActive) state.userKinds = state.userKinds.filter(function (k) { return k !== kind; });
        else state.userKinds.push(kind);
        applyState();

        btn.disabled = true;
        fetch(apiUrl, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kind: kind }),
        })
          .then(function (res) {
            if (res.status === 401) {
              state.signedOut = true;
              window.location.href = '/login?next=' + encodeURIComponent(window.location.href);
              return null;
            }
            return res.json();
          })
          .then(function (data) {
            if (!data) return;
            if (data.ok) {
              state.userKinds = Array.isArray(data.userKinds) ? data.userKinds : [];
              state.counts = data.counts || null;
              applyState();
            } else {
              if (wasActive) state.userKinds.push(kind);
              else state.userKinds = state.userKinds.filter(function (k) { return k !== kind; });
              applyState();
              setStatus(data.error || 'Couldn’t save that. Try again.', 'err');
            }
          })
          .catch(function () {
            if (wasActive) state.userKinds.push(kind);
            else state.userKinds = state.userKinds.filter(function (k) { return k !== kind; });
            applyState();
            setStatus('Network error. Try again.', 'err');
          })
          .finally(function () { btn.disabled = false; });
      });
    });
  })();
</script>

<style>
  .px-reactions__grid { display: grid; grid-template-columns: 260px 1fr; gap: 34px; align-items: start; }
  .px-reactions__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.05;
    letter-spacing: -0.028em;
    color: var(--ink);
  }
  .px-reactions__title em { font-style: italic; font-weight: 400; color: var(--accent); }
  .px-reactions__dek { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); max-width: 34ch; }
  .px-reactions__row { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .px-reactions__btn {
    display: flex; flex-direction: column; gap: 10px;
    min-height: 132px;
    padding: 18px 16px;
    border: 0;
    border-left: 4px solid transparent;
    background: var(--bg);
    color: var(--ink);
    text-align: left;
    font-family: inherit;
    cursor: pointer;
    transition: background var(--t-quick) var(--ease), border-color var(--t-quick) var(--ease);
  }
  .px-reactions__btn:hover:not(:disabled) { background: color-mix(in oklab, var(--accent) 4%, var(--bg)); }
  .px-reactions__btn:focus-visible { outline: 2px solid var(--accent-deep, var(--accent)); outline-offset: -2px; }
  .px-reactions__btn:disabled { cursor: default; opacity: 0.7; }
  .px-reactions__btn[data-active="true"] {
    background: color-mix(in oklab, var(--accent) 8%, var(--bg));
    border-left-color: var(--accent);
  }
  .px-reactions__label-t {
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--ink);
  }
  .px-reactions__btn[data-active="true"] .px-reactions__label-t { color: var(--accent-deep, var(--accent)); }
  .px-reactions__tick { display: none; }
  .px-reactions__btn[data-active="true"] .px-reactions__tick { display: inline; }
  .px-reactions__count { font-variant-numeric: tabular-nums; }
  .px-reactions__help { font-size: 13.5px; line-height: 1.5; color: var(--ink-soft); }
  .px-reactions__status { margin: 12px 0 0; font-size: 12px; color: var(--muted); min-height: 1.2em; }
  .px-reactions__status--err { color: var(--accent-deep, var(--accent)); }

  @media (max-width: 1100px) {
    .px-reactions__grid { grid-template-columns: 1fr; gap: 22px; }
  }
  @media (max-width: 768px) {
    .px-reactions__title { font-size: 28px; }
    .px-reactions__row { grid-template-columns: 1fr 1fr; }
    .px-reactions__btn { min-height: 112px; padding: 16px 14px; }
  }
</style>
