---
/**
 * LettersBlock — "Sixty days of argument." (launch design, 2026-09-08).
 *
 * The canvas's end-matter band: a 260px label column (eyebrow, title, dek)
 * beside the letters as hairline rows — signer and date in small capitals on
 * the left, the letter on the right — then the form under a 2px ink rule:
 * name and email side by side, the letter, the count, a square ink button.
 *
 * Letters reuse the `comments` table with a NULL anchor and flow through the
 * same moderation queue as before (`/admin/comments`). Flow: GET on load
 * (approved + own pending), POST to submit, 401 → login redirect. Pure
 * `is:inline` IIFE, no framework, same-origin API.
 *
 * Root class stays `px-letter`: core/ReadingGate.astro hides it by name.
 */
interface Props {
  issueId: string;
}
const { issueId } = Astro.props;
---

<section class="px-letter px-band" data-issue-id={issueId} aria-labelledby="px-letter-title">
  <div class="px-letter__grid">
    <div class="px-letter__label">
      <p class="px-eyebrow">Letters</p>
      <h2 class="px-letter__title" id="px-letter-title">Sixty days of <em>argument</em>.</h2>
      <p class="px-letter__dek">Longer responses from readers. The editor reads each one before it appears here.</p>
    </div>

    <div class="px-letter__body">
      <div class="px-letter__head">
        <span class="px-meta px-letter__count-line" id="px-letter-count-line">No letters yet</span>
        <span class="px-meta">Newest first</span>
      </div>

      <div class="px-letter__list" id="px-letter-list">
        <p class="px-letter__empty" id="px-letter-empty">Be the first to write one. Letters open for sixty days after an issue is published.</p>
      </div>

      <form class="px-letter__form" id="px-letter-form">
        <p class="px-eyebrow px-letter__form-eyebrow">Write a letter</p>
        <div class="px-letter__fields">
          <input
            class="px-input"
            id="px-letter-name"
            type="text"
            maxlength="80"
            placeholder="Sign as — your name (optional)"
            autocomplete="name"
          />
        </div>
        <textarea
          class="px-input px-letter__input"
          id="px-letter-input"
          placeholder="Your response to this issue…"
          maxlength="2000"
          rows="6"
        ></textarea>
        <div class="px-letter__actions">
          <span class="px-meta"><span id="px-letter-count">0 / 2000</span> · reviewed before it appears</span>
          <button type="submit" class="px-btn" id="px-letter-submit">Send letter →</button>
        </div>
        <p class="px-letter__status" id="px-letter-status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.currentScript.previousElementSibling;
    while (root && !(root.classList && root.classList.contains('px-letter'))) {
      root = root.previousElementSibling;
    }
    if (!root) return;

    var issueId = root.dataset.issueId;
    if (!issueId) return;
    var apiUrl = '/api/letters/' + encodeURIComponent(issueId);

    var list = document.getElementById('px-letter-list');
    var empty = document.getElementById('px-letter-empty');
    var countLine = document.getElementById('px-letter-count-line');
    var form = document.getElementById('px-letter-form');
    var nameInput = document.getElementById('px-letter-name');
    var input = document.getElementById('px-letter-input');
    var count = document.getElementById('px-letter-count');
    var submit = document.getElementById('px-letter-submit');
    var statusEl = document.getElementById('px-letter-status');

    var signedIn = false;
    var approved = 0, pending = 0;

    function goLogin() {
      window.location.href = '/login?next=' + encodeURIComponent(window.location.href);
    }

    function fmtDate(iso) {
      if (!iso) return '';
      try {
        return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
      } catch (_) { return ''; }
    }

    function updateCount() {
      if (!countLine) return;
      var parts = [];
      if (approved) parts.push(approved + (approved === 1 ? ' letter' : ' letters'));
      if (pending) parts.push(pending + ' in review');
      countLine.textContent = parts.length ? parts.join(' · ') : 'No letters yet';
    }

    function renderLetter(l, prepend) {
      if (!l || !l.body_md) return;
      if (empty) empty.style.display = 'none';
      var isApproved = l.status === 'approved';
      if (isApproved) approved++; else pending++;

      var item = document.createElement('article');
      item.className = 'px-letter__item';
      item.dataset.status = l.status || 'pending';

      var meta = document.createElement('div');
      meta.className = 'px-letter__item-meta';
      var who = (l.author_name && String(l.author_name).trim()) ? String(l.author_name) : 'A reader';
      var when = fmtDate(l.created_at);
      var whoEl = document.createElement('span'); whoEl.className = 'px-letter__who'; whoEl.textContent = who;
      var whenEl = document.createElement('span'); whenEl.textContent = when;
      meta.appendChild(whoEl); meta.appendChild(whenEl);
      if (!isApproved) { var rv = document.createElement('span'); rv.textContent = 'In review'; meta.appendChild(rv); }
      item.appendChild(meta);

      var bodyEl = document.createElement('p');
      bodyEl.className = 'px-letter__item-body';
      bodyEl.textContent = l.body_md; // textContent = escaped; no HTML injection
      item.appendChild(bodyEl);

      if (prepend && list.firstChild) list.insertBefore(item, list.firstChild);
      else list.appendChild(item);
      updateCount();
    }

    function setStatus(msg, kind) {
      statusEl.textContent = msg || '';
      statusEl.className = 'px-letter__status' + (kind ? ' px-letter__status--' + kind : '');
    }

    input.addEventListener('input', function () {
      count.textContent = input.value.length + ' / 2000';
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!signedIn) { goLogin(); return; }
      var text = input.value.trim();
      if (!text) { setStatus('Your letter needs some text.', 'err'); return; }

      submit.disabled = true;
      setStatus('Sending…', null);

      fetch(apiUrl, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ body_md: text, author_name: nameInput.value }),
      })
        .then(function (res) {
          if (res.status === 401) { signedIn = false; goLogin(); return null; }
          return res.json();
        })
        .then(function (data) {
          if (!data) return;
          if (data.ok && data.letter) {
            renderLetter(data.letter, true);
            input.value = '';
            count.textContent = '0 / 2000';
            setStatus('Thanks — your letter is in review.', 'ok');
          } else {
            setStatus(data.error || 'Could not send your letter.', 'err');
          }
        })
        .catch(function () { setStatus('Network error. Try again.', 'err'); })
        .finally(function () { submit.disabled = false; });
    });

    function applyAuthState() {
      submit.textContent = signedIn ? 'Send letter →' : 'Sign in to write a letter →';
    }

    fetch(apiUrl, { method: 'GET', credentials: 'include' })
      .then(function (res) { return res.ok ? res.json() : null; })
      .then(function (data) {
        if (!data || !data.ok) { applyAuthState(); return; }
        signedIn = !!data.signedIn;
        applyAuthState();
        if (signedIn && data.defaultName && !nameInput.value) nameInput.value = data.defaultName;
        var all = [].concat(data.approved || []).concat(data.mine || []);
        // newest first
        all.sort(function (a, b) { return (b.created_at || '').localeCompare(a.created_at || ''); });
        all.forEach(function (l) { renderLetter(l, false); });
      })
      .catch(function () { applyAuthState(); });
  })();
</script>

<style>
  .px-letter__grid { display: grid; grid-template-columns: 260px 1fr; gap: 34px; align-items: start; }
  .px-letter__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.05;
    letter-spacing: -0.028em;
    color: var(--ink);
  }
  .px-letter__title em { font-style: italic; font-weight: 400; color: var(--accent); }
  .px-letter__dek { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); max-width: 34ch; }

  .px-letter__head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--ink);
  }
  .px-letter__count-line { color: var(--ink); }
  .px-letter__empty { margin: 0; padding: 18px 0; font-size: 15px; line-height: 1.6; color: var(--muted); }
  .px-letter__item {
    display: grid; grid-template-columns: 170px 1fr; gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--rule);
  }
  .px-letter__item:first-child { border-top: 0; }
  .px-letter__item-meta {
    display: flex; flex-direction: column; gap: 5px;
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--muted);
  }
  .px-letter__item[data-status="approved"] .px-letter__who { color: var(--accent-deep, var(--accent)); }
  .px-letter__item-body {
    margin: 0;
    font-size: 16px;
    line-height: 1.68;
    color: var(--ink-soft);
    max-width: 62ch;
    white-space: pre-wrap;
  }

  .px-letter__form { border-top: 2px solid var(--ink); margin-top: 8px; padding-top: 22px; }
  .px-letter__form-eyebrow { color: var(--muted); margin-bottom: 14px; }
  .px-letter__fields { display: grid; grid-template-columns: 1fr; gap: 10px; margin-bottom: 10px; max-width: 460px; }
  .px-letter__input { min-height: 150px; line-height: 1.55; resize: vertical; }
  .px-letter__actions {
    display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;
    margin-top: 12px;
  }
  .px-letter__status { margin: 12px 0 0; font-size: 12px; color: var(--muted); min-height: 1.2em; }
  .px-letter__status--ok { color: var(--accent-deep, var(--accent)); }
  .px-letter__status--err { color: var(--accent-deep, var(--accent)); }

  @media (max-width: 1100px) {
    .px-letter__grid { grid-template-columns: 1fr; gap: 22px; }
  }
  @media (max-width: 768px) {
    .px-letter__title { font-size: 28px; }
    .px-letter__item { grid-template-columns: 1fr; gap: 8px; }
    .px-letter__item-meta { flex-direction: row; flex-wrap: wrap; gap: 4px 12px; }
  }
</style>
