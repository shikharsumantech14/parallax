---
/**
 * Comparison — two or three peer things, side by side.
 *
 * TWO authored shapes, and both render (2026-09-15):
 *
 *   matrix  { sides: [{label, title, tag?, kicker?}], rows: [{label, values: []}] }
 *           the original — read ACROSS a row for the same attribute on each side.
 *
 *   list    { columns: [{label, items: [string | {text, strong?: true}]}] }
 *           parallel lists that do NOT pair up row by row (a done / not-done
 *           ledger, say). `docs/design/catalog.md` documented ONLY this shape
 *           from the start and nothing ever read it, so a section authored
 *           against the catalog rendered an empty card. Rather than re-pair
 *           eight sourced statements into rows they do not actually form, the
 *           shape is now implemented. `columns` wins when present.
 *
 *   pair    { cityA: {name, subtitle?}, cityB: {name, subtitle?},
 *             rows: [{label, a, b, winner?: 'a'|'b'|'tie', note?}] }
 *           the folded `city-compare` shape (the Lens verdict, 2026-09-30:
 *           `city-compare` is an alias of `comparison`, KIND_ALIASES in
 *           src/content/config.ts). It normalises onto the matrix form: the
 *           two places become the sides, each row's winning cell is marked
 *           (`data-win`), and a row's note runs full width under it.
 *
 * THE BUILD (Lens Phase 5, LENS §6.4): the root is a `data-build-scene`.
 * Matrix and pair forms: 1 the column heads fade in, 2 the rows drop in, 80ms
 * apart. List form: the columns drop in. src/scripts/build.ts runs it; no JS
 * or reduced motion shows the table as written.
 *
 * Renders NO source line: `core/Section.astro` emits it for every kind
 * (`.px-plain__src`). The old `.px-compare__source` emitter survived the
 * 2026-09-04 sweep because its class ends in `__source`, not `__src` — so it
 * printed the source a second time under the card, and story.css's
 * `[class$='__src']` beat rule could not hide it either.
 */
import { renderInline } from '../../lib/text';

interface ComparisonRow {
  label: string;
  values: string[];
  /** Pair form only: the winning cell (0-based) and a full-width note. */
  win?: number;
  note?: string;
}

interface ComparisonSide {
  label?: string;
  title: string;
  tag?: string;
  kicker?: string;
}

type ColumnItem = string | { text: string; strong?: boolean };

interface ComparisonColumn {
  label: string;
  items: ColumnItem[];
}

interface PairPlace { name: string; subtitle?: string; }
interface PairRow { label: string; a: string; b: string; winner?: 'a' | 'b' | 'tie'; note?: string; }

interface Props {
  sides?: ComparisonSide[];
  rows?: (ComparisonRow | PairRow)[];
  columns?: ComparisonColumn[];
  cityA?: PairPlace;
  cityB?: PairPlace;
}
const { columns = [], cityA, cityB } = Astro.props;

// The pair form (the folded city-compare) normalises onto the matrix form.
const isPair = !!(cityA && cityB);
const sides: ComparisonSide[] = isPair && cityA && cityB
  ? [
      { title: cityA.name, kicker: cityA.subtitle },
      { title: cityB.name, kicker: cityB.subtitle },
    ]
  : (Astro.props.sides ?? []);
const rows: ComparisonRow[] = isPair
  ? ((Astro.props.rows ?? []) as PairRow[]).map((r) => ({
      label: r.label,
      values: [r.a, r.b],
      win: r.winner === 'a' ? 0 : r.winner === 'b' ? 1 : undefined,
      note: r.note,
    }))
  : ((Astro.props.rows ?? []) as ComparisonRow[]);

const isList = columns.length > 0;
const cols = isList ? columns.length : sides.length;

// An item is a bare string or { text, strong }. `strong: true` promotes the
// whole line, which is the list form's equivalent of `highlight` elsewhere.
const itemText = (it: ColumnItem) => (typeof it === 'string' ? it : it.text);
const itemStrong = (it: ColumnItem) => typeof it !== 'string' && it.strong === true;
---

<div class="px-compare" data-build-scene data-cols={cols} data-form={isList ? 'list' : isPair ? 'pair' : 'matrix'}>
  {isList ? (
    /* Each column is ONE block — its head and its own items together — so a
       phone can stack the blocks and every item stays under its own heading.
       The matrix form below cannot do this: its head and its rows share a
       column count, so they must stay two grids that line up. */
    <div class="px-compare__lists">
      {columns.map((c, ci) => (
        <section class="px-compare__col" data-cue={ci + 1} data-build="1" data-build-kind="drop">
          <div class="px-compare__col-head">
            <div class="px-compare__col-title"><span class="px-cue-tag" data-cue-tag={ci + 1} hidden></span><Fragment set:html={renderInline(c.label)} /></div>
          </div>
          <ul class="px-compare__list">
            {c.items.map((it) => (
              <li class="px-compare__item" data-strong={itemStrong(it) ? 'true' : 'false'}>
                <span set:html={renderInline(itemText(it))} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <>
      <div class="px-compare__head" data-build="1">
        {sides.map((s) => (
          <div class="px-compare__col-head">
            {s.label && <div class="px-compare__col-label">{s.label}</div>}
            <div class="px-compare__col-title" set:html={renderInline(s.title)} />
            {s.kicker && <div class="px-compare__col-kicker">{s.kicker}</div>}
            {s.tag && <div class="px-compare__col-tag">{s.tag}</div>}
          </div>
        ))}
      </div>
      <div class="px-compare__body">
        {/* Cue anchors (LENS §5.2): each row (matrix and pair forms) or each
            column (list form) is `data-cue="<n>"`, numbered from 1 in data
            order; the empty tag is the numeral's slot. */}
        {rows.map((row, ri) => (
          <div class="px-compare__row" data-cue={ri + 1} data-build="2" data-build-kind="drop">
            <div class="px-compare__row-label"><span class="px-cue-tag" data-cue-tag={ri + 1} hidden></span>{row.label}</div>
            {row.values.map((v, i) => (
              <div class="px-compare__cell" data-win={row.win === i ? 'true' : undefined} set:html={renderInline(v)} />
            ))}
            {row.note && <div class="px-compare__note" set:html={renderInline(row.note)} />}
          </div>
        ))}
      </div>
    </>
  )}
</div>

<style>
  /* The pair form (the folded city-compare): the winning cell reads in the
     accent and bold, and a row's note runs full width under its cells. The
     rest of the matrix styling is `.px-compare*` in src/styles/base.css. */
  .px-compare[data-form='pair'] .px-compare__cell[data-win='true'] {
    color: var(--accent-deep, var(--accent));
    font-weight: 700;
  }
  .px-compare[data-form='pair'] .px-compare__row:has(> .px-compare__note) .px-compare__cell:nth-last-child(2) {
    border-right: none;
  }
  .px-compare__note {
    grid-column: 1 / -1;
    padding: 0 26px 14px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-soft);
    overflow-wrap: break-word;
  }
</style>
