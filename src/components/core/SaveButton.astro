---
/**
 * SaveButton — client island that toggles save-for-later state for an issue.
 *
 * The publication is static, so we don't know the user's auth state at
 * render time. The button starts in a "loading" state, then on mount
 * fetches the current save status from `app.parallaxlens.com/api/save/<id>`.
 *
 * States:
 *   loading    → small spinner, no text yet
 *   signedout  → "Save to your shelf" (clicking redirects to /login?next=<here>&world=<topic>)
 *   unsaved    → "Save for later"   (clicking POSTs to toggle → saved)
 *   saved      → "✓ Saved"          (clicking POSTs to toggle → unsaved; first
 *                save flashes an "On your shelf →" microline that fades after 4s)
 *   error      → "Try again" (transient; click retries)
 *
 * Brand: matches the SkimToggle — small, monospace eyebrow, restrained.
 * No counts, no public visibility — saving is private to the reader.
 */

interface Props {
  /** Issue slug, e.g. 2026-04-24-delimitation */
  issueId: string;
}
const { issueId } = Astro.props;

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.parallaxlens.com';
---

<div class="px-save" data-issue-id={issueId} data-app-url={appUrl}>
  <button
    class="px-save__btn"
    type="button"
    data-state="loading"
    aria-label="Save this issue"
    aria-live="polite"
  >
    <span class="px-save__icon" aria-hidden="true"></span>
    <span class="px-save__label">…</span>
  </button>
  <a class="px-save__micro" data-save-micro href="#" hidden>On your shelf →</a>
</div>

<script is:inline>
  (function () {
    var root = document.currentScript.previousElementSibling;
    // Walk back to the most recent .px-save (the script's preceding sibling
    // may be a text node depending on whitespace).
    while (root && !(root.classList && root.classList.contains('px-save'))) {
      root = root.previousElementSibling;
    }
    if (!root) return;

    var issueId = root.dataset.issueId;
    var appUrl = root.dataset.appUrl;
    var btn = root.querySelector('.px-save__btn');
    var label = root.querySelector('.px-save__label');
    if (!btn || !label || !issueId || !appUrl) return;

    var apiUrl = appUrl + '/api/save/' + encodeURIComponent(issueId);

    // First-save microline ("On your shelf →") — a quiet, once-per-page
    // confirmation that fades after 4s (JOURNEY-SPEC §2 Save · §4 celebration).
    var micro = root.querySelector('[data-save-micro]');
    var microShown = false;
    var microTimer = 0;
    if (micro) micro.setAttribute('href', appUrl + '/dashboard');
    var reduceMotion = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function flashMicro() {
      if (!micro || microShown) return;
      microShown = true;
      micro.hidden = false;
      void micro.offsetWidth; // commit the pre-transition state so it animates in
      micro.classList.add('is-in');
      microTimer = window.setTimeout(function () {
        micro.classList.remove('is-in');
        window.setTimeout(function () { micro.hidden = true; }, reduceMotion ? 0 : 300);
      }, 4000);
    }

    function setState(state, text) {
      btn.dataset.state = state;
      label.textContent = text;
      // Loading is the only "no interaction" state.
      btn.disabled = state === 'loading';
      btn.setAttribute(
        'aria-label',
        state === 'saved'
          ? 'Saved. Click to remove.'
          : state === 'signedout'
          ? 'Sign in to save this issue'
          : 'Save this issue for later',
      );
    }

    // Initial fetch — figure out current state.
    fetch(apiUrl, { method: 'GET', credentials: 'include' })
      .then(function (res) {
        if (res.status === 401) {
          setState('signedout', 'Save to your shelf');
          return null;
        }
        return res.json();
      })
      .then(function (data) {
        if (!data) return;
        if (data.ok) {
          setState(data.saved ? 'saved' : 'unsaved', data.saved ? 'Saved' : 'Save for later');
        } else {
          setState('error', 'Try again');
        }
      })
      .catch(function () {
        // Network failure — keep button usable; first click will retry.
        setState('unsaved', 'Save for later');
      });

    btn.addEventListener('click', function () {
      var state = btn.dataset.state;

      if (state === 'signedout') {
        // Send the reader to login with the FULL URL of this page (different
        // origin than the app subdomain). safeNextPath on the app side
        // allow-lists parallaxlens.com so the round-trip works. Carry the desk
        // so login shows the world-tinted plate (JOURNEY-SPEC §2 Save).
        var nextUrl = window.location.href;
        var topic = document.documentElement.getAttribute('data-topic') || '';
        window.location.href =
          appUrl + '/login?next=' + encodeURIComponent(nextUrl) +
          (topic ? '&world=' + encodeURIComponent(topic) : '');
        return;
      }

      if (state === 'loading') return;

      // Optimistic toggle: flip immediately, reconcile after request.
      var optimisticSaved = state !== 'saved';
      setState(optimisticSaved ? 'saved' : 'unsaved', optimisticSaved ? 'Saved' : 'Save for later');

      fetch(apiUrl, { method: 'POST', credentials: 'include' })
        .then(function (res) {
          if (res.status === 401) {
            setState('signedout', 'Save to your shelf');
            return null;
          }
          return res.json();
        })
        .then(function (data) {
          if (!data) return;
          if (data.ok) {
            setState(data.saved ? 'saved' : 'unsaved', data.saved ? 'Saved' : 'Save for later');
            // Only on a genuine new save (not an unsave), and only once.
            if (optimisticSaved && data.saved) flashMicro();
          } else {
            // Server rejected — revert
            setState(optimisticSaved ? 'unsaved' : 'saved', 'Try again');
          }
        })
        .catch(function () {
          // Network failure — revert
          setState(optimisticSaved ? 'unsaved' : 'saved', 'Try again');
        });
    });
  })();
</script>

<style>
  .px-save {
    display: inline-flex;
    align-items: center;
    position: relative;
  }
  /* First-save microline — floats just above the button, doesn't reflow the
     glass toolbar pill it lives in. */
  .px-save__micro {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translate(-50%, 4px);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--accent-deep, var(--accent));
    padding: 5px 10px;
    border-radius: var(--r-pill, 999px);
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 6px 18px -8px color-mix(in oklab, var(--ink) 60%, transparent);
    transition: opacity 0.28s var(--ease, ease), transform 0.28s var(--ease, ease);
  }
  .px-save__micro[hidden] { display: none; }
  .px-save__micro.is-in { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  @media (prefers-reduced-motion: reduce) {
    .px-save__micro { transition: opacity 0.12s linear; transform: translate(-50%, 0); }
    .px-save__btn[data-state="loading"] .px-save__icon { animation: none; opacity: 0.6; }
  }
  .px-save__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 8px 14px;
    cursor: pointer;
    border-radius: var(--r-card);
    transition: color var(--t-quick) var(--ease), border-color var(--t-quick) var(--ease), background var(--t-quick) var(--ease);
    line-height: 1;
  }
  .px-save__btn:hover:not(:disabled) {
    color: var(--ink);
    border-color: var(--ink);
  }
  .px-save__btn:disabled {
    cursor: default;
    opacity: 0.6;
  }
  .px-save__icon {
    display: inline-block;
    width: 10px;
    height: 12px;
    flex-shrink: 0;
    /* Bookmark outline — only one rendering, fills on saved */
    background: transparent;
    border: 1.5px solid currentColor;
    border-bottom: none;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 75%, 0 100%);
    transition: background var(--t-quick) var(--ease), border-color var(--t-quick) var(--ease);
  }
  .px-save__btn[data-state="saved"] {
    color: var(--accent-deep, var(--accent));
    border-color: var(--accent-deep, var(--accent));
  }
  .px-save__btn[data-state="saved"]:hover {
    color: var(--accent-deep, var(--accent));
    border-color: var(--accent-deep, var(--accent));
  }
  .px-save__btn[data-state="saved"] .px-save__icon {
    background: currentColor;
  }
  .px-save__btn[data-state="signedout"] {
    color: var(--muted);
  }
  .px-save__btn[data-state="loading"] .px-save__icon {
    animation: px-save-pulse 1.2s ease-in-out infinite;
  }
  @keyframes px-save-pulse {
    0%, 100% { opacity: 0.35; }
    50%      { opacity: 1; }
  }
</style>
