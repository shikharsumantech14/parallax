---
/*
  Gauge — one value on an arc. The Lens verdict (2026-09-30, docs/design/LENS.md
  §9) merged three kinds into this one: `carbon-gauge` was renamed `gauge`, and
  `swing-dial` and `throughput-dial` folded into it. The old names stay
  accepted as aliases (KIND_ALIASES in src/content/config.ts), so every issue
  that authored them still builds, unedited.

  LENS PHASE 6 (2026-09-30): the three are ONE drawing, the board
  `Lib-carbon-gauge.dc.html` ("gauge, was carbon-gauge · swing-dial ·
  throughput-dial"): a half arc from left over the top to right, the track in
  the desk tint, the filled part in the desk mark, one number set large in the
  bowl of the arc. The old px-cgauge / px-swdial / px-tdial markup is gone.

  Three variants, derived from the fields present unless `variant` is authored:

    budget    { remaining (0–1), remainingGt?, usedGt?, totalGt?, target?, year? }
              the arc filled by what is used; the number is the used share.
    lean      { value (-100..100), leftLabel?, rightLabel?, markers?: [{at, label}] }
              the arc split at its top into the two blocs; the fill runs from
              the middle toward the side the value leans; markers tick the arc.
    capacity  { value, max, unit?, label?, zones?: [{from, to, label?}] }
              the arc filled to value / max; zones ride a thin ring outside it.

  Derivation: `remaining` present → budget; else `max` present → capacity;
  else → lean.

  Cue anchors:
    value    the headline number (and the boundary tick on the arc)
    fill     the filled arc (budget: used; capacity: the reading; lean: the swing)
    rest     the unfilled arc (budget: what is left; capacity: the headroom)
    left     lean only: the left bloc's half and its end label
    right    lean only: the right bloc's half and its end label
    target   budget only: the target and year line
    1..n     capacity: each zone, in data order; lean: each marker, in data order

  The build (LENS §6.4, src/scripts/build.ts): the root is the scene. 1 the
  unfilled arc fades in (the axis), 2 the fill draws and the zones and marker
  ticks fade, 3 the end labels and the key rise, 4 the number counts up.

  Drawn for the figure panel: the arc is an SVG 440 units wide with NO text in
  it; every word and the number are HTML over and under it, so they print at
  their size at any width (no text scales with the SVG). Renders no source and
  no caption: `core/Section.astro` prints both. Prefix px-gauge.
*/
type Variant = 'budget' | 'lean' | 'capacity';
interface Marker { at: number; label: string; }
interface Zone { from: number; to: number; label?: string; }
interface Props {
  variant?: Variant;
  // budget
  remaining?: number;
  remainingGt?: string;
  usedGt?: string;
  totalGt?: string;
  target?: string;
  year?: string;
  // lean + capacity
  value?: number;
  // capacity
  max?: number;
  unit?: string;
  label?: string;
  zones?: Zone[];
  // lean
  leftLabel?: string;
  rightLabel?: string;
  markers?: Marker[];
  /** Accepted and never rendered: the article holds the one caption. */
  caption?: string;
  /** Accepted and never rendered: core/Section.astro prints the source. */
  source?: string;
}
const props = Astro.props;

const variant: Variant =
  props.variant ??
  (props.remaining !== undefined ? 'budget' : props.max !== undefined ? 'capacity' : 'lean');

const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
const f1 = (n: number) => n.toFixed(1);

/* ── the one geometry ─────────────────────────────────────────────────────── */
const W = 440;
const R = 176;          // the band's centre line
const SW = 40;          // the band
const RING = R + SW / 2 + 9; // the zone ring's centre line (capacity)
const cx = W / 2;
const cy = 216;
const H = cy + 2;
const at = (u: number, r = R) => ({ x: cx - r * Math.cos(Math.PI * u), y: cy - r * Math.sin(Math.PI * u) });
const arc = (a: number, b: number, r = R) => {
  const p0 = at(a, r), p1 = at(b, r);
  return `M ${f1(p0.x)} ${f1(p0.y)} A ${r} ${r} 0 0 ${b > a ? 1 : 0} ${f1(p1.x)} ${f1(p1.y)}`;
};
/* a tick across the band at u */
const tick = (u: number, out = 6) => {
  const p0 = at(u, R - SW / 2 - out), p1 = at(u, R + SW / 2 + out);
  return { x1: f1(p0.x), y1: f1(p0.y), x2: f1(p1.x), y2: f1(p1.y) };
};
/* a pin (the numeral's place on the band) at u, as % of the drawing box */
const pin = (u: number) => {
  const p = at(u);
  return `left:${((p.x / W) * 100).toFixed(2)}%;top:${((p.y / H) * 100).toFixed(2)}%`;
};
const EPS = 0.002;

type Seg = { id: string; d: string; tone: 'mark' | 'tint' | 'well'; pin?: string };
type Key = { id: string; swatch: 'mark' | 'tint' | 'well' | 'zone' | 'tick'; zoneOpacity?: number; k?: string; v: string };

let segs: Seg[] = [];          // step 1 (tone tint / well) and step 2 (tone mark)
let zonePaths: { id: string; d: string; o: number }[] = [];
let markerTicks: { id: string; t: ReturnType<typeof tick> }[] = [];
let boundary: ReturnType<typeof tick> | null = null;
let ends: { l: string; r: string; lId?: string; rId?: string } = { l: '', r: '' };
let keys: Key[] = [];
let meta: string | undefined;
let num = { text: '', to: 0, dp: false };
let numSub: string | undefined;
let numUnit: string | undefined;
let aria = '';

if (variant === 'budget') {
  const f = clamp(props.remaining ?? 0, 0, 1);
  const used = 1 - f;
  if (used > EPS) segs.push({ id: 'fill', d: arc(0, used), tone: 'mark', pin: pin(used / 2) });
  if (f > EPS) segs.push({ id: 'rest', d: arc(used, 1), tone: 'tint', pin: pin(used + f / 2) });
  if (used > EPS && f > EPS) boundary = tick(used);
  const pct = Math.round(used * 100);
  num = { text: `${pct}%`, to: pct, dp: false };
  numSub = 'of the budget used';
  ends = { l: '0', r: props.totalGt ?? '100%' };
  if (props.usedGt) keys.push({ id: 'fill', swatch: 'mark', k: 'Used', v: props.usedGt });
  if (props.remainingGt) keys.push({ id: 'rest', swatch: 'tint', k: 'Left', v: props.remainingGt });
  meta = [props.target, props.year].filter(Boolean).join(' · ') || undefined;
  aria = `Budget gauge: ${pct}% used, ${Math.round(f * 100)}% left.`;
}

if (variant === 'lean') {
  const leftLabel = props.leftLabel ?? 'Left';
  const rightLabel = props.rightLabel ?? 'Right';
  const v = clamp(props.value ?? 0, -100, 100);
  const u = 0.5 + v / 200;
  const uOf = (x: number) => 0.5 + clamp(x, -100, 100) / 200;
  segs.push({ id: 'left', d: arc(0, 0.5), tone: v < 0 ? 'tint' : 'well' });
  segs.push({ id: 'right', d: arc(0.5, 1), tone: v > 0 ? 'tint' : 'well' });
  if (Math.abs(v) > 0.4) segs.push({ id: 'fill', d: arc(0.5, u), tone: 'mark', pin: pin((0.5 + u) / 2) });
  boundary = tick(0.5, 10);
  markerTicks = (props.markers ?? []).map((m, i) => ({ id: String(i + 1), t: tick(uOf(m.at), 2) }));
  const mag = Math.abs(v);
  const sign = v > 0 ? '+' : v < 0 ? '−' : '';
  num = { text: `${sign}${mag}`, to: mag, dp: !Number.isInteger(mag) };
  numSub = v === 0 ? 'evenly split' : `toward ${v < 0 ? leftLabel : rightLabel}`;
  ends = { l: leftLabel, r: rightLabel, lId: 'left', rId: 'right' };
  keys = (props.markers ?? []).map((m, i) => ({
    id: String(i + 1),
    swatch: 'tick' as const,
    v: m.label,
    k: `${m.at > 0 ? '+' : m.at < 0 ? '−' : ''}${Math.abs(m.at)}`,
  }));
  aria = `Lean gauge: ${mag} points toward ${v === 0 ? 'neither side' : v < 0 ? leftLabel : rightLabel}.`;
}

if (variant === 'capacity') {
  const unit = props.unit;
  const safeMax = Math.max(1e-9, props.max || 1);
  const val = clamp(props.value ?? 0, 0, safeMax);
  const frac = val / safeMax;
  if (frac > EPS) segs.push({ id: 'fill', d: arc(0, frac), tone: 'mark', pin: pin(frac / 2) });
  if (frac < 1 - EPS) segs.push({ id: 'rest', d: arc(frac, 1), tone: 'tint', pin: pin(frac + (1 - frac) / 2) });
  if (frac > EPS && frac < 1 - EPS) boundary = tick(frac);
  const OP = [0.35, 0.6, 0.9];
  zonePaths = (props.zones ?? [])
    .map((z, i) => {
      const a = clamp(z.from, 0, safeMax) / safeMax;
      const b = clamp(z.to, 0, safeMax) / safeMax;
      return b > a ? { id: String(i + 1), d: arc(a, b, RING), o: OP[i % OP.length] } : null;
    })
    .filter((z): z is NonNullable<typeof z> => z !== null);
  const fmt = (n: number) => (Number.isInteger(n) ? n.toLocaleString('en-US') : (Math.round(n * 10) / 10).toLocaleString('en-US'));
  const pctUnit = unit === '%';
  num = { text: `${fmt(val)}${pctUnit ? '%' : ''}`, to: val, dp: !Number.isInteger(val) };
  numUnit = pctUnit ? undefined : unit;
  numSub = props.label;
  ends = { l: '0', r: `${fmt(safeMax)}${pctUnit ? '%' : ''}` };
  keys = (props.zones ?? []).map((z, i) => ({
    id: String(i + 1),
    swatch: 'zone' as const,
    zoneOpacity: OP[i % OP.length],
    v: z.label ?? `${fmt(z.from)} to ${fmt(z.to)}${unit ? ' ' + unit : ''}`,
  }));
  aria = `${props.label ? props.label + ': ' : ''}${fmt(val)} of ${fmt(safeMax)}${unit ? ' ' + unit : ''}.`;
}

const tag = (id: string) => `<span class="px-cue-tag" data-cue-tag="${id}" hidden></span>`;
const TONE: Record<string, string> = { mark: 'var(--accent)', tint: 'var(--accent-tint)', well: 'var(--paper-3)' };
---

<div class="px-gauge" data-viz-root data-gauge={variant} data-build-scene>
  <div class="px-gauge__dial">
    <svg class="px-gauge__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
      {segs.filter((s) => s.tone !== 'mark').map((s) => (
        <path d={s.d} data-cue={s.id} data-build="1" style={`fill:none;stroke:${TONE[s.tone]};stroke-width:${SW}`} />
      ))}
      {zonePaths.map((z) => (
        <path d={z.d} data-cue={z.id} data-build="2" style={`fill:none;stroke:var(--accent-deep);stroke-opacity:${z.o};stroke-width:10`} />
      ))}
      {segs.filter((s) => s.tone === 'mark').map((s) => (
        <path d={s.d} data-cue={s.id} data-build="2" data-build-kind="draw" style={`fill:none;stroke:${TONE.mark};stroke-width:${SW}`} />
      ))}
      {markerTicks.map((m) => (
        <line x1={m.t.x1} y1={m.t.y1} x2={m.t.x2} y2={m.t.y2} data-cue={m.id} data-build="2" style="stroke:var(--ink-2);stroke-width:2" />
      ))}
      {boundary && (
        <line x1={boundary.x1} y1={boundary.y1} x2={boundary.x2} y2={boundary.y2} data-cue="value" data-build="2" style="stroke:var(--ink);stroke-width:2" />
      )}
    </svg>

    {segs.filter((s) => s.pin).map((s) => (
      <span class="px-gauge__pin" style={s.pin} data-cue={s.id} data-build="3"><Fragment set:html={tag(s.id)} /></span>
    ))}

    <div class="px-gauge__read" data-cue="value">
      <p class="px-gauge__num">
        <span class="px-gauge__n" data-build="4" data-build-kind="counter" data-to={num.to} data-format={num.dp ? '1dp' : undefined}>{num.text}</span>
        {numUnit && <span class="px-gauge__u">{numUnit}</span>}
      </p>
      {numSub && <p class="px-gauge__sub" data-build="3" data-build-kind="rise"><Fragment set:html={tag('value')} />{numSub}</p>}
      {!numSub && <Fragment set:html={tag('value')} />}
    </div>
  </div>

  <div class="px-gauge__ends" data-build="3" data-build-kind="rise">
    <span class="px-gauge__end" data-cue={ends.lId}>{ends.lId && <Fragment set:html={tag(ends.lId)} />}{ends.l}</span>
    <span class="px-gauge__end px-gauge__end--r" data-cue={ends.rId}>{ends.rId && <Fragment set:html={tag(ends.rId)} />}{ends.r}</span>
  </div>

  {(keys.length > 0 || meta) && (
    <ul class="px-gauge__key">
      {keys.map((k) => (
        <li class="px-gauge__row" data-cue={k.id} data-build="3" data-build-kind="rise">
          <span class:list={['px-gauge__sw', `px-gauge__sw--${k.swatch}`]} style={k.zoneOpacity != null ? `opacity:${k.zoneOpacity}` : undefined} aria-hidden="true"></span>
          <span class="px-gauge__kt">
            {variant !== 'budget' && k.swatch !== 'mark' && k.swatch !== 'tint' && <Fragment set:html={tag(k.id)} />}
            {k.k && <b class="px-gauge__kk">{k.k}</b>}
            {k.v}
          </span>
        </li>
      ))}
      {meta && (
        <li class="px-gauge__row px-gauge__row--meta" data-cue="target" data-build="3" data-build-kind="rise">
          <span class="px-gauge__kt"><Fragment set:html={tag('target')} />{meta}</span>
        </li>
      )}
    </ul>
  )}
</div>

<style>
  .px-gauge {
    container-type: inline-size;
    max-width: 472px;
    margin: 0 auto;
  }
  .px-gauge__dial { position: relative; }
  .px-gauge__svg { display: block; width: 100%; height: auto; overflow: visible; }
  /* SVG anchors light by opacity only: an outline would ring the path's box. */
  .px-gauge__svg [data-cue] { outline: none !important; }

  /* The numeral's place on the band: a 20px disc centred on the arc. */
  .px-gauge__pin {
    position: absolute;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    border-radius: 999px;
    display: flex;
  }
  .px-gauge__pin :global(.px-cue-tag) { margin: 0; background: var(--accent-deep); box-shadow: 0 0 0 2px var(--paper-2); }

  /* The number sits in the bowl of the arc. */
  .px-gauge__read {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-radius: var(--r-ctl);
  }
  .px-gauge__num {
    margin: 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 8px;
    font-family: var(--font-ui);
    font-weight: 600;
    /* The headline number (LENS §7): 96, 72 on phones, never wider than
       the bowl of the arc. */
    font-size: min(96px, 21cqi);
    line-height: 0.92;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-deep);
  }
  @media (max-width: 1023px) {
    .px-gauge__num { font-size: min(72px, 24cqi); }
  }
  .px-gauge__u {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .px-gauge__sub {
    margin: 8px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-2);
  }

  /* The scale's two ends, under the arc's two feet. */
  .px-gauge__ends {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 8px;
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .px-gauge__end { display: flex; align-items: center; min-width: 0; overflow-wrap: anywhere; border-radius: var(--r-ctl); }
  .px-gauge__end--r { text-align: right; justify-content: flex-end; }

  /* The key: what each part of the arc is, as words that wrap. */
  .px-gauge__key {
    list-style: none;
    margin: 16px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--hair);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .px-gauge__row {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    border-radius: var(--r-ctl);
  }
  .px-gauge__row--meta { grid-template-columns: minmax(0, 1fr); }
  .px-gauge__sw { width: 16px; height: 12px; border-radius: 2px; }
  .px-gauge__sw--mark { background: var(--accent); }
  .px-gauge__sw--tint { background: var(--accent-tint); box-shadow: inset 0 0 0 1px var(--hair-2); }
  .px-gauge__sw--well { background: var(--paper-3); }
  .px-gauge__sw--zone { height: 6px; background: var(--accent-deep); }
  .px-gauge__sw--tick { width: 2px; height: 16px; margin: 0 7px; background: var(--ink-2); }
  .px-gauge__kt {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px 8px;
    min-width: 0;
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .px-gauge__kt :global(.px-cue-tag) { margin-right: 0; }
  .px-gauge__kk {
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-deep);
    font-variant-numeric: tabular-nums;
  }
  .px-gauge__row--meta .px-gauge__kt {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
