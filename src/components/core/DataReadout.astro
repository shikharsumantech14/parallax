---
/**
 * DataReadout — v2 telemetry card (.tel): value tiles. Faithful port of
 * publication-v2 <Telemetry> / <TelemetryTile>. Build-time, zero JS of its
 * own. THE BUILD (Lens Phase 5, LENS §6.4): the card is a
 * `data-build-scene`; step 1 drops the tiles in, 80ms apart; step 2 counts
 * each plain number up to the value already in the HTML
 * (src/scripts/build.ts). No JS or reduced motion: the tiles as written.
 *
 * Cue anchors: 1..n, one per tile in data order (the whole tile; its numeral
 * prints beside the tile's label).
 *
 * This is a CORE (topic-agnostic) component, so the "Live · nominal" status
 * pip is opt-in via the `status` prop and omitted by default.
 *
 * props (interface preserved):
 *   tiles[] — { value: string, unit?, label, note?, emphasis?, color? }
 *   caption · source · status?
 */
import { renderInline } from '../../lib/text';

interface Tile {
  value: string;
  unit?: string;
  label: string;
  note?: string;
  emphasis?: 'default' | 'key' | 'warn';
  color?: string;
}

interface Props {
  tiles: Tile[];
  caption?: string;
  source?: string;
  status?: string;
  /** The Lens reading system (Phase 3): the article column beside the figure
   *  carries each tile as a sentence (label, value, note), so the figure keeps
   *  the value and the label. */
  compact?: boolean;
}
const { tiles, caption, source, status, compact = false } = Astro.props;

// A value counts up only when it is a plain number, optionally with thousands
// separators and one decimal (e.g. "39", "10,074", "28.3"). Anything with
// other glyphs (e.g. "~10", "$150,000", "GO") renders verbatim, no count-up.
const countUpValue = (v: string): { n: number; dp: boolean } | null => {
  if (typeof v !== 'string') return null;
  const t = v.trim();
  if (!/^(\d{1,3}(,\d{3})*|\d+)(\.\d)?$/.test(t)) return null;
  const n = parseFloat(t.replace(/,/g, ''));
  return Number.isFinite(n) ? { n, dp: t.includes('.') } : null;
};

/* THE FIT (2026-09-23). A value is authored, a tile is a fixed share of the
   card, and the numeral may neither wrap nor be cut — "$150,000" ran 26px
   past a phone tile's clip and "1 Jul – 10 Sep" broke over two lines at
   1280. CSS cannot measure a string, so the component estimates it: each
   glyph's advance in em for the numeral face (Literata 700, tabular
   figures), calibrated against the eleven published readouts at 40px and
   rounded UP so the estimate errs wide; a unit is fixed-size 12px capitals
   at .16em, about 10.2px a character in Literata 600 (measured 2026-10-04)
   plus the 8px gap, taken against a 28px numeral (the
   phone floor) so it errs wide too. `--tel-em` is the widest tile's need;
   dataviz-v2.css sizes every numeral in the readout from it with container
   units, one size per readout, capped at the 40px design size. When that
   size would drop too far the readout takes fewer columns instead:
   `data-cols="2"` on a wide screen (fitted size under ~39px at 1280), and
   `data-phone="stack"` below 720 (under ~32px at a 375 phone). */
const glyphEm = (ch: string): number => {
  if (/[0-9]/.test(ch)) return 0.57;
  if (/[,.:'’]/.test(ch)) return 0.3;
  if (ch === ' ' || ch === ' ') return 0.25;
  if (/[–—-]/.test(ch)) return 0.55;
  if (/[MWmw@]/.test(ch)) return 0.95;
  return 0.62;                        // letters and $ £ ¥ € + ~ < > % × −
};
const tileEm = (t: Tile): number => {
  const v = [...String(t.value ?? '')].reduce((s, ch) => s + glyphEm(ch), 0);
  const u = t.unit ? (8 + 10.2 * [...t.unit.trim()].length) / 28 : 0;
  return v + u;
};
/* THE LENS LAYOUT (Phase 6, 2026-09-30; the board Lib-data-readout): the
   tile the section is about (`emphasis: "key"`, the first such) is the HERO,
   across the full width with its number at up to 96px (LENS §7, a readout
   IS a number); the others sit under it as cards in a row, their numbers at
   up to 48px. Each group is fitted on its own widest value: `--tel-em` for
   the row, `--tel-hero-em` for the hero. A zero is drawn as well as written,
   a dashed hollow ring beside it (the board's "zero drawn as a hollow ring"). */
const heroIdx = tiles.findIndex((t) => t.emphasis === 'key');
const rest = tiles.filter((_, i) => i !== heroIdx);
const need = Math.max(1, ...rest.map(tileEm));
const telEm = Math.ceil(need * 10) / 10;
const heroEm = heroIdx >= 0 ? Math.ceil(Math.max(1, tileEm(tiles[heroIdx])) * 10) / 10 : 1;
const nRest = rest.length;
const telCols = nRest >= 3 ? (nRest === 4 ? 2 : 3) : Math.max(1, nRest);
const cols = need > 4.4 && telCols > 2 ? '2' : undefined;
const phone = need > 3.4 ? 'stack' : undefined;
const isZero = (v: string) => typeof v === 'string' && v.trim() === '0';
---

<div class="tel" data-build-scene data-cols={cols} data-phone={phone} style={`--tel-em:${telEm};--tel-hero-em:${heroEm};--tel-cols:${cols ?? telCols}`}>
  {caption && (
    <div class="tel__cap">
      <span>{caption}</span>
      {status && <span class="tel__cap-status">{status}</span>}
    </div>
  )}
  {/* Cue anchors: each tile is `data-cue="<n>"`, numbered from 1 in data
      order (the hero keeps its own number); the empty tag beside the label is
      its numeral's slot, filled by core/Section.astro. */}
  <div class="tel__grid">
    {tiles.map((t, i) => {
      const n = countUpValue(t.value);
      return (
        <div class="tel__tile" data-emphasis={t.emphasis ?? 'default'} data-hero={i === heroIdx ? 'true' : undefined} data-cue={i + 1} data-build="1" data-build-kind="drop">
          <div class="tel__l"><span class="px-cue-tag" data-cue-tag={i + 1} hidden></span><span set:html={renderInline(t.label)} /></div>
          <div class="tel__val">
            {n != null ? (
              <span class="tel__n" data-build="2" data-build-kind="counter" data-to={n.n} data-format={n.dp ? '1dp' : undefined} style={t.color ? `color:${t.color}` : undefined}>{t.value}</span>
            ) : (
              <span class="tel__n" style={t.color ? `color:${t.color}` : undefined}>{t.value}</span>
            )}
            {t.unit && <span class="tel__u">{t.unit}</span>}
            {isZero(t.value) && <span class="tel__zero" aria-hidden="true"></span>}
          </div>
          {!compact && t.note && <div class="tel__note" set:html={renderInline(t.note)} />}
        </div>
      );
    })}
  </div>
</div>
