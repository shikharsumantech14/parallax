---
/**
 * ThreeSteps — a mechanism in numbered cards, one idea each, read left to
 * right. Contract: docs/design/blueprints/core/three-steps.md.
 *
 * NARRATIVE kind: the component emits the steps and NOTHING else — no caption
 * row, no how-to-read, no plain line, no source line, no VizCard. `source` is
 * accepted so an authored section may carry one (core/Section.astro is the one
 * emitter, below the graphic) and is deliberately ignored here.
 *
 * No-JS / reduced-motion: the steps rest in their FINAL state; the `--i`
 * stagger is gated behind `html.js` and reset under prefers-reduced-motion.
 * The arrows are CSS `::after` glyphs — `→` in a row, `↓` stacked — so the
 * still frame carries the order with no JS and no SVG.
 *
 * data: { steps[]{ title, text }, source? }   2–4 steps; three is the shape.
 * Prefix: px-3s.
 */
import { renderInline } from '../../lib/text';

interface Step { title: string; text: string; }
interface Props { steps: Step[]; source?: string; }
const { steps = [] } = Astro.props;
---

{steps.length > 0 && (
  <div class="px-3s" data-reveal>
    <div class="px-3s__row" style={`--cols:${steps.length}`}>
      {steps.map((s, i) => (
        <div class="px-3s__step" style={`--i:${i}`}>
          <div class="px-3s__n">{i + 1}</div>
          <div class="px-3s__t">{s.title}</div>
          <p class="px-3s__x" set:html={renderInline(s.text)} />
        </div>
      ))}
    </div>
  </div>
)}

<style>
  /* Flat per CANON §14 — a hairline is the only edge; no radius, no shadow. */
  .px-3s { border-top: 1px solid var(--rule); }
  .px-3s__row { display: grid; grid-template-columns: minmax(0, 1fr); }

  .px-3s__step {
    position: relative;
    padding: 16px 0;
    /* resting = final visible state, so no-JS paints the finished component */
    opacity: 1; transform: none;
    transition: opacity var(--t-soft) var(--ease), transform var(--t-soft) var(--ease);
  }
  .px-3s__step:not(:last-child) { border-bottom: 1px solid var(--rule); }

  .px-3s__n {
    font-family: var(--font-display); font-weight: 700;
    font-size: 26px; line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--accent-deep, var(--accent));
    margin-bottom: 8px;
  }
  .px-3s__t {
    font-family: var(--font-display); font-weight: 700;
    font-size: 16.5px; line-height: 1.3;
    color: var(--ink); margin-bottom: 6px;
  }
  .px-3s__x {
    font-family: var(--font-body); font-size: 15.5px; line-height: 1.5;
    color: var(--ink-soft); max-width: 30ch; margin: 0;
  }

  /* The arrow — the one vivid mark. It straddles the hairline between two
     steps, on a patch of ground so the rule does not run through the glyph. */
  .px-3s__step:not(:last-child)::after {
    content: '↓';
    position: absolute; left: 50%; bottom: 0;
    transform: translate(-50%, 50%);
    font-family: var(--font-display); font-size: 20px; line-height: 1;
    color: var(--accent); background: var(--bg); padding: 0 6px;
  }

  @media (min-width: 640px) {
    .px-3s__row { grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); }
    .px-3s__step { padding: 18px 20px 18px 0; }
    .px-3s__step:not(:first-child) { padding-left: 20px; }
    .px-3s__step:not(:last-child) { border-bottom: 0; border-right: 1px solid var(--rule); }
    /* centred on the numeral row: 18px of padding + half the 26px numeral */
    .px-3s__step:not(:last-child)::after {
      content: '→';
      left: auto; right: 0; bottom: auto; top: 31px;
      transform: translate(50%, -50%);
      padding: 6px 0;
    }
  }

  /* Stagger (blueprint §5, the kit's CSS-only `--i`), gated on html.js. */
  html.js .px-3s:not(.is-in) .px-3s__step { opacity: 0; transform: translateY(12px); }
  .px-3s.is-in .px-3s__step { transition-delay: calc(var(--i) * 90ms); }
  @media (prefers-reduced-motion: reduce) {
    html.js .px-3s:not(.is-in) .px-3s__step { opacity: 1 !important; transform: none !important; }
  }
</style>
