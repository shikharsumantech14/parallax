---
/**
 * Section — the article chrome around every numbered section.
 *
 * 2026-07-05 additions (docs/design/CANON.md §10 + §3):
 *  - the "In plain terms" line: one quiet sentence under every viz explaining
 *    the FORM of the graphic. Authored `plain` overrides the per-kind default
 *    from src/lib/explainers.ts; kinds with no entry (prose, quote…) render
 *    nothing. Static HTML — no JS, no toggle.
 *  - `layout` variants (data-layout attr; geometry in src/styles/layout-v2.css).
 *    `split`/`split-flip` restructure into a copy column + sticky stage — the
 *    scrollytelling primitive. All other layouts keep the flat structure.
 */
import { renderEmphasis, renderInline } from '../../lib/text';
import { EXPLAIN, howToReadFor } from '../../lib/explainers';

interface Props {
  number?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  kind?: string;
  plain?: string;
  layout?: string;
  /** Shell adoption (Phase 6): the source line moves OUT of the card and
   *  becomes the second line of the plain paragraph — one render site for
   *  every kind instead of ~70, which also ends the sibling-vs-child depth
   *  split that story.css had to special-case. `string` or the schema's
   *  `{ label, date }`; joined the way VizCard used to. */
  source?: string | { label: string; date?: string };
  /** Contract part 02, "how to read this" — a paragraph ABOVE the graphic.
   *  Authored `howToRead` always wins, for every kind. The per-kind default
   *  (EXPLAIN[kind].how) renders only for the kinds in NEEDS_HOW — instruments,
   *  WebGL scenes and counter-intuitive forms (REGISTER-PLAN RG-19, ruled
   *  2026-09-13; the 2026-09-04 every-kind fallback had put a paragraph on 69
   *  published sections). The resolution lives in ONE function,
   *  `howToReadFor`, shared with SectionBody's VizCard dispatch. The ten
   *  VizCard kinds render theirs inside the card; dataviz-v2.css hides this
   *  copy when the slotted card already carries one, so a section shows at
   *  most one. */
  howToRead?: string;
  /** The DATA claim (`section.caption ?? data.caption`). Rendered here, directly
   *  below the graphic, ONLY for kinds whose component carries no caption
   *  element of its own — timeline, seat-chart, vote-result, bill-breakdown,
   *  comparison and their like — which until 2026-09-13 silently dropped an
   *  authored caption (the delimitation rewrite's reader panel found the two
   *  restatements that answer its quiz were authored and not on the page).
   *  A `:has()` rule in dataviz-v2.css hides this copy wherever the slotted
   *  component already shows one (VizCard's caption row, DataReadout's
   *  `.tel__cap`, any `*__cap`), so a section shows exactly one. */
  caption?: string;
  /** Anchor for the aside's contents list (launch design). */
  id?: string;
}
const { number, eyebrow, title, intro, kind, plain, layout, source, howToRead, caption, id } = Astro.props;

const plainText = plain ?? (kind ? EXPLAIN[kind]?.what : undefined);
const howText = howToReadFor(kind, howToRead);
const sourceLine =
  typeof source === 'string'
    ? source
    : source
      ? [source.label, source.date].filter(Boolean).join(' · ')
      : undefined;
const layoutAttr = layout && layout !== 'default' ? layout : undefined;
/* One markup for every layout (2026-09-23). `split` / `split-flip` used to
   wrap the copy and the graphic in `__copy` / `__stage` for a two-column grid
   that put the plain line and source ABOVE the graphic once the grid stacked
   (every phone, and the floor plan now). The geometry is retired in
   layout-v2.css — split is an alias of wide — so the order is the same as
   every other section: number, eyebrow, title, intro, how, GRAPHIC, caption,
   plain + source. */
---

<section class="px-section" id={id} data-reveal data-kind={kind} data-layout={layoutAttr}>
  {number && <div class="px-section__num" data-n={number}>{number}</div>}
  {eyebrow && <div class="px-eyebrow">{eyebrow}</div>}
  {title && <h2 class="px-section__title" set:html={renderEmphasis(title)} />}
  {intro && <p class="px-section__intro">{intro}</p>}
  {howText && (
    <p class="px-viz__how px-viz__how--section"><b>How to read this —</b>{' ' + howText}</p>
  )}
  <slot />
  {caption && <p class="px-section__claim vz-caption" set:html={renderInline(caption)} />}
  {(plainText || sourceLine) && (
    <p class="px-plain">
      {plainText && <><span class="px-plain__k">In plain terms</span>{' ' + plainText}</>}
      {sourceLine && <span class="px-plain__src">Source · {sourceLine}</span>}
    </p>
  )}
</section>
