---
/**
 * Section — the article chrome around every numbered section.
 *
 * 2026-07-05 additions (docs/design/CANON.md §10 + §3):
 *  - the "In plain terms" line: one quiet sentence under every viz explaining
 *    the FORM of the graphic. Authored `plain` overrides the per-kind default
 *    from src/lib/explainers.ts; kinds with no entry (prose, quote…) render
 *    nothing. Static HTML — no JS, no toggle.
 *  - `layout` variants (data-layout attr; geometry in src/styles/layout-v2.css).
 *    `split`/`split-flip` restructure into a copy column + sticky stage — the
 *    scrollytelling primitive. All other layouts keep the flat structure.
 */
import { renderEmphasis } from '../../lib/text';
import { EXPLAIN } from '../../lib/explainers';

interface Props {
  number?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  kind?: string;
  plain?: string;
  layout?: string;
  /** Shell adoption (Phase 6): the source line moves OUT of the card and
   *  becomes the second line of the plain paragraph — one render site for
   *  every kind instead of ~70, which also ends the sibling-vs-child depth
   *  split that story.css had to special-case. `string` or the schema's
   *  `{ label, date }`; joined the way VizCard used to. */
  source?: string | { label: string; date?: string };
}
const { number, eyebrow, title, intro, kind, plain, layout, source } = Astro.props;

const plainText = plain ?? (kind ? EXPLAIN[kind]?.what : undefined);
const sourceLine =
  typeof source === 'string'
    ? source
    : source
      ? [source.label, source.date].filter(Boolean).join(' · ')
      : undefined;
const layoutAttr = layout && layout !== 'default' ? layout : undefined;
const isSplit = layoutAttr === 'split' || layoutAttr === 'split-flip';
---

{isSplit ? (
  <section class="px-section" data-reveal data-kind={kind} data-layout={layoutAttr}>
    <div class="px-section__copy">
      {number && <div class="px-section__num" data-n={number}>{number}</div>}
      {eyebrow && <div class="px-eyebrow">{eyebrow}</div>}
      {title && <h2 class="px-section__title" set:html={renderEmphasis(title)} />}
      {intro && <p class="px-section__intro">{intro}</p>}
      {(plainText || sourceLine) && (
        <p class="px-plain">
          {plainText && <><span class="px-plain__k">In plain terms</span>{' ' + plainText}</>}
          {sourceLine && <span class="px-plain__src">Source · {sourceLine}</span>}
        </p>
      )}
    </div>
    <div class="px-section__stage">
      <slot />
    </div>
  </section>
) : (
  <section class="px-section" data-reveal data-kind={kind} data-layout={layoutAttr}>
    {number && <div class="px-section__num" data-n={number}>{number}</div>}
    {eyebrow && <div class="px-eyebrow">{eyebrow}</div>}
    {title && <h2 class="px-section__title" set:html={renderEmphasis(title)} />}
    {intro && <p class="px-section__intro">{intro}</p>}
    <slot />
    {(plainText || sourceLine) && (
      <p class="px-plain">
        {plainText && <><span class="px-plain__k">In plain terms</span>{' ' + plainText}</>}
        {sourceLine && <span class="px-plain__src">Source · {sourceLine}</span>}
      </p>
    )}
  </section>
)}
