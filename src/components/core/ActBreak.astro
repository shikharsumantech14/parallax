---
/**
 * ActBreak — the chapter divider (`kind: act-break`). Data: { act: 'II',
 * title?, epigraph? }. It takes no section number and carries no cue anchors
 * (a NARRATIVE kind, LENS §5.1).
 *
 * LENS PHASE 6 (2026-09-30), the board Lib-act-break: a band on the well
 * (`--paper-3`, 6px corners) with a ruler along its top and bottom edges
 * (minor ticks in the hair, every fifth in the desk mark), the Roman numeral
 * at 160px (88px on a phone) in the desk text colour, a double rule each side
 * of it (the mark over the hair). The optional title and epigraph sit under
 * the numeral. Prefix `px-act`.
 *
 * THE BUILD (LENS §6.4): the band is a `data-build-scene`: 1 the rulers fade
 * in, 2 the side rules grow from the numeral outward, 3 the numeral rises,
 * 4 the title and epigraph rise (src/scripts/build.ts). No JS or reduced
 * motion: the band as drawn.
 */
import { renderEmphasis } from '../../lib/text';

interface Props {
  act?: string;
  title?: string;
  epigraph?: string;
}
const { act = 'I', title, epigraph } = Astro.props;
---

<div class="px-act" role="group" aria-label={`Act ${act}${title ? `: ${title}` : ''}`} data-build-scene>
  <span class="px-act__ruler" aria-hidden="true" data-build="1"></span>
  <div class="px-act__mid">
    <span class="px-act__rule px-act__rule--l" aria-hidden="true" data-build="2" data-build-kind="grow-x"></span>
    <span class="px-act__num" aria-hidden="true" data-build="3" data-build-kind="rise">{act}</span>
    <span class="px-act__rule px-act__rule--r" aria-hidden="true" data-build="2" data-build-kind="grow-x"></span>
  </div>
  {title && <h2 class="px-act__title" data-build="4" data-build-kind="rise" set:html={renderEmphasis(title)} />}
  {epigraph && <p class="px-act__epigraph" data-build="4" data-build-kind="rise">{epigraph}</p>}
  <span class="px-act__ruler px-act__ruler--b" aria-hidden="true" data-build="1"></span>
</div>

<style>
  .px-act {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 36px;
    margin: 24px 0 72px;
    padding: 32px 32px;
    background: var(--paper-3);
    border-radius: var(--r-card);
    text-align: center;
  }
  /* The ruler: a hair tick every 16px, a mark tick every 80px. */
  .px-act__ruler {
    display: block;
    height: 20px;
    background:
      repeating-linear-gradient(90deg, var(--accent) 0 1px, transparent 1px 80px) left top / 100% 20px no-repeat,
      repeating-linear-gradient(90deg, var(--hair-2) 0 1px, transparent 1px 16px) left 50% / 100% 10px no-repeat;
  }
  .px-act__ruler--b { background-position: left bottom, left 50%; }

  .px-act__mid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 40px;
  }
  .px-act__rule {
    display: block;
    height: 5px;
    border-top: 1.5px solid var(--accent);
    border-bottom: 1.5px solid var(--hair-2);
  }
  .px-act__rule--l { transform-origin: right center; }
  .px-act__rule--r { transform-origin: left center; }
  .px-act__num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(88px, 13vw, 160px);
    line-height: 0.92;
    letter-spacing: 0.02em;
    color: var(--accent-deep);
  }
  .px-act__title {
    margin: -12px auto 0;
    max-width: 560px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 3.4vw, 30px);
    line-height: 1.15;
    color: var(--ink);
  }
  .px-act__title :global(em) { font-style: italic; color: var(--accent-deep); }
  .px-act__epigraph {
    margin: -20px auto 0;
    max-width: 480px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  @media (max-width: 640px) {
    .px-act { gap: 24px; padding: 20px 16px; margin: 8px 0 40px; }
    .px-act__mid { gap: 16px; }
  }
</style>
