---
/**
 * CoverCard — the graphic-dominant issue card (Lens Phase 2, LENS §4.2; the
 * Home board's "Latest" cards, the Archive board's month groups, the Desk
 * board's dispatch tiles). For Home, Desk, Archive, the Shelf and Subscribe.
 *
 *   card  3-across. A 216px graphic panel on the desk tint (about 60% of the
 *         card), then the headline in Literata 700 21/1.18 (the authored
 *         `*word*` italic 400 in the desk text colour) and the meta line
 *         "No 17 · 28 Sep · 4 min" in 12px capitals behind the desk dot.
 *   tile  the desk strip. A 264px panel, then the meta line in the desk text
 *         colour with an arrow, then the headline at 24, under a 3px rule in
 *         the desk mark.
 *   row   a 120 x 72 thumbnail for the list row (home/IssueRows). Marks
 *         only, no words, aria-hidden, and NOT a link: the row it sits in is
 *         the link, and a link inside a link is invalid.
 *
 * `card` and `tile` are one `<a>` on the `.px-card` surface (paper-2, a hair,
 * 6px corners, shadow-1), lifting to an ink border and shadow-2 on hover, the
 * headline underlined; nothing moves. The panel draws `core/CoverMark.astro`.
 *
 * Prefix: px-cover. No JS.
 */
import type { CollectionEntry } from 'astro:content';
import CoverMark from './CoverMark.astro';
import { ink } from '../../lib/desk-inks';
import { renderEmphasis, stripEmphasis } from '../../lib/text';
import { formatNo, issueNumbers, shortDay } from '../../lib/issue-number';

interface Props {
  issue: CollectionEntry<'issues'>;
  size?: 'card' | 'row' | 'tile';
  /** The issue number; derived from the published collection when omitted. */
  number?: number;
  class?: string;
}
const { issue, size = 'card', number: numberProp, class: extra } = Astro.props;

const desk = issue.data.topic;
const n = numberProp ?? (await issueNumbers()).get(issue.slug);
const meta = [
  n ? formatNo(n) : undefined,
  shortDay(issue.data.publishedAt),
  issue.data.readTimeMinutes ? `${issue.data.readTimeMinutes} min` : undefined,
].filter(Boolean).join(' · ');

const inks = `--cv-text: ${ink(desk, 'text')}; --cv-mark: ${ink(desk, 'mark')}; --cv-tint: ${ink(desk, 'tint')}`;
const href = `/issues/${issue.slug}/`;
const label = `${n ? `${formatNo(n)}, ` : ''}${stripEmphasis(issue.data.title)}`;
---

{size === 'row' ? (
  <span class:list={['px-cover', 'px-cover--row', extra]} style={inks} aria-hidden="true">
    <span class="px-cover__panel"><CoverMark issue={issue} labels={false} /></span>
  </span>
) : (
  <a class:list={['px-card', 'px-cover', `px-cover--${size}`, extra]} href={href} style={inks} aria-label={label}>
    <span class="px-cover__panel"><CoverMark issue={issue} /></span>
    <span class="px-cover__body">
      {size === 'tile' ? (
        <>
          <span class="px-cover__meta px-cover__meta--desk">
            {meta}
            <svg class="px-cover__arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M2.5 8 H13 M9 4 L13 8 L9 12" />
            </svg>
          </span>
          <span class="px-cover__hl" set:html={renderEmphasis(issue.data.title)} />
        </>
      ) : (
        <>
          <span class="px-cover__hl" set:html={renderEmphasis(issue.data.title)} />
          <span class="px-cover__meta"><span class="px-cover__dot" aria-hidden="true"></span>{meta}</span>
        </>
      )}
    </span>
  </a>
)}

<style>
  /* The .px-card surface (base.css) without its padding and gap: the panel
     runs to the card's edges and the body carries its own padding. */
  .px-cover {
    padding: 0;
    gap: 0;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    min-width: 0;
  }
  .px-cover__panel {
    display: flex; align-items: center; justify-content: center;
    flex: 0 0 216px;
    height: 216px;
    background: var(--cv-tint);
    container-type: inline-size;
    overflow: hidden;
  }
  .px-cover--tile .px-cover__panel { flex-basis: 264px; height: 264px; }
  .px-cover__body {
    flex: 1;
    display: flex; flex-direction: column; justify-content: space-between; gap: 14px;
    padding: 20px 24px 22px;
    min-width: 0;
  }
  .px-cover--tile .px-cover__body {
    justify-content: flex-start; gap: 10px;
    padding: 20px 24px 24px;
    border-top: 3px solid var(--cv-mark);
  }
  .px-cover__hl {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: pretty;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .px-cover--tile .px-cover__hl { font-size: 24px; line-height: 1.15; }
  .px-cover__hl :global(em) { font-style: italic; color: var(--cv-text); font-weight: 400; }
  .px-cover:hover .px-cover__hl { text-decoration-line: underline; }
  .px-cover__meta {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--font-ui);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    line-height: 1.4;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .px-cover__meta--desk {
    justify-content: space-between;
    font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--cv-text);
    font-weight: 600;
  }
  .px-cover__dot { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 999px; background: var(--cv-mark); }
  .px-cover__arrow { flex: 0 0 16px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }

  /* The row thumbnail: 120 x 72, the tint, the marks alone. */
  .px-cover--row {
    display: block;
    width: 120px; height: 72px;
    flex: 0 0 120px;
    border-radius: var(--r-ctl);
    background: var(--cv-tint);
  }
  .px-cover--row .px-cover__panel { height: 72px; flex-basis: 72px; padding: 4px 6px; box-sizing: border-box; }

  @media (max-width: 768px) {
    .px-cover__body { padding: 16px 20px 20px; }
    .px-cover--tile .px-cover__hl { font-size: 22px; }
  }
</style>
