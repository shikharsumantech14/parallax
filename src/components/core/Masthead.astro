---
/**
 * Masthead — the single, unified v2 press header for every page.
 *
 * Replaces the six per-topic `.px-masthead--<topic>` variants with one
 * token-driven three-zone press header (`.mh`): brand + lens mark · status
 * pill · nav + Subscribe CTA. The world still shifts entirely via
 * `data-topic` on <html> (accent, paper, signature faces). Each world's
 * register microcopy (telemetry T+, atlas coordinates, build hash, matchday,
 * dateline) now reads in the per-issue <Banner> that sits just below.
 *
 * Markup is ported faithfully from the v2 kit (publication-v2/Sections.jsx +
 * styles.css `.mh*`). Styling lives in base.css (global, shared with the
 * Colophon lens). The only motion is the lens/status pulse, which
 * prefers-reduced-motion disables globally (motion-v2.css).
 *
 * Brand naming: the public brand "Parallax" is the wordmark (per the
 * brand-vs-legal split); the legal "Parallax Lens™" stays in <title>, RSS,
 * and the colophon.
 */
type Variant = 'meta' | 'politics' | 'space' | 'earth' | 'tech' | 'travel' | 'sports';

interface Props {
  /** Accepted for call-site compatibility; no longer switches markup —
   *  the active world is set by `data-topic` on <html>. */
  variant?: Variant;
  issueNumber?: string;
  date?: string;
  /** Status dot + label state. Published issues and meta pages are 'live'. */
  status?: 'live' | 'draft';
  /** Optional overrides for the status-pill text. */
  statusLabel?: string;
  statusSub?: string;
}
const { issueNumber, date, status = 'live', statusLabel, statusSub } = Astro.props;

import AccountEntry from './AccountEntry.astro';

const stateWord = status === 'draft' ? 'Draft' : 'Live';
const topLine =
  statusLabel ?? (issueNumber ? `Issue ${issueNumber} · ${stateWord}` : 'Parallax');
const subLine = statusSub ?? date ?? 'Est. 2026';
---

<header class="mh">
  <a class="mh__brand" href="/" aria-label="Parallax — home">
    <span class="mh__lens" aria-hidden="true">
      <span class="mh__lens-dot"></span>
    </span>
    <span class="mh__type">
      <span class="mh__name">Paral<span class="mh__name-tail">lax</span></span>
      <span class="mh__tagline">Visual Explainers · Est. 2026</span>
    </span>
  </a>

  <div class="mh__status">
    <span class="mh__status-dot" data-state={status}></span>
    <span class="mh__status-tx">
      <b>{topLine}</b>
      <span>{subLine}</span>
    </span>
  </div>

  <div class="mh__r">
    <nav class="mh__links" aria-label="Primary">
      <a href="/#desks">Desks</a>
      <a href="/about/">About</a>
      <a href="/rss.xml">Feed</a>
    </nav>
    <AccountEntry />
    <a href="/#subscribe" class="mh__cta">Subscribe<span aria-hidden="true">→</span></a>
  </div>

  {/*
    Phone navigation. Below 900px the desktop nav and status pill are hidden,
    which until now left the site with NO primary navigation at all on a phone.

    Built on <details>/<summary> rather than an island: it is a native
    disclosure, so it opens, closes and announces its state with ZERO
    JavaScript and is keyboard-operable for free. That satisfies the fallback
    contract by construction instead of by a no-JS branch.

    Only one of the two navs is ever in the accessibility tree — the other is
    display:none at every width — so the duplicate links never double up for
    screen readers.
  */}
  <details class="mh__menu">
    <summary class="mh__menu-btn">Menu</summary>
    <nav class="mh__menu-panel" aria-label="Primary (compact)">
      <a href="/#desks">Desks</a>
      <a href="/about/">About</a>
      <a href="/rss.xml">Feed</a>
      <span class="mh__menu-status">
        <span class="mh__status-dot" data-state={status}></span>
        <b>{topLine}</b><span>{subLine}</span>
      </span>
    </nav>
  </details>
</header>
