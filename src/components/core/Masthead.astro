---
/**
 * Masthead — the launch lockup (2026-09-08), one header for every page.
 *
 * Left: the lockup — the medallion drawn TIGHT (the ring is the edge, so the
 * 12px gap is measured from the ring, not from the brand file's clear space),
 * the wordmark at 25px/700 with its cap centre on the disc centre, and the
 * register on the same axis: the desk's own name on a desk page ("Politics
 * desk", "Mission control"), "Visual explainers" on the house pages. A long
 * house line is what once pushed Sign in and Subscribe onto a second row.
 *
 * Right: Home · Desks · Archive · About (the current one underlined in the
 * accent), the pulsing live badge, the account slot, and a square ink
 * Subscribe. Below 768px the right side folds into a native <details> Menu —
 * it opens, closes and announces itself with zero JavaScript, and only one of
 * the two navs is ever in the accessibility tree.
 *
 * Styling lives in base.css (`.mh`). Brand naming: the public brand
 * "Parallax" is the wordmark; the legal "Parallax Lens™" stays in <title>,
 * RSS and the footer's legal line.
 */
import AccountEntry from './AccountEntry.astro';
import Mark from './Mark.astro';
import { DESK_REGISTER } from '../../lib/desks';
import type { Topic } from '../../content/config';

type Variant = 'meta' | Topic;
type Current = 'home' | 'desks' | 'archive' | 'about' | 'subscribe';

interface Props {
  /** The world this page stands in; 'meta' (or omitted) = the house pages. */
  variant?: Variant;
  /** The badge: "Issue NN · live". */
  issueNumber?: string;
  /** Accepted for call-site compatibility; the date now reads in the fact
   *  rail, not here. */
  date?: string;
  status?: 'live' | 'draft';
  /** Which nav item is the current page. */
  current?: Current;
}
const { variant, issueNumber, status = 'live', current } = Astro.props;

const desk = variant && variant !== 'meta' ? (variant as Topic) : undefined;
const register = desk ? DESK_REGISTER[desk] : 'Visual explainers';
const stateWord = status === 'draft' ? 'draft' : 'live';
const badge = issueNumber ? `Issue ${issueNumber} · ${stateWord}` : 'Est. 2026';

const nav: { key: Current; label: string; href: string }[] = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'desks', label: 'Desks', href: '/#desks' },
  { key: 'archive', label: 'Archive', href: '/archive/' },
  { key: 'about', label: 'About', href: '/about/' },
];
---

<header class="mh">
  <a class="mh__brand" href="/" aria-label="Parallax — home">
    {/* RD-10 step 5 — the PER-DESK CUT: the mark carries the station and the
        accent of the world it stands in. House pages take the house cut. */}
    <Mark desk={desk} size={34} ring={9} tight class="mh__mark" />
    <span class="mh__type">
      <span class="mh__name">Parallax</span>
      <span class="mh__desk">{register}</span>
    </span>
  </a>

  <div class="mh__r">
    <nav class="mh__links" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <span class="mh__status">
      <span class="mh__status-dot" data-state={status}></span>
      {badge}
    </span>
    <AccountEntry />
    <a href="/subscribe/" class="mh__cta" aria-current={current === 'subscribe' ? 'page' : undefined}>
      Subscribe<span aria-hidden="true">→</span>
    </a>
  </div>

  <details class="mh__menu">
    <summary class="mh__menu-btn">Menu</summary>
    <nav class="mh__menu-panel" aria-label="Primary (compact)">
      {nav.map((n) => (
        <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
      ))}
      <a href="/subscribe/">Subscribe</a>
      <span class="mh__menu-status">
        <span class="mh__status-dot" data-state={status}></span>
        {badge}
      </span>
      <span class="mh__menu-cta"><AccountEntry /></span>
    </nav>
  </details>
</header>
