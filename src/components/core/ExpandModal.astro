---
/**
 * ExpandModal — in-page "study view" lightbox for data-viz. Rendered once per
 * issue page.
 *
 * Adds a ⤢ button to every viz card (.px-viz / .vb / .tl / .tel). On click it
 * PORTALS the live root node into the modal (leaving a same-height placeholder
 * so the page never shifts), REPLAYS its entrance animation so it feels alive,
 * and shows a plain-language explainer beside it: "What you're looking at"
 * (per component kind) + "How to explore" + the issue's own caption/intro. The
 * kind is read from the enclosing `.px-section[data-kind]`.
 *
 * The explainer dictionary lives in src/lib/explainers.ts (shared with the
 * in-flow "In plain terms" line in core/Section.astro) and is serialized into
 * a JSON script tag below — one dictionary, two consumers, no drift.
 *
 * a11y: role=dialog + aria-modal, Esc / backdrop / ✕ close, focus trap, focus
 * returned to the trigger, body scroll locked. No-JS: never runs (no buttons).
 * Reduced-motion: no transitions, no replay.
 */
import { EXPLAIN } from '../../lib/explainers';
---
<script type="application/json" id="px-explain-data" set:html={JSON.stringify(EXPLAIN)} />
<div class="px-modal" data-expand-modal hidden>
  <div class="px-modal__backdrop" data-modal-close aria-hidden="true"></div>
  <div class="px-modal__panel" role="dialog" aria-modal="true" aria-labelledby="px-modal-title">
    <header class="px-modal__bar">
      <span class="px-modal__title" id="px-modal-title" data-modal-title></span>
      <button class="px-modal__close" type="button" data-modal-close data-modal-close-btn aria-label="Close (Esc)"><span aria-hidden="true">✕</span></button>
    </header>
    <div class="px-modal__body">
      <div class="px-modal__stage" data-modal-slot></div>
      <aside class="px-modal__aside">
        <div class="px-modal__aside-h">What you're looking at</div>
        <p class="px-modal__lede" data-modal-lede></p>
        <p class="px-modal__how" data-modal-how><b>Explore</b><span data-modal-how-text></span></p>
        <p class="px-modal__ctx" data-modal-ctx></p>
      </aside>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var modal = document.querySelector('[data-expand-modal]');
    if (!modal) return;
    var slot = modal.querySelector('[data-modal-slot]');
    var titleEl = modal.querySelector('[data-modal-title]');
    var ledeEl = modal.querySelector('[data-modal-lede]');
    var howEl = modal.querySelector('[data-modal-how]');
    var howText = modal.querySelector('[data-modal-how-text]');
    var ctxEl = modal.querySelector('[data-modal-ctx]');
    var panel = modal.querySelector('.px-modal__panel');
    var closeBtn = modal.querySelector('[data-modal-close-btn]');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Plain-language explainers live in src/lib/explainers.ts (shared with
    // the in-flow "In plain terms" line in core/Section.astro); the
    // frontmatter serializes the dict into #px-explain-data above.
    var EXPLAIN = {};
    try { EXPLAIN = JSON.parse(document.getElementById('px-explain-data').textContent) || {}; } catch (e) { /* keep {} */ }

    var active = null, placeholder = null, lastFocus = null, hideTimer = 0;

    function fireResize() { requestAnimationFrame(function () { window.dispatchEvent(new Event('resize')); }); }

    function ctxOf(root) {
      var sec = root.closest('.px-section');
      var kind = sec ? (sec.getAttribute('data-kind') || '') : '';
      var title = '', intro = '';
      if (sec) {
        var t = sec.querySelector('.px-section__title');
        var i = sec.querySelector('.px-section__intro');
        if (t) title = t.textContent.trim();
        if (i) intro = i.textContent.trim();
      }
      var cap = root.querySelector('.px-viz__cap span, .vb__cap, .tel__cap span');
      var capText = cap ? cap.textContent.trim() : '';
      if (!title) title = capText;
      if (!intro) intro = capText;
      return { kind: kind, title: title, intro: intro };
    }

    function replay(root) {
      if (reduce) return;
      var nodes = [];
      if (root.hasAttribute('data-reveal')) nodes.push(root);
      root.querySelectorAll('[data-reveal]').forEach(function (n) { nodes.push(n); });
      if (!nodes.length) return;
      nodes.forEach(function (n) { n.classList.remove('is-in'); });
      void root.offsetWidth;
      requestAnimationFrame(function () { requestAnimationFrame(function () {
        nodes.forEach(function (n) { n.classList.add('is-in'); });
      }); });
    }

    function open(root, btn) {
      if (active) return;
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = 0; }
      active = root;
      lastFocus = btn || document.activeElement;

      var c = ctxOf(root);
      titleEl.textContent = c.title || 'Expanded view';
      var ex = EXPLAIN[c.kind];
      if (ex && ex.what) { ledeEl.textContent = ex.what; ledeEl.style.display = ''; }
      else ledeEl.style.display = 'none';
      if (ex && ex.how) { howText.textContent = ' ' + ex.how; howEl.style.display = ''; }
      else howEl.style.display = 'none';
      if (c.intro) { ctxEl.textContent = c.intro; ctxEl.style.display = ''; }
      else ctxEl.style.display = 'none';

      var rect = root.getBoundingClientRect();
      placeholder = document.createElement('div');
      placeholder.className = 'px-modal__ph';
      placeholder.style.height = rect.height + 'px';
      root.parentNode.insertBefore(placeholder, root);

      root.classList.add('px-modal__viz');
      slot.appendChild(root);

      document.body.classList.add('px-modal-open');
      modal.hidden = false;
      void modal.offsetWidth;
      modal.classList.add('is-open');

      fireResize();
      replay(root);
      if (closeBtn) closeBtn.focus();
      document.addEventListener('keydown', onKey, true);
    }

    function close() {
      if (!active) return;
      if (placeholder && placeholder.parentNode) {
        placeholder.parentNode.insertBefore(active, placeholder);
        placeholder.parentNode.removeChild(placeholder);
      }
      active.classList.remove('px-modal__viz');
      modal.classList.remove('is-open');
      document.body.classList.remove('px-modal-open');
      document.removeEventListener('keydown', onKey, true);
      var restore = lastFocus;
      var hide = function () { modal.hidden = true; };
      if (reduce) hide(); else hideTimer = setTimeout(hide, 300);
      active = null; placeholder = null;
      fireResize();
      if (restore && restore.focus) restore.focus();
    }

    function onKey(e) {
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key === 'Tab') {
        var f = panel.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        var vis = [];
        for (var k = 0; k < f.length; k++) { if (f[k].offsetParent !== null || f[k] === closeBtn) vis.push(f[k]); }
        if (!vis.length) return;
        var first = vis[0], last = vis[vis.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }

    modal.addEventListener('click', function (e) { if (e.target.closest('[data-modal-close]')) close(); });

    document.querySelectorAll('.px-viz, .vb, .tl, .tel').forEach(function (root) {
      if (root.closest('[data-modal-slot]')) return;
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'px-vexp';
      btn.setAttribute('aria-label', 'Expand to full view');
      btn.innerHTML = '<span aria-hidden="true">⤢</span>';
      btn.addEventListener('click', function (e) { e.stopPropagation(); open(root, btn); });
      root.appendChild(btn);
    });
  })();
</script>
