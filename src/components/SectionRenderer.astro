---
/**
 * SectionRenderer — the article shell around every section.
 *
 * The kind → component switch lives in SectionBody.astro (shared with story
 * mode). This file hands a section to its shell: the act-break divider, or
 * core/Section.astro, the Lens reading system (article beside the pinned
 * figure, Phase 3), with SectionBody in `bare` mode inside it. It also keeps
 * the skim-mode caption block (any kind may carry `skimCaption`; in skim mode
 * prose hides behind its caption).
 */
import type { Section, Source } from '../content/config';
import CoreSection from './core/Section.astro';
import SectionBody from './SectionBody.astro';
import ActBreak from './core/ActBreak.astro';

interface Props {
  section: Section;
  /** 0-based numbered index; -1 for an act-break, which takes no number. */
  index: number;
  /** How many numbered sections the issue has. */
  total?: number;
  /** The issue's sources, so the source line can link its first cited one. */
  sources?: Source[];
}

const { section, index, total = 0, sources = [] } = Astro.props;
const data: any = section.data ?? {};
const n = index + 1;
const sourceUrl = sources.find((s) => s.id === section.sourceRefs?.[0])?.url;
---

{section.kind === 'act-break' && (
  <ActBreak act={data.act} title={data.title ?? section.title} epigraph={data.epigraph} />
)}

{section.kind === 'prose' && (
  <Fragment>
    <div class="px-prose-full">
      <CoreSection section={section} n={n} total={total} sourceUrl={sourceUrl}>
        <SectionBody section={section} bare />
      </CoreSection>
    </div>
    {section.skimCaption && (
      <div class="px-skim-caption-block">
        <p class="px-skim-caption-text">{section.skimCaption}</p>
      </div>
    )}
  </Fragment>
)}

{section.kind !== 'act-break' && section.kind !== 'prose' && (
  <Fragment>
    <CoreSection section={section} n={n} total={total} sourceUrl={sourceUrl}>
      <SectionBody section={section} bare />
    </CoreSection>
    {section.skimCaption && (
      <div class="px-skim-caption-block">
        <p class="px-skim-caption-text">{section.skimCaption}</p>
      </div>
    )}
  </Fragment>
)}
