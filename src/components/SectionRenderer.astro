---
/**
 * SectionRenderer — the article shell around every section.
 *
 * Composition (since 2026-07-05): the kind → component switch lives in
 * SectionBody.astro (shared with story mode); this file owns the ARTICLE
 * chrome — core/Section.astro (number / eyebrow / title / intro / plain line /
 * layout attribute), the act-break divider, and the skim-mode caption block
 * (any section kind may carry `skimCaption`; in skim mode prose hides behind
 * its caption, viz sections show caption alongside — the skim rail reads as a
 * complete summary).
 */
import type { Section } from '../content/config';
import CoreSection from './core/Section.astro';
import SectionBody from './SectionBody.astro';
import ActBreak from './core/ActBreak.astro';

interface Props {
  section: Section;
  index: number;
}

const { section, index } = Astro.props;
const data: any = section.data ?? {};

const autoNumber = section.number ?? `— ${String(index + 1).padStart(2, '0')}`;
---

{section.kind === 'act-break' && (
  <ActBreak act={data.act} title={data.title ?? section.title} epigraph={data.epigraph} />
)}

{section.kind === 'prose' && (
  <Fragment>
    <div class="px-prose-full">
      <CoreSection
        number={autoNumber}
        eyebrow={section.eyebrow}
        title={section.title}
        intro={section.intro}
        kind={section.kind}
        plain={section.plain}
        layout={section.layout}
        source={section.source ?? data.source}
        howToRead={section.howToRead}
      >
        <SectionBody section={section} />
      </CoreSection>
    </div>
    {section.skimCaption && (
      <div class="px-skim-caption-block">
        <p class="px-skim-caption-text">{section.skimCaption}</p>
      </div>
    )}
  </Fragment>
)}

{section.kind !== 'hero' && section.kind !== 'act-break' && section.kind !== 'prose' && (
  <Fragment>
    <CoreSection
      number={autoNumber}
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
      kind={section.kind}
      plain={section.plain}
      layout={section.layout}
      source={section.source ?? data.source}
      howToRead={section.howToRead}
    >
      <SectionBody section={section} />
    </CoreSection>
    {section.skimCaption && (
      <div class="px-skim-caption-block">
        <p class="px-skim-caption-text">{section.skimCaption}</p>
      </div>
    )}
  </Fragment>
)}
