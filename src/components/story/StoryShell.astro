---
/**
 * StoryShell — the card scroller, the stepper and the keys (Lens, 2026-09-30,
 * Phase 4b; the Story and Story-Phone boards). Spec: STORY-MODE-SPEC.md §3.
 *
 * Desktop (768px and up): a head (the eyebrow "Story · Match programme ·
 * No 17", "The short version, in five cards", the story's address), then the
 * 360 x 640 cards in ONE horizontal row that snaps card by card, 24px apart
 * on the 64px frame margin, then the dot stepper: a dot and a short name per
 * card on a hair line, the current one filled in the desk mark with a ring.
 * The stepper's dots are links to the cards (#c1…), so they work with no JS;
 * the island marks the current one and adds the prev / next buttons and the
 * arrow keys (left / right).
 *
 * Phone: each card is the screen (100dvh) and the shell snaps vertically, as
 * before; every card carries its own "k of n" dots (StoryCard / hook / CTA),
 * so the phone needs no floating control. Up / down keys page.
 *
 * No JS: the cards are ordinary DOM in source order, the snap is pure CSS,
 * nothing is hidden. Reduced motion: proximity snap and instant scrolls.
 */
import type { Topic } from '../../content/config';
import { ink } from '../../lib/desk-inks';

interface Props {
  cardCount: number;
  /** One short name per card, for the stepper (Cover, the beats, Read on). */
  labels: string[];
  desk: Topic;
  eyebrow: string;
  slug: string;
}
const { cardCount, labels, desk, eyebrow, slug } = Astro.props;

const WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const countWord = WORDS[cardCount] ?? String(cardCount);
const vars = `--dk-text: ${ink(desk, 'text')}; --dk-mark: ${ink(desk, 'mark')}; --dk-tint: ${ink(desk, 'tint')}; --dk-deep: ${ink(desk, 'deep')}`;
---

<div class="pxs" style={vars}>
  <header class="pxs-head">
    <div class="pxs-head__text">
      <span class="pxs-head__eyebrow">{eyebrow}</span>
      <p class="pxs-head__title">The short version, in {countWord} cards</p>
    </div>
    <span class="pxs-head__url">parallaxlens.com/s/{slug}</span>
  </header>

  <div class="pxs-shell" id="pxs-shell" tabindex="-1">
    <slot />
  </div>

  <nav class="pxs-step" aria-label="Story cards">
    <button class="pxs-step__nav" id="pxs-prev" type="button" aria-label="Previous card" hidden>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <ol class="pxs-step__list" style={`--steps: ${cardCount}`}>
      {labels.slice(0, cardCount).map((label, i) => (
        <li class="pxs-step__item">
          <a class="pxs-step__link" href={`#c${i + 1}`} aria-current={i === 0 ? 'step' : undefined} data-step={i}>
            <span class="pxs-step__dot" aria-hidden="true"></span>
            <span class="pxs-step__label">{label}</span>
          </a>
        </li>
      ))}
    </ol>
    <button class="pxs-step__nav" id="pxs-next" type="button" aria-label="Next card" hidden>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </nav>
</div>

<script is:inline>
  (function () {
    var shell = document.getElementById('pxs-shell');
    if (!shell) return;
    var cards = Array.prototype.slice.call(shell.querySelectorAll('.pxs-card'));
    if (!cards.length) return;
    var steps = Array.prototype.slice.call(document.querySelectorAll('[data-step]'));
    var prevBtn = document.getElementById('pxs-prev');
    var nextBtn = document.getElementById('pxs-next');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var wide = window.matchMedia ? window.matchMedia('(min-width: 768px)') : { matches: false };
    var current = 0;

    if (prevBtn) prevBtn.hidden = false;
    if (nextBtn) nextBtn.hidden = false;

    function paint() {
      steps.forEach(function (s, i) {
        if (i === current) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
        s.classList.toggle('is-done', i < current);
      });
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current === cards.length - 1;
    }

    /* The current card is the one nearest the scroller's leading edge: the
       left edge of the desktop row (three cards show at once, so "in view"
       would pick the last of them), the top of the phone column. */
    function track() {
      var best = 0;
      var bestD = Infinity;
      cards.forEach(function (c, i) {
        var d = wide.matches
          ? Math.abs(c.offsetLeft - shell.offsetLeft - shell.scrollLeft)
          : Math.abs(c.offsetTop - shell.offsetTop - shell.scrollTop);
        if (d < bestD) { bestD = d; best = i; }
      });
      if (best !== current) { current = best; paint(); }
    }
    var ticking = false;
    shell.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () { ticking = false; track(); });
    }, { passive: true });

    function go(idx) {
      idx = Math.max(0, Math.min(cards.length - 1, idx));
      var behavior = reduce ? 'auto' : 'smooth';
      if (wide.matches) {
        shell.scrollTo({ left: cards[idx].offsetLeft - shell.offsetLeft - parseFloat(getComputedStyle(shell).scrollPaddingLeft || '0'), behavior: behavior });
      } else {
        cards[idx].scrollIntoView({ behavior: behavior, block: 'start' });
      }
    }
    if (prevBtn) prevBtn.addEventListener('click', function () { go(current - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { go(current + 1); });
    steps.forEach(function (s, i) {
      s.addEventListener('click', function (e) { e.preventDefault(); go(i); });
    });

    document.addEventListener('keydown', function (e) {
      if (e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;
      var fwd = wide.matches ? ['ArrowRight', 'PageDown'] : ['ArrowDown', 'PageDown'];
      var back = wide.matches ? ['ArrowLeft', 'PageUp'] : ['ArrowUp', 'PageUp'];
      if (fwd.indexOf(e.key) >= 0) { e.preventDefault(); go(current + 1); }
      else if (back.indexOf(e.key) >= 0) { e.preventDefault(); go(current - 1); }
    });

    paint();
  })();
</script>
