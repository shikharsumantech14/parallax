---
/**
 * StoryShare — share the story link (STORY-MODE-SPEC §5 share mechanics).
 * navigator.share where available → clipboard fallback + an inline
 * "Link copied" confirmation (role=status, fades after 2s). JS-gated:
 * hidden without JS (the URL bar is the no-JS share path). Prefix pxs-.
 */
interface Props {
  storyUrl: string;
}
const { storyUrl } = Astro.props;
---

<div class="pxs-share" data-story-url={storyUrl} hidden>
  <button class="pxs-share__btn" type="button" data-share-btn>
    <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
      <path d="M14 6.5a2.5 2.5 0 1 0-2.45-3M6 10.5a2.5 2.5 0 1 0 0-1M14 16.5a2.5 2.5 0 1 0-2.45-3M8.1 9.2l3.8-2.4M8.1 11.8l3.8 2.4"
        fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    Share this story
  </button>
  <span class="pxs-share__ok" role="status" aria-live="polite" hidden>Link copied</span>
</div>

<script is:inline>
  (function () {
    var root = document.currentScript.previousElementSibling;
    while (root && !(root.classList && root.classList.contains('pxs-share'))) {
      root = root.previousElementSibling;
    }
    if (!root) return;
    root.hidden = false;
    var url = root.dataset.storyUrl || location.href;
    var btn = root.querySelector('[data-share-btn]');
    var ok = root.querySelector('.pxs-share__ok');
    var okTimer = 0;
    function confirmCopied() {
      if (!ok) return;
      ok.hidden = false;
      if (okTimer) clearTimeout(okTimer);
      okTimer = setTimeout(function () { ok.hidden = true; }, 2000);
    }
    btn && btn.addEventListener('click', function () {
      var title = document.title || 'Parallax';
      if (navigator.share) {
        navigator.share({ title: title, url: url }).catch(function () {});
      } else if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(confirmCopied).catch(function () {});
      } else {
        confirmCopied();
      }
    });
  })();
</script>
