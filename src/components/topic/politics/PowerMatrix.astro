---
/**
 * PowerMatrix — v2 institutional control grid (.pm) inside the elevated .px-viz
 * card. Cells scale-in row by row on scroll. Faithful port of publication-v2
 * DataViz1.jsx <PowerMatrix>. Build-time, zero runtime JS.
 *
 * props:
 *   institutions[] — string[]
 *   parties[]      — { id, label, color? }
 *   cells[]        — { institution, party, control: full|partial|none|contested }
 *   caption · source
 */
interface Party { id: string; label: string; color?: string; }
interface Cell {
  institution: string;
  party: string;
  control: 'full' | 'partial' | 'none' | 'contested';
}
interface Props {
  institutions: string[];
  parties: Party[];
  cells: Cell[];
  caption?: string;
  source?: string;
}
const { institutions = [], parties = [], cells = [], caption, source } = Astro.props;

const colorOf = (pid: string) => parties.find((p) => p.id === pid)?.color || 'var(--muted)';
const cellFor = (inst: string, pid: string): Cell =>
  cells.find((c) => c.institution === inst && c.party === pid) || { institution: inst, party: pid, control: 'none' };

const GLYPH: Record<string, string> = { full: '●', partial: '◐', none: '○', contested: '◆' };
// The kit styles full / partial / none; 'contested' borrows the partial hatch.
const attrOf = (control: string) => (control === 'contested' ? 'partial' : control);
---

<div class="px-viz" data-reveal>
  {caption && <div class="px-viz__cap"><span>{caption}</span></div>}
  <div class="pm__grid" style={`--cols:${parties.length}`}>
    <div class="pm__row">
      <div class="pm__head" style="padding-left:0"></div>
      {parties.map((p) => <div class="pm__head">{p.label}</div>)}
    </div>
    {institutions.map((inst, ri) => (
      <div class="pm__row">
        <div class="pm__inst">{inst}</div>
        {parties.map((p) => {
          const c = cellFor(inst, p.id);
          const bg = c.control === 'none' ? undefined : colorOf(p.id);
          return (
            <div class="pm__cell" data-control={attrOf(c.control)}
                 style={`${bg ? `background:${bg};` : ''}transition-delay:${ri * parties.length * 40}ms`}>
              <span>{GLYPH[c.control] ?? '○'}</span>
            </div>
          );
        })}
      </div>
    ))}
  </div>
  <div class="pm__legend">
    <span class="key">● Full control</span>
    <span class="key">◐ Partial / contested</span>
    <span class="key">○ None</span>
  </div>
  {source && <div class="px-viz__src">Source · {source}</div>}
</div>
