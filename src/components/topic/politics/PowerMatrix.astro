---
/**
 * PowerMatrix — v2 institutional control grid (.pm) inside the elevated .px-viz
 * card. Faithful port of publication-v2 DataViz1.jsx <PowerMatrix>.
 * Build-time, zero JS of its own. THE BUILD (Lens Phase 5, LENS §6.4): the
 * card is a `data-build-scene`: 1 the axes (party heads, institution
 * names) fade in, 2 the cells drop in row by row, 3 the legend
 * (src/scripts/build.ts). No JS or reduced motion: the grid as written.
 *
 * props:
 *   institutions[] — string[]
 *   parties[]      — { id, label, color? }
 *   cells[]        — { institution, party, control: full|partial|none|contested }
 *   caption · source
 */
interface Party { id: string; label: string; color?: string; }
interface Cell {
  institution: string;
  party: string;
  control: 'full' | 'partial' | 'none' | 'contested';
}
interface Props {
  institutions: string[];
  parties: Party[];
  cells: Cell[];
  caption?: string;
  source?: string;
}
const { institutions = [], parties = [], cells = [], caption, source } = Astro.props;

const colorOf = (pid: string) => parties.find((p) => p.id === pid)?.color || 'var(--muted)';
const cellFor = (inst: string, pid: string): Cell =>
  cells.find((c) => c.institution === inst && c.party === pid) || { institution: inst, party: pid, control: 'none' };

const GLYPH: Record<string, string> = { full: '●', partial: '◐', none: '○', contested: '◆' };
// The kit styles full / partial / none; 'contested' borrows the partial hatch.
const attrOf = (control: string) => (control === 'contested' ? 'partial' : control);
---

<div class="px-viz" data-build-scene>
  {caption && <div class="px-viz__cap"><span>{caption}</span></div>}
  <div class="pm__grid" style={`--cols:${parties.length}`}>
    <div class="pm__row">
      <div class="pm__head" style="padding-left:0"></div>
      {parties.map((p) => <div class="pm__head" data-build="1">{p.label}</div>)}
    </div>
    {/* Cue anchors (LENS §5.2): each institution row is `data-cue="<n>"`,
        numbered from 1 in data order (the header row is not an anchor). */}
    {institutions.map((inst, ri) => (
      <div class="pm__row" data-cue={ri + 1}>
        <div class="pm__inst" data-build="1"><span class="px-cue-tag" data-cue-tag={ri + 1} hidden></span>{inst}</div>
        {parties.map((p) => {
          const c = cellFor(inst, p.id);
          const bg = c.control === 'none' ? undefined : colorOf(p.id);
          return (
            <div class="pm__cell" data-control={attrOf(c.control)} data-build={2 + ri} data-build-kind="drop"
                 style={bg ? `background:${bg}` : undefined}>
              <span>{GLYPH[c.control] ?? '○'}</span>
            </div>
          );
        })}
      </div>
    ))}
  </div>
  <div class="pm__legend" data-build={2 + institutions.length}>
    <span class="key">● Full control</span>
    <span class="key">◐ Partial / contested</span>
    <span class="key">○ None</span>
  </div>
</div>
