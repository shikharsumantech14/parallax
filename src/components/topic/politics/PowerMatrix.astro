---
/**
 * PowerMatrix (politics) — who holds each lever. Lens Phase 6 (2026-09-30),
 * to the Lib-power-matrix board: institutions down the left, parties across
 * the top, and in every cell one 28px square: full control a solid square in
 * the desk mark, partial a light square, contested a hatched square with an
 * ink edge, no control a dashed outline. A legend of the four states closes
 * it. The board draws every column in the desk mark, so the cells do too; a
 * party's own `color` shows as the small key dot beside its name.
 *
 * Cue anchors (LENS §5.2):
 *   1 … n        each institution row, numbered from 1 in DATA order
 *   <party id>   each party column head (the `id` from `parties`)
 *   <r>-<c>      one cell: row r, party column c, both from 1
 *   legend       the key
 *
 * THE BUILD (LENS §6.4): the root is a scene. 1 the party heads and the
 * institution names fade in, 2 … the cells drop in, row by row, 80ms apart,
 * then the legend. No JS or reduced motion: the grid as written.
 *
 * props:
 *   institutions[] — string[]
 *   parties[]      — { id, label, color? }
 *   cells[]        — { institution, party, control: full|partial|none|contested }
 *   caption · source
 */
interface Party { id: string; label: string; color?: string; }
interface Cell {
  institution: string;
  party: string;
  control: 'full' | 'partial' | 'none' | 'contested';
}
interface Props {
  institutions: string[];
  parties: Party[];
  cells: Cell[];
  caption?: string;
  source?: string;
}
const { institutions = [], parties = [], cells = [] } = Astro.props;

const cellFor = (inst: string, pid: string): Cell['control'] =>
  cells.find((c) => c.institution === inst && c.party === pid)?.control ?? 'none';
const WORD: Record<string, string> = { full: 'full control', partial: 'partial', contested: 'contested', none: 'no control' };
const cols = parties.length;
const legendStep = 2 + institutions.length;
const used = new Set(cells.map((c) => c.control));
---

<div class="pm" data-viz-root data-build-scene>
  <div class="pm__tbl" role="table" aria-label="Who controls each institution" style={`--cols:${cols}`}>
    <div class="pm__row pm__row--head" role="row">
      <span role="columnheader"></span>
      {parties.map((p) => (
        <span class="pm__head" role="columnheader" data-cue={p.id} data-build="1">
          <span class="px-cue-tag" data-cue-tag={p.id} hidden></span>
          {p.color && <i class="pm__dot" style={`background:${p.color}`}></i>}
          <span>{p.label}</span>
        </span>
      ))}
    </div>
    {institutions.map((inst, ri) => (
      <div class="pm__row" role="row" data-cue={ri + 1}>
        <span class="pm__inst" role="rowheader" data-build="1"><span class="px-cue-tag" data-cue-tag={ri + 1} hidden></span><span>{inst}</span></span>
        {parties.map((p, ci) => {
          const c = cellFor(inst, p.id);
          const id = `${ri + 1}-${ci + 1}`;
          return (
            <span class="pm__cell" role="cell" aria-label={`${p.label}: ${WORD[c] ?? c}`} data-cue={id}>
              <i class="pm__sq" data-control={c} data-build={2 + ri} data-build-kind="drop"></i>
              <span class="px-cue-tag" data-cue-tag={id} hidden></span>
            </span>
          );
        })}
      </div>
    ))}
  </div>
  <div class="pm__legend" data-cue="legend" data-build={legendStep}>
    <span class="px-cue-tag" data-cue-tag="legend" hidden></span>
    <span class="pm__key"><i class="pm__sq pm__sq--sm" data-control="full"></i>Full control</span>
    <span class="pm__key"><i class="pm__sq pm__sq--sm" data-control="partial"></i>Partial</span>
    {used.has('contested') && <span class="pm__key"><i class="pm__sq pm__sq--sm" data-control="contested"></i>Contested</span>}
    <span class="pm__key"><i class="pm__sq pm__sq--sm" data-control="none"></i>No control</span>
  </div>
</div>

<style>
  .pm { display: flex; flex-direction: column; gap: 16px; min-width: 0; font-family: var(--font-ui); }
  /* One grid for the whole table, the rows its subgrids, so every row
     shares the columns that the longest word in each column sets. */
  .pm__tbl {
    display: grid;
    grid-template-columns: minmax(min-content, 1.5fr) repeat(var(--cols, 3), minmax(min-content, 1fr));
    column-gap: 6px;
  }
  .pm__row {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
    padding: 4px 0;
    border-top: 1px solid var(--hair);
  }
  .pm__row--head { align-items: end; padding: 0 0 8px; border-top: 0; }
  .pm__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 0;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink-2);
    text-align: center;
    overflow-wrap: normal;
    word-break: normal;
  }
  .pm__head .px-cue-tag { margin: 0; }
  .pm__dot { display: block; width: 8px; height: 8px; border-radius: 50%; }
  .pm__inst {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink);
    overflow-wrap: normal;
    word-break: normal;
  }
  .pm__inst .px-cue-tag { flex: none; margin-right: 0; }
  .pm__cell { position: relative; display: flex; justify-content: center; align-items: center; min-width: 34px; min-height: 34px; }
  .pm__cell .px-cue-tag { position: absolute; left: calc(50% + 18px); margin: 0; }

  .pm__sq { display: block; width: 28px; height: 28px; flex: none; border-radius: 4px; box-sizing: border-box; }
  .pm__sq--sm { width: 14px; height: 14px; border-radius: 3px; }
  .pm__sq[data-control='full'] { background: var(--accent); }
  .pm__sq[data-control='partial'] { background: color-mix(in oklab, var(--accent) 42%, var(--paper-2)); }
  .pm__sq[data-control='contested'] {
    border: 2px solid var(--ink);
    background:
      repeating-linear-gradient(-45deg, var(--accent-deep) 0 2px, transparent 2px 7px),
      var(--accent-tint);
  }
  .pm__sq--sm[data-control='contested'] { border-width: 1.5px; background: repeating-linear-gradient(-45deg, var(--accent-deep) 0 1.5px, transparent 1.5px 4px), var(--accent-tint); }
  .pm__sq[data-control='none'] { border: 1.5px dashed var(--hair-2); }

  .pm__legend { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .pm__legend .px-cue-tag { margin-right: -8px; }
  .pm__key { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; color: var(--ink-2); }

  @media (max-width: 560px) {
    /* Words never break inside a label (2026-10-04): the row-label column is
       at least as wide as its longest word, and on a phone the column heads
       turn to run bottom to top, so a head needs only its line height across
       and "District magistrate" keeps both words whole. */
    .pm__tbl { grid-template-columns: minmax(min-content, 1.4fr) repeat(var(--cols, 3), minmax(34px, 1fr)); column-gap: 4px; }
    .pm__head > span:last-child { writing-mode: vertical-rl; transform: rotate(180deg); max-height: 132px; text-align: start; }
    .pm__sq { width: 24px; height: 24px; }
    .pm__cell .px-cue-tag { left: calc(50% + 14px); }
  }
</style>
