---
/**
 * Timeline — v2 vertical rail (.tl): a hairline rail and state-coloured nodes
 * (default / key / fail / now). Faithful port of publication-v2
 * Components.jsx <Timeline>. The rail and node are pure CSS
 * (.tl__row::before). THE BUILD (Lens Phase 5, LENS §6.4): the .tl root is a
 * `data-build-scene` and its rows drop in, in date order, 80ms apart
 * (src/scripts/build.ts). No JS or reduced motion: every row in place.
 */
import { renderInline } from '../../../lib/text';

interface TimelineEvent {
  date: string;
  label: string;
  note?: string;
  state?: 'default' | 'key' | 'fail' | 'now';
}
/* The annotation layer — docs/design/blueprints/_ANNOTATIONS.md. 0–3 per
   chart, optional everywhere; absent ⇒ nothing renders. `side` / `series`
   are accepted for contract parity and carry no meaning on a vertical rail
   (there is one series and one place a row's callout can go). */
interface Annotation {
  at: string | number;
  text: string;
  side?: 'above' | 'below' | 'left' | 'right';
  series?: string;
}
interface Props {
  events: TimelineEvent[];
  annotations?: Annotation[];
  /* Optional — promoted onto the section schema in Phase 2 and merged
     down in SectionBody. CANON §7: no source, no section. */
  source?: string;
  /* The Lens reading system (Phase 3): the article column beside the figure
     carries each event's full sentence (label, note, annotation, with its
     cue), so the figure keeps the date and the label only. */
  compact?: boolean;
}
const { events = [], annotations = [], source, compact = false } = Astro.props;

/* Resolve each annotation to one row: a number is the 0-based index, a string
   is the event's `date` — the FIRST row carrying it, since two events may
   share a date (the showcase has two on "6 May 2025"); index form addresses
   the second. An `at` that matches nothing is a silent no-op, per spec §2. */
const annotRows = new Map<number, string[]>();
for (const a of annotations ?? []) {   // `annotations:` with no items parses as null
  if (!a || !a.text) continue;
  const i = typeof a.at === 'number' ? a.at : events.findIndex((e) => e.date === a.at);
  if (i < 0 || i >= events.length) continue;
  annotRows.set(i, [...(annotRows.get(i) ?? []), a.text]);
}
---

{/* Cue anchors (LENS §5.2): each row is `data-cue="<n>"`, numbered from 1 in
    data order; the empty `.px-cue-tag` is the numeral's slot, filled by
    core/Section.astro when a cue names the row. */}
<div class="tl" data-build-scene data-compact={compact ? 'true' : undefined}>
  {events.map((e, i) => (
    <div class="tl__row" data-state={e.state ?? 'default'} data-cue={i + 1} data-build="1" data-build-kind="drop">
      <div class="tl__date">{e.date}</div>
      <div>
        <div class="tl__label"><span class="px-cue-tag" data-cue-tag={i + 1} hidden></span><Fragment set:html={renderInline(e.label)} /></div>
        {!compact && e.note && <div class="tl__note" set:html={renderInline(e.note)} />}
        {!compact && (annotRows.get(i) ?? []).map((t) => (
          <span class="tl__annot vz-annot" style="display:block;margin-top:6px">
            <span class="tl__annot-dot" style="display:inline-block;width:8px;height:8px;margin-right:8px;border-radius:50%;background:var(--accent);vertical-align:middle"></span>{t}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
