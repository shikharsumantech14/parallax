---
/**
 * Chamber (politics · FLAGSHIP + world signature) — "The record, rendered."
 * A 3D hemicycle parliament: every seat an instanced block on true hemicycle
 * arcs, colored by party (contiguous wedges, gov → cross → opp), with the
 * dashed majority arc sweeping the rim. When a `division` is attached, the
 * COMPOSITION / DIVISION chips walk the seats to the Aye and No lobbies.
 *
 * Blueprint (the contract): docs/design/blueprints/politics/chamber.md.
 * Math: src/scripts/viz3d/hemicycle.ts — the SAME functions compute the
 * static fallback below at build time (2D projection x → x, z → y·0.72), so
 * the no-JS / reduced-motion / no-WebGL reader gets the identical chamber as
 * a composed SVG still, plus a second static division plate when one exists.
 *
 * Lens Phase 6 (2026-09-30), to the Lib-chamber board: the scene sits on the
 * desk's deep plate (LENS §8.3), with the chamber's size at 40 in the bowl of
 * the arc, the majority over its apex and a one-line legend of every party
 * and its seats under it. The labels are HTML over the fallback drawing, in
 * percent of its frame and set in real pixels (12px and up at any width). The
 * cue anchors and the build live on the FALLBACK (LENS §5.2, §6.4; PHASE 6
 * rule 9), never on the canvas; the scene keeps its one idle loop.
 *
 * Cue anchors: 1 … n each party (its seats and its legend entry), numbered
 * from 1 in DATA order; `line` the majority arc; `total` the seat count;
 * `aye`, `no` the division's lobbies when there is one.
 *
 * THE BUILD: the legend is the scene; its entries drop in, 80ms apart. The
 * drawing itself does not build: the fallback is hidden the moment the WebGL
 * scene takes over, and a build inside it would end on a box the static page
 * never shows (the render gate's BUILD check). No JS, no WebGL or reduced
 * motion: the chamber as drawn.
 *
 * data: { chamber?: {rows?, arcDeg?}, parties[]{name, seats, color?, side?,
 *         short?}, majority?, division?: {label?, aye{}, no{}},
 *         caption?, source? }
 */
import {
  hemicycleSeats, lobbyGrid, lobbyCols, rowsFor, R0, ROW_GAP,
} from '../../../scripts/viz3d/hemicycle';

interface ChamberParty {
  name: string;
  seats: number;
  color?: string;
  side?: 'gov' | 'opp' | 'cross';
  short?: string;
}
interface ChamberDivision {
  label?: string;
  aye: Record<string, number>;
  no: Record<string, number>;
}
interface Props {
  chamber?: { rows?: number; arcDeg?: number };
  parties: ChamberParty[];
  majority?: number;
  division?: ChamberDivision;
  caption?: string;
  source?: string;
}
const {
  chamber, parties: rawParties = [], majority: majorityProp, division, caption, source,
} = Astro.props;

/* wedge order: gov left → cross → opp right (stable within a side) */
const SIDE_RANK: Record<string, number> = { gov: 0, cross: 1, opp: 2 };
const parties = rawParties
  .filter((p) => p && typeof p.name === 'string' && typeof p.seats === 'number' && p.seats > 0)
  .map((p, i) => ({ p, i }))
  .sort((a, b) => (SIDE_RANK[a.p.side ?? 'cross'] - SIDE_RANK[b.p.side ?? 'cross']) || a.i - b.i)
  .map((x) => x.p);
const total = parties.reduce((s, p) => s + p.seats, 0);
const rows = chamber?.rows ?? rowsFor(total);
const arcDeg = chamber?.arcDeg ?? 210;
const majority = majorityProp ?? Math.floor(total / 2) + 1;

/* party fill — data encoding (CANON §6 exemption); blueprint fallback cycle:
   accent, accent-alt, then ink @ 0.7 / 0.5 / 0.35 */
const FALLBACK_FILL: { fill: string; opacity: number }[] = [
  { fill: 'var(--accent)', opacity: 1 },
  { fill: 'var(--accent-alt)', opacity: 1 },
  { fill: 'var(--ink)', opacity: 0.7 },
  { fill: 'var(--ink)', opacity: 0.5 },
  { fill: 'var(--ink)', opacity: 0.35 },
];
let fb = 0;
const partyFill = parties.map((p) =>
  p.color ? { fill: p.color, opacity: 1 } : FALLBACK_FILL[fb++ % FALLBACK_FILL.length]);

/* α-sorted anchors + contiguous wedge assignment (same rule as the scene) */
const anchors = hemicycleSeats(total, rows, arcDeg);
const seatParty: number[] = new Array(total);
{
  let i = 0;
  parties.forEach((p, k) => { for (let n = 0; n < p.seats; n++) seatParty[i++] = k; });
}

/* ── build-time fallback geometry: front-facing 2D projection ──
   x → x, z → y·0.72 foreshortening (blueprint §7)

   TWO LAYERS (2026-09-24; HTML since Lens Phase 6). The seats, arc and
   lobby grids are a W×H viewBox scaled to the card; the LABELS are HTML laid
   over it, positioned in percent of the same frame and set in real pixels,
   so a 12px label is 12px at any card width. The drawing reserves the units
   each label needs at the smallest card (a 260px panel):
     - MAJORITY sits just above the arc's apex;
     - the division title heads its plate, the lobby grids start under it;
     - AYE / NO tallies sit UNDER their lobby grids. */
const W = 680;
const M = 22;
const FORE = 0.72;
const theta = (arcDeg * Math.PI) / 180;
const rArc = R0 + rows * ROW_GAP + 0.12;
const S = (W - 2 * M) / (2 * rArc);
const cy0 = M + 36 + rArc * S * FORE; // room above the arc apex for its label
const dip = rArc * S * FORE * Math.max(0, -Math.cos(theta / 2)); // arc tips below center when θ > 180°
let H = cy0 + dip + M;

const px = (x: number) => W / 2 + x * S;
const py = (z: number) => cy0 + z * S * FORE;
const seats2d = anchors.map((a, i) => ({
  cx: +px(a.x).toFixed(1), cy: +py(a.z).toFixed(1), k: seatParty[i],
}));
let arcPath = '';
for (let k = 0; k <= 96; k++) {
  const a = -theta / 2 + (theta * k) / 96;
  arcPath += (k ? 'L' : 'M') + px(rArc * Math.sin(a)).toFixed(1) + ' ' + py(-rArc * Math.cos(a)).toFixed(1);
}
const dashOn = (0.04 * S).toFixed(1);  // scene dash 0.04/0.03, scaled
const dashOff = (0.03 * S).toFixed(1);

/* ── division: a second static plate (the fallback can't animate the walk) ── */
interface PlateDot { cx: number; cy: number; k: number; }
const clampN = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
// label budget, in px at the smallest card (a 260px panel on a phone)
const MIN_SCALE = 260 / W;
const LINE_PX = 22;                         // one 12px label line, its padding and air
const TITLE_CHARS = 34;                     // about 260px of 12px capitals at .06em
const wrapTitle = (t: string): string[] => {
  const out: string[] = [];
  for (const word of t.split(/\s+/).filter(Boolean)) {
    const last = out[out.length - 1];
    if (last !== undefined && (last + ' ' + word).length <= TITLE_CHARS) out[out.length - 1] = last + ' ' + word;
    else out.push(word);
  }
  return out.length ? out : [t];
};
let plate: null | {
  y0: number; label: string; lines: string[]; tallyY: number;
  aye: { dots: PlateDot[]; tally: number; x: number };
  no: { dots: PlateDot[]; tally: number; x: number };
} = null;
if (division) {
  const ayeKs: number[] = [];
  const noKs: number[] = [];
  parties.forEach((p, k) => {
    const a = clampN(Math.round(division.aye[p.name] ?? 0), 0, p.seats);
    const n = clampN(Math.round(division.no[p.name] ?? 0), 0, p.seats - a);
    for (let s = 0; s < a; s++) ayeKs.push(k);
    for (let s = 0; s < n; s++) noKs.push(k);
  });
  const y0 = H + 8;
  const lines = wrapTitle((division.label ?? 'Division').toUpperCase());
  // the grids start under the title: its lines plus 6px of air, at the
  // smallest card, and never tighter than the 40 units the plate always had
  const gridTop = Math.max(40, Math.ceil((lines.length * LINE_PX + 6) / MIN_SCALE));
  const gridDots = (ks: number[], centerX: number): PlateDot[] => {
    const n = ks.length;
    if (!n) return [];
    const cols = lobbyCols(n);
    const gap = Math.min(9, (W / 2 - 48) / Math.max(1, cols - 1));
    const g = lobbyGrid(n, cols, centerX - ((cols - 1) * gap) / 2, y0 + gridTop, gap, gap);
    return g.map((pt, i) => ({ cx: +pt.x.toFixed(1), cy: +pt.z.toFixed(1), k: ks[i] }));
  };
  const ayeDots = gridDots(ayeKs, W * 0.27);
  const noDots = gridDots(noKs, W * 0.73);
  const depth = Math.max(
    ayeDots.length ? ayeDots[ayeDots.length - 1].cy : y0 + gridTop,
    noDots.length ? noDots[noDots.length - 1].cy : y0 + gridTop,
  );
  plate = {
    y0,
    label: (division.label ?? 'Division').toUpperCase(),
    lines,
    tallyY: depth,
    aye: { dots: ayeDots, tally: ayeKs.length, x: W * 0.27 },
    no: { dots: noDots, tally: noKs.length, x: W * 0.73 },
  };
  // room under the grids for the AYE / NO tallies (hung 1.5em below the last
  // row) at the smallest card
  H = depth + Math.max(M, Math.ceil((20 + 8 + 4) / MIN_SCALE));
}
const Hpx = Math.round(H);

/* ledger legend rows — the AT-readable data source (blueprint §7) */
const ledger = parties.map((p, k) => ({
  name: p.name,
  seats: p.seats,
  pct: Math.round((p.seats / total) * 100),
  fill: partyFill[k],
  aye: division ? Math.round(division.aye[p.name] ?? 0) : 0,
  no: division ? Math.round(division.no[p.name] ?? 0) : 0,
}));

// overlay coordinates: percent of the W×Hpx frame the drawing fills exactly
const pctX = (x: number) => `${((x / W) * 100).toFixed(3)}%`;
const pctY = (y: number) => `${((y / Hpx) * 100).toFixed(3)}%`;
const apexY = cy0 - rArc * S * FORE;
const payload = JSON.stringify({ chamber: { rows, arcDeg }, parties, majority, division });
/* a party's cue id is its place in the AUTHORED list, from 1 */
const cueOf = (k: number) => rawParties.indexOf(parties[k]) + 1;
const byParty = parties.map((_, k) => seats2d.filter((s) => s.k === k));
const fmt = (n: number) => n.toLocaleString('en-US');
---

<div class="px-chmbr" data-viz-root>
  <div class="px-chmbr__stage">
    <div
      class="viz3d viz3d--chmbr"
      data-viz3d="chamber"
      data-viz3d-state="composition"
      style={`aspect-ratio: ${W} / ${Hpx}`}
      role="img"
      aria-label={`Chamber of ${total} seats by party; ${majority} make a majority.`}
    >
      <div class="viz3d__fallback">
        <svg viewBox={`0 0 ${W} ${Hpx}`} preserveAspectRatio="xMidYMid meet">
          <path class="px-chmbr__arc" d={arcPath} data-cue="line"
            stroke-dasharray={`${dashOn} ${dashOff}`} />
          {byParty.map((dots, k) => (
            <g data-cue={cueOf(k)} fill={partyFill[k].fill} fill-opacity={partyFill[k].opacity}>
              {dots.map((s) => <circle cx={s.cx} cy={s.cy} r="3.4" />)}
            </g>
          ))}
          {plate && (
            <>
              <g data-cue="aye">
                {plate.aye.dots.map((d) => (
                  <circle cx={d.cx} cy={d.cy} r="2.8" fill={partyFill[d.k].fill} fill-opacity={partyFill[d.k].opacity} />
                ))}
              </g>
              <g data-cue="no">
                {plate.no.dots.map((d) => (
                  <circle cx={d.cx} cy={d.cy} r="2.8" fill={partyFill[d.k].fill} fill-opacity={partyFill[d.k].opacity} />
                ))}
              </g>
            </>
          )}
        </svg>

        {/* the label layer: HTML over the drawing, in percent of its frame and
            set in real pixels, so a label is 12px at any card width */}
        <div class="px-chmbr__over" aria-hidden="true">
          <span class="px-chmbr__maj" data-cue="line" style={`top:${pctY(apexY)}`}>
            <span class="px-cue-tag" data-cue-tag="line" hidden></span>Majority · {fmt(majority)}
          </span>
          <span class="px-chmbr__total" data-cue="total" style={`top:${pctY(cy0)}`}>
            <span class="px-chmbr__tn"><span class="px-cue-tag" data-cue-tag="total" hidden></span><b>{fmt(total)}</b></span>
            <span class="px-chmbr__tl">seats</span>
          </span>
          {plate && (
            <>
              <span class="px-chmbr__ptitle" style={`top:${pctY(plate.y0)}`}>{plate.label}</span>
              <span class="px-chmbr__tally" data-cue="aye" style={`left:${pctX(plate.aye.x)};top:${pctY(plate.tallyY)}`}>
                <span class="px-cue-tag" data-cue-tag="aye" hidden></span>Aye · {fmt(plate.aye.tally)}
              </span>
              <span class="px-chmbr__tally" data-cue="no" style={`left:${pctX(plate.no.x)};top:${pctY(plate.tallyY)}`}>
                <span class="px-cue-tag" data-cue-tag="no" hidden></span>No · {fmt(plate.no.tally)}
              </span>
            </>
          )}
        </div>
      </div>
      <span class="viz3d__hint" aria-hidden="true">drag to look around</span>
      <script type="application/json" class="viz3d__data" set:html={payload}></script>
    </div>

    {division && (
      <div class="px-chmbr__chips">
        <button type="button" class="px-chmbr__chip is-on" data-state="composition" aria-pressed="true">Composition</button>
        <button type="button" class="px-chmbr__chip" data-state="division" aria-pressed="false">Division</button>
      </div>
    )}

    <ul class="px-chmbr__legend" data-build-scene>
      {ledger.map((r, k) => (
        <li data-cue={cueOf(k)} data-build="1" data-build-kind="drop">
          <i class="px-chmbr__sw" style={`background:${r.fill.fill};opacity:${r.fill.opacity}`}></i>
          <span class="px-cue-tag" data-cue-tag={cueOf(k)} hidden></span>
          <span>{parties[k].short ?? r.name} <b>{fmt(r.seats)}</b></span>
        </li>
      ))}
    </ul>
  </div>

  {division && (
    <script is:inline>
      (function () {
        var root = document.currentScript && document.currentScript.previousElementSibling;
        while (root && !(root.classList && root.classList.contains('px-chmbr__stage'))) {
          root = root.previousElementSibling;
        }
        if (!root) return;
        var mount = root.querySelector('[data-viz3d="chamber"]');
        var chips = root.querySelectorAll('.px-chmbr__chip');
        if (!mount || !chips.length) return;
        function onClick() {
          var s = this.getAttribute('data-state') || 'composition';
          mount.setAttribute('data-viz3d-state', s);
          for (var k = 0; k < chips.length; k++) {
            var on = chips[k] === this;
            chips[k].setAttribute('aria-pressed', on ? 'true' : 'false');
            chips[k].classList.toggle('is-on', on);
          }
        }
        for (var i = 0; i < chips.length; i++) chips[i].addEventListener('click', onClick);
      })();
    </script>
  )}

  {/* the AT-readable data source (blueprint §7): every party, its share and
      its division vote */}
  <table class="px-chmbr__table">
    <caption>Seats by party{division ? ', with the division' : ''}</caption>
    <tbody>
      {ledger.map((r) => (
        <tr>
          <th scope="row">{r.name}</th>
          <td>{fmt(r.seats)} seats, {r.pct}%{division ? `, aye ${r.aye}, no ${r.no}` : ''}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .px-chmbr { min-width: 0; font-family: var(--font-ui); }
  /* The WebGL scene sits on the desk's deep plate (LENS §8.3). The scene
     reads --ink / --paper / --rule / --muted off its mount, so the mount
     re-points them onto the on-deep set: the majority arc and the absent
     seats draw light on the plate. */
  .px-chmbr__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px 16px 16px;
    border-radius: var(--r-card, 6px);
    background: var(--deep);
    color: var(--on-deep);
  }
  .viz3d--chmbr {
    --ink: var(--on-deep);
    --paper: var(--deep);
    --rule: var(--on-deep-hair);
    --muted: var(--on-deep-2);
  }
  .viz3d--chmbr { background: transparent; }
  .px-chmbr__arc { fill: none; stroke: var(--on-deep-2); stroke-width: 1.4; }

  .px-chmbr__over { position: absolute; inset: 0; pointer-events: none; }
  .px-chmbr__over > * { position: absolute; }
  .px-chmbr__maj {
    left: 50%;
    translate: -50% -100%;
    display: inline-flex;
    align-items: center;
    padding-bottom: 4px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--on-deep);
  }
  .px-chmbr__total { left: 50%; translate: -50% -100%; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .px-chmbr__total b { font-size: 40px; line-height: 1; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--on-deep); }
  .px-chmbr__tn { display: inline-flex; align-items: center; gap: 6px; }
  .px-chmbr__tl { display: inline-flex; align-items: center; font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-deep-2); }
  .px-chmbr__ptitle { left: 50%; translate: -50% 0; width: max-content; max-width: 90%; padding-top: 6px; font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; text-align: center; color: var(--on-deep-2); }
  .px-chmbr__tally { translate: -50% 8px; display: inline-flex; align-items: center; font-size: 13px; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; color: var(--on-deep); }
  .px-chmbr__over .px-cue-tag { box-shadow: 0 0 0 2px var(--deep); }

  .viz3d--chmbr .viz3d__hint { color: var(--on-deep-2); }

  /* State chips: shown only while the WebGL scene is live (the fallback shows
     the division as its own static plate instead). */
  .px-chmbr__chips { display: none; gap: 8px; flex-wrap: wrap; }
  .viz3d--live + .px-chmbr__chips { display: flex; }
  .px-chmbr__chip {
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--on-deep-hair);
    border-radius: 999px;
    background: transparent;
    color: var(--on-deep-2);
    font: 500 13px/1 var(--font-ui);
    cursor: pointer;
    transition: color 160ms var(--ease), border-color 160ms var(--ease);
  }
  .px-chmbr__chip.is-on { color: var(--on-deep); border-color: var(--on-deep); }
  .px-chmbr__chip:focus-visible { outline: 2px solid var(--on-deep); outline-offset: 2px; }
  @media (pointer: coarse) { .px-chmbr__chip { min-height: 44px; } }

  .px-chmbr__legend { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 0; padding: 0; list-style: none; }
  .px-chmbr__legend li { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--on-deep-2); }
  .px-chmbr__legend b { font-weight: 600; color: var(--on-deep); font-variant-numeric: tabular-nums; }
  .px-chmbr__legend .px-cue-tag { margin-right: 0; }
  .px-chmbr__sw { display: block; width: 10px; height: 10px; border-radius: 50%; }

  @media (max-width: 560px) {
    /* the bowl of the arc is about 90px wide on a phone: the count alone fits */
    .px-chmbr__total b { font-size: 22px; }
    .px-chmbr__tl { display: none; }
  }

  .px-chmbr__table {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
