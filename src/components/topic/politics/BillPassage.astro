---
/**
 * BillPassage (politics) — one bill, stage by stage. Lens Phase 6
 * (2026-09-30), to the Lib-bill-passage board: a headline number at 96, then
 * the stages as a column of rows, each with its status drawn as a glyph (a
 * filled check for passed, a ring for the stage it sits at now, a crossed ring
 * on a tinted, dashed row for a stage that failed or never happened, a dashed
 * clock for one still to come), the stage name, its date on the right and its
 * note under the name.
 *
 * The board's number was one issue's own fact ("45 minutes of debate"). A
 * component cannot know that, so it sets the count it CAN derive: how many of
 * the stages the bill has cleared. The 3D tilt of the old card track is gone:
 * a hover never moves layout (LENS §6.5).
 *
 * Cue anchors (LENS §5.2): each stage row is `data-cue="<n>"`, numbered from 1
 * in DATA order; `cleared` is the headline number.
 *
 * THE BUILD (LENS §6.4): the root is a scene. 1 the rows drop in, 80ms apart,
 * 2 the status glyphs fade in, 3 the number counts up. No JS or reduced
 * motion: every stage as drawn.
 *
 * data: { stages[]{ label, status, date?, note? }, caption?, source? }
 */
type Status = 'passed' | 'failed' | 'pending' | 'current';
interface Stage { label: string; status: Status; date?: string; note?: string; }
interface Props { stages: Stage[]; caption?: string; source?: string; }
const { stages = [] } = Astro.props;

const cleared = stages.filter((s) => s.status === 'passed').length;
const WORD: Record<Status, string> = { passed: 'Passed', failed: 'Failed', current: 'Now', pending: 'Pending' };
---

<div class="px-billp" data-viz-root data-build-scene>
  <div class="px-billp__head" data-cue="cleared">
    <span class="px-billp__big" data-build="3" data-build-kind="counter" data-to={cleared}>{cleared}</span>
    <span class="px-billp__big-u"><span class="px-cue-tag" data-cue-tag="cleared" hidden></span>of {stages.length} stages cleared</span>
  </div>

  <ol class="px-billp__list">
    {stages.map((s, i) => (
      <li class="px-billp__row" data-status={s.status} data-cue={i + 1} data-build="1" data-build-kind="drop">
        <span class="px-billp__glyph" data-build="2" aria-hidden="true">
          {s.status === 'passed' && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" class="g-fill" /><path d="M7 12.5l3.2 3.2L17 9" class="g-tick" /></svg>
          )}
          {s.status === 'failed' && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.5" class="g-ring" /><path d="M8.5 8.5l7 7M15.5 8.5l-7 7" class="g-x" /></svg>
          )}
          {s.status === 'current' && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.5" class="g-ring" /><circle cx="12" cy="12" r="5" class="g-dot" /></svg>
          )}
          {s.status === 'pending' && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.5" class="g-dash" /><path d="M12 7v5.5l3.5 2" class="g-hand" /></svg>
          )}
        </span>
        <span class="px-billp__main">
          <span class="px-billp__label">{s.label}</span>
          {s.note && <span class="px-billp__note">{s.note}</span>}
        </span>
        <span class="px-billp__meta">
          <span class="px-cue-tag" data-cue-tag={i + 1} hidden></span>
          <span>{s.date ?? WORD[s.status]}</span>
        </span>
      </li>
    ))}
  </ol>
</div>

<style>
  .px-billp { display: flex; flex-direction: column; gap: 18px; min-width: 0; font-family: var(--font-ui); }
  .px-billp__head { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 8px 12px; }
  .px-billp__big {
    font-size: 96px;
    line-height: 0.92;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: var(--accent-deep);
  }
  .px-billp__big-u { display: inline-flex; align-items: center; padding-bottom: 6px; font-size: 14px; font-weight: 500; line-height: 1.3; color: var(--ink-2); }

  .px-billp__list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .px-billp__row {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: start;
    column-gap: 14px;
    padding: 12px 14px;
    border-radius: var(--r-card, 6px);
    background: var(--paper-3);
    border: 1px solid var(--hair);
  }
  .px-billp__row[data-status='failed'] { background: var(--accent-tint); border: 1px dashed var(--accent); }
  .px-billp__row[data-status='current'] { background: var(--paper-2); border-color: var(--accent); }
  .px-billp__row[data-status='pending'] { background: var(--paper-2); }

  .px-billp__glyph { display: block; width: 24px; height: 24px; }
  .px-billp__glyph svg { display: block; width: 24px; height: 24px; }
  .g-fill { fill: var(--accent); }
  .g-tick { fill: none; stroke: var(--paper); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .g-ring { fill: none; stroke: var(--accent-deep); stroke-width: 1.6; }
  .g-x { fill: none; stroke: var(--accent-deep); stroke-width: 1.8; stroke-linecap: round; }
  .g-dot { fill: var(--accent); }
  .g-dash { fill: none; stroke: var(--muted); stroke-width: 1.6; stroke-dasharray: 2.5 2.5; }
  .g-hand { fill: none; stroke: var(--muted); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  .px-billp__main { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding-top: 2px; }
  .px-billp__label { font-size: 15px; font-weight: 600; line-height: 1.3; color: var(--ink); overflow-wrap: anywhere; }
  .px-billp__note { font-size: 13px; line-height: 1.45; color: var(--ink-2); }
  .px-billp__meta {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    padding-top: 2px;
    font-size: 13px;
    line-height: 20px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .px-billp__meta .px-cue-tag { margin-right: 8px; }
  .px-billp__row[data-status='failed'] .px-billp__meta { color: var(--accent-deep); }
  .px-billp__row[data-status='pending'] .px-billp__meta,
  .px-billp__row[data-status='pending'] .px-billp__label { color: var(--muted); }

  @media (max-width: 560px) {
    .px-billp__big { font-size: 72px; }
    .px-billp__row { grid-template-columns: 24px minmax(0, 1fr); column-gap: 12px; padding: 10px 12px; }
    .px-billp__meta { grid-column: 2; justify-content: flex-start; text-align: left; padding-top: 4px; }
  }
</style>
