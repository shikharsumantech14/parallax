---
/**
 * CoalitionCalculus (politics) — the reader-agency coalition builder.
 *
 * Lens Phase 6 (2026-09-30), to the Lib-coalition-calculus board: the party
 * chips on top (a coalition member filled in the desk text ink, a party on
 * the bench in outline, a locked-out party dashed with a lock), then the
 * margin set at 96 ("12 seats clear" or "5 seats short") with the coalition's
 * total beside it, then the seat bar: the coalition's parties first in shades
 * of the desk mark with their name and seats on the block, the bench in paper
 * blocks named underneath, the locked-out parties hatched at the far end, and
 * the majority line dashed across it with its number above. Each locked-out
 * party's stated reason sits under the bar. A party's own `color` is the
 * small key dot in its chip.
 *
 * Tier: HTML-interactive. Build-time HTML paints the preset answer in full
 * (no-JS = the print edition); one small vanilla is:inline island unhides the
 * chips, re-scores on every press and folds the ledger. The formulas are the
 * same here and in the island. The build scene is the FIGURE (`.px-coalc__fig`),
 * not the card, so the chips the island unhides above it never move a built
 * element (LENS §6.4, the render gate's BUILD check).
 *
 * Cue anchors (LENS §5.2):
 *   1 … n   each party (its block, its name under the bar, its reason), in DATA order
 *   line    the majority line and its label
 *   top     the margin
 *
 * THE BUILD (LENS §6.4): 1 the blocks grow from the left, 80ms apart, 2 the
 * majority line fades in, 3 the names rise, 4 the margin counts up.
 *
 * data: { majority?, parties[]{name, short?, seats, color?, locked?}, preset?, caption?, source? }
 */
interface Party { name: string; short?: string; seats: number; color?: string; locked?: string; }
interface Props {
  majority?: number;
  parties?: Party[];
  preset?: string[];
  caption?: string;
  source?: string;
}
// `caption` and `source` are the article's and the panel's (core/Section.astro).
const { majority: majorityProp, parties = [], preset, caption: _caption, source: _source } = Astro.props;

// ── chamber size + threshold ────────────────────────────────────────────────
const N = parties.reduce((s, p) => s + (p.seats || 0), 0);
const defaultMajority = Math.ceil((N + 1) / 2);
const majority = majorityProp && majorityProp > 0 ? majorityProp : defaultMajority;
// honesty note only when a non-default threshold is declared (CANON §7)
const showThreshold = majorityProp != null && majorityProp !== defaultMajority;

// preset default: the largest unlocked party only
const unlocked = parties.filter((p) => !p.locked);
const largest = unlocked.reduce<Party | null>((a, b) => (a && a.seats >= b.seats ? a : b), null);
const presetNames = preset && preset.length ? preset : largest ? [largest.name] : [];
const presetSet = new Set(presetNames);

const REF = 440; // the panel's drawing width, for the static label decisions
const rows = parties.map((p, i) => {
  const share = N > 0 ? p.seats / N : 0;
  return {
    i,
    cue: i + 1,
    name: p.name,
    label: p.short ?? p.name,
    seats: p.seats,
    locked: p.locked,
    color: p.color,
    share,
    on: presetSet.has(p.name) && !p.locked,
    wide: share * REF >= 64,  // a block this wide carries its name on it
  };
});
// the bar: unlocked parties in data order, then the locked-out ones
const beam = [...rows.filter((r) => !r.locked), ...rows.filter((r) => r.locked)];

const sum = rows.filter((r) => r.on).reduce((s, r) => s + r.seats, 0);
const margin = sum - majority;
const clears = margin >= 0;
const majFrac = N > 0 ? majority / N : 0;
const flip = majFrac > 0.72;
const fmt = (n: number) => n.toLocaleString('en-US');

// left edge of each beam block, for the labels drawn under / over it
let acc = 0;
const placed = beam.map((r) => {
  const left = acc;
  acc += r.share;
  return { ...r, left, mid: left + r.share / 2 };
});
/* the names under the bar: a name that would touch the one before it on its
   line drops to the next line (widths estimated at the panel's 440 units) */
const estW = (r: { label: string; seats: number }) => Math.max(r.label.length * 7.6, String(r.seats).length * 7 + 40);
const lineEnds: number[] = [];
const under = placed.map((r) => {
  const cx = r.mid * REF, half = estW(r) / 2;
  let line = 0;
  while (lineEnds[line] !== undefined && lineEnds[line] + 8 > cx - half) line++;
  lineEnds[line] = cx + half;
  return { ...r, line };
});
const underLines = Math.max(1, lineEnds.length);

const payload = JSON.stringify({
  N,
  majority,
  parties: rows.map((r) => ({ i: r.i, seats: r.seats, locked: !!r.locked })),
});
---

<div class="px-coalc" data-viz-root class:list={[{ 'is-clears': clears }]}>
  <!-- the one control: the party chips (JS-only; unhidden by the island) -->
  <div class="px-coalc__bench" hidden>
    {rows.map((r) => (
      <button
        type="button"
        class="px-coalc__chip"
        class:list={[{ 'is-on': r.on, 'is-locked': !!r.locked }]}
        data-i={r.i}
        aria-pressed={r.locked ? undefined : r.on ? 'true' : 'false'}
        aria-disabled={r.locked ? 'true' : undefined}
      >
        {r.locked ? (
          <svg class="px-coalc__lock" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
            <rect x="2.5" y="5.3" width="7" height="5.2" rx="0.8" />
            <path d="M4 5.3V3.7a2 2 0 0 1 4 0v1.6" />
          </svg>
        ) : r.color && <i class="px-coalc__dot" style={`background:${r.color}`} aria-hidden="true"></i>}
        <span>{r.label}</span>
        <b>{fmt(r.seats)}</b>
      </button>
    ))}
  </div>

  <div class="px-coalc__fig" data-build-scene>
    <div class="px-coalc__head">
      <div class="px-coalc__head-k" data-cue="top">
        <span class="px-coalc__big" data-vnum data-build="4" data-build-kind="counter" data-to={Math.abs(margin)}>{fmt(Math.abs(margin))}</span>
        <span class="px-coalc__big-u"><span class="px-cue-tag" data-cue-tag="top" hidden></span><span data-vword>{clears ? 'seats clear' : 'seats short'}</span></span>
      </div>
      <span class="px-coalc__sum"><b data-vsum>{fmt(sum)}</b> of {fmt(N)}</span>
    </div>

    <div class="px-coalc__plot">
      <span class="px-coalc__mlabel" data-cue="line" data-build="2" style={flip ? `right:calc(${((1 - majFrac) * 100).toFixed(3)}% + 8px)` : `left:calc(${(majFrac * 100).toFixed(3)}% + 8px)`}>
        <span class="px-cue-tag" data-cue-tag="line" hidden></span>Majority {fmt(majority)}
      </span>

      <div class="px-coalc__beam">
        {placed.map((r, k) => (
          <div
            class="px-coalc__block"
            class:list={[{ 'is-on': r.on, 'is-locked': !!r.locked, 'is-wide': r.wide }]}
            data-i={r.i}
            data-cue={r.cue}
            data-build="1"
            data-build-kind="grow-x"
            style={`--w:${r.share.toFixed(5)};--k:${k % 2 ? 72 : 100}%`}
          >
            <span class="px-coalc__tag" aria-hidden="true"><span class="px-cue-tag" data-cue-tag={r.cue} hidden></span><span>{r.label}</span><b>{fmt(r.seats)}</b></span>
          </div>
        ))}
        <span class="px-coalc__mline" data-cue="line" data-build="2" style={`left:${(majFrac * 100).toFixed(3)}%`} aria-hidden="true"></span>
      </div>

      <div class="px-coalc__under" style={`height:${underLines * 38}px`}>
        {under.map((r) => (
          <span class="px-coalc__name" class:list={[{ 'is-on': r.on && r.wide }]} data-i={r.i} data-wide={r.wide ? 'true' : 'false'} data-cue={r.cue} data-build="3" data-build-kind="rise" style={`left:${(r.mid * 100).toFixed(3)}%;top:${r.line * 38}px`}>
            <span class="px-cue-tag" data-cue-tag={r.cue} hidden></span>
            <b>{r.label}</b>
            <span>{fmt(r.seats)}{r.locked ? ' locked' : ''}</span>
          </span>
        ))}
      </div>
    </div>

    {rows.some((r) => r.locked) && (
      <ul class="px-coalc__why">
        {rows.filter((r) => r.locked).map((r) => (
          <li data-cue={r.cue}>
            <svg class="px-coalc__lock" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
              <rect x="2.5" y="5.3" width="7" height="5.2" rx="0.8" />
              <path d="M4 5.3V3.7a2 2 0 0 1 4 0v1.6" />
            </svg>
            <span><b>{r.label} locked out.</b> {r.locked}</span>
          </li>
        ))}
      </ul>
    )}
    {showThreshold && <p class="px-coalc__thr">Threshold {fmt(majority)} of {fmt(N)}</p>}
    <span class="px-coalc__sr" data-vlive role="status" aria-live="polite">{clears ? 'Clears by' : 'Short by'} {fmt(Math.abs(margin))}</span>
  </div>

  <!-- AT-readable source: the full ledger. Open in markup; the island folds it
       once the live chips carry the data (CANON §4.5). No-JS = open. -->
  <details class="px-coalc__ledger" open>
    <summary class="px-coalc__summary">Party ledger</summary>
    <ul class="px-coalc__led">
      {rows.map((r) => (
        <li data-i={r.i}>
          <span>{r.name}</span>
          <span>{fmt(r.seats)} · {r.locked ? `locked out: ${r.locked}` : r.on ? <b>in coalition</b> : 'not in coalition'}</span>
        </li>
      ))}
    </ul>
  </details>

  <script type="application/json" class="px-coalc__data" set:html={payload}></script>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('.px-coalc').forEach(function (root) {
      var cfgEl = root.querySelector('.px-coalc__data');
      if (!cfgEl) return;
      var cfg = JSON.parse(cfgEl.textContent);
      var MAJ = cfg.majority;
      var bench = root.querySelector('.px-coalc__bench');
      var vnum = root.querySelector('[data-vnum]');
      var vword = root.querySelector('[data-vword]');
      var vsum = root.querySelector('[data-vsum]');
      var vlive = root.querySelector('[data-vlive]');
      var details = root.querySelector('.px-coalc__ledger');
      var on = {};
      root.querySelectorAll('.px-coalc__chip').forEach(function (c) { on[+c.dataset.i] = c.getAttribute('aria-pressed') === 'true'; });

      function rescore() {
        var sum = 0;
        cfg.parties.forEach(function (p) { if (on[p.i] && !p.locked) sum += p.seats; });
        var m = sum - MAJ, clears = m >= 0;
        vnum.textContent = Math.abs(m).toLocaleString('en-US');
        vword.textContent = clears ? 'seats clear' : 'seats short';
        vsum.textContent = sum.toLocaleString('en-US');
        if (vlive) vlive.textContent = (clears ? 'Clears by ' : 'Short by ') + Math.abs(m).toLocaleString('en-US');
        root.classList.toggle('is-clears', clears);
      }

      root.querySelectorAll('.px-coalc__chip:not(.is-locked)').forEach(function (chip) {
        var i = +chip.dataset.i;
        chip.addEventListener('click', function () {
          on[i] = !on[i];
          chip.setAttribute('aria-pressed', on[i] ? 'true' : 'false');
          chip.classList.toggle('is-on', on[i]);
          root.querySelectorAll('[data-i="' + i + '"]').forEach(function (el) {
            if (el.classList.contains('px-coalc__block')) el.classList.toggle('is-on', on[i]);
            if (el.classList.contains('px-coalc__name')) el.classList.toggle('is-on', on[i] && el.dataset.wide !== 'false');
          });
          rescore();
        });
      });

      bench.hidden = false;
      if (details) details.open = false;
    });
  })();
</script>

<style>
  .px-coalc { display: flex; flex-direction: column; gap: 18px; min-width: 0; font-family: var(--font-ui); }

  /* the chips */
  .px-coalc__bench { display: flex; flex-wrap: wrap; gap: 8px; }
  .px-coalc__bench[hidden] { display: none; }
  .px-coalc__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--hair-2);
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--ink);
    font: 500 13px/1 var(--font-ui);
    cursor: pointer;
    transition: background-color 160ms var(--ease), border-color 160ms var(--ease), color 160ms var(--ease);
  }
  .px-coalc__chip b { font-weight: 600; font-variant-numeric: tabular-nums; }
  .px-coalc__chip:hover { border-color: var(--ink); }
  .px-coalc__chip:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .px-coalc__chip.is-on { background: var(--accent-deep); border-color: var(--accent-deep); color: var(--paper); }
  .px-coalc__chip.is-locked { border-style: dashed; background: var(--paper-3); color: var(--muted); cursor: not-allowed; }
  .px-coalc__dot { display: block; width: 8px; height: 8px; border-radius: 50%; }
  .px-coalc__lock { flex: none; }
  .px-coalc__lock rect, .px-coalc__lock path { fill: none; stroke: currentColor; stroke-width: 1.2; }
  @media (pointer: coarse) { .px-coalc__chip { min-height: 44px; } }

  /* the margin */
  .px-coalc__fig { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .px-coalc__head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 8px 16px; }
  .px-coalc__head-k { display: flex; align-items: flex-end; gap: 12px; }
  .px-coalc__big { font-size: 96px; line-height: 0.92; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; color: var(--ink); }
  .px-coalc.is-clears .px-coalc__big { color: var(--accent-deep); }
  .px-coalc__big-u { display: inline-flex; align-items: center; padding-bottom: 6px; font-size: 14px; font-weight: 500; line-height: 1.3; color: var(--ink-2); }
  .px-coalc__sum { padding-bottom: 6px; font-size: 13px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .px-coalc__sum b { font-weight: 600; color: var(--ink); }

  /* the bar */
  .px-coalc__plot { position: relative; padding-top: 28px; }
  .px-coalc__mlabel { position: absolute; top: 0; display: inline-flex; align-items: center; font-size: 13px; font-weight: 600; line-height: 20px; color: var(--ink); }
  .px-coalc__beam { position: relative; display: flex; height: 48px; }
  .px-coalc__block {
    position: relative;
    flex: 0 0 calc(var(--w) * 100%);
    min-width: 1px;
    box-sizing: border-box;
    overflow: hidden;
    background: var(--paper-3);
    border-right: 1px solid var(--hair);
    transform-origin: left center;
    transition: background-color 160ms var(--ease);
  }
  .px-coalc__block.is-on { background: color-mix(in oklab, var(--accent) var(--k, 100%), var(--paper-2)); border-right-color: var(--paper-2); }
  .px-coalc__block.is-locked { background: repeating-linear-gradient(-45deg, var(--hair-2) 0 1px, transparent 1px 7px), var(--paper-3); border: 1px dashed var(--hair-2); }
  .px-coalc__tag {
    display: none;
    position: absolute;
    inset: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    color: var(--paper);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .px-coalc__tag .px-cue-tag { margin: 0 0 2px; }
  .px-coalc__tag b { font-weight: 500; font-variant-numeric: tabular-nums; }
  .px-coalc__block.is-on.is-wide .px-coalc__tag { display: flex; }
  .px-coalc__mline { position: absolute; top: -6px; bottom: -6px; width: 0; border-left: 2px dashed var(--ink); margin-left: -1px; }

  .px-coalc__under { position: relative; margin-top: 8px; }
  .px-coalc__name { position: absolute; top: 0; display: flex; flex-direction: column; align-items: center; translate: -50% 0; font-size: 12px; line-height: 1.3; color: var(--muted); text-align: center; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .px-coalc__name b { font-size: 13px; font-weight: 600; color: var(--ink); }
  .px-coalc__name .px-cue-tag { margin: 0 0 2px; }
  .px-coalc__name.is-on { visibility: hidden; }

  .px-coalc__why { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .px-coalc__why li { display: flex; align-items: baseline; gap: 8px; font-size: 13px; line-height: 1.45; color: var(--ink-2); }
  .px-coalc__why li b { font-weight: 600; color: var(--ink); }
  .px-coalc__why .px-coalc__lock { color: var(--ink-2); translate: 0 1px; }
  .px-coalc__thr { margin: 0; font-size: 12px; color: var(--muted); }
  .px-coalc__sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  .px-coalc__ledger { border-top: 1px solid var(--hair); padding-top: 10px; }
  .px-coalc__summary { cursor: pointer; font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .px-coalc__led { margin: 8px 0 0; padding: 0; list-style: none; }
  .px-coalc__led li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--hair); font-size: 13px; color: var(--ink); }
  .px-coalc__led li span:last-child { color: var(--ink-2); text-align: right; }
  .px-coalc__led b { font-weight: 600; color: var(--accent-deep); }

  @media (max-width: 560px) {
    .px-coalc__big { font-size: 72px; }
  }
</style>
