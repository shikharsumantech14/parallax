---
/**
 * ApprovalChart (politics) — approve against disapprove over time. Lens Phase
 * 6 (2026-09-30), to the Lib-approval-chart board: drawn for the figure panel
 * (a 440-unit viewBox, text at 12 and 13), the y axis fitted to the data in
 * steps of 5, the band between the two lines tinted, a dot on every point,
 * the first crossing ringed, the lines named at their ends with their last
 * values, and the months along the foot with the year under the first month
 * of each year. The legend is the end labels.
 *
 * Every word and numeral that a cue can name is HTML laid over the SVG in
 * percent (`.ac__over`), so the numerals print where Section.astro puts them
 * and nothing scales below 12px. On a phone the drawing keeps its 440 units
 * and scrolls sideways inside the panel (the 2026-09-07 rule, kept here).
 *
 * Cue anchors (LENS §5.2):
 *   1 … n        each point (both of its dots), numbered from 1 in DATA order
 *   approve      the approve line and its end label
 *   disapprove   the disapprove line and its end label
 *   cross        the first crossing, ringed
 *   note1 …      each annotation, in DATA order
 *
 * THE BUILD (LENS §6.4): the root is a scene. 1 the grid and the axis fade in,
 * 2 the band fades in, 3 both lines draw, 4 the dots fade in, 5 the end
 * labels, the crossing and the notes rise. No JS or reduced motion: the chart
 * as drawn.
 *
 * props: points[] { date, approve, disapprove } · subject · caption · source
 *        · annotations[] (docs/design/blueprints/_ANNOTATIONS.md)
 */
interface DataPoint { date: string; approve: number; disapprove: number; }
interface Annotation {
  at: string | number;
  text: string;
  side?: 'above' | 'below' | 'left' | 'right';
  series?: string;
}
interface Props {
  points: DataPoint[];
  subject?: string;
  caption?: string;
  source?: string;
  annotations?: Annotation[];
}
const { points = [], subject, annotations = [] } = Astro.props;

const W = 440, H = 292, padL = 30, plotR = 312, padT = 16, baseY = 250;
const n = points.length;
const vals = points.flatMap((p) => [p.approve, p.disapprove]).filter((v) => Number.isFinite(v));
const lo = vals.length ? Math.max(0, Math.floor((Math.min(...vals) - 1) / 5) * 5) : 0;
const hi = vals.length ? Math.min(100, Math.ceil((Math.max(...vals) + 1) / 5) * 5) : 100;
const span = Math.max(5, hi - lo);
const x = (i: number) => padL + (n > 1 ? i / (n - 1) : 0.5) * (plotR - padL);
const y = (v: number) => padT + (1 - (v - lo) / span) * (baseY - padT);
const step = span <= 30 ? 5 : span <= 60 ? 10 : 25;
const ticks: number[] = [];
for (let v = lo; v <= hi; v += step) ticks.push(v);

const pts = (k: 'approve' | 'disapprove') => points.map((p, i) => `${x(i).toFixed(1)},${y(p[k]).toFixed(1)}`).join(' ');
const band = n > 1
  ? [...points.map((p, i) => `${x(i).toFixed(1)},${y(p.disapprove).toFixed(1)}`), ...points.map((p, i) => `${x(i).toFixed(1)},${y(p.approve).toFixed(1)}`).reverse()].join(' ')
  : '';

/* the first crossing, interpolated between two points */
let cross: { cx: number; cy: number } | undefined;
for (let i = 0; i < n - 1 && !cross; i++) {
  const d0 = points[i].approve - points[i].disapprove;
  const d1 = points[i + 1].approve - points[i + 1].disapprove;
  if (d0 === 0) { cross = { cx: x(i), cy: y(points[i].approve) }; break; }
  if (d0 * d1 < 0) {
    const t = d0 / (d0 - d1);
    const v = points[i].approve + t * (points[i + 1].approve - points[i].approve);
    cross = { cx: x(i) + t * (x(i + 1) - x(i)), cy: y(v) };
  }
}

/* the months: every `every`-th point and the last; the year under the first
   point and under the first point of each new year */
const every = Math.max(1, Math.ceil(n / 7));
const part = (d: string) => {
  const m = String(d).trim().split(/\s+/);
  return m.length > 1 ? { m: m[0].slice(0, 3), yr: m[m.length - 1] } : { m: m[0], yr: '' };
};
const xLabels = points.map((p, i) => {
  const { m, yr } = part(p.date);
  const prev = i > 0 ? part(points[i - 1].date).yr : '';
  const show = i % every === 0 || i === n - 1;
  return { i, m, yr: yr && (i === 0 || yr !== prev) ? yr : '', show: show || (yr && i > 0 && yr !== prev) };
}).filter((l) => l.show)
  /* the last month is always shown, so the one before it can land a single
     step away: drop that one (unless it carries a year) when the two would
     sit closer than a three-letter month in Literata 12 needs, with air. */
  .filter((l, k, all) => {
    const next = all[k + 1];
    return !next || next.i !== n - 1 || l.yr || x(next.i) - x(l.i) >= 34;
  });

const last = points[n - 1];
/* end labels: keep them 18 units apart */
let yA = last ? y(last.approve) : 0;
let yD = last ? y(last.disapprove) : 0;
if (last && Math.abs(yA - yD) < 18) {
  const mid = (yA + yD) / 2;
  const up = last.approve >= last.disapprove;
  yA = mid + (up ? -9 : 9);
  yD = mid + (up ? 9 : -9);
}

/* annotations: `at` is a point's date, or the short label the axis prints */
const notes = (annotations ?? [])
  .filter((a) => a && a.text)
  .map((a, k) => {
    const i = points.findIndex((p) => String(a.at) === p.date || String(a.at) === part(p.date).yr || String(a.at) === part(p.date).m);
    if (i < 0) return undefined;
    const v = a.series === 'disapprove' ? points[i].disapprove : points[i].approve;
    const cy = y(v);
    return { id: `note${k + 1}`, text: a.text, side: a.side, cx: x(i), cy };
  })
  .filter((a): a is NonNullable<typeof a> => !!a);

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const svgStack = "font-family:'Literata',Georgia,serif";
---

<div class="ac" data-viz-root data-build-scene>
  {subject && <p class="ac__subject">{subject}</p>}
  <div class="ac__canvas">
    <svg class="ac__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="img"
      aria-label={subject ? `Approve and disapprove over time: ${subject}` : 'Approve and disapprove over time'}>
      <g class="ac__grid" data-build="1">
        {ticks.map((v) => (
          <g>
            <line x1={padL} y1={y(v)} x2={plotR} y2={y(v)} />
            <text x={padL - 6} y={y(v) + 4} text-anchor="end" style={`${svgStack};font-size:12px`}>{v}</text>
          </g>
        ))}
        {xLabels.map((l) => (
          <g>
            <text class="ac__m" x={x(l.i)} y={baseY + 20} text-anchor="middle" style={`${svgStack};font-size:12px`}>{l.m}</text>
            {l.yr && <text class="ac__yr" x={x(l.i)} y={baseY + 36} text-anchor="middle" style={`${svgStack};font-size:12px;font-weight:600`}>{l.yr}</text>}
          </g>
        ))}
      </g>
      {band && <polygon class="ac__band" points={band} data-build="2" />}
      <polyline class="ac__line ac__line--dis" points={pts('disapprove')} data-cue="disapprove" data-build="3" data-build-kind="draw" />
      <polyline class="ac__line ac__line--app" points={pts('approve')} data-cue="approve" data-build="3" data-build-kind="draw" />
      {points.map((p, i) => (
        <g class="ac__pt" data-cue={i + 1} data-build="4">
          <circle class="ac__dot--dis" cx={x(i).toFixed(1)} cy={y(p.disapprove).toFixed(1)} r="2.5" />
          <circle class="ac__dot--app" cx={x(i).toFixed(1)} cy={y(p.approve).toFixed(1)} r="3" />
        </g>
      ))}
      {cross && (
        <g class="ac__cross" data-cue="cross" data-build="5">
          <circle cx={cross.cx.toFixed(1)} cy={cross.cy.toFixed(1)} r="7" />
        </g>
      )}
      {notes.map((a) => (
        <g class="ac__note" data-cue={a.id} data-build="5">
          <circle cx={a.cx.toFixed(1)} cy={a.cy.toFixed(1)} r="5" />
        </g>
      ))}
    </svg>

    <div class="ac__over">
      {points.map((p, i) => (
        <span class="ac__pt-tag" data-cue={i + 1} style={`left:${pct(x(i), W)};top:${pct(Math.min(y(p.approve), y(p.disapprove)) - 8, H)}`}><span class="px-cue-tag" data-cue-tag={i + 1} hidden></span></span>
      ))}
      {last && (
        <>
          <span class="ac__end ac__end--dis" data-cue="disapprove" data-build="5" data-build-kind="rise" style={`left:${pct(plotR + 10, W)};top:${pct(yD, H)}`}><span class="px-cue-tag" data-cue-tag="disapprove" hidden></span>Disapprove {last.disapprove}</span>
          <span class="ac__end ac__end--app" data-cue="approve" data-build="5" data-build-kind="rise" style={`left:${pct(plotR + 10, W)};top:${pct(yA, H)}`}><span class="px-cue-tag" data-cue-tag="approve" hidden></span>Approve {last.approve}</span>
        </>
      )}
      {cross && (
        <span class="ac__pt-tag ac__pt-tag--below" data-cue="cross" style={`left:${pct(cross.cx, W)};top:${pct(cross.cy + 12, H)}`}><span class="px-cue-tag" data-cue-tag="cross" hidden></span></span>
      )}
      {notes.length > 1 && notes.map((a, k) => (
        <span class="ac__pt-tag ac__nt-k" data-cue={a.id} style={`left:${pct(a.cx, W)};top:${pct(a.cy + 9, H)}`}><b>{String.fromCharCode(65 + k)}</b></span>
      ))}
    </div>
  </div>
  {notes.length > 0 && (
    <ul class="ac__notes">
      {notes.map((a, k) => (
        <li data-cue={a.id} data-build="5" data-build-kind="rise">
          <span class="px-cue-tag" data-cue-tag={a.id} hidden></span>
          {notes.length > 1 && <b>{String.fromCharCode(65 + k)}</b>}
          <span>{a.text}</span>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .ac { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .ac__subject {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ac__canvas { position: relative; }
  .ac__svg { display: block; width: 100%; height: auto; overflow: visible; }
  .ac__grid line { stroke: var(--hair); stroke-width: 1; }
  .ac__grid text { fill: var(--muted); font-variant-numeric: tabular-nums; }
  .ac__grid .ac__m { fill: var(--ink-2); }
  .ac__band { fill: var(--accent-tint); }
  .ac__line { fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .ac__line--dis { stroke: var(--ink-2); stroke-width: 2; }
  .ac__line--app { stroke: var(--accent); stroke-width: 2.5; }
  .ac__dot--dis { fill: var(--ink-2); }
  .ac__dot--app { fill: var(--accent); }
  .ac__cross circle { fill: none; stroke: var(--ink); stroke-width: 1.5; }
  .ac__note circle { fill: none; stroke: var(--accent-deep); stroke-width: 1.5; }

  /* the HTML layer over the drawing, in the drawing's own percent */
  .ac__over { position: absolute; inset: 0; pointer-events: none; }
  .ac__over > * { position: absolute; }
  .ac__pt-tag { translate: -50% -100%; line-height: 0; }
  .ac__pt-tag--below { translate: -50% 0; }
  .ac__pt-tag .px-cue-tag { margin: 0; }
  .ac__end {
    display: inline-flex;
    align-items: center;
    translate: 0 -50%;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    line-height: 20px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .ac__end--dis { color: var(--ink-2); }
  .ac__end--app { color: var(--accent-deep); }
  .ac__end .px-cue-tag { margin-right: 6px; }
  .ac__nt-k { translate: -50% 0; }
  .ac__nt-k b { font-family: var(--font-ui); font-size: 12px; font-weight: 600; color: var(--accent-deep); line-height: 1; }
  .ac__notes { margin: 0; padding: 10px 0 0; list-style: none; border-top: 1px solid var(--hair); display: flex; flex-direction: column; gap: 6px; }
  .ac__notes li { display: flex; align-items: baseline; gap: 8px; font-family: var(--font-display); font-size: 15px; font-style: normal; line-height: 1.4; color: var(--ink); }
  .ac__notes li b { font-family: var(--font-ui); font-style: normal; font-size: 12px; font-weight: 600; color: var(--accent-deep); }
  .ac__notes .px-cue-tag { align-self: center; margin-right: 0; }

  /* A phone keeps the drawing at its 440 units and scrolls it. */
  @media (max-width: 1023px) {
    .ac { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; }
    .ac__canvas { min-width: 440px; }
  }
</style>
