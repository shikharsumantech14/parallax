---
import { renderInline } from '../../../lib/text';

interface BillCard {
  label: string;
  title: string;
  body: string;
  bullets?: string[];
  primary?: boolean;
}

interface Props {
  cards: BillCard[];
  /* Optional — promoted onto the section schema in Phase 2 and merged
     down in SectionBody. CANON §7: no source, no section. */
  source?: string;
}

const { cards, source} = Astro.props;
---

<div class="px-bills" data-viz-root data-reveal>
  {cards.map((c) => (
    <article class={`px-bills__card${c.primary ? ' px-bills__card--primary' : ''}`}>
      <div class="px-bills__label">{c.label}</div>
      <h3 class="px-bills__title" set:html={renderInline(c.title)} />
      <p class="px-bills__body" set:html={renderInline(c.body)} />
      {c.bullets && c.bullets.length > 0 && (
        <ul class="px-bills__bullets">
          {c.bullets.map((b) => <li set:html={renderInline(b)} />)}
        </ul>
      )}
    </article>
  ))}
</div>
