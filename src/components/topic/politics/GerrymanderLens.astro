---
/**
 * GerrymanderLens (politics · SVG · FLAGSHIP of the same-data-many-maps family)
 * — the proof that district lines, not votes, decide who wins. ONE shared vote
 * grid (the exact same voters, the exact same party split) is re-districted under
 * 2–3 plans side by side; each plan's efficiency gap is named as a signed number
 * against the fairness flag. "Nothing changed but the lines, and everything
 * changed."
 *
 * Blueprint (the contract): docs/design/blueprints/politics/gerrymander-lens.md.
 * Physics: docs/design/physics/apportionment.md §4 (efficiency gap).
 *
 * Everything is build-time: the efficiency-gap arithmetic and every panel's
 * geometry are computed here, once. The only JS is a ~4-line inline island that folds the verdict-ledger
 * <details> once the in-SVG numbers are visible (legend-collapse, CANON §4.5) —
 * no-JS keeps the ledger permanently open.
 *
 * Lens Phase 6 (2026-09-30), to the Lib-gerrymander-lens board: the most
 * skewed plan's seat split set at 96 ("5−0 from 272 to 228"), a one-line key
 * (the two parties' cells, the seat-winner dot), then the maps side by side,
 * each titled, with its seat split, its signed efficiency gap and a pill that
 * says "Balanced" or "Favours <party>" (tinted when past the flag). The
 * verdict ledger (with each plan's note) folds under JS; it sits outside the
 * build scene (`.px-glens__fig`) so folding it never moves a built element.
 *
 * Cue anchors (LENS §5.2): each plan's panel is `data-cue="<n>"`, numbered
 * from 1 in DATA order; `top` the headline, `legend` the key.
 *
 * THE BUILD (LENS §6.4): 1 the key and the cell fills fade in, 2 the district
 * lines draw, 3 the winner dots fade in, 4 the readouts rise, 5 the headline
 * rises. No JS or reduced motion: every map complete.
 *
 * Build FAILS (naming the offender) if a plan's district A-tallies don't re-sum
 * to the shared statewide total (the "same votes" guarantee), or a plan has
 * unequal-population districts, or a non-contiguous district.
 *
 * data: see GerrymanderLensData below.
 */
interface GLParty { name: string; short?: string; color?: string; }
interface GLPlan { label: string; districts: number[]; note?: string; }
interface Props {
  grid: { cols: number; rows: number; a: number[]; perCell: number };
  parties: { a: GLParty; b: GLParty };
  plans: GLPlan[];
  flagPct?: number;
  caption?: string;
  source?: string;
}
const { grid, parties, plans = [], flagPct = 7, caption, source } = Astro.props;

const { cols, rows, a: gridA, perCell } = grid;
const nCells = rows * cols;

/* ── §4 invariant assert 1: array lengths ─────────────────────────────────── */
if (gridA.length !== nCells) {
  throw new Error(`gerrymander-lens: grid.a has ${gridA.length} cells but rows·cols = ${nCells}`);
}
const statewideA = gridA.reduce((s, v) => s + v, 0);
const totalVotes = nCells * perCell;
const statewideB = totalVotes - statewideA;

/* cell index → (row, col) and 4-neighbours (shared across all plans) */
const rc = (i: number) => ({ r: Math.floor(i / cols), c: i % cols });
function neighbours(i: number): number[] {
  const { r, c } = rc(i);
  const out: number[] = [];
  if (c > 0) out.push(i - 1);
  if (c < cols - 1) out.push(i + 1);
  if (r > 0) out.push(i - cols);
  if (r < rows - 1) out.push(i + cols);
  return out;
}

const MINUS = '−'; // proper minus glyph for signed readouts

interface DistrictTally {
  id: number; cells: number[]; aVotes: number; bVotes: number;
  total: number; winner: 'a' | 'b'; wastedA: number; wastedB: number;
  pipX: number; pipY: number;
}
interface PlanComputed {
  label: string; note?: string; flagged: boolean;
  seatsA: number; seatsB: number; seatWinner: 'a' | 'b' | 'tie';
  egPct: number; egSign: string; egAbs: string;
  gloss: string; boundsPath: string; pips: DistrictTally[];
}

/* ── §4: CELL geometry (square cells, PANEL = 200 map area) ────────────────── */
const CELL = 200 / Math.max(cols, rows);
const MAP_W = cols * CELL;
const MAP_H = rows * CELL;
const f1 = (v: number) => (Math.round(v * 100) / 100).toString();

/* cell fills — derived from grid.a ONLY, so they are byte-identical across the
   three panels (the "same votes" fact made structural: only boundaries differ). */
const cellFills = gridA.map((av, i) => {
  const { r, c } = rc(i);
  const bv = perCell - av;
  const margin = Math.abs(av - bv) / perCell;         // 0 (tie) … 1 (pure cell)
  const op = 0.28 + 0.42 * margin;                     // §4/§6 margin ramp
  return {
    x: c * CELL, y: r * CELL,
    party: av >= bv ? 'a' : 'b',                        // tie → A (documented §4)
    op: Math.round(op * 1000) / 1000,
  };
});

function computePlan(plan: GLPlan): PlanComputed {
  const { districts, label, note } = plan;
  if (districts.length !== nCells) {
    throw new Error(`gerrymander-lens: plan "${label}" has ${districts.length} cells but rows·cols = ${nCells}`);
  }
  const maxId = Math.max(...districts);
  const D = maxId + 1;

  /* group cells by district; assert domain 0..D−1 fully covered */
  const byDistrict: number[][] = Array.from({ length: D }, () => []);
  districts.forEach((d, i) => {
    if (d < 0 || d >= D || !Number.isInteger(d)) {
      throw new Error(`gerrymander-lens: plan "${label}" cell ${i} has invalid district id ${d}`);
    }
    byDistrict[d].push(i);
  });

  /* §4 assert 3: equal population (every district owns the same cell count) */
  const expectSize = nCells / D;
  if (!Number.isInteger(expectSize)) {
    throw new Error(`gerrymander-lens: plan "${label}" — ${nCells} cells do not divide evenly into ${D} districts`);
  }
  for (let d = 0; d < D; d++) {
    if (byDistrict[d].length !== expectSize) {
      throw new Error(
        `gerrymander-lens: plan "${label}" district ${d} owns ${byDistrict[d].length} cells, ` +
        `expected ${expectSize} (equal population violated)`,
      );
    }
  }

  /* §4 assert 4: contiguity (flood-fill reaches every member of the district) */
  for (let d = 0; d < D; d++) {
    const members = new Set(byDistrict[d]);
    const seen = new Set<number>();
    const stack = [byDistrict[d][0]];
    while (stack.length) {
      const cur = stack.pop()!;
      if (seen.has(cur)) continue;
      seen.add(cur);
      for (const nb of neighbours(cur)) if (members.has(nb) && !seen.has(nb)) stack.push(nb);
    }
    if (seen.size !== members.size) {
      throw new Error(
        `gerrymander-lens: plan "${label}" district ${d} is not contiguous ` +
        `(${seen.size}/${members.size} cells 4-connected)`,
      );
    }
  }

  /* district tallies + efficiency-gap arithmetic (§4 / apportionment §4) */
  const tallies: DistrictTally[] = [];
  let wastedA = 0, wastedB = 0, seatsA = 0, seatsB = 0, resumA = 0;
  for (let d = 0; d < D; d++) {
    const cells = byDistrict[d];
    const aVotes = cells.reduce((s, i) => s + gridA[i], 0);
    const total = cells.length * perCell;
    const bVotes = total - aVotes;
    const threshold = Math.floor(total / 2) + 1;        // wᵈ
    const winner: 'a' | 'b' = aVotes >= bVotes ? 'a' : 'b'; // tie → A (§4)
    let wA: number, wB: number;
    if (winner === 'a') { wA = aVotes - threshold; wB = bVotes; seatsA++; }
    else { wB = bVotes - threshold; wA = aVotes; seatsB++; }
    wastedA += wA; wastedB += wB; resumA += aVotes;

    /* winner pip → the district's cell nearest its centroid */
    const mr = cells.reduce((s, i) => s + rc(i).r, 0) / cells.length;
    const mc = cells.reduce((s, i) => s + rc(i).c, 0) / cells.length;
    let best = cells[0], bestD = Infinity;
    for (const i of cells) {
      const { r, c } = rc(i);
      const dist = (r - mr) ** 2 + (c - mc) ** 2;
      if (dist < bestD) { bestD = dist; best = i; }
    }
    const { r: pr, c: pc } = rc(best);
    tallies.push({
      id: d, cells, aVotes, bVotes, total, winner, wastedA: wA, wastedB: wB,
      pipX: (pc + 0.5) * CELL, pipY: (pr + 0.5) * CELL,
    });
  }

  /* §4 assert 2: the "same votes" guarantee — this plan's district A-tallies
     must re-sum to the shared statewide Party-A total, else FAIL naming it. */
  if (resumA !== statewideA) {
    throw new Error(
      `gerrymander-lens: plan "${label}" district A-tallies sum to ${resumA} but the shared ` +
      `grid statewide total is ${statewideA} — the "same votes" guarantee is broken`,
    );
  }

  const eg = (wastedA - wastedB) / totalVotes;          // signed; − favours A
  const egPct = eg * 100;
  const flagged = Math.abs(egPct) > flagPct;
  const favoured = egPct < 0 ? parties.a.name : parties.b.name;
  const gloss = flagged ? `favours ${favoured}` : 'balanced';

  /* district boundaries — the ONLY thing that differs between panels. One path
     of every interior cell edge that separates two DIFFERENT districts. */
  const segs: string[] = [];
  for (let i = 0; i < nCells; i++) {
    const { r, c } = rc(i);
    const x = c * CELL, y = r * CELL;
    if (c < cols - 1 && districts[i] !== districts[i + 1]) {
      segs.push(`M ${f1(x + CELL)} ${f1(y)} L ${f1(x + CELL)} ${f1(y + CELL)}`);
    }
    if (r < rows - 1 && districts[i] !== districts[i + cols]) {
      segs.push(`M ${f1(x)} ${f1(y + CELL)} L ${f1(x + CELL)} ${f1(y + CELL)}`);
    }
  }

  return {
    label, note, flagged, seatsA, seatsB,
    seatWinner: seatsA > seatsB ? 'a' : seatsB > seatsA ? 'b' : 'tie',
    egPct, egSign: egPct < 0 ? MINUS : '+', egAbs: Math.abs(egPct).toFixed(1),
    gloss, boundsPath: segs.join(' '), pips: tallies,
  };
}

const computed = plans.map(computePlan);

/* shared grid hairlines (identical every panel — same cell matrix) */
const gridLines: string[] = [];
for (let c = 1; c < cols; c++) gridLines.push(`M ${f1(c * CELL)} 0 L ${f1(c * CELL)} ${f1(MAP_H)}`);
for (let r = 1; r < rows; r++) gridLines.push(`M 0 ${f1(r * CELL)} L ${f1(MAP_W)} ${f1(r * CELL)}`);
const gridPath = gridLines.join(' ');

const colA = parties.a.color || 'var(--accent)';
const colB = parties.b.color || 'var(--accent-alt)';
const shortA = parties.a.short || parties.a.name;
const shortB = parties.b.short || parties.b.name;
const pipColor = (w: 'a' | 'b') => (w === 'a' ? colA : colB);
const cellColor = (p: string) => (p === 'a' ? colA : colB);
const fmt = (n: number) => n.toLocaleString('en-US');
/* the headline: the seat split of the most skewed plan */
const worst = computed.length ? [...computed].sort((x, y) => Math.abs(y.egPct) - Math.abs(x.egPct))[0] : undefined;
const cap1 = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
---

<div class="px-glens" data-viz-root style={`--col-a:${colA}; --col-b:${colB}`}>
  <div class="px-glens__fig" data-build-scene>
    {worst && (
      <div class="px-glens__top" data-cue="top">
        <span class="px-glens__big" data-build="5" data-build-kind="rise">{worst.seatsA}–{worst.seatsB}</span>
        <span class="px-glens__big-u"><span class="px-cue-tag" data-cue-tag="top" hidden></span>from {fmt(statewideA)} to {fmt(statewideB)}</span>
      </div>
    )}

    <p class="px-glens__key" data-cue="legend" data-build="1">
      <span class="px-cue-tag" data-cue-tag="legend" hidden></span>
      <span><i class="px-glens__sw" style={`background:${colA}`}></i>{shortA} cell</span>
      <span><i class="px-glens__sw" style={`background:${colB}`}></i>{shortB} cell</span>
      <span><i class="px-glens__dot" style={`background:${colA}`}></i><i class="px-glens__dot" style={`background:${colB}`}></i>Seat winner</span>
    </p>

    <div class="px-glens__row">
      {computed.map((p, pi) => (
        <figure class="px-glens__panel" data-flagged={p.flagged ? 'true' : 'false'} data-cue={pi + 1}>
          <figcaption class="px-glens__label"><span>{p.label}</span><span class="px-cue-tag" data-cue-tag={pi + 1} hidden></span></figcaption>

          <svg
            class="px-glens__map"
            viewBox={`0 0 ${f1(MAP_W)} ${f1(MAP_H)}`}
            preserveAspectRatio="xMidYMid meet"
            role="img"
            aria-label={`${p.label}: ${parties.a.name} ${p.seatsA} seats, ${parties.b.name} ${p.seatsB} seats, efficiency gap ${p.egSign}${p.egAbs}%`}
          >
            <g class="px-glens__cells" data-build="1">
              {cellFills.map((cell) => (
                <rect x={f1(cell.x)} y={f1(cell.y)} width={f1(CELL)} height={f1(CELL)} fill={cellColor(cell.party)} opacity={cell.op} />
              ))}
            </g>
            <path class="px-glens__grid" d={gridPath} />
            <path class="px-glens__bounds" d={p.boundsPath} pathLength="1" data-build="2" data-build-kind="draw" />
            <rect class="px-glens__frame" x="0" y="0" width={f1(MAP_W)} height={f1(MAP_H)} />
            <g class="px-glens__pips" data-build="3">
              {p.pips.map((d) => (
                <circle class="px-glens__pip" cx={f1(d.pipX)} cy={f1(d.pipY)} r="6" fill={pipColor(d.winner)} />
              ))}
            </g>
          </svg>

          <div class="px-glens__readout" data-build="4" data-build-kind="rise">
            <p class="px-glens__seats">
              <span class:list={['px-glens__seat', 'is-a', { 'is-win': p.seatWinner === 'a' }]}>{shortA} {p.seatsA}</span>
              <span class="px-glens__seatdot">·</span>
              <span class:list={['px-glens__seat', 'is-b', { 'is-win': p.seatWinner === 'b' }]}>{shortB} {p.seatsB}</span>
            </p>
            <p class="px-glens__eg">EG {p.egSign}{p.egAbs}%</p>
            <span class:list={['px-glens__chip', { 'is-flag': p.flagged }]}>{cap1(p.gloss)}</span>
          </div>
        </figure>
      ))}
    </div>
  </div>

  <!-- verdict ledger: open in markup (no-JS keeps it), folds on boot (§7) -->
  <details class="px-glens__ledger" data-glens-ledger open>
    <summary class="px-glens__summary">Verdict ledger</summary>
    <ul class="px-glens__llist">
      {computed.map((p) => (
        <li>
          <span class="px-glens__lk">{p.label}</span>
          <span class="px-glens__lv">{p.seatsA}–{p.seatsB} · EG {p.egSign}{p.egAbs}% · {p.flagged ? <b>{p.gloss}</b> : p.gloss} · flag at ±{flagPct}%</span>
          {p.note && <span class="px-glens__lnote">{p.note}</span>}
        </li>
      ))}
    </ul>
  </details>
</div>

<script is:inline>
  /* Fold the verdict ledger once JS is present (its figures are already on the
     maps). No-JS leaves the <details open> permanently. */
  (function () {
    var d = document.querySelectorAll('details[data-glens-ledger]');
    for (var i = 0; i < d.length; i++) d[i].open = false;
  })();
</script>

<style>
  .px-glens { display: flex; flex-direction: column; gap: 16px; min-width: 0; font-family: var(--font-ui); }
  .px-glens__fig { display: flex; flex-direction: column; gap: 16px; min-width: 0; }

  .px-glens__top { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 8px 12px; }
  .px-glens__big { font-size: 96px; line-height: 1; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; color: var(--accent-deep); padding-bottom: 0.12em; }
  .px-glens__big-u { display: inline-flex; align-items: center; padding-bottom: 6px; font-size: 12px; font-weight: 600; line-height: 1.35; color: var(--ink-2); letter-spacing: 0.16em; text-transform: uppercase; }

  .px-glens__key { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; font-size: 12px; font-weight: 500; color: var(--ink-2); }
  .px-glens__key > span { display: inline-flex; align-items: center; gap: 6px; }
  .px-glens__key .px-cue-tag { margin-right: -8px; }
  .px-glens__sw { display: block; width: 12px; height: 12px; border-radius: 2px; }
  .px-glens__dot { display: block; width: 10px; height: 10px; border-radius: 50%; }
  .px-glens__dot + .px-glens__dot { margin-left: -2px; }

  .px-glens__row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .px-glens__panel { margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .px-glens__label { display: flex; justify-content: space-between; align-items: center; gap: 6px; min-height: 20px; font-size: 13px; font-weight: 600; line-height: 1.3; color: var(--ink); }
  .px-glens__label .px-cue-tag { margin: 0; }

  .px-glens__map { display: block; width: 100%; height: auto; overflow: visible; }
  .px-glens__grid { fill: none; stroke: var(--paper-2); stroke-opacity: 0.6; stroke-width: 1; }
  .px-glens__frame { fill: none; stroke: var(--ink); stroke-width: 2.5; }
  .px-glens__bounds { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linecap: square; stroke-linejoin: miter; }
  .px-glens__pip { stroke: var(--paper-2); stroke-width: 2; }

  .px-glens__readout { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .px-glens__seats { margin: 0; font-size: 13px; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--ink-2); }
  .px-glens__seat.is-win { font-weight: 600; }
  .px-glens__seat.is-a.is-win { color: var(--accent-deep); }
  .px-glens__seat.is-b.is-win { color: var(--ink); }
  .px-glens__seatdot { margin: 0 4px; color: var(--muted); }
  .px-glens__eg { margin: 0; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink); }
  .px-glens__chip { display: inline-flex; align-items: center; min-height: 24px; padding: 0 10px; border-radius: 999px; background: var(--paper-3); font-size: 12px; font-weight: 600; color: var(--ink-2); }
  .px-glens__chip.is-flag { background: var(--accent-tint); color: var(--accent-deep); }

  .px-glens__ledger { border-top: 1px solid var(--hair); padding-top: 10px; }
  .px-glens__summary { cursor: pointer; font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .px-glens__llist { margin: 8px 0 0; padding: 0; list-style: none; }
  .px-glens__llist li { display: flex; flex-direction: column; gap: 2px; padding: 6px 0; border-bottom: 1px solid var(--hair); font-size: 13px; line-height: 1.45; }
  .px-glens__lk { font-weight: 600; color: var(--ink); }
  .px-glens__lv { color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .px-glens__lv b { font-weight: 600; color: var(--accent-deep); }
  .px-glens__lnote { font-family: var(--font-display); font-style: normal; font-size: 14px; color: var(--ink-2); }

  @media (max-width: 560px) {
    .px-glens__big { font-size: 72px; }
    .px-glens__row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 12px; }
  }
</style>
