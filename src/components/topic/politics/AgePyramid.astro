---
/**
 * AgePyramid (`age-pyramid`) — a body's composition by age band and a binary
 * split, mirrored about a centre line. The reader learns whether an imbalance
 * is a generational effect working through, or roughly constant all the way up.
 *
 * Lens Phase 6 (2026-09-30), to the Lib-age-pyramid board: the largest band's
 * total set at 96, then a head row (the left side's name, the band, the right
 * side's name, and "Share"), and one row per band, oldest first: the left bar
 * running left from the centre in ink with its count at its end, the band in
 * the middle, the right bar running right in the desk mark with its count, and
 * in the last column the right side's share of that band. Showing the share
 * as a column retires the Counts / Share chips the old version switched
 * between: both readings are on the figure at once, with no control.
 *
 * `mode: 'share'` still draws every bar as its share of its own band (and says
 * so under the head); `count` puts every bar on one scale set by the largest
 * single side anywhere. The `<table>` with the absolute counts stays for a
 * screen reader (the bars are aria-hidden). Blueprint:
 * docs/design/blueprints/politics/age-pyramid.md. Prefix `px-pyr`, inside
 * core/VizCard.astro (whose root is the scene).
 *
 * Cue anchors (LENS §5.2):
 *   1 … n         each band row, numbered from 1 in DATA order (oldest first)
 *   left, right   the two side heads
 *   share         the share column head
 *   top           the headline number
 *
 * THE BUILD (LENS §6.4): 1 the head row fades in, 2 the bars grow out from
 * the centre, 80ms apart, 3 the counts and shares rise, 4 the headline counts
 * up. No JS or reduced motion: the pyramid as drawn.
 */
import VizCard from '../../core/VizCard.astro';

interface Band {
  /** e.g. '55–64'. Oldest FIRST in array order — never sorted here. */
  label: string;
  left: number;
  right: number;
}
interface Side {
  label: string;
  /** Blueprint §6: available, but NOT a data-encoding exemption. */
  color?: string;
}
interface Props {
  bands?: Band[];
  sides?: { left: Side; right: Side };
  mode?: 'count' | 'share';
  /** What a count counts. Purely a label; it never touches the geometry. */
  unit?: string;
  caption?: string;
  source?: string | { label: string; date?: string };
}

const { bands = [], sides, mode = 'count', unit = 'counts', caption, source } = Astro.props;

/* ── Build-time validation (blueprint §3, §10) ─────────────────────────────
   A pyramid drawn from a band that totals zero, or from a negative "count",
   is a data error that would be published as an argument about a population. */
if (mode !== 'count' && mode !== 'share') {
  throw new Error(`[age-pyramid] mode must be 'count' or 'share', got ${JSON.stringify(mode)}.`);
}
if (!sides || !sides.left?.label || !sides.right?.label) {
  throw new Error('[age-pyramid] sides.left.label and sides.right.label are both required — an unlabelled side is an unreadable chart.');
}
if (bands.length < 4 || bands.length > 8) {
  throw new Error(`[age-pyramid] needs 4–8 bands, got ${bands.length}. See blueprint §10.`);
}
const seen = new Set<string>();
for (const b of bands) {
  if (!b.label) throw new Error('[age-pyramid] every band needs a label; one band has none.');
  if (seen.has(b.label)) throw new Error(`[age-pyramid] duplicate band label "${b.label}" — band labels must be unique.`);
  seen.add(b.label);
  for (const side of ['left', 'right'] as const) {
    const v = b[side];
    if (typeof v !== 'number' || !Number.isFinite(v) || v < 0) {
      throw new Error(
        `[age-pyramid] band "${b.label}" has a ${side} value of ${JSON.stringify(v)}; ` +
          'every value must be a finite number of 0 or more.',
      );
    }
  }
  if (b.left + b.right <= 0) {
    throw new Error(`[age-pyramid] band "${b.label}" totals 0. Share mode normalises each row to its own total, so an empty band cannot be drawn — drop it or merge it into a neighbour.`);
  }
}

/* One shared scale for `count` mode: the largest SINGLE side value anywhere. */
const maxSide = Math.max(...bands.map((b) => Math.max(b.left, b.right)));
if (!(maxSide > 0)) throw new Error('[age-pyramid] every value is 0; there is nothing to draw.');

const nf = new Intl.NumberFormat('en-US');
const rows = bands.map((b, i) => {
  const total = b.left + b.right;
  /* Round ONE side and derive the other, so a band's two shares total 100. */
  const lPct = Math.round((b.left / total) * 100);
  const rPct = 100 - lPct;
  const wl = mode === 'count' ? b.left / maxSide : b.left / total;
  const wr = mode === 'count' ? b.right / maxSide : b.right / total;
  return { cue: i + 1, label: b.label, total, left: b.left, right: b.right, lPct, rPct, wl, wr };
});

const fillL = sides.left.color ?? 'var(--ink-2)';
const fillR = sides.right.color ?? 'var(--accent)';
const big = [...rows].sort((a, b) => b.total - a.total)[0];
---

<VizCard prefix="px-pyr" class={`px-pyr--${mode}`} caption={caption} source={source}>
  <div class="px-pyr__top" data-cue="top">
    <span class="px-pyr__big" data-build="4" data-build-kind="counter" data-to={big.total}>{nf.format(big.total)}</span>
    <span class="px-pyr__big-u"><span class="px-cue-tag" data-cue-tag="top" hidden></span>{unit} in {big.label}</span>
  </div>

  <div class="px-pyr__grid" aria-hidden="true" style={`--fl:${fillL};--fr:${fillR}`}>
    <div class="px-pyr__row px-pyr__row--head" data-build="1">
      <span class="px-pyr__h px-pyr__h--l" data-cue="left"><span class="px-cue-tag" data-cue-tag="left" hidden></span>{sides.left.label}</span>
      <span class="px-pyr__h px-pyr__h--band">Age</span>
      <span class="px-pyr__h px-pyr__h--r" data-cue="right"><span class="px-cue-tag" data-cue-tag="right" hidden></span>{sides.right.label}</span>
      <span class="px-pyr__h px-pyr__h--share" data-cue="share"><span class="px-cue-tag" data-cue-tag="share" hidden></span>Share</span>
    </div>
    {mode === 'share' && <p class="px-pyr__mode">Bars show share of band</p>}
    {rows.map((r) => (
      <div class="px-pyr__row" data-cue={r.cue}>
        <span class="px-pyr__cell px-pyr__cell--l">
          <span class="px-pyr__v" data-build="3" data-build-kind="rise">{nf.format(r.left)}</span>
          <span class="px-pyr__bar px-pyr__bar--l" data-build="2" data-build-kind="grow-x" style={`--w:${r.wl.toFixed(4)}`}></span>
        </span>
        <span class="px-pyr__band">{r.label}</span>
        <span class="px-pyr__cell px-pyr__cell--r">
          <span class="px-pyr__bar px-pyr__bar--r" data-build="2" data-build-kind="grow-x" style={`--w:${r.wr.toFixed(4)}`}></span>
          <span class="px-pyr__v" data-build="3" data-build-kind="rise">{nf.format(r.right)}</span>
        </span>
        <span class="px-pyr__share"><span class="px-cue-tag" data-cue-tag={r.cue} hidden></span><span data-build="3" data-build-kind="rise">{r.rPct}%</span></span>
      </div>
    ))}
  </div>

  {/* The real content for a screen reader: absolute counts and both shares. */}
  <table class="px-pyr__table">
    <caption>Every band as counts and shares</caption>
    <thead>
      <tr>
        <th scope="col">Band</th>
        <th scope="col">{sides.left.label}</th>
        <th scope="col">{sides.right.label}</th>
        <th scope="col">{sides.right.label}, share of band</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.label}</th>
          <td>{nf.format(r.left)}</td>
          <td>{nf.format(r.right)}</td>
          <td>{r.rPct}%</td>
        </tr>
      ))}
    </tbody>
  </table>
</VizCard>

<style>
  .px-pyr__top { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 8px 12px; margin-bottom: 18px; }
  .px-pyr__big { font-family: var(--font-ui); font-size: 96px; line-height: 0.92; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; color: var(--accent-deep); }
  .px-pyr__big-u { display: inline-flex; align-items: center; padding-bottom: 6px; font-family: var(--font-ui); font-size: 14px; font-weight: 500; line-height: 1.3; color: var(--ink-2); }

  .px-pyr__grid { display: flex; flex-direction: column; font-family: var(--font-ui); }
  .px-pyr__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1fr) 64px;
    column-gap: 6px;
    align-items: center;
    min-height: 38px;
  }
  .px-pyr__row--head { min-height: 28px; align-items: end; padding-bottom: 6px; }
  .px-pyr__h { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .px-pyr__h .px-cue-tag { margin-right: 0; }
  .px-pyr__h--l { justify-content: flex-end; color: var(--ink); }
  .px-pyr__h--band { justify-content: center; font-weight: 500; color: var(--muted); }
  .px-pyr__h--r { color: var(--accent-deep); }
  .px-pyr__h--share { justify-content: flex-end; font-weight: 500; color: var(--muted); }
  .px-pyr__mode { margin: 0 0 4px; font-size: 12px; color: var(--muted); text-align: center; }

  .px-pyr__cell { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .px-pyr__cell--l { justify-content: flex-end; }
  .px-pyr__bar { display: block; flex: none; height: 26px; min-width: 2px; width: calc((100% - 44px) * var(--w)); }
  .px-pyr__bar--l { background: var(--fl); transform-origin: right center; }
  .px-pyr__bar--r { background: var(--fr); transform-origin: left center; }
  .px-pyr__v { flex: none; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink); }
  .px-pyr__band { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink); text-align: center; overflow-wrap: anywhere; }
  .px-pyr__share .px-cue-tag { margin-right: 0; }
  .px-pyr__share { display: flex; align-items: center; justify-content: flex-end; gap: 4px; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--accent-deep); }

  .px-pyr__table {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (max-width: 560px) {
    .px-pyr__big { font-size: 72px; }
    .px-pyr__row { grid-template-columns: minmax(0, 1fr) 46px minmax(0, 1fr) 60px; column-gap: 4px; }
    .px-pyr__cell { gap: 4px; }
    .px-pyr__bar { width: calc((100% - 34px) * var(--w)); height: 22px; }
    .px-pyr__h--share, .px-pyr__h--band { letter-spacing: 0.02em; }
  }
</style>
