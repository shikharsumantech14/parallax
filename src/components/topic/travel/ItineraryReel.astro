---
/**
 * ItineraryReel (travel) — a perspective carousel of day cards. Each day is a
 * card on a shared 3D stage; cards carry depth (layered shadow) and tilt toward
 * the pointer (core/Tilt.astro `data-tilt`), lifting + brightening on hover/
 * focus. On scroll-in they slide/fan in on a stagger (CSS, reveal-gated). On
 * desktop the cards sit in a row; on mobile they become a horizontal
 * scroll-snap rail (no JS — native overflow scrolling).
 *
 * No-JS / reduced-motion: cards paint in their FINAL resting position (hidden
 * offsets sit behind `html.js`; reduced-motion resets with !important). The day
 * label, place, and item list are all static text.
 *
 * data: { days[]{ day, place, items? }, caption?, source? }
 */
interface Day { day: number | string; place: string; items?: string[]; }
interface Props {
  days: Day[];
  caption?: string;
  source?: string;
}
const { days = [], caption, source } = Astro.props;

const items = days.filter((d) => d && d.place);
const fmtDay = (d: number | string) =>
  typeof d === 'number' ? `Day ${d}` : /^\d+$/.test(String(d)) ? `Day ${d}` : String(d);
---

<div class="px-viz" data-reveal>
  {caption && <div class="px-viz__cap"><span>{caption}</span><b>{items.length} days</b></div>}

  {items.length > 0 ? (
    <div class="px-ireel px3d-stage">
      <div class="px-ireel__rail">
        {items.map((d, i) => (
          <div class="px-ireel__card px3d-tilt" data-tilt="8" style={`--i:${i}`}>
            <div class="px-ireel__day">{fmtDay(d.day)}</div>
            <div class="px-ireel__place">{d.place}</div>
            {d.items && d.items.length > 0 && (
              <ul class="px-ireel__items">
                {d.items.map((it) => (
                  <li class="px-ireel__item">{it}</li>
                ))}
              </ul>
            )}
            <span class="px-ireel__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
        ))}
      </div>
    </div>
  ) : (
    <p class="px-ireel__empty">No itinerary days.</p>
  )}

  {source && <div class="px-viz__src">Source · {source}</div>}
</div>

<style>
  .px-ireel { width: 100%; }
  .px-ireel__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(190px, 1fr);
    gap: 16px;
    align-items: stretch;
    padding: 6px 2px 10px;
  }

  .px-ireel__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 18px 22px;
    border-radius: var(--r-tile);
    background:
      radial-gradient(150% 100% at 0% 0%, color-mix(in oklab, var(--accent) 14%, var(--paper)) 0%, var(--paper) 58%);
    border: 1px solid var(--rule);
    /* depth — layered shadow reads as a card lifted off the page */
    box-shadow:
      0 1px 0 0 color-mix(in oklab, var(--ink) 5%, transparent),
      0 18px 40px -26px color-mix(in oklab, var(--ink) 55%, transparent);
    transform-origin: 50% 90%;
    /* base/resting = final visible state (no-JS safe) */
    transition:
      transform var(--t-soft) var(--ease),
      box-shadow var(--t-soft) var(--ease),
      opacity var(--t-soft) var(--ease);
    overflow: hidden;
  }
  /* focused/hover card pops forward with a deeper shadow + a touch of scale */
  .px-ireel__card:hover,
  .px-ireel__card:focus-within {
    box-shadow:
      0 1px 0 0 color-mix(in oklab, var(--accent) 40%, transparent),
      0 30px 60px -28px color-mix(in oklab, var(--ink) 65%, transparent);
  }

  .px-ireel__day {
    /* "Day N" reads as a display-serif kicker, tabular figure, accent ink */
    font-family: var(--issue-face, var(--font-display)); font-weight: 700;
    font-size: 14px; letter-spacing: 0.01em; line-height: 1;
    color: var(--accent-deep, var(--accent)); font-variant-numeric: tabular-nums;
  }
  .px-ireel__place {
    font-family: var(--issue-face, var(--font-display)); font-weight: 700;
    font-size: 22px; line-height: 1.12; color: var(--ink); letter-spacing: -0.01em;
  }
  .px-ireel__items {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: 8px;
  }
  .px-ireel__item {
    position: relative;
    font-family: var(--font-body); font-size: 13px; line-height: 1.45;
    color: var(--ink-soft); padding-left: 16px;
  }
  .px-ireel__item::before {
    content: ''; position: absolute; left: 0; top: 0.62em;
    width: 6px; height: 6px; border-radius: 50%;
    background: color-mix(in oklab, var(--accent) 60%, var(--rule));
  }
  .px-ireel__no {
    position: absolute; right: 12px; bottom: 6px;
    font-family: var(--issue-face, var(--font-display)); font-weight: 700;
    font-size: 46px; line-height: 1; color: var(--ink);
    opacity: 0.06; font-variant-numeric: tabular-nums; pointer-events: none;
  }

  /* reveal: cards fan/slide in on a stagger (gated behind html.js) */
  html.js .px-viz:not(.is-in) .px-ireel__card {
    opacity: 0;
    transform: translateY(20px) rotate(-2deg);
  }
  .px-viz.is-in .px-ireel__card { transition-delay: calc(var(--i) * 90ms); }

  /* mobile: horizontal scroll-snap rail */
  @media (max-width: 640px) {
    .px-ireel { margin-inline: calc(-1 * var(--gutter, 0px)); }
    .px-ireel__rail {
      grid-auto-columns: 78%;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 6px 16px 14px;
      scrollbar-width: none;
    }
    .px-ireel__rail::-webkit-scrollbar { display: none; }
    .px-ireel__card { scroll-snap-align: center; }
    /* In a horizontal scroller, overflow-x:auto computes overflow-y:auto, so a
       rotated reveal offset would add phantom scroll width/height. Drop the
       rotation here — translate-only keeps the rail clean. */
    html.js .px-viz:not(.is-in) .px-ireel__card { transform: translateY(20px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .px-viz:not(.is-in) .px-ireel__card { opacity: 1 !important; transform: none !important; }
  }

  .px-ireel__empty {
    font-family: var(--font-mono); font-size: 12px; color: var(--muted);
    text-align: center; padding: 28px 0;
  }
</style>
