---
/**
 * SeasonWheel (`season-wheel`) — when to go, as a dial of the year (Lens
 * Phase 6, the Lib-season-wheel board). Twelve month sectors, January at
 * the top and clockwise; two or three rings (inner climate comfort, middle
 * crowds, outer price by default), each month's value filling its band from
 * the inside out on a paper-3 track. The sweet spot is outlined in the desk
 * text colour: the good window is where the inner ring is full and the outer
 * two are empty. The place is named in the middle.
 *
 * The month scrubber and the tilted disc of the old wheel are gone: the cues
 * light a month or the window instead (a lit month shows its own outline).
 * Every value stays reachable as each month's title and in the figure's
 * accessible name. Values are normalised 0–1 indices, never raw degrees,
 * rupees or heads (the `indices 0–1` chip says so).
 *
 * The rings are SVG, drawn on a 460-unit square that scales to its box; the
 * month names, the place and the numerals are an HTML layer on top, so they
 * print at their own size at any width. Zero JS.
 *
 * Cue anchors:
 *   1…12    each month, January first (its sector and its name)
 *   best    the sweet-spot window
 *   climate · crowd · price   each ring's key under the wheel
 *
 * Build (src/scripts/build.ts, LENS §6.4): 1 the tracks, 2 the months fill
 * clockwise, 3 the sweet spot, 4 the names and the key. No JS or reduced
 * motion: the wheel as drawn.
 *
 * data: { place, months: [12 × {climate?, crowd?, price?, label?}], rings?, sweetSpot? }
 */
type Metric = 'climate' | 'crowd' | 'price';
interface MonthDatum { climate?: number; crowd?: number; price?: number; label?: string; }
interface Props {
  place: string;
  months: MonthDatum[];
  rings?: Metric[];
  sweetSpot?: number[];
  caption?: string;
  source?: string;
}
const { place, months = [], rings, sweetSpot, caption, source } = Astro.props;

if (!Array.isArray(months) || months.length !== 12) {
  throw new Error(`season-wheel (${place ?? 'unknown'}): expected EXACTLY 12 months (Jan→Dec), got ${months?.length ?? 0}. The wheel is a calendar year.`);
}

const ringNames: Metric[] = rings && (rings.length === 2 || rings.length === 3) ? rings : ['climate', 'crowd', 'price'];
const BANDS: [number, number][] = ringNames.length === 2 ? [[64, 116], [122, 174]] : [[64, 98], [103, 137], [142, 174]];
const FILL: Record<Metric, string> = {
  climate: 'var(--accent)',
  crowd: 'var(--ink-2)',
  price: 'color-mix(in oklab, var(--ink-2) 62%, var(--paper-3))',
};
const WORD: Record<Metric, string> = { climate: 'climate', crowd: 'crowds', price: 'price' };
const POS = ringNames.length === 2 ? ['inner', 'outer'] : ['inner', 'middle', 'outer'];

const S = 460, C = 230;
const D2R = Math.PI / 180;
const pt = (r: number, deg: number): [number, number] => [C + r * Math.cos(deg * D2R), C + r * Math.sin(deg * D2R)];
const f = (v: number) => v.toFixed(1);
const ang = (i: number) => -90 + i * 30;
function sector(r0: number, r1: number, a0: number, a1: number) {
  const [x0, y0] = pt(r1, a0), [x1, y1] = pt(r1, a1), [x2, y2] = pt(r0, a1), [x3, y3] = pt(r0, a0);
  const lg = a1 - a0 > 180 ? 1 : 0;
  return `M${f(x0)} ${f(y0)}A${r1} ${r1} 0 ${lg} 1 ${f(x1)} ${f(y1)}L${f(x2)} ${f(y2)}A${r0} ${r0} 0 ${lg} 0 ${f(x3)} ${f(y3)}Z`;
}
const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// ── the sweet spot: authored, else months passing all three thresholds ──────
const passes = (m: MonthDatum) => {
  const any = m.climate != null || m.crowd != null || m.price != null;
  return any && (m.climate == null || m.climate >= 0.6) && (m.crowd == null || m.crowd <= 0.4) && (m.price == null || m.price <= 0.5);
};
const chosen = sweetSpot && sweetSpot.length
  ? [...sweetSpot].filter((i) => i >= 0 && i <= 11).sort((a, b) => a - b)
  : months.map((m, i) => (passes(m) ? i : -1)).filter((i) => i >= 0);
const runs: number[][] = [];
for (const i of chosen) {
  const last = runs[runs.length - 1];
  if (last && i === last[last.length - 1] + 1) last.push(i); else runs.push([i]);
}
const best = new Set(chosen);

const R0 = BANDS[0][0] - 6, R1 = BANDS[BANDS.length - 1][1] + 6;
const sectors = months.map((m, i) => {
  const a0 = ang(i) + 1.2, a1 = ang(i + 1) - 1.2;
  const wedges = ringNames.map((k, ri) => {
    const [r0, r1] = BANDS[ri];
    const v = m[k];
    return {
      track: sector(r0, r1, a0, a1),
      fill: v == null || !Number.isFinite(v) ? '' : sector(r0, r0 + (r1 - r0) * clamp01(v), a0, a1),
      color: FILL[k],
    };
  });
  const [lx, ly] = pt(196, ang(i) + 15);
  const vals = ringNames.map((k) => `${WORD[k]} ${m[k] == null ? 'no data' : clamp01(m[k] as number).toFixed(2)}`).join(', ');
  return {
    i, wedges,
    hl: sector(R0, R1, ang(i), ang(i + 1)),
    title: `${MON[i]}: ${vals}${m.label ? ` · ${m.label}` : ''}`,
    lx: (lx / S) * 100, ly: (ly / S) * 100,
  };
});
const bestTag = runs.length
  ? (() => { const run = runs[0]; const [bx, by] = pt(R1 + 18, ang(run[run.length - 1] + 1) - 8); return { x: (bx / S) * 100, y: (by / S) * 100 }; })()
  : null;
const aria = [caption, source ? `Source: ${source}` : ''].filter(Boolean).concat('').join('. ') + `${place}: ${ringNames.map((k) => WORD[k]).join(', ')} by month, January at the top${chosen.length ? `; the sweet spot is ${chosen.map((i) => MON[i]).join(', ')}` : ''}`;
---

<div class="px-swheel" data-viz-root data-build-scene>
  <div class="px-swheel__dial">
    <svg viewBox={`0 0 ${S} ${S}`} role="img" aria-label={aria}>
      {sectors.map((s) => (
        <g class="px-swheel__mo" data-cue={s.i + 1}>
          <title>{s.title}</title>
          {s.wedges.map((w) => <path d={w.track} fill="var(--paper-3)" data-build="1" />)}
          <g data-build="2">
            {s.wedges.map((w) => w.fill && <path d={w.fill} fill={w.color} />)}
          </g>
          <path class="px-swheel__hl" d={s.hl} fill="none" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round" />
        </g>
      ))}
      {runs.length > 0 && (
        <g data-cue="best" data-build="3">
          {runs.map((run) => (
            <path d={sector(R0, R1, ang(run[0]), ang(run[run.length - 1] + 1))} fill="none" stroke="var(--accent-deep)" stroke-width="2.5" stroke-linejoin="round" />
          ))}
        </g>
      )}
    </svg>

    <div class="px-swheel__labels" data-build="4">
      <span class="px-swheel__place">
        <b>{place}</b>
        <span>Jan at top</span>
      </span>
      {sectors.map((s) => (
        <span class="px-swheel__m" data-cue={s.i + 1} data-best={best.has(s.i) ? 'true' : undefined} style={`left:${s.lx.toFixed(2)}%;top:${s.ly.toFixed(2)}%`}>
          {MON[s.i]}<span class="px-cue-tag" data-cue-tag={s.i + 1} hidden></span>
        </span>
      ))}
      {bestTag && (
        <span class="px-swheel__tag" data-cue="best" style={`left:${bestTag.x.toFixed(2)}%;top:${bestTag.y.toFixed(2)}%`}>
          <span class="px-cue-tag" data-cue-tag="best" hidden></span>
        </span>
      )}
    </div>
  </div>

  <div class="px-swheel__key" data-build="4">
    {ringNames.map((k, ri) => (
      <span class="px-swheel__k" data-cue={k}>
        <i style={`background:${FILL[k]}`}></i>{POS[ri]} · {WORD[k]}<span class="px-cue-tag" data-cue-tag={k} hidden></span>
      </span>
    ))}
    <span class="px-swheel__chip">indices 0–1</span>
  </div>
</div>

<style>
  .px-swheel { font-family: var(--font-ui); }
  .px-swheel__dial { position: relative; width: 100%; max-width: 460px; margin: 0 auto; }
  .px-swheel__dial svg { display: block; width: 100%; height: auto; }
  /* a month's own outline shows only while a cue lights it */
  .px-swheel__hl { opacity: 0; transition: opacity var(--t-micro, 160ms) var(--ease); }
  .px-swheel__mo[data-lit='true'] .px-swheel__hl { opacity: 1; }
  .px-swheel__mo[data-cue] { outline: none !important; }

  .px-swheel__labels { position: absolute; inset: 0; pointer-events: none; }
  .px-swheel__m {
    position: absolute; translate: -50% -50%;
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 13px; line-height: 1; font-weight: 500; color: var(--ink-2); white-space: nowrap;
  }
  .px-swheel__m[data-best] { color: var(--accent-deep); font-weight: 600; }
  .px-swheel__m .px-cue-tag { margin: 0; }
  .px-swheel__m[data-cue] { outline-offset: 2px; }
  .px-swheel__place {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    display: flex; flex-direction: column; align-items: center; gap: 2px; text-align: center;
    width: 24%;
  }
  .px-swheel__place b {
    font-family: var(--font-display); font-size: 22px; line-height: 1.05; font-weight: 500; color: var(--ink);
    overflow-wrap: anywhere;
  }
  .px-swheel__place span { font-size: 12px; line-height: 1.2; color: var(--muted); }
  .px-swheel__tag { position: absolute; translate: -50% -50%; line-height: 0; }
  .px-swheel__tag .px-cue-tag { margin: 0; }
  .px-swheel__tag[data-cue] { outline: none !important; }

  .px-swheel__key { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-top: 14px; }
  .px-swheel__k { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; line-height: 1.3; color: var(--ink-2); }
  .px-swheel__k i { display: inline-block; width: 14px; height: 14px; border-radius: 2px; }
  .px-swheel__k .px-cue-tag { margin: 0; }
  .px-swheel__chip {
    display: inline-flex; align-items: center; height: 28px; padding: 0 12px; border-radius: 999px;
    background: var(--paper-3); color: var(--ink-2); font-size: 12px; font-weight: 500;
  }

  @media (max-width: 520px) {
    .px-swheel__place b { font-size: 16px; }
    .px-swheel__place span { display: none; }
    .px-swheel__m { font-size: 12px; }
  }
</style>
