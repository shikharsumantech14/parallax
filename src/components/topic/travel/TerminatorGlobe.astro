---
/**
 * TerminatorGlobe (`terminator-globe`, travel FLAGSHIP) — "the reason your
 * body is wrong, drawn on the actual planet" (Lens Phase 6, the
 * Lib-terminator-globe board). On the desk's deep plate: the hours aloft set
 * large; a real country-outline Earth lit for the departure instant, night
 * shaded, the day and night line dashed, the great-circle flight in the desk
 * mark from one city to the other; a key under it. Rendered lazily by the
 * WebGL runtime (scene 'terminator-globe': drag to spin, the ARRIVAL chip
 * moves the sun to landing); the static fallback is the same projection
 * computed at build time from the same pure functions (kepler.ts,
 * terminator.ts), so no-JS, reduced-motion and no-WebGL readers get the
 * identical still.
 *
 * On the plate (LENS §8): words in --on-deep, rules --on-deep-hair, marks in
 * the desk mark. The scene reads its colours from the mount's custom
 * properties, which this component points at the plate's (scenes/
 * terminatorGlobe.ts lifts the globe off a dark ground and darkens the
 * night there).
 *
 * The city labels are HTML over the fallback drawing, placed in percent, so
 * they print at 13 / 12px at any width (the mount pins an aspect ratio, so a
 * scroll could not help). The cue anchors live on that fallback and its label
 * layer, never on the canvas (Phase 6 brief §9). The build runs on the
 * number and the key only, which sit outside the mount: the fallback is
 * hidden once the scene is live, so nothing inside it may build.
 *
 * Cue anchors:
 *   line    the day and night line (the terminator)
 *   night   the night side (its wash, and its key)
 *   arc     the flight's great circle (its path, and its key)
 *   from    the departure city (its pin and label)
 *   to      the arrival city (its pin and label)
 *   hours   the hours aloft, the number above
 *
 * Build (src/scripts/build.ts, LENS §6.4): 1 the key, 2 the number. The
 * scene's own boot reveal and its one idle loop stay (the runtime's).
 *
 * data: { epoch, from: {city, lat, lon, tzOffsetH}, to: {…}, flightHours, arcBulge? }
 */
import { geoOrthographic, geoPath, geoCircle } from 'd3-geo';
import { mesh as topomesh } from 'topojson-client';
import { readFileSync } from 'fs';
import { join } from 'path';
import { subsolarPoint, greatCircle } from '../../../scripts/viz3d/kepler';
import {
  terminatorRing, antisolarPoint, isDaylight, groundDistanceKm,
  localClock, offsetLabel, clampBulge, fmtKm,
} from '../../../scripts/viz3d/terminator';

interface City { city: string; lat: number; lon: number; tzOffsetH: number }
interface Props {
  epoch?: string;
  from?: City;
  to?: City;
  flightHours?: number;
  arcBulge?: number;
  caption?: string;
  source?: string;
}
const {
  epoch = '2026-01-01T00:00:00Z',
  from = { city: 'From', lat: 0, lon: 0, tzOffsetH: 0 },
  to = { city: 'To', lat: 0, lon: 0, tzOffsetH: 0 },
  flightHours = 0,
  arcBulge,
} = Astro.props;

const bulge = clampBulge(arcBulge);
const epochMs = Date.parse(epoch + (epoch.length <= 10 ? 'T00:00:00Z' : ''));
const arrivalMs = epochMs + flightHours * 3600000;
const sub = subsolarPoint(epochMs);
const anti = antisolarPoint(sub);

/* ── orthographic globe, centred a little south of the arc midpoint so the
   arc rides the upper half (the board's framing) ── */
const W = 460, H = 366, cx = 230, cy = 183, Rpx = 172;
const midPt = greatCircle({ lat: from.lat, lon: from.lon }, { lat: to.lat, lon: to.lon }, 2)[1];
const proj = geoOrthographic().scale(Rpx).translate([cx, cy]).clipAngle(90)
  .rotate([-midPt.lon, -Math.max(-60, midPt.lat - 18)]);
const pathGen = geoPath(proj);

const topo = JSON.parse(readFileSync(join(process.cwd(), 'node_modules/world-atlas/countries-110m.json'), 'utf-8')) as any;
const bordersGeo = topomesh(topo, topo.objects.countries);
function lines(geo: any, minStep = 2): string {
  const ls: number[][][] = geo.type === 'MultiLineString' ? geo.coordinates : [geo.coordinates];
  let d = '';
  for (const line of ls) {
    let on = false, lx = 0, ly = 0;
    for (const c of line) {
      const p = proj(c as [number, number]);
      if (!p) { on = false; continue; }
      const x = +p[0].toFixed(1), y = +p[1].toFixed(1);
      if (!on) { d += `M${x} ${y}`; on = true; lx = x; ly = y; }
      else if (Math.hypot(x - lx, y - ly) >= minStep) { d += `L${x} ${y}`; lx = x; ly = y; }
    }
  }
  return d;
}
const countryPath = lines(bordersGeo);

function seg(pts: [number, number][]): string {
  let d = '', on = false;
  for (const c of pts) {
    const p = proj(c);
    if (!p) { on = false; continue; }
    d += `${on ? 'L' : 'M'}${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
    on = true;
  }
  return d;
}
let gratPath = '';
for (const lat of [-60, -30, 0, 30, 60]) gratPath += seg(Array.from({ length: 61 }, (_, k) => [-180 + k * 6, lat] as [number, number]));
for (let lon = -150; lon <= 180; lon += 30) gratPath += seg(Array.from({ length: 41 }, (_, k) => [lon, -80 + k * 4] as [number, number]));

const ringPts = terminatorRing(sub, 128);
const termPath = seg([...ringPts, ringPts[0]].map((p) => [p.lon, p.lat] as [number, number]));
const nightPath = pathGen(geoCircle().center([anti.lon, anti.lat]).radius(90)()) || '';
const arcPts = greatCircle({ lat: from.lat, lon: from.lon }, { lat: to.lat, lon: to.lon }, 64);
const flightPath = seg(arcPts.map((p) => [p.lon, p.lat] as [number, number]));

const pin = (c: { lat: number; lon: number }) => {
  const q = proj([c.lon, c.lat]);
  return q ? { x: q[0], y: q[1], vis: true } : { x: 0, y: 0, vis: false };
};
const fromPin = pin(from);
const toPin = pin(to);
const arcMid = pin(arcPts[32]);
// the line's numeral where the visible terminator is farthest from both
// city labels and the arc's numeral (their HTML labels keep their size on a
// phone, where the globe shrinks). The night side carries no numeral of its
// own: its wash and its key are the anchor.
const busy = [fromPin, toPin, arcMid].filter((p) => p.vis);
const termVis = ringPts.map((p) => pin(p)).filter((p) => p.vis && Math.hypot(p.x - cx, p.y - cy) < Rpx * 0.88);
const clear = (p: { x: number; y: number }) => Math.min(...busy.map((q) => Math.hypot(q.x - p.x, q.y - p.y)), 1e9);
const termTag = termVis.length
  ? termVis.reduce((m, p) => (clear(p) > clear(m) ? p : m), termVis[0])
  : { x: cx, y: cy, vis: false };

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const side = (x: number) => (x > cx ? 'l' : 'r');

const distKm = groundDistanceKm({ lat: from.lat, lon: from.lon }, { lat: to.lat, lon: to.lon });
const dep = localClock(epochMs, from.tzOffsetH);
const arr = localClock(arrivalMs, to.tzOffsetH);
const dayTag = (d: number) => (d < 0 ? ' (prev day)' : d > 0 ? ' (+1)' : '');
const light = (c: City) => (isDaylight({ lat: c.lat, lon: c.lon }, sub) ? 'in daylight' : 'in darkness');
const hoursTxt = (() => {
  const r = Math.round(flightHours * 2) / 2;
  if (Math.abs(r - flightHours) < 0.01) return Number.isInteger(r) ? String(r) : `${Math.floor(r)}½`;
  return flightHours.toFixed(1);
})();
const phaseH = Math.abs(from.tzOffsetH - to.tzOffsetH);
const arrLabel = `Arrival ${arr.hhmm}${dayTag(arr.dayDelta)}`;
const aria = `Globe lit for ${epoch}: ${from.city} ${dep.hhmm} ${light(from)} to ${to.city}, arriving ${arr.hhmm}${dayTag(arr.dayDelta)} local, ${fmtKm(distKm)} km, ${hoursTxt} hours aloft, ${phaseH} hours of clock difference`;
const payload = JSON.stringify({ epoch, from, to, flightHours, arcBulge: bulge });
---

<div class="px-tglobe" data-viz-root>
  {/* the scene is the plate without the chips: they appear only once the
      WebGL scene is live, and a scene must end where the static page ends */}
  <div class="px-tglobe__scene" data-build-scene>
  <div class="px-tglobe__head" data-cue="hours">
    <b class="px-tglobe__n" data-build="2" data-build-kind="rise">{hoursTxt}</b>
    <span class="px-tglobe__u">hours aloft<span class="px-cue-tag" data-cue-tag="hours" hidden></span></span>
  </div>

  <div class="viz3d viz3d--tglobe" data-viz3d="terminator-globe" data-viz3d-state="departure" role="img" aria-label={aria}>
    <div class="viz3d__fallback">
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <circle cx={cx} cy={cy} r={Rpx} fill="color-mix(in oklab, var(--deep) 84%, var(--on-deep))" />
        {nightPath && <path d={nightPath} fill="color-mix(in oklab, var(--deep) 45%, #000)" fill-opacity="0.8" data-cue="night" />}
        <path d={gratPath} fill="none" stroke="var(--on-deep-hair)" stroke-width="1" />
        <path d={countryPath} fill="none" stroke="var(--on-deep)" stroke-opacity="0.5" stroke-width="0.9" stroke-linejoin="round" stroke-linecap="round" />
        <circle cx={cx} cy={cy} r={Rpx} fill="none" stroke="var(--on-deep-hair)" stroke-width="1" />
        {termPath && <path d={termPath} fill="none" stroke="var(--on-deep)" stroke-opacity="0.85" stroke-width="1.75" stroke-dasharray="5 4" data-cue="line" />}
        {flightPath && <path d={flightPath} fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" data-cue="arc" />}
        {fromPin.vis && <circle cx={fromPin.x.toFixed(1)} cy={fromPin.y.toFixed(1)} r="6" fill="var(--accent)" stroke="var(--on-deep)" stroke-width="1.5" data-cue="from" />}
        {toPin.vis && <circle cx={toPin.x.toFixed(1)} cy={toPin.y.toFixed(1)} r="6" fill="var(--accent)" stroke="var(--on-deep)" stroke-width="1.5" data-cue="to" />}
      </svg>
      {[{ p: fromPin, c: from, id: 'from', clk: dep }, { p: toPin, c: to, id: 'to', clk: arr }].map(({ p, c, id, clk }) => p.vis && (
        <span class="px-tglobe__city" data-cue={id} data-side={side(p.x)} data-up={p.y > cy ? undefined : 'true'}
          style={`left:${pct(p.x, W)};top:${pct(p.y, H)}`}>
          <span class="px-cue-tag" data-cue-tag={id} hidden></span>
          <span class="px-tglobe__ct"><b>{`${c.city} ${clk.hhmm}${dayTag(clk.dayDelta)}`}</b><span>{offsetLabel(c.tzOffsetH)}</span></span>
        </span>
      ))}
      <span class="px-tglobe__tag" data-cue="line" style={`left:${pct(termTag.x, W)};top:${pct(termTag.y, H)}`}><span class="px-cue-tag" data-cue-tag="line" hidden></span></span>
      {arcMid.vis && (
        <span class="px-tglobe__tag" data-cue="arc" style={`left:${pct(arcMid.x, W)};top:${pct(arcMid.y - 18, H)}`}><span class="px-cue-tag" data-cue-tag="arc" hidden></span></span>
      )}
    </div>
    <span class="viz3d__hint" aria-hidden="true">drag to spin</span>
    <script type="application/json" class="viz3d__data" set:html={payload}></script>
  </div>

  <div class="px-tglobe__key" data-build="1">
    <span class="px-tglobe__k"><i class="px-tglobe__sw" data-k="day"></i>day side</span>
    <span class="px-tglobe__k" data-cue="night"><i class="px-tglobe__sw" data-k="night"></i>night side</span>
    <span class="px-tglobe__k" data-cue="arc"><i class="px-tglobe__sw" data-k="arc"></i>the flight</span>
  </div>
  </div>

  {/* the scene's two instants: shown only once the WebGL scene is live, in
      flow under the plate (never floating over it on touch) */}
  <div class="px-tglobe__chips">
    <button type="button" class="px-tglobe__chip" data-state="departure" aria-pressed="true">Departure {dep.hhmm}</button>
    <button type="button" class="px-tglobe__chip" data-state="arrival" aria-pressed="false">{arrLabel}</button>
  </div>
</div>

<script is:inline>
  (function () {
    var s = document.currentScript;
    var root = s && s.previousElementSibling;
    if (!root || !root.classList.contains('px-tglobe')) return;
    var mount = root.querySelector('[data-viz3d="terminator-globe"]');
    var chips = root.querySelectorAll('.px-tglobe__chip');
    if (!mount || !chips.length) return;
    function onClick() {
      var st = this.getAttribute('data-state') || 'departure';
      mount.setAttribute('data-viz3d-state', st);
      for (var k = 0; k < chips.length; k++) chips[k].setAttribute('aria-pressed', chips[k] === this ? 'true' : 'false');
    }
    for (var i = 0; i < chips.length; i++) chips[i].addEventListener('click', onClick);
  })();
</script>

<style>
  .px-tglobe {
    background: var(--deep); color: var(--on-deep);
    border-radius: var(--r-card); padding: 20px;
    font-family: var(--font-ui);
  }
  /* the ONE headline number at 96 (72 on phones), its label 8px below it
     (LENS §7) */
  .px-tglobe__head { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 8px; }
  .px-tglobe__n {
    font-weight: 700; font-size: 96px; line-height: 1; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--on-deep);
    padding-bottom: 0.12em;
  }
  .px-tglobe__u {
    display: inline-flex; align-items: center; gap: 8px; padding-bottom: 0;
    font-size: 12px; line-height: 1.35; font-weight: 600; color: var(--on-deep-2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .px-tglobe__u .px-cue-tag { margin: 0; }
  @media (max-width: 640px) { .px-tglobe__n { font-size: 72px; } }

  /* the mount on the plate: the scene reads these as its colours */
  .viz3d--tglobe {
    aspect-ratio: 460 / 366;
    background: transparent;
    --paper: var(--deep);
    --paper-2: var(--deep);
    --ink: var(--on-deep);
    --muted: var(--on-deep-2);
    --accent-deep: var(--on-deep);
  }

  .px-tglobe__city {
    position: absolute; z-index: 1; pointer-events: none;
    display: inline-flex; align-items: flex-start; gap: 6px;
    translate: 10px 8px;
    text-shadow: 0 0 3px var(--deep), 0 0 3px var(--deep), 0 0 6px var(--deep);
  }
  .px-tglobe__city[data-up] { translate: 10px calc(-100% - 8px); }
  .px-tglobe__city[data-side='l'] { flex-direction: row-reverse; translate: calc(-100% - 10px) 8px; }
  .px-tglobe__city[data-side='l'][data-up] { translate: calc(-100% - 10px) calc(-100% - 8px); }
  .px-tglobe__city[data-side='l'] .px-tglobe__ct { align-items: flex-end; text-align: right; }
  .px-tglobe__ct { display: flex; flex-direction: column; gap: 2px; white-space: nowrap; }
  .px-tglobe__ct b { font-size: 13px; line-height: 1.2; font-weight: 600; color: var(--on-deep); }
  .px-tglobe__ct span { font-size: 12px; line-height: 1.2; color: var(--on-deep-2); }
  .px-tglobe__city .px-cue-tag { margin: 0; }
  .px-tglobe__tag { position: absolute; z-index: 1; translate: -50% -50%; line-height: 0; }
  .px-tglobe__tag .px-cue-tag { margin: 0; }
  .px-tglobe .px-cue-tag { box-shadow: 0 0 0 2px var(--deep); }
  .px-tglobe__tag[data-cue], .px-tglobe__city[data-cue] { outline: none !important; }

  .px-tglobe__chips { display: none; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .px-tglobe:has(.viz3d--live) .px-tglobe__chips { display: flex; }
  .px-tglobe__chip {
    min-height: 44px; padding: 0 14px; border-radius: 999px;
    border: 1px solid var(--on-deep-hair); background: transparent; color: var(--on-deep-2);
    font-family: var(--font-ui); font-size: 13px; font-weight: 500; font-variant-numeric: tabular-nums;
    cursor: pointer; transition: color var(--t-micro, 160ms) var(--ease), border-color var(--t-micro, 160ms) var(--ease);
  }
  .px-tglobe__chip:hover { border-color: var(--on-deep-2); color: var(--on-deep); }
  .px-tglobe__chip[aria-pressed='true'] { border-color: var(--accent); color: var(--on-deep); }
  .px-tglobe__chip:focus-visible { outline: 2px solid var(--on-deep); outline-offset: 2px; }

  .px-tglobe__key { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-top: 12px; }
  .px-tglobe__k { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; line-height: 1.3; color: var(--on-deep-2); }
  .px-tglobe__k[data-cue] { outline: none !important; }
  .px-tglobe__sw { display: inline-block; width: 12px; height: 12px; border-radius: 999px; border: 1px solid var(--on-deep-hair); }
  .px-tglobe__sw[data-k='day'] { background: color-mix(in oklab, var(--deep) 84%, var(--on-deep)); }
  .px-tglobe__sw[data-k='night'] { background: color-mix(in oklab, var(--deep) 45%, #000); }
  .px-tglobe__sw[data-k='arc'] { width: 18px; height: 3px; border: 0; border-radius: 2px; background: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .px-tglobe__chip { transition: none; }
  }
</style>
