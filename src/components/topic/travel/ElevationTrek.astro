---
/**
 * ElevationTrek (`elevation-trek`) — a route's height against distance (Lens
 * Phase 6, the Lib-elevation-trek board). The peak set large above the plot;
 * under it a y-axis of heights, the ground filled in the desk tint, the
 * profile in the desk mark, a dot on each point. A point's name sits beside
 * its dot where it fits clear of the line and of every other name; where it
 * does not, it moves to a column at the right with a leader, the height under
 * it. A long authored label prints its first part ("Camp 4 · South Col" →
 * "Camp 4"); the whole label is the dot's title.
 *
 * Drawn for the figure panel: a 460-unit viewBox, text at 12 and 13 units, so
 * it prints at size in the 472 panel; on a phone the figure keeps its 460px
 * and scrolls inside its card (dataviz-v2.css, the card-scroll rule). The cue
 * numerals are an HTML layer over the drawing, placed in percent.
 *
 * Cue anchors:
 *   1…n     each point, in authored order (its dot and its name)
 *   line    the profile and the ground under it
 *   peak    the highest point (its ring, and the number above)
 *   axis    the height and distance axes
 *
 * Build (src/scripts/build.ts, LENS §6.4): 1 the axes, 2 the ground fades and
 * the profile draws, 3 the dots drop, 4 the names rise, 5 the peak counts up.
 * No JS or reduced motion: the chart as drawn.
 *
 * data: { points: [{km, elevM, label?}], unit? }
 */
interface Point { km: number; elevM: number; label?: string; }
interface Props {
  points: Point[];
  unit?: string;
  caption?: string;
  source?: string;
}
const { points = [], unit = 'm' } = Astro.props;

const FF = "'Instrument Sans','Helvetica Neue',Arial,sans-serif";
const W = 460, H = 300;
const PL = 48, PT = 14, PB = H - 30;
const CH = 6.7;            // units a character at 12px (13px names are budgeted at 7.3)

const pts = points
  .map((p, i) => ({ ...p, i }))
  .filter((p) => p && Number.isFinite(p.km) && Number.isFinite(p.elevM));
const byKm = [...pts].sort((a, b) => a.km - b.km);
const hasData = byKm.length > 0;

const nice = (span: number, want: number, steps: number[]) =>
  steps.find((s) => span / s <= want) ?? steps[steps.length - 1];

const kmLo = hasData ? Math.min(0, byKm[0].km) : 0;
const kmHi = hasData ? Math.max(byKm[byKm.length - 1].km, kmLo + 1) : 1;
const eMinR = hasData ? Math.min(...byKm.map((p) => p.elevM)) : 0;
const eMaxR = hasData ? Math.max(...byKm.map((p) => p.elevM)) : 1;
const eStep = nice(eMaxR - eMinR || 1, 5, [50, 100, 200, 250, 500, 1000, 2000, 5000]);
const eLo = Math.floor(eMinR / eStep) * eStep;
const eHi = Math.max(Math.ceil(eMaxR / eStep) * eStep, eLo + eStep);
const yTicks: number[] = [];
for (let e = eLo; e <= eHi + 1e-9; e += eStep) yTicks.push(e);
const kStep = nice(kmHi - kmLo, 5, [1, 2, 4, 5, 10, 20, 25, 50, 100, 200, 250, 500]);
const xTicks: number[] = [];
for (let k = Math.ceil(kmLo / kStep) * kStep; k <= kmHi + 1e-9; k += kStep) xTicks.push(k);

const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
const short = (s?: string) => (s ? s.split(/\s+[·—–]\s+|\s+-\s+/)[0].trim() : '');

type Box = { l: number; r: number; t: number; b: number };
const hit = (a: Box, b: Box) => a.l < b.r && a.r > b.l && a.t < b.b && a.b > b.t;

/* Lay the chart out for a plot whose right edge is PR. Returns null when a
   name cannot be placed without the right-hand column. */
function layout(PR: number, allowColumn: boolean) {
  const sx = (km: number) => PL + ((km - kmLo) / (kmHi - kmLo)) * (PR - PL);
  const sy = (e: number) => PT + (1 - (e - eLo) / (eHi - eLo)) * (PB - PT);
  const xy = byKm.map((p) => ({ ...p, x: sx(p.km), y: sy(p.elevM), name: short(p.label) }));
  // the line as samples, for the collision test
  const samples: { x: number; y: number }[] = [];
  for (let k = 0; k < xy.length - 1; k++) {
    const a = xy[k], b = xy[k + 1];
    const n = Math.max(2, Math.ceil(Math.hypot(b.x - a.x, b.y - a.y) / 3));
    for (let j = 0; j <= n; j++) samples.push({ x: a.x + ((b.x - a.x) * j) / n, y: a.y + ((b.y - a.y) * j) / n });
  }
  const placed: Box[] = xy.map((p) => ({ l: p.x - 5, r: p.x + 5, t: p.y - 5, b: p.y + 5 }));
  const inline: Record<number, { x: number; y: number; anchor: string }> = {};
  const callouts: typeof xy = [];
  const maxR = allowColumn ? PR - 2 : W - 2;
  for (const p of xy) {
    if (!p.name) continue;
    const w = p.name.length * CH;
    const cands = [
      { x: p.x + 8, y: p.y + 17, anchor: 'start', box: { l: p.x + 7, r: p.x + 9 + w, t: p.y + 6, b: p.y + 20 } },
      { x: p.x - 8, y: p.y - 9, anchor: 'end', box: { l: p.x - 9 - w, r: p.x - 7, t: p.y - 20, b: p.y - 5 } },
      { x: p.x + 8, y: p.y - 9, anchor: 'start', box: { l: p.x + 7, r: p.x + 9 + w, t: p.y - 20, b: p.y - 5 } },
      { x: p.x - 8, y: p.y + 17, anchor: 'end', box: { l: p.x - 9 - w, r: p.x - 7, t: p.y + 6, b: p.y + 20 } },
    ];
    const ok = cands.find((c) =>
      c.box.l >= PL + 2 && c.box.r <= maxR && c.box.t >= 0 && c.box.b <= PB - 1 &&
      !placed.some((q) => hit(q, c.box)) &&
      !samples.some((s) => s.x > c.box.l - 1 && s.x < c.box.r + 1 && s.y > c.box.t - 1 && s.y < c.box.b + 1),
    );
    if (ok) { inline[p.i] = { x: ok.x, y: ok.y, anchor: ok.anchor }; placed.push(ok.box); }
    else if (allowColumn) callouts.push(p);
    else return null;
  }
  // the column: stacked in height order, each name + height (30 units a block)
  const colX = PR + 14;
  const BLOCK = 32;
  const cs = [...callouts].sort((a, b) => a.y - b.y).map((p) => ({ p, y: Math.max(12, p.y - 6) }));
  for (let k = 1; k < cs.length; k++) cs[k].y = Math.max(cs[k].y, cs[k - 1].y + BLOCK);
  const over = cs.length ? cs[cs.length - 1].y + 16 - PB : 0;
  if (over > 0) for (let k = cs.length - 1; k >= 0; k--) {
    cs[k].y = Math.min(cs[k].y, (k === cs.length - 1 ? PB - 16 : cs[k + 1].y - BLOCK));
  }
  const colChars = Math.max(4, Math.floor((W - colX - 2) / 7.3));
  const callout: Record<number, { y: number; x: number; name: string }> = {};
  for (const c of cs) {
    const nm = c.p.name.length > colChars ? c.p.name.slice(0, colChars - 1).trimEnd() + '…' : c.p.name;
    callout[c.p.i] = { y: c.y, x: colX, name: nm };
  }
  // the callout blocks and leaders are occupied too
  for (const c of cs) placed.push({ l: colX - 2, r: W, t: c.y - 12, b: c.y + 18 });
  return { PR, sx, sy, xy, inline, callout, placed, samples };
}

const L = hasData ? (layout(W - 4, false) ?? layout(W - 108, true)!) : null;

const peak = hasData ? byKm.reduce((m, p) => (p.elevM > m.elevM ? p : m), byKm[0]) : null;
const peakName = short(peak?.label);

let linePath = '', areaPath = '';
if (L) {
  linePath = L.xy.map((p, k) => `${k ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join('');
  const first = L.xy[0], last = L.xy[L.xy.length - 1];
  areaPath = `${linePath}L${last.x.toFixed(1)} ${PB}L${first.x.toFixed(1)} ${PB}Z`;
}
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const clampX = (x: number) => Math.min(W - 12, Math.max(12, x));
const clampY = (y: number) => Math.min(H - 12, Math.max(10, y));

/* where each anchor's numeral prints (viewBox units) */
const tagPos: { id: string; x: number; y: number }[] = [];
if (L) {
  // each point's numeral beside its dot, on a side clear of every name, the
  // line and the numerals already placed
  const taken: Box[] = [...L.placed];
  const OFF: [number, number][] = [[-15, -15], [15, -15], [-15, 15], [15, 15], [0, -20], [-20, 0], [20, 0], [0, 20]];
  for (const p of L.xy) {
    const at = OFF.map(([dx, dy]) => ({ x: clampX(p.x + dx), y: clampY(p.y + dy) }))
      .map((c) => ({ ...c, box: { l: c.x - 11, r: c.x + 11, t: c.y - 11, b: c.y + 11 } }));
    const ok = at.find((c) => !taken.some((q) => hit(q, c.box)) &&
      !L.samples.some((s) => s.x > c.box.l && s.x < c.box.r && s.y > c.box.t && s.y < c.box.b)) ?? at[0];
    taken.push(ok.box);
    tagPos.push({ id: String(p.i + 1), x: ok.x, y: ok.y });
  }
  const mid = L.xy[Math.max(0, Math.floor((L.xy.length - 1) / 3))];
  const nxt = L.xy[Math.min(L.xy.length - 1, Math.floor((L.xy.length - 1) / 3) + 1)];
  tagPos.push({ id: 'line', x: clampX((mid.x + nxt.x) / 2), y: clampY(Math.max(mid.y, nxt.y) + 22) });
  tagPos.push({ id: 'axis', x: 14, y: clampY(PT + 4) });
}
---

{hasData && L ? (
  <div class="px-etrek" data-viz-root data-build-scene>
    <div class="px-etrek__head" data-cue="peak">
      <b class="px-etrek__n" data-build="5" data-build-kind="counter" data-to={Math.round(peak!.elevM)}>{fmt(peak!.elevM)}</b>
      <span class="px-etrek__u">{unit}{peakName ? `, ${peakName}` : ', highest point'}<span class="px-cue-tag" data-cue-tag="peak" hidden></span></span>
    </div>

    <div class="px-etrek__stage">
      <svg
        class="px-etrek__plot"
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={`Elevation profile over ${fmt(kmHi - kmLo)} km, from ${fmt(eMinR)} ${unit} to ${fmt(eMaxR)} ${unit}`}
        style={`font-family:${FF}`}
      >
        <g class="px-etrek__axis" data-cue="axis" data-build="1">
          {yTicks.map((e) => (
            <g>
              <line x1={PL} x2={L.PR} y1={L.sy(e).toFixed(1)} y2={L.sy(e).toFixed(1)} stroke="var(--hair)" stroke-width="1" />
              <text x={PL - 8} y={(L.sy(e) + 4).toFixed(1)} text-anchor="end" font-size="12" fill="var(--muted)">{fmt(e)}</text>
            </g>
          ))}
          <line x1={PL} x2={L.PR} y1={PB} y2={PB} stroke="var(--hair-2)" stroke-width="1" />
          {xTicks.map((k, j) => (
            <text
              x={L.sx(k).toFixed(1)}
              y={H - 10}
              text-anchor={j === xTicks.length - 1 && L.sx(k) > L.PR - 24 ? 'end' : 'middle'}
              font-size="12"
              fill="var(--muted)"
            >{fmt(k)}{j === xTicks.length - 1 ? ' km' : ''}</text>
          ))}
        </g>

        <g data-cue="line">
          <path d={areaPath} fill="var(--accent-tint)" data-build="2" />
          <path d={linePath} fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" data-build="2" data-build-kind="draw" />
        </g>

        {L.xy.map((p) => {
          const il = L.inline[p.i];
          const co = L.callout[p.i];
          const isPeak = p === L.xy.find((q) => q.i === peak!.i);
          return (
            <g data-cue={p.i + 1}>
              {p.label && <title>{p.label} · {fmt(p.elevM)} {unit}</title>}
              {co && (
                <polyline
                  points={`${(p.x + 6).toFixed(1)},${p.y.toFixed(1)} ${(co.x - 12).toFixed(1)},${(co.y - 4).toFixed(1)} ${(co.x - 4).toFixed(1)},${(co.y - 4).toFixed(1)}`}
                  fill="none" stroke="var(--ink-2)" stroke-width="1" data-build="4"
                />
              )}
              {isPeak && (
                <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="9" fill="none" stroke="var(--accent)" stroke-width="2" data-cue="peak" data-build="3" data-build-kind="drop" />
              )}
              <circle
                cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={isPeak ? 4.5 : 4}
                fill={isPeak ? 'var(--accent)' : 'var(--ink)'} stroke="var(--paper-2)" stroke-width="1.5"
                data-build="3" data-build-kind="drop"
              />
              {il && (
                <text x={il.x.toFixed(1)} y={il.y.toFixed(1)} text-anchor={il.anchor} font-size="12" fill="var(--ink-2)"
                  stroke="var(--paper-2)" stroke-width="3" stroke-linejoin="round" paint-order="stroke" data-build="4" data-build-kind="rise">{p.name}</text>
              )}
              {co && (
                <text x={co.x.toFixed(1)} y={(co.y).toFixed(1)} font-size="13" data-build="4" data-build-kind="rise">
                  <tspan font-weight="600" fill="var(--ink)">{co.name}</tspan>
                  <tspan x={co.x.toFixed(1)} dy="15" font-size="12" font-weight="600" fill="var(--accent-deep)">{`${fmt(p.elevM)} ${unit}`}</tspan>
                </text>
              )}
            </g>
          );
        })}
      </svg>

      <div class="px-etrek__tags" aria-hidden="true" data-build="4">
        {tagPos.map((t) => (
          <span class="px-etrek__tag" data-cue={t.id} style={`left:${pct(t.x, W)};top:${pct(t.y, H)}`}>
            <span class="px-cue-tag" data-cue-tag={t.id} hidden></span>
          </span>
        ))}
      </div>
    </div>
  </div>
) : (
  <p class="px-etrek__empty">No elevation data.</p>
)}

<style>
  .px-etrek { font-family: var(--font-ui); }
  /* the ONE headline number at 96 (72 on phones), its label 8px below it
     (LENS §7) */
  .px-etrek__head { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 16px; }
  .px-etrek__n {
    font-weight: 600; font-size: 96px; line-height: 0.92; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--accent-deep);
  }
  .px-etrek__u {
    display: inline-flex; align-items: center; gap: 8px; padding-bottom: 0;
    font-size: 14px; line-height: 1.3; font-weight: 500; color: var(--ink-2);
  }
  .px-etrek__u .px-cue-tag { margin: 0; }
  @media (max-width: 640px) { .px-etrek__n { font-size: 72px; } }

  /* the drawing keeps its 460 units: it fills the 472 panel, and on a phone
     its card scrolls rather than shrinking the type */
  .px-etrek__stage { position: relative; min-width: 460px; }
  .px-etrek__plot { display: block; width: 100%; height: auto; overflow: visible; }
  .px-etrek__tags { position: absolute; inset: 0; pointer-events: none; }
  .px-etrek__tag { position: absolute; translate: -50% -50%; line-height: 0; }
  .px-etrek__tag .px-cue-tag { margin: 0; }
  .px-etrek__tag[data-cue] { outline: none !important; }

  .px-etrek__empty { font-size: 13px; color: var(--muted); text-align: center; padding: 28px 0; }
</style>
