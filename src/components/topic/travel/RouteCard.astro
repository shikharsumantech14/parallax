---
/*
  RouteCard — v2 vertical multi-leg journey (.rc) inside the elevated .px-viz
  card. A dashed rail threads mode-glyph nodes; legs slide in on a stagger as
  the card reveals on scroll. Faithful port of publication-v2 DataViz <RouteCard>.
  Build-time, zero runtime JS.

  Use for: trip itineraries, migration routes, trade routes,
  logistical supply chains, flight paths.

  props:
    legs[]   — { from: string, to: string, distance?: string,
                 duration?: string, mode: string, note?: string }
    title    — optional journey title
    caption
    source
*/
interface Leg {
  from: string;
  to: string;
  distance?: string;
  duration?: string;
  mode: string;
  note?: string;
}
interface Props {
  legs: Leg[];
  title?: string;
  caption?: string;
  source?: string;
}
const { legs = [], title, caption, source } = Astro.props;

// Glyph keyed off the leg mode (lowercased); anything unknown falls back to fly.
const glyphFor = (mode: string): 'train' | 'drive' | 'ferry' | 'fly' => {
  const m = mode.toLowerCase();
  if (m === 'train') return 'train';
  if (m === 'drive' || m === 'car') return 'drive';
  if (m === 'ferry' || m === 'ship') return 'ferry';
  return 'fly';
};
---

<div class="px-viz" data-reveal>
  {caption && <div class="px-viz__cap"><span>{caption}</span></div>}

  <div class="rc__head">
    <span class="rc__title">{title}</span>
    <span class="rc__count">{legs.length} legs</span>
  </div>

  <div class="rc__legs">
    {legs.map((leg, i) => {
      const glyph = glyphFor(leg.mode);
      return (
        <div class="rc__leg" style={`transition-delay:${i * 70}ms`}>
          <span class="rc__node">
            {glyph === 'train' && (
              <svg viewBox="0 0 24 24">
                <rect x="6" y="3" width="12" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="6" y1="11" x2="18" y2="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="9" cy="19" r="1.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="15" cy="19" r="1.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="8" y1="21" x2="6" y2="23" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="16" y1="21" x2="18" y2="23" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {glyph === 'drive' && (
              <svg viewBox="0 0 24 24">
                <path d="M4 13l1.5-5h13L20 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <rect x="3" y="13" width="18" height="5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="7" cy="18" r="1.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="17" cy="18" r="1.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {glyph === 'ferry' && (
              <svg viewBox="0 0 24 24">
                <path d="M4 17l1-5h14l1 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M3 17c1.5 1.5 3 1.5 4.5 0s3-1.5 4.5 0 3 1.5 4.5 0 3-1.5 4.5 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="12" y1="5" x2="12" y2="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {glyph === 'fly' && (
              <svg viewBox="0 0 24 24">
                <path d="M2 16l20-7-9 11-2-5-9 1z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </span>
          <div class="rc__leg-body">
            <div class="rc__cities">{leg.from}<span class="arr">→</span>{leg.to}</div>
            <div class="rc__meta">
              <span>{leg.mode}</span>
              {leg.distance && <span>{leg.distance}</span>}
              {leg.duration && <span>{leg.duration}</span>}
            </div>
            {leg.note && <div class="rc__note">{leg.note}</div>}
          </div>
        </div>
      );
    })}
  </div>

  {source && <div class="px-viz__src">Source · {source}</div>}
</div>
