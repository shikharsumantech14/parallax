---
/**
 * AttritionWaffle (`attrition-waffle`) — a hundred squares, one per person,
 * grouped by what happened to them (Lens Phase 6, the Lib-attrition-waffle
 * board). The largest group's count set large; under it a 10 × 10 grid, one
 * contiguous block per group in order of size (largest first, ties in
 * authored order), and beside it the ledger: each group's swatch, label,
 * note and count. The reader audits a published rate by counting it.
 *
 * Blueprint: docs/design/blueprints/travel/attrition-waffle.md. HTML, no JS:
 * the group-select island of the old card is gone, because the cues light a
 * group now (its squares and its ledger row share one anchor). No count-up
 * and no square-by-square stagger: an animated waffle turns an auditable
 * figure into a performance (the blueprint). `trueN` prints the
 * `per hundred · n = …` chip. The grid is 10 wide (the board), 212px on the
 * panel and on a phone alike, each square about 18px.
 *
 * Cue anchors:
 *   1…n     each group, in AUTHORED order (its squares, its ledger row, and
 *           the number above when it is the largest)
 *   grid    the hundred squares
 *
 * Build (src/scripts/build.ts, LENS §6.4): 1 the grid, 2 the ledger rows,
 * 3 the number. No JS or reduced motion: the waffle as drawn.
 *
 * data: { groups: [{id, label, count, color?, note?}], n?: 100, trueN?, subject? }
 */
interface Group {
  id: string;
  label: string;
  count: number;
  color?: string;
  note?: string;
}
interface Props {
  /** Literal 100. Documentation only — the denominator is never anything else. */
  n?: number;
  /** The REAL sample size when the figure is normalised to a hundred. */
  trueN?: number;
  /** 'trekkers', 'patients' — named in the readout, omitted when absent. */
  subject?: string;
  groups?: Group[];
  caption?: string;
  source?: string | { label: string; date?: string };
}

const { n, trueN, subject, groups = [], caption, source } = Astro.props;

const K = '[attrition-waffle]';

/* ── Build-time validation (blueprint §3) ──────────────────────────────────
   The squares ARE the data here — nothing is scaled, so there is no rendering
   that can absorb a bad payload. A waffle whose parts do not make a hundred
   silently publishes a rate that does not exist, which is worse than a failed
   build. Every check below therefore throws, naming the offending group. */
if (n !== undefined && n !== 100) {
  throw new Error(
    `${K} \`n\` documents the denominator and must be exactly 100 if present, got ${n}. ` +
      'A real sample of another size goes in `trueN`.',
  );
}
if (groups.length < 3 || groups.length > 6) {
  throw new Error(`${K} needs 3–6 outcome groups, got ${groups.length}. See blueprint §10.`);
}

const seenIds = new Set<string>();
groups.forEach((g, i) => {
  if (!g || !g.id || !g.label) throw new Error(`${K} group ${i} needs both an \`id\` and a \`label\`.`);
  if (seenIds.has(g.id)) {
    throw new Error(`${K} duplicate group id "${g.id}" — ids identify the outcome and must be unique.`);
  }
  seenIds.add(g.id);
  if (typeof g.count !== 'number' || !Number.isFinite(g.count) || g.count < 0) {
    throw new Error(`${K} group "${g.label}" has a count of ${g.count}; it must be a finite number of 0 or more.`);
  }
});

const sum = groups.reduce((t, g) => t + g.count, 0);
if (Math.abs(sum - 100) > 1e-9) {
  throw new Error(
    `${K} the counts must sum to exactly 100 — they sum to ${sum}. ` +
      groups.map((g) => `${g.label} = ${g.count}`).join('; ') +
      '.',
  );
}

/* Fractional counts mean the real sample was normalised, which is a claim about
   the data and not a formatting detail — so it is only allowed when `trueN`
   declares the real n and the caption states it. */
const isNormalised = groups.some((g) => !Number.isInteger(g.count));
if (isNormalised && trueN === undefined) {
  throw new Error(
    `${K} fractional counts are only permitted when \`trueN\` is set: rounding a real sample down to ` +
      'a hundred squares is a claim the caption has to carry.',
  );
}

/* Rounding five numbers that total 100 can land on 99 or 101. The blueprint
   gives the remainder to the LARGEST group — a fixed rule so the choice is
   never arbitrary, and the one that distorts a proportion least. */
const squares = groups.map((g) => Math.round(g.count));
const drift = 100 - squares.reduce((t, v) => t + v, 0);
if (drift !== 0) {
  let big = 0;
  for (let i = 1; i < squares.length; i++) if (squares[i] > squares[big]) big = i;
  squares[big] += drift;
}
squares.forEach((v, i) => {
  if (v < 1) {
    throw new Error(
      `${K} group "${groups[i].label}" comes to ${v} squares. A group that cannot be counted is not a ` +
        'group — fold it into the "other" bucket.',
    );
  }
});

if (trueN !== undefined) {
  if (!Number.isInteger(trueN) || trueN < 1) {
    throw new Error(`${K} \`trueN\` must be a positive whole number, got ${trueN}.`);
  }
  if (!caption) {
    throw new Error(`${K} \`trueN\` is set (${trueN}), so the caption must state the real sample size. There is no caption.`);
  }
  // Separators stripped so a caption reading "1,240 walkers" satisfies trueN: 1240.
  if (!caption.replace(/[,\s]/g, '').includes(String(trueN))) {
    throw new Error(
      `${K} the figure is normalised to a hundred, so the caption must state the real n (${trueN}). ` +
        `It reads: "${caption}".`,
    );
  }
}

/* ── The ramp (blueprint §6), in order of size ─────────────────────────── */
const RAMP = [
  'var(--accent-deep)',
  'var(--accent)',
  'color-mix(in oklab, var(--accent) 60%, var(--paper))',
  'color-mix(in oklab, var(--ink) 55%, var(--paper))',
  'color-mix(in oklab, var(--ink) 34%, var(--paper))',
  'color-mix(in oklab, var(--ink) 22%, var(--paper))',
];
const rows = groups
  .map((g, i) => ({ ...g, i, squares: squares[i] }))
  .sort((a, b) => b.squares - a.squares || a.i - b.i)
  .map((g, k) => ({ ...g, fill: g.color ?? RAMP[k] }));
const cells: typeof rows = [];
for (const r of rows) for (let k = 0; k < r.squares; k++) cells.push(r);

const noun = (subject ?? '').split(',')[0].trim();
const one = noun ? noun.replace(/ies$/, 'y').replace(/s$/, '') : '';
const first = rows[0];
const srcText = typeof source === 'string' ? source : source ? [source.label, source.date].filter(Boolean).join(' · ') : '';
const aria = (srcText ? `Source: ${srcText}. ` : '') + `100 squares${noun ? ' of ' + noun : ''}: ` + rows.map((r) => `${r.squares} ${r.label}`).join(', ');
/* A ledger note is budgeted, not clamped: at most about two lines of the
   ledger's narrowest column; the whole note is the row's title. */
const NOTE_CH = 64;
const brief = (t?: string) => {
  if (!t || t.length <= NOTE_CH) return t;
  const cut = t.slice(0, NOTE_CH - 1);
  return cut.slice(0, Math.max(cut.lastIndexOf(' '), NOTE_CH - 12)).replace(/[\s,.;:—–-]+$/, '') + '…';
};
const chip = trueN !== undefined ? `per hundred · n = ${trueN}` : undefined;
---

<div class="px-waf" data-viz-root data-build-scene>
  <div class="px-waf__head" data-cue={first.i + 1}>
    <b class="px-waf__n" data-build="3" data-build-kind="rise">{first.squares}</b>
    <span class="px-waf__u">{first.label}<span class="px-cue-tag" data-cue-tag={first.i + 1} hidden></span></span>
  </div>

  <div class="px-waf__body">
    <div class="px-waf__side">
      <span class="px-waf__lab" data-cue="grid">100{noun ? ` ${noun}` : ''}<span class="px-cue-tag" data-cue-tag="grid" hidden></span></span>
      <div class="px-waf__grid" role="img" aria-label={aria} data-cue="grid" data-build="1">
        {cells.map((r) => <i class="px-waf__cell" data-cue={r.i + 1} style={`background:${r.fill}`}></i>)}
      </div>
      <span class="px-waf__foot">one square, one {one || 'in a hundred'}</span>
      {chip && <span class="px-waf__chip">{chip}</span>}
    </div>

    <ol class="px-waf__ledger">
      {rows.map((r) => (
        <li class="px-waf__row" data-cue={r.i + 1} data-build="2" data-build-kind="rise" title={r.note}>
          <span class="px-waf__sw" style={`background:${r.fill}`}></span>
          <span class="px-waf__txt">
            <span class="px-waf__label">{r.label}</span>
            {r.note && <span class="px-waf__note">{brief(r.note)}</span>}
          </span>
          <span class="px-waf__val">{r.squares}</span>
          <span class="px-waf__slot"><span class="px-cue-tag" data-cue-tag={r.i + 1} hidden></span></span>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .px-waf { position: relative; font-family: var(--font-ui); }
  /* the ONE headline number at 96 (72 on phones), its label 8px below it
     (LENS §7) */
  .px-waf__head { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 18px; }
  .px-waf__n {
    font-weight: 700; font-size: 96px; line-height: 1; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--accent-deep);
    padding-bottom: 0.12em;
  }
  .px-waf__u {
    display: inline-flex; align-items: center; gap: 8px; padding-bottom: 0; min-width: 0;
    font-size: 12px; line-height: 1.35; font-weight: 600; color: var(--ink-2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .px-waf__u .px-cue-tag { margin: 0; }
  @media (max-width: 640px) { .px-waf__n { font-size: 72px; } }

  .px-waf__body { display: flex; flex-wrap: wrap; gap: 16px 20px; align-items: flex-start; }
  .px-waf__side { width: 212px; flex: none; display: flex; flex-direction: column; gap: 8px; }
  .px-waf__lab { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .px-waf__grid { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 3px; }
  /* a square, never rounded past 2px: a rounded square stops reading as a unit */
  .px-waf__cell { display: block; aspect-ratio: 1; border-radius: 2px; }
  .px-waf__cell[data-cue] { outline: none !important; }
  .px-waf__foot { font-size: 12px; line-height: 1.4; color: var(--muted); }
  .px-waf__chip {
    align-self: flex-start; display: inline-flex; align-items: center; min-height: 28px; padding: 0 12px;
    border-radius: 999px; background: var(--paper-3); color: var(--ink-2); font-size: 12px; font-weight: 500;
  }

  .px-waf__ledger { flex: 1 1 200px; min-width: 0; list-style: none; margin: 0; padding: 20px 0 0; display: flex; flex-direction: column; gap: 10px; }
  .px-waf__row {
    display: grid; grid-template-columns: 14px minmax(0, 1fr) auto auto; gap: 10px; align-items: center;
    padding-bottom: 10px; border-bottom: 1px solid var(--hair);
  }
  .px-waf__sw { width: 14px; height: 14px; border-radius: 2px; }
  .px-waf__txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .px-waf__label { font-size: 14px; line-height: 1.3; font-weight: 600; color: var(--ink); overflow-wrap: anywhere; }
  .px-waf__note {
    font-size: 12px; line-height: 1.35; color: var(--muted);
  }
  .px-waf__val { font-size: 20px; line-height: 1; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink); }
  .px-waf__slot { display: flex; min-width: 20px; }
  .px-waf__slot .px-cue-tag + .px-cue-tag { margin-left: -4px; }
  .px-waf__slot .px-cue-tag { margin: 0; }
</style>
