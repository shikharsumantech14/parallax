---
/**
 * FareTerrain (`fare-terrain`) — when to book (Lens Phase 6, the
 * Lib-fare-terrain board). The sweet-spot fare set large and the last-minute
 * fare beside it; under them the fare against days before departure, time
 * running left to right toward the flight (a reversed axis, declared by the
 * `time → departure` chip), the focal route as a line over a tinted ground
 * with a dot at each sample, any other routes as thinner ink lines, and the
 * booking window shaded and named SWEET SPOT.
 *
 * The window is `sweetSpotDays` when authored; otherwise the contiguous run
 * of the focal route's samples at or under 1.05 × its lowest fare. The focal
 * route is the one marked `highlight`, else the first.
 *
 * Drawn for the figure panel: a 460-unit viewBox, text at 12 units and more;
 * on a phone it keeps 460px and scrolls inside its card. The cue numerals are
 * an HTML layer over the drawing.
 *
 * Cue anchors:
 *   band    the sweet-spot window
 *   low     the lowest fare (its point, and the number above)
 *   last    the fare nearest departure (its point, and its number)
 *   1…n     each route's line, in authored order
 *   axis    the fare and day axes
 *
 * Build (src/scripts/build.ts, LENS §6.4): 1 the axes, 2 the window, 3 the
 * ground fades and the lines draw, 4 the points and labels, 5 the numbers
 * count up. No JS or reduced motion: the chart as drawn.
 *
 * data: { routes: [{label, points: [{daysBefore, fare}], highlight?}], unit, sweetSpotDays? }
 */
interface FarePoint { daysBefore: number; fare: number; }
interface Route { label: string; points: FarePoint[]; highlight?: boolean; }
interface Props {
  routes: Route[];
  unit?: string;
  sweetSpotDays?: [number, number];
  caption?: string;
  source?: string;
}
const { routes = [], unit = 'index', sweetSpotDays } = Astro.props;

// ── validation (blueprint §11: 1–5 routes; ≥6 samples each) ──────────────────
if (routes.length < 1 || routes.length > 5) {
  throw new Error(`fare-terrain: routes.length must be 1–5 (got ${routes.length}). A booking chart holds one to five curves.`);
}
routes.forEach((r, i) => {
  const n = Array.isArray(r.points) ? r.points.length : 0;
  if (n < 6) throw new Error(`fare-terrain: route ${i} ("${r.label}") has ${n} points; each route needs ≥6 fare samples.`);
});

const FF = "'Instrument Sans','Helvetica Neue',Arial,sans-serif";
const W = 460, H = 254;
const PL = 44, PR = 452, PT = 26, PB = 222;

const clean = (r: Route) =>
  [...r.points].filter((p) => Number.isFinite(p.daysBefore) && Number.isFinite(p.fare) && p.daysBefore >= 0)
    .sort((a, b) => b.daysBefore - a.daysBefore);
const built = routes.map((r, i) => ({ r, i, pts: clean(r) }));
const focal = built.find((b) => b.r.highlight) ?? built[0];

const maxDays = Math.max(...built.flatMap((b) => b.pts.map((p) => p.daysBefore)));
const allFares = built.flatMap((b) => b.pts.map((p) => p.fare));
const fMin = Math.min(...allFares), fMax = Math.max(...allFares);
const fStep = [10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000, 5000].find((s) => (fMax - fMin) / s <= 4) ?? 10000;
const fLo = Math.max(0, Math.floor((fMin - fStep * 0.4) / fStep) * fStep);
const fHi = fMax;
const x = (d: number) => PL + ((maxDays - d) / maxDays) * (PR - PL);
const y = (f: number) => PB - ((f - fLo) / (fHi - fLo || 1)) * (PB - PT - 8);

const yTicks: number[] = [];
for (let f = Math.ceil((fLo + 1e-9) / fStep) * fStep; f <= fHi + 1e-9; f += fStep) yTicks.push(f);
const dStep = [7, 14, 15, 30, 60, 90, 180].find((s) => maxDays / s <= 4) ?? 365;
const xTickVals = [...new Set([maxDays, ...Array.from({ length: Math.floor(maxDays / dStep) }, (_, k) => (k + 1) * dStep).filter((d) => d < maxDays - dStep * 0.5), 0])].sort((a, b) => b - a);

const path = (pts: FarePoint[]) => pts.map((p, k) => `${k ? 'L' : 'M'}${x(p.daysBefore).toFixed(1)} ${y(p.fare).toFixed(1)}`).join('');

// ── the window ───────────────────────────────────────────────────────────────
const fp = focal.pts;
const low = Math.min(...fp.map((p) => p.fare));
let winMaxD: number, winMinD: number;
if (sweetSpotDays && Number.isFinite(sweetSpotDays[0]) && Number.isFinite(sweetSpotDays[1])) {
  winMaxD = Math.max(sweetSpotDays[0], sweetSpotDays[1]);
  winMinD = Math.min(sweetSpotDays[0], sweetSpotDays[1]);
} else {
  let mi = fp.findIndex((p) => p.fare === low), lo = mi, hi = mi;
  while (lo > 0 && fp[lo - 1].fare <= low * 1.05) lo--;
  while (hi < fp.length - 1 && fp[hi + 1].fare <= low * 1.05) hi++;
  winMaxD = fp[lo].daysBefore; winMinD = fp[hi].daysBefore;
}
if (winMaxD === winMinD) { winMaxD += Math.max(2, dStep / 6); winMinD = Math.max(0, winMinD - Math.max(2, dStep / 6)); }
const inWin = fp.filter((p) => p.daysBefore <= winMaxD && p.daysBefore >= winMinD);
const valley = inWin.length ? inWin.reduce((m, p) => (p.fare < m.fare ? p : m), inWin[0]) : fp.find((p) => p.fare === low)!;
const lastPt = fp[fp.length - 1];
const firstPt = fp[0];

const bandL = x(winMaxD), bandR = x(winMinD), bandMid = (bandL + bandR) / 2;
const SPOT = 'SWEET SPOT';
const spotW = SPOT.length * 7.6;
const spotX = Math.min(Math.max(bandMid, PL + spotW / 2), W - 2 - spotW / 2);

const fmt = (n: number) => (Number.isInteger(n) ? n.toLocaleString('en-US') : n.toFixed(1));
const isIndex = /^index$/i.test(unit);
const axisTitle = isIndex ? 'fare index' : `fare, ${unit}`;
const dayWord = (d: number) => (d === 1 ? 'day before' : `${fmt(d)} days before`);
const firstLabel = `${fmt(firstPt.fare)} · ${fmt(firstPt.daysBefore)} days`;

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const tagPos = [
  { id: 'band', x: Math.max(12, spotX - spotW / 2 - 18), y: 10 },
  { id: 'low', x: x(valley.daysBefore), y: Math.min(H - 12, y(valley.fare) + 20) },
  { id: 'last', x: Math.max(12, x(lastPt.daysBefore) - 20), y: y(lastPt.fare) + 8 },
  { id: 'axis', x: 14, y: PB + 18 },
  ...built.map((b) => {
    const p = b.pts[Math.floor(b.pts.length / 3)];
    return { id: String(b.i + 1), x: x(p.daysBefore), y: Math.max(12, y(p.fare) - 16) };
  }),
];
---

<div class="px-fterr" data-viz-root data-build-scene>
  <div class="px-fterr__head">
    <span class="px-fterr__fig" data-cue="low">
      <b class="px-fterr__n" data-build="5" data-build-kind="counter" data-to={valley.fare} data-format={Number.isInteger(valley.fare) ? 'int' : '1dp'}>{fmt(valley.fare)}</b>
      <span class="px-fterr__u">at {fmt(valley.daysBefore)} days<span class="px-cue-tag" data-cue-tag="low" hidden></span></span>
    </span>
    <span class="px-fterr__fig px-fterr__fig--2" data-cue="last">
      <b class="px-fterr__n2" data-build="5" data-build-kind="counter" data-to={lastPt.fare} data-format={Number.isInteger(lastPt.fare) ? 'int' : '1dp'}>{fmt(lastPt.fare)}</b>
      <span class="px-fterr__u">{dayWord(lastPt.daysBefore)}<span class="px-cue-tag" data-cue-tag="last" hidden></span></span>
    </span>
  </div>

  <div class="px-fterr__key">
    <span class="px-fterr__routes">
      {built.map((b) => (
        <span class="px-fterr__route" data-focal={b === focal ? 'true' : undefined}><i></i>{b.r.label}</span>
      ))}
    </span>
    <span class="px-fterr__chip">time → departure</span>
  </div>

  <div class="px-fterr__stage">
    <svg
      class="px-fterr__plot"
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={`${axisTitle} against days before departure for ${built.map((b) => b.r.label).join(', ')}; lowest ${fmt(valley.fare)} at ${fmt(valley.daysBefore)} days, ${fmt(lastPt.fare)} ${dayWord(lastPt.daysBefore)}`}
      style={`font-family:${FF}`}
    >
      <g data-cue="axis" data-build="1">
        <text x={PL} y="14" font-size="12" fill="var(--muted)">{axisTitle}</text>
        {yTicks.map((f) => (
          <g>
            <line x1={PL} x2={PR} y1={y(f).toFixed(1)} y2={y(f).toFixed(1)} stroke="var(--hair)" stroke-width="1" />
            <text x={PL - 8} y={(y(f) + 4).toFixed(1)} text-anchor="end" font-size="12" fill="var(--muted)">{fmt(f)}</text>
          </g>
        ))}
        <line x1={PL} x2={PR} y1={PB} y2={PB} stroke="var(--hair-2)" stroke-width="1" />
        {xTickVals.map((d, k) => (
          <g>
            <line x1={x(d).toFixed(1)} x2={x(d).toFixed(1)} y1={PB} y2={PB + 6} stroke="var(--hair-2)" />
            <text x={x(d).toFixed(1)} y={PB + 22} text-anchor={k === 0 ? 'start' : d === 0 ? 'end' : 'middle'} font-size="12" fill="var(--muted)">{d === 0 ? 'departure' : k === 0 ? `${fmt(d)} days` : fmt(d)}</text>
          </g>
        ))}
      </g>

      <g data-cue="band" data-build="2">
        <rect x={bandL.toFixed(1)} y={PT} width={(bandR - bandL).toFixed(1)} height={PB - PT} fill="var(--accent-deep)" fill-opacity="0.12" />
        <text x={spotX.toFixed(1)} y="14" text-anchor="middle" font-size="12" font-weight="600" letter-spacing="0.72" fill="var(--accent-deep)">{SPOT}</text>
      </g>

      {built.filter((b) => b !== focal).map((b) => (
        <path d={path(b.pts)} fill="none" stroke="var(--ink-2)" stroke-width="1.5" stroke-linejoin="round" data-cue={b.i + 1} data-build="3" data-build-kind="draw" />
      ))}
      <g data-cue={focal.i + 1}>
        <path d={`${path(fp)}L${x(lastPt.daysBefore).toFixed(1)} ${PB}L${x(firstPt.daysBefore).toFixed(1)} ${PB}Z`} fill="var(--accent-tint)" fill-opacity="0.85" data-build="3" />
        <path d={path(fp)} fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" data-build="3" data-build-kind="draw" />
        <g data-build="4">
          {fp.map((p) => <circle cx={x(p.daysBefore).toFixed(1)} cy={y(p.fare).toFixed(1)} r="2.5" fill="var(--accent)" />)}
          <text x={(x(firstPt.daysBefore) + 2).toFixed(1)} y={(y(firstPt.fare) - 10).toFixed(1)} font-size="12" fill="var(--ink-2)"
            stroke="var(--paper-2)" stroke-width="3" stroke-linejoin="round" paint-order="stroke">{firstLabel}</text>
        </g>
      </g>
      <circle cx={x(valley.daysBefore).toFixed(1)} cy={y(valley.fare).toFixed(1)} r="5.5" fill="var(--accent-deep)" stroke="var(--paper-2)" stroke-width="1.5" data-cue="low" data-build="4" data-build-kind="drop" />
      <circle cx={x(lastPt.daysBefore).toFixed(1)} cy={y(lastPt.fare).toFixed(1)} r="5" fill="var(--ink)" stroke="var(--paper-2)" stroke-width="1.5" data-cue="last" data-build="4" data-build-kind="drop" />
    </svg>

    <div class="px-fterr__tags" aria-hidden="true" data-build="4">
      {tagPos.map((t) => (
        <span class="px-fterr__tag" data-cue={t.id} style={`left:${pct(t.x, W)};top:${pct(t.y, H)}`}>
          <span class="px-cue-tag" data-cue-tag={t.id} hidden></span>
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .px-fterr { font-family: var(--font-ui); }
  .px-fterr__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 8px 16px; margin-bottom: 14px; }
  /* the low fare is the ONE headline number, 96 (72 on phones); the
     departure fare a secondary figure at 48; each label 8px below (LENS §7) */
  .px-fterr__fig { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .px-fterr__n {
    font-weight: 600; font-size: 96px; line-height: 0.92; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--accent-deep);
  }
  .px-fterr__n2 {
    font-weight: 600; font-size: 48px; line-height: 0.92; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .px-fterr__u {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; line-height: 1.3; font-weight: 500; color: var(--ink-2);
  }
  .px-fterr__u .px-cue-tag { margin: 0; }
  @media (max-width: 640px) { .px-fterr__n { font-size: 72px; } }
  .px-fterr__key { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; margin-bottom: 10px; }
  .px-fterr__routes { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .px-fterr__route { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--ink); }
  .px-fterr__route i { display: inline-block; width: 20px; height: 2px; border-radius: 2px; background: var(--ink-2); }
  .px-fterr__route[data-focal] i { height: 3px; background: var(--accent); }
  .px-fterr__chip {
    display: inline-flex; align-items: center; height: 28px; padding: 0 12px; border-radius: 999px;
    background: var(--paper-3); color: var(--ink-2); font-size: 12px; font-weight: 500;
  }
  .px-fterr__stage { position: relative; min-width: 460px; }
  .px-fterr__plot { display: block; width: 100%; height: auto; overflow: visible; }
  .px-fterr__tags { position: absolute; inset: 0; pointer-events: none; }
  .px-fterr__tag { position: absolute; translate: -50% -50%; line-height: 0; }
  .px-fterr__tag .px-cue-tag { margin: 0; }
  .px-fterr__tag[data-cue] { outline: none !important; }
</style>
