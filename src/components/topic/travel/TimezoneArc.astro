---
/**
 * TimezoneArc (`timezone-arc`) — who is awake when you are (Lens Phase 6,
 * the Lib-timezone-arc board). The reference zone's clock set large ("12:00
 * in Tokyo"); under it one day, 00:00 to 24:00, left to right: the sun's
 * height as a curve over a horizon, the day above it on paper and the night
 * below it on the desk's deep plate. Each city sits on the curve at its
 * local hour when it is noon in the reference zone: a sun disc by day, a
 * moon by night, its name, clock and UTC offset beside it.
 *
 * Deterministic: the reference zone is pinned at 12:00 (no live clock, so
 * every build is the same); every other city is `12 + (offset − refOffset)`.
 * `refOffset` defaults to the first zone's offset.
 *
 * Drawn for the figure panel: a 460-unit viewBox, text at 12 and 13 units,
 * names placed by a collision pass (beside the dot, on the side that keeps
 * day words on paper and night words on the plate); on a phone it keeps its
 * 460px and scrolls inside its card. The cue numerals are an HTML layer.
 *
 * Cue anchors:
 *   band    the horizon, with SUN UP and SUN DOWN
 *   arc     the sun's curve
 *   ref     the reference city (its label on the curve, and the clock above)
 *   1…n     each city, in authored order (its glyph and its label)
 *
 * Build (src/scripts/build.ts, LENS §6.4): 1 the day and the night and the
 * hours, 2 the horizon fades and the day's curve draws, 3 the cities drop,
 * 4 their labels rise, 5 the clock. No JS or reduced motion: as drawn.
 *
 * data: { zones: [{city, offset}], refOffset? }   (offset = hours from UTC)
 */
interface Zone { city: string; offset: number; }
interface Props {
  zones: Zone[];
  refOffset?: number;
  caption?: string;
  source?: string;
}
const { zones = [], refOffset } = Astro.props;

const FF = "'Instrument Sans','Helvetica Neue',Arial,sans-serif";
const W = 460, H = 280;
const X0 = 22, X1 = 438, HZ = 150, TOP = 20, BOT = 250, A = 90;
const x = (h: number) => X0 + (h / 24) * (X1 - X0);
const y = (h: number) => HZ - A * -Math.cos((2 * Math.PI * h) / 24);

const data = zones.map((z, i) => ({ ...z, i })).filter((z) => z && z.city && Number.isFinite(z.offset));
const hasData = data.length > 0;
const ref = Number.isFinite(refOffset as number) ? (refOffset as number) : hasData ? data[0].offset : 0;
const refIdx = data.findIndex((z) => z.offset === ref);

const wrap24 = (h: number) => ((h % 24) + 24) % 24;
const hhmm = (h: number) => {
  let hh = Math.floor(h), mm = Math.round((h - hh) * 60);
  if (mm === 60) { hh += 1; mm = 0; }
  return `${String(hh % 24).padStart(2, '0')}:${String(mm).padStart(2, '0')}`;
};
const utc = (o: number) => {
  const a = Math.abs(o), hh = Math.floor(a), mm = Math.round((a - hh) * 60);
  return `UTC${o >= 0 ? '+' : '−'}${hh}${mm ? ':' + String(mm).padStart(2, '0') : ''}`;
};

let all = '', day = '';
for (let h = 0; h <= 24.001; h += 0.25) all += `${h ? 'L' : 'M'}${x(h).toFixed(1)} ${y(h).toFixed(1)}`;
for (let h = 6; h <= 18.001; h += 0.25) day += `${h > 6 ? 'L' : 'M'}${x(h).toFixed(1)} ${y(h).toFixed(1)}`;

/* ── labels: a collision pass ──────────────────────────────────────────── */
type Box = { l: number; r: number; t: number; b: number };
const hit = (a: Box, b: Box) => a.l < b.r && a.r > b.l && a.t < b.b && a.b > b.t;
const CW13 = 7.4, CW12 = 6.7;
const placed: Box[] = [
  { l: X1 - 92, r: X1, t: 26, b: 42 },            // SUN UP
  { l: X1 - 104, r: X1, t: HZ + 10, b: HZ + 26 }, // SUN DOWN
];
const cities = data
  .map((z) => {
    const lh = wrap24(12 + (z.offset - ref));
    return { ...z, lh, px: x(lh), py: y(lh), isDay: lh >= 6 && lh < 18, isRef: z.i === (refIdx >= 0 ? data[refIdx].i : -1) };
  })
  // the reference first, then the rest by hour, so the key label gets its place
  .sort((a, b) => Number(b.isRef) - Number(a.isRef) || a.lh - b.lh);
for (const c of cities) placed.push({ l: c.px - 8, r: c.px + 8, t: c.py - 8, b: c.py + 8 });

type Lab = { lines: { t: string; sub?: string }[]; x: number; y: number; anchor: 'start' | 'end' | 'middle' };
const labels = new Map<number, Lab>();
for (const c of cities) {
  const head = `${c.city} ${hhmm(c.lh)}`;
  const off = utc(c.offset);
  const oneW = head.length * CW13 + (off.length + 3) * CW12;
  const headW = head.length * CW13;
  const twoW = Math.max(headW, off.length * CW12);
  const zoneOk = (b: Box) => (c.isDay ? b.b <= HZ - 3 && b.t >= TOP + 2 : b.t >= HZ + 3 && b.b <= BOT - 2);
  const cands: (Lab & { box: Box })[] = [];
  const one = (lx: number, ly: number, anchor: Lab['anchor']): Lab & { box: Box } => {
    const l = anchor === 'start' ? lx : anchor === 'end' ? lx - oneW : lx - oneW / 2;
    return { lines: [{ t: head, sub: off }], x: lx, y: ly, anchor, box: { l, r: l + oneW, t: ly - 11, b: ly + 4 } };
  };
  const two = (lx: number, ly: number, anchor: Lab['anchor']): Lab & { box: Box } => {
    const l = anchor === 'start' ? lx : anchor === 'end' ? lx - twoW : lx - twoW / 2;
    return { lines: [{ t: head }, { t: off }], x: lx, y: ly, anchor, box: { l, r: l + twoW, t: ly - 11, b: ly + 18 } };
  };
  if (c.isRef) cands.push(one(c.px, c.py - 16, 'middle'), one(c.px, c.py + 26, 'middle'));
  for (const dy of [0, -16, 16, -32, 32]) {
    cands.push(
      one(c.px + 12, c.py + 5 + dy, 'start'), one(c.px - 12, c.py + 5 + dy, 'end'),
      two(c.px - 12, c.py - 2 + dy, 'end'), two(c.px + 12, c.py - 2 + dy, 'start'),
    );
  }
  const ok = cands.find((k) => k.box.l >= X0 + 2 && k.box.r <= X1 - 2 && zoneOk(k.box) && !placed.some((p) => hit(p, k.box)))
    ?? cands.find((k) => k.box.l >= X0 + 2 && k.box.r <= X1 - 2 && zoneOk(k.box))
    ?? cands[0];
  placed.push(ok.box);
  labels.set(c.i, ok);
}

const refCity = refIdx >= 0 ? data[refIdx] : undefined;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const clampX = (v: number) => Math.min(W - 12, Math.max(12, v));
const clampY = (v: number) => Math.min(H - 12, Math.max(12, v));
const tagPos: { id: string; x: number; y: number }[] = [
  { id: 'band', x: X1 - 10, y: HZ },
  { id: 'arc', x: clampX(x(15.5)), y: clampY(y(15.5) - 16) },
];
{
  const OFF: [number, number][] = [[-15, -15], [15, -15], [-15, 15], [15, 15], [0, -20], [0, 20], [-20, 0], [20, 0]];
  for (const c of cities) {
    const at = OFF.map(([dx, dy]) => ({ x: clampX(c.px + dx), y: clampY(c.py + dy) }))
      .map((k) => ({ ...k, box: { l: k.x - 11, r: k.x + 11, t: k.y - 11, b: k.y + 11 } }));
    const ok = at.find((k) => !placed.some((q) => hit(q, k.box))) ?? at[0];
    placed.push(ok.box);
    tagPos.push({ id: String(c.i + 1), x: ok.x, y: ok.y });
  }
}
---

{hasData ? (
  <div class="px-tzarc" data-viz-root data-build-scene>
    <div class="px-tzarc__head" data-cue="ref">
      <b class="px-tzarc__n" data-build="5" data-build-kind="rise">12:00</b>
      <span class="px-tzarc__u">{refCity ? `in ${refCity.city}` : `at ${utc(ref)}`}<span class="px-cue-tag" data-cue-tag="ref" hidden></span></span>
    </div>

    <div class="px-tzarc__stage">
      <svg
        class="px-tzarc__plot"
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={`Local time in ${data.length} cities when it is noon ${refCity ? 'in ' + refCity.city : 'at ' + utc(ref)}: ${cities.map((c) => `${c.city} ${hhmm(c.lh)}`).join(', ')}`}
        style={`font-family:${FF}`}
      >
        <g data-build="1">
          <rect x={X0} y={TOP} width={X1 - X0} height={HZ - TOP} fill="var(--paper)" stroke="var(--hair)" />
          <rect x={X0} y={HZ} width={X1 - X0} height={BOT - HZ} fill="var(--deep)" />
          {[0, 6, 12, 18, 24].map((h) => (
            <g>
              <line x1={x(h)} x2={x(h)} y1={BOT} y2={BOT + 6} stroke="var(--hair-2)" />
              <text x={x(h)} y={BOT + 22} text-anchor={h === 0 ? 'start' : h === 24 ? 'end' : 'middle'} font-size="12" fill="var(--muted)">{String(h).padStart(2, '0')}:00</text>
            </g>
          ))}
        </g>
        <path d={all} fill="none" stroke="var(--on-deep-hair)" stroke-width="1.5" stroke-dasharray="4 4" data-build="2" />
        <g data-cue="band" data-build="2">
          <line x1={X0} x2={X1} y1={HZ} y2={HZ} stroke="var(--accent)" stroke-width="1.5" />
          <text x={X1 - 26} y="38" text-anchor="end" font-size="12" font-weight="600" letter-spacing="0.72" fill="var(--accent-deep)">SUN UP</text>
          <text x={X1 - 26} y={HZ + 22} text-anchor="end" font-size="12" font-weight="600" letter-spacing="0.72" fill="var(--on-deep-2)">SUN DOWN</text>
        </g>
        <path d={day} fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" data-cue="arc" data-build="2" data-build-kind="draw" />

        {cities.map((c) => {
          const lab = labels.get(c.i)!;
          const ink = c.isDay ? 'var(--ink)' : 'var(--on-deep)';
          const ink2 = c.isDay ? 'var(--ink-2)' : 'var(--on-deep-2)';
          return (
            <g data-cue={c.i + 1}>
              <g data-build="3" data-build-kind="drop">
                {c.isDay ? (
                  <circle cx={c.px.toFixed(1)} cy={c.py.toFixed(1)} r="7" fill="var(--accent)" stroke="var(--paper-2)" stroke-width="2" />
                ) : (
                  <g>
                    <circle cx={c.px.toFixed(1)} cy={c.py.toFixed(1)} r="6.5" fill="var(--on-deep)" />
                    <circle cx={(c.px + 3.5).toFixed(1)} cy={(c.py - 2.5).toFixed(1)} r="5.5" fill="var(--deep)" />
                  </g>
                )}
              </g>
              <g data-cue={c.isRef ? 'ref' : undefined}>
                <text x={lab.x.toFixed(1)} y={lab.y.toFixed(1)} text-anchor={lab.anchor} font-size="13" font-weight="600" fill={ink} data-build="4" data-build-kind="rise">
                  {lab.lines[0].t}{lab.lines[0].sub && <tspan font-size="12" font-weight="400" fill={ink2}> · {lab.lines[0].sub}</tspan>}
                  {lab.lines[1] && <tspan x={lab.x.toFixed(1)} dy="15" font-size="12" font-weight="400" fill={ink2}>{lab.lines[1].t}</tspan>}
                </text>
              </g>
            </g>
          );
        })}
      </svg>

      <div class="px-tzarc__tags" aria-hidden="true" data-build="4">
        {tagPos.map((t) => (
          <span class="px-tzarc__tag" data-cue={t.id} style={`left:${pct(t.x, W)};top:${pct(t.y, H)}`}>
            <span class="px-cue-tag" data-cue-tag={t.id} hidden></span>
          </span>
        ))}
      </div>
    </div>
  </div>
) : (
  <p class="px-tzarc__empty">No time zones.</p>
)}

<style>
  .px-tzarc { font-family: var(--font-ui); }
  /* the ONE headline number at 96 (72 on phones), its label 8px below it
     (LENS §7) */
  .px-tzarc__head { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 16px; }
  .px-tzarc__n {
    font-weight: 600; font-size: 96px; line-height: 0.92; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--accent-deep);
  }
  .px-tzarc__u {
    display: inline-flex; align-items: center; gap: 8px; padding-bottom: 0;
    font-size: 14px; line-height: 1.3; font-weight: 500; color: var(--ink-2);
  }
  .px-tzarc__u .px-cue-tag { margin: 0; }
  @media (max-width: 640px) { .px-tzarc__n { font-size: 72px; } }
  .px-tzarc__stage { position: relative; min-width: 460px; }
  .px-tzarc__plot { display: block; width: 100%; height: auto; overflow: visible; }
  .px-tzarc__tags { position: absolute; inset: 0; pointer-events: none; }
  .px-tzarc__tag { position: absolute; translate: -50% -50%; line-height: 0; }
  .px-tzarc__tag .px-cue-tag { margin: 0; box-shadow: 0 0 0 2px var(--paper-2); }
  .px-tzarc__tag[data-cue] { outline: none !important; }
  .px-tzarc__empty { font-size: 13px; color: var(--muted); text-align: center; padding: 28px 0; }
</style>
