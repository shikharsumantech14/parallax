---
/**
 * AltitudeOxygen (`altitude-oxygen`) — the air thinning on the way up (Lens
 * Phase 6, the Lib-altitude-oxygen board). The oxygen left at the highest
 * stop set large; under it a column of air, as wide at each height as the
 * effective oxygen the air still carries there (21% at sea level, drawn as
 * the full width), narrowing as it climbs. Each stop is a rule across the
 * column at its height, with a leader to its name and its `{elevation} m ·
 * {oxygen}%` in a column at the right; each night spent there is a small
 * tent to the left of the rule.
 *
 * The oxygen is MODELLED (the barometric formula, geodesy §7: the lapse-rate
 * atmosphere by default, isothermal on request), so a `model:` chip always
 * prints under the column. A stop's `note` is its hover title and its
 * screen-reader text, not a label on the figure (LENS §5.5).
 *
 * Drawn for the figure panel: a 460-unit viewBox, text at 12 and 13 units;
 * on a phone it keeps 460px and scrolls inside its card. The cue numerals
 * are an HTML layer over the drawing.
 *
 * Cue anchors:
 *   column  the air column
 *   1…n     each stop, in authored order (its rule, leader and label)
 *   nights  the tents
 *   peak    the highest stop's oxygen, the number above
 *   axis    the height axis and the sea-level line
 *
 * Build (src/scripts/build.ts, LENS §6.4): 1 the axis, 2 the column grows up
 * from sea level, 3 the stop rules and tents drop, 4 the labels rise, 5 the
 * number counts up. No JS or reduced motion: the plate as drawn.
 *
 * data: { stops: [{name, elevM, nights?, note?}], maxElevM?, model?, seaLevelO2Pct? }
 */
interface Stop { name: string; elevM: number; nights?: number; note?: string; }
interface Props {
  stops: Stop[];
  maxElevM?: number;
  model?: 'lapse' | 'isothermal';
  seaLevelO2Pct?: number;
  caption?: string;
  source?: string;
}
const { stops = [], model = 'lapse', seaLevelO2Pct = 21 } = Astro.props;

// ── data guard (2–8 stops; blueprint §3) ────────────────────────────────────
if (stops.length < 2 || stops.length > 8) {
  throw new Error(`altitude-oxygen: needs 2–8 stops (got ${stops.length}). See the blueprint's 2–8 rule.`);
}

// ── barometric model (geodesy §7) ───────────────────────────────────────────
const T0 = 288, LAPSE = 6.5, EXP = 5.256, HS = 8.4;
function o2At(elevM: number): number {
  const h = elevM / 1000;
  const ratio = model === 'isothermal' ? Math.exp(-h / HS) : Math.pow((T0 - LAPSE * h) / T0, EXP);
  return seaLevelO2Pct * ratio;
}

const maxStop = Math.max(...stops.map((s) => s.elevM));
const maxElevM = Astro.props.maxElevM ?? Math.ceil(maxStop / 500) * 500 + 500;

// ── geometry ────────────────────────────────────────────────────────────────
const FF = "'Literata',Georgia,serif";
const W = 460, H = 330;
const PT = 26, PB = 290;              // plot top / sea level
const AX = 44;                        // the axis rule's x
const CX = 150, HW = 80;              // column centre and half-width at sea level
const LX = 258;                       // the label column
const y = (e: number) => PB - (e / maxElevM) * (PB - PT);
const hw = (e: number) => HW * (o2At(e) / seaLevelO2Pct);

let left = '', right = '';
const STEP = Math.max(50, Math.round(maxElevM / 60 / 50) * 50);
for (let e = 0; e <= maxElevM + 1e-9; e += STEP) left += `${e ? 'L' : 'M'}${(CX - hw(e)).toFixed(1)} ${y(e).toFixed(1)}`;
for (let e = Math.floor(maxElevM / STEP) * STEP; e >= 0; e -= STEP) right += `L${(CX + hw(e)).toFixed(1)} ${y(e).toFixed(1)}`;
const column = `${left}${right}Z`;

const tickStep = maxElevM > 6000 ? 2000 : 1000;
const ticks: number[] = [];
for (let e = 0; e <= maxElevM + 1e-9; e += tickStep) ticks.push(e);

const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
const fmtO2 = (v: number) => v.toFixed(1);

// ── labels in the right column: blocks of two lines, never on each other ────
const NAME_CH = Math.floor((W - LX - 4) / 7.4);
const cut = (s: string) => (s.length > NAME_CH ? s.slice(0, NAME_CH - 1).trimEnd() + '…' : s);
const BLOCK = 30, GAP = 8;
type M = Stop & { i: number; o2: number; sy: number; top: number };
const marks: M[] = stops
  .map((s, i) => ({ ...s, i, o2: o2At(s.elevM), sy: y(s.elevM), top: 0 }))
  .sort((a, b) => a.sy - b.sy);
{
  type C = { items: M[]; top: number; h: number };
  const COL_T = 2, COL_B = PB + 8;
  const fit = (c: C) => {
    c.h = c.items.length * BLOCK + (c.items.length - 1) * GAP;
    let sum = 0;
    c.items.forEach((m, k) => { sum += m.sy - 10 - k * (BLOCK + GAP); });
    c.top = Math.min(Math.max(sum / c.items.length, COL_T), COL_B - c.h);
  };
  let cl: C[] = marks.map((m) => { const c = { items: [m], top: 0, h: 0 }; fit(c); return c; });
  for (let again = true; again;) {
    again = false;
    for (let k = 0; k < cl.length - 1; k++) {
      if (cl[k].top + cl[k].h + GAP > cl[k + 1].top) {
        const c = { items: [...cl[k].items, ...cl[k + 1].items], top: 0, h: 0 };
        fit(c);
        cl.splice(k, 2, c);
        again = true;
        break;
      }
    }
  }
  for (const c of cl) c.items.forEach((m, k) => { m.top = c.top + k * (BLOCK + GAP); });
}
const top = marks[0];   // the highest stop

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const tentsFor = (m: M) => {
  const n = Math.max(0, Math.round(m.nights ?? 0));
  const room = Math.max(0, Math.floor((CX - hw(m.elevM) - AX - 8) / 15));
  return { draw: Math.min(n, room), more: n > room ? n : 0 };
};
const anyNights = marks.some((m) => (m.nights ?? 0) >= 1);
const firstTent = marks.find((m) => (m.nights ?? 0) >= 1);
const tagPos: { id: string; x: number; y: number }[] = [
  { id: 'column', x: CX, y: y(maxElevM * 0.14) },
  { id: 'axis', x: 16, y: PT },
  ...marks.map((m) => ({ id: String(m.i + 1), x: Math.min(W - 12, LX + cut(m.name).length * 7.4 + 14), y: m.top + 6 })),
  ...(firstTent ? [{ id: 'nights', x: Math.max(AX + 12, CX - hw(firstTent.elevM) - 12 - tentsFor(firstTent).draw * 15), y: firstTent.sy - 6 }] : []),
];
---

<div class="px-altox" data-viz-root data-build-scene>
  <div class="px-altox__head" data-cue="peak">
    <b class="px-altox__n" data-build="5" data-build-kind="counter" data-to={fmtO2(top.o2)} data-format="1dp">{fmtO2(top.o2)}%</b>
    <span class="px-altox__u">at {top.name}<span class="px-cue-tag" data-cue-tag="peak" hidden></span></span>
  </div>

  <div class="px-altox__stage">
    <svg
      class="px-altox__plot"
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={`Effective oxygen by altitude: ${marks.map((m) => `${m.name} ${fmt(m.elevM)} m, ${fmtO2(m.o2)}%`).join('; ')}`}
      style={`font-family:${FF}`}
    >
      <g data-cue="axis" data-build="1">
        <text x={AX - 6} y={PT - 12} text-anchor="end" font-size="12" fill="var(--muted)">metres</text>
        {ticks.map((e) => (
          <g>
            <line x1={AX} x2={W} y1={y(e).toFixed(1)} y2={y(e).toFixed(1)} stroke={e === 0 ? 'var(--hair-2)' : 'var(--hair)'} stroke-width="1" />
            <text x={AX - 6} y={(y(e) + 4).toFixed(1)} text-anchor="end" font-size="12" fill="var(--muted)">{fmt(e)}</text>
          </g>
        ))}
        <text x={CX} y={PB + 22} text-anchor="middle" font-size="12" font-weight="600" fill="var(--ink-2)">Sea level · {seaLevelO2Pct}%</text>
      </g>

      <path d={column} fill="var(--accent-tint)" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round"
        data-cue="column" data-build="2" data-build-kind="grow-y" />

      {marks.map((m) => {
        const w = hw(m.elevM);
        const ly = m.top + 11;
        return (
          <g data-cue={m.i + 1}>
            <title>{m.name} · {fmt(m.elevM)} m · {fmtO2(m.o2)}% effective oxygen{m.nights ? ` · ${m.nights} night${m.nights === 1 ? '' : 's'}` : ''}{m.note ? ` · ${m.note}` : ''}</title>
            <line x1={(CX - w).toFixed(1)} x2={(CX + w).toFixed(1)} y1={m.sy.toFixed(1)} y2={m.sy.toFixed(1)} stroke="var(--ink)" stroke-width="1.5" data-build="3" data-build-kind="drop" />
            <path d={`M${(CX + w + 4).toFixed(1)} ${m.sy.toFixed(1)}L${LX - 22} ${m.sy.toFixed(1)}L${LX - 8} ${(ly - 4).toFixed(1)}`}
              fill="none" stroke="var(--ink-2)" stroke-width="1" data-build="4" />
            <text x={LX} y={ly.toFixed(1)} font-size="13" font-weight="600" fill="var(--ink)" data-build="4" data-build-kind="rise">
              {cut(m.name)}
              <tspan x={LX} dy="15" font-size="12" font-weight="400" fill="var(--ink-2)">{fmt(m.elevM)} m · {fmtO2(m.o2)}%</tspan>
            </text>
          </g>
        );
      })}

      {anyNights && (
        <g data-cue="nights" data-build="3" data-build-kind="drop">
          {marks.map((m) => {
            const t = tentsFor(m);
            const w = hw(m.elevM);
            return (
              <g>
                {Array.from({ length: t.draw }, (_, k) => {
                  const tx = CX - w - 12 - k * 15;
                  return <path d={`M${(tx - 6).toFixed(1)} ${(m.sy - 1).toFixed(1)}L${tx.toFixed(1)} ${(m.sy - 11).toFixed(1)}L${(tx + 6).toFixed(1)} ${(m.sy - 1).toFixed(1)}Z`} fill="var(--accent-deep)" />;
                })}
                {t.more > 0 && (
                  <text x={(CX - w - 8 - t.draw * 15).toFixed(1)} y={(m.sy - 2).toFixed(1)} text-anchor="end" font-size="12" font-weight="600" fill="var(--accent-deep)">×{t.more}</text>
                )}
              </g>
            );
          })}
        </g>
      )}
    </svg>

    <div class="px-altox__tags" aria-hidden="true" data-build="4">
      {tagPos.map((t) => (
        <span class="px-altox__tag" data-cue={t.id} style={`left:${pct(t.x, W)};top:${pct(t.y, H)}`}>
          <span class="px-cue-tag" data-cue-tag={t.id} hidden></span>
        </span>
      ))}
    </div>
  </div>

  <div class="px-altox__foot" data-build="4">
    {anyNights ? (
      <span class="px-altox__key"><svg viewBox="0 0 14 12" width="14" height="12" aria-hidden="true"><path d="M1 11L7 1L13 11Z" fill="var(--accent-deep)" /></svg>one night acclimatizing</span>
    ) : <span></span>}
    <span class="px-altox__chip">model: {model}</span>
  </div>
</div>

<style>
  .px-altox { font-family: var(--font-ui); }
  /* the ONE headline number at 96 (72 on phones), its label 8px below it
     (LENS §7) */
  .px-altox__head { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 16px; }
  .px-altox__n {
    font-weight: 700; font-size: 96px; line-height: 1; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--accent-deep);
    padding-bottom: 0.12em;
  }
  .px-altox__u {
    display: inline-flex; align-items: center; gap: 8px; padding-bottom: 0;
    font-size: 12px; line-height: 1.35; font-weight: 600; color: var(--ink-2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .px-altox__u .px-cue-tag { margin: 0; }
  @media (max-width: 640px) { .px-altox__n { font-size: 72px; } }
  .px-altox__stage { position: relative; min-width: 460px; }
  .px-altox__plot { display: block; width: 100%; height: auto; overflow: visible; }
  .px-altox__tags { position: absolute; inset: 0; pointer-events: none; }
  .px-altox__tag { position: absolute; translate: -50% -50%; line-height: 0; }
  .px-altox__tag .px-cue-tag { margin: 0; }
  .px-altox__tag[data-cue] { outline: none !important; }
  .px-altox__foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px;
    margin-top: 12px; min-width: 0;
  }
  .px-altox__key { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; line-height: 1.3; color: var(--ink-2); }
  .px-altox__chip {
    display: inline-flex; align-items: center; height: 28px; padding: 0 12px; border-radius: 999px;
    background: var(--paper-3); color: var(--ink-2); font-size: 12px; font-weight: 500;
  }
</style>
