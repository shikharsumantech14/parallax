---
/*
  CityCompare — v2 head-to-head comparison (.cc) inside the elevated .px-viz
  card. Two city columns flank a centred metric label; the winning side glows
  via data-win. Rows fade + rise on a stagger as the card reveals on scroll.
  Faithful port of publication-v2 DataViz <CityCompare>. Build-time, zero JS.

  Use for: cost-of-living, travel planning, demographic
  comparisons, infrastructure snapshots.

  props:
    cityA      — { name: string, subtitle?: string }
    cityB      — { name: string, subtitle?: string }
    rows[]     — { label: string, a: string, b: string,
                   winner?: 'a' | 'b' | 'tie', note?: string }
                 note renders as a full-width italic line under its row.

    `flag` was declared here and never rendered. Struck 2026-09-15: the
    authored values were emoji, and the publication carries no raster or
    emoji imagery (root AGENTS.md §5 — type- and data-viz-led). A city is
    identified by its name and subtitle.
    caption
    source
*/
interface City  { name: string; subtitle?: string; }
interface Row   { label: string; a: string; b: string; winner?: 'a' | 'b' | 'tie'; note?: string; }
interface Props {
  cityA: City;
  cityB: City;
  rows: Row[];
  caption?: string;
  source?: string;
}
const { cityA, cityB, rows = [], caption, source } = Astro.props;
---

<div class="px-viz" data-reveal>
  {caption && <div class="px-viz__cap"><span>{caption}</span></div>}

  <div class="cc__head">
    <div class="cc__city">
      <span class="cc__city-name">{cityA.name}</span>
      {cityA.subtitle && <span class="cc__city-sub">{cityA.subtitle}</span>}
    </div>
    <span class="cc__vs">vs</span>
    <div class="cc__city cc__city--b">
      <span class="cc__city-name">{cityB.name}</span>
      {cityB.subtitle && <span class="cc__city-sub">{cityB.subtitle}</span>}
    </div>
  </div>

  {rows.map((r, i) => (
    <div class="cc__row" style={`transition-delay:${i * 50}ms`}>
      <span class="cc__a" data-win={r.winner === 'a' ? 'true' : 'false'}>{r.a}</span>
      <span class="cc__metric">{r.label}</span>
      <span class="cc__b" data-win={r.winner === 'b' ? 'true' : 'false'}>{r.b}</span>
      {r.note && <span class="cc__note">{r.note}</span>}
    </div>
  ))}

</div>
