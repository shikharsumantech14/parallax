---
/**
 * ClimateCalendar (`climate-calendar`) — a place's year as a ribbon of twelve
 * months (Lens Phase 6, the Lib-climate-calendar board). The wettest month
 * set large; under it one column a month: the month's name, a temperature
 * cell tinted from the paper (the coolest month) through the desk tint and
 * mark to the desk text colour (the warmest), with its value, and a rainfall
 * bar hanging below with its millimetres. A month's `note` is marked with an
 * asterisk on its name and printed as a footnote under the ribbon (a column
 * is far too narrow for it). A key closes it.
 *
 * HTML, drawn for the 472 panel (a column about 37px); on a phone the ribbon
 * keeps 440px and scrolls inside its card rather than shrinking its numbers.
 * The tint is a data encoding (cool to warm), built from the desk inks.
 *
 * Cue anchors:
 *   1…12    each month, in authored order (its name, its cell, its bar)
 *   temp    the temperature row
 *   rain    the rainfall row
 *   peak    the wettest month's number above the ribbon
 *   legend  the key
 *
 * Build (src/scripts/build.ts, LENS §6.4): 1 the month names, 2 the
 * temperature cells drop left to right, 3 the rain bars grow down, 4 the
 * rain values, the footnote and the key, 5 the number counts up. No JS or
 * reduced motion: the ribbon as drawn.
 *
 * data: { months: [{month, temp?, rainfall?, note?}], tempUnit? }
 */
interface Month { month: string; temp?: number; rainfall?: number; note?: string; }
interface Props {
  months: Month[];
  tempUnit?: string;
  caption?: string;
  source?: string;
}
const { months = [], tempUnit = '°C' } = Astro.props;

const data = months.filter((m) => m && m.month);
const hasData = data.length > 0;
const n = data.length || 1;
const isNum = (v: unknown): v is number => typeof v === 'number' && Number.isFinite(v);

const temps = data.map((m) => m.temp).filter(isNum);
const tMin = temps.length ? Math.min(...temps) : 0;
const tMax = temps.length ? Math.max(...temps) : 1;
const tSpan = tMax - tMin || 1;
const rains = data.map((m) => m.rainfall).filter(isNum);
const rMax = rains.length ? Math.max(...rains) : 0;

/* The cool-to-warm tint, from the desk inks: paper-3 → tint → mark → text. */
const STOPS: [number, string][] = [
  [0, 'var(--paper-3)'],
  [0.35, 'var(--accent-tint)'],
  [0.7, 'var(--accent)'],
  [1, 'var(--accent-deep)'],
];
function tint(t: number): { bg: string; dark: boolean } {
  const f = Math.max(0, Math.min(1, (t - tMin) / tSpan));
  for (let k = 0; k < STOPS.length - 1; k++) {
    const [a, ca] = STOPS[k], [b, cb] = STOPS[k + 1];
    if (f <= b) {
      const u = Math.round(((f - a) / (b - a)) * 100);
      return { bg: `color-mix(in oklab, ${cb} ${u}%, ${ca})`, dark: f >= 0.78 };
    }
  }
  return { bg: 'var(--accent-deep)', dark: true };
}

const fmtT = (t: number) => (Number.isInteger(t) ? `${t}` : t.toFixed(1));
const fmtR = (r: number) => Math.round(r).toLocaleString('en-US');
const mon3 = (m: string) => m.slice(0, 3);

const BAR = 96;                                   // the tallest bar, px
const cols = data.map((m, i) => {
  const t = isNum(m.temp) ? tint(m.temp) : null;
  return {
    m, i,
    t,
    bar: isNum(m.rainfall) && rMax > 0 ? Math.max(3, (m.rainfall / rMax) * BAR) : 0,
  };
});

// the headline: the wettest month, else the warmest
const wetIdx = rains.length ? data.findIndex((m) => m.rainfall === rMax) : -1;
const warmIdx = temps.length ? data.findIndex((m) => m.temp === tMax) : -1;
const head = wetIdx >= 0
  ? { idx: wetIdx, val: fmtR(rMax), to: Math.round(rMax), fmt: 'int', label: `mm, ${data[wetIdx].month} rain` }
  : warmIdx >= 0
    ? { idx: warmIdx, val: fmtT(tMax), to: tMax, fmt: Number.isInteger(tMax) ? 'int' : '1dp', label: `${tempUnit}, ${data[warmIdx].month}` }
    : null;

const noted = data.filter((m) => m.note);
---

{hasData ? (
  <div class="px-ccal" data-viz-root data-build-scene style={`--cols:${n}`}>
    {head && (
      <div class="px-ccal__head" data-cue="peak">
        <b class="px-ccal__n" data-build="5" data-build-kind="counter" data-to={head.to} data-format={head.fmt}>{head.val}</b>
        <span class="px-ccal__u">{head.label}<span class="px-cue-tag" data-cue-tag="peak" hidden></span></span>
      </div>
    )}

    <div class="px-ccal__rib" role="img" aria-label={`Monthly ${temps.length ? 'mean temperature' : ''}${temps.length && rains.length ? ' and ' : ''}${rains.length ? 'rainfall' : ''}, ${data[0].month} to ${data[data.length - 1].month}`}>
      <div class="px-ccal__row px-ccal__row--m">
        <span class="px-ccal__gut"></span>
        {cols.map((c) => (
          <span class="px-ccal__mon" data-cue={c.i + 1} data-note={c.m.note ? 'true' : undefined} data-build="1">
            <span class="px-cue-tag" data-cue-tag={c.i + 1} hidden></span>
            <span>{mon3(c.m.month)}{c.m.note && '*'}</span>
          </span>
        ))}
      </div>

      {temps.length > 0 && (
        <div class="px-ccal__row px-ccal__row--t" data-cue="temp">
          <span class="px-ccal__gut"><span class="px-cue-tag" data-cue-tag="temp" hidden></span></span>
          {cols.map((c) => (
            <span
              class="px-ccal__cell"
              data-cue={c.i + 1}
              data-dark={c.t?.dark ? 'true' : undefined}
              style={c.t ? `background:${c.t.bg}` : undefined}
              data-build="2"
              data-build-kind="drop"
            >{isNum(c.m.temp) ? fmtT(c.m.temp) : '–'}</span>
          ))}
        </div>
      )}

      {rains.length > 0 && (
        <div class="px-ccal__row px-ccal__row--r" data-cue="rain">
          <span class="px-ccal__gut"><span class="px-cue-tag" data-cue-tag="rain" hidden></span></span>
          {cols.map((c) => (
            <span class="px-ccal__rcol" data-cue={c.i + 1} data-hi={c.i === wetIdx ? 'true' : undefined}>
              <i class="px-ccal__bar" style={`height:${c.bar.toFixed(1)}px`} data-build="3" data-build-kind="grow-y"></i>
              <span class="px-ccal__rv" data-build="4">{isNum(c.m.rainfall) ? fmtR(c.m.rainfall) : '·'}</span>
            </span>
          ))}
        </div>
      )}
    </div>

    {noted.length > 0 && (
      <ul class="px-ccal__notes" data-build="4">
        {noted.map((m) => <li>* {mon3(m.month)}: {m.note}</li>)}
      </ul>
    )}

    <div class="px-ccal__legend" data-cue="legend" data-build="4">
      <span class="px-cue-tag" data-cue-tag="legend" hidden></span>
      {temps.length > 0 && (
        <span class="px-ccal__key">
          <span class="px-ccal__kv">{fmtT(tMin)} {tempUnit}</span>
          <i class="px-ccal__grad"></i>
          <span class="px-ccal__kv">{fmtT(tMax)} {tempUnit}</span>
          <span>mean temperature</span>
        </span>
      )}
      {rains.length > 0 && <span class="px-ccal__key"><i class="px-ccal__rk"></i>rainfall, mm</span>}
    </div>
  </div>
) : (
  <p class="px-ccal__empty">No climate data.</p>
)}

<style>
  .px-ccal { font-family: var(--font-ui); color: var(--ink); }
  /* the ONE headline number at 96 (72 on phones), its label 8px below it
     (LENS §7) */
  .px-ccal__head { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 18px; }
  .px-ccal__n {
    font-weight: 700; font-size: 96px; line-height: 1; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--accent-deep);
    padding-bottom: 0.12em;
  }
  .px-ccal__u {
    display: inline-flex; align-items: center; gap: 8px; padding-bottom: 0;
    font-size: 12px; line-height: 1.35; font-weight: 600; color: var(--ink-2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .px-ccal__u .px-cue-tag { margin: 0; }
  @media (max-width: 640px) { .px-ccal__n { font-size: 72px; } }

  /* the ribbon keeps a column of about 34px: on a phone it scrolls inside
     its card (the root is a card scroller below 900px) */
  .px-ccal__rib { min-width: 440px; }
  .px-ccal__row {
    display: grid;
    grid-template-columns: 26px repeat(var(--cols, 12), minmax(0, 1fr));
    column-gap: 3px;
  }
  .px-ccal__gut { display: flex; align-items: center; justify-content: flex-start; }
  .px-ccal__gut .px-cue-tag { margin: 0; }

  .px-ccal__row--m { margin-bottom: 8px; align-items: end; }
  .px-ccal__mon {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    font-size: 12px; line-height: 1.2; color: var(--muted); text-align: center;
  }
  .px-ccal__mon .px-cue-tag { margin: 0; }
  .px-ccal__mon[data-note] { color: var(--accent-deep); font-weight: 600; }

  .px-ccal__cell {
    display: flex; align-items: center; justify-content: center;
    height: 60px; border-radius: 3px; background: var(--paper-3);
    font-size: 13px; font-weight: 600; color: var(--ink);
    font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
  }
  .px-ccal__cell[data-dark] { color: var(--paper); }

  .px-ccal__row--r { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--hair-2); align-items: start; }
  .px-ccal__row--r .px-ccal__gut { align-items: flex-start; padding-top: 30px; }
  .px-ccal__rcol { display: flex; flex-direction: column; align-items: center; gap: 4px; min-height: 118px; }
  .px-ccal__bar {
    display: block; width: 58%; max-width: 22px; border-radius: 0 0 2px 2px;
    background: var(--ink-2); opacity: 0.72; transform-origin: 50% 0;
  }
  .px-ccal__rcol[data-hi] .px-ccal__bar { opacity: 1; }
  .px-ccal__rv { font-size: 12px; line-height: 1.2; color: var(--ink-2); font-variant-numeric: tabular-nums; }

  .px-ccal__notes {
    list-style: none; margin: 10px 0 0; padding: 0;
    font-size: 13px; line-height: 1.45; color: var(--ink-2);
  }
  .px-ccal__legend {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px;
    margin-top: 14px; font-size: 12px; line-height: 1.3; color: var(--ink-2);
  }
  .px-ccal__legend > .px-cue-tag { margin: 0; }
  .px-ccal__key { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .px-ccal__kv { color: var(--muted); font-variant-numeric: tabular-nums; }
  .px-ccal__grad {
    display: inline-block; width: 88px; height: 12px; border-radius: 2px;
    background: linear-gradient(90deg, var(--paper-3) 0%, var(--accent-tint) 35%, var(--accent) 70%, var(--accent-deep) 100%);
    box-shadow: inset 0 0 0 1px var(--hair);
  }
  .px-ccal__rk { display: inline-block; width: 12px; height: 16px; border-radius: 2px; background: var(--ink-2); opacity: 0.72; }
  .px-ccal__empty { font-size: 13px; color: var(--muted); text-align: center; padding: 28px 0; }
</style>
