---
/*
  Itinerary (`itinerary`) — a journey as ONE route of stops down a dashed
  rail (Lens Phase 6, the merged board: `Lib-route-card` retitled
  "itinerary (was route-card · itinerary-reel)"). Each row is a leg: its
  mode glyph on the rail, "From → To", its distance and time, and a box of
  the things done at that stop (the leg's note and up to three items). The
  legs shape ends on a filled dot at the last leg's destination. Above the
  rail, the count of legs set large; under it, a key of the modes used.
  HTML, fits the 472 panel and a phone without a scroll. Zero JS.

  The Lens verdict (2026-09-30, docs/design/LENS.md §9) renamed `route-card`
  to `itinerary` and folded `itinerary-reel` in. Both old names stay
  accepted as aliases (KIND_ALIASES in src/content/config.ts). A reel's
  `days: [{day, place, items?}]` render here as stops: each day is a row at
  its place, its day label where a leg's distance sits, its items in the box.
  An authored `legs` list wins when both are present. The old `.rc` card and
  the reel's rows-of-three markup are gone.

  Cue anchors:
    1…n     each leg (or day), in authored order: its row and its box
    end     the final destination (legs shape only)
    total   the count above the rail
    legend  the key of modes under the rail

  Build (src/scripts/build.ts, LENS §6.4): 1 the rail segments grow down,
  2 the stops drop in order, 3 the stop boxes fade in, 4 the key, 5 the
  count. No JS or reduced motion: the route as drawn.

  props:
    legs[]   — { from, to?, mode?, distance?, duration?, note?, day?, items?: [string] }
    days[]   — { day, place, items? }   (the folded itinerary-reel shape)
    title    — optional journey title (the figure's accessible name)
    caption  — accepted, not rendered: the article prints it
    source   — accepted, not rendered: core/Section.astro is the one source emitter
*/
interface Leg {
  from: string;
  to?: string;
  distance?: string;
  duration?: string;
  mode?: string;
  note?: string;
  day?: string | number;
  items?: string[];
}
interface Day { day: number | string; place: string; items?: string[]; }
interface Props {
  legs?: Leg[];
  days?: Day[];
  title?: string;
  caption?: string;
  source?: string;
}
const { legs: authoredLegs = [], days = [], title } = Astro.props;

const fmtDay = (d: number | string) =>
  typeof d === 'number' ? `Day ${d}` : /^\d+$/.test(String(d)) ? `Day ${d}` : String(d);

// Days become stops: one row per day, at its place, carrying its items.
const dayLegs: Leg[] = (days ?? [])
  .filter((d) => d && d.place)
  .map((d) => ({ from: d.place, day: fmtDay(d.day), items: d.items }));

const legs: Leg[] = authoredLegs.length > 0 ? authoredLegs : dayLegs;
const fromDays = authoredLegs.length === 0 && dayLegs.length > 0;

// Glyph keyed off the leg mode (lowercased); a leg with no mode is a stop.
type Glyph = 'train' | 'drive' | 'ferry' | 'fly' | 'walk' | 'stop';
const glyphFor = (mode?: string): Glyph => {
  if (!mode) return 'stop';
  const m = mode.toLowerCase();
  if (m === 'train' || m === 'rail') return 'train';
  if (m === 'drive' || m === 'car' || m === 'bus' || m === 'road') return 'drive';
  if (m === 'ferry' || m === 'ship' || m === 'boat') return 'ferry';
  if (m === 'walk' || m === 'foot' || m === 'trek' || m === 'hike') return 'walk';
  return 'fly';
};
const NAMES: Record<Glyph, string> = { train: 'Train', drive: 'Road', ferry: 'Ferry', fly: 'Flight', walk: 'On foot', stop: 'Stop' };

const rows = legs.map((leg, i) => {
  const glyph = glyphFor(leg.mode);
  // The box: the leg's note, then its items. Up to three items is an
  // authoring cap (the catalog), not a render cap: nothing authored drops.
  const lines = [...(leg.note ? [leg.note] : []), ...(leg.items ?? [])];
  const meta = fromDays
    ? [leg.day !== undefined ? fmtDay(leg.day) : ''].filter(Boolean)
    : [leg.distance, leg.duration].filter(Boolean) as string[];
  const kicker = !fromDays && leg.day !== undefined ? fmtDay(leg.day) : undefined;
  return { leg, i, glyph, lines, meta, kicker };
});

const modes = [...new Set(rows.map((r) => r.glyph))];
const noFlights = !fromDays && legs.length > 0 && legs.every((l) => l.mode) && !modes.includes('fly');
const countLabel = fromDays
  ? (legs.length === 1 ? 'day' : 'days')
  : `${legs.length === 1 ? 'leg' : 'legs'}${noFlights ? ', no flights' : ''}`;
const endPlace = !fromDays && legs.length ? legs[legs.length - 1].to : undefined;
const hasBoxes = rows.some((r) => r.lines.length > 0);
const label = title ? title.replace(/\s+/g, ' ') : `Itinerary of ${legs.length} ${fromDays ? 'days' : 'legs'}`;
---

<div class="px-itin" data-viz-root data-build-scene role="figure" aria-label={label}>
  <div class="px-itin__tot" data-cue="total">
    <b class="px-itin__n" data-build="5" data-build-kind="counter" data-to={legs.length}>{legs.length}</b>
    <span class="px-itin__u">{countLabel}<span class="px-cue-tag" data-cue-tag="total" hidden></span></span>
  </div>

  <ol class="px-itin__legs">
    {rows.map((r, k) => (
      <li class="px-itin__leg" data-cue={r.i + 1}>
        <span class="px-itin__rail" aria-hidden="true">
          {(k < rows.length - 1 || endPlace) && (
            <span class="px-itin__seg" data-first={k === 0 ? 'true' : undefined} data-build="1" data-build-kind="grow-y"></span>
          )}
          <span class="px-itin__node" data-g={r.glyph} data-build="2" data-build-kind="drop">
            {r.glyph === 'train' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3" width="12" height="13" rx="2" /><line x1="6" y1="10" x2="18" y2="10" /><circle cx="9" cy="13" r="0.9" /><circle cx="15" cy="13" r="0.9" /><line x1="8.5" y1="16" x2="6.5" y2="20" /><line x1="15.5" y1="16" x2="17.5" y2="20" /></svg>
            )}
            {r.glyph === 'drive' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13l1.5-5h13L20 13" /><rect x="3" y="13" width="18" height="5" rx="1.5" /><circle cx="7" cy="18" r="1.6" /><circle cx="17" cy="18" r="1.6" /></svg>
            )}
            {r.glyph === 'ferry' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16l1-5h14l1 5" /><path d="M3 19c1.5 1.2 3 1.2 4.5 0s3-1.2 4.5 0 3 1.2 4.5 0 3-1.2 4.5 0" /><path d="M9 11V7h6v4" /><line x1="12" y1="4" x2="12" y2="7" /></svg>
            )}
            {r.glyph === 'fly' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 16l20-7-9 11-2-5-9 1z" /></svg>
            )}
            {r.glyph === 'walk' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="13" cy="4.5" r="1.8" /><path d="M11 21l2-6-3-3 1-4 3 3 3 1" /><path d="M10 12l-3 3" /></svg>
            )}
            {r.glyph === 'stop' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-5.6-6-10.5a6 6 0 0 1 12 0C18 15.4 12 21 12 21z" /><circle cx="12" cy="10.5" r="2" /></svg>
            )}
          </span>
        </span>
        <div class="px-itin__body">
          <div class="px-itin__head" data-build="2" data-build-kind="drop">
            <span class="px-itin__cities">
              <span class="px-cue-tag" data-cue-tag={r.i + 1} hidden></span>
              {r.kicker && <span class="px-itin__kick">{r.kicker}</span>}
              {r.leg.from}{r.leg.to && <><span class="px-itin__arr" aria-label="to"> → </span>{r.leg.to}</>}
            </span>
            {r.meta.length > 0 && <span class="px-itin__meta">{r.meta.join(' · ')}</span>}
          </div>
          {r.lines.length > 0 && (
            <ul class="px-itin__box" data-build="3">
              {r.lines.map((t) => <li class="px-itin__item">{t}</li>)}
            </ul>
          )}
        </div>
      </li>
    ))}
    {endPlace && (
      <li class="px-itin__leg px-itin__leg--end" data-cue="end">
        <span class="px-itin__rail" aria-hidden="true">
          <span class="px-itin__dot" data-build="2" data-build-kind="drop"></span>
        </span>
        <div class="px-itin__body">
          <div class="px-itin__head" data-build="2" data-build-kind="drop">
            <span class="px-itin__cities"><span class="px-cue-tag" data-cue-tag="end" hidden></span>{endPlace}</span>
          </div>
        </div>
      </li>
    )}
  </ol>

  <div class="px-itin__legend" data-cue="legend" data-build="4">
    <span class="px-cue-tag" data-cue-tag="legend" hidden></span>
    {modes.map((g) => (
      <span class="px-itin__key">
        <span class="px-itin__kg" data-g={g}>
          {g === 'train' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3" width="12" height="13" rx="2" /><line x1="6" y1="10" x2="18" y2="10" /><line x1="8.5" y1="16" x2="6.5" y2="20" /><line x1="15.5" y1="16" x2="17.5" y2="20" /></svg>}
          {g === 'drive' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13l1.5-5h13L20 13" /><rect x="3" y="13" width="18" height="5" rx="1.5" /></svg>}
          {g === 'ferry' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16l1-5h14l1 5" /><path d="M3 19c1.5 1.2 3 1.2 4.5 0s3-1.2 4.5 0 3 1.2 4.5 0 3-1.2 4.5 0" /></svg>}
          {g === 'fly' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 16l20-7-9 11-2-5-9 1z" /></svg>}
          {g === 'walk' && <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="13" cy="4.5" r="1.8" /><path d="M11 21l2-6-3-3 1-4 3 3 3 1" /></svg>}
          {g === 'stop' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-5.6-6-10.5a6 6 0 0 1 12 0C18 15.4 12 21 12 21z" /></svg>}
        </span>
        {NAMES[g]}
      </span>
    ))}
    {hasBoxes && <span class="px-itin__key"><i class="px-itin__kbox"></i>Stop items</span>}
  </div>
</div>

<style>
  .px-itin { font-family: var(--font-ui); color: var(--ink); }

  /* the ONE headline number at 96 (72 on phones), its label 8px below it
     (LENS §7) */
  .px-itin__tot { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 20px; }
  .px-itin__n {
    font-weight: 600; font-size: 96px; line-height: 0.92; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--accent-deep);
  }
  .px-itin__u {
    display: inline-flex; align-items: center; gap: 8px; padding-bottom: 0;
    font-size: 14px; line-height: 1.3; font-weight: 500; color: var(--ink-2);
  }
  .px-itin__u .px-cue-tag { margin: 0; }
  @media (max-width: 640px) { .px-itin__n { font-size: 72px; } }

  .px-itin__legs { list-style: none; margin: 0; padding: 0; }
  .px-itin__leg {
    display: grid; grid-template-columns: 32px minmax(0, 1fr); column-gap: 12px;
    padding: 0 0 12px;
  }
  .px-itin__rail { position: relative; align-self: stretch; }
  /* the dashed rail: one segment per row, from this node's centre to the next */
  .px-itin__seg {
    position: absolute; left: 15px; width: 2px; top: 0; bottom: 0;
    background: repeating-linear-gradient(to bottom, var(--accent) 0 4px, transparent 4px 9px);
    transform-origin: 50% 0;
  }
  .px-itin__seg[data-first] { top: 16px; }
  .px-itin__node {
    position: absolute; left: 0; top: 0;
    width: 32px; height: 32px; border-radius: 999px;
    background: var(--accent-tint); color: var(--accent-deep);
    display: flex; align-items: center; justify-content: center;
  }
  .px-itin__node svg, .px-itin__kg svg {
    width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .px-itin__dot {
    position: absolute; left: 7px; top: 3px;
    width: 18px; height: 18px; border-radius: 999px;
    background: var(--accent); box-shadow: 0 0 0 4px var(--accent-tint);
  }

  .px-itin__body { min-width: 0; padding-top: 5px; }
  .px-itin__head {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
    gap: 2px 12px;
  }
  .px-itin__cities {
    min-width: 0; font-size: 15px; line-height: 1.35; font-weight: 600; color: var(--ink);
    overflow-wrap: anywhere;
  }
  .px-itin__cities .px-cue-tag { margin-right: 6px; vertical-align: 1px; }
  .px-itin__arr { color: var(--accent-deep); }
  .px-itin__kick {
    display: block; font-size: 12px; font-weight: 500; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--accent-deep);
  }
  .px-itin__meta {
    font-size: 13px; line-height: 1.35; font-weight: 600; color: var(--ink-2);
    font-variant-numeric: tabular-nums; margin-left: auto; text-align: right;
  }

  .px-itin__box {
    list-style: none; margin: 8px 0 0; padding: 8px 12px;
    display: flex; flex-direction: column; gap: 4px;
    background: var(--paper-3); border: 1px solid var(--hair); border-radius: var(--r-ctl);
  }
  .px-itin__item {
    position: relative; padding-left: 14px;
    font-size: 13px; line-height: 1.45; color: var(--ink-2); overflow-wrap: anywhere;
  }
  .px-itin__item::before {
    content: ''; position: absolute; left: 0; top: 0.6em;
    width: 5px; height: 5px; border-radius: 999px; background: var(--accent);
  }

  .px-itin__leg--end { padding-bottom: 0; }
  .px-itin__leg--end .px-itin__body { padding-top: 2px; }

  .px-itin__legend {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px;
    margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--hair);
    font-size: 13px; line-height: 1.3; color: var(--ink-2);
  }
  .px-itin__legend > .px-cue-tag { margin: 0; }
  .px-itin__key { display: inline-flex; align-items: center; gap: 6px; }
  .px-itin__kg { display: inline-flex; color: var(--accent-deep); }
  .px-itin__kbox {
    display: inline-block; width: 14px; height: 12px; box-sizing: border-box;
    background: var(--paper-3); border: 1px solid var(--hair-2); border-radius: 2px;
  }
</style>
