---
/**
 * CityGrid (`city-grid`) — the street-orientation rose, a city's plan read
 * from its silhouette (Lens Phase 6, the Lib-city-grid board). Each city is
 * a card: its name in Newsreader, its subtitle, and a 36-petal rose. A
 * petal points along a compass bearing and its length is how much of that
 * city's road length runs that way, normalised per city (so shape, not
 * size, is compared: a `normalised per city` chip says so whenever there is
 * more than one). A gridded plan collapses to a cross; an organic one fans
 * to a circle. Under each rose the Boeing (2019) orientation-order score φ
 * (`orderScore` when authored, else computed from the bins).
 *
 * Each rose is drawn at a fixed 200px (text at 12 units prints at 12px), and
 * the cards wrap: two side by side in the 472 panel, one a row on a phone.
 * Zero JS.
 *
 * Cue anchors:
 *   1…n     each city, in authored order (its card)
 *   rose    the petals, on every rose
 *   phi     the order score under each rose
 *   norm    the `normalised per city` chip
 *
 * Build (src/scripts/build.ts, LENS §6.4): 1 the names, 2 the rings and the
 * compass, 3 the petals, 4 the order scores and the chip. No JS or reduced
 * motion: the plate as drawn.
 *
 * data: { cities: [{name, subtitle?, bins[36], orderScore?}] }
 */
interface City {
  name: string;
  subtitle?: string;
  bins: number[];        // EXACTLY 36 non-negative values, one per 10° sector
  orderScore?: number;   // optional 0–1 Boeing φ; computed if absent
}
interface Props {
  cities: City[];
  caption?: string;
  source?: string;
}
const { cities = [], caption, source } = Astro.props;

/* ── validation (build errors, per the blueprint §3 + §11) ──────────────── */
if (cities.length < 1 || cities.length > 3) {
  throw new Error(`city-grid: expected 1–3 cities, got ${cities.length}. The orientation-rose plate renders one to three cities.`);
}
cities.forEach((c, i) => {
  if (!Array.isArray(c.bins) || c.bins.length !== 36) {
    throw new Error(`city-grid: city "${c?.name ?? i}" has ${c?.bins?.length ?? 0} bins; the 36-bin rule requires EXACTLY 36 (one per 10° compass sector).`);
  }
});

const FF = "'Instrument Sans','Helvetica Neue',Arial,sans-serif";
const S = 200, CX = 100, CY = 102, R = 76;

// Boeing (2019) orientation-order φ = 1 − ((H − ln4)/(ln36 − ln4))².
function orderPhi(bins: number[]): number {
  const total = bins.reduce((a, b) => a + b, 0);
  if (total <= 0) return 0;
  let Hn = 0;
  for (const v of bins) { const p = v / total; if (p > 0) Hn -= p * Math.log(p); }
  const phi = 1 - Math.pow((Hn - Math.log(4)) / (Math.log(36) - Math.log(4)), 2);
  return Math.max(0, Math.min(1, phi));
}

const roses = cities.map((c, i) => {
  const max = Math.max(...c.bins, 0);
  let d = '';
  c.bins.forEach((v, b) => {
    const r = max > 0 ? (R * v) / max : 0;
    if (r <= 0.01) return;
    const a0 = ((b * 10 - 4) * Math.PI) / 180, a1 = ((b * 10 + 4) * Math.PI) / 180;
    d += `M${CX} ${CY}L${(CX + r * Math.sin(a0)).toFixed(1)} ${(CY - r * Math.cos(a0)).toFixed(1)}A${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${(CX + r * Math.sin(a1)).toFixed(1)} ${(CY - r * Math.cos(a1)).toFixed(1)}Z`;
  });
  const phi = Number.isFinite(c.orderScore as number) ? Math.max(0, Math.min(1, c.orderScore as number)) : orderPhi(c.bins);
  return { c, i, d, phi };
});
const multi = cities.length > 1;
/* In story mode the card hands the component its caption and source; they
   join the plate's accessible name (the visible ones are core/Section's). */
const plateLabel = [caption, source ? `Source: ${source}` : ''].filter(Boolean).join('. ');
---

<div class="px-cgrid" data-viz-root data-build-scene>
  {multi && (
    <div class="px-cgrid__top">
      <span class="px-cgrid__chip" data-cue="norm" data-build="4"><span class="px-cue-tag" data-cue-tag="norm" hidden></span>normalised per city</span>
    </div>
  )}

  <div class="px-cgrid__cards" role="group" aria-label={plateLabel || undefined}>
    {roses.map((r) => (
      <div class="px-cgrid__card" data-cue={r.i + 1}>
        <div class="px-cgrid__head" data-build="1" data-build-kind="rise">
          <span class="px-cgrid__name"><span class="px-cue-tag" data-cue-tag={r.i + 1} hidden></span>{r.c.name}</span>
          {r.c.subtitle && <span class="px-cgrid__sub">{r.c.subtitle}</span>}
        </div>
        <div class="px-cgrid__rose">
          <svg viewBox={`0 0 ${S} 206`} width={S} height="206" role="img"
            aria-label={`${r.c.name}: street-orientation rose, order ${r.phi.toFixed(2)}`}
            style={`font-family:${FF}`}>
            <g data-build="2">
              {[0.25, 0.5, 0.75, 1].map((k) => <circle cx={CX} cy={CY} r={R * k} fill="none" stroke="var(--hair)" stroke-width="1" />)}
              <line x1={CX} y1={CY - R - 2} x2={CX} y2={CY + R + 2} stroke="var(--hair)" stroke-width="1" />
              <line x1={CX - R - 2} y1={CY} x2={CX + R + 2} y2={CY} stroke="var(--hair)" stroke-width="1" />
              <text x={CX} y="14" text-anchor="middle" font-size="12" font-weight="600" fill="var(--ink-2)">N</text>
              <text x={S - 8} y={CY + 4} text-anchor="middle" font-size="12" font-weight="600" fill="var(--ink-2)">E</text>
              <text x={CX} y="200" text-anchor="middle" font-size="12" font-weight="600" fill="var(--ink-2)">S</text>
              <text x="8" y={CY + 4} text-anchor="middle" font-size="12" font-weight="600" fill="var(--ink-2)">W</text>
            </g>
            <path d={r.d} fill="var(--accent)" fill-opacity="0.9" stroke="var(--accent-deep)" stroke-width="0.75" data-cue="rose" data-build="3" />
          </svg>
          <span class="px-cgrid__rtag" data-cue="rose" aria-hidden="true"><span class="px-cue-tag" data-cue-tag="rose" hidden></span></span>
        </div>
        <span class="px-cgrid__phi" data-cue="phi" data-build="4">
          <span class="px-cue-tag" data-cue-tag="phi" hidden></span>order φ <b>{r.phi.toFixed(2)}</b>
        </span>
      </div>
    ))}
  </div>
</div>

<style>
  .px-cgrid { font-family: var(--font-ui); }
  .px-cgrid__top { display: flex; justify-content: flex-end; margin-bottom: 12px; }
  .px-cgrid__chip {
    display: inline-flex; align-items: center; gap: 8px; min-height: 28px; padding: 0 12px; border-radius: 999px;
    background: var(--paper-3); color: var(--ink-2); font-size: 12px; font-weight: 500; line-height: 1.3;
  }
  .px-cgrid__chip .px-cue-tag { margin: 0 0 0 -6px; }
  .px-cgrid__cards { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; }
  .px-cgrid__card {
    flex: 1 1 200px; max-width: 100%; min-width: 0;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
  }
  .px-cgrid__head { align-self: stretch; display: flex; flex-direction: column; gap: 4px; }
  .px-cgrid__name {
    font-family: var(--font-display); font-size: 24px; line-height: 1.1; font-weight: 500; color: var(--ink);
    overflow-wrap: anywhere;
  }
  .px-cgrid__name .px-cue-tag { vertical-align: 3px; }
  .px-cgrid__sub { font-size: 12px; line-height: 1.35; color: var(--muted); }
  .px-cgrid__rose { position: relative; width: 200px; flex: none; }
  .px-cgrid__rose svg { display: block; overflow: visible; }
  .px-cgrid__rtag { position: absolute; left: 76%; top: 21%; translate: -50% -50%; line-height: 0; }
  .px-cgrid__rtag .px-cue-tag { margin: 0; }
  .px-cgrid__rtag[data-cue] { outline: none !important; }
  .px-cgrid__phi { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
  .px-cgrid__phi .px-cue-tag { margin: 0; }
  .px-cgrid__phi b { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
</style>
