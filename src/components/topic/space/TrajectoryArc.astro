---
/**
 * TrajectoryArc (space) — a launch-to-orbit ascent profile: altitude against
 * downrange distance, one smooth arc through the flight's named phases, a
 * dashed apoapsis line, and the final phase's altitude set large above the
 * plot. Drawn for the pinned figure panel (Lens Phase 6, 2026-09-30; board
 * Lib-trajectory-arc): a 470-unit SVG, 12px axis type, 13px phase labels.
 *
 * Cue anchors: `1`…`n` — each phase, numbered in AUTHORED order (its pin, its
 * label, its numeral); `line` — the arc; `apoapsis` — the dashed line (when
 * `apoapsisKm` is set); `axis` — the two axes. The headline number carries
 * the anchor of the phase it reports (the last one downrange), so a cue on
 * that phase lights both.
 *
 * THE BUILD (LENS §6.4, src/scripts/build.ts): 1 the axes fade, 2 the arc
 * draws, 3 the phase pins drop in downrange order, 4 the apoapsis line fades,
 * 5 the headline counts up. No JS or reduced motion: the figure as drawn.
 *
 * A phase's `note` rides as its pin's <title> (the article carries the
 * sentences; the figure keeps the label only, LENS §5.5).
 *
 * data: { phases[]{ label, altKm, downrangeKm, note? }, apoapsisKm?, caption?, source? }
 */
import { SANS, nf, dpOf, svgTag, niceTicks, smooth, textW, tbox, hit, type Box } from './_fig';

interface Phase { label: string; altKm: number; downrangeKm: number; note?: string; }
interface Props {
  phases: Phase[];
  apoapsisKm?: number;
  caption?: string;
  source?: string;
}
const { phases = [], apoapsisKm, caption } = Astro.props;
/* Drawn twice (Lens Phase 6): at 470 for the panel and at 290 for a phone,
   one shown by the .px-sfig__dual rule in dataviz-v2.css, so every label
   prints at 12px or more at both widths and nothing has to scroll. */
const W: number = (Astro.props as any).w ?? 470;
const dual = (Astro.props as any).w == null;

const pts = (Array.isArray(phases) ? phases : [])
  .map((p, i) => ({
    id: String(i + 1),
    label: p?.label ?? '',
    altKm: Math.max(0, p?.altKm ?? 0),
    downrangeKm: Math.max(0, p?.downrangeKm ?? 0),
    note: p?.note,
  }))
  .sort((a, b) => a.downrangeKm - b.downrangeKm);

// ── frame (470 wide) ─────────────────────────────────────────────────────────
const H = 330, L = 44, R = W - 12, T = 24, B = H - 42;
const maxDown = Math.max(1, ...pts.map((p) => p.downrangeKm));
const maxAltRaw = Math.max(1, apoapsisKm ?? 0, ...pts.map((p) => p.altKm));
const xt = niceTicks(maxDown, 4);
const yt = niceTicks(maxAltRaw * 1.04, 4);
const xMax = xt[xt.length - 1], yMax = yt[yt.length - 1];
const X = (d: number) => L + (d / xMax) * (R - L);
const Y = (a: number) => B - (a / yMax) * (B - T);
const nodes = pts.map((p) => ({ ...p, x: X(p.downrangeKm), y: Y(p.altKm) }));
const arc = smooth(nodes);
const apoY = apoapsisKm != null ? Y(apoapsisKm) : null;

// ── phase labels: beside the pin, stacked where they would touch ────────────
const FS = 13;
const placed: Box[] = [];
// the axes' own text and the apoapsis label are fixed first
yt.forEach((v) => placed.push(tbox(L - 8, Y(v) + 4, textW(nf(v), 12), 'end', 12)));
const apoLabel = apoapsisKm != null ? `Apoapsis ${nf(apoapsisKm)} km` : '';
if (apoY != null) placed.push(tbox(R, apoY - 6, textW(apoLabel, 12), 'end', 12));
const labels = [...nodes]
  .sort((a, b) => b.y - a.y) // lowest first, so a crowded launch stacks upward
  .map((p) => {
    const w = textW(p.label, FS, true) + 24; // the label and its numeral slot
    const flip = p.x + 8 + w > R + 6;
    const anchor: 'start' | 'end' = flip ? 'end' : 'start';
    const lx = flip ? p.x - 8 : p.x + 8;
    let ly = Math.min(B - 8, p.y + 4);
    let box = tbox(lx, ly, w, anchor, FS);
    for (let k = 0; k < 24 && placed.some((q) => hit(box, q, 3)); k++) {
      ly -= 17;
      box = tbox(lx, ly, w, anchor, FS);
    }
    placed.push(box);
    // the numeral slot sits between the pin and the words
    return { ...p, anchor, lx, ly, lead: Math.abs(ly - 4 - p.y) > 6, tagX: flip ? lx - 12 : lx + 12, textX: flip ? lx - 24 : lx + 24 };
  });
const byId = new Map(labels.map((l) => [l.id, l]));

const last = nodes[nodes.length - 1];
const headDp = last ? Math.min(1, dpOf(last.altKm)) : 0;
const aria = caption ? `Launch trajectory: ${caption}` : 'Launch trajectory, altitude against downrange distance';
---
{dual ? (
  <div class="px-sfig__dual">
    <Astro.self {...Astro.props} w={470} />
    <Astro.self {...Astro.props} w={290} />
  </div>
) : (
<Fragment>

<div class="px-viz px-traj" data-build-scene>
  {last && (
    <div class="px-sfig__head" data-cue={last.id}>
      <span class="px-sfig__num" data-build="5" data-build-kind="counter" data-to={last.altKm} data-format={headDp ? '1dp' : undefined}>{nf(last.altKm, headDp)}</span>
      <span class="px-sfig__lbl"><span class="px-cue-tag" data-cue-tag={last.id} hidden></span>km at {last.label}</span>
    </div>
  )}

  <div class="px-sfig__plot">
    <svg class="px-sfig__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
      <g data-cue="axis" data-build="1">
        {yt.map((v) => (
          <>
            <line class="px-sfig__grid" x1={L} x2={R} y1={Y(v).toFixed(1)} y2={Y(v).toFixed(1)} />
            <text class="px-sfig__ax" x={L - 8} y={(Y(v) + 4).toFixed(1)} text-anchor="end" style={SANS}>{nf(v)}</text>
          </>
        ))}
        {xt.map((v, i) => (
          <text class="px-sfig__ax" x={X(v).toFixed(1)} y={B + 18} text-anchor={i === 0 ? 'start' : 'middle'} style={SANS}>{nf(v)}</text>
        ))}
        <line class="px-sfig__base" x1={L} x2={R} y1={B} y2={B} />
        <text class="px-sfig__at" x="0" y="12" style={SANS}>Altitude (km)</text>
        <text class="px-sfig__at" x={R} y={H - 4} text-anchor="end" style={SANS}>Downrange (km)</text>
      </g>

      {apoY != null && (
        <g data-cue="apoapsis" data-build="4">
          <line class="px-traj__apo" x1={L} x2={R} y1={apoY.toFixed(1)} y2={apoY.toFixed(1)} />
          <text class="px-sfig__ax px-traj__apo-t" x={R} y={(apoY - 6).toFixed(1)} text-anchor="end" style={SANS}>{apoLabel}</text>
        </g>
      )}

      {arc && (
        <g data-cue="line">
          <path class="px-traj__line" d={arc} data-build="2" data-build-kind="draw" />
        </g>
      )}

      {nodes.map((p) => {
        const l = byId.get(p.id)!;
        return (
          <g class="px-traj__pin" data-cue={p.id} data-build="3" data-build-kind="drop">
            {p.note && <title>{p.label}: {p.note}</title>}
            {l.lead && <line class="px-traj__lead" x1={p.x.toFixed(1)} y1={p.y.toFixed(1)} x2={l.lx.toFixed(1)} y2={(l.ly - 4).toFixed(1)} />}
            <circle class="px-traj__dot" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="4.5" />
            <text class="px-sfig__t px-sfig__b" x={l.textX.toFixed(1)} y={l.ly.toFixed(1)} text-anchor={l.anchor} style={SANS}>{p.label}</text>
            <Fragment set:html={svgTag(p.id, l.tagX, l.ly - 4)} />
          </g>
        );
      })}
    </svg>
  </div>
</div>
</Fragment>
)}

<style>
  .px-traj__line { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .px-traj__dot { fill: var(--accent); stroke: var(--paper-2); stroke-width: 2; }
  .px-traj__lead { stroke: var(--hair-2); stroke-width: 1; }
  .px-traj__apo { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 4 4; }
  .px-traj__apo-t { fill: var(--ink-2); }
</style>
