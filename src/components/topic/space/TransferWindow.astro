---
/**
 * TransferWindow (space · SVG instrument) — why a planet is only reachable in
 * windows. Two circular orbits round the central body, the Hohmann half
 * ellipse from the departure planet's launch point to the destination's
 * arrival point, and the lead the destination must have at launch (the phase
 * angle) as a wedge, set large above the figure. Under the figure: the Δv,
 * the flight time and the days between windows. Drawn for the pinned figure
 * panel (Lens Phase 6, 2026-09-30; board Lib-transfer-window): a 290-unit SVG
 * centred in the panel, so it prints at 12 to 13px on a 375 phone too and
 * never scrolls (a radial figure scrolled sideways hides its subject).
 *
 * Math: src/scripts/viz3d/kepler.ts `hohmannDv` (Δv and flight time); the
 * synodic period and the required phase are closed forms, computed here.
 *
 * THE INSTRUMENT. A range input (shipped `hidden`, unhidden by the inline
 * island) sweeps the destination's lead at launch; the island moves the
 * destination's launch dot and the wedge and says in words whether the
 * transfer would arrive. It never runs on load: the static figure IS the
 * window-open state, the island only answers the reader's drag. The control
 * sits outside the build scene, so its reveal moves nothing the build owns.
 *
 * Cue anchors: `lead` — the wedge, the destination at launch, and the
 * headline; `transfer` — the half ellipse; `from` — the departure planet at
 * launch; `to` — the destination at arrival; `central`; `dv`, `days`,
 * `cadence` — the three numbers under the figure.
 *
 * THE BUILD (LENS §6.4): 1 the orbits and the central body fade, 2 the
 * transfer draws, 3 the planets and the wedge drop, 4 the three numbers rise,
 * 5 the headline counts up.
 *
 * data: { central{name, mu}, from{name, radiusKm, periodDays?}, to{name,
 *         radiusKm, periodDays?}, distanceUnit?, caption?, source? }
 */
import { hohmannDv } from '../../../scripts/viz3d/kepler';
import { SANS, nf, svgTag } from './_fig';

interface TransferWindowData {
  central: { name: string; mu: number };
  from: { name: string; radiusKm: number; periodDays?: number };
  to: { name: string; radiusKm: number; periodDays?: number };
  distanceUnit?: 'AU' | 'km';
  caption?: string;
  source?: string;
}
type Props = TransferWindowData;
const {
  central = { name: 'Sun', mu: 1.327e11 },
  from = { name: 'Earth', radiusKm: 149600000, periodDays: 365.25 },
  to = { name: 'Mars', radiusKm: 227900000, periodDays: 686.98 },
  distanceUnit = 'km',
  caption,
} = Astro.props as Props;

const AU_KM = 1.496e8;
/* ── physics ─────────────────────────────────────────────────────────────── */
const r1 = from.radiusKm, r2 = to.radiusKm, mu = central.mu;
const { dv1, dv2, tTransferSec } = hohmannDv(r1, r2, mu);
const dvTotal = dv1 + dv2;
const tDays = tTransferSec / 86400;
const circ = (r: number) => (2 * Math.PI * Math.sqrt((r * r * r) / mu)) / 86400;
const T1 = from.periodDays ?? circ(r1);
const T2 = to.periodDays ?? circ(r2);
const synodic = 1 / Math.abs(1 / T1 - 1 / T2);
const norm = (a: number) => ((((a + 180) % 360) + 360) % 360) - 180;
const phi = norm(180 - 360 * (tDays / T2));          // the destination's lead at launch
const lead = Math.round(phi);

/* ── the drawing: screen angles, y down; motion runs 180° → 0° via the bottom ── */
const TW = 290, H = 262, CX = 145, CY = 132;
const ratio = r2 / r1;
const compressed = ratio > 6 || ratio < 1 / 6;
const RO = 108;
const rin = compressed ? RO / Math.sqrt(Math.max(ratio, 1 / ratio)) : RO / Math.max(ratio, 1 / ratio);
const R1 = ratio >= 1 ? rin : RO, R2 = ratio >= 1 ? RO : rin;
const pt = (a: number, R: number) => ({ x: CX + R * Math.cos((a * Math.PI) / 180), y: CY + R * Math.sin((a * Math.PI) / 180) });
const at = (R1 + R2) / 2, et = (R2 - R1) / (R1 + R2);
let transfer = '';
for (let k = 0; k <= 72; k++) {
  const nu = (k / 72) * 180;
  const r = (at * (1 - et * et)) / (1 + et * Math.cos((nu * Math.PI) / 180));
  const p = pt(180 - nu, r);
  transfer += (k ? 'L' : 'M') + p.x.toFixed(1) + ' ' + p.y.toFixed(1);
}
const wedge = (v: number) => {
  let d = '';
  for (let k = 0; k <= 24; k++) { const p = pt(180 - (k / 24) * v, 34); d += (k ? 'L' : 'M') + p.x.toFixed(1) + ' ' + p.y.toFixed(1); }
  return d;
};
const dep = pt(180, R1);
const arr = pt(0, R2);
const dstAt = pt(180 - lead, R2);
const wMid = pt(180 - lead / 2, 52);
const trMid = pt(58, (R1 + R2) / 2 + 16);
const dist = (km: number) => (distanceUnit === 'AU' ? `${(km / AU_KM).toFixed(2)} AU` : `${nf(km)} km`);
const chip = compressed ? 'Radii compressed' : 'Idealised orbits';
const payload = JSON.stringify({ CX, CY, R2, lead, syn: +synodic.toFixed(1), to: to.name });
const aria = `Hohmann transfer from ${from.name} to ${to.name}: ${to.name} must lead by ${lead} degrees at launch.`;
---

<div class="px-viz px-xwin">
  <div class="px-xwin__scene" data-build-scene>
    <div class="px-sfig__head px-xwin__head">
      <span class="px-xwin__hn" data-cue="lead">
        <span class="px-sfig__num" data-build="5" data-build-kind="counter" data-to={lead}>{lead}°</span>
        <span class="px-sfig__lbl"><span class="px-cue-tag" data-cue-tag="lead" hidden></span>{to.name} must lead</span>
      </span>
      <span class="px-xwin__chip">{chip}</span>
    </div>

    <div class="px-xwin__plot">
      <svg class="px-xwin__svg" viewBox={`0 0 ${TW} ${H}`} role="img" aria-label={caption ? `${aria} ${caption}` : aria}>
        <g data-build="1">
          <circle class="px-xwin__orb" cx={CX} cy={CY} r={R1.toFixed(1)}><title>{from.name} orbit, {dist(r1)}</title></circle>
          <circle class="px-xwin__orb" cx={CX} cy={CY} r={R2.toFixed(1)}><title>{to.name} orbit, {dist(r2)}</title></circle>
        </g>
        <g data-cue="central" data-build="1">
          <circle class="px-xwin__sun" cx={CX} cy={CY} r="9" />
          <text class="px-sfig__t px-sfig__b" x={CX + 14} y={CY - 10} style={SANS}>{central.name}</text>
        </g>

        <g data-cue="transfer">
          <path class="px-xwin__tr" d={transfer} data-build="2" data-build-kind="draw" />
          <g data-build="3" data-build-kind="drop">
            <text class="px-sfig__t px-xwin__tr-t" x={trMid.x.toFixed(1)} y={trMid.y.toFixed(1)} style={SANS}>Transfer</text>
            <Fragment set:html={svgTag('transfer', trMid.x - 14, trMid.y - 4)} />
          </g>
        </g>

        <g data-cue="lead" data-build="3" data-build-kind="drop">
          <line class="px-xwin__ray" x1={CX} y1={CY} x2={dep.x.toFixed(1)} y2={dep.y.toFixed(1)} />
          <line class="px-xwin__ray px-xwin__ray-d" x1={CX} y1={CY} x2={dstAt.x.toFixed(1)} y2={dstAt.y.toFixed(1)} />
          <path class="px-xwin__wedge" d={wedge(lead)} />
          <text class="px-xwin__deg" x={wMid.x.toFixed(1)} y={(wMid.y + 4).toFixed(1)} text-anchor="middle" style={SANS}>{lead}°</text>
          <circle class="px-xwin__dst" cx={dstAt.x.toFixed(1)} cy={dstAt.y.toFixed(1)} r="5" />
          <text class="px-sfig__t px-sfig__b" x={Math.max(48, dstAt.x).toFixed(1)} y={(dstAt.y + 24).toFixed(1)} text-anchor="middle" style={SANS}>{to.name}, launch</text>
          <Fragment set:html={svgTag('lead', dstAt.x - 20, dstAt.y + 2)} />
        </g>

        <g data-cue="from" data-build="3" data-build-kind="drop">
          <circle class="px-xwin__dep" cx={dep.x.toFixed(1)} cy={dep.y.toFixed(1)} r="6" />
          <text class="px-sfig__t px-sfig__b" x={Math.max(48, dep.x).toFixed(1)} y={(dep.y - 14).toFixed(1)} text-anchor="middle" style={SANS}>{from.name}, launch</text>
          <Fragment set:html={svgTag('from', dep.x + 2, dep.y + 18)} />
        </g>
        <g data-cue="to" data-build="3" data-build-kind="drop">
          <circle class="px-xwin__arr" cx={arr.x.toFixed(1)} cy={arr.y.toFixed(1)} r="6" />
          <text class="px-sfig__t px-sfig__b" x={(TW - 2).toFixed(1)} y={(arr.y - 14).toFixed(1)} text-anchor="end" style={SANS}>{to.name}, arrival</text>
          <Fragment set:html={svgTag('to', arr.x - 22, arr.y + 2)} />
        </g>
      </svg>
    </div>

    <dl class="px-xwin__stats">
      <div class="px-xwin__st" data-cue="dv" data-build="4" data-build-kind="rise">
        <dt><span class="px-cue-tag" data-cue-tag="dv" hidden></span>km/s total</dt>
        <dd>{dvTotal.toFixed(1)}</dd>
      </div>
      <div class="px-xwin__st" data-cue="days" data-build="4" data-build-kind="rise">
        <dt><span class="px-cue-tag" data-cue-tag="days" hidden></span>days to {to.name}</dt>
        <dd>{nf(Math.round(tDays))}</dd>
      </div>
      <div class="px-xwin__st" data-cue="cadence" data-build="4" data-build-kind="rise">
        <dt><span class="px-cue-tag" data-cue-tag="cadence" hidden></span>days between windows</dt>
        <dd>{nf(Math.round(synodic))}</dd>
      </div>
    </dl>
  </div>

  <div class="px-xwin__scrub" hidden>
    <label class="px-xwin__lab" for="px-xwin-range">{to.name}'s lead at launch</label>
    <input id="px-xwin-range" class="px-xwin__range" type="range" min="-180" max="180" step="1" value={lead} aria-describedby="px-xwin-verdict" />
    <p id="px-xwin-verdict" class="px-xwin__verdict" aria-live="polite">Window open: the transfer arrives as {to.name} does.</p>
  </div>

  <script type="application/json" class="px-xwin__data" set:html={payload}></script>
  <script is:inline>
    (function () {
      var self = document.currentScript;
      var root = self && self.closest ? self.closest('.px-xwin') : null;
      if (!root) return;
      var P; try { P = JSON.parse(root.querySelector('.px-xwin__data').textContent); } catch (e) { return; }
      var wrap = root.querySelector('.px-xwin__scrub'), range = root.querySelector('.px-xwin__range');
      var dst = root.querySelector('.px-xwin__dst'), ray = root.querySelector('.px-xwin__ray-d');
      var wedge = root.querySelector('.px-xwin__wedge'), deg = root.querySelector('.px-xwin__deg');
      var verdict = root.querySelector('.px-xwin__verdict');
      if (!wrap || !range || !dst || !ray || !wedge || !deg || !verdict) return;
      function pt(a, R) { var r = a * Math.PI / 180; return [P.CX + R * Math.cos(r), P.CY + R * Math.sin(r)]; }
      function render(v) {
        var p = pt(180 - v, P.R2), d = '', k, q;
        dst.setAttribute('cx', p[0].toFixed(1)); dst.setAttribute('cy', p[1].toFixed(1));
        ray.setAttribute('x2', p[0].toFixed(1)); ray.setAttribute('y2', p[1].toFixed(1));
        for (k = 0; k <= 24; k++) { q = pt(180 - (k / 24) * v, 34); d += (k ? 'L' : 'M') + q[0].toFixed(1) + ' ' + q[1].toFixed(1); }
        wedge.setAttribute('d', d);
        q = pt(180 - v / 2, 52); deg.setAttribute('x', q[0].toFixed(1)); deg.setAttribute('y', (q[1] + 4).toFixed(1));
        deg.textContent = v + '°';
        var off = v - P.lead;
        verdict.textContent = Math.abs(off) <= 3
          ? 'Window open: the transfer arrives as ' + P.to + ' does.'
          : 'Off by ' + Math.abs(off) + '°: the next window is about ' + Math.round(P.syn * Math.abs(off) / 360).toLocaleString('en-US') + ' days away.';
      }
      wrap.hidden = false;
      range.addEventListener('input', function () { render(parseInt(range.value, 10)); });
    })();
  </script>
</div>

<style>
  .px-xwin__head { flex-direction: row; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .px-xwin__hn { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .px-xwin__chip { display: inline-flex; align-items: center; height: 28px; padding: 0 12px; border: 1px solid var(--hair-2); border-radius: 999px; font-family: var(--font-ui); font-size: 12px; font-weight: 500; color: var(--ink-2); white-space: nowrap; }
  .px-xwin__plot { display: flex; justify-content: center; }
  .px-xwin__svg { display: block; width: 100%; max-width: 290px; height: auto; overflow: visible; }
  .px-xwin__orb { fill: none; stroke: var(--ink-2); stroke-width: 1; }
  .px-xwin__sun { fill: var(--accent-alt, #9c5a14); }
  .px-xwin__tr { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; }
  .px-xwin__tr-t { fill: var(--accent-deep); font-weight: 600; }
  .px-xwin__ray { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 2 3; }
  .px-xwin__wedge { fill: none; stroke: var(--accent-deep); stroke-width: 2; }
  .px-xwin__deg { font-size: 13px; font-weight: 600; fill: var(--accent-deep); paint-order: stroke; stroke: var(--paper-2); stroke-width: 4px; }
  .px-xwin__dst { fill: var(--ink); stroke: var(--paper-2); stroke-width: 1.5; }
  .px-xwin__dep { fill: var(--accent); stroke: var(--paper-2); stroke-width: 2; }
  .px-xwin__arr { fill: var(--paper-2); stroke: var(--ink); stroke-width: 1.5; stroke-dasharray: 2 2; }

  .px-xwin__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 12px 0 0; padding: 14px 0 0; border-top: 1px solid var(--hair); }
  .px-xwin__st { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 6px; min-width: 0; }
  .px-xwin__st dd { margin: 0; font-family: var(--font-ui); font-size: 32px; line-height: 0.92; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink); }
  .px-xwin__st dt { display: flex; align-items: flex-start; font-family: var(--font-ui); font-size: 13px; line-height: 1.3; font-weight: 500; color: var(--ink-2); }

  .px-xwin__scrub:not([hidden]) { margin-top: 16px; display: grid; gap: 8px; }
  .px-xwin__lab { font-family: var(--font-ui); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .px-xwin__range { width: 100%; min-height: 44px; accent-color: var(--accent-deep); margin: 0; }
  .px-xwin__verdict { margin: 0; font-family: var(--font-ui); font-size: 14px; line-height: 1.4; color: var(--ink); }
</style>
