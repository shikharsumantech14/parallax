---
/**
 * LagrangeMap (space) — the effective potential of a two-body system in the
 * frame that turns with it (gravity plus the spin), drawn as equal-potential
 * lines, with the five Lagrange points at their true geometry: L1, L2 and L3
 * as unstable saddles (⊗), L4 and L5 as the stable corners 60° off the axis
 * (a filled dot). For real mass ratios (Sun–Earth) L1 and L2 sit a few pixels
 * from the smaller body, so an inset beside the map magnifies them. The
 * distance to the first marked point near the smaller body is set large.
 * Drawn for the pinned figure panel (Lens Phase 6, 2026-09-30; board
 * Lib-lagrange-map): a 290-unit map and a 160-unit inset side by side in the
 * 470 panel (the inset wraps under the map on a phone, so neither scrolls),
 * 12 to 13px labels, the key in HTML.
 *
 * Physics: docs/design/physics/orbital-mechanics.md §7 — Ω(x, y) and the five
 * equilibria, computed here at build time.
 *
 * Cue anchors: `L1`…`L5` — each point (in the map, and in the inset for the
 * two it magnifies) with its marker label; `primary`, `secondary` — the two
 * masses; `inset` — the magnified window; `field` — the equal-potential lines.
 * The headline carries the anchor of the point it measures.
 *
 * THE BUILD (LENS §6.4): 1 the field and the inset frame fade, 2 the masses
 * fade, 3 the points drop, 4 the key fades, 5 the headline counts up.
 *
 * data: { primary{name, mass}, secondary{name, mass}, separationKm?,
 *         markers?[{at, label}], show?[...], caption?, source? }
 */
import { SANS, nf, svgTag, wrap } from './_fig';

interface Body { name: string; mass: number; }
type PName = 'L1' | 'L2' | 'L3' | 'L4' | 'L5';
interface Marker { at: PName; label: string; }
interface Props {
  primary: Body;
  secondary: Body;
  separationKm?: number;
  markers?: Marker[];
  show?: PName[];
  caption?: string;
  source?: string;
}
const {
  primary = { name: 'Sun', mass: 332946 },
  secondary = { name: 'Earth', mass: 1 },
  separationKm,
  markers = [],
  show,
  caption,
  source,
} = Astro.props;

// ── CR3BP (orbital-mechanics.md §7) ──────────────────────────────────────────
const mu = secondary.mass / (primary.mass + secondary.mass);
const omega = (x: number, y: number, mask = 0.02): number | null => {
  const r1 = Math.hypot(x + mu, y), r2 = Math.hypot(x - 1 + mu, y);
  if (r1 < mask || r2 < mask * 0.02) return null;
  return 0.5 * (x * x + y * y) + (1 - mu) / r1 + mu / r2;
};
const dOm = (x: number) => {
  const s1 = Math.sign(x + mu), s2 = Math.sign(x - 1 + mu);
  return x - ((1 - mu) * s1) / (x + mu) ** 2 - (mu * s2) / (x - 1 + mu) ** 2;
};
const root = (seed: number) => {
  let x = seed;
  for (let k = 0; k < 60; k++) {
    const h = 1e-9, dx = dOm(x) / ((dOm(x + h) - dOm(x - h)) / (2 * h));
    x -= dx;
    if (Math.abs(dx) < 1e-13) break;
  }
  return x;
};
const rH = Math.cbrt(mu / 3);
const LP: Record<PName, [number, number]> = {
  L1: [root(1 - mu - rH), 0], L2: [root(1 - mu + rH), 0], L3: [root(-(1 + (5 * mu) / 12)), 0],
  L4: [0.5 - mu, Math.sqrt(3) / 2], L5: [0.5 - mu, -Math.sqrt(3) / 2],
};
const ALL: PName[] = ['L1', 'L2', 'L3', 'L4', 'L5'];
const shown = (show && show.length ? show : ALL).filter((p) => ALL.includes(p));
const saddle = (p: PName) => p === 'L1' || p === 'L2' || p === 'L3';
const markOf = (p: PName) => markers.filter((m) => m && m.at === p).map((m) => m.label);

// ── marching squares: equal-potential lines of f over a box ─────────────────
function iso(f: (x: number, y: number) => number, x0: number, x1: number, y0: number, y1: number, nx: number, ny: number, level: number, sx: (x: number) => number, sy: (y: number) => number): string {
  const g: number[][] = [];
  for (let j = 0; j <= ny; j++) { const row: number[] = []; for (let i = 0; i <= nx; i++) row.push(f(x0 + ((x1 - x0) * i) / nx, y0 + ((y1 - y0) * j) / ny)); g.push(row); }
  let d = '';
  const lerp = (a: number, b: number, va: number, vb: number) => a + (b - a) * ((level - va) / (vb - va || 1e-12));
  for (let j = 0; j < ny; j++) for (let i = 0; i < nx; i++) {
    const tl = g[j][i], tr = g[j][i + 1], br = g[j + 1][i + 1], bl = g[j + 1][i];
    const c = (tl > level ? 8 : 0) | (tr > level ? 4 : 0) | (br > level ? 2 : 0) | (bl > level ? 1 : 0);
    if (c === 0 || c === 15) continue;
    const xa = x0 + ((x1 - x0) * i) / nx, xb = x0 + ((x1 - x0) * (i + 1)) / nx;
    const ya = y0 + ((y1 - y0) * j) / ny, yb = y0 + ((y1 - y0) * (j + 1)) / ny;
    const T = [lerp(xa, xb, tl, tr), ya], Rr = [xb, lerp(ya, yb, tr, br)], Bm = [lerp(xa, xb, bl, br), yb], Lf = [xa, lerp(ya, yb, tl, bl)];
    const seg = (p: number[], q: number[]) => { d += `M${sx(p[0]).toFixed(1)} ${sy(p[1]).toFixed(1)}L${sx(q[0]).toFixed(1)} ${sy(q[1]).toFixed(1)}`; };
    const ct = (tl + tr + br + bl) / 4 > level;
    switch (c) {
      case 1: case 14: seg(Lf, Bm); break;
      case 2: case 13: seg(Bm, Rr); break;
      case 3: case 12: seg(Lf, Rr); break;
      case 4: case 11: seg(T, Rr); break;
      case 6: case 9: seg(T, Bm); break;
      case 7: case 8: seg(Lf, T); break;
      case 5: if (ct) { seg(Lf, T); seg(Bm, Rr); } else { seg(Lf, Bm); seg(T, Rr); } break;
      case 10: if (ct) { seg(Lf, Bm); seg(T, Rr); } else { seg(Lf, T); seg(Bm, Rr); } break;
    }
  }
  return d;
}

// ── the map: a square on the left ─────────────────────────────────────────────
const MAPW = 290, H = 290, MX = 8, MY = 8, MS = 274, SPAN = 1.25;
const sx = (x: number) => MX + ((x + SPAN) / (2 * SPAN)) * MS;
const sy = (y: number) => MY + ((SPAN - y) / (2 * SPAN)) * MS;
const omL1 = omega(LP.L1[0], 0) ?? 1.5;
const CAP = omL1 + 0.6;
const fMain = (x: number, y: number) => Math.min(CAP, omega(x, y) ?? CAP);
let lo = Infinity;
for (let j = 0; j <= 60; j++) for (let i = 0; i <= 60; i++) { const v = omega(-SPAN + (2 * SPAN * i) / 60, -SPAN + (2 * SPAN * j) / 60); if (v != null && v < lo) lo = v; }
const mainLevels = Array.from({ length: 7 }, (_, k) => lo + Math.exp(Math.log(0.004) + ((Math.log(CAP - lo + 0.004) - Math.log(0.004)) * (k + 1)) / 8) - 0.004);
const mainPaths = mainLevels.map((lv) => iso(fMain, -SPAN, SPAN, -SPAN, SPAN, 84, 84, lv, sx, sy));
const pri = { x: sx(-mu), y: sy(0) };
const sec = { x: sx(1 - mu), y: sy(0) };
const collapse = Math.abs(sx(LP.L2[0]) - sx(LP.L1[0])) < 24 && shown.includes('L1') && shown.includes('L2');

// ── the inset: L1 · secondary · L2, magnified ─────────────────────────────────
const IX = 2, IY = 22, IW = 156, IH = 124;
const half = Math.max(LP.L2[0] - (1 - mu), (1 - mu) - LP.L1[0]) * 1.9;
const ix0 = 1 - mu - half, ix1 = 1 - mu + half, iyH = (half * IH) / IW;
const isx = (x: number) => IX + ((x - ix0) / (ix1 - ix0)) * IW;
const isy = (y: number) => IY + IH / 2 - (y / iyH) * (IH / 2);
const omL2 = omega(LP.L2[0], 0) ?? omL1;
const fIn = (x: number, y: number) => Math.min(omL1 * 1.05, omega(x, y, 0) ?? omL1 * 1.05);
const edge = omega(ix0, iyH) ?? omL1;
const inLevels = [omL1, omL2, ...[0.25, 0.5, 0.75].map((f) => edge + (omL2 - edge) * f), ...[1.0015, 1.004, 1.01].map((f) => omL1 * f)];
const inPaths = collapse ? inLevels.map((lv) => iso(fIn, ix0, ix1, -iyH, iyH, 90, 70, lv, isx, isy)) : [];
const MAG = collapse ? Math.round(IW / (2 * half) / (MS / (2 * SPAN))) : 1;

// ── points ───────────────────────────────────────────────────────────────────
const pts = shown.map((p) => {
  const inInset = collapse && (p === 'L1' || p === 'L2');
  const [nx, ny] = LP[p];
  return { id: p, inInset, x: inInset ? isx(nx) : sx(nx), y: inInset ? isy(ny) : sy(ny), saddle: saddle(p), marks: markOf(p) };
});
// the headline: the first marker at L1/L2 (else L2), from the smaller body
const hp = (markers.find((m) => m && (m.at === 'L1' || m.at === 'L2'))?.at ?? 'L2') as PName;
const hKm = separationKm && shown.includes(hp) ? Math.abs(LP[hp][0] - (1 - mu)) * separationKm : null;
const hMillion = hKm != null && hKm >= 1e6;
const hVal = hKm == null ? null : hMillion ? +(hKm / 1e6).toFixed(1) : Math.round(hKm);
const angle60 = (() => {
  const a0 = 0, a1 = -60, r = 34;
  const p0 = { x: pri.x + r * Math.cos(a0 * Math.PI / 180), y: pri.y + r * Math.sin(a0 * Math.PI / 180) };
  const p1 = { x: pri.x + r * Math.cos(a1 * Math.PI / 180), y: pri.y + r * Math.sin(a1 * Math.PI / 180) };
  return { d: `M${p0.x.toFixed(1)} ${p0.y.toFixed(1)} A${r} ${r} 0 0 0 ${p1.x.toFixed(1)} ${p1.y.toFixed(1)}`, lx: pri.x + 44 * Math.cos(-30 * Math.PI / 180), ly: pri.y + 44 * Math.sin(-30 * Math.PI / 180) + 4 };
})();
const aria = `Effective-potential map of the ${primary.name}–${secondary.name} system, ${shown.length} Lagrange points marked${caption ? `: ${caption}` : ''}`;
const insetNotes = pts.filter((p) => p.inInset).map((p) => ({ id: p.id, text: [p.id, ...p.marks].join(' · ') }));
const IH2 = IY + IH + 30 + insetNotes.reduce((a, n) => a + wrap(n.text, 20).length * 16 + 20, 0);
---

<div class="px-viz px-lagr" data-build-scene>
  {hVal != null && (
    <div class="px-sfig__head" data-cue={hp}>
      <span class="px-sfig__num" data-build="5" data-build-kind="counter" data-to={hVal} data-format={hMillion ? '1dp' : undefined}>{hMillion ? hVal.toFixed(1) : nf(hVal)}</span>
      <span class="px-sfig__lbl"><span class="px-cue-tag" data-cue-tag={hp} hidden></span>{hMillion ? 'million km' : 'km'} to {hp}</span>
    </div>
  )}

  <div class="px-lagr__figs">
    <svg class="px-lagr__map" viewBox={`0 0 ${MAPW} ${H}`} role="img" aria-label={aria}>
      {source && <desc>{source}</desc>}
      <g data-cue="field" data-build="1">
        {mainPaths.map((d, i) => <path class="px-lagr__iso" d={d} style={`opacity:${(0.45 + 0.07 * i).toFixed(2)}`} />)}
        <line class="px-lagr__ax" x1={MX} x2={MX + MS} y1={pri.y} y2={pri.y} />
        {shown.includes('L4') && <line class="px-lagr__ax" x1={pri.x} y1={pri.y} x2={sx(LP.L4[0])} y2={sy(LP.L4[1])} />}
        {shown.includes('L5') && <line class="px-lagr__ax" x1={pri.x} y1={pri.y} x2={sx(LP.L5[0])} y2={sy(LP.L5[1])} />}
        {shown.includes('L4') && (
          <>
            <path class="px-lagr__ang" d={angle60.d} />
            <text class="px-sfig__ax" x={angle60.lx.toFixed(1)} y={angle60.ly.toFixed(1)} style={SANS}>60°</text>
          </>
        )}
      </g>
      {collapse && (
        <g data-cue="inset" data-build="1">
          <rect class="px-lagr__win" x={(sec.x - 6).toFixed(1)} y={(sec.y - 6).toFixed(1)} width="12" height="12" />
        </g>
      )}
      <g data-cue="primary" data-build="2">
        <circle class="px-lagr__sun" cx={pri.x.toFixed(1)} cy={pri.y.toFixed(1)} r="10" />
        <text class="px-sfig__t px-sfig__b" x={pri.x.toFixed(1)} y={(pri.y + 26).toFixed(1)} text-anchor="middle" style={SANS}>{primary.name}</text>
      </g>
      <g data-cue="secondary" data-build="2">
        <circle class="px-lagr__body" cx={sec.x.toFixed(1)} cy={sec.y.toFixed(1)} r="4.5" />
        <text class="px-sfig__t px-sfig__b" x={(sec.x - 4).toFixed(1)} y={(sec.y + 22).toFixed(1)} text-anchor="end" style={SANS}>{secondary.name}</text>
      </g>
      {pts.filter((p) => !p.inInset).map((p) => {
        const lines = wrap([p.id, ...p.marks].join(' · '), 18);
        const below = p.y > pri.y + 4;
        const ly = below ? p.y + 22 : p.y - 12 - (lines.length - 1) * 16;
        const anchor = p.x < pri.x - 20 ? 'start' : 'middle';
        const lx = anchor === 'start' ? Math.max(4, p.x - 8) : Math.min(MAPW - 70, p.x);
        return (
          <g data-cue={p.id} data-build="3" data-build-kind="drop">
            {p.saddle ? (
              <g class="px-lagr__sad">
                <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="6" />
                <line x1={(p.x - 4).toFixed(1)} y1={(p.y - 4).toFixed(1)} x2={(p.x + 4).toFixed(1)} y2={(p.y + 4).toFixed(1)} />
                <line x1={(p.x - 4).toFixed(1)} y1={(p.y + 4).toFixed(1)} x2={(p.x + 4).toFixed(1)} y2={(p.y - 4).toFixed(1)} />
              </g>
            ) : (
              <circle class="px-lagr__stable" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="6" />
            )}
            <text class="px-sfig__t px-sfig__b" x={lx.toFixed(1)} y={ly.toFixed(1)} text-anchor={anchor} style={SANS}>
              {lines.map((ln, i) => <tspan x={lx.toFixed(1)} dy={i ? 16 : 0}>{ln}</tspan>)}
            </text>
            <Fragment set:html={svgTag(p.id, p.x + 18, p.y)} />
          </g>
        );
      })}
    </svg>

    {collapse && (
      <svg class="px-lagr__ins" viewBox={`0 0 ${IW + 4} ${IH2}`} role="img" aria-label={`${insetNotes.map((n) => n.text).join(', ')}, magnified ${MAG} times`}>
        <g data-cue="inset" data-build="1">
          <rect class="px-lagr__frame" x={IX} y={IY} width={IW} height={IH} />
          <clipPath id="px-lagr-clip"><rect x={IX} y={IY} width={IW} height={IH} /></clipPath>
          <g clip-path="url(#px-lagr-clip)">
            {inPaths.map((d, i) => <path class={i < 2 ? 'px-lagr__iso px-lagr__iso--sep' : 'px-lagr__iso'} d={d} />)}
            <line class="px-lagr__ax" x1={IX} x2={IX + IW} y1={isy(0)} y2={isy(0)} />
          </g>
          <circle class="px-lagr__body" cx={isx(1 - mu).toFixed(1)} cy={isy(0).toFixed(1)} r="5" />
          <text class="px-sfig__ax px-lagr__mag" x={IX} y={IY + IH + 16} style={SANS}>Inset, {MAG}× closer</text>
        </g>
        {pts.filter((p) => p.inInset).map((p) => (
          <g data-cue={p.id} data-build="3" data-build-kind="drop">
            <g class="px-lagr__sad">
              <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="6" />
              <line x1={(p.x - 4).toFixed(1)} y1={(p.y - 4).toFixed(1)} x2={(p.x + 4).toFixed(1)} y2={(p.y + 4).toFixed(1)} />
              <line x1={(p.x - 4).toFixed(1)} y1={(p.y + 4).toFixed(1)} x2={(p.x + 4).toFixed(1)} y2={(p.y - 4).toFixed(1)} />
            </g>
            <text class="px-sfig__t px-sfig__b" x={p.x.toFixed(1)} y={(p.y - 12).toFixed(1)} text-anchor="middle" style={SANS}>{p.id}</text>
            <Fragment set:html={svgTag(p.id, p.x, p.y + 20)} />
          </g>
        ))}
        {insetNotes.map((n, i) => (
          <g data-cue={n.id} data-build="3" data-build-kind="drop">
            {wrap(n.text, 20).map((ln, k) => (
              <text class="px-sfig__t px-sfig__b" x={IX} y={IY + IH + 36 + i * 36 + k * 16} style={SANS}>{ln}</text>
            ))}
          </g>
        ))}
      </svg>
    )}
  </div>

  <ul class="px-sfig__key px-lagr__key" data-build="4">
    <li><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M4 4l6 6M4 10l6-6" stroke="currentColor" stroke-width="1.4" /></svg>Unstable saddle</li>
    <li><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6" class="px-lagr__kdot" /></svg>Stable point</li>
    <li><svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><line x1="1" x2="17" y1="7" y2="7" class="px-lagr__kline" /></svg>Equal potential</li>
  </ul>
</div>

<style>
  .px-lagr__figs { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 10px; }
  .px-lagr__map { display: block; flex: none; width: 290px; max-width: 100%; height: auto; overflow: visible; }
  .px-lagr__ins { display: block; flex: none; width: 160px; height: auto; overflow: visible; }
  .px-lagr__iso { fill: none; stroke: var(--accent); stroke-width: 1; }
  .px-lagr__iso--sep { stroke: var(--accent-deep); stroke-width: 1.6; }
  .px-lagr__ax { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 3 4; opacity: 0.6; }
  .px-lagr__ang { fill: none; stroke: var(--ink-2); stroke-width: 1; }
  .px-lagr__win { fill: none; stroke: var(--ink-2); stroke-width: 1; }
  .px-lagr__lead { stroke: var(--hair-2); stroke-width: 1; }
  .px-lagr__frame { fill: var(--paper-2); stroke: var(--ink-2); stroke-width: 1; }
  .px-lagr__sun { fill: var(--accent); }
  .px-lagr__body { fill: var(--ink); }
  .px-lagr__sad circle { fill: var(--paper-2); stroke: var(--ink); stroke-width: 1.5; }
  .px-lagr__sad line { stroke: var(--ink); stroke-width: 1.5; }
  .px-lagr__stable { fill: var(--accent); stroke: var(--paper-2); stroke-width: 2; }
  .px-lagr__mag { fill: var(--muted); }
  .px-lagr__key svg { flex: none; color: var(--ink); }
  .px-lagr__kdot { fill: var(--accent); }
  .px-lagr__kline { stroke: var(--accent); stroke-width: 1.5; }
</style>
