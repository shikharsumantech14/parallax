---
/**
 * LaunchStats — v2 grouped launch-count bars (.ls) inside the elevated .px-viz
 * card. One column per year, one bar per operator; bars grow from the baseline
 * on scroll-in with a staggered delay (gated no-JS-safe via .px-viz.is-in in
 * dataviz-v2.css). Faithful port of publication-v2 <LaunchStats>. Build-time,
 * zero runtime JS.
 *
 * props (unchanged — see SectionRenderer 'launch-stats'):
 *   years[] — { year: number, bars: { label, value, color? }[] }
 *   caption · source
 */
interface Bar { label: string; value: number; color?: string; }
interface YearData { year: number; bars: Bar[]; }
interface Props {
  years: YearData[];
  caption?: string;
  source?: string;
}
const { years = [], caption, source } = Astro.props;

// Fallback palette for bars without an explicit color.
const DEFAULT_COLORS = [
  '#00d4ff', '#ff6b6b', '#b47dff', '#7a8a92',
  '#ffb347', '#4dffb0', '#ff9ecd', '#fff47a',
];
const colorOf = (b: Bar, bi: number) => b.color ?? DEFAULT_COLORS[bi % DEFAULT_COLORS.length];

// Max single-bar value across every year — identical to the kit.
const max = Math.max(1, ...years.flatMap((y) => y.bars.map((b) => b.value)));

// Legend taken from the first year's bars (kit: years[0].bars).
const legend = years.length
  ? years[0].bars.map((b, bi) => ({ label: b.label, color: colorOf(b, bi) }))
  : [];
---

<div class="px-viz" data-reveal role="img"
  aria-label={caption ?? 'Orbital launches per year'}>
  <div class="px-viz__cap"><span>{caption}</span><b>launches / yr</b></div>
  <div class="ls__chart">
    {years.map((yr, yi) => (
      <div class="ls__year">
        <div class="ls__bars">
          {yr.bars.map((b, bi) => (
            <div class="ls__bar"
              style={`--h:${(b.value / max) * 100}%;background:${colorOf(b, bi)};transition-delay:${yi * 60 + bi * 30}ms`}
              title={`${yr.year} · ${b.label}: ${b.value}`} />
          ))}
        </div>
        <span class="ls__yr">{String(yr.year).slice(2)}</span>
      </div>
    ))}
  </div>
  <div class="ls__legend">
    {legend.map((l) => (
      <span class="key"><span class="sw" style={`background:${l.color}`}></span>{l.label}</span>
    ))}
  </div>
  {source && <div class="px-viz__src">Source · {source}</div>}
</div>
