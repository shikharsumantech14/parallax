---
/**
 * ConstellationSwarm (space · FLAGSHIP) — a satellite mega-constellation
 * rendered as the wall of hardware it actually is: every craft an instanced
 * point on its true orbital shell around a line-art Earth, thousands of them,
 * the shells at their real altitude ratios. Where `orbit-globe` draws a handful
 * of named rings, this draws the census. Rendered lazily by the WebGL runtime
 * (scene 'constellation-swarm'); drag to orbit, scroll to zoom, hover any craft
 * for its shell's altitude, tilt, and TRUE count.
 *
 * Blueprint (the contract): docs/design/blueprints/space/constellation-swarm.md.
 * Math: src/scripts/viz3d/kepler.ts (circularPeriodSec, R_EARTH) + the three
 * closed-form shell-placement lines — the SAME numbers compute the static
 * fallback below at build time, so the no-JS / reduced-motion / no-WebGL reader
 * gets the identical epoch-seeded swarm as a composed SVG still.
 *
 * data: { shells: [{name, altKm, inclDeg, count, color?, planes?, raanSpread?}],
 *         epoch?, spin?, caption?, source? }
 */
import { circularPeriodSec, daysSinceJ2000 } from '../../../scripts/viz3d/kepler';

interface Shell {
  name: string; altKm: number; inclDeg: number; count: number;
  color?: string; planes?: number; raanSpread?: number;
}
interface Props {
  shells: Shell[];
  epoch?: string;
  spin?: boolean;
  caption?: string;
  source?: string;
}
const { shells = [], epoch = '2026-01-01', spin = true, caption, source } = Astro.props;

const DEG = Math.PI / 180;
const CAP = 6000;          // live instance cap (scene) — mirrored here for the chip
const FB_CAP = 1500;       // static-SVG dot budget (§7)
const INSET = 0.42, BAND = 0.22;

const valid = shells.filter((s) => s && s.altKm > 0);
const single = valid.length <= 1;
const altMin = Math.min(...valid.map((s) => s.altKm));
const altMax = Math.max(...valid.map((s) => s.altKm));
const rhoOf = (alt: number) =>
  single ? 1 + INSET + BAND / 2 : 1 + BAND * (alt - altMin) / Math.max(1, altMax - altMin) + INSET;

const counts = valid.map((s) => Math.max(0, Math.round(s.count) || 0));
const total = counts.reduce((a, b) => a + b, 0);
const liveSampled = total > CAP;
const liveShown = counts.map((c) => (liveSampled ? Math.max(Math.min(c, 24), Math.round((c * CAP) / total)) : c));
const liveShownTotal = liveShown.reduce((a, b) => a + b, 0);

const defColor = (i: number) => (i === 0 ? 'var(--accent)' : i === 1 ? 'var(--accent-alt)' : 'var(--ink)');
const colorOf = (s: Shell, i: number) => s.color ?? defColor(i);

/* ── build-time fallback: same shell math, projected top-down-tilted (§7) ──
   tilt 0.32 rad about X, yaw 0: (x,y,z) → px = 360 + x·150,
   py = 260 − (y·cos0.32 − z·sin0.32)·150. Static SVG samples to ≤ FB_CAP dots. */
const d0 = daysSinceJ2000(Date.parse(epoch + (epoch.length <= 10 ? 'T12:00:00Z' : '')));
const seedDeg = 360 * (((d0 % 1) + 1) % 1);
const cosT = Math.cos(0.32), sinT = Math.sin(0.32);
const CX = 360, CY = 260, PS = 150;

const fbSampled = total > FB_CAP;
const fbShown = counts.map((c) => (fbSampled ? Math.max(Math.min(c, 12), Math.round((c * FB_CAP) / total)) : c));
const fbShownTotal = fbShown.reduce((a, b) => a + b, 0);

interface FbDot { x: number; y: number; z: number; px: number; py: number; ci: number; }
const dots: FbDot[] = [];
valid.forEach((s, si) => {
  const rho = rhoOf(s.altKm);
  const inc = (s.inclDeg ?? 0) * DEG;
  const ci = Math.cos(inc), sinI = Math.sin(inc);
  const planes = Math.max(6, Math.min(72, s.planes ? Math.round(s.planes) : Math.round(Math.sqrt(counts[si] || 1))));
  const spread = typeof s.raanSpread === 'number' ? s.raanSpread : 360;
  const showN = fbShown[si];
  const satsPerPlane = Math.max(1, Math.ceil(showN / planes));
  const phi = si * 11.7 * DEG;
  for (let k = 0; k < showN; k++) {
    const p = k % planes, j = Math.floor(k / planes);
    const Omega = ((spread / planes) * p) * DEG + phi;
    const nu = ((360 * (j / satsPerPlane) + 0.618 * p * 360 + seedDeg) % 360) * DEG;
    const cO = Math.cos(Omega), sO = Math.sin(Omega);
    const c = Math.cos(nu), sn = Math.sin(nu);
    const x = rho * (c * cO + sn * sinI * sO);
    const y = rho * (sn * ci);
    const z = rho * (-c * sO + sn * sinI * cO);
    dots.push({ x, y, z, px: CX + x * PS, py: CY - (y * cosT - z * sinT) * PS, ci: si });
  }
});
// draw far side first (smaller projected depth toward the camera reads behind)
dots.sort((a, b) => (a.y * cosT - a.z * sinT) - (b.y * cosT - b.z * sinT));

/* two plane guides per shell as projected ellipse polylines */
const guidePaths: { d: string }[] = [];
valid.forEach((s, si) => {
  const rho = rhoOf(s.altKm);
  const inc = (s.inclDeg ?? 0) * DEG;
  const ci = Math.cos(inc), sinI = Math.sin(inc);
  const phi = si * 11.7 * DEG;
  [phi, phi + Math.PI / 2].forEach((Omega) => {
    const cO = Math.cos(Omega), sO = Math.sin(Omega);
    let d = '';
    for (let t = 0; t <= 96; t++) {
      const th = (t / 96) * Math.PI * 2, c = Math.cos(th), sn = Math.sin(th);
      const x = rho * (c * cO + sn * sinI * sO);
      const y = rho * (sn * ci);
      const zz = rho * (-c * sO + sn * sinI * cO);
      const px = CX + x * PS, py = CY - (y * cosT - zz * sinT) * PS;
      d += (t ? 'L' : 'M') + px.toFixed(1) + ' ' + py.toFixed(1);
    }
    guidePaths.push({ d: d + 'Z' });
  });
});

/* faint Earth graticule (parallels + meridians), projected the same way */
const gratPaths: string[] = [];
const projPt = (lat: number, lon: number) => {
  const phi = lat * DEG, lam = lon * DEG;
  const x = Math.cos(phi) * Math.cos(lam);
  const y = Math.sin(phi);
  const z = Math.cos(phi) * Math.sin(lam);
  return { px: CX + x * PS, py: CY - (y * cosT - z * sinT) * PS, front: (y * sinT + z * cosT) };
};
[-60, -30, 0, 30, 60].forEach((lat) => {
  let d = '';
  for (let lon = -180; lon <= 180; lon += 10) { const q = projPt(lat, lon); d += (d ? 'L' : 'M') + q.px.toFixed(1) + ' ' + q.py.toFixed(1); }
  gratPaths.push(d);
});
[-150, -90, -30, 30, 90, 150].forEach((lon) => {
  let d = '';
  for (let lat = -90; lat <= 90; lat += 10) { const q = projPt(lat, lon); d += (d ? 'L' : 'M') + q.px.toFixed(1) + ' ' + q.py.toFixed(1); }
  gratPaths.push(d);
});

const legend = valid.map((s, i) => ({ name: s.name, altKm: Math.round(s.altKm), inclDeg: s.inclDeg ?? 0, count: counts[i], color: colorOf(s, i) }));
const epochLabel = epoch.length <= 10 ? epoch : epoch.slice(0, 10);
const nf = (n: number) => n.toLocaleString('en-US');
const payload = JSON.stringify({ shells: valid, epoch, spin, caption, source });
---

<div class="px-viz px-cswrm" data-reveal>
  {caption && (
    <div class="px-viz__cap">
      <span>{caption}</span>
      {liveSampled && <b>showing {nf(liveShownTotal)} of {nf(total)} craft</b>}
    </div>
  )}

  <div class="viz3d viz3d--cswrm" data-viz3d="constellation-swarm" role="img"
    aria-label={caption ? `Satellite constellation swarm: ${caption}` : 'Satellite constellation swarm'}>
    <div class="viz3d__fallback">
      <svg viewBox="0 0 720 560" preserveAspectRatio="xMidYMid meet">
        <!-- Earth disc + graticule -->
        <circle cx={CX} cy={CY} r={PS} fill="var(--paper)" />
        {gratPaths.map((d) => <path d={d} fill="none" stroke="var(--ink)" stroke-width="0.8" opacity="0.1" />)}
        <circle cx={CX} cy={CY} r={PS} fill="none" stroke="var(--ink)" stroke-width="1" opacity="0.32" />
        <!-- plane guides -->
        {guidePaths.map((g) => <path d={g.d} fill="none" stroke="var(--ink)" stroke-width="0.7" opacity="0.16" />)}
        <!-- the swarm -->
        {dots.map((dt) => <circle cx={dt.px.toFixed(1)} cy={dt.py.toFixed(1)} r="1.3" fill={legend[dt.ci].color} />)}
        <!-- epoch / census stamp -->
        <text x={720 - 10} y={560 - 12} text-anchor="end"
          style="font-family:'JetBrains Mono',ui-monospace,monospace"
          font-size="9.5" fill="var(--muted)" letter-spacing="0.08em">
          {nf(total)} CRAFT · {epochLabel}{fbSampled ? ` · PLOTTING ${nf(fbShownTotal)}` : ''}
        </text>
      </svg>
    </div>
    <span class="viz3d__hint" aria-hidden="true">drag to orbit · scroll to zoom{spin ? ' · 1 s = 90 min' : ''}</span>
    <script type="application/json" class="viz3d__data" set:html={payload}></script>
  </div>

  <ul class="px-cswrm__legend">
    {legend.slice(0, 5).map((s) => (
      <li class="px-cswrm__row">
        <span class="px-cswrm__dot" style={`background:${s.color}`}></span>
        <span class="px-cswrm__name">{s.name}</span>
        <span class="px-cswrm__meta">{nf(s.altKm)} km · {s.inclDeg}° · {nf(s.count)} craft</span>
      </li>
    ))}
    {legend.length > 5 && (
      <li class="px-cswrm__more">
        <details>
          <summary>show all {legend.length} shells</summary>
          <ul class="px-cswrm__legend">
            {legend.slice(5).map((s) => (
              <li class="px-cswrm__row">
                <span class="px-cswrm__dot" style={`background:${s.color}`}></span>
                <span class="px-cswrm__name">{s.name}</span>
                <span class="px-cswrm__meta">{nf(s.altKm)} km · {s.inclDeg}° · {nf(s.count)} craft</span>
              </li>
            ))}
          </ul>
        </details>
      </li>
    )}
    <li class="px-cswrm__total">Σ {nf(total)} craft in {valid.length} shell{valid.length === 1 ? '' : 's'}</li>
  </ul>

</div>

<style>
  .viz3d--cswrm { aspect-ratio: 18 / 14; }

  .px-cswrm__legend { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-direction: column; }
  .px-cswrm__row {
    display: grid; grid-template-columns: 14px auto 1fr; gap: 12px; align-items: baseline;
    padding: 8px 0; border-bottom: 1px dashed var(--rule);
    font-variant-numeric: tabular-nums;
  }
  .px-cswrm__dot { width: 9px; height: 9px; border-radius: 2px; align-self: center; box-shadow: 0 0 0 1px color-mix(in oklab, var(--ink) 12%, transparent); }
  .px-cswrm__name { font-family: var(--font-display); font-size: 15px; color: var(--ink); font-weight: 600; }
  .px-cswrm__meta {
    font-family: var(--font-mono); font-size: var(--viz-fs-legend, 10px);
    letter-spacing: 0.06em; color: var(--muted); text-align: right;
  }
  .px-cswrm__more { padding: 4px 0 0; }
  .px-cswrm__more summary {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent-deep, var(--accent)); cursor: pointer;
    padding: 8px 0; list-style-position: inside;
  }
  .px-cswrm__more .px-cswrm__legend { margin-top: 0; }
  .px-cswrm__total {
    margin-top: 12px; font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 480px) {
    .px-cswrm__row { grid-template-columns: 12px 1fr; gap: 8px; }
    .px-cswrm__meta { grid-column: 1 / -1; text-align: left; padding-left: 20px; }
  }
</style>
