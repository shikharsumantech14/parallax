---
/**
 * DescentProfile (space) — an altitude-against-time profile (a descent or an
 * ascent): one smooth line over a tinted area, the craft at its first point,
 * each named event flagged on the line with its altitude, and the starting
 * altitude set large above the plot. Drawn for the pinned figure panel (Lens
 * Phase 6, 2026-09-30; board Lib-descent-profile): a 470-unit SVG, 12px axis
 * type, 13px event labels placed by one collision rule (beside the point,
 * then the other side, then stacked), so no two labels touch whatever the
 * data.
 *
 * Time carries no unit in the data (seconds on one issue, months on another),
 * so the x-axis prints its ticks only and the caption names the unit.
 *
 * Cue anchors: `1`…`n` — each event in authored order (its point, label and
 * numeral); `start` — the craft at the first point, and the headline number
 * that reports its altitude; `line` — the profile; `axis`.
 *
 * THE BUILD (LENS §6.4): 1 the axes fade, 2 the area fades and the line
 * draws, 3 the event flags drop in time order, 4 the headline counts up.
 *
 * A point's `phase` rides as its dot's <title>; `craftLabel` names the craft
 * in the headline and on its glyph.
 *
 * data: { points[]{ t, altKm, phase? }, events?[]{ t, label }, craftLabel?,
 *         caption?, source? }
 */
import { SANS, nf, dpOf, svgTag, niceTicks, smooth, textW, tbox, hit, wrap, type Box } from './_fig';

interface Point { t: number; altKm: number; phase?: string; }
interface EventMark { t: number; label: string; }
interface Props {
  points: Point[];
  events?: EventMark[];
  craftLabel?: string;
  caption?: string;
  source?: string;
}
const { points = [], events = [], craftLabel, caption } = Astro.props;
/* Drawn twice (Lens Phase 6): at 470 for the panel and at 290 for a phone,
   one shown by the .px-sfig__dual rule in dataviz-v2.css, so every label
   prints at 12px or more at both widths and nothing has to scroll. */
const W: number = (Astro.props as any).w ?? 470;
const dual = (Astro.props as any).w == null;

const pts = (Array.isArray(points) ? points : [])
  .map((p) => ({ t: p?.t ?? 0, altKm: Math.max(0, p?.altKm ?? 0), phase: p?.phase }))
  .sort((a, b) => a.t - b.t);
const evs = (Array.isArray(events) ? events : []).map((e, i) => ({ id: String(i + 1), t: e?.t ?? 0, label: e?.label ?? '' }));

// ── frame ───────────────────────────────────────────────────────────────────
const H = 300, L = 44, R = W - 10, T = 26, B = H - 30;
const tMin = pts.length ? pts[0].t : 0;
const tMax = pts.length ? pts[pts.length - 1].t : 1;
const span = Math.max(1e-6, tMax - tMin);
const step = (() => { const t = niceTicks(span, 4); return t.length > 1 ? t[1] : span; })();
const xt: number[] = [];
for (let v = Math.ceil(tMin / step - 1e-9) * step; v <= tMax + 1e-9; v += step) xt.push(+v.toFixed(9));
const yt = niceTicks(Math.max(1, ...pts.map((p) => p.altKm)) * 1.04, 4);
const yMax = yt[yt.length - 1];
const X = (t: number) => L + ((t - tMin) / span) * (R - L);
const Y = (a: number) => B - (a / yMax) * (B - T);
const nodes = pts.map((p) => ({ ...p, x: X(p.t), y: Y(p.altKm) }));
const line = smooth(nodes);
const area = nodes.length > 1 ? `${line} L${nodes[nodes.length - 1].x.toFixed(1)} ${B} L${nodes[0].x.toFixed(1)} ${B} Z` : '';

function altAt(t: number): number {
  if (!nodes.length) return 0;
  if (t <= nodes[0].t) return nodes[0].altKm;
  for (let i = 0; i < nodes.length - 1; i++) {
    const a = nodes[i], b = nodes[i + 1];
    if (t >= a.t && t <= b.t) return a.altKm + (b.altKm - a.altKm) * ((t - a.t) / Math.max(1e-9, b.t - a.t));
  }
  return nodes[nodes.length - 1].altKm;
}
const fmtAlt = (a: number) => (a >= 10 ? nf(a) : String(+a.toFixed(a < 1 ? 2 : 1)));
const fmtT = (v: number) => (v < 0 ? '−' : '') + nf(Math.abs(v), Math.min(1, dpOf(v)));

// ── event flags: one collision rule ──────────────────────────────────────────
const FS = 13;
const placed: Box[] = [];
yt.forEach((v) => placed.push(tbox(L - 8, Y(v) + 4, textW(nf(v), 12), 'end', 12)));
placed.push(tbox(0, 12, textW('Altitude (km)', 12), 'start', 12));
const craft = nodes[0];
if (craft) placed.push({ x0: craft.x - 16, y0: craft.y - 8, x1: craft.x + 16, y1: craft.y + 8 });
const flags = evs.map((e) => {
  const x = X(e.t), a = altAt(e.t), y = Y(a);
  const alt = `${fmtAlt(a)} km`;
  // one line where it fits; on the narrow drawing the name wraps and the
  // altitude takes its own line, so a flag never runs off the plot
  const oneW = textW(e.label, FS, true) + textW(` · ${alt}`, FS) + 24;
  const single = oneW <= (R - L) * 0.75;
  const nameLines = single ? [e.label] : wrap(e.label, Math.max(12, Math.floor(((R - L) * 0.5) / 8)));
  const w = single ? oneW : Math.max(...nameLines.map((l) => textW(l, FS, true)), textW(alt, FS)) + 24;
  const nl = single ? 1 : nameLines.length + 1;
  const boxAt = (lx: number, ly: number, anchor: 'start' | 'end'): Box => {
    const b = tbox(lx, ly, w, anchor, FS);
    return { ...b, y1: b.y1 + (nl - 1) * 16 };
  };
  // every spot in the plot, nearest the point first; the first clear one wins
  const cands: { lx: number; ly: number; anchor: 'start' | 'end'; d: number }[] = [];
  for (let ly = T + 2; ly <= B - 6 - (nl - 1) * 16; ly += 6) {
    for (const anchor of ['start', 'end'] as const) {
      const lx = anchor === 'start' ? x + 8 : x - 8;
      if (anchor === 'start' ? lx + w > R + 6 : lx - w < 2) continue;
      const mid = ly + ((nl - 1) * 16) / 2 - 4;
      cands.push({ lx, ly, anchor, d: Math.abs(mid - y) + (Math.abs(mid - y) < 8 ? 40 : 0) + (anchor === 'end' ? 6 : 0) });
    }
  }
  cands.sort((p, q) => p.d - q.d);
  let pick: { lx: number; ly: number; anchor: 'start' | 'end'; box: Box } | null = null;
  for (const c of cands) {
    const box = boxAt(c.lx, c.ly, c.anchor);
    if (!placed.some((q) => hit(box, q, 3))) { pick = { lx: c.lx, ly: c.ly, anchor: c.anchor, box }; break; }
  }
  if (!pick) {
    const c = cands[0] ?? { lx: x + 8, ly: Math.max(T + 2, y - 10), anchor: 'start' as const };
    pick = { lx: c.lx, ly: c.ly, anchor: c.anchor, box: boxAt(c.lx, c.ly, c.anchor) };
  }
  placed.push(pick.box);
  const tagCx = pick.anchor === 'start' ? pick.lx + 12 : pick.lx - 12;
  const textX = pick.anchor === 'start' ? pick.lx + 24 : pick.lx - 24;
  return { ...e, x, y, single, nameLines, alt, ...pick, tagCx, textX, lead: Math.abs(pick.ly - 4 - y) > 12 };
});

const headDp = craft ? Math.min(1, dpOf(craft.altKm)) : 0;
const who = craftLabel ?? (craft?.phase || 'start');
const aria = caption ? `Altitude profile: ${caption}` : `Altitude profile${craftLabel ? ` of ${craftLabel}` : ''}`;
---
{dual ? (
  <div class="px-sfig__dual">
    <Astro.self {...Astro.props} w={470} />
    <Astro.self {...Astro.props} w={290} />
  </div>
) : (
<Fragment>

<div class="px-viz px-desc" data-build-scene>
  {craft && (
    <div class="px-sfig__head" data-cue="start">
      <span class="px-sfig__num" data-build="4" data-build-kind="counter" data-to={craft.altKm} data-format={headDp ? '1dp' : undefined}>{nf(craft.altKm, headDp)}</span>
      <span class="px-sfig__lbl"><span class="px-cue-tag" data-cue-tag="start" hidden></span>km at the start, {who}</span>
    </div>
  )}

  <div class="px-sfig__plot">
    <svg class="px-sfig__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
      <g data-cue="axis" data-build="1">
        {yt.map((v) => (
          <>
            <line class="px-sfig__grid" x1={L} x2={R} y1={Y(v).toFixed(1)} y2={Y(v).toFixed(1)} />
            <text class="px-sfig__ax" x={L - 8} y={(Y(v) + 4).toFixed(1)} text-anchor="end" style={SANS}>{nf(v)}</text>
          </>
        ))}
        {xt.map((v, i) => (
          <text class="px-sfig__ax" x={X(v).toFixed(1)} y={B + 18} text-anchor={i === xt.length - 1 && X(v) > R - 12 ? 'end' : 'middle'} style={SANS}>{fmtT(v)}</text>
        ))}
        <line class="px-sfig__base" x1={L} x2={R} y1={B} y2={B} />
        <text class="px-sfig__at" x="0" y="12" style={SANS}>Altitude (km)</text>
      </g>

      <g data-cue="line">
        {area && <path class="px-desc__area" d={area} data-build="2" />}
        {line && <path class="px-desc__line" d={line} data-build="2" data-build-kind="draw" />}
        {nodes.map((p) => (
          <circle class="px-desc__pt" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="3">{p.phase && <title>{p.phase}</title>}</circle>
        ))}
      </g>

      {craft && (
        <g class="px-desc__craft" data-cue="start">
          <title>{craftLabel ?? 'Craft'}</title>
          <rect x={(craft.x - 13).toFixed(1)} y={(craft.y - 5).toFixed(1)} width="8" height="10" rx="1" />
          <rect x={(craft.x - 5).toFixed(1)} y={(craft.y - 1.5).toFixed(1)} width="10" height="3" />
          <rect x={(craft.x + 5).toFixed(1)} y={(craft.y - 5).toFixed(1)} width="8" height="10" rx="1" />
        </g>
      )}

      {flags.map((f) => (
        <g class="px-desc__flag" data-cue={f.id} data-build="3" data-build-kind="drop">
          {f.lead && <line class="px-desc__lead" x1={f.x.toFixed(1)} y1={f.y.toFixed(1)} x2={f.lx.toFixed(1)} y2={(f.ly - 4).toFixed(1)} />}
          <circle class="px-desc__ev" cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r="4.5" />
          <text class="px-sfig__t" x={f.textX.toFixed(1)} y={f.ly.toFixed(1)} text-anchor={f.anchor} style={SANS}>
            {f.single ? (
              <><tspan class="px-sfig__b">{f.label}</tspan><tspan class="px-sfig__m"> · {f.alt}</tspan></>
            ) : (
              <>
                {f.nameLines.map((ln: string, i: number) => <tspan class="px-sfig__b" x={f.textX.toFixed(1)} dy={i ? 16 : 0}>{ln}</tspan>)}
                <tspan class="px-sfig__m" x={f.textX.toFixed(1)} dy="16">{f.alt}</tspan>
              </>
            )}
          </text>
          <Fragment set:html={svgTag(f.id, f.tagCx, f.ly - 4)} />
        </g>
      ))}
    </svg>
  </div>
</div>
</Fragment>
)}

<style>
  .px-desc__area { fill: var(--accent-tint); opacity: 0.7; }
  .px-desc__line { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .px-desc__pt { fill: var(--paper-2); stroke: var(--accent); stroke-width: 1.5; }
  .px-desc__ev { fill: var(--accent); stroke: var(--paper-2); stroke-width: 2; }
  .px-desc__lead { stroke: var(--hair-2); stroke-width: 1; }
  .px-desc__craft rect { fill: var(--accent-deep); }
</style>
