---
/**
 * DeltaVLadder (space) — a Δv (velocity-change) budget as stacked columns on
 * one scale. Segments whose labels chain as "A → B" (the end of one is the
 * start of the next) are laid out as ROUTES: each route from the first origin
 * to a destination is one column, so alternatives (on to GEO, or out to
 * escape) stand side by side instead of adding up to a number no mission
 * spends. Labels that do not chain stack as one column. Drawn for the pinned
 * figure panel (Lens Phase 6, 2026-09-30; board Lib-delta-v-ladder), the
 * largest single step set large above it.
 *
 * Cue anchors: `1`…`n` — each segment in authored order (its band in every
 * column that climbs it, and its label); `total-1`…`total-k` — each column's
 * total, left to right; `axis`. The headline carries the anchor of the
 * segment it reports.
 *
 * THE BUILD (LENS §6.4): 1 the axis fades, 2 the bands grow up from their own
 * floors (bottom band first), 3 the labels rise, 4 the column totals fade,
 * 5 the headline counts up.
 *
 * Colour: a segment's `color` is honoured as a fixed encoding; otherwise the
 * bands step through the desk inks (mark, text, a tint of the mark).
 *
 * data: { segments[]{ label, dv, color? }, unit?, caption?, source? }
 */
import { SANS, nf, niceTicks, textW, wrap } from './_fig';

interface Segment { label: string; dv: number; color?: string; }
interface Props {
  segments: Segment[];
  unit?: string;
  caption?: string;
  source?: string;
}
const { segments = [], unit = 'm/s', caption } = Astro.props;
/* Drawn twice (Lens Phase 6): at 470 for the panel and at 290 for a phone,
   one shown by the .px-sfig__dual rule in dataviz-v2.css, so every label
   prints at 12px or more at both widths and nothing has to scroll. */
const W: number = (Astro.props as any).w ?? 470;
const dual = (Astro.props as any).w == null;

const segs = (Array.isArray(segments) ? segments : []).map((s, i) => {
  const label = s?.label ?? '';
  const m = label.split(/\s*(?:→|->)\s*/);
  return { id: String(i + 1), label, dv: Math.max(0, s?.dv ?? 0), color: s?.color, from: m.length === 2 ? m[0].trim() : null, to: m.length === 2 ? m[1].trim() : null };
});

// ── routes: chain "A → B" labels from the first segment's origin ────────────
type Seg = (typeof segs)[number];
let routes: Seg[][] = [];
const chains = segs.length > 0 && segs.every((s) => s.from && s.to);
if (chains) {
  const walk = (at: string, path: Seg[]) => {
    const next = segs.filter((s) => s.from === at && !path.includes(s));
    if (!next.length) { if (path.length) routes.push(path); return; }
    next.forEach((s) => walk(s.to!, [...path, s]));
  };
  walk(segs[0].from!, []);
  // every segment must sit on a route, or the chain reading is wrong
  if (!segs.every((s) => routes.some((r) => r.includes(s)))) routes = [];
}
if (!routes.length) routes = [segs];
const colName = (r: Seg[]) => {
  const end = r[r.length - 1];
  return routes.length > 1 && end?.to ? `To ${end.to.replace(/\s*\(.*?\)\s*/g, '').trim()}` : '';
};

// ── frame ───────────────────────────────────────────────────────────────────
const H = 330, L = 52, R = W - 4, T = 34, B = H - 40;
const totals = routes.map((r) => r.reduce((a, s) => a + s.dv, 0));
const yt = niceTicks(Math.max(1, ...totals), 5);
const yMax = yt[yt.length - 1];
const Y = (v: number) => B - (v / yMax) * (B - T);
const slot = (R - L - 12) / routes.length;
const barW = Math.min(96, slot * (W < 400 ? 0.4 : 0.46));
const TONES = ['var(--accent)', 'var(--accent-deep)', 'color-mix(in oklab, var(--accent) 50%, var(--paper-2))', 'color-mix(in oklab, var(--accent-deep) 60%, var(--paper-2))'];

const cols = routes.map((r, k) => {
  const x = L + 12 + k * slot;
  let acc = 0;
  const bands = r.map((s, j) => {
    const y0 = Y(acc), y1 = Y(acc + s.dv);
    acc += s.dv;
    return { ...s, y: y1, h: y0 - y1, mid: (y0 + y1) / 2, fill: s.color ?? TONES[j % TONES.length] };
  });
  // outside labels, right of the column, stacked so none touch
  const lx = x + barW + 8;
  const maxChars = Math.max(6, Math.floor((slot - barW - 14) / (13 * 0.62)));
  let floor = B + 8;
  const labels = [...bands].map((b) => {
    const lines = wrap(b.label, maxChars);
    const h = lines.length * 16 + 15;
    let top = Math.max(T, b.mid - h / 2);
    if (top + h > floor) top = floor - h;
    floor = top - 2;
    return { id: b.id, lines, top, dv: b.dv };
  });
  return { x, bands, labels, total: totals[k], name: colName(r) };
});
const big = segs.reduce((m, s) => (s.dv > (m?.dv ?? -1) ? s : m), segs[0]);
const aria = caption ? `Delta-v budget: ${caption}` : 'Delta-v budget';
---
{dual ? (
  <div class="px-sfig__dual">
    <Astro.self {...Astro.props} w={470} />
    <Astro.self {...Astro.props} w={290} />
  </div>
) : (
<Fragment>

<div class="px-viz px-dvl" data-build-scene>
  {big && (
    <div class="px-sfig__head" data-cue={big.id}>
      <span class="px-sfig__num" data-build="5" data-build-kind="counter" data-to={Math.round(big.dv)}>{nf(big.dv)}</span>
      <span class="px-sfig__lbl"><span class="px-cue-tag" data-cue-tag={big.id} hidden></span>{unit} · {big.label}</span>
    </div>
  )}

  <div class="px-sfig__plot">
    <svg class="px-sfig__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
      <g data-cue="axis" data-build="1">
        {yt.map((v) => (
          <>
            <line class="px-sfig__grid" x1={L} x2={R} y1={Y(v).toFixed(1)} y2={Y(v).toFixed(1)} />
            <text class="px-sfig__ax" x={L - 8} y={(Y(v) + 4).toFixed(1)} text-anchor="end" style={SANS}>{nf(v)}</text>
          </>
        ))}
        <line class="px-sfig__base" x1={L} x2={R} y1={B} y2={B} />
        <text class="px-sfig__at" x="0" y="12" style={SANS}>Δv ({unit})</text>
        {cols.map((c) => c.name && (
          <text class="px-sfig__ax px-dvl__col" x={(c.x + barW / 2).toFixed(1)} y={B + 20} text-anchor="middle" style={SANS}>{c.name}</text>
        ))}
      </g>

      {cols.map((c) => c.bands.map((b) => (
        <g data-cue={b.id}>
          <rect class="px-dvl__band" x={c.x.toFixed(1)} y={b.y.toFixed(1)} width={barW.toFixed(1)} height={Math.max(0, b.h - 1).toFixed(1)} style={`fill:${b.fill}`} data-build="2" data-build-kind="grow-y" />
        </g>
      )))}

      {cols.map((c) => c.labels.map((l) => (
        <g data-cue={l.id} data-build="3" data-build-kind="rise">
          <line class="px-dvl__lead" x1={(c.x + barW + 1).toFixed(1)} x2={(c.x + barW + 5).toFixed(1)} y1={(l.top + 6).toFixed(1)} y2={(l.top + 6).toFixed(1)} />
          <text class="px-sfig__t px-sfig__b" x={(c.x + barW + 8).toFixed(1)} y={(l.top + 11).toFixed(1)} style={SANS}>
            {l.lines.map((ln, i) => <tspan x={(c.x + barW + 8).toFixed(1)} dy={i ? 16 : 0}>{ln}</tspan>)}
          </text>
          <text class="px-sfig__t px-sfig__m" x={(c.x + barW + 8).toFixed(1)} y={(l.top + 11 + l.lines.length * 16).toFixed(1)} style={SANS}>+{nf(l.dv)}</text>
          <Fragment set:html={`<foreignObject x="${(c.x + barW / 2 - 10).toFixed(1)}" y="${(c.bands.find((b) => b.id === l.id)!.mid - 10).toFixed(1)}" width="20" height="20" style="overflow:visible"><div xmlns="http://www.w3.org/1999/xhtml" style="display:flex;align-items:center;height:20px;line-height:1"><span class="px-cue-tag" data-cue-tag="${l.id}" hidden></span></div></foreignObject>`} />
        </g>
      )))}

      {cols.map((c, k) => (
        <g data-cue={`total-${k + 1}`} data-build="4">
          <line class="px-dvl__cap" x1={(c.x - 4).toFixed(1)} x2={(c.x + barW + 4).toFixed(1)} y1={Y(c.total).toFixed(1)} y2={Y(c.total).toFixed(1)} />
          <text class="px-sfig__t px-sfig__b" x={(c.x + barW / 2).toFixed(1)} y={(Y(c.total) - 8).toFixed(1)} text-anchor="middle" style={SANS}>{nf(c.total)}{W < 400 ? '' : ` ${unit}`}</text>
        </g>
      ))}
    </svg>
  </div>
</div>
</Fragment>
)}

<style>
  .px-dvl__band { stroke: var(--paper-2); stroke-width: 1; }
  .px-dvl__lead { stroke: var(--ink-2); stroke-width: 1; }
  .px-dvl__cap { stroke: var(--ink); stroke-width: 2; }
  .px-dvl__col { fill: var(--ink-2); font-weight: 500; }
</style>
