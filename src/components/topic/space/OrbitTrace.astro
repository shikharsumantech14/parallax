---
/**
 * OrbitTrace — v2 orbital diagram (.ot) inside the elevated .px-viz card.
 * A compact Earth with log-scaled orbit rings; one satellite per ring rides
 * its ellipse via SVG <animateMotion>. Rings fade in and the legend rows
 * slide in on scroll (gated no-JS-safe in dataviz-v2.css via .px-viz.is-in).
 * Faithful port of publication-v2 <OrbitTrace>. Build-time, zero runtime JS.
 *
 * props (unchanged — see SectionRenderer 'orbit-trace'):
 *   orbits[]      — { name, altKm, inclDeg?, color?, satCount?, note? }
 *   earthRadiusPx — accepted for back-compat (kit uses a fixed Earth radius)
 *   maxAltKm      — scale ceiling in km (defaults to max altKm across orbits)
 *   caption · source
 */
interface Orbit {
  name: string;
  altKm: number;
  inclDeg?: number;
  color?: string;
  satCount?: number;
  note?: string;
}
interface Props {
  orbits?: Orbit[];
  earthRadiusPx?: number;
  maxAltKm?: number;
  caption?: string;
  source?: string;
}
const { orbits = [], maxAltKm, caption, source } = Astro.props;

// Default colors for orbits if not specified (kit binds o.color directly).
const DEFAULT_COLORS = [
  '#00d4ff', '#ffb347', '#b47dff', '#ff6b6b',
  '#4dffb0', '#ff9ecd', '#fff47a', '#80d8ff',
];

// Geometry — identical constants/formula to the kit JSX.
const C = 200, cx = C / 2, cy = C / 2, earthR = 16, maxR = 92;
const ceiling = maxAltKm ?? Math.max(1, ...orbits.map((o) => o.altKm));
const rFor = (alt: number) => earthR + (Math.log(alt + 1) / Math.log(ceiling + 1)) * (maxR - earthR);

const items = orbits.map((o, i) => ({
  ...o,
  color: o.color ?? DEFAULT_COLORS[i % DEFAULT_COLORS.length],
  r: rFor(o.altKm),
  dur: 6 + i * 2.5,
}));
---

<div class="px-viz ot" data-reveal role="img"
  aria-label={caption ? `Orbital diagram: ${caption}` : 'Orbital diagram'}>
  <div class="ot__stage">
    <svg class="ot__svg" viewBox={`0 0 ${C} ${C}`}>
      {items.map((o, i) => (
        <circle class="ot__ring" cx={cx} cy={cy} r={o.r}
          style={`transition-delay:${i * 120}ms;stroke:${o.color}`} />
      ))}
      <circle class="ot__earth" cx={cx} cy={cy} r={earthR} />
      {items.map((o) => (
        <circle class="ot__sat" r="3.5" fill={o.color}>
          <animateMotion dur={`${o.dur}s`} repeatCount="indefinite"
            path={`M ${cx + o.r} ${cy} A ${o.r} ${o.r} 0 1 1 ${cx - o.r} ${cy} A ${o.r} ${o.r} 0 1 1 ${cx + o.r} ${cy} Z`} />
        </circle>
      ))}
    </svg>
  </div>
  <div>
    <div class="px-viz__cap" style="margin-bottom:14px"><span>{caption}</span></div>
    <div class="ot__legend">
      {items.map((o) => (
        <div class="ot__item">
          <span class="ot__dot" style={`background:${o.color}`}></span>
          <span class="ot__name">{o.name}</span>
          <span class="ot__alt">{o.altKm.toLocaleString()} km{o.inclDeg != null ? ` · ${o.inclDeg}°` : ''}</span>
          {o.satCount != null && (
            <span class="ot__count">{o.satCount.toLocaleString()} active{o.note ? ' · ' + o.note.split('.')[0] + '.' : ''}</span>
          )}
        </div>
      ))}
    </div>
    {source && <div class="px-viz__src">Source · {source}</div>}
  </div>
</div>
