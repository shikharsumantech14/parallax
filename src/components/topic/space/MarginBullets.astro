---
/**
 * MarginBullets (`margin-bullets`) — several measurements, each against its own
 * requirement and in its own unit. The reader learns which ones close and
 * which do not, without being invited to compare quantities that do not
 * compare. Blueprint: docs/design/blueprints/space/margin-bullets.md.
 *
 * Lens Phase 6 (2026-09-30; board Lib-margin-bullets): one card per row, the
 * label and its verdict ("Short by 8 kg" / "Clear by 1.8 dB") on top, the bar
 * against its own track with the requirement as an ink tick, the value and
 * the mark underneath; the worst shortfall set large above. Pure HTML/CSS
 * inside core/VizCard.astro (whose root is the build scene). The row picker,
 * its readout, the legend and the fallback table retired with the redraw:
 * every value, mark and margin is printed on its card, and the article's cues
 * do what pressing a row did. A row's `note` is kept for assistive tech.
 *
 * Cue anchors: `1`…`n` — each row in authored order (its whole card). The
 * headline carries the anchor of the row it reports.
 *
 * THE BUILD (LENS §6.4): 1 the cards drop, 2 the bars grow from the left,
 * 3 the verdicts rise, 4 the headline counts up.
 *
 * Colour: bars in the desk mark, the requirement tick in ink, a short row's
 * verdict in the desk text ink with an ink card edge.
 */
import VizCard from '../../core/VizCard.astro';

interface Row {
  /** MUST carry or imply the unit — there is no shared axis to carry it. */
  label: string;
  value: number;
  required: number;
  /** The row's OWN full range; sets 100% of this row's track and nothing else. */
  max: number;
  /** Printed after the number; a space is supplied unless it binds (%, °). */
  unit: string;
  note?: string;
}
interface Props {
  rows?: Row[];
  caption?: string;
  source?: string | { label: string; date?: string };
  howToRead?: string;
}

const { rows: input = [], caption } = Astro.props;

/* ── Build-time validation (blueprint §3) ──────────────────────────────────
   Every bar here is normalised to its own `max`, so a row whose numbers fall
   outside that range does not render badly — it renders *plausibly*, at a
   length that means something it is not. That is a published false claim, and
   it must cost a build instead. */
if (input.length < 4 || input.length > 8) {
  throw new Error(`[margin-bullets] needs 4–8 rows, got ${input.length}. See blueprint §10.`);
}

input.forEach((r, i) => {
  const name = r && r.label ? r.label : `row ${i + 1}`;
  if (!r || typeof r !== 'object') {
    throw new Error(`[margin-bullets] ${name} is not an object: ${JSON.stringify(r)}.`);
  }
  // The unit is not decoration. With six independent scales, two bars of equal
  // length have nothing in common, and a bare number is unreadable.
  if (typeof r.unit !== 'string' || r.unit.trim() === '') {
    throw new Error(`[margin-bullets] row "${name}" has no unit. Every row must carry one — the rows share no axis.`);
  }
  ([['value', r.value], ['required', r.required], ['max', r.max]] as const).forEach(([k, v]) => {
    if (typeof v !== 'number' || !Number.isFinite(v)) {
      throw new Error(`[margin-bullets] row "${name}": ${k} must be a finite number, got ${JSON.stringify(v)}.`);
    }
  });
  if (!(r.required > 0 && r.required <= r.max)) {
    throw new Error(
      `[margin-bullets] row "${name}" breaks 0 < required <= max: required ${r.required}, max ${r.max}.`,
    );
  }
  if (!(r.value >= 0 && r.value <= r.max)) {
    throw new Error(
      `[margin-bullets] row "${name}" breaks 0 <= value <= max: value ${r.value}, max ${r.max}.`,
    );
  }
});

/* Decimal places are DERIVED from the authored numbers rather than looked up
   from a unit table: `unit` is free text, so a table would silently mis-round
   any unit nobody thought of. 4.8 against 3 → 1 dp; 84 against 40 → 0 dp,
   which is exactly the convention blueprint §4 asks for. */
const decimalsOf = (n: number) => {
  const s = String(n);
  if (s.indexOf('e') >= 0 || s.indexOf('E') >= 0) return 0;
  const dot = s.indexOf('.');
  return dot < 0 ? 0 : Math.min(3, s.length - dot - 1);
};

/* The unit is printed after the number. The blueprint asks authors for a
   leading space where the convention is "4.8 dB", but every author who has
   used this kind wrote `unit: "minutes of the scheduled hour"` and shipped
   "0.6minutes" (measured live 2026-09-22). So the space is supplied here
   unless the unit already starts with one or is a symbol that binds to the
   number (%, °, ′, ″). */
const unitOut = (u: string) => (/^[\s%°′″]/.test(u) ? u : ` ${u}`);

const rows = input.map((r, i) => {
  const dp = Math.max(decimalsOf(r.value), decimalsOf(r.required));
  const margin = r.value - r.required;
  const ok = r.value >= r.required;
  const valueText = r.value.toFixed(dp);
  const reqText = r.required.toFixed(dp);
  const sign = margin > 0 ? '+' : margin < 0 ? '−' : '±';
  // The true minus sign (U+2212), not a hyphen: at mono 11px in a tabular
  // column a hyphen reads as a dash and the sign is the whole point.
  const marginNum = `${sign}${Math.abs(margin).toFixed(dp)}`;
  const u = unitOut(r.unit);
  return {
    ...r,
    i,
    ok,
    dp,
    valueText,
    reqText,
    marginNum,
    unitText: u,
    marginText: `${marginNum}${u}`,
    vsText: `${valueText}${u} against a mark of ${reqText}${u}`,
    // Blueprint §8: where the margin is negative the readout says so in words,
    // because a minus sign is easy to miss and this is the whole argument.
    // Desk-neutral wording: the kind was written for spacecraft subsystems and
    // shipped "this subsystem does not close" on a Parliament issue.
    noteText: [r.note, ok ? '' : 'This one falls short of its mark.'].filter(Boolean).join(' ') || '—',
    vPct: (r.value / r.max) * 100,
    rPct: (r.required / r.max) * 100,
  };
});

/* The headline: the worst RELATIVE shortfall, since the rows share no unit
   (8 kg short of 30 is worse than 8 W short of 400). None short, no headline. */
let worstIdx = -1;
let worst = 0;
rows.forEach((r) => {
  if (r.ok) return;
  const shortfall = (r.required - r.value) / r.required;
  if (shortfall > worst) { worst = shortfall; worstIdx = r.i; }
});
const w = worstIdx >= 0 ? rows[worstIdx] : null;
const shortBy = w ? w.required - w.value : 0;
const aria = caption ? `Margins against their requirements: ${caption}` : 'Margins against their requirements';
---

<VizCard prefix="px-mgb">
  {w && (
    <div class="px-mgb__head" data-cue={w.i + 1}>
      <span class="px-mgb__num" data-build="4" data-build-kind="counter" data-to={+shortBy.toFixed(Math.min(1, w.dp))} data-format={w.dp ? '1dp' : undefined}>{shortBy.toFixed(Math.min(1, w.dp))}</span>
      <span class="px-mgb__hl"><span class="px-cue-tag" data-cue-tag={w.i + 1} hidden></span>{w.unit.trim()} short, {w.label}</span>
    </div>
  )}
  <ol class="px-mgb__rows" role="list" aria-label={aria}>
    {rows.map((r) => (
      <li class="px-mgb__row" data-ok={r.ok ? 'true' : 'false'} data-cue={r.i + 1} data-build="1" data-build-kind="drop">
        <div class="px-mgb__top">
          <span class="px-mgb__label"><span class="px-cue-tag" data-cue-tag={r.i + 1} hidden></span>{r.label}</span>
          <span class="px-mgb__ver" data-build="3" data-build-kind="rise">{r.ok ? 'Clear by' : 'Short by'} {Math.abs(r.value - r.required).toFixed(r.dp)}{r.unitText}</span>
        </div>
        <span class="px-mgb__track" aria-hidden="true">
          <span class="px-mgb__bar" style={`width:${r.vPct.toFixed(3)}%`} data-build="2" data-build-kind="grow-x"></span>
          <span class="px-mgb__tick" style={`left:${r.rPct.toFixed(3)}%`}></span>
        </span>
        <div class="px-mgb__foot">
          <span>{r.valueText}{r.unitText}</span>
          <span>mark {r.reqText}{r.unitText}</span>
        </div>
        {r.note && <span class="px-mgb__sr">{r.note}</span>}
      </li>
    ))}
  </ol>
</VizCard>

<style>
  .px-mgb__head { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin: 0 0 16px; }
  .px-mgb__num {
    font-family: var(--font-ui); font-size: 96px; line-height: 0.92; font-weight: 600;
    font-variant-numeric: tabular-nums; letter-spacing: -0.02em; color: var(--accent-deep);
  }
  .px-mgb__hl { display: inline-flex; align-items: center; font-family: var(--font-ui); font-size: 14px; line-height: 1.3; font-weight: 500; color: var(--ink-2); min-width: 0; }
  @media (max-width: 599px) { .px-mgb__num { font-size: 72px; } }
  .px-mgb__rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .px-mgb__row {
    position: relative; display: grid; gap: 8px; padding: 12px 14px;
    border: 1px solid var(--hair); border-radius: var(--r-card, 6px); background: var(--paper-2);
  }
  .px-mgb__row[data-ok='false'] { border-color: var(--ink); }
  .px-mgb__top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .px-mgb__label { display: inline-flex; align-items: center; min-width: 0; font-family: var(--font-ui); font-size: 14px; line-height: 1.3; font-weight: 600; color: var(--ink); }
  .px-mgb__ver { flex: none; max-width: 50%; text-align: right; font-family: var(--font-ui); font-size: 13px; line-height: 1.3; font-weight: 500; color: var(--muted); font-variant-numeric: tabular-nums; }
  .px-mgb__row[data-ok='false'] .px-mgb__ver { color: var(--accent-deep); font-weight: 600; }
  .px-mgb__track { position: relative; display: block; height: 12px; border-radius: 2px; background: var(--paper-3); }
  .px-mgb__bar { position: absolute; left: 0; top: 0; bottom: 0; background: var(--accent); border-radius: 2px 0 0 2px; transform-origin: 0 50%; }
  .px-mgb__tick { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: var(--ink); }
  .px-mgb__foot { display: flex; justify-content: space-between; gap: 12px; font-family: var(--font-ui); font-size: 13px; line-height: 1.3; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .px-mgb__foot > span:last-child { color: var(--muted); text-align: right; }
  .px-mgb__sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>
