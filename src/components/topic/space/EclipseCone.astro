---
/**
 * EclipseCone (space) — the shadow geometry of an eclipse. Top: the occulting
 * body, its umbra cone drawn to its TRUE length along the axis (the cone's
 * width exaggerated so it can be seen), the penumbra, and the target's range
 * of distances. Below: the tip at TRUE scale in both directions, where the
 * target, drawn at its real size, sits at its closest, mean and farthest
 * distance against the point where the umbra runs out. The umbra's length is
 * set large. Drawn for the pinned figure panel (Lens Phase 6, 2026-09-30;
 * board Lib-eclipse-cone): one 470-unit SVG, 12px axis type, 13px labels.
 *
 * Physics (docs/design/physics/orbital-mechanics.md §8):
 *   umbraLength = dSource·rOcc / (rSource − rOcc)
 *   r_umbra(d)  = rOcc·(1 − d/umbraLength)   (> 0 total · ≤ 0 annular)
 *
 * Cue anchors: `tip` — the umbra's point (both panels) and the headline;
 * `mean` — the target at its mean distance (both panels); `near`, `far` — at
 * the ends of its range (the zoom); `umbra`;
 * `range` — the range box above; `penumbra`; `occulter`; `axis`.
 *
 * THE BUILD (LENS §6.4): 1 the axes fade, 2 the occulter, penumbra and umbra
 * fade in, 3 the target's positions drop, 4 the headline counts up.
 *
 * data: EclipseConeData. NB `source` is the light SOURCE body (the Sun), not
 * the citation; author the citation as the section's `source`. `sourceCite`
 * is accepted and kept in the figure's <desc>.
 */
import { SANS, nf, svgTag, niceTicks } from './_fig';

interface Body { name: string; radiusKm: number; }
interface Occulter extends Body { distanceFromSourceKm: number; }
interface Target extends Body { distanceFromOcculterKm: number; distanceRangeKm?: [number, number]; }
interface Props {
  source: Body;
  occulter: Occulter;
  target: Target;
  showPenumbra?: boolean;
  caption?: string;
  sourceCite?: string;
}
const { source, occulter, target, showPenumbra = true, caption, sourceCite } = Astro.props;
/* Drawn twice (Lens Phase 6): at 470 for the panel and at 290 for a phone,
   one shown by the .px-sfig__dual rule in dataviz-v2.css, so every label
   prints at 12px or more at both widths and nothing has to scroll. */
const W: number = (Astro.props as any).w ?? 470;
const dual = (Astro.props as any).w == null;

// ── physics ─────────────────────────────────────────────────────────────────
const rSrc = source.radiusKm, rOcc = occulter.radiusKm, dSrc = occulter.distanceFromSourceKm;
const d = target.distanceFromOcculterKm;
const range = target.distanceRangeKm;
const umbraLength = (dSrc * rOcc) / (rSrc - rOcc);
const rUmbraAt = (dist: number) => rOcc * (1 - dist / umbraLength);
const headline = Math.round(umbraLength / 1000) * 1000;

// ── the top panel: along the axis to true length, widths exaggerated ─────────
const H = 350, OX = 40, OY = 72, OR = 24, XE = W - 12;
const maxD = Math.max(umbraLength, d, range ? range[1] : 0) * 1.06;
const k = (XE - OX) / maxD;
const AX = (km: number) => OX + km * k;
const tipX = AX(umbraLength);
const slope = OR / (tipX - OX);
const penTop = Math.max(10, OY - OR - slope * (XE - OX));
const penBot = Math.min(OY + OR + (OY - OR - penTop), 128);
const xt = niceTicks(maxD, 2).filter((v) => AX(v) <= XE + 0.5);
const AXY = 136;

// ── the tip at true scale (km per px the same both ways) ─────────────────────
const lo = Math.min(range ? range[0] : d, umbraLength, d) - target.radiusKm * 3;
const hi = Math.max(range ? range[1] : d, umbraLength, d) + target.radiusKm * 3;
const zStep = niceTicks(hi - lo, 4)[1] ?? 10000;
const z0 = Math.floor(lo / zStep) * zStep, z1 = Math.ceil(hi / zStep) * zStep;
const ZL = 8, ZR = W - 8, ZY = 262;
const kz = (ZR - ZL) / (z1 - z0);
const ZX = (km: number) => ZL + (km - z0) * kz;
const tR = target.radiusKm * kz;                       // the target's true radius
const zTicks: number[] = [];
for (let v = z0; v <= z1 + 1e-6; v += zStep) zTicks.push(v);
// a tick label needs about 56 units: on the narrow drawing every other one is named
const zEvery = (ZR - ZL) / Math.max(1, zTicks.length - 1) < 60 ? 2 : 1;
// the umbra near the tip, both edges at true scale (sub-pixel by then)
const uL = Math.max(z0, 0);
const uHalf = Math.max(0.6, rUmbraAt(uL) * kz);
const positions = [
  ...(range ? [{ id: 'near', km: range[0], label: 'Closest', dash: true }] : []),
  { id: 'mean', km: d, label: 'Mean', dash: false },
  ...(range ? [{ id: 'far', km: range[1], label: 'Farthest', dash: true }] : []),
];
const aria =
  `Eclipse shadow geometry: the ${occulter.name}'s umbra reaches ${nf(umbraLength)} km; ` +
  `${target.name} sits ${nf(d)} km away` + (range ? `, between ${nf(range[0])} and ${nf(range[1])} km` : '') + '.';
---
{dual ? (
  <div class="px-sfig__dual">
    <Astro.self {...Astro.props} w={470} />
    <Astro.self {...Astro.props} w={290} />
  </div>
) : (
<Fragment>

<div class="px-viz px-eclp" data-build-scene>
  <div class="px-sfig__head" data-cue="tip">
    <span class="px-sfig__num" data-build="4" data-build-kind="counter" data-to={headline}>{nf(headline)}</span>
    <span class="px-sfig__lbl"><span class="px-cue-tag" data-cue-tag="tip" hidden></span>km to the tip</span>
  </div>

  <div class="px-sfig__plot">
    <svg class="px-sfig__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={caption ? `${aria} ${caption}` : aria}>
      {sourceCite && <desc>{sourceCite}</desc>}
      <g data-cue="axis" data-build="1">
        <text class="px-sfig__at" x="0" y="14" style={SANS}>← {source.name}</text>
        <line class="px-sfig__base" x1={OX} x2={XE} y1={AXY} y2={AXY} />
        {xt.map((v, i) => (
          <>
            <line class="px-sfig__base" x1={AX(v).toFixed(1)} x2={AX(v).toFixed(1)} y1={AXY} y2={AXY + 5} />
            <text class="px-sfig__ax" x={AX(v).toFixed(1)} y={AXY + 20} text-anchor={i === 0 ? 'start' : 'middle'} style={SANS}>{nf(v)}</text>
          </>
        ))}
        <text class="px-sfig__at" x={OX} y={AXY + 38} style={SANS}>km from the {occulter.name}, widths exaggerated</text>

        <line class="px-sfig__grid" x1="0" x2={W} y1={AXY + 50} y2={AXY + 50} />
        <text class="px-sfig__at px-eclp__k" x="0" y={AXY + 68} style={SANS}>THE TIP, TRUE SCALE</text>
        <line class="px-sfig__base" x1={ZL} x2={ZR} y1={H - 28} y2={H - 28} />
        {zTicks.map((v, i) => (
          <>
            <line class="px-sfig__base" x1={ZX(v).toFixed(1)} x2={ZX(v).toFixed(1)} y1={H - 28} y2={H - 23} />
            {i % zEvery === 0 && <text class="px-sfig__ax" x={ZX(v).toFixed(1)} y={H - 8} text-anchor={i === 0 ? 'start' : i === zTicks.length - 1 ? 'end' : 'middle'} style={SANS}>{nf(v)}</text>}
          </>
        ))}
      </g>

      {showPenumbra && (
        <g data-cue="penumbra" data-build="2">
          <polygon class="px-eclp__pen" points={`${OX},${OY - OR} ${XE},${penTop.toFixed(1)} ${XE},${penBot.toFixed(1)} ${OX},${OY + OR}`} />
          <text class="px-sfig__t px-eclp__pen-t" x={(XE - 70).toFixed(1)} y={(Math.max(penTop, 18) + 18).toFixed(1)} text-anchor="middle" style={SANS}>Penumbra</text>
        </g>
      )}
      <g data-cue="umbra" data-build="2">
        <polygon class="px-eclp__umb" points={`${OX},${OY - OR} ${tipX.toFixed(1)},${OY} ${OX},${OY + OR}`} />
        <text class="px-eclp__umb-t" x={OX + OR + 8} y={OY + 4.5} style={SANS}>Umbra</text>
        {/* the umbra at true scale in the zoom: a sliver that ends at the tip */}
        {umbraLength > z0 && (
          <polygon class="px-eclp__umb" points={`${ZX(uL).toFixed(1)},${(ZY - uHalf).toFixed(2)} ${ZX(umbraLength).toFixed(1)},${ZY} ${ZX(uL).toFixed(1)},${(ZY + uHalf).toFixed(2)}`} />
        )}
        <line class="px-eclp__axisline" x1={ZX(Math.min(umbraLength, z1)).toFixed(1)} x2={ZR} y1={ZY} y2={ZY} />
      </g>
      <g data-cue="occulter" data-build="2">
        <circle class="px-eclp__occ" cx={OX} cy={OY} r={OR} />
        <text class="px-eclp__occ-t" x={OX} y={OY + 4.5} text-anchor="middle" style={SANS}>{occulter.name}</text>
      </g>

      <g data-cue="tip" data-build="3" data-build-kind="drop">
        <circle class="px-eclp__tip" cx={tipX.toFixed(1)} cy={OY} r="3" />
        <circle class="px-eclp__tip" cx={ZX(umbraLength).toFixed(1)} cy={ZY} r="3.5" />
        <line class="px-eclp__lead" x1={ZX(umbraLength).toFixed(1)} x2={ZX(umbraLength).toFixed(1)} y1={ZY + 4} y2={(ZY + tR + 6).toFixed(1)} />
        <text class="px-sfig__t px-sfig__b" x={(ZX(umbraLength) - 6).toFixed(1)} y={(ZY + tR + 20).toFixed(1)} text-anchor="end" style={SANS}>Umbra tip</text>
        <Fragment set:html={svgTag('tip', ZX(umbraLength) + 12, ZY + tR + 16)} />
      </g>

      {range && (
        <g data-cue="range" data-build="3" data-build-kind="drop">
          <rect class="px-eclp__range" x={AX(range[0]).toFixed(1)} y={OY - 12} width={(AX(range[1]) - AX(range[0])).toFixed(1)} height="24" />
          <text class="px-sfig__t px-eclp__range-t" x={((AX(range[0]) + AX(range[1])) / 2).toFixed(1)} y={OY + 32} text-anchor="middle" style={SANS}>{target.name} range</text>
        </g>
      )}
      {positions.map((p) => (
        <g data-cue={p.id} data-build="3" data-build-kind="drop">
          {p.id === 'mean' && <circle class="px-eclp__tgt" cx={AX(p.km).toFixed(1)} cy={OY} r="4" />}
          <circle class={p.dash ? 'px-eclp__pos px-eclp__pos--d' : 'px-eclp__pos'} cx={ZX(p.km).toFixed(1)} cy={ZY} r={tR.toFixed(1)} />
          <text class="px-sfig__t px-sfig__b" x={ZX(p.km).toFixed(1)} y={(ZY - tR - 8).toFixed(1)} text-anchor="middle" style={SANS}>{p.label}</text>
          <Fragment set:html={svgTag(p.id, ZX(p.km), ZY + tR * 0.55)} />
        </g>
      ))}
    </svg>
  </div>
</div>
</Fragment>
)}

<style>
  .px-eclp__pen { fill: var(--accent-tint); }
  .px-eclp__pen-t { fill: var(--accent-deep); font-weight: 600; }
  .px-eclp__umb { fill: var(--ink); }
  .px-eclp__umb-t { font-size: 13px; font-weight: 600; fill: var(--paper-2); }
  .px-eclp__axisline { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 2 3; }
  .px-eclp__occ { fill: var(--paper-3); stroke: var(--ink-2); stroke-width: 1.5; }
  .px-eclp__occ-t { font-size: 12px; font-weight: 600; fill: var(--ink); }
  .px-eclp__tip { fill: var(--ink); stroke: var(--paper-2); stroke-width: 1.5; }
  .px-eclp__lead { stroke: var(--ink-2); stroke-width: 1; }
  .px-eclp__range { fill: none; stroke: var(--accent-deep); stroke-width: 1.2; stroke-dasharray: 3 3; }
  .px-eclp__range-t { fill: var(--accent-deep); font-weight: 600; }
  .px-eclp__tgt { fill: var(--accent); stroke: var(--paper-2); stroke-width: 1.5; }
  .px-eclp__pos { fill: color-mix(in oklab, var(--accent) 22%, transparent); stroke: var(--accent-deep); stroke-width: 1.5; }
  .px-eclp__pos--d { fill: none; stroke: var(--ink-2); stroke-dasharray: 3 3; }
  .px-eclp__k { letter-spacing: 0.06em; }
</style>
