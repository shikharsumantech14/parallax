---
/**
 * ShotMap (sports) — every shot at the spot it was taken from (Lens Phase 6,
 * 2026-09-30; the board is Lib-shot-map). The goals set at 48 over the
 * figure; the attacking third drawn on paper, goal at the top, with the
 * penalty box, the six-yard box, the spot and the arc; one circle per shot,
 * its area in proportion to its xG, its treatment by outcome: a goal filled
 * in the desk text ink, a save on the tint with a mark edge, a miss dashed,
 * a block on hair with a drawn cross (two strokes, never a glyph). One legend
 * row with the counts.
 *
 * The drawing carries NO text: the three pitch words and the cue numerals are
 * an HTML layer over it, placed by percent and sized in real pixels, so they
 * print at 12px at any width and the pitch scales freely (it never scrolls on
 * a phone). The CSS-3D goal tilt and the hover scale are retired.
 *
 * Coords: x, y in 0..100 of the attacking third. x across the pitch (0 = the
 * left touchline), y the depth from the goal line (0) to the edge of the
 * third (100), a third being 35 m deep on a 68 m pitch; the drawing is
 * cropped to the depth the shots use (24 m at the least).
 *
 * Cue anchors:
 *   goals   the headline count and every goal circle
 *   box     the penalty box
 *   1..n    each shot, in authored order
 *
 * The build (LENS §6.4): 1 the pitch and its words, 2 the shots drop, 3 the
 * legend, 4 the goals count up.
 */
type Outcome = 'goal' | 'saved' | 'miss' | 'blocked';
interface Shot { x: number; y: number; xg: number; outcome: Outcome; }
interface Props { shots: Shot[]; caption?: string; source?: string; }
const { shots = [] } = Astro.props;

/* The third: 68 m across and 35 m deep (y = 100). The drawing is cropped
   to the depth the shots use, 24 m at the least, so a cluster in the box is
   not left above an empty half. 420 units across. */
const clamp = (v: number) => Math.max(0, Math.min(100, v ?? 0));
const DEPTH = Math.min(35, Math.max(24, (Math.max(0, ...shots.map((s) => clamp(s.y))) / 100) * 35 + 4));
const W = 440, M = 10, PW = W - 2 * M, PD = (PW * DEPTH) / 68, TOP = 22, H = TOP + PD + M;
const X = (m: number) => M + (m / 68) * PW;            // metres across → units
const Y = (m: number) => TOP + (m / DEPTH) * PD;       // metres deep → units
const f = (n: number) => n.toFixed(1);
const cx = X(34);
const box = { x1: X(34 - 20.16), x2: X(34 + 20.16), y: Y(16.5) };
const six = { x1: X(34 - 9.16), x2: X(34 + 9.16), y: Y(5.5) };
const spot = Y(11);
const goal = { x1: X(34 - 3.66), x2: X(34 + 3.66) };
/* The arc: the part of the 9.15 m circle round the spot outside the box. */
const R915 = (9.15 / 35) * PD;
const dy = box.y - spot;
const half = Math.sqrt(Math.max(0, R915 * R915 - dy * dy));
const arc = `M ${f(cx - half)} ${f(box.y)} A ${f(R915)} ${f(R915)} 0 0 0 ${f(cx + half)} ${f(box.y)}`;

const rOf = (xg: number) => 4 + Math.sqrt(Math.max(0, Math.min(1, xg ?? 0))) * 11;
const placed = shots.map((s, i) => {
  const r = rOf(s.xg);
  const x = Math.max(r + 2, Math.min(W - r - 2, M + (clamp(s.x) / 100) * PW));
  const y = Math.max(TOP + r, Math.min(H - r - 2, Y((clamp(s.y) / 100) * 35)));
  return { ...s, i, r, x, y, xgTxt: Math.max(0, Math.min(1, s.xg ?? 0)).toFixed(2) };
});
const ARM = 3.4;
const cross = (x: number, y: number) =>
  `M ${f(x - ARM)} ${f(y - ARM)} L ${f(x + ARM)} ${f(y + ARM)} M ${f(x + ARM)} ${f(y - ARM)} L ${f(x - ARM)} ${f(y + ARM)}`;

const OUTS: { key: Outcome; label: string }[] = [
  { key: 'goal', label: 'Goal' },
  { key: 'saved', label: 'Saved' },
  { key: 'miss', label: 'Off target' },
  { key: 'blocked', label: 'Blocked' },
];
const count = (k: Outcome) => placed.filter((s) => s.outcome === k).length;
const goals = count('goal');
const totXg = placed.reduce((a, s) => a + Math.max(0, Math.min(1, s.xg ?? 0)), 0);
const pc = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const others = placed.filter((s) => s.outcome !== 'goal').sort((a, b) => b.r - a.r);
const goalShots = placed.filter((s) => s.outcome === 'goal').sort((a, b) => b.r - a.r);
---

<div class="px-viz px-shot" data-build-scene>
  <div class="px-shot__head" data-cue="goals">
    <span class="px-shot__big" data-build="4" data-build-kind="counter" data-to={goals}>{goals}</span>
    <span class="px-shot__big-l"><span class="px-cue-tag" data-cue-tag="goals" hidden></span>{goals === 1 ? 'goal' : 'goals'} from {placed.length} shots · {totXg.toFixed(2)} xG</span>
  </div>

  <div class="px-shot__fig">
    <svg class="px-shot__svg" viewBox={`0 0 ${W} ${f(H)}`} role="img"
      aria-label={`Shot map: ${placed.length} shots, ${goals} ${goals === 1 ? 'goal' : 'goals'}, ${totXg.toFixed(2)} expected goals`}>
      <g data-build="1">
        <rect x={M} y={TOP} width={PW} height={f(PD)} fill="var(--paper)" stroke="var(--hair-2)" stroke-width="1.5" />
        <polyline points={`${f(six.x1)},${TOP} ${f(six.x1)},${f(six.y)} ${f(six.x2)},${f(six.y)} ${f(six.x2)},${TOP}`} fill="none" stroke="var(--hair-2)" stroke-width="1.5" />
        <path d={arc} fill="none" stroke="var(--hair-2)" stroke-width="1.5" />
        <circle cx={f(cx)} cy={f(spot)} r="2.5" fill="var(--hair-2)" />
        <rect x={f(goal.x1)} y={TOP - 12} width={f(goal.x2 - goal.x1)} height="12" fill="none" stroke="var(--ink-2)" stroke-width="2" />
      </g>
      <polyline data-cue="box" data-build="1" points={`${f(box.x1)},${TOP} ${f(box.x1)},${f(box.y)} ${f(box.x2)},${f(box.y)} ${f(box.x2)},${TOP}`} fill="none" stroke="var(--hair-2)" stroke-width="1.5" />
      {others.map((s) => (
        <g class="px-shot__pt" data-out={s.outcome} data-cue={s.i + 1} data-build="2" data-build-kind="drop">
          <circle class="px-shot__c" cx={f(s.x)} cy={f(s.y)} r={f(s.r)}><title>{s.outcome} · xG {s.xgTxt}</title></circle>
          {s.outcome === 'blocked' && <path class="px-shot__x" d={cross(s.x, s.y)} />}
        </g>
      ))}
      {/* The goals draw last, so a big goal circle never hides a small attempt
          under it, and they share a wrapper: the `goals` anchor. */}
      <g data-cue="goals">
        {goalShots.map((s) => (
          <g class="px-shot__pt" data-out="goal" data-cue={s.i + 1} data-build="2" data-build-kind="drop">
            <circle class="px-shot__c" cx={f(s.x)} cy={f(s.y)} r={f(s.r)}><title>goal · xG {s.xgTxt}</title></circle>
          </g>
        ))}
      </g>
    </svg>
    <div class="px-shot__layer" aria-hidden="true">
      <span class="px-shot__w" data-build="1" style={`left:${pc(goal.x2 + 8, W)};top:${pc(TOP - 6, H)}`}>Goal</span>
      <span class="px-shot__w" data-build="1" style={`left:${pc(box.x1 + 6, W)};top:${pc(box.y + 12, H)}`}><span class="px-cue-tag" data-cue-tag="box" hidden></span>Penalty box</span>
      {placed.map((s) => (
        <span class="px-shot__tag" style={`left:${pc(s.x + s.r * 0.7, W)};top:${pc(s.y - s.r * 0.7, H)}`}><span class="px-cue-tag" data-cue-tag={s.i + 1} hidden></span></span>
      ))}
    </div>
  </div>

  <div class="px-shot__legend" data-build="3">
    {OUTS.filter((o) => count(o.key) > 0).map((o) => (
      <span class="px-shot__key" data-out={o.key}><i></i>{o.label} · {count(o.key)}</span>
    ))}
    <span class="px-shot__key">Size shows xG</span>
  </div>
  {/* No source line and no caption: core/Section.astro prints both. */}
</div>

<style>
  .px-shot__head { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 12px; }
  .px-shot__big {
    font-family: var(--font-ui);
    font-size: 96px;
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-deep);
  }
  .px-shot__big-l { display: inline-flex; align-items: center; min-width: 0; font-family: var(--font-ui); font-size: 14px; font-weight: 500; line-height: 1.3; color: var(--ink-2); }
  .px-shot__big-l .px-cue-tag { margin-right: 8px; }
  .px-shot__fig { position: relative; }
  .px-shot__svg { display: block; width: 100%; height: auto; }
  .px-shot__layer { position: absolute; inset: 0; pointer-events: none; }
  .px-shot__w {
    position: absolute;
    translate: 0 -50%;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .px-shot__w .px-cue-tag { margin-right: 6px; }
  .px-shot__tag { position: absolute; translate: -2px -18px; }
  .px-shot__tag .px-cue-tag { margin: 0; }
  .px-shot__c { stroke-width: 1.5; }
  .px-shot__pt[data-out='goal'] .px-shot__c { fill: var(--accent-deep); fill-opacity: 0.92; stroke: var(--paper-2); }
  .px-shot__pt[data-out='saved'] .px-shot__c { fill: color-mix(in oklab, var(--accent) 40%, var(--paper-2)); stroke: var(--accent); }
  .px-shot__pt[data-out='miss'] .px-shot__c { fill: none; stroke: var(--muted); stroke-dasharray: 3 2; }
  .px-shot__pt[data-out='blocked'] .px-shot__c { fill: var(--hair); stroke: var(--ink-2); }
  .px-shot__x { fill: none; stroke: var(--ink-2); stroke-width: 1.5; stroke-linecap: round; }
  .px-shot__legend { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; margin-top: 14px; }
  .px-shot__key { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-ui); font-size: 12px; line-height: 1.3; color: var(--muted); }
  .px-shot__key i { flex: none; box-sizing: border-box; width: 13px; height: 13px; border-radius: 50%; }
  .px-shot__key[data-out='goal'] i { background: var(--accent-deep); }
  .px-shot__key[data-out='saved'] i { background: color-mix(in oklab, var(--accent) 40%, var(--paper-2)); border: 1.5px solid var(--accent); }
  .px-shot__key[data-out='miss'] i { border: 1.5px dashed var(--muted); }
  .px-shot__key[data-out='blocked'] i { background: var(--hair); border: 1.5px solid var(--ink-2); }
  /* LENS §7: the pinned figure headline is 96, 72 on phones. */
  @media (max-width: 767px) { .px-shot__big { font-size: 72px; } }
</style>
