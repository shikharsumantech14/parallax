---
/**
 * FlightOfTheBall (sports · WebGL FLAGSHIP) — "The shot's real machinery"
 * (Lens Phase 6, 2026-09-30; the board is Lib-flight-of-the-ball). One famous
 * struck ball rebuilt from its physics: a real launch speed and spin, bent by
 * drag and Magnus to the goal, integrated by RK4, beside the "no-air" path the
 * same kick would have flown in a vacuum. On the desk's deep plate.
 *
 * The WebGL scene (src/scripts/viz3d/scenes/flightOfTheBall.ts) flies the ball
 * once on boot and again on REPLAY, and keeps its one idle loop. The mount
 * sets the scene's colour variables to the plate's (on-deep lines, the lime
 * flight), so the live scene and the still read as one picture.
 *
 * THE STILL (no JS, reduced motion, no WebGL): the kick drawn from behind the
 * ball in perspective, the goal frame and the box lines in on-deep hair, the
 * no-air path dashed, the real flight in the lime, the swerve bracketed at the
 * goal line. Its words and cue numerals are an HTML layer over the drawing
 * (percent positions, real pixels), because the mount pins its aspect ratio.
 * Math: src/scripts/viz3d/ballistics.ts, the SAME integrate() the scene runs,
 * so the drawn arc and the flown arc are one sample set.
 *
 * Cue anchors (on the still and on the launch row, never on the canvas):
 *   real     the real flight and its label
 *   ghost    the no-air path and its label
 *   swerve   the bracket at the goal line
 *   launch   the ball and the launch numbers
 *
 * The build (LENS §6.4) sits on the launch row under the mount, which paints
 * the same with or without WebGL: 1 the label, 2 the three numbers count up,
 * 3 the flight line. The drawing itself does not build (a live scene hides
 * it, so its elements have no box to compare).
 *
 * data: { sport?, shot{label, v0, speedUnit?, elevationDeg, azimuthDeg,
 *         spinRevPerS, spinAxis?, from, note?}, goal?, showGhost?, slowmo? }
 */
import {
  SPORT_CONSTS, SPORT_GOAL, toMetersPerSec, integrate, swerveMeters, apexMeters,
  type Sport, type Sample, type ShotInput,
} from '../../../scripts/viz3d/ballistics';

interface ShotProp {
  label?: string;
  v0?: number;
  speedUnit?: 'm/s' | 'km/h';
  elevationDeg?: number;
  azimuthDeg?: number;
  spinRevPerS?: number;
  spinAxis?: [number, number, number];
  from?: [number, number];
  note?: string;
}
interface Props {
  sport?: Sport;
  shot?: ShotProp;
  goal?: { x_m?: number; width_m?: number; height_m?: number; z_m?: number };
  showGhost?: boolean;
  slowmo?: number;
  caption?: string;
  source?: string;
}
const { sport: sportProp, shot: shotProp = {}, goal: goalProp, showGhost = true, slowmo = 3 } = Astro.props;

const sport: Sport = (['football', 'basketball', 'cricket'] as const).includes(sportProp as Sport) ? (sportProp as Sport) : 'football';
const consts = SPORT_CONSTS[sport];
const v0Display = typeof shotProp.v0 === 'number' ? shotProp.v0 : 30;
const speedUnit = shotProp.speedUnit === 'km/h' ? 'km/h' : 'm/s';
const spinRevPerS = typeof shotProp.spinRevPerS === 'number' ? Math.max(0, shotProp.spinRevPerS) : 0;
const elevationDeg = typeof shotProp.elevationDeg === 'number' ? shotProp.elevationDeg : 12;
const shot: ShotInput = {
  v0: toMetersPerSec(v0Display, speedUnit),
  elevationDeg,
  azimuthDeg: typeof shotProp.azimuthDeg === 'number' ? shotProp.azimuthDeg : 0,
  spinRevPerS,
  spinAxis: Array.isArray(shotProp.spinAxis) && shotProp.spinAxis.length === 3 ? shotProp.spinAxis : [0, 1, 0],
  from: Array.isArray(shotProp.from) && shotProp.from.length === 2 ? shotProp.from : [30, 0],
};
const label = shotProp.label ?? 'the shot';
const note = shotProp.note;
const goal = {
  x_m: goalProp?.x_m ?? SPORT_GOAL[sport].x_m,
  width_m: goalProp?.width_m ?? SPORT_GOAL[sport].width_m,
  height_m: goalProp?.height_m ?? SPORT_GOAL[sport].height_m,
  z_m: goalProp?.z_m ?? SPORT_GOAL[sport].z_m,
};

/* ── integrate at BUILD TIME — the same call the scene makes at runtime ── */
const real: Sample[] = integrate(shot, consts, goal.x_m, false);
const ghost: Sample[] = integrate(shot, consts, goal.x_m, true);
const swerve = swerveMeters(real, ghost);
const flightTime = real[real.length - 1].t;
const apex = apexMeters(real);
const realEnd = real[real.length - 1];
const ghostEnd = ghost[ghost.length - 1];

/* ── the still: a perspective view from 8 m behind the ball, 1.9 m up ──────
   x downrange (decreasing to the goal), y up, z lateral. d = depth from the
   camera; the view is centred so the goal mouth sits in the middle. */
const VW = 512, VH = 300;
const B = 8, CAM_H = 1.9, FOC = 700, HOR = 80;
const ballX = shot.from[0], ballZ = shot.from[1];
const camX = ballX + B;
const zc = ballZ - 0.22 * (ballZ - goal.z_m);
const dGoal = camX - goal.x_m;
const CX = VW / 2 + (FOC * (goal.z_m - zc)) / dGoal;
const P = (x: number, y: number, z: number) => {
  const d = Math.max(0.8, camX - x);
  return { x: CX - (FOC * (z - zc)) / d, y: HOR - (FOC * (y - CAM_H)) / d };
};
const f = (n: number) => n.toFixed(1);
const line = (pts: [number, number, number][]) => pts.map(([x, y, z]) => { const p = P(x, y, z); return `${f(p.x)},${f(p.y)}`; }).join(' ');
const pathOf = (s: Sample[]) => s.map((p) => { const q = P(p.x, Math.max(0, p.y), p.z); return `${f(q.x)},${f(q.y)}`; }).join(' ');
const gx = goal.x_m, gz = goal.z_m, gw = goal.width_m / 2, gh = goal.height_m;
const football = sport === 'football';
const marks: string[] = [
  line([[gx, 0, gz - 30], [gx, 0, gz + 30]]),
  ...(football ? [
    line([[gx, 0, gz - 9.16], [gx + 5.5, 0, gz - 9.16], [gx + 5.5, 0, gz + 9.16], [gx, 0, gz + 9.16]]),
    line([[gx, 0, gz - 20.16], [gx + 16.5, 0, gz - 20.16], [gx + 16.5, 0, gz + 20.16], [gx, 0, gz + 20.16]]),
    line(Array.from({ length: 25 }, (_, k) => {
      const a = (-53.13 + (106.26 * k) / 24) * (Math.PI / 180);
      return [gx + 11 + 9.15 * Math.cos(a), 0, gz + 9.15 * Math.sin(a)] as [number, number, number];
    })),
  ] : []),
];
const frame = line([[gx, 0, gz - gw], [gx, gh, gz - gw], [gx, gh, gz + gw], [gx, 0, gz + gw]]);
const ball = P(ballX, 0.11, ballZ);
const rEnd = P(realEnd.x, Math.max(0, realEnd.y), realEnd.z);
const gEnd = P(ghostEnd.x, Math.max(0, ghostEnd.y), ghostEnd.z);
const bracketY = Math.min(rEnd.y, gEnd.y, P(gx, gh, gz).y) - 16;
const rMid = (() => { const s = real[Math.floor(real.length * 0.4)]; return P(s.x, Math.max(0, s.y), s.z); })();
const pc = (v: number, of: number) => `${((Math.max(2, Math.min(of - 2, v)) / of) * 100).toFixed(2)}%`;
const dist = Math.round(ballX - gx);
const swerveAbs = Math.abs(swerve).toFixed(1);
const fmtV0 = Number.isInteger(v0Display) ? String(v0Display) : v0Display.toFixed(1);
const isInt = (n: number) => Number.isInteger(n);
const payload = JSON.stringify({
  sport,
  shot: { label, v0: v0Display, speedUnit, elevationDeg, azimuthDeg: shot.azimuthDeg, spinRevPerS, spinAxis: shot.spinAxis, from: shot.from, note },
  goal, showGhost, slowmo,
});
---

<div class="px-viz px-fball">
  <div class="px-fball__plate">
    <p class="px-fball__label">{label}</p>
    <div class="px-fball__stage">
      <div class="viz3d viz3d--fball" data-viz3d="flight-of-the-ball" role="img"
        aria-label={`Ball flight: ${label}. The real flight curls ${swerveAbs} m away from the no-air path by the goal line.`}>
        <div class="viz3d__fallback">
          <svg viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="xMidYMid meet" class="px-fball__svg">
            <g fill="none" stroke="var(--on-deep-hair)" stroke-width="1.5">
              {marks.map((m) => <polyline points={m} />)}
            </g>
            <polyline points={frame} fill="none" stroke="var(--on-deep)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            {showGhost && (
              <g data-cue="ghost">
                <polyline points={pathOf(ghost)} fill="none" stroke="var(--on-deep-2)" stroke-width="2" stroke-dasharray="6 6" stroke-linecap="round" />
                <circle cx={f(gEnd.x)} cy={f(gEnd.y)} r="5" fill="none" stroke="var(--on-deep-2)" stroke-width="2" />
              </g>
            )}
            <g data-cue="real">
              <polyline points={pathOf(real)} fill="none" stroke="var(--accent-lime, #e8f048)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx={f(rEnd.x)} cy={f(rEnd.y)} r="6" fill="var(--accent-lime, #e8f048)" />
            </g>
            {showGhost && (
              <g data-cue="swerve">
                <polyline points={`${f(rEnd.x)},${f(bracketY + 8)} ${f(rEnd.x)},${f(bracketY)} ${f(gEnd.x)},${f(bracketY)} ${f(gEnd.x)},${f(bracketY + 8)}`} fill="none" stroke="var(--accent-lime, #e8f048)" stroke-width="2" />
              </g>
            )}
            <g data-cue="launch">
              <circle cx={f(ball.x)} cy={f(ball.y)} r="8" fill="var(--on-deep)" />
            </g>
          </svg>
          <div class="px-fball__layer" aria-hidden="true">
            <span class="px-fball__w px-fball__w--real" style={`left:${pc(rMid.x - 12, VW)};top:${pc(rMid.y, VH)}`}><span class="px-cue-tag" data-cue-tag="real" hidden></span>real flight</span>
            {showGhost && <span class="px-fball__w" style={`left:${pc(gEnd.x + 10, VW)};top:${pc(gEnd.y + 16, VH)}`}>no-air path<span class="px-cue-tag" data-cue-tag="ghost" hidden></span></span>}
            {showGhost && <span class="px-fball__w px-fball__w--sw" style={`left:${pc((rEnd.x + gEnd.x) / 2, VW)};top:${pc(bracketY - 12, VH)}`}><span class="px-cue-tag" data-cue-tag="swerve" hidden></span>swerve {swerveAbs} m</span>}
            <span class="px-fball__w" style={`left:${pc(ball.x + 14, VW)};top:${pc(ball.y, VH)}`}>{dist} m out</span>
          </div>
        </div>

        {/* REPLAY: the ONE control. Hidden until the scene is live. */}
        <div class="px-fball__chips">
          <button type="button" class="px-fball__chip" data-state="replay" aria-pressed="false">Replay</button>
        </div>
        <span class="viz3d__hint" aria-hidden="true">drag to orbit · scroll to zoom</span>
        <script type="application/json" class="viz3d__data" set:html={payload}></script>
      </div>
    </div>

    <div class="px-fball__launch" data-cue="launch" data-build-scene>
      <p class="px-fball__ll" data-build="1"><span class="px-cue-tag" data-cue-tag="launch" hidden></span>Launch</p>
      <div class="px-fball__stats">
        <div class="px-fball__stat">
          <span class="px-fball__num"><span data-build="2" data-build-kind={isInt(v0Display) ? 'counter' : undefined} data-to={isInt(v0Display) ? v0Display : undefined}>{fmtV0}</span><small> {speedUnit}</small></span>
          <span class="px-fball__sl">Speed</span>
        </div>
        <div class="px-fball__stat">
          <span class="px-fball__num"><span data-build="2" data-build-kind={isInt(elevationDeg) ? 'counter' : undefined} data-to={isInt(elevationDeg) ? elevationDeg : undefined}>{elevationDeg}</span>°<small> up</small></span>
          <span class="px-fball__sl">Angle</span>
        </div>
        <div class="px-fball__stat">
          <span class="px-fball__num"><span data-build="2" data-build-kind={isInt(spinRevPerS) ? 'counter' : undefined} data-to={isInt(spinRevPerS) ? spinRevPerS : undefined}>{spinRevPerS}</span><small> rev/s</small></span>
          <span class="px-fball__sl">Sidespin</span>
        </div>
      </div>
      <p class="px-fball__flight" data-build="3">Flight {flightTime.toFixed(2)} s · apex {apex.toFixed(1)} m{note ? ` · ${note}` : ''}</p>
    </div>
  </div>

  <div class="px-fball__caps">
    {slowmo > 1 && <span class="px-fball__cap px-fball__cap--live">Replay ×{slowmo} slow-mo</span>}
    {sport === 'cricket' && <span class="px-fball__cap">Swing not modelled</span>}
  </div>
  {/* No source line and no caption: core/Section.astro prints both. */}
</div>

{/* REPLAY chip → data-viz3d-state bridge (the path chamber uses). Also
    mirrors the mount's live state onto the root so the slow-mo chip (a
    live-only artefact) can show. */}
<script is:inline>
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling;
    while (root && !(root.classList && root.classList.contains('px-viz'))) root = root.previousElementSibling;
    if (!root) return;
    var mount = root.querySelector('[data-viz3d="flight-of-the-ball"]');
    var chip = root.querySelector('.px-fball__chip');
    if (!mount || !chip) return;
    chip.addEventListener('click', function () {
      mount.setAttribute('data-viz3d-state', 'replay-' + Date.now());
      mount.setAttribute('data-viz3d-state', 'replay');
      chip.setAttribute('aria-pressed', 'true');
      setTimeout(function () { chip.setAttribute('aria-pressed', 'false'); }, 600);
    });
    var mo = new MutationObserver(function () {
      if (mount.classList.contains('viz3d--live')) { root.classList.add('px-fball--live'); mo.disconnect(); }
    });
    mo.observe(mount, { attributes: true, attributeFilter: ['class'] });
    if (mount.classList.contains('viz3d--live')) root.classList.add('px-fball--live');
  })();
</script>

<style>
  .px-fball__plate {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px;
    border-radius: var(--r-card, 6px);
    background: var(--deep);
    color: var(--on-deep);
  }
  .px-fball__label { margin: 0; font-family: var(--font-ui); font-size: 12px; font-weight: 500; line-height: 1.3; letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-deep-2); }
  .px-fball__stage { position: relative; }
  /* The scene reads its colours from the mount: here they are the plate's. */
  .viz3d--fball {
    aspect-ratio: 512 / 300;
    background: transparent;
    --ink: var(--on-deep);
    --paper: var(--deep);
    --muted: var(--on-deep-2);
    --accent: var(--accent-lime, #e8f048);
    --accent-deep: var(--accent-lime, #e8f048);
  }
  .px-fball__svg { overflow: hidden; }
  .px-fball__layer { position: absolute; inset: 0; pointer-events: none; }
  .px-fball__w {
    position: absolute;
    translate: 0 -50%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--on-deep-2);
  }
  .px-fball__w--real { translate: -100% -50%; font-weight: 600; color: var(--accent-lime, #e8f048); }
  .px-fball__w--sw { translate: -50% -50%; font-size: 13px; font-weight: 600; color: var(--on-deep); }
  .px-fball__w .px-cue-tag { margin: 0; background: var(--accent-lime, #e8f048); color: var(--deep); }
  .px-fball__chips { display: none; position: absolute; top: 8px; right: 8px; z-index: 3; }
  .viz3d--fball.viz3d--live .px-fball__chips { display: flex; }
  .px-fball__chip {
    min-height: 32px;
    padding: 0 14px;
    border: 1px solid var(--on-deep-hair);
    border-radius: 999px;
    background: transparent;
    color: var(--on-deep);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--t-micro, 160ms) var(--ease);
  }
  .px-fball__chip:hover, .px-fball__chip[aria-pressed='true'] { border-color: var(--on-deep); }
  @media (pointer: coarse) { .px-fball__chip { min-height: 44px; } }
  .px-fball__launch { display: flex; flex-direction: column; gap: 12px; padding-top: 14px; border-top: 1px solid var(--on-deep-hair); }
  .px-fball__ll { display: inline-flex; align-items: center; margin: 0; font-family: var(--font-ui); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-deep-2); }
  .px-fball__ll .px-cue-tag { margin-right: 8px; background: var(--accent-lime, #e8f048); color: var(--deep); }
  .px-fball__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .px-fball__stat { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .px-fball__num { font-family: var(--font-ui); font-size: 48px; font-weight: 600; line-height: 0.92; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--on-deep); white-space: nowrap; }
  .px-fball__num small { font-size: 13px; font-weight: 500; letter-spacing: 0; color: var(--on-deep-2); }
  .px-fball__sl { font-family: var(--font-ui); font-size: 13px; line-height: 1.3; color: var(--on-deep-2); }
  .px-fball__flight { margin: 0; font-family: var(--font-ui); font-size: 13px; line-height: 1.4; color: var(--on-deep-2); }
  .px-fball__caps { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .px-fball__caps:not(:has(.px-fball__cap:not(.px-fball__cap--live))) { margin-top: 0; }
  .px-fball__cap { font-family: var(--font-ui); font-size: 12px; font-weight: 500; color: var(--muted); border: 1px solid var(--hair); border-radius: 999px; padding: 4px 10px; }
  .px-fball__cap--live { display: none; }
  .px-fball--live .px-fball__cap--live { display: inline-block; }
  @container (max-width: 380px) {
    .px-fball__num { font-size: 36px; }
  }
  @media (max-width: 420px) {
    .px-fball__num { font-size: 32px; }
    .px-fball__plate { padding: 12px; }
  }
</style>
