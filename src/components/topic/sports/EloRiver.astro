---
/**
 * EloRiver (sports) — a season of teams' ratings, one line per team (Lens
 * Phase 6, 2026-09-30; the board is Lib-elo-river). The board redrew the
 * braided streamgraph as what the reader needs from it: every team's rating
 * across the dates on one shared axis, the subject team a heavy line in the
 * desk mark, the others thin ink lines each in its own dash, the subject's
 * overtakes ringed where its line crosses another, and each line's final
 * rating tagged at its end. The subject's gain across the span is the
 * headline (48). The model, the update rule (`kInfo`) and the `baseline`
 * print as one muted line; a rating left `null` is bridged by a faint dashed
 * span, so an interpolated stretch never reads as measured.
 *
 * Drawn for the `wide` panel: a 552-unit viewBox, 12 and 13-unit labels in
 * the literal Instrument Sans stack; below 1024px it keeps that width and the
 * card scrolls (dataviz-v2.css). No JS of its own.
 *
 * Cue anchors:
 *   gain        the headline gain
 *   overtakes   the rings where the subject passes another team
 *   1..n        each team, in authored order (its line, its end tag and its
 *               legend key)
 *   note1..     the annotations, in authored order
 *
 * The build (LENS §6.4): 1 the grid and the axes, 2 the lines draw, 3 the
 * rings, end tags and notes, 4 the gain counts up.
 *
 * data: { model, kInfo?, dates[], baseline?, teams[]{name, short?, color?,
 *         ratings[], subject?}, annotations? }
 */
interface EloTeam { name: string; short?: string; color?: string; ratings: Array<number | null>; subject?: boolean; }
interface Annotation { at: string | number; text: string; side?: 'above' | 'below' | 'left' | 'right'; series?: string; }
interface Props {
  model: string;
  kInfo?: string;
  dates: string[];
  baseline?: number;
  teams: EloTeam[];
  caption?: string;
  source?: string;
  annotations?: Annotation[];
}
const { model, kInfo, dates = [], baseline = 1500, teams = [], annotations = [], caption, source } = Astro.props;

const W = 552, H = 300;
const plotL = 48, plotR = W - 96, plotT = 14, plotB = H - 32;
const f = (n: number) => n.toFixed(1);
const nD = dates.length;
const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
const real = (v: number | null | undefined): v is number => v != null && Number.isFinite(v);

let subjectSeen = false;
const prepared = teams
  .filter((t) => t && Array.isArray(t.ratings) && t.ratings.some(real))
  .map((t, i) => {
    const isSubject = !!t.subject && !subjectSeen;
    if (isSubject) subjectSeen = true;
    const r = t.ratings.slice(0, nD);
    /* nulls: linear between known values, clamped at the ends, flagged */
    const known = r.map((v, k) => (real(v) ? k : -1)).filter((k) => k >= 0);
    const vals = r.map((v, k) => {
      if (real(v)) return v;
      const a = [...known].reverse().find((j) => j < k);
      const b = known.find((j) => j > k);
      if (a == null) return r[b!] as number;
      if (b == null) return r[a] as number;
      return (r[a] as number) + (((r[b] as number) - (r[a] as number)) * (k - a)) / (b - a);
    });
    return { i, name: t.name, short: (t.short || t.name.slice(0, 3)).toUpperCase().slice(0, 4), color: t.color, isSubject, vals, interp: r.map((v) => !real(v)) };
  });
const subject = prepared.find((t) => t.isSubject) ?? null;
const degenerate = nD < 2 || prepared.length < 1;

const allVals = prepared.flatMap((t) => t.vals);
const lo = Math.floor((Math.min(...allVals) - 10) / 50) * 50;
const hi = Math.ceil((Math.max(...allVals) + 10) / 50) * 50;
const xAt = (k: number) => plotL + (nD > 1 ? (k / (nD - 1)) * (plotR - plotL) : 0);
const yAt = (v: number) => plotB - ((v - lo) / Math.max(1, hi - lo)) * (plotB - plotT);
const step = (hi - lo) / 50 > 5 ? 100 : 50;
const yTicks: number[] = [];
for (let v = lo; v <= hi; v += step) yTicks.push(v);

/* Each non-subject line takes its own dash and ink; a team's `color` is a
   fixed encoding and wins. */
const STYLES = [
  { stroke: 'var(--ink-2)', dash: '2 3' },
  { stroke: 'var(--muted)', dash: '7 4' },
  { stroke: 'var(--ink)', dash: '' },
  { stroke: 'var(--ink-2)', dash: '' },
  { stroke: 'var(--muted)', dash: '2 3' },
  { stroke: 'var(--ink)', dash: '7 4' },
];
let o = 0;
const lines = prepared.map((t) => {
  const st = t.isSubject ? { stroke: t.color ?? 'var(--accent)', dash: '' } : { ...STYLES[o++ % STYLES.length], ...(t.color ? { stroke: t.color } : {}) };
  const pts = t.vals.map((v, k) => [xAt(k), yAt(v)] as [number, number]);
  // solid runs between measured points; a span touching a null is bridged apart
  const solid: string[] = [];
  const bridge: string[] = [];
  for (let k = 0; k < nD - 1; k++) {
    const seg = `${f(pts[k][0])},${f(pts[k][1])} ${f(pts[k + 1][0])},${f(pts[k + 1][1])}`;
    (t.interp[k] || t.interp[k + 1] ? bridge : solid).push(seg);
  }
  const run = solid.length === nD - 1 ? pts.map(([x, y]) => `${f(x)},${f(y)}`).join(' ') : null;
  return { ...t, ...st, pts, run, solid, bridge };
});

/* The subject's overtakes: where its line crosses another's, date to date. */
const rings: { x: number; y: number }[] = [];
if (subject && !degenerate) {
  for (const t of prepared) {
    if (t === subject) continue;
    for (let k = 0; k < nD - 1; k++) {
      const d0 = subject.vals[k] - t.vals[k], d1 = subject.vals[k + 1] - t.vals[k + 1];
      if (d0 < 0 && d1 > 0) {
        const fr = d0 / (d0 - d1);
        rings.push({ x: xAt(k + fr), y: yAt(subject.vals[k] + fr * (subject.vals[k + 1] - subject.vals[k])) });
      }
    }
  }
}
const lead = subject ?? [...prepared].sort((a, b) => b.vals[nD - 1] - a.vals[nD - 1])[0];
const gain = lead ? Math.round(lead.vals[nD - 1] - lead.vals[0]) : 0;

/* End tags, de-collided 16 units apart top-down, then pushed up from the foot. */
const order = [...lines].sort((a, b) => a.pts[nD - 1][1] - b.pts[nD - 1][1]);
const tagY = new Map<number, number>();
let prev = -Infinity;
for (const l of order) { const y = Math.max(l.pts[nD - 1][1], prev + 16); tagY.set(l.i, y); prev = y; }
if (prev > plotB) {
  let cap = plotB;
  for (let k = order.length - 1; k >= 0; k--) { const y = Math.min(tagY.get(order[k].i)!, cap); tagY.set(order[k].i, y); cap = y - 16; }
}

const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const years = new Set(dates.map((d) => d.slice(0, 4))).size;
const fmtDate = (iso: string) => {
  const [y, m] = iso.split('-');
  const mon = MON[Math.max(0, Math.min(11, (parseInt(m, 10) || 1) - 1))];
  return years > 1 && (m === '01' || iso === dates[0]) ? `${mon} '${(y || '').slice(2)}` : mon;
};
const every = nD <= 7 ? 1 : Math.ceil(nD / 6);
const xLabels = dates.map((d, k) => ({ x: xAt(k), t: fmtDate(d), k })).filter((l) => l.k % every === 0 || l.k === nD - 1);

/* ── the annotation layer (docs/design/blueprints/_ANNOTATIONS.md) ──────────
   `at` is the date index (or the `dates[i]` string); `series` the team name
   or short code, default the subject. The note sits beside its dot on the
   side with room, wrapped to a 170-unit measure, over a paper halo. */
const A_FS = 13, A_LH = 16, A_MAX = 170;
const aEst = (s: string) => 0.5 * A_FS * s.length;
const wrap = (s: string) => {
  const out: string[] = [];
  for (const w of s.split(/\s+/)) {
    const last = out[out.length - 1];
    if (last && aEst(last + ' ' + w) <= A_MAX) out[out.length - 1] = last + ' ' + w;
    else out.push(w);
  }
  return out;
};
const annots = degenerate ? [] : (annotations ?? []).flatMap((a, k) => {
  if (!a || !a.text) return [];
  const num = typeof a.at === 'number' ? a.at : Number(String(a.at).trim() || NaN);
  const di = Number.isInteger(num) && num >= 0 && num < nD ? num : dates.indexOf(String(a.at));
  if (di < 0) return [];
  const want = (a.series || '').trim();
  const t = want ? lines.find((l) => l.name === want || l.short === want.toUpperCase().slice(0, 4)) : lines.find((l) => l.isSubject);
  if (!t) return [];
  const [cx, cy] = t.pts[di];
  const ls = wrap(a.text);
  const w = Math.max(...ls.map(aEst));
  const dir = cx - 24 - w >= plotL ? -1 : 1;
  const bh = (ls.length - 1) * A_LH;
  const below = a.side === 'below' || cy - 10 - bh - A_FS < plotT;
  const ty = below ? Math.min(plotB - bh - 4, cy + 24) : Math.max(plotT + A_FS, cy - 14 - bh);
  const tx = cx + dir * 12;
  return [{ id: `note${k + 1}`, cx, cy, tx, ty, lines: ls, anchor: dir > 0 ? 'start' : 'end' }];
});
const meta = [model, kInfo, `avg ${baseline}`].filter(Boolean).join(' · ');
const UI = "font-family:'Instrument Sans','Helvetica Neue',Arial,sans-serif";
---

<div class="px-viz px-eriv" data-build-scene>
  {degenerate ? (
    <p class="px-eriv__empty">No rating data.</p>
  ) : (
    <>
      <div class="px-eriv__head">
        <div class="px-eriv__n" data-cue="gain">
          <span class="px-eriv__big" data-build="4" data-build-kind="counter" data-to={Math.abs(gain)}>{gain >= 0 ? '+' : '−'}{Math.abs(gain)}</span>
          <span class="px-eriv__nl"><span class="px-cue-tag" data-cue-tag="gain" hidden></span>{lead?.name}, rating points</span>
        </div>
        <p class="px-eriv__meta" data-build="1">{meta}</p>
      </div>

      <svg class="px-eriv__svg" viewBox={`0 0 ${W} ${H}`} role="img"
        aria-label={`Ratings (${model}) of ${lines.length} teams from ${fmtDate(dates[0])} to ${fmtDate(dates[nD - 1])}: ${lines.map((l) => `${l.name} ${fmt(l.vals[0])} to ${fmt(l.vals[nD - 1])}`).join('; ')}`}>
        {/* The caption and the source print once, in core/Section.astro; the
            drawing carries them as its accessible description. */}
        {(caption || source) && <desc>{[caption, source && `Source: ${source}`].filter(Boolean).join(' ')}</desc>}
        <g data-build="1">
          {yTicks.map((v) => (
            <>
              <line x1={plotL} y1={f(yAt(v))} x2={plotR} y2={f(yAt(v))} stroke="var(--hair)" stroke-width="1" />
              <text class="px-eriv__ax" x={plotL - 8} y={f(yAt(v) + 4)} text-anchor="end" style={UI}>{fmt(v)}</text>
            </>
          ))}
          {xLabels.map((l) => (
            <text class="px-eriv__ax" x={f(l.x)} y={H - 10} text-anchor={l.k === 0 ? 'start' : l.k === nD - 1 ? 'end' : 'middle'} style={UI}>{l.t}</text>
          ))}
        </g>
        {[...lines].sort((a, b) => Number(a.isSubject) - Number(b.isSubject)).map((l) => (
          <g data-cue={l.i + 1}>
            {l.run
              ? <polyline class="px-eriv__line" points={l.run} stroke={l.stroke} stroke-width={l.isSubject ? 4.5 : 2} stroke-dasharray={l.dash || undefined} data-build="2" data-build-kind={l.dash ? undefined : 'draw'} />
              : l.solid.map((s) => <polyline class="px-eriv__line" points={s} stroke={l.stroke} stroke-width={l.isSubject ? 4.5 : 2} stroke-dasharray={l.dash || undefined} data-build="2" />)}
            {l.bridge.map((s) => <polyline class="px-eriv__line" points={s} stroke={l.stroke} stroke-width="1.5" stroke-opacity="0.45" stroke-dasharray="1 4" data-build="2" />)}
            {l.pts.map(([x, y], k) => (
              l.isSubject
                ? <circle cx={f(x)} cy={f(y)} r="4" fill={l.stroke} data-build="2" />
                : <circle cx={f(x)} cy={f(y)} r="3" fill="var(--paper-2)" stroke={l.stroke} stroke-width="1.5" data-build="2" />
            ))}
            <text class="px-eriv__tag" data-subject={l.isSubject ? 'true' : undefined} x={plotR + 12} y={f(tagY.get(l.i)! + 4)} style={UI} data-build="3" data-build-kind="rise">{l.short} {fmt(l.vals[nD - 1])}</text>
            <foreignObject x={f(l.pts[0][0] - 2)} y={f(l.pts[0][1] - 26)} width="22" height="22"><span class="px-cue-tag" data-cue-tag={l.i + 1} hidden></span></foreignObject>
          </g>
        ))}
        {rings.length > 0 && (
          <g data-cue="overtakes" data-build="3">
            {rings.map((r) => <circle cx={f(r.x)} cy={f(r.y)} r="9" fill="none" stroke="var(--accent-deep)" stroke-width="2" />)}
            <foreignObject x={f(rings[0].x - 34)} y={f(rings[0].y + 4)} width="22" height="22"><span class="px-cue-tag" data-cue-tag="overtakes" hidden></span></foreignObject>
          </g>
        )}
        {annots.map((a) => (
          <g data-cue={a.id} data-build="3" data-build-kind="rise">
            <line x1={f(a.cx)} y1={f(a.cy)} x2={f(a.tx)} y2={f(a.ty - 4)} stroke="var(--hair-2)" stroke-width="1" />
            <text class="px-eriv__note" x={f(a.tx)} y={f(a.ty)} text-anchor={a.anchor}
              style="font-family:'Newsreader',Georgia,'Times New Roman',serif">{a.lines.map((ln, li) => <tspan x={f(a.tx)} dy={li === 0 ? 0 : A_LH}>{ln}</tspan>)}</text>
            <foreignObject x={f(a.anchor === 'start' ? a.tx : a.tx - 22)} y={f(a.ty - 36)} width="22" height="22"><span class="px-cue-tag" data-cue-tag={a.id} hidden></span></foreignObject>
          </g>
        ))}
      </svg>

      <div class="px-eriv__legend" data-build="3">
        {lines.map((l) => (
          <span class="px-eriv__key" data-cue={l.i + 1}>
            <svg width="22" height="8" viewBox="0 0 22 8" aria-hidden="true"><line x1="0" y1="4" x2="22" y2="4" stroke={l.stroke} stroke-width={l.isSubject ? 4.5 : 2} stroke-dasharray={l.dash || undefined} /></svg>
            {l.name}
          </span>
        ))}
      </div>
    </>
  )}
  {/* No source line and no caption: core/Section.astro prints both. */}
</div>

<style>
  .px-eriv__empty { margin: 0; font-family: var(--font-ui); font-size: 13px; color: var(--muted); }
  .px-eriv__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 16px; margin-bottom: 12px; }
  .px-eriv__n { display: flex; flex-direction: column; gap: 8px; }
  .px-eriv__big { font-family: var(--font-ui); font-size: 96px; font-weight: 600; line-height: 0.92; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--accent-deep); }
  .px-eriv__nl { display: inline-flex; align-items: center; font-family: var(--font-ui); font-size: 13px; line-height: 1.3; color: var(--muted); }
  .px-eriv__meta { margin: 0; max-width: 260px; font-family: var(--font-ui); font-size: 12px; line-height: 1.4; color: var(--muted); text-align: right; }
  .px-eriv__svg { display: block; width: 100%; height: auto; }
  .px-eriv__svg foreignObject { overflow: visible; }
  .px-eriv__svg .px-cue-tag { margin: 1px; }
  .px-eriv__ax { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .px-eriv__line { fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .px-eriv__tag { font-size: 13px; font-weight: 500; fill: var(--ink-2); font-variant-numeric: tabular-nums; }
  .px-eriv__tag[data-subject] { font-weight: 600; fill: var(--accent-deep); }
  .px-eriv__note {
    font-size: 13px;
    font-style: italic;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper-2);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .px-eriv__legend { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 12px; }
  .px-eriv__key { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-ui); font-size: 12px; line-height: 1.3; color: var(--muted); }
  .px-eriv__key svg { flex: none; }
  /* LENS §7: the pinned figure headline is 96, 72 on phones. */
  @media (max-width: 767px) { .px-eriv__big { font-size: 72px; } }
</style>
