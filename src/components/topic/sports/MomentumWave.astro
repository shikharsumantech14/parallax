---
/**
 * MomentumWave (sports) — which way the pressure ran, minute by minute (Lens
 * Phase 6, 2026-09-30; the board is Lib-momentum-wave). A baseline across the
 * middle; the wave swells ABOVE it on the desk mark tint while the home side
 * pushes and BELOW it on an ink tint while the away side does, with the
 * momentum line over both. Events stand on the line as dots with their labels
 * over the plot (home) or under it (away), rows stacked so no two labels
 * print over each other. The headline (48) is the share of the match the
 * home side spent on top, derived from the points.
 *
 * Drawn for the panel: a 452-unit viewBox, 12-unit labels in the literal
 * Instrument Sans stack; below 1024px it keeps that width and the card
 * scrolls (dataviz-v2.css). No JS of its own.
 *
 * Cue anchors:
 *   top         the headline share
 *   home, away  the swell above the line, the swell below it
 *   half        the half-time rule
 *   1..n        each event, in authored order (its pin, dot and label)
 *
 * The build (LENS §6.4): 1 the baseline, the ticks and the half-time rule,
 * 2 the wave grows out of the baseline, 3 the events drop, 4 the share counts.
 *
 * data: { points[]{ minute, value }, events?[]{ minute, label, team? },
 *         home?, away? }  value in -100..100: + home push, - away push.
 */
type Side = 'home' | 'away';
interface Pt { minute: number; value: number; }
interface Ev { minute: number; label: string; team?: Side; }
interface Props {
  points: Pt[];
  events?: Ev[];
  home?: string;
  away?: string;
  caption?: string;
  source?: string;
}
const { points = [], events = [], home = 'Home', away = 'Away' } = Astro.props;

const W = 452, plotL = 12, plotR = W - 12, plotW = plotR - plotL;
const ROW = 16, FS = 12, PAD = 8;
const f = (n: number) => n.toFixed(1);
const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
const pts = (points || [])
  .filter((p) => p && Number.isFinite(p.minute) && Number.isFinite(p.value))
  .sort((a, b) => a.minute - b.minute);
const lastMin = Math.max(90, ...pts.map((p) => p.minute || 0));
const maxMin = Math.ceil(lastMin / 5) * 5;
const px = (m: number) => plotL + (clamp(m, 0, maxMin) / maxMin) * plotW;

/* The value at any minute, linear between the points (the dot of an event
   sits on it). */
const valueAt = (m: number) => {
  if (!pts.length) return 0;
  if (m <= pts[0].minute) return pts[0].value;
  for (let k = 1; k < pts.length; k++) {
    if (m <= pts[k].minute) {
      const a = pts[k - 1], b = pts[k];
      return a.value + ((b.value - a.value) * (m - a.minute)) / Math.max(1e-9, b.minute - a.minute);
    }
  }
  return pts[pts.length - 1].value;
};

/* The share of the match the home side spent on top: the fraction of the
   span of the points where the linear momentum is above zero. */
const share = (() => {
  if (pts.length < 2) return 0;
  const a0 = pts[0].minute, a1 = pts[pts.length - 1].minute;
  let up = 0;
  const N = 600;
  for (let k = 0; k < N; k++) if (valueAt(a0 + ((k + 0.5) * (a1 - a0)) / N) > 0) up++;
  return Math.round((up / N) * 100);
})();

/* Labels: an estimated box per label (Instrument Sans 600 at 12, about .58em
   a character), anchored inward at the plot's edges, stacked into the first
   row where it clears every label already there. */
const estW = (s: string) => s.length * FS * 0.58;
const placeRows = (list: (Ev & { i: number; x: number })[]) => {
  const rows: { l: number; r: number }[][] = [];
  return list.map((e) => {
    const w = estW(e.label ?? '');
    const anchor = e.x - w / 2 < plotL ? 'start' : e.x + w / 2 > plotR ? 'end' : 'middle';
    const lx = anchor === 'start' ? e.x - 4 : anchor === 'end' ? e.x + 4 : e.x;
    const box = anchor === 'start' ? { l: lx, r: lx + w } : anchor === 'end' ? { l: lx - w, r: lx } : { l: lx - w / 2, r: lx + w / 2 };
    let row = 0;
    while ((rows[row] ?? []).some((o) => box.l < o.r + PAD && o.l < box.r + PAD)) row++;
    (rows[row] ??= []).push(box);
    return { ...e, anchor, lx, row };
  });
};
const evs = (events || [])
  .map((e, i) => ({ ...e, i, x: px(e.minute), team: (e.team ?? 'home') as Side }))
  .filter((e) => Number.isFinite(e.minute))
  .sort((a, b) => a.x - b.x);
const homePins = placeRows(evs.filter((e) => e.team === 'home'));
const awayPins = placeRows(evs.filter((e) => e.team === 'away'));
const homeRows = homePins.length ? Math.max(...homePins.map((p) => p.row)) + 1 : 0;
const awayRows = awayPins.length ? Math.max(...awayPins.map((p) => p.row)) + 1 : 0;

/* The vertical plan: home label rows, the plot, away label rows, the ticks. */
const plotT = 6 + homeRows * ROW + (homeRows ? 8 : 0);
const PLOT_H = 200;
const plotB = plotT + PLOT_H;
const mid = plotT + PLOT_H / 2;
const awayTop = plotB + (awayRows ? 8 : 0);
const tickY = awayTop + awayRows * ROW + 18;
const H = tickY + 6;
const py = (v: number) => mid - (clamp(v, -100, 100) / 100) * (PLOT_H / 2);

function smoothLine(p: { x: number; y: number }[]): string {
  if (!p.length) return '';
  let d = `M ${f(p[0].x)} ${f(p[0].y)}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[i === 0 ? 0 : i - 1], p1 = p[i], p2 = p[i + 1], p3 = p[i + 2 < p.length ? i + 2 : i + 1];
    d += ` C ${f(p1.x + (p2.x - p0.x) / 6)} ${f(p1.y + (p2.y - p0.y) / 6)} ${f(p2.x - (p3.x - p1.x) / 6)} ${f(p2.y - (p3.y - p1.y) / 6)} ${f(p2.x)} ${f(p2.y)}`;
  }
  return d;
}
const screen = pts.map((p) => ({ x: px(p.minute), y: py(p.value) }));
const linePath = smoothLine(screen);
const areaPath = screen.length ? `${linePath} L ${f(screen[screen.length - 1].x)} ${f(mid)} L ${f(screen[0].x)} ${f(mid)} Z` : '';
const htX = px(45);
const xTicks = Array.from({ length: Math.floor(maxMin / 15) + 1 }, (_, i) => i * 15);
const uid = 'mom' + Math.abs([...`${home}|${away}|${pts.length}|${evs.length}`].reduce((a, c) => ((a << 5) - a + c.charCodeAt(0)) | 0, 0)).toString(36);
const pins = [
  ...homePins.map((p) => ({ ...p, ly: 6 + p.row * ROW + FS, ty: 6 + p.row * ROW + FS + 4 })),
  ...awayPins.map((p) => ({ ...p, ly: awayTop + p.row * ROW + FS, ty: awayTop + p.row * ROW })),
].map((p) => ({ ...p, dy: py(valueAt(p.minute)) }));
const UI = "font-family:'Instrument Sans','Helvetica Neue',Arial,sans-serif";
---

<div class="px-viz px-mom" data-build-scene>
  <div class="px-mom__head">
    <div class="px-mom__n" data-cue="top">
      <span class="px-mom__big"><span data-build="4" data-build-kind="counter" data-to={share}>{share}</span>%</span>
      <span class="px-mom__nl"><span class="px-cue-tag" data-cue-tag="top" hidden></span>{home} on top</span>
    </div>
    <div class="px-mom__key" data-build="1">
      <span class="px-mom__k"><i class="px-mom__kh"></i>{home} on top</span>
      <span class="px-mom__k"><i class="px-mom__ka"></i>{away} on top</span>
      {evs.length > 0 && <span class="px-mom__k"><i class="px-mom__ke"></i>Event</span>}
    </div>
  </div>

  <svg class="px-mom__svg" viewBox={`0 0 ${W} ${f(H)}`} role="img"
    aria-label={`Match momentum by minute, ${home} above the line, ${away} below${evs.length ? ': ' + evs.map((e) => `${e.minute}' ${e.label}`).join(', ') : ''}`}>
    <defs>
      <clipPath id={`${uid}u`}><rect x={plotL} y={plotT} width={plotW} height={f(mid - plotT)} /></clipPath>
      <clipPath id={`${uid}d`}><rect x={plotL} y={f(mid)} width={plotW} height={f(plotB - mid)} /></clipPath>
    </defs>
    <g data-build="1">
      <line x1={plotL} y1={plotT} x2={plotR} y2={plotT} stroke="var(--hair)" stroke-width="1" />
      <line x1={plotL} y1={plotB} x2={plotR} y2={plotB} stroke="var(--hair)" stroke-width="1" />
      {xTicks.map((m) => (
        <text class="px-mom__ax" x={f(px(m))} y={f(tickY)} text-anchor={m === 0 ? 'start' : m === maxMin ? 'end' : 'middle'} style={UI}>{m}'</text>
      ))}
    </g>
    <g data-cue="half" data-build="1">
      <line x1={f(htX)} y1={plotT} x2={f(htX)} y2={plotB} stroke="var(--hair-2)" stroke-width="1" stroke-dasharray="3 3" />
      <foreignObject x={f(htX - 11)} y={f(plotB - 26)} width="22" height="22"><span class="px-cue-tag" data-cue-tag="half" hidden></span></foreignObject>
    </g>

    <g class="px-mom__wave" data-build="2" data-build-kind="grow-y" style={`transform-origin:0 ${f(mid)}px`}>
      <g data-cue="home">
        <path class="px-mom__area px-mom__area--home" d={areaPath} clip-path={`url(#${uid}u)`} />
        <path class="px-mom__line px-mom__line--home" d={linePath} clip-path={`url(#${uid}u)`} />
      </g>
      <g data-cue="away">
        <path class="px-mom__area px-mom__area--away" d={areaPath} clip-path={`url(#${uid}d)`} />
        <path class="px-mom__line px-mom__line--away" d={linePath} clip-path={`url(#${uid}d)`} />
      </g>
    </g>
    <line x1={plotL} y1={f(mid)} x2={plotR} y2={f(mid)} stroke="var(--ink)" stroke-width="1.5" data-build="1" />
    <foreignObject x={plotL + 2} y={f(plotT + 4)} width="22" height="22"><span class="px-cue-tag" data-cue-tag="home" hidden></span></foreignObject>
    <foreignObject x={plotL + 2} y={f(plotB - 26)} width="22" height="22"><span class="px-cue-tag" data-cue-tag="away" hidden></span></foreignObject>

    {pins.map((p) => (
      <g class="px-mom__pin" data-side={p.team} data-cue={p.i + 1} data-build="3" data-build-kind="drop">
        <line x1={f(p.x)} y1={f(p.team === 'home' ? p.ty : p.dy + 6)} x2={f(p.x)} y2={f(p.team === 'home' ? p.dy - 6 : p.ty)} />
        <circle cx={f(p.x)} cy={f(p.dy)} r="5" />
        <text x={f(p.lx)} y={f(p.ly)} text-anchor={p.anchor} style={UI}>{p.label}</text>
        <foreignObject x={f(p.x + 6)} y={f(p.dy - (p.team === 'home' ? -4 : 26))} width="22" height="22"><span class="px-cue-tag" data-cue-tag={p.i + 1} hidden></span></foreignObject>
      </g>
    ))}
  </svg>
  {/* No source line and no caption: core/Section.astro prints both. */}
</div>

<style>
  .px-mom__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 16px; margin-bottom: 12px; }
  .px-mom__n { display: flex; flex-direction: column; gap: 8px; }
  .px-mom__big { font-family: var(--font-ui); font-size: 96px; font-weight: 600; line-height: 0.92; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--accent-deep); }
  .px-mom__nl { display: inline-flex; align-items: center; font-family: var(--font-ui); font-size: 13px; line-height: 1.3; color: var(--muted); }
  .px-mom__key { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .px-mom__k { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-ui); font-size: 12px; line-height: 1.3; color: var(--muted); }
  .px-mom__k i { flex: none; box-sizing: border-box; display: inline-block; }
  .px-mom__kh { width: 20px; height: 12px; background: color-mix(in oklab, var(--accent) 32%, transparent); border-top: 2px solid var(--accent); }
  .px-mom__ka { width: 20px; height: 12px; background: color-mix(in oklab, var(--ink-2) 30%, transparent); border-bottom: 2px solid var(--ink-2); }
  .px-mom__ke { width: 10px; height: 10px; border-radius: 50%; background: var(--accent-deep); }
  .px-mom__svg { display: block; width: 100%; height: auto; }
  .px-mom__svg foreignObject { overflow: visible; }
  .px-mom__svg .px-cue-tag { margin: 1px; }
  .px-mom__ax { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .px-mom__wave { transform-box: view-box; }
  .px-mom__area--home { fill: var(--accent); fill-opacity: 0.32; }
  .px-mom__area--away { fill: var(--ink-2); fill-opacity: 0.3; }
  .px-mom__line { fill: none; stroke-width: 2; stroke-linejoin: round; }
  .px-mom__line--home { stroke: var(--accent); }
  .px-mom__line--away { stroke: var(--ink-2); }
  .px-mom__pin line { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 2 3; }
  .px-mom__pin circle { fill: var(--accent-deep); stroke: var(--paper-2); stroke-width: 2; }
  .px-mom__pin[data-side='away'] circle { fill: var(--ink-2); }
  .px-mom__pin text {
    font-size: 12px;
    font-weight: 600;
    fill: var(--ink);
    font-variant-numeric: tabular-nums;
    paint-order: stroke;
    stroke: var(--paper-2);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  /* LENS §7: the pinned figure headline is 96, 72 on phones. */
  @media (max-width: 767px) { .px-mom__big { font-size: 72px; } }
</style>
