---
/**
 * FinishInterval (`finish-interval`) — a projected finishing position per
 * team, drawn with the range the model actually gives (Lens Phase 6,
 * 2026-09-30; the board is Lib-finish-interval). The reader learns which
 * positions are decided and which are still open, because the answer is
 * whether the bars overlap. The headline (48) is the most ranges that cover
 * one position at once, and a dashed band frames those rows.
 *
 * Blueprint: docs/design/blueprints/sports/finish-interval.md. Pure HTML/CSS
 * in core/VizCard.astro, prefix `px-fin`. The row-selection island, the
 * readout and the AT table of the launch design are retired: the cues do the
 * pointing, and each row carries its full sentence as its label.
 *
 * Cue anchors:
 *   overlap  the headline number and the dashed band
 *   zones    the consequence strips (the first label carries the numeral)
 *   1..n     the team rows, in authored order
 *
 * The build (LENS §6.4): 1 the names, the ticks and the strips, 2 the ranges
 * grow from their best finish, 3 the likely finishes drop, 4 the band, the
 * notes, the model line and the headline count.
 */
import VizCard from '../../core/VizCard.astro';

interface Zone {
  fromPos: number;
  toPos: number;
  label: string;
  tone: 'good' | 'bad';
}
interface Row {
  name: string;
  median: number;
  low: number; // 5th percentile position — the BEST finish
  high: number; // 95th percentile position — the WORST finish
  note?: string;
}
interface Props {
  model?: string;
  runs?: number;
  positions?: number;
  zones?: Zone[];
  rows?: Row[];
  caption?: string;
  source?: string | { label: string; date?: string };
}

const {
  model = '',
  runs,
  positions = 0,
  zones = [],
  rows = [],
  caption,
  source,
} = Astro.props;

/* ── Build-time validation (blueprint §3) ──────────────────────────────────
   THE INTERVAL IS THE CONTENT. Every rule below exists because the failure it
   catches renders as a plausible chart carrying a false claim — a bar drawn
   off its own scale, or no bar at all, in a figure whose entire argument is
   "look how much these bars overlap". A named build failure is cheap; a
   published projection that quietly misstates its own uncertainty is not. */
if (!model.trim()) {
  throw new Error(
    '[finish-interval] `model` is mandatory — the projection must name what produced it, and it is printed in the source line. See blueprint §3.',
  );
}
if (!Number.isInteger(positions) || positions < 5) {
  throw new Error(
    `[finish-interval] \`positions\` must be a whole number of 5 or more (the league size sets the scale), got ${positions}.`,
  );
}
if (rows.length < 8 || rows.length > 20) {
  throw new Error(`[finish-interval] needs 8–20 rows, got ${rows.length}. See blueprint §10.`);
}
for (const r of rows) {
  if (![r.low, r.median, r.high].every((n) => typeof n === 'number' && Number.isFinite(n))) {
    throw new Error(`[finish-interval] "${r.name}" needs numeric low, median and high.`);
  }
  // A row with no interval is a standing, not a projection — and a chart of
  // standings is a `league-table`. Refusing it here is the blueprint's §3 rule.
  if (r.low === r.high) {
    throw new Error(
      `[finish-interval] "${r.name}" has low === high (${r.low}); an interval of zero width is a settled position — use \`league-table\`.`,
    );
  }
  if (!(r.low <= r.median && r.median <= r.high)) {
    throw new Error(
      `[finish-interval] "${r.name}" must satisfy low <= median <= high, got ${r.low} / ${r.median} / ${r.high}.`,
    );
  }
  if (r.low < 1 || r.high > positions) {
    throw new Error(
      `[finish-interval] "${r.name}" runs ${r.low}–${r.high}, outside the 1–${positions} scale this chart draws.`,
    );
  }
}
for (const z of zones) {
  if (z.tone !== 'good' && z.tone !== 'bad') {
    throw new Error(`[finish-interval] zone "${z.label}" has tone "${z.tone}"; expected 'good' or 'bad'.`);
  }
  if (!(z.fromPos >= 1 && z.fromPos <= z.toPos && z.toPos <= positions)) {
    throw new Error(
      `[finish-interval] zone "${z.label}" spans ${z.fromPos}–${z.toPos}, which is not inside 1–${positions}.`,
    );
  }
}

/* ── Scale ────────────────────────────────────────────────────────────────
   ONE mapping from position to horizontal offset, used by the dots, the bars
   AND the zone strips. The prototype's layout bug was a zone strip measured
   against a different box from the dots, so position 1 did not start where the
   track started; sharing `ipos` is the fix, and the strips are inset to the
   track in CSS so both boxes are the same box. */
const ipos = (p: number) => ((p - 1) / (positions - 1)) * 100;
const clamp = (n: number) => Math.min(100, Math.max(0, n));
const pc = (n: number) => `${n.toFixed(3)}%`;

const ord = (n: number) => {
  if (!Number.isInteger(n)) return String(n);
  const h = n % 100;
  const t = n % 10;
  const suffix = h >= 11 && h <= 13 ? 'th' : t === 1 ? 'st' : t === 2 ? 'nd' : t === 3 ? 'rd' : 'th';
  return `${n}${suffix}`;
};

/* Overlap is DERIVED, never authored. It is the argument the figure makes, so
   an authored count could contradict the bars the reader is looking at. The
   readout and the table's column read from this one value (blueprint §11). */
const overlaps = (a: Row, b: Row) => a.low <= b.high && b.low <= a.high;

const items = rows.map((r, i) => {
  const n = rows.filter((o, j) => j !== i && overlaps(r, o)).length;
  return {
    ...r,
    i,
    n,
    barLeft: ipos(r.low),
    barWidth: ipos(r.high) - ipos(r.low),
    dotLeft: ipos(r.median),
    span: r.high - r.low + 1,
  };
});

/* The highlighted row: a team from the contested middle, because the still
   should already be making the argument: most overlaps first, then the
   widest interval, then array order. */
const defaultIdx = items.reduce((best, r) => {
  const b = items[best];
  if (r.n !== b.n) return r.n > b.n ? r.i : best;
  if (r.span !== b.span) return r.span > b.span ? r.i : best;
  return best;
}, 0);

/* The headline: the most ranges that cover one position at once. Derived,
   never authored, like the overlap count above. The dashed band frames those
   rows, from the lowest to the highest of their likely finishes. */
let peak = 0;
let peakAt = 1;
for (let p = 1; p <= positions; p++) {
  const k = rows.filter((r) => r.low <= p && p <= r.high).length;
  if (k > peak) { peak = k; peakAt = p; }
}
const inPeak = items.filter((r) => r.low <= peakAt && peakAt <= r.high);
const firstRow = Math.min(...inPeak.map((r) => r.i));
const lastRow = Math.max(...inPeak.map((r) => r.i));
const boxFrom = clamp(ipos(Math.min(...inPeak.map((r) => r.median)) - 0.5));
const boxTo = clamp(ipos(Math.max(...inPeak.map((r) => r.median)) + 0.5));
const contiguous = lastRow - firstRow + 1 === inPeak.length;

/* Ticks at 1, every third position and the last; the phone keeps four. */
const tickSet = [...new Set([1, ...Array.from({ length: Math.floor(positions / 3) }, (_, k) => (k + 1) * 3), positions])]
  .filter((t) => t <= positions && !(t !== positions && positions - t < 2));
const phoneTicks = new Set([1, tickSet[Math.floor(tickSet.length / 3)], tickSet[Math.floor((2 * tickSet.length) / 3)], positions]);

const zoneMarks = zones.map((z, k) => {
  const start = clamp(ipos(z.fromPos - 0.5));
  const end = clamp(ipos(z.toPos + 0.5));
  return { ...z, k, start, width: end - start, alignEnd: end > 60 };
});

/* The model reaches the figure as one muted line: the projection must name
   what produced it (blueprint §9). `runs` joins it when the model string does
   not already carry the count. */
const modelLine =
  runs && !/\d[\d,]*\s*(runs|simulations|sims)/i.test(model)
    ? `${model} · ${runs.toLocaleString('en-US')} runs`
    : model;
const noted = items.filter((r) => r.note);
const sentence = (r: (typeof items)[number]) =>
  `${r.name}: most likely ${ord(r.median)}, 90% range ${ord(r.low)} to ${ord(r.high)}, overlapping ${r.n} other ${r.n === 1 ? 'range' : 'ranges'}.`;
---

<VizCard prefix="px-fin" caption={caption} source={source}>
  <div class="px-fin__head">
    <div class="px-fin__big" data-cue="overlap">
      <span class="px-fin__num" data-build="4" data-build-kind="counter" data-to={peak}>{peak}</span>
      <span class="px-fin__big-l"><span class="px-cue-tag" data-cue-tag="overlap" hidden></span>Ranges overlap</span>
    </div>
    <div class="px-fin__key" data-build="1">
      <span class="px-fin__keyitem"><i class="px-fin__kdot"></i>Likely finish</span>
      <span class="px-fin__keyitem"><i class="px-fin__kbar"></i>90% range</span>
    </div>
  </div>

  <div class="px-fin__plot" role="list" aria-label="Projected finishing positions with 90% ranges">
    {/* The strips, the ticks and the dashed band sit over the TRACK column
        only, so position 1 starts where the bars start. */}
    <div class="px-fin__over" aria-hidden="true">
      <div class="px-fin__zones" data-cue="zones">
        {zoneMarks.map((z) => (
          <div class="px-fin__zone" data-tone={z.tone} data-build="1" style={`left:${pc(z.start)};width:${pc(z.width)}`}>
            <span class="px-fin__zl" data-end={z.alignEnd ? 'true' : undefined}>{z.k === 0 && <span class="px-cue-tag" data-cue-tag="zones" hidden></span>}{z.label}</span>
          </div>
        ))}
      </div>
      <div class="px-fin__ticks" data-build="1">
        {tickSet.map((t) => (
          <span class="px-fin__tick" data-phone={phoneTicks.has(t) ? 'true' : undefined} style={`left:${pc(ipos(t))}`}>{t}</span>
        ))}
      </div>
      {inPeak.length > 1 && contiguous && (
        <div
          class="px-fin__band"
          data-cue="overlap"
          data-build="4"
          style={`left:${pc(boxFrom)};width:${pc(boxTo - boxFrom)};--r0:${firstRow};--rn:${inPeak.length}`}
        ></div>
      )}
    </div>

    {items.map((r) => (
      <div class="px-fin__row" role="listitem" data-cue={r.i + 1} data-hl={r.i === defaultIdx ? 'true' : undefined} aria-label={sentence(r)}>
        <span class="px-fin__name" data-build="1"><span class="px-cue-tag" data-cue-tag={r.i + 1} hidden></span><span class="px-fin__nm">{r.name}</span></span>
        <span class="px-fin__track" aria-hidden="true">
          <span class="px-fin__bar" data-build="2" data-build-kind="grow-x" style={`left:${pc(r.barLeft)};width:${pc(r.barWidth)}`}></span>
          <span class="px-fin__dot" data-build="3" data-build-kind="drop" style={`left:${pc(r.dotLeft)}`}></span>
        </span>
      </div>
    ))}
  </div>

  {noted.length > 0 && (
    <ul class="px-fin__notes" data-build="4">
      {noted.map((r) => <li><b>{r.name}</b> {r.note}</li>)}
    </ul>
  )}
  <p class="px-fin__model" data-build="4">{modelLine}</p>
</VizCard>

<style>
  .px-fin__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 16px; margin-bottom: 14px; }
  .px-fin__big { display: flex; flex-direction: column; gap: 8px; }
  .px-fin__num {
    font-family: var(--font-ui);
    font-size: 96px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-deep);
    padding-bottom: 0.12em;
  }
  .px-fin__big-l { display: inline-flex; align-items: center; font-family: var(--font-ui); font-size: 12px; line-height: 1.35; color: var(--muted); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  .px-fin__key { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .px-fin__keyitem { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-ui); font-size: 12px; line-height: 1.3; color: var(--muted); }
  .px-fin__kdot { flex: none; width: 12px; height: 12px; border-radius: 50%; background: var(--accent-deep); }
  .px-fin__kbar { flex: none; width: 24px; height: 10px; border-radius: 5px; background: color-mix(in oklab, var(--accent) 50%, var(--paper-2)); }

  /* The row grid: the name column, then the track. The overlay is inset by
     the same numbers (name + gap on the left). */
  .px-fin__plot { --name: 132px; --gap: 12px; --rh: 32px; position: relative; padding-top: 42px; }
  .px-fin__row {
    position: relative;
    display: grid;
    grid-template-columns: var(--name) minmax(0, 1fr);
    column-gap: var(--gap);
    align-items: center;
    height: var(--rh);
    border-top: 1px solid var(--hair);
  }
  .px-fin__row:last-child { border-bottom: 1px solid var(--hair); }
  .px-fin__over { position: absolute; top: 0; bottom: 0; right: 0; left: calc(var(--name) + var(--gap)); pointer-events: none; }
  .px-fin__zones { position: absolute; inset: 0; }
  .px-fin__zone { position: absolute; top: 42px; bottom: 0; }
  .px-fin__zone[data-tone='good'] { background: var(--accent-tint); }
  .px-fin__zone[data-tone='bad'] { background: var(--paper-3); }
  .px-fin__zl {
    position: absolute;
    top: -42px;
    left: 2px;
    display: inline-flex;
    align-items: center;
    width: max-content;
    max-width: 180px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    line-height: 20px;
    color: var(--accent-deep);
    white-space: nowrap;
  }
  .px-fin__zl .px-cue-tag { margin-right: 6px; }
  .px-fin__zl[data-end] { left: auto; right: 2px; }
  .px-fin__zone[data-tone='bad'] .px-fin__zl { color: var(--muted); }
  .px-fin__ticks { position: absolute; left: 0; right: 0; top: 22px; height: 16px; }
  .px-fin__tick {
    position: absolute;
    top: 0;
    translate: -50% 0;
    font-family: var(--font-ui);
    font-size: 12px;
    line-height: 16px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .px-fin__band {
    position: absolute;
    top: calc(42px + var(--r0) * var(--rh) + 3px);
    height: calc(var(--rn) * var(--rh) - 6px);
    border: 1.5px dashed var(--accent-deep);
    border-radius: 4px;
  }
  .px-fin__name { display: flex; align-items: center; min-width: 0; font-family: var(--font-ui); font-size: 13px; line-height: 1.2; color: var(--ink); }
  .px-fin__name .px-cue-tag { margin-right: 6px; }
  .px-fin__nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .px-fin__row[data-hl] .px-fin__name { font-weight: 600; color: var(--accent-deep); }
  .px-fin__track { position: relative; display: block; height: 14px; }
  .px-fin__bar {
    position: absolute;
    top: 2px;
    height: 10px;
    border-radius: 5px;
    background: color-mix(in oklab, var(--accent) 50%, var(--paper-2));
    transform-origin: 0 50%;
  }
  .px-fin__row[data-hl] .px-fin__bar { background: var(--accent); }
  .px-fin__dot {
    position: absolute;
    top: 0;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 50%;
    background: var(--accent-deep);
    box-shadow: 0 0 0 2px var(--paper-2);
  }
  .px-fin__notes { margin: 14px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; font-family: var(--font-ui); font-size: 13px; line-height: 1.4; color: var(--ink-2); }
  .px-fin__notes b { font-weight: 600; color: var(--ink); }
  .px-fin__model { margin: 10px 0 0; font-family: var(--font-ui); font-size: 12px; line-height: 1.4; color: var(--muted); }

  @media (max-width: 640px) {
    .px-fin__plot { --name: 100px; --gap: 10px; }
    .px-fin__tick:not([data-phone]) { display: none; }
  }
  /* LENS §7: the pinned figure headline is 96, 72 on phones. */
  @media (max-width: 767px) { .px-fin__num { font-size: 72px; } }
</style>
