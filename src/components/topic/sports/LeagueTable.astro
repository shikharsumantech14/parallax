---
/*
  LeagueTable — v2 sports standings table (.lt) inside the elevated .px-viz
  card. Rows stagger in left→right on scroll; qualify/relegation bands paint
  as a left inset rule; form pills colour by result. Faithful port of the kit's
  <LeagueTable>. Build-time, zero runtime JS (reveal handled by CSS via
  core/Reveal.astro toggling .is-in on the .px-viz).

  Use for: football/cricket league standings, tournament
  points tables, series results.

  props:
    rows[]       — { pos: number, posChange?: number,
                     team: string, badge?: string,
                     played: number, won: number,
                     drawn?: number, lost: number,
                     gf?: number, ga?: number,
                     gd?: number, points: number,
                     form?: string[],     // 'W' | 'D' | 'L'
                     highlight?: 'top' | 'promotion' | 'relegation' | 'qualified' }
    showDrawn    — show Drawn column (default true; set false for cricket)
    showGoals    — show GF/GA/GD columns (default true)
    caption
    source
*/
interface TableRow {
  pos: number;
  posChange?: number;   // +ve = moved up, -ve = moved down, 0 = same
  team: string;
  badge?: string;       // emoji or short text badge
  played: number;
  won: number;
  drawn?: number;
  lost: number;
  gf?: number;
  ga?: number;
  gd?: number;
  points: number;
  form?: string[];      // up to 5 recent results: 'W' | 'D' | 'L'
  highlight?: 'top' | 'promotion' | 'relegation' | 'qualified';
}
interface Props {
  rows: TableRow[];
  showDrawn?: boolean;
  showGoals?: boolean;
  caption?: string;
  source?: string;
}
const {
  rows = [],
  showDrawn = true,
  showGoals = true,
  caption,
  source,
} = Astro.props;

// Map an emoji/short badge to a swatch colour. Falls back to the muted token
// for any badge the kit doesn't recognise (or when no badge is supplied).
const badgeColor = (b?: string): string => {
  const map: Record<string, string> = {
    '🟣': '#7b2d8e', '🟠': '#e8730c', '🩷': '#ec4899', '🔴': '#c0392b',
    '🔵': '#2563eb', '🟡': '#eab308', '🔷': '#0ea5e9', '💙': '#1e3a8a',
    '🩵': '#7dd3fc',
  };
  return (b && map[b]) || 'var(--muted)';
};
---

<div class="px-viz" data-reveal>
  {caption && <div class="px-viz__cap"><span>{caption}</span></div>}
  <table class="lt">
    <thead>
      <tr>
        <th class="l">#</th>
        <th class="l">Team</th>
        <th>P</th>
        <th>W</th>
        {showDrawn && <th>D</th>}
        <th>L</th>
        {showGoals && <th class="hide">GD</th>}
        <th>Pts</th>
        <th class="hide">Form</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => (
        <tr data-band={r.highlight || ''} style={`transition-delay:${i * 45}ms`}>
          <td>
            <span class="lt__pos">
              {r.pos}
              {(r.posChange ?? 0) > 0 && <span class="lt__chg lt__chg--up">▲{r.posChange}</span>}
              {(r.posChange ?? 0) < 0 && <span class="lt__chg lt__chg--dn">▼{Math.abs(r.posChange as number)}</span>}
            </span>
          </td>
          <td class="team"><span class="lt__badge" style={`background:${badgeColor(r.badge)}`}></span>{r.team}</td>
          <td>{r.played}</td>
          <td>{r.won}</td>
          {showDrawn && <td>{r.drawn ?? '—'}</td>}
          <td>{r.lost}</td>
          {showGoals && <td class="hide">{r.gd != null ? (r.gd > 0 ? '+' : '') + r.gd : '—'}</td>}
          <td class="pts">{r.points}</td>
          <td class="hide"><span class="lt__form">{(r.form ?? []).slice(-5).map((f) => <span class={'lt__fp lt__fp--' + f}>{f}</span>)}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="lt__legend">
    <span class="key"><span class="sw" style="background:var(--accent)"></span>Playoff places</span>
    <span class="key"><span class="sw" style="background:#c0392b"></span>Bottom three</span>
  </div>
</div>
