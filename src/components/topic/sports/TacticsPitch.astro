---
/**
 * TacticsPitch (sports) — a team's shape on a pitch seen from behind its own
 * goal (Lens Phase 6, 2026-09-30; the board is Lib-tactics-pitch). The
 * formation set at 48 with the team under it, a two-key legend, then the
 * pitch drawn in perspective on paper (markings in hair-2, the own goal at
 * the foot), the outfield block as one soft tint shape, each line of the team
 * joined by a thin rule, and a disc per player: the shirt number (or the
 * position code when there is none) in the disc, the surname under it.
 *
 * The pitch is an SVG of lines only; the discs and every word are an HTML
 * layer over it, placed by percent and sized in real pixels, so the pitch
 * scales to any width and the discs keep their size and 12px type. The
 * CSS-3D recline and the pointer tilt are retired: the perspective is drawn.
 *
 * Coords: x, y in 0..100. x = pitch WIDTH (0 = left touchline), y = pitch
 * LENGTH (0 = own goal line, 100 = the far one).
 *
 * data: { players[]{ x, y, num?, name?, role? }, formation?, team? }
 *   num  — shirt number, shown in the disc
 *   name — surname shown under the disc (hidden in a box under 360px)
 *   role — position code ("GK", "RB"); in the disc when there is no `num`,
 *          always in the marker's label; a GK disc is drawn in ink-2
 *
 * Cue anchors:
 *   formation  the formation headline
 *   shape      the outfield block
 *   1..n       each player, in authored order
 *
 * The build (LENS §6.4): 1 the pitch, 2 the block fades and the lines draw,
 * 3 the players drop, 4 the formation and the legend.
 */
interface Player { x: number; y: number; num?: number | string; name?: string; role?: string; }
interface Props {
  players: Player[];
  formation?: string;
  team?: string;
  caption?: string;
  source?: string;
}
const { players = [], formation, team } = Astro.props;

/* The pitch in perspective: the own goal line 420 units across at the foot,
   the far line narrower and higher. y maps through a foreshortening curve so
   the far half recedes. */
const W = 440, H = 400, BOT = 368, TOPY = 26, K = 0.55;
const wAt = (t: number) => 420 / (1 + K * t);
const yAt = (t: number) => BOT - (BOT - TOPY) * ((t * (1 + K)) / (1 + K * t));
const P = (x: number, y: number) => {
  const t = Math.max(0, Math.min(1, y / 100));
  return { x: W / 2 + (x / 100 - 0.5) * wAt(t), y: yAt(t) };
};
const f = (n: number) => n.toFixed(1);
const poly = (pts: [number, number][]) => pts.map(([x, y]) => { const p = P(x, y); return `${f(p.x)},${f(p.y)}`; }).join(' ');
/* An ellipse on the turf, traced as a polyline through the projection. */
const ring = (cx: number, cy: number, rx: number, ry: number, a0 = 0, a1 = 360) =>
  poly(Array.from({ length: 37 }, (_, k) => {
    const a = ((a0 + ((a1 - a0) * k) / 36) * Math.PI) / 180;
    return [cx + rx * Math.cos(a), cy + ry * Math.sin(a)] as [number, number];
  }));
// markings, in pitch percent (68 x 105 m)
const bx = (m: number) => (m / 68) * 100, by = (m: number) => (m / 105) * 100;
const lines = [
  poly([[0, 0], [100, 0], [100, 100], [0, 100], [0, 0]]),
  poly([[0, 50], [100, 50]]),
  ring(50, 50, bx(9.15), by(9.15)),
  poly([[50 - bx(20.16), 0], [50 - bx(20.16), by(16.5)], [50 + bx(20.16), by(16.5)], [50 + bx(20.16), 0]]),
  poly([[50 - bx(9.16), 0], [50 - bx(9.16), by(5.5)], [50 + bx(9.16), by(5.5)], [50 + bx(9.16), 0]]),
  poly([[50 - bx(20.16), 100], [50 - bx(20.16), 100 - by(16.5)], [50 + bx(20.16), 100 - by(16.5)], [50 + bx(20.16), 100]]),
  poly([[50 - bx(9.16), 100], [50 - bx(9.16), 100 - by(5.5)], [50 + bx(9.16), 100 - by(5.5)], [50 + bx(9.16), 100]]),
];
const g0 = P(50 - bx(3.66), 0), g1 = P(50 + bx(3.66), 0);

const surname = (name?: string) => {
  if (!name) return undefined;
  const t = name.trim().split(/\s+/);
  return t[t.length - 1] || name.trim();
};
const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v ?? 0));
const placed = players.map((p, i) => {
  const s = P(clamp(p.x, 4, 96), clamp(p.y, 3, 97));
  const gk = /^gk$/i.test(String(p.role ?? '').trim());
  return {
    ...p, i, gk, sx: s.x, sy: s.y,
    short: surname(p.name),
    disc: p.num != null && p.num !== '' ? String(p.num) : (p.role ?? ''),
    label: [p.num != null ? `No ${p.num}` : '', p.name, p.role].filter(Boolean).join(', '),
  };
});
const field = placed.filter((p) => !p.gk);

/* The block: the convex hull of the outfield players (monotone chain). */
const hull = (() => {
  const pts = field.map((p) => [p.sx, p.sy] as [number, number]).sort((a, b) => a[0] - b[0] || a[1] - b[1]);
  if (pts.length < 3) return [];
  const cr = (o: number[], a: number[], b: number[]) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
  const lo: number[][] = [], up: number[][] = [];
  for (const p of pts) { while (lo.length >= 2 && cr(lo[lo.length - 2], lo[lo.length - 1], p) <= 0) lo.pop(); lo.push(p); }
  for (const p of [...pts].reverse()) { while (up.length >= 2 && cr(up[up.length - 2], up[up.length - 1], p) <= 0) up.pop(); up.push(p); }
  return [...lo.slice(0, -1), ...up.slice(0, -1)];
})();
/* The lines of the team: outfield players grouped by depth (a gap of more
   than ten points of pitch length starts a new line), each joined across. */
const bands: (typeof field)[] = [];
for (const p of [...field].sort((a, b) => a.y - b.y)) {
  const last = bands[bands.length - 1];
  if (last && p.y - last[last.length - 1].y <= 10) last.push(p);
  else bands.push([p]);
}
const joins = bands.filter((b) => b.length > 1).map((b) => [...b].sort((a, c) => a.sx - c.sx).map((p) => `${f(p.sx)},${f(p.sy)}`).join(' '));
const pc = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---

<div class="px-viz px-pitch" data-build-scene>
  {(formation || team) && (
    <div class="px-pitch__head">
      <div class="px-pitch__f" data-cue="formation" data-build="4">
        {formation && <span class="px-pitch__big">{formation}</span>}
        <span class="px-pitch__team"><span class="px-cue-tag" data-cue-tag="formation" hidden></span>{team ?? 'Formation'}</span>
      </div>
      <div class="px-pitch__key" data-build="4">
        <span class="px-pitch__k"><i class="px-pitch__kd"></i>One player</span>
        {hull.length > 2 && <span class="px-pitch__k"><i class="px-pitch__ks"></i>Block shape</span>}
      </div>
    </div>
  )}

  <div class="px-pitch__fig">
    <svg class="px-pitch__svg" viewBox={`0 0 ${W} ${H}`} role="img"
      aria-label={`${team ?? 'The team'}${formation ? `, ${formation}` : ''}: ${placed.map((p) => p.label).join('; ')}`}>
      <g data-build="1" fill="none" stroke="var(--hair-2)" stroke-width="1.5" stroke-linejoin="round">
        <polygon points={lines[0]} fill="var(--paper)" />
        {lines.slice(1).map((d) => <polyline points={d} />)}
        <rect x={f(g0.x)} y={BOT} width={f(g1.x - g0.x)} height="10" stroke="var(--ink-2)" />
      </g>
      {hull.length > 2 && (
        <g data-cue="shape">
          <polygon class="px-pitch__hull" points={hull.map(([x, y]) => `${f(x)},${f(y)}`).join(' ')} data-build="2" />
        </g>
      )}
      {joins.map((d) => <polyline class="px-pitch__join" points={d} data-build="2" data-build-kind="draw" />)}
    </svg>
    <div class="px-pitch__layer">
      {hull.length > 2 && (
        <span class="px-pitch__tag" style={`left:${pc(Math.max(...hull.map((h) => h[0])) + 6, W)};top:${pc(hull.reduce((a, h) => a + h[1], 0) / hull.length, H)}`}><span class="px-cue-tag" data-cue-tag="shape" hidden></span></span>
      )}
      {placed.map((p) => (
        <span class="px-pitch__mk" data-cue={p.i + 1} data-gk={p.gk ? 'true' : undefined} data-build="3" data-build-kind="drop"
          style={`left:${pc(p.sx, W)};top:${pc(p.sy, H)}`} role="img" aria-label={p.label}>
          <span class="px-pitch__disc">{p.disc}</span>
          {p.short && <span class="px-pitch__name">{p.short}</span>}
          <span class="px-pitch__mt"><span class="px-cue-tag" data-cue-tag={p.i + 1} hidden></span></span>
        </span>
      ))}
    </div>
  </div>
  {/* No source line and no caption: core/Section.astro prints both. */}
</div>

<style>
  .px-pitch { container-type: inline-size; }
  .px-pitch__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 16px; margin-bottom: 8px; }
  .px-pitch__f { display: flex; flex-direction: column; gap: 8px; }
  .px-pitch__big {
    font-family: var(--font-ui);
    font-size: 96px;
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .px-pitch__team { display: inline-flex; align-items: center; font-family: var(--font-ui); font-size: 13px; line-height: 1.3; color: var(--muted); }
  .px-pitch__key { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .px-pitch__k { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-ui); font-size: 12px; line-height: 1.3; color: var(--muted); }
  .px-pitch__kd { flex: none; width: 16px; height: 16px; border-radius: 50%; background: var(--accent-deep); }
  .px-pitch__ks { flex: none; width: 22px; height: 14px; border-radius: 7px; background: color-mix(in oklab, var(--accent) 28%, transparent); }
  .px-pitch__fig { position: relative; }
  .px-pitch__svg { display: block; width: 100%; height: auto; }
  .px-pitch__hull { fill: var(--accent); fill-opacity: 0.2; stroke: var(--accent); stroke-opacity: 0.2; stroke-width: 40; stroke-linejoin: round; }
  .px-pitch__join { fill: none; stroke: var(--ink-2); stroke-opacity: 0.6; stroke-width: 1.8; }
  .px-pitch__layer { position: absolute; inset: 0; pointer-events: none; }
  .px-pitch__tag { position: absolute; translate: 0 -50%; }
  .px-pitch__tag .px-cue-tag { margin: 0; }
  .px-pitch__mk {
    position: absolute;
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border-radius: 999px;
  }
  .px-pitch__disc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    box-sizing: border-box;
    border: 2px solid var(--paper-2);
    border-radius: 999px;
    background: var(--accent-deep);
    color: var(--paper-2);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .px-pitch__mk[data-gk] .px-pitch__disc { background: var(--ink-2); }
  .px-pitch__name {
    position: absolute;
    top: 31px;
    left: 50%;
    translate: -50% 0;
    max-width: 96px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0 3px;
    border-radius: 3px;
    background: color-mix(in oklab, var(--paper-2) 85%, transparent);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--ink);
  }
  .px-pitch__mt { position: absolute; left: 24px; top: -14px; }
  .px-pitch__mt .px-cue-tag { margin: 0; }
  @container (max-width: 400px) {
    .px-pitch__name { display: none; }
  }
  /* LENS §7: the pinned figure headline is 96, 72 on phones. */
  @media (max-width: 767px) { .px-pitch__big { font-size: 72px; } }
</style>
