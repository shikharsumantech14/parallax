---
/**
 * PlayerCard — the profile card (Lens Phase 6, 2026-09-30; the board is
 * Lib-player-card, the named redraw of BRIEF-7 §2). The front only: a header
 * band on the desk tint with the team and the position chip, the rating at 96
 * (this kind IS a number), the name beside it, and the attributes as bars on
 * a well, the strongest one in the desk text ink. The CSS-3D tilt, the flip
 * and the back face are retired: every attribute is on the one face.
 *
 * HTML, no JS of its own.
 *
 * Cue anchors:
 *   rating  the rating and the name
 *   stats   the attribute block (its label and every bar)
 *   1..n    the attribute rows, in authored order
 *
 * The build (LENS §6.4): 1 the attribute names, 2 the bars grow from the
 * left, 3 the values rise, 4 the rating counts up.
 */
interface Stat { label: string; value: number; max?: number; }
interface Props { name: string; position?: string; team?: string; rating: number; stats: Stat[]; caption?: string; source?: string; }
const { name, position, team, rating, stats = [] } = Astro.props;
const pct = (s: Stat) => Math.max(0, Math.min(100, (s.value / (s.max ?? 100)) * 100));
const best = stats.length ? Math.max(...stats.map(pct)) : -1;
const isInt = Number.isInteger(Number(rating));
---

<div class="px-pcard" data-viz-root data-build-scene>
  <div class="px-pcard__card">
    {(team || position) && (
      <div class="px-pcard__band">
        <span class="px-pcard__team">{team}</span>
        {position && <span class="px-pcard__pos">{position}</span>}
      </div>
    )}
    <div class="px-pcard__body">
      <div class="px-pcard__head" data-cue="rating">
        <div class="px-pcard__r">
          <span class="px-pcard__num" data-build="4" data-build-kind={isInt ? 'counter' : undefined} data-to={isInt ? rating : undefined}>{rating}</span>
          <span class="px-pcard__rl"><span class="px-cue-tag" data-cue-tag="rating" hidden></span>Rating</span>
        </div>
        <p class="px-pcard__name">{name}</p>
      </div>
      {stats.length > 0 && (
        <div class="px-pcard__stats" data-cue="stats">
          <p class="px-pcard__sl"><span class="px-cue-tag" data-cue-tag="stats" hidden></span>Attributes</p>
          {stats.map((s, i) => (
            <div class="px-pcard__row" data-cue={i + 1} data-best={pct(s) === best ? 'true' : undefined}>
              <span class="px-pcard__l" data-build="1"><span class="px-cue-tag" data-cue-tag={i + 1} hidden></span>{s.label}</span>
              <span class="px-pcard__track"><span class="px-pcard__fill" data-build="2" data-build-kind="grow-x" style={`width:${pct(s).toFixed(1)}%`}></span></span>
              <span class="px-pcard__v" data-build="3" data-build-kind="rise">{s.value}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
  {/* No source line and no caption: core/Section.astro prints both. */}
</div>

<style>
  .px-pcard { container-type: inline-size; min-width: 0; font-family: var(--font-ui); }
  .px-pcard__card {
    overflow: hidden;
    border: 1px solid var(--hair);
    border-radius: var(--r-card, 6px);
    background: var(--paper);
    box-shadow: var(--shadow-1);
  }
  .px-pcard__band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 20px;
    background: var(--accent-tint);
  }
  .px-pcard__team {
    min-width: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }
  .px-pcard__pos {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--accent-deep);
    color: var(--paper);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .px-pcard__body { display: flex; flex-direction: column; gap: 20px; padding: 24px 20px; }
  .px-pcard__head { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 8px 20px; }
  .px-pcard__r { display: flex; flex-direction: column; gap: 8px; }
  .px-pcard__num {
    font-size: 96px;
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .px-pcard__rl { display: inline-flex; align-items: center; font-size: 13px; line-height: 1.3; color: var(--muted); }
  .px-pcard__name {
    flex: 1 1 160px;
    min-width: 0;
    margin: 0;
    padding-bottom: 26px;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .px-pcard__stats { display: flex; flex-direction: column; gap: 12px; padding-top: 18px; border-top: 1px solid var(--hair); }
  .px-pcard__sl {
    display: flex;
    align-items: center;
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .px-pcard__row {
    display: grid;
    grid-template-columns: minmax(0, 112px) minmax(0, 1fr) 32px;
    gap: 12px;
    align-items: center;
  }
  .px-pcard__l { display: flex; align-items: center; min-width: 0; font-size: 13px; line-height: 1.3; color: var(--ink); overflow-wrap: anywhere; }
  .px-pcard__row[data-best] .px-pcard__l { font-weight: 600; }
  .px-pcard__track { display: flex; height: 10px; border-radius: 5px; background: var(--paper-3); }
  .px-pcard__fill { display: block; height: 100%; border-radius: 5px; background: var(--accent); transform-origin: 0 50%; }
  .px-pcard__row[data-best] .px-pcard__fill { background: var(--accent-deep); }
  .px-pcard__v { font-size: 13px; font-weight: 600; line-height: 1.3; text-align: right; font-variant-numeric: tabular-nums; color: var(--ink); }
  .px-pcard__row[data-best] .px-pcard__v { color: var(--accent-deep); }
  @container (max-width: 360px) {
    .px-pcard__body { padding: 20px 16px; }
    .px-pcard__row { grid-template-columns: minmax(0, 96px) minmax(0, 1fr) 28px; gap: 10px; }
    .px-pcard__name { font-size: 24px; padding-bottom: 0; }
  }
  /* LENS §7: the pinned figure headline is 96, 72 on phones. */
  @media (max-width: 767px) { .px-pcard__num { font-size: 72px; } }
</style>
