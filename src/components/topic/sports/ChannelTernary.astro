---
/**
 * ChannelTernary (`channel-ternary`) — three shares that must total a hundred,
 * drawn in a triangle because only two of them are ever free (Lens Phase 6,
 * 2026-09-30; the board is Lib-channel-ternary).
 *
 * Blueprint: docs/design/blueprints/sports/channel-ternary.md. Prefix
 * `px-trn`, inside core/VizCard.astro. The triangle on paper with its 25 / 50
 * / 75 grid, the three corner words, the even-split mark at the centre, one
 * dot per entity; the entities with a note, and the most lopsided one, are
 * drawn in the desk text ink and named beside their dot. The table under it
 * is the identity layer: every entity and its three shares, the leading
 * share in the desk ink. The entity-select island of the launch design is
 * retired: the cues point now.
 *
 * Drawn for the panel AND the phone: a 292-unit viewBox with 12-unit labels
 * in the literal Instrument Sans stack, shown at up to 360px, so it prints at
 * 12px or more on a 293px phone body. No JS of its own.
 *
 * Cue anchors:
 *   corners  the three corner words
 *   even     the even-split mark
 *   1..n     each entity: its dot (with its numeral) and its table row, in
 *            authored order
 *
 * The build (LENS §6.4): 1 the triangle, grid and corners fade, 2 the dots
 * drop, 3 the names rise and the table rows fade.
 */
import VizCard from '../../core/VizCard.astro';

interface Corner { label: string }
interface Entity { name: string; values: [number, number, number]; note?: string }
interface Props {
  corners?: Corner[];
  entities?: Entity[];
  caption?: string;
  source?: string | { label: string; date?: string };
  howToRead?: string;
}
const { corners = [], entities = [], caption, source } = Astro.props;

/* ── Build-time validation (blueprint §3) ─────────────────────────────────
   A ternary plot of unconstrained values is meaningless — the geometry IS the
   sum constraint, so a payload that breaks it must not render at all. */
if (corners.length !== 3) throw new Error(`[channel-ternary] needs exactly 3 corners, got ${corners.length}.`);
if (entities.length < 4 || entities.length > 12) {
  throw new Error(`[channel-ternary] needs 4–12 entities, got ${entities.length}.`);
}
for (const e of entities) {
  if (!Array.isArray(e.values) || e.values.length !== 3) {
    throw new Error(`[channel-ternary] "${e.name}" must have exactly 3 values.`);
  }
  const sum = e.values[0] + e.values[1] + e.values[2];
  if (Math.abs(sum - 1) > 0.001) {
    throw new Error(`[channel-ternary] "${e.name}" values sum to ${sum.toFixed(4)}, not 1.0 (±0.001).`);
  }
}

/* Barycentric mapping: left corner bottom-left, the second corner at the
   apex, the third bottom-right. An equilateral triangle, side 252. */
const W = 292, H = 272;
const L = { x: 20, y: 244 }, T = { x: 146, y: 26 }, R = { x: 272, y: 244 };
const pt = (l: number, t: number, r: number) => ({ x: l * L.x + t * T.x + r * R.x, y: l * L.y + t * T.y + r * R.y });
const f = (n: number) => n.toFixed(1);
const CENTROID = pt(1 / 3, 1 / 3, 1 / 3);
const pct = (n: number) => Math.round(n * 100);

const rows = entities.map((e, i) => {
  const [l, t, r] = e.values;
  const p = pt(l, t, r);
  const shares = [l, t, r];
  const maxIdx = shares.indexOf(Math.max(...shares));
  return { ...e, i, x: p.x, y: p.y, p: shares.map(pct), maxIdx, maxPct: pct(shares[maxIdx]) };
});
const lopsided = rows.reduce((best, r) => (r.maxPct > rows[best].maxPct ? r.i : best), 0);
const named = rows.map((r) => r.i === lopsided || !!r.note);

/* A name tries the right of its dot, then the left, then above, then below,
   and takes the first place that stays inside the plot and clears every
   name already placed and every named dot (Instrument Sans 600 at 12, about
   .58em a character). Its numeral sits on the far side of the dot. */
type Place = { x: number; y: number; anchor: 'start' | 'end' | 'middle'; tx: number; ty: number };
const boxes: { l: number; r: number; t: number; b: number }[] = [];
const places = new Map<number, Place>();
for (const r of rows.filter((q) => named[q.i]).sort((a, b) => a.y - b.y)) {
  const w = r.name.length * 12 * 0.58;
  const tries: Place[] = [
    { x: r.x + 11, y: r.y + 4, anchor: 'start', tx: r.x - 33, ty: r.y - 11 },
    { x: r.x - 11, y: r.y + 4, anchor: 'end', tx: r.x + 11, ty: r.y - 11 },
    { x: r.x, y: r.y - 12, anchor: 'middle', tx: r.x - 11, ty: r.y + 9 },
    { x: r.x, y: r.y + 22, anchor: 'middle', tx: r.x - 11, ty: r.y - 31 },
  ];
  const box = (p: Place) => {
    const l = p.anchor === 'start' ? p.x : p.anchor === 'end' ? p.x - w : p.x - w / 2;
    return { l, r: l + w, t: p.y - 11, b: p.y + 3 };
  };
  const dotsHit = (b: { l: number; r: number; t: number; b: number }) =>
    rows.some((o) => named[o.i] && o.x + 7 > b.l && o.x - 7 < b.r && o.y + 7 > b.t && o.y - 7 < b.b);
  const pick = tries.find((p) => {
    const b = box(p);
    return b.l >= 2 && b.r <= W - 2 && b.t >= 18 && b.b <= H - 2 && !boxes.some((o) => b.l < o.r + 4 && o.l < b.r + 4 && b.t < o.b + 2 && o.t < b.b + 2) && !dotsHit(b);
  }) ?? tries[3];
  boxes.push(box(pick));
  places.set(r.i, pick);
}

const grid: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (const g of [0.25, 0.5, 0.75]) {
  const rest = 1 - g;
  for (const [a, b] of [
    [pt(g, rest, 0), pt(g, 0, rest)],
    [pt(rest, g, 0), pt(0, g, rest)],
    [pt(rest, 0, g), pt(0, rest, g)],
  ]) grid.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y });
}
const UI = "font-family:'Instrument Sans','Helvetica Neue',Arial,sans-serif";
---

<VizCard prefix="px-trn" caption={caption} source={source}>
  <svg class="px-trn__svg" viewBox={`0 0 ${W} ${H}`} role="img"
    aria-label={`${rows.length} teams placed by their shares of ${corners.map((c) => c.label.toLowerCase()).join(', ')}`}>
    <g data-build="1">
      <polygon points={`${L.x},${L.y} ${T.x},${T.y} ${R.x},${R.y}`} fill="var(--paper)" stroke="var(--ink-2)" stroke-width="1.5" />
      {grid.map((g) => <line x1={f(g.x1)} y1={f(g.y1)} x2={f(g.x2)} y2={f(g.y2)} stroke="var(--hair)" stroke-width="1" />)}
    </g>
    <g data-cue="corners" data-build="1">
      <text x={T.x} y="14" text-anchor="middle" class="px-trn__corner" style={UI}>{corners[1].label}</text>
      <text x="14" y="264" text-anchor="start" class="px-trn__corner" style={UI}>{corners[0].label}</text>
      <text x="278" y="264" text-anchor="end" class="px-trn__corner" style={UI}>{corners[2].label}</text>
      <foreignObject x={T.x + 44} y="1" width="22" height="22"><span class="px-cue-tag" data-cue-tag="corners" hidden></span></foreignObject>
    </g>
    <g data-cue="even" data-build="1">
      <path d={`M${f(CENTROID.x - 5)} ${f(CENTROID.y)}h10M${f(CENTROID.x)} ${f(CENTROID.y - 5)}v10`} stroke="var(--ink-2)" stroke-width="1.5" />
      <foreignObject x={f(CENTROID.x - 11)} y={f(CENTROID.y + 8)} width="22" height="22"><span class="px-cue-tag" data-cue-tag="even" hidden></span></foreignObject>
    </g>
    {rows.map((r) => (
      <g data-cue={r.i + 1} data-named={named[r.i] ? 'true' : undefined}>
        <circle class="px-trn__dot" cx={f(r.x)} cy={f(r.y)} r={named[r.i] ? 7 : 5} data-build="2" data-build-kind="drop" />
        {places.has(r.i) && (
          <text x={f(places.get(r.i)!.x)} y={f(places.get(r.i)!.y)} text-anchor={places.get(r.i)!.anchor} class="px-trn__name" style={UI} data-build="3" data-build-kind="rise">{r.name}</text>
        )}
        <foreignObject x={f(places.has(r.i) ? places.get(r.i)!.tx : r.x - 11)} y={f(places.has(r.i) ? places.get(r.i)!.ty : r.y - 31)} width="22" height="22"><span class="px-cue-tag" data-cue-tag={r.i + 1} hidden></span></foreignObject>
      </g>
    ))}
  </svg>

  {/* The identity layer: the plot names only a few dots, because eight names
      inside a small triangle cannot be placed without collision. */}
  <table class="px-trn__table">
    <thead>
      <tr>
        <th scope="col">Team, %</th>
        {corners.map((c) => <th scope="col">{c.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr data-cue={r.i + 1} data-named={named[r.i] ? 'true' : undefined} data-build="3">
          <th scope="row">{r.name}</th>
          {r.p.map((v, k) => <td data-hi={k === r.maxIdx && r.maxPct >= 40 ? 'true' : undefined}>{v}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
  {rows.some((r) => r.note) && (
    <ul class="px-trn__notes" data-build="3">
      {rows.filter((r) => r.note).map((r) => <li><b>{r.name}</b> {r.note}</li>)}
    </ul>
  )}
</VizCard>

<style>
  .px-trn__svg { display: block; width: 100%; max-width: 360px; height: auto; margin: 0 auto; overflow: visible; }
  .px-trn__svg foreignObject { overflow: visible; }
  .px-trn__svg .px-cue-tag { margin: 1px; }
  .px-trn__corner { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; fill: var(--ink-2); }
  .px-trn__dot { fill: var(--ink-2); fill-opacity: 0.7; stroke: var(--paper-2); stroke-width: 1.5; }
  [data-named] > .px-trn__dot { fill: var(--accent-deep); fill-opacity: 1; }
  .px-trn__name {
    font-size: 12px;
    font-weight: 600;
    fill: var(--accent-deep);
    stroke: var(--paper);
    stroke-width: 3px;
    stroke-linejoin: round;
    paint-order: stroke;
  }

  .px-trn__table {
    display: table;
    width: 100%;
    margin-top: 16px;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .px-trn__table th,
  .px-trn__table td { padding: 6px 0 6px 8px; border-top: 1px solid var(--hair); text-align: right; font-weight: 400; color: var(--ink); }
  .px-trn__table thead th { padding-top: 0; border-top: 0; font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .px-trn__table th:first-child { padding-left: 0; text-align: left; }
  .px-trn__table tbody th { overflow-wrap: anywhere; }
  .px-trn__table tr[data-named] th { font-weight: 600; color: var(--accent-deep); }
  .px-trn__table td[data-hi] { font-weight: 600; color: var(--accent-deep); }
  .px-trn__notes { margin: 12px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; font-family: var(--font-ui); font-size: 13px; line-height: 1.4; color: var(--ink-2); }
  .px-trn__notes b { font-weight: 600; color: var(--ink); }
</style>
