---
/**
 * CourtValue (sports) — the spatial value SURFACE over a pitch or a court
 * (Lens Phase 6, 2026-09-30; the board is Lib-court-value).
 *
 * The penalty box (or half-pitch, or half-court) washed with filled contour
 * bands of expected value, from the desk tint at the lowest band through the
 * mark to the text ink at the highest, so the reader sees the geography of a
 * good chance; the raw shots optionally plotted on top as hollow dots, the
 * best spot ringed and its value set at 48 over the figure. One ramp row
 * under it names the bands; one muted line names the model, the smoothing
 * and the domain.
 *
 * SVG, build-time only: the value field, the marching-squares contours and
 * the bands are computed here. The drawing carries NO text: the two pitch
 * words and the cue numerals are an HTML layer over it (placed by percent,
 * sized in real pixels), and the legend is HTML, so the surface scales to any
 * width without a sideways scroll and every word prints at 12px.
 *
 * Coordinate convention (the ShotMap convention): shot x,y are 0–100 pitch
 * coords — x toward goal (depth), y across — mapped into the selected
 * surface's true metre bbox by (x·1.05, y·0.68) [a 105 m × 68 m pitch].
 *
 * Cue anchors:
 *   peak    the best spot (its ring and the headline value)
 *   shots   the sampled shots (when shown)
 *   1..k    each contour band, lowest first (the band and its legend step)
 *
 * The build (LENS §6.4): 1 the turf and the chalk, 2 the bands, 3 the shots,
 * the ring, the words and the legend, 4 the value.
 */
interface CourtValueData {
  surface?: 'football-box' | 'football-half' | 'basketball-half';
  model: string;               // the value model NAMED (honesty)
  valueLabel: string;          // what the contour value MEANS, ≤ 3 words
  valueRange?: [number, number];
  grid?: { cols: number; rows: number; values: number[] };
  shots?: Array<{ x: number; y: number; value: number }>;
  levels?: number[];
  showShots?: boolean;
  smoothed?: boolean;
  caption?: string;
  source?: string;
}
type Props = CourtValueData;

const {
  surface = 'football-box',
  model,
  valueLabel,
  valueRange,
  grid,
  shots,
  levels: levelsIn,
  showShots = false,
  smoothed: smoothedIn,
  caption,
  source,
} = Astro.props;

const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
const fmt = (v: number) => (Math.abs(v) < 1 && v !== 0 ? v.toFixed(2) : v.toFixed(v % 1 === 0 ? 0 : 2));

// ── SURFACES ────────────────────────────────────────────────────────────────
// Each surface declares its viewBox and the true metre bbox of the region, in
// pitch metres (105 × 68 full pitch). `xm` = depth toward goal, `ym` = across.
type Surface = {
  W: number; H: number;
  ymMin: number; ymMax: number;   // across metres (pitch y range shown)
  xmMin: number; xmMax: number;   // depth metres (pitch x range shown), xmMax = goal line
};
const SURFACES: Record<string, Surface> = {
  // 40 m wide × 30 m deep penalty-box third in front of one goal (goal @ 105 m).
  'football-box':    { W: 620, H: 465, ymMin: 14, ymMax: 54, xmMin: 75,  xmMax: 105 },
  // 68 m wide × 52.5 m deep attacking half (halfway line @ 52.5 m → goal @ 105 m).
  'football-half':   { W: 560, H: 725, ymMin: 0,  ymMax: 68, xmMin: 52.5, xmMax: 105 },
  // ~15.24 m wide × 14.33 m deep NBA half-court, expressed in the same metre frame.
  'basketball-half': { W: 600, H: 564, ymMin: 26.4, ymMax: 41.6, xmMin: 90.7, xmMax: 105 },
};
const surf = SURFACES[surface] ?? SURFACES['football-box'];
const { W, H } = surf;
const across = surf.ymMax - surf.ymMin;   // metres across
const depth  = surf.xmMax - surf.xmMin;   // metres deep

// Plot area inside the viewBox (top margin holds the goal frame + peak label).
const MT = 44, MSIDE = 18, MB = 18;
const availW = W - 2 * MSIDE, availH = H - MT - MB;
const s = Math.min(availW / across, availH / depth);   // isotropic px/metre
const plotW = across * s, plotH = depth * s;
const OX = MSIDE + (availW - plotW) / 2;                // plot origin x (centred)
const OY = MT;                                          // plot origin y (goal line)

// metre → px (goal line xmMax sits at the top, OY)
const px = (ym: number) => OX + (ym - surf.ymMin) * s;
const py = (xm: number) => OY + (surf.xmMax - xm) * s;
// shot 0–100 pitch coords → metre
const shotXm = (x: number) => x * 1.05;   // depth toward goal
const shotYm = (y: number) => y * 0.68;   // across

// ── DOMAIN ──────────────────────────────────────────────────────────────────
// Build the raw sample list either from `shots` or from the `grid` cell values.
const hasShots = Array.isArray(shots) && shots.length > 0;
const hasGrid = !!grid && Array.isArray(grid.values) && grid.values.length > 0;
// EXACTLY ONE of grid / shots — if both given, `grid` wins (pre-binned, honest).
const useGrid = hasGrid;
const smoothed = smoothedIn ?? (useGrid ? false : hasShots);   // sparse shots ⇒ smoothed

// Grid resolution: GX across, GY ≈ square cells over the bbox.
const GX = 40;
const GY = Math.max(6, Math.round(GX * (plotH / plotW)));

// Value domain.
let rawMax = 0;
if (useGrid) rawMax = Math.max(...grid!.values);
else if (hasShots) rawMax = Math.max(...shots!.map((sh) => sh.value));
const vMin = valueRange ? valueRange[0] : 0;
const vMax = valueRange ? valueRange[1] : (rawMax > 0 ? rawMax : 1);

// ── FIELD (clamped to [vMin, vMax] BEFORE contouring) ────────────────────────
// Nadaraya–Watson kernel-weighted mean of nearby shots' value, Gaussian kernel,
// bandwidth 6 m in surface metres. Cells with Σw < 0.01 held at the domain min
// (no data ⇒ no phantom value). A directly-supplied grid is contoured as-is.
const BW = 6;                       // kernel bandwidth, metres
const TWO_BW2 = 2 * BW * BW;
const field = new Float64Array(GX * GY);
const weight = new Float64Array(GX * GY);   // Σw per cell (data density → peak tie-break)

for (let j = 0; j < GY; j++) {
  for (let i = 0; i < GX; i++) {
    const idx = j * GX + i;
    if (useGrid) {
      // map our grid node onto the supplied grid (row 0 = goal line / top)
      const c = Math.round((i / (GX - 1)) * (grid!.cols - 1));
      const r = Math.round((1 - j / (GY - 1)) * (grid!.rows - 1));
      const v = grid!.values[r * grid!.cols + c] ?? vMin;
      field[idx] = clamp(v, vMin, vMax);
      weight[idx] = 1;
      continue;
    }
    // node metre position
    const ym = surf.ymMin + (i / (GX - 1)) * across;
    const xm = surf.xmMin + (j / (GY - 1)) * depth;
    let sw = 0, swv = 0;
    for (const sh of shots!) {
      const dx = xm - shotXm(sh.x);
      const dy = ym - shotYm(sh.y);
      const w = Math.exp(-(dx * dx + dy * dy) / TWO_BW2);
      sw += w; swv += w * sh.value;
    }
    weight[idx] = sw;
    const v = sw < 0.01 ? vMin : swv / sw;
    field[idx] = clamp(v, vMin, vMax);
  }
}

// getV with a vMin border ring so every contour closes just inside/at the plot
// edge (no open-boundary special-casing); anything drawn in the border ring is
// removed by the plot clip.
const getV = (i: number, j: number) =>
  i < 0 || i >= GX || j < 0 || j >= GY ? vMin : field[j * GX + i];

// px of a (possibly fractional) node index
const nodeX = (fi: number) => OX + (fi / (GX - 1)) * plotW;
const nodeY = (fj: number) => OY + plotH * (1 - fj / (GY - 1));

// ── CONTOUR EXTRACTION — inlined marching squares (closed rings) ─────────────
// corners c0=BL(i,j) c1=BR(i+1,j) c2=TR(i+1,j+1) c3=TL(i,j+1); above = v ≥ L.
// index = c0 + 2·c1 + 4·c2 + 8·c3. Each case connects cell edges (0 bottom,
// 1 right, 2 top, 3 left). Crossings are keyed by canonical grid-edge id so
// adjacent cells stitch exactly (no float matching), then walked into loops.
const CASES: number[][][] = [
  [], [[3, 0]], [[0, 1]], [[3, 1]], [[1, 2]], [[3, 0], [1, 2]], [[0, 2]], [[3, 2]],
  [[2, 3]], [[2, 0]], [[0, 1], [2, 3]], [[2, 1]], [[1, 3]], [[1, 0]], [[0, 3]], [],
];

function contourRings(L: number): [number, number][][] {
  const pointOf = new Map<string, [number, number]>();
  const segs: [string, string][] = [];

  const edgeInfo = (edge: number, ci: number, cj: number): [string, [number, number]] => {
    // returns [canonical key, px point] for a crossing on `edge` of cell (ci,cj)
    let key = '', a = 0, b = 0, x = 0, y = 0;
    if (edge === 0) {            // bottom c0-c1
      a = getV(ci, cj); b = getV(ci + 1, cj);
      const t = (L - a) / (b - a); key = `h${ci}_${cj}`;
      x = nodeX(ci + t); y = nodeY(cj);
    } else if (edge === 2) {     // top c3-c2
      a = getV(ci, cj + 1); b = getV(ci + 1, cj + 1);
      const t = (L - a) / (b - a); key = `h${ci}_${cj + 1}`;
      x = nodeX(ci + t); y = nodeY(cj + 1);
    } else if (edge === 3) {     // left c0-c3
      a = getV(ci, cj); b = getV(ci, cj + 1);
      const t = (L - a) / (b - a); key = `v${ci}_${cj}`;
      x = nodeX(ci); y = nodeY(cj + t);
    } else {                     // right c1-c2
      a = getV(ci + 1, cj); b = getV(ci + 1, cj + 1);
      const t = (L - a) / (b - a); key = `v${ci + 1}_${cj}`;
      x = nodeX(ci + 1); y = nodeY(cj + t);
    }
    if (!pointOf.has(key)) pointOf.set(key, [x, y]);
    return [key, [x, y]];
  };

  for (let cj = -1; cj < GY; cj++) {
    for (let ci = -1; ci < GX; ci++) {
      const v0 = getV(ci, cj), v1 = getV(ci + 1, cj);
      const v2 = getV(ci + 1, cj + 1), v3 = getV(ci, cj + 1);
      const idx = (v0 >= L ? 1 : 0) + (v1 >= L ? 2 : 0) + (v2 >= L ? 4 : 0) + (v3 >= L ? 8 : 0);
      for (const [e1, e2] of CASES[idx]) {
        const [k1] = edgeInfo(e1, ci, cj);
        const [k2] = edgeInfo(e2, ci, cj);
        if (k1 !== k2) segs.push([k1, k2]);
      }
    }
  }

  // stitch segments into closed rings by shared edge-keys
  const byKey = new Map<string, number[]>();
  segs.forEach(([k1, k2], si) => {
    (byKey.get(k1) ?? byKey.set(k1, []).get(k1)!).push(si);
    (byKey.get(k2) ?? byKey.set(k2, []).get(k2)!).push(si);
  });
  const used = new Set<number>();
  const rings: [number, number][][] = [];
  for (let si = 0; si < segs.length; si++) {
    if (used.has(si)) continue;
    used.add(si);
    const [start, second] = segs[si];
    const ring: [number, number][] = [pointOf.get(start)!, pointOf.get(second)!];
    let node = second;
    let guard = 0;
    while (node !== start && guard++ < segs.length + 4) {
      const cand = (byKey.get(node) ?? []).find((k) => !used.has(k));
      if (cand === undefined) break;
      used.add(cand);
      const [a, b] = segs[cand];
      const other = a === node ? b : a;
      ring.push(pointOf.get(other)!);
      node = other;
    }
    if (ring.length >= 3) rings.push(ring);
  }
  return rings;
}

const ringsToPath = (rings: [number, number][][]) =>
  rings
    .map((r) => 'M' + r.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L') + 'Z')
    .join(' ');

// ── LEVELS + BANDS ───────────────────────────────────────────────────────────
// default = 5 evenly-spaced thresholds across the value domain.
const levels = (levelsIn && levelsIn.length > 0
  ? [...levelsIn].sort((a, b) => a - b)
  : Array.from({ length: 5 }, (_, k) => vMin + ((k + 1) / 5) * (vMax - vMin))
).filter((L) => L > vMin && L <= vMax);
const nBands = levels.length;

// Fixed single-hue volt ramp (NON-themeable data encoding, CANON §6): from
// --paper-2 (turf) through --accent-deep to --accent (hot volt). Only intensity
// carries value — never a rainbow. Colour interpolated across the three token
// stops; opacities follow the declared reference ramp.
/* The ramp: the desk tint at the lowest band, the mark in the middle, the
   text ink at the highest, all opaque (the board's five steps). */
const RAMP = ['var(--accent-tint)', 'var(--accent)', 'var(--accent-deep)'];
function bandColor(k: number) {
  const t = nBands > 1 ? k / (nBands - 1) : 1;
  const p = t * (RAMP.length - 1);
  const seg = Math.min(RAMP.length - 2, Math.floor(p));
  const f = p - seg;
  return `color-mix(in oklab, ${RAMP[seg + 1]} ${Math.round(f * 100)}%, ${RAMP[seg]})`;
}

const levelRings = levels.map((L) => contourRings(L));
const bands = levels.map((L, k) => {
  const outer = levelRings[k];
  const inner = k < nBands - 1 ? levelRings[k + 1] : [];
  return {
    d: ringsToPath(outer) + (inner.length ? ' ' + ringsToPath(inner) : ''),
    color: bandColor(k),
    level: L,
  };
});

// ── PEAK ──────────────────────────────────────────────────────────────────────
// The hottest cell: max clamped value, ties → max data density (Σw). On a
// weighted-mean surface this lands at the goalward HEART of the shot cloud —
// where value is highest — not at a symmetric interior spot. Label = clamped
// value, so it never reads above vMax.
let peakIdx = 0, peakV = -Infinity, peakW = -Infinity;
for (let idx = 0; idx < field.length; idx++) {
  const v = field[idx], w = weight[idx];
  if (v > peakV + 1e-9 || (Math.abs(v - peakV) < 1e-9 && w > peakW)) {
    peakV = v; peakW = w; peakIdx = idx;
  }
}
const pi = peakIdx % GX, pj = Math.floor(peakIdx / GX);
const peakX = nodeX(pi), peakY = nodeY(pj);
const peakLabel = `${valueLabel} ${fmt(peakV)}`;

// ── SHOT OVERPLOT (≤ 400; the surface already encodes the rest) ──────────────
const dots = (!useGrid && showShots && hasShots)
  ? shots!.slice(0, 400).map((sh) => ({
      x: clamp(px(shotYm(sh.y)), OX, OX + plotW),
      y: clamp(py(shotXm(sh.x)), OY, OY + plotH),
    }))
  : [];

// ── CHALK MARKINGS (per surface, drawn in metres → px) ───────────────────────
// primitives: line | dot | arc (arcs sampled so anisotropy/roundness is exact).
type Mark =
  | { t: 'line'; x1: number; y1: number; x2: number; y2: number }
  | { t: 'dot'; cx: number; cy: number; r: number }
  | { t: 'arc'; d: string };

function arcMetres(cym: number, cxm: number, rM: number, a0: number, a1: number, n = 28): string {
  // centre in metres (across cym, depth cxm), radius metres, angles deg.
  // point: across = cym + r·cosθ, depth = cxm + r·sinθ
  const pts: string[] = [];
  for (let k = 0; k <= n; k++) {
    const th = ((a0 + (a1 - a0) * (k / n)) * Math.PI) / 180;
    const ym = cym + rM * Math.cos(th);
    const xm = cxm + rM * Math.sin(th);
    pts.push(`${px(ym).toFixed(1)} ${py(xm).toFixed(1)}`);
  }
  return 'M' + pts.join(' L');
}
const cy0 = (surf.ymMin + surf.ymMax) / 2;   // pitch centre-line across metre (≈34)

let marks: Mark[] = [];
let goalPx: { l: number; r: number; y: number; top: number } | null = null;
if (surface === 'basketball-half') {
  // NBA half-court to real dims (feet→m): rim @ ~1.575 m from baseline,
  // restricted-area r 1.22 m, key 4.9 m long × 4.88 m wide, FT circle r 1.83 m,
  // 3-pt arc r 7.24 m (corners cut). Baseline = goal line (xmMax).
  const base = surf.xmMax;
  const rimXm = base - 1.575;
  const keyBackXm = base - 5.8;      // key length ~5.8 m to FT line
  const keyHalf = 2.44;              // key half-width
  const arcR = 7.24;
  marks = [
    { t: 'line', x1: px(surf.ymMin), y1: py(base), x2: px(surf.ymMax), y2: py(base) },              // baseline
    { t: 'line', x1: px(cy0 - keyHalf), y1: py(base), x2: px(cy0 - keyHalf), y2: py(keyBackXm) },   // key L
    { t: 'line', x1: px(cy0 + keyHalf), y1: py(base), x2: px(cy0 + keyHalf), y2: py(keyBackXm) },   // key R
    { t: 'line', x1: px(cy0 - keyHalf), y1: py(keyBackXm), x2: px(cy0 + keyHalf), y2: py(keyBackXm) }, // FT line
    { t: 'arc', d: arcMetres(cy0, keyBackXm, 1.83, -180, 0) },                                      // FT circle top
    { t: 'dot', cx: px(cy0), cy: py(rimXm), r: 3 },                                                 // rim
    { t: 'arc', d: arcMetres(cy0, rimXm, arcR, -158, -22) },                                        // 3-pt arc
  ];
} else {
  // football-box / football-half — FIFA-scale goal, 6-yard box, 18-yard box,
  // penalty spot + arc, all centred on the pitch centre line.
  const goalLine = surf.xmMax;
  const goalHalf = 3.66;             // 7.32 m goal / 2
  const sixHalf = 9.16, sixDeep = 5.5;
  const boxHalf = 20.16, boxDeep = 16.5;
  const spotXm = goalLine - 11;
  const cy = clamp(cy0, surf.ymMin, surf.ymMax);
  const cl = (ym: number) => clamp(ym, surf.ymMin, surf.ymMax);
  marks = [
    { t: 'line', x1: px(surf.ymMin), y1: py(goalLine), x2: px(surf.ymMax), y2: py(goalLine) },      // goal line
    // 18-yard box
    { t: 'line', x1: px(cl(cy - boxHalf)), y1: py(goalLine), x2: px(cl(cy - boxHalf)), y2: py(goalLine - boxDeep) },
    { t: 'line', x1: px(cl(cy + boxHalf)), y1: py(goalLine), x2: px(cl(cy + boxHalf)), y2: py(goalLine - boxDeep) },
    { t: 'line', x1: px(cl(cy - boxHalf)), y1: py(goalLine - boxDeep), x2: px(cl(cy + boxHalf)), y2: py(goalLine - boxDeep) },
    // 6-yard box
    { t: 'line', x1: px(cl(cy - sixHalf)), y1: py(goalLine), x2: px(cl(cy - sixHalf)), y2: py(goalLine - sixDeep) },
    { t: 'line', x1: px(cl(cy + sixHalf)), y1: py(goalLine), x2: px(cl(cy + sixHalf)), y2: py(goalLine - sixDeep) },
    { t: 'line', x1: px(cl(cy - sixHalf)), y1: py(goalLine - sixDeep), x2: px(cl(cy + sixHalf)), y2: py(goalLine - sixDeep) },
    // penalty spot + arc (portion outside the box, i.e. depth < goalLine - boxDeep)
    { t: 'dot', cx: px(cy), cy: py(spotXm), r: 2.6 },
    { t: 'arc', d: arcMetres(cy, spotXm, 9.15, 216.9, 323.1) },
  ];
  // goal frame (posts extend up into the top margin — the net)
  goalPx = { l: px(cl(cy - goalHalf)), r: px(cl(cy + goalHalf)), y: py(goalLine), top: py(goalLine) - 22 };
}

// ── LEGEND (in-SVG, lower-left ramp) ─────────────────────────────────────────
const pc = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const meta = [model, smoothed ? 'kernel-smoothed' : '', `${fmt(vMin)}–${fmt(vMax)} ${valueLabel}`].filter(Boolean).join(' · ');
const ariaLabel =
  `${valueLabel} value surface from ${model}: highest at ${fmt(peakV)} ${valueLabel}, ` +
  `fading to ${fmt(vMin)} ${valueLabel} at the edges. ${nBands} contour bands.`;
const clipId = `px-cval-${Math.abs([...`${surface}|${model}|${levels.join(',')}|${dots.length}`].reduce((a, c) => ((a << 5) - a + c.charCodeAt(0)) | 0, 0)).toString(36)}`;
/* Where the two words sit on a football surface: inside the six-yard box and
   under the edge of the box. */
const boxWords = surface === 'basketball-half' ? [] : [
  { t: 'Six-yard box', x: px(clamp(cy0 - 9.16, surf.ymMin, surf.ymMax)) + 6, y: py(surf.xmMax - 5.5) - 6, on: 'deep' },
  { t: 'Edge of box', x: px(clamp(cy0 - 20.16, surf.ymMin, surf.ymMax)) + 6, y: py(surf.xmMax - 16.5) + 16, on: 'paper' },
];
---

<div class="px-viz px-cval" data-build-scene>
  <div class="px-cval__head" data-cue="peak">
    <span class="px-cval__big" data-build="4" data-build-kind="rise">{fmt(peakV)}</span>
    <span class="px-cval__nl"><span class="px-cue-tag" data-cue-tag="peak" hidden></span>{valueLabel}, the best spot</span>
  </div>

  <div class="px-cval__fig">
    <svg class="px-cval__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel}>
      <defs>
        <clipPath id={clipId}><rect x={OX} y={OY} width={plotW} height={plotH} /></clipPath>
      </defs>
      <rect x={OX} y={OY} width={plotW} height={plotH} fill="var(--paper)" data-build="1" />
      <g clip-path={`url(#${clipId})`}>
        {bands.map((b, k) => (
          <path data-cue={k + 1} d={b.d} style={`fill:${b.color}`} fill-rule="evenodd" data-build="2" />
        ))}
        {levelRings.map((rings) => <path d={ringsToPath(rings)} fill="none" stroke="var(--accent)" stroke-opacity="0.5" stroke-width="1" data-build="2" />)}
      </g>
      <g fill="none" stroke="var(--ink)" stroke-opacity="0.55" stroke-width="1.25" data-build="1">
        <rect x={OX} y={OY} width={plotW} height={plotH} />
        {marks.map((m) => (
          m.t === 'line' ? <line x1={m.x1.toFixed(1)} y1={m.y1.toFixed(1)} x2={m.x2.toFixed(1)} y2={m.y2.toFixed(1)} />
          : m.t === 'dot' ? <circle cx={m.cx.toFixed(1)} cy={m.cy.toFixed(1)} r={m.r} fill="var(--ink)" fill-opacity="0.55" stroke="none" />
          : <path d={m.d} />
        ))}
      </g>
      {goalPx && (
        <rect x={goalPx.l.toFixed(1)} y={(goalPx.y - 12).toFixed(1)} width={(goalPx.r - goalPx.l).toFixed(1)} height="12" fill="none" stroke="var(--ink)" stroke-width="2" data-build="1" />
      )}
      {dots.length > 0 && (
        <g data-cue="shots">
          {dots.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="3.6" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="1.2" data-build="3" data-build-kind="drop" />)}
        </g>
      )}
      <g data-cue="peak" data-build="3">
        <circle cx={peakX.toFixed(1)} cy={peakY.toFixed(1)} r="9" fill="none" stroke="var(--paper-2)" stroke-width="2.5" />
        <circle cx={peakX.toFixed(1)} cy={peakY.toFixed(1)} r="9" fill="none" stroke="var(--ink)" stroke-width="1.25" />
      </g>
    </svg>
    <div class="px-cval__layer" aria-hidden="true">
      {boxWords.map((b) => <span class="px-cval__w" data-on={b.on} data-build="3" style={`left:${pc(b.x, W)};top:${pc(b.y, H)}`}>{b.t}</span>)}
      <span class="px-cval__tag" style={`left:${pc(peakX + 12, W)};top:${pc(peakY, H)}`}><span class="px-cue-tag" data-cue-tag="peak" hidden></span></span>
      {dots.length > 0 && <span class="px-cval__tag" style={`left:${pc(dots[dots.length - 1].x + 6, W)};top:${pc(dots[dots.length - 1].y, H)}`}><span class="px-cue-tag" data-cue-tag="shots" hidden></span></span>}
    </div>
  </div>

  <div class="px-cval__key" data-build="3">
    <span class="px-cval__kl">{valueLabel}</span>
    <div class="px-cval__ramp">
      {bands.map((b, k) => (
        <div class="px-cval__step" data-cue={k + 1}>
          <span class="px-cval__sw" style={`background:${b.color}`}></span>
          <span class="px-cval__sv"><span class="px-cue-tag" data-cue-tag={k + 1} hidden></span>{fmt(b.level)}{k === nBands - 1 ? ' +' : ''}</span>
        </div>
      ))}
    </div>
    {dots.length > 0 && <span class="px-cval__kd"><i></i>Sampled shot</span>}
  </div>
  <p class="px-cval__meta" data-build="3">{meta}</p>
  {/* No source line and no caption: core/Section.astro prints both. */}
</div>

