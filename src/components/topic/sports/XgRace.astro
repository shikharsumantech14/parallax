---
/**
 * XgRace (sports) — a cumulative expected-goals race, with a MINUTE SCRUB
 * (Lens Phase 6, 2026-09-30; the board is Lib-xg-race).
 *
 * Each shot adds its xG to its team's running total, so two step-lines climb
 * across the match (home in the desk mark, away in ink-2), each shot a dot at
 * the top of its step. The home total is set at 48 over the chart, the away
 * total beside it at 20. Dragging the minute scrub replays the match: the
 * lines ahead of the playhead drop back to a ghost and the readout states who
 * was ahead AT that minute.
 *
 * The scrub table (pixel positions and values per minute) is computed here and
 * inlined as JSON; no scale math ships to the client. The ghosts sit under the
 * real lines and are hidden by them at rest, so the no-JS still IS the
 * finished chart. The scrub ships `hidden` and its island unhides it once the
 * payload parses; that island is the kind's control and stays.
 *
 * THE BUILD sits on the plot (`.px-xgr__plot`, the numbers and the SVG), not
 * on the card: the card holds the html.js-gated scrub, which changes the
 * card's height, and the render gate compares a scene's size with and without
 * JS (LENS §6.4). So the root is a plain `.px-viz` here, not core/VizCard.
 *
 * Drawn for the panel: a 452-unit viewBox with 12-unit labels in the literal
 * Literata stack. Below 1024px the SVG keeps that width and the card
 * scrolls sideways (the standing rule in dataviz-v2.css), so every label
 * prints at 12px.
 *
 * Cue anchors:
 *   home, away   each side's line and its total
 *   half         the half-time rule
 *   note1..      the annotations, in authored order
 *   1..n         each shot, in authored order (the dot on its step)
 *
 * The build (LENS §6.4): 1 the grid, the axes and the half-time rule, 2 the
 * lines draw, 3 the shot dots drop and the notes rise, 4 the totals count.
 *
 * data: { events[]{ minute, team, xg }, home?, away?, annotations? }
 */
type Side = 'home' | 'away';
interface Ev { minute: number; team: Side; xg: number; }
interface Annotation {
  at: string | number;
  text: string;
  side?: 'above' | 'below' | 'left' | 'right';
  series?: string;
}
interface Props {
  events: Ev[];
  home?: string;
  away?: string;
  caption?: string;
  source?: string | { label: string; date?: string };
  annotations?: Annotation[];
}
const { events = [], home = 'Home', away = 'Away', annotations = [] } = Astro.props;

// ── viewBox + plot box ──────────────────────────────────────────────────────
const W = 452, H = 272;
const plotL = 30, plotR = W - 14, plotT = 16, plotB = H - 30;
const plotW = plotR - plotL, plotH = plotB - plotT;
const f = (n: number) => n.toFixed(1);

const evs = (events || [])
  .map((e, i) => ({ ...e, i }))
  .filter((e) => e && Number.isFinite(e.minute) && Number.isFinite(e.xg));
const lastMin = Math.max(90, ...evs.map((e) => e.minute || 0));
const maxMin = Math.ceil(lastMin / 5) * 5;
const atMin = (e: Ev) => Math.max(0, Math.min(maxMin, e.minute));

function series(side: Side): [number, number][] {
  const pts: [number, number][] = [[0, 0]];
  let acc = 0;
  evs
    .filter((e) => e.team === side)
    .sort((a, b) => a.minute - b.minute)
    .forEach((e) => {
      acc += Math.max(0, e.xg || 0);
      pts.push([atMin(e), acc]);
    });
  if (pts[pts.length - 1][0] < maxMin) pts.push([maxMin, acc]);
  return pts;
}
const homeSeries = series('home');
const awaySeries = series('away');
const homeFinal = homeSeries[homeSeries.length - 1][1];
const awayFinal = awaySeries[awaySeries.length - 1][1];
const maxXg = Math.max(1, Math.ceil(Math.max(homeFinal, awayFinal)));

const px = (m: number) => plotL + (m / maxMin) * plotW;
const py = (xg: number) => plotB - (xg / maxXg) * plotH;

function stepPath(pts: [number, number][]): string {
  let d = `M ${f(px(pts[0][0]))} ${f(py(pts[0][1]))}`;
  for (let k = 1; k < pts.length; k++) {
    const [m, v] = pts[k];
    d += ` H ${f(px(m))}`;
    if (v !== pts[k - 1][1]) d += ` V ${f(py(v))}`;
  }
  return d;
}
const homePath = stepPath(homeSeries);
const awayPath = stepPath(awaySeries);

/* The scrub payload, one row per minute:
   [playheadX, homeMarkerY, awayMarkerY, homeXg, awayXg]. */
const cumAt = (side: Side, m: number) =>
  evs.filter((e) => e.team === side && atMin(e) <= m).reduce((a, e) => a + Math.max(0, e.xg || 0), 0);
const minuteTable = Array.from({ length: maxMin + 1 }, (_, m) => {
  const h = cumAt('home', m);
  const a = cumAt('away', m);
  return [+f(px(m)), +f(py(h)), +f(py(a)), +h.toFixed(2), +a.toFixed(2)];
});

/* Each shot as a dot at the top of its step. */
const shotDots = evs.map((e) => {
  const m = atMin(e);
  return { i: e.i, team: e.team, x: px(m), y: py(cumAt(e.team, m) - (evs.filter((o) => o.team === e.team && atMin(o) === m && o.i > e.i).reduce((a, o) => a + Math.max(0, o.xg || 0), 0))) };
});

const yTicks = Array.from({ length: maxXg + 1 }, (_, i) => i);
const xTicks = Array.from({ length: Math.floor(maxMin / 15) + 1 }, (_, i) => i * 15);
const htX = px(45);
const homeEnd = { x: px(homeSeries[homeSeries.length - 1][0]), y: py(homeFinal) };
const awayEnd = { x: px(awaySeries[awaySeries.length - 1][0]), y: py(awayFinal) };

const uid = 'xgr' + Math.abs([...`${home}|${away}|${evs.length}|${maxMin}`].reduce((a, c) => ((a << 5) - a + c.charCodeAt(0)) | 0, 0)).toString(36);
const restReadout = `Full time · ${home} ${homeFinal.toFixed(2)} xG, ${away} ${awayFinal.toFixed(2)} xG`;
const readoutFor = (m: number, hv: number, av: number) => {
  const lead = hv > av ? `${home} ahead by ${(hv - av).toFixed(2)}` : av > hv ? `${away} ahead by ${(av - hv).toFixed(2)}` : 'level';
  return `${m}' · ${home} ${hv.toFixed(2)} xG, ${away} ${av.toFixed(2)} xG · ${lead}`;
};
const longestReadout = minuteTable.map((r, m) => readoutFor(m, r[3], r[4])).concat(restReadout).reduce((a, b) => (b.length > a.length ? b : a), '');

/* ── the annotation layer (docs/design/blueprints/_ANNOTATIONS.md) ──────────
   `at` is the minute; `series` 'home' / 'away' (or a side's name), default
   the higher line. Wrapped to a 170-unit measure, placed above or below its
   dot (the `side` hint flips when it would leave the plot), and mirrored at
   the plot's edges. */
const A_FS = 13, A_LH = 16, A_LEAD = 14, A_GAP = 5, A_MAX = 170;
const aEst = (s: string) => 0.5 * A_FS * s.length;
const aWrap = (s: string): string[] => {
  const out: string[] = [];
  for (const w of s.split(/\s+/)) {
    const last = out[out.length - 1];
    if (last && aEst(last + ' ' + w) <= A_MAX) out[out.length - 1] = last + ' ' + w;
    else out.push(w);
  }
  return out;
};
const annots = (annotations ?? []).flatMap((a, k) => {
  if (!a || !a.text) return [];
  const m = Math.round(Number(a.at));
  if (!Number.isFinite(m) || m < 0 || m > maxMin) return [];
  const row = minuteTable[m];
  const s = (a.series || '').trim();
  const team: Side = /^home$/i.test(s) || (!!s && s === home) ? 'home' : /^away$/i.test(s) || (!!s && s === away) ? 'away' : row[3] >= row[4] ? 'home' : 'away';
  const cx = row[0];
  const cy = team === 'home' ? row[1] : row[2];
  const lines = aWrap(a.text);
  const wEst = Math.max(...lines.map(aEst));
  const blockH = (lines.length - 1) * A_LH;
  // beside the dot, on the side with room, vertically centred on it
  const dir = cx + A_GAP + A_LEAD + 4 + wEst <= plotR ? 1 : -1;
  const x2 = cx + dir * (A_GAP + A_LEAD);
  const ty = Math.max(plotT + A_FS, Math.min(plotB - blockH - 4, cy + 4 - blockH / 2 + (a.side === 'below' ? A_LH : 0)));
  return [{ id: `note${k + 1}`, lines, cx, cy, x1: cx + dir * A_GAP, x2, tx: x2 + dir * 4, ty, anchor: dir > 0 ? 'start' : 'end' }];
});
const UI = "font-family:'Literata',Georgia,serif";
---

<div class="px-viz px-xgr">
  <div class="px-xgr__box" data-xgr-box data-xgr-home={home} data-xgr-away={away} data-xgr-max={maxMin} data-xgr-rest={restReadout}>
    <div class="px-xgr__plot" data-build-scene>
      <div class="px-xgr__head">
        <div class="px-xgr__n" data-cue="home">
          <span class="px-xgr__big" data-build="4" data-build-kind="counter" data-to={homeFinal.toFixed(2)} data-format="1dp">{homeFinal.toFixed(2)}</span>
          <span class="px-xgr__nl"><span class="px-cue-tag" data-cue-tag="home" hidden></span>{home} xG</span>
        </div>
        <div class="px-xgr__n" data-cue="away">
          <span class="px-xgr__sm" data-build="4">{awayFinal.toFixed(2)}</span>
          <span class="px-xgr__nl"><span class="px-cue-tag" data-cue-tag="away" hidden></span>{away} xG</span>
        </div>
      </div>

      <svg class="px-xgr__svg" viewBox={`0 0 ${W} ${H}`} role="img"
        aria-label={`Cumulative xG race: ${home} ${homeFinal.toFixed(2)}, ${away} ${awayFinal.toFixed(2)}`}>
        <defs>
          <clipPath id={uid}>
            <rect class="px-xgr__clip" data-xgr-clip x={plotL} y={plotT - 8} width={plotW} height={plotH + 16} />
          </clipPath>
        </defs>
        <g data-build="1">
          {yTicks.map((t) => (
            <>
              <line x1={plotL} y1={f(py(t))} x2={plotR} y2={f(py(t))} stroke="var(--hair)" stroke-width="1" />
              <text class="px-xgr__ax" x={plotL - 8} y={f(py(t) + 4)} text-anchor="end" style={UI}>{t}</text>
            </>
          ))}
          {xTicks.filter((m) => m !== 45).map((m) => (
            <text class="px-xgr__ax" x={f(px(m))} y={plotB + 20} text-anchor={m === 0 ? 'start' : m === maxMin ? 'end' : 'middle'} style={UI}>{m}'</text>
          ))}
        </g>
        <g data-cue="half" data-build="1">
          <line x1={f(htX)} y1={plotT} x2={f(htX)} y2={plotB} stroke="var(--hair-2)" stroke-width="1" stroke-dasharray="3 3" />
          <text class="px-xgr__ax" x={f(htX)} y={plotB + 20} text-anchor="middle" style={UI}>Half-time</text>
          <foreignObject x={f(htX - 11)} y={plotT - 4} width="22" height="22"><span class="px-cue-tag" data-cue-tag="half" hidden></span></foreignObject>
        </g>

        <path class="px-xgr__ghost px-xgr__ghost--away" d={awayPath} data-build="2" />
        <path class="px-xgr__ghost px-xgr__ghost--home" d={homePath} data-build="2" />
        <g clip-path={`url(#${uid})`}>
          <path class="px-xgr__line px-xgr__line--away" data-cue="away" d={awayPath} data-build="2" data-build-kind="draw" />
          <path class="px-xgr__line px-xgr__line--home" data-cue="home" d={homePath} data-build="2" data-build-kind="draw" />
        </g>

        {shotDots.map((d) => (
          <g data-cue={d.i + 1}>
            <circle class={`px-xgr__dot px-xgr__dot--${d.team}`} cx={f(d.x)} cy={f(d.y)} r="3.5" data-build="3" data-build-kind="drop" />
            <foreignObject x={f(d.x + 5)} y={f(d.y + 3)} width="22" height="22"><span class="px-cue-tag" data-cue-tag={d.i + 1} hidden></span></foreignObject>
          </g>
        ))}

        {annots.map((a) => (
          <g class="px-xgr__annot" data-cue={a.id} data-build="3" data-build-kind="rise">
            <line x1={f(a.x1)} y1={f(a.cy)} x2={f(a.x2)} y2={f(a.cy)} stroke="var(--hair-2)" stroke-width="1" />
            <text class="px-xgr__annot-t" x={f(a.tx)} y={f(a.ty)} text-anchor={a.anchor}
              style="font-family:'Literata',Georgia,serif">{a.lines.map((ln, li) => <tspan x={f(a.tx)} dy={li === 0 ? 0 : A_LH}>{ln}</tspan>)}</text>
            <foreignObject x={f(a.anchor === 'start' ? a.tx - 26 : a.tx + 4)} y={f(a.ty - 15)} width="22" height="22"><span class="px-cue-tag" data-cue-tag={a.id} hidden></span></foreignObject>
          </g>
        ))}

        {/* the playhead + the two markers reading off it, shown only while the
            scrub is off its resting position */}
        <g class="px-xgr__cursor" data-xgr-cursor>
          <line class="px-xgr__play" data-xgr-play x1={plotR} y1={plotT} x2={plotR} y2={plotB} />
          <circle class="px-xgr__mark px-xgr__mark--away" data-xgr-mark-away cx={plotR} cy={f(awayEnd.y)} r="4" />
          <circle class="px-xgr__mark px-xgr__mark--home" data-xgr-mark-home cx={plotR} cy={f(homeEnd.y)} r="4" />
        </g>
      </svg>

      <div class="px-xgr__legend" data-build="3">
        <span class="px-xgr__key px-xgr__key--home"><i></i>{home}, home</span>
        <span class="px-xgr__key px-xgr__key--away"><i></i>{away}, away</span>
      </div>
    </div>

    {/* JS-only control. Ships hidden; the island unhides it only once the
        payload has parsed, so a bad payload degrades to the static chart. */}
    <div class="px-xgr__scrub px-inst__controls" hidden data-xgr-scrub>
      <label class="px-xgr__scrub-lab">
        <span>Minute</span>
        <input class="px-xgr__range px-inst__drag" type="range" min="0" max={maxMin} step="1" value={maxMin} data-xgr-range />
      </label>
    </div>

    <p class="px-xgr__readout px-inst__readout px-inst__readout--sized">
      <span data-xgr-readout aria-live="polite">{restReadout}</span>
      <span class="px-inst__sizer" aria-hidden="true">{longestReadout}</span>
    </p>

    <script type="application/json" class="px-xgr__data" data-xgr-data set:html={JSON.stringify(minuteTable)} />
  </div>
  {/* No source line and no caption: core/Section.astro prints both. */}
</div>

<script is:inline>
  (function () {
    if (!document.documentElement.classList.contains('js')) return;
    document.querySelectorAll('[data-xgr-box]').forEach(function (box) {
      var raw = box.querySelector('[data-xgr-data]');
      var range = box.querySelector('[data-xgr-range]');
      var scrub = box.querySelector('[data-xgr-scrub]');
      if (!raw || !range || !scrub) return;
      var table;
      try { table = JSON.parse(raw.textContent); } catch (e) { return; }
      if (!table || !table.length) return;
      var clip = box.querySelector('[data-xgr-clip]');
      var play = box.querySelector('[data-xgr-play]');
      var mh = box.querySelector('[data-xgr-mark-home]');
      var ma = box.querySelector('[data-xgr-mark-away]');
      var out = box.querySelector('[data-xgr-readout]');
      var home = box.getAttribute('data-xgr-home') || 'Home';
      var away = box.getAttribute('data-xgr-away') || 'Away';
      var maxMin = parseInt(box.getAttribute('data-xgr-max'), 10);
      var rest = box.getAttribute('data-xgr-rest') || '';
      var clipX = parseFloat(clip.getAttribute('x'));
      var clipW = parseFloat(clip.getAttribute('width'));
      function paint(m) {
        var row = table[Math.max(0, Math.min(table.length - 1, m))];
        if (!row) return;
        var x = row[0], hy = row[1], ay = row[2], hv = row[3], av = row[4];
        var atRest = m >= maxMin;
        box.setAttribute('data-scrubbing', atRest ? 'false' : 'true');
        clip.setAttribute('width', atRest ? clipW : Math.max(0, x - clipX));
        play.setAttribute('x1', x); play.setAttribute('x2', x);
        mh.setAttribute('cx', x); mh.setAttribute('cy', hy);
        ma.setAttribute('cx', x); ma.setAttribute('cy', ay);
        if (atRest) { out.textContent = rest; return; }
        var lead = hv > av ? home + ' ahead by ' + (hv - av).toFixed(2) : av > hv ? away + ' ahead by ' + (av - hv).toFixed(2) : 'level';
        out.textContent = m + "' · " + home + ' ' + hv.toFixed(2) + ' xG, ' + away + ' ' + av.toFixed(2) + ' xG · ' + lead;
      }
      range.addEventListener('input', function () { paint(parseInt(range.value, 10)); });
      scrub.removeAttribute('hidden');
    });
  })();
</script>

<style>
  .px-xgr__box { width: 100%; }
  .px-xgr__head { display: flex; align-items: flex-end; gap: 32px; margin-bottom: 12px; }
  .px-xgr__n { display: flex; flex-direction: column; gap: 8px; }
  .px-xgr__big, .px-xgr__sm { font-family: var(--font-ui); font-weight: 700; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .px-xgr__big { font-size: 96px; color: var(--accent-deep); }
  .px-xgr__sm { font-size: 20px; color: var(--ink-2); }
  .px-xgr__nl { display: inline-flex; align-items: center; font-family: var(--font-ui); font-size: 13px; line-height: 1.3; color: var(--muted); }
  .px-xgr__svg { display: block; width: 100%; height: auto; }
  .px-xgr__svg foreignObject { overflow: visible; }
  .px-xgr__svg .px-cue-tag { margin: 1px; }
  .px-xgr__ax { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .px-xgr__line, .px-xgr__ghost { fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .px-xgr__line--home { stroke: var(--accent); stroke-width: 3.5; }
  .px-xgr__line--away { stroke: var(--ink-2); stroke-width: 2.5; }
  .px-xgr__ghost { opacity: 0.2; stroke-width: 2.5; }
  .px-xgr__ghost--home { stroke: var(--accent); }
  .px-xgr__ghost--away { stroke: var(--ink-2); }
  .px-xgr__dot { stroke: var(--paper-2); stroke-width: 1.5; }
  .px-xgr__dot--home { fill: var(--accent-deep); }
  .px-xgr__dot--away { fill: var(--ink-2); }
  .px-xgr__annot-t {
    font-size: 13px;
    font-style: normal;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper-2);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .px-xgr__cursor { display: none; }
  .px-xgr__box[data-scrubbing='true'] .px-xgr__cursor { display: block; }
  .px-xgr__play { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 2 3; }
  .px-xgr__mark { stroke: var(--paper-2); stroke-width: 1.5; }
  .px-xgr__mark--home { fill: var(--accent); }
  .px-xgr__mark--away { fill: var(--ink-2); }
  .px-xgr__box[data-scrubbing='true'] .px-xgr__dot { opacity: 0.4; }
  .px-xgr__legend { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 12px; }
  .px-xgr__key { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-ui); font-size: 12px; line-height: 1.3; color: var(--muted); }
  .px-xgr__key i { flex: none; width: 22px; height: 3px; }
  .px-xgr__key--home i { height: 4px; background: var(--accent); }
  .px-xgr__key--away i { background: var(--ink-2); }
  .px-xgr__scrub { margin-top: 14px; }
  .px-xgr__scrub[hidden] { display: none; }
  .px-xgr__scrub-lab {
    display: flex; flex-direction: column; gap: 6px; width: 100%;
    font-family: var(--font-ui); font-size: 12px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
  }
  .px-xgr__range { width: 100%; min-height: 44px; accent-color: var(--accent-deep); cursor: pointer; }
  .px-xgr__range:focus-visible { outline: 2px solid var(--accent-deep); outline-offset: 3px; }
  /* LENS §7: the pinned figure headline is 96, 72 on phones. */
  @media (max-width: 767px) { .px-xgr__big { font-size: 72px; } }
</style>
