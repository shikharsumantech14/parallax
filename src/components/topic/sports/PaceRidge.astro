---
/*
  PaceRidge (sports) — the split-distribution ridgeline (Lens Phase 6,
  2026-09-30; the board is Lib-pace-ridge). One athlete's whole distribution
  of a measured quantity against the field's, as stacked kernel-density
  ridges on one shared scale: the subject's ridge in the desk mark, the
  others in quiet ink, each with its centre line and, in the left gutter, its
  label and its centre value. The subject's centre is the headline (48); a
  bracket over the stack measures the gap from the subject's centre to the
  largest comparison group's, with a dashed guide down from each.

  All maths (Silverman-bandwidth Gaussian KDE, the layout, the centres) runs
  once here at build time. No JS.

  Drawn for the panel: a 452-unit viewBox, 12 and 13-unit labels in the
  literal Instrument Sans stack; below 1024px it keeps that width and the
  card scrolls (dataviz-v2.css).

  Cue anchors:
    stat   the subject's centre, the large number
    gap    the bracket and the two dashed guides
    1..n   each group, in authored order (its ridge, centre line and label)

  The build (LENS §6.4): 1 the axis and the baselines, 2 the ridges grow from
  their baselines, 3 the centre lines, labels, guides and bracket, 4 the
  subject's centre counts up.

  data: {
    metric, unit, source_n?, stat?: 'mean'|'median', domain?: [min,max],
    groups: [{ label, samples: number[], subject?: true }],  // 2-7, top->bottom
  }
*/
interface Group { label: string; samples: number[]; subject?: true; }
interface Props {
  metric?: string;
  unit?: string;
  source_n?: string;
  stat?: 'mean' | 'median';
  domain?: [number, number];
  groups?: Group[];
  caption?: string;
  source?: string;
}
const { metric = 'value', unit = '', source_n, stat = 'median', groups: rawGroups = [], caption, source } = Astro.props;

const W = 452, GUT = 118, PAD_R = 8;
const plotL = GUT, plotR = W - PAD_R, w = plotR - plotL;
const STEP = 78, PEAK = 88, TOP = 52, M = 128;
const f = (n: number) => n.toFixed(1);

let groups = (rawGroups || [])
  .filter((g) => g && Array.isArray(g.samples))
  .map((g) => ({ label: String(g.label ?? ''), subject: g.subject === true, samples: g.samples.filter((s) => Number.isFinite(s)) as number[] }))
  .filter((g) => g.samples.length >= 2)
  .slice(0, 7);
let seenSubj = false;
groups = groups.map((g) => {
  if (g.subject && !seenSubj) { seenSubj = true; return g; }
  return { ...g, subject: false };
});
const G = groups.length;

function niceStep(range: number, target: number): number {
  if (!(range > 0)) return 1;
  const raw = range / target;
  const mag = Math.pow(10, Math.floor(Math.log10(raw)));
  const norm = raw / mag;
  return (norm < 1.5 ? 1 : norm < 3 ? 2 : norm < 7 ? 5 : 10) * mag;
}
const allSamples = groups.flatMap((g) => g.samples);
let dMin: number, dMax: number;
if (Astro.props.domain && Number.isFinite(Astro.props.domain[0]) && Number.isFinite(Astro.props.domain[1])) {
  [dMin, dMax] = Astro.props.domain;
} else {
  const lo = Math.min(...allSamples), hi = Math.max(...allSamples);
  const st = niceStep(hi - lo || 1, 6);
  dMin = Math.floor(lo / st) * st;
  dMax = Math.ceil(hi / st) * st;
  if (dMax === dMin) dMax = dMin + st;
}
const span = dMax - dMin;
const x = (v: number) => plotL + ((v - dMin) / span) * w;

// ── statistics ──────────────────────────────────────────────────────────────
const median = (a: number[]) => {
  const s = [...a].sort((p, q) => p - q);
  const m = s.length >> 1;
  return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
};
const mean = (a: number[]) => a.reduce((t, v) => t + v, 0) / a.length;
const sampleStd = (a: number[]) => {
  if (a.length < 2) return 0;
  const mu = mean(a);
  return Math.sqrt(a.reduce((t, v) => t + (v - mu) * (v - mu), 0) / (a.length - 1));
};
const centre = (a: number[]) => (stat === 'mean' ? mean(a) : median(a));
const statWord = stat === 'mean' ? 'mean' : 'median';

// ── Gaussian KDE (Silverman bandwidth), one grid and one scale for all ──────
const K = (u: number) => Math.exp(-0.5 * u * u) / Math.sqrt(2 * Math.PI);
const bwFloor = span / 40;
const bandwidth = (a: number[]) => Math.max(1.06 * sampleStd(a) * Math.pow(a.length, -1 / 5), bwFloor);
const density = (samples: number[], bw: number, at: number) => {
  let s = 0;
  for (const si of samples) s += K((at - si) / bw);
  return s / (samples.length * bw);
};
const grid = Array.from({ length: M }, (_, i) => dMin + (span * i) / (M - 1));
let peakDensity = 0;
const model = groups.map((g, i) => {
  const bw = bandwidth(g.samples);
  const dens = grid.map((gx) => density(g.samples, bw, gx));
  peakDensity = Math.max(peakDensity, ...dens);
  return { ...g, i, bw, dens, n: g.samples.length, c: centre(g.samples) };
});
const SY = peakDensity > 0 ? PEAK / peakDensity : 0;

// ── ridge geometry ──────────────────────────────────────────────────────────
const baseY = (g: number) => TOP + (g + 1) * STEP;
/* A gutter label wraps to about fourteen characters a line. */
const wrap = (s: string, max = 15) => {
  const out: string[] = [];
  for (const wd of s.split(/\s+/).filter(Boolean)) {
    const last = out[out.length - 1];
    if (last && (last + ' ' + wd).length <= max) out[out.length - 1] = last + ' ' + wd;
    else out.push(wd);
  }
  return out.length ? out : [''];
};
const ridges = model.map((m) => {
  const yb = baseY(m.i);
  const pts = grid.map((gx, k) => [x(gx), yb - m.dens[k] * SY] as [number, number]);
  const edge = pts.map((p, k) => `${k ? 'L' : 'M'} ${f(p[0])} ${f(p[1])}`).join(' ');
  const area = `${edge} L ${f(pts[pts.length - 1][0])} ${yb} L ${f(pts[0][0])} ${yb} Z`;
  const cx = x(m.c);
  const cyTop = yb - density(m.samples, m.bw, m.c) * SY;
  const lines = wrap(m.label);
  return { ...m, yb, edge, area, cx, cyTop, lines, val: m.c.toFixed(1) };
});
const subj = ridges.find((r) => r.subject) ?? null;
const field = ridges.filter((r) => !r.subject).sort((a, b) => b.n - a.n)[0] ?? null;
const gap = subj && field ? subj.c - field.c : null;
const bottom = G ? baseY(G - 1) : TOP;
const axisY = bottom + 14;
const H = axisY + 24;

const tStep = niceStep(span, 6);
const ticks: number[] = [];
for (let v = Math.ceil(dMin / tStep) * tStep; v <= dMax + 1e-9; v += tStep) ticks.push(Math.round(v * 1e6) / 1e6);

const aria = subj && field
  ? `Ridgeline of ${metric}${unit ? ' in ' + unit : ''}: the subject's ${statWord} is ${subj.val} ${unit}, ${Math.abs(gap!).toFixed(1)} ${unit} ${gap! >= 0 ? 'above' : 'below'} the ${statWord} of ${field.label}, ${field.val}.`
  : `Ridgeline distribution of ${metric}${unit ? ' in ' + unit : ''} across ${G} groups.`;
const lead = subj ?? ridges[0];
const UI = "font-family:'Instrument Sans','Helvetica Neue',Arial,sans-serif";
---

<div class="px-viz px-prdg" data-build-scene>
  {lead && (
    <div class="px-prdg__head">
      <div class="px-prdg__n" data-cue="stat">
        <span class="px-prdg__big" data-build="4" data-build-kind="counter" data-to={lead.val} data-format="1dp">{lead.val}</span>
        <span class="px-prdg__nl"><span class="px-cue-tag" data-cue-tag="stat" hidden></span>{statWord === 'mean' ? 'Mean' : 'Median'}{unit ? `, ${unit}` : ''}</span>
      </div>
      <div class="px-prdg__key" data-build="1">
        {subj && <span class="px-prdg__k"><i class="px-prdg__ks"></i>{subj.lines.join(' ')}</span>}
        <span class="px-prdg__k"><i class="px-prdg__km"></i>{statWord === 'mean' ? 'Mean line' : 'Median line'}</span>
      </div>
    </div>
  )}

  <svg class="px-prdg__svg" viewBox={`0 0 ${W} ${f(H)}`} role="img" aria-label={aria}>
    {/* The caption and the source print once, in core/Section.astro; the
        drawing carries them as its accessible description. */}
    {(caption || source) && <desc>{[caption, source && `Source: ${source}`].filter(Boolean).join(' ')}</desc>}
    <g data-build="1">
      {ridges.map((r) => <line x1={plotL} y1={r.yb} x2={plotR} y2={r.yb} stroke="var(--hair-2)" stroke-width="1" />)}
      <line x1={plotL} y1={f(axisY)} x2={plotR} y2={f(axisY)} stroke="var(--hair-2)" stroke-width="1" />
      {ticks.map((t) => <text class="px-prdg__ax" x={f(x(t))} y={f(axisY + 18)} text-anchor={x(t) > plotR - 8 ? 'end' : 'middle'} style={UI}>{t}</text>)}
      {unit && <text class="px-prdg__ax" x="0" y={f(axisY + 18)} style={UI}>{unit}</text>}
    </g>

    {ridges.map((r) => (
      <g data-cue={r.i + 1} data-subject={r.subject ? 'true' : undefined}>
        <g class="px-prdg__ridge" data-build="2" data-build-kind="grow-y">
          <path class="px-prdg__area" d={r.area} />
          <path class="px-prdg__edge" d={r.edge} />
        </g>
        <line class="px-prdg__c" x1={f(r.cx)} y1={r.yb} x2={f(r.cx)} y2={f(r.cyTop)} data-build="3" />
        <text class="px-prdg__gl" x="0" y={f(r.yb - 22 - (r.lines.length - 1) * 16)} style={UI} data-build="3" data-build-kind="rise">
          {r.lines.map((ln, k) => <tspan x="0" dy={k === 0 ? 0 : 16}>{ln}</tspan>)}
        </text>
        <text class="px-prdg__gv" x="0" y={f(r.yb - 5)} style={UI} data-build="3" data-build-kind="rise">{statWord} {r.val}</text>
        <foreignObject x={f(Math.min(r.cx + 6, plotR - 22))} y={f(r.yb - 26)} width="22" height="22"><span class="px-cue-tag" data-cue-tag={r.i + 1} hidden></span></foreignObject>
      </g>
    ))}

    {subj && field && gap != null && (
      <g data-cue="gap" data-build="3">
        <line x1={f(field.cx)} y1="26" x2={f(field.cx)} y2={f(bottom)} stroke="var(--ink)" stroke-width="1" stroke-dasharray="3 4" />
        <line x1={f(subj.cx)} y1="26" x2={f(subj.cx)} y2={f(bottom)} stroke="var(--accent-deep)" stroke-width="1.25" stroke-dasharray="4 4" />
        <polyline points={`${f(field.cx)},30 ${f(field.cx)},24 ${f(subj.cx)},24 ${f(subj.cx)},30`} fill="none" stroke="var(--accent-deep)" stroke-width="2" />
        <text class="px-prdg__gapt" x={f((field.cx + subj.cx) / 2)} y="16" text-anchor="middle" style={UI}>{gap >= 0 ? '' : '−'}{Math.abs(gap).toFixed(1)}{unit ? ` ${unit}` : ''}</text>
        <foreignObject x={f(Math.max(field.cx, subj.cx) + 4)} y="4" width="22" height="22"><span class="px-cue-tag" data-cue-tag="gap" hidden></span></foreignObject>
      </g>
    )}
  </svg>

  <p class="px-prdg__foot" data-build="3">{[source_n, `kernel density · ${statWord} line`].filter(Boolean).join(' · ')}</p>
  {/* No source line and no caption: core/Section.astro prints both. */}
</div>

<style>
  .px-prdg__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 16px; margin-bottom: 12px; }
  .px-prdg__n { display: flex; flex-direction: column; gap: 8px; }
  .px-prdg__big { font-family: var(--font-ui); font-size: 96px; font-weight: 600; line-height: 0.92; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--accent-deep); }
  .px-prdg__nl { display: inline-flex; align-items: center; font-family: var(--font-ui); font-size: 13px; line-height: 1.3; color: var(--muted); }
  .px-prdg__key { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .px-prdg__k { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-ui); font-size: 12px; line-height: 1.3; color: var(--muted); }
  .px-prdg__k i { flex: none; box-sizing: border-box; display: inline-block; }
  .px-prdg__ks { width: 18px; height: 12px; background: color-mix(in oklab, var(--accent) 45%, transparent); border-top: 2px solid var(--accent-deep); }
  .px-prdg__km { width: 2px; height: 14px; background: var(--ink); }
  .px-prdg__svg { display: block; width: 100%; height: auto; }
  .px-prdg__svg foreignObject { overflow: visible; }
  .px-prdg__svg .px-cue-tag { margin: 1px; }
  .px-prdg__ax { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .px-prdg__area { fill: var(--ink); fill-opacity: 0.12; }
  .px-prdg__edge { fill: none; stroke: var(--ink-2); stroke-width: 1.25; stroke-linejoin: round; }
  [data-subject] .px-prdg__area { fill: var(--accent); fill-opacity: 0.45; }
  [data-subject] .px-prdg__edge { stroke: var(--accent-deep); stroke-width: 2; }
  .px-prdg__c { stroke: var(--ink); stroke-width: 2; }
  [data-subject] .px-prdg__c { stroke: var(--accent-deep); }
  .px-prdg__gl { font-size: 13px; font-weight: 500; fill: var(--ink); }
  [data-subject] .px-prdg__gl { font-weight: 600; fill: var(--accent-deep); }
  .px-prdg__gv { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .px-prdg__gapt {
    font-size: 13px; font-weight: 600; fill: var(--accent-deep); font-variant-numeric: tabular-nums;
    paint-order: stroke; stroke: var(--paper-2); stroke-width: 3px; stroke-linejoin: round;
  }
  .px-prdg__foot { margin: 10px 0 0; font-family: var(--font-ui); font-size: 12px; line-height: 1.4; color: var(--muted); }
  /* LENS §7: the pinned figure headline is 96, 72 on phones. */
  @media (max-width: 767px) { .px-prdg__big { font-size: 72px; } }
</style>
