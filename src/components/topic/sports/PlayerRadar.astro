---
/*
  PlayerRadar — v2 hexagonal radar (.pr) inside the elevated .px-viz card.
  The data polygon scale-pops from the centre on scroll-in; the stat bars
  below grow left→right with a staggered delay. Faithful port of the kit's
  <PlayerRadar>. SVG, build-time, zero runtime JS (reveal handled by CSS via
  core/Reveal.astro toggling .is-in on the .px-viz).

  Use for: player ratings, team strengths, product feature
  comparisons, any N-dimensional comparison.

  props:
    stats[]   — { label: string, value: number, max?: number }
    player    — player / subject name
    team      — optional team / context label
    color     — preserved for compatibility (kit polygon colours via --accent)
    compare[] — preserved for compatibility (kit radar has no overlay; ignored)
    caption
    source
*/
interface Stat  { label: string; value: number; max?: number; }
interface Subject { label: string; stats: Stat[]; color?: string; }
interface Props {
  stats: Stat[];
  player?: string;
  team?: string;
  color?: string;
  compare?: Subject;
  caption?: string;
  source?: string;
}
const {
  stats = [],
  player,
  team,
  color,
  compare,
  caption,
  source,
} = Astro.props;

const C = 240, cx = C / 2, cy = C / 2, R = 92;
const n = stats.length;
const ang = (i: number) => (Math.PI * 2 * i) / n - Math.PI / 2;
const pt = (i: number, r: number): [number, number] => [cx + Math.cos(ang(i)) * r, cy + Math.sin(ang(i)) * r];

const rings = [0.25, 0.5, 0.75, 1];
const polyAt = (scale: number) => stats.map((_, i) => pt(i, R * scale).join(',')).join(' ');
const dataPoly = stats.map((s, i) => pt(i, R * (s.value / (s.max ?? 100))).join(',')).join(' ');
const axes = stats.map((_, i) => ({ x2: pt(i, R)[0], y2: pt(i, R)[1] }));
const labels = stats.map((s, i) => {
  const [lx, ly] = pt(i, R + 16);
  return { lx, ly, anchor: Math.abs(lx - cx) < 8 ? 'middle' : lx > cx ? 'start' : 'end', label: s.label };
});
---

<div class="px-viz pr" data-reveal>
  <div class="pr__stage">
    <svg class="pr__svg" viewBox={`0 0 ${C} ${C}`} role="img"
      aria-label={player ? `Radar chart: ${player}` : 'Radar chart'}>
      {rings.map((r) => <polygon class="pr__web" points={polyAt(r)} />)}
      {axes.map((a) => <line class="pr__axis" x1={cx} y1={cy} x2={a.x2} y2={a.y2} />)}
      <polygon class="pr__poly" points={dataPoly} />
      {labels.map((l) => (
        <text class="pr__lbl" x={l.lx} y={l.ly} text-anchor={l.anchor} dominant-baseline="middle">{l.label}</text>
      ))}
    </svg>
  </div>
  <div class="pr__stats">
    {player && <div class="pr__name">{player}</div>}
    {team && <div class="pr__team">{team}</div>}
    {stats.map((s, i) => (
      <>
        <div class="pr__stat"><span class="pr__stat-l">{s.label}</span><span class="pr__stat-v">{s.value}</span></div>
        <div class="pr__stat-bar"><span class="pr__stat-fill" style={`--w:${(s.value / (s.max ?? 100)) * 100}%;transition-delay:${300 + i * 70}ms`}></span></div>
      </>
    ))}
  </div>
</div>
