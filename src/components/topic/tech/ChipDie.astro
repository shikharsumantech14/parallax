---
/**
 * ChipDie (tech) — a processor die drawn as a floorplan to scale. Every
 * functional block (cores, cache, GPU, memory, I/O) is a tile whose AREA is
 * its real silicon area in mm², so "the GPU is bigger than all the CPU cores
 * combined" is something the reader SEES. Layout is a build-time squarified
 * treemap (Bruls et al.) over a fixed 560×360 board, placed by percentage.
 *
 * LENS PHASE 6 (2026-09-30, the board Lib-chip-die): FLAT. The CSS-3D
 * drafting tilt, the tile lift on hover and the hover readout island are
 * retired (LENS §6.5: hover never moves layout; the tilt set every label on
 * a slant and in perspective). The die is a flat floorplan with an ink edge
 * and a hard offset shadow, compute in the desk mark, the primary block in
 * the desk text ink, the other groups in the neutral inks, one key row. The
 * figure's one large number is the primary block's area. Labels are 12px
 * Literata and print only where measured to fit (per width tier);
 * elsewhere a dot marks the tile, and "All n blocks" lists every one.
 *
 * Cue anchors:
 *   1..n    each block, numbered from 1 in DATA order (the blocks as
 *           authored, not the area order the treemap draws them in).
 *   legend  the key row.
 *   head    the large number.
 *
 * THE BUILD (LENS §6.4): the card is the scene. 1 the die fades in, 2 its
 * tiles fade in, largest first, 80ms apart (compressed by the island), 3 the
 * key, 4 the large number counts up (src/scripts/build.ts). No JS or reduced
 * motion: the floorplan as drawn.
 *
 * data: ChipDieData — see docs/design/blueprints/tech/chip-die.md §3.
 */
import { renderInline } from '../../../lib/text';

type Group = 'compute' | 'memory' | 'io' | 'media' | 'other';
interface Block {
  label: string;
  areaMm2?: number;
  pct?: number;
  group?: Group;
  primary?: true;
  note?: string;
  count?: number;
}
interface Props {
  chip: string;
  dieAreaMm2?: number;
  blocks: Block[];
  caption?: string;
  source?: string;
}
const { chip, dieAreaMm2, blocks = [], caption, source } = Astro.props;

// ── Validation (blueprint §3 / acceptance) — 4–24 blocks ────────────────────
if (blocks.length < 4 || blocks.length > 24) {
  throw new Error(
    `chip-die "${chip}": blocks.length is ${blocks.length}; a chip-die needs 4–24 blocks (each covering a real die area). Split or merge blocks to fit the 4–24 rule.`
  );
}

// ── Resolve every block's real area in mm² (areaMm2 OR pct·dieArea) ──────────
const sumAreas = blocks.reduce((s, b) => s + (b.areaMm2 ?? 0), 0);
// If any block gives area, dieArea defaults to their sum; needed to resolve pct.
const provisionalDie = dieAreaMm2 ?? (sumAreas > 0 ? sumAreas : 0);
const resolved = blocks.map((b) => {
  let area = b.areaMm2;
  if (area == null && b.pct != null && provisionalDie > 0) area = (b.pct / 100) * provisionalDie;
  if (area == null || !(area > 0)) {
    throw new Error(`chip-die "${chip}": block "${b.label}" has no resolvable area (give areaMm2 or pct + dieAreaMm2).`);
  }
  return { ...b, area };
});
const mappedArea = resolved.reduce((s, b) => s + b.area, 0);
const dieArea = dieAreaMm2 ?? mappedArea;
const coverage = mappedArea / dieArea;
const mappedPct = Math.round(coverage * 100);

// Explicit "unmapped" remainder tile when coverage < 95% (blueprint §3, never
// silently absorbed).
const UNMAPPED = coverage < 0.95 ? dieArea - mappedArea : 0;

// ── Board + area-preserving scale (blueprint §4) ────────────────────────────
const BOARD_W = 560;
const BOARD_H = 360;
const BOARD_AREA = BOARD_W * BOARD_H; // 201,600 px²
const S = BOARD_AREA / dieArea;       // px² per mm² — 1 mm² = S px²

// Cells fed to the treemap: pixel-area value = area·S so Σ value = board area.
type Meta = { label: string; area: number; group: Group; primary: boolean; note?: string; count?: number; unmapped?: boolean };
const cells: { value: number; meta: Meta }[] = resolved.map((b) => ({
  value: b.area * S,
  meta: { label: b.label, area: b.area, group: b.group ?? 'other', primary: !!b.primary, note: b.note, count: b.count },
}));
if (UNMAPPED > 0) {
  cells.push({ value: UNMAPPED * S, meta: { label: 'Unmapped', area: UNMAPPED, group: 'other', primary: false, unmapped: true } });
}
// Squarify wants area-descending input (aspect-ratio minimising).
cells.sort((a, b) => b.value - a.value);

// ── Squarified treemap (Bruls et al.), integer-rounded, board exactly filled ─
type Rect = { x: number; y: number; w: number; h: number; meta: Meta };
function squarify(items: { value: number; meta: Meta }[]): Rect[] {
  const out: Rect[] = [];
  let x = 0, y = 0, w = BOARD_W, h = BOARD_H;
  const sum = (a: typeof items) => a.reduce((s, c) => s + c.value, 0);
  const worst = (a: typeof items, side: number) => {
    if (!a.length) return Infinity;
    const s = sum(a), mx = Math.max(...a.map((c) => c.value)), mn = Math.min(...a.map((c) => c.value));
    const s2 = s * s, side2 = side * side;
    return Math.max((side2 * mx) / s2, s2 / (side2 * mn));
  };
  const place = (row: typeof items, isLast: boolean) => {
    const rv = sum(row);
    if (w >= h) {
      // vertical strip (column) along the shorter side h
      const stripW = isLast ? w : Math.max(1, Math.min(w, Math.round(rv / h)));
      let cum = 0, prev = 0;
      row.forEach((c, k) => {
        cum += c.value;
        const b = k === row.length - 1 ? h : Math.round((cum / rv) * h);
        out.push({ x, y: y + prev, w: stripW, h: b - prev, meta: c.meta });
        prev = b;
      });
      x += stripW; w -= stripW;
    } else {
      // horizontal strip along the shorter side w
      const stripH = isLast ? h : Math.max(1, Math.min(h, Math.round(rv / w)));
      let cum = 0, prev = 0;
      row.forEach((c, k) => {
        cum += c.value;
        const b = k === row.length - 1 ? w : Math.round((cum / rv) * w);
        out.push({ x: x + prev, y, w: b - prev, h: stripH, meta: c.meta });
        prev = b;
      });
      y += stripH; h -= stripH;
    }
  };
  let row: typeof items = [];
  let i = 0;
  while (i < items.length) {
    const side = Math.min(w, h);
    const cur = items[i];
    if (row.length === 0) { row = [cur]; i++; continue; }
    if (worst([...row, cur], side) <= worst(row, side)) { row = [...row, cur]; i++; }
    else { place(row, false); row = []; }
  }
  if (row.length) place(row, true);
  return out;
}
const rects = squarify(cells);

// ── Does a tile's label fit it? Measured per width tier, not guessed ──────
// The board is a fixed share of the figure panel: about 470px wide at 1280
// and about 300px on a 375 phone, while the label is set in CSS pixels, so
// the same tile holds its label at one width and not at the next. Each tile
// gets `data-fit` = the narrowest tier whose box holds its name (wrapped at
// spaces, the count inline) and its area line; below that tier the label
// hides and a dot marks the tile (the block list carries every block).
// Literata 600 runs ~0.56em a character, estimated at 0.6em.
const TIERS = [
  { key: 'm', scale: 0.53, name: 12, area: 12 },   // ≤ 640px: board ≈ 300px
  { key: 'd', scale: 0.82, name: 12, area: 12 },   // the 1280 panel, board ≈ 460px
] as const;
const glyphW = (s: string, fs: number) => s.length * fs * 0.6;
function labelFits(label: string, count: number | undefined, areaTxt: string, w: number, h: number, t: (typeof TIERS)[number]): boolean {
  const boxW = w * t.scale - 2 - 12;
  const boxH = h * t.scale - 2 - 10;
  let lines = 1, cur = 0;
  for (const word of `${label}${count ? ` ×${count}` : ''}`.split(/\s+/).filter(Boolean)) {
    const ww = glyphW(word, t.name);
    if (ww > boxW) return false;
    const next = cur === 0 ? ww : cur + glyphW(' ', t.name) + ww;
    if (next > boxW) { lines++; cur = ww; } else cur = next;
  }
  if (glyphW(areaTxt, t.area) > boxW) return false;
  return lines * t.name * 1.2 + t.area * 1.25 <= boxH;
}

// ── Colour by group: the desk mark for compute, the primary block in the
//    desk text ink, the rest in the neutral inks (ink-2, muted, hair-2,
//    paper-3). `ink` says which text colour each fill carries. ───────────────
const groupFill: Record<Group, { fill: string; light: boolean; name: string }> = {
  compute: { fill: 'var(--accent)', light: false, name: 'Compute' },
  memory: { fill: 'var(--ink-2)', light: true, name: 'Memory' },
  io: { fill: 'var(--muted)', light: true, name: 'I/O' },
  media: { fill: 'var(--hair-2)', light: false, name: 'Media' },
  other: { fill: 'var(--paper-3)', light: false, name: 'Other' },
};
const fmtArea = (a: number) => (Number.isInteger(a) ? `${a}` : a.toFixed(1));
const pctOf = (a: number) => Math.round((a / dieArea) * 100);
/* Cue anchors are numbered in DATA order (the blocks as authored). */
const dataIdx = (label: string) => blocks.findIndex((b) => b.label === label) + 1;

const tiles = rects
  .map((r) => {
    const m = r.meta;
    const pct = pctOf(m.area);
    const readParts = [
      `${m.label}${m.count ? ` ×${m.count}` : ''}`,
      `${fmtArea(m.area)} mm² · ${pct}% of die`,
    ];
    if (m.note) readParts.push(m.note);
    const g = groupFill[m.group];
    return {
      ...m,
      pct,
      cue: m.unmapped ? 0 : dataIdx(m.label),
      lp: (r.x / BOARD_W) * 100,
      tp: (r.y / BOARD_H) * 100,
      wp: (r.w / BOARD_W) * 100,
      hp: (r.h / BOARD_H) * 100,
      fit: (TIERS.find((t) => labelFits(m.label, m.count, `${fmtArea(m.area)} mm²`, r.w, r.h, t))?.key ?? '') as string,
      fill: m.primary ? 'var(--accent-deep)' : g.fill,
      light: m.primary ? true : g.light,
      read: readParts.join(' · '),
    };
  })
  .sort((a, b) => b.area - a.area);

/* The key: one swatch per group present, the primary block first. */
const primary = tiles.find((t) => t.primary) ?? tiles[0];
const groupsPresent = (['compute', 'memory', 'io', 'media', 'other'] as Group[]).filter((g) =>
  tiles.some((t) => !t.unmapped && t.group === g && !t.primary),
);
const headWhole = Number.isInteger(primary.area);
const headLabel = `mm² · ${primary.label}${primary.count ? ` ×${primary.count}` : ''}${mappedPct < 100 ? ` · ${mappedPct}% of the die mapped` : ''}`;
---

<div class="px-viz px-die" data-build-scene>
  {caption && (
    <div class="px-viz__cap">
      <span set:html={renderInline(caption)} />
      {mappedPct < 100 && <b>{mappedPct}% mapped</b>}
    </div>
  )}

  <div class="px-die__head" data-cue="head" style={`--ch:${fmtArea(primary.area).length}`}>
    <span class="px-cue-tag" data-cue-tag="head" hidden></span>
    <span class="px-die__big"><span data-build="4" data-build-kind="counter" data-to={primary.area} data-format={headWhole ? 'int' : '1dp'}>{fmtArea(primary.area)}</span></span>
    <span class="px-die__biglab">{headLabel}</span>
  </div>

  <ul class="px-die__key" aria-hidden="true" data-cue="legend" data-build="3">
    <li><span class="px-die__sw" style={`--fill:${primary.primary ? 'var(--accent-deep)' : groupFill[primary.group].fill}`}></span>{primary.label}</li>
    {groupsPresent.map((g) => (
      <li><span class="px-die__sw" style={`--fill:${groupFill[g].fill}`}></span>{groupFill[g].name}</li>
    ))}
  </ul>

  <div class="px-die__board" role="group" aria-label={`${chip}: die floorplan, drawn to scale, ${fmtArea(dieArea)} mm²`} style={`aspect-ratio:${BOARD_W}/${BOARD_H}`} data-build="1">
    {tiles.map((t) => (
      <div
        class:list={['px-die__tile', { 'is-primary': t.primary, 'is-light': t.light, 'is-unmapped': t.unmapped }]}
        data-fit={t.fit}
        data-cue={t.cue || undefined}
        title={t.read}
        role="img"
        aria-label={t.read}
        style={`left:${t.lp.toFixed(3)}%; top:${t.tp.toFixed(3)}%; width:${t.wp.toFixed(3)}%; height:${t.hp.toFixed(3)}%; --fill:${t.fill}`}
        data-build="2"
      >
        {t.fit && (
          <span class="px-die__lab" aria-hidden="true">
            <span class="px-die__name">{t.label}{t.count ? <>{' '}<em class="px-die__tx">×{t.count}</em></> : null}</span>
            <span class="px-die__area">{fmtArea(t.area)} mm²</span>
          </span>
        )}
        <span class="px-die__dot" aria-hidden="true"></span>
        {t.cue > 0 && <span class="px-die__pin"><span class="px-cue-tag" data-cue-tag={t.cue} hidden></span></span>}
      </div>
    ))}
  </div>

  <details class="px-die__more">
    <summary>All {tiles.length} blocks</summary>
    <ul class="px-die__list">
      {tiles.map((t) => (
        <li class:list={['px-die__row', { 'is-primary': t.primary }]}>
          <span class="px-die__sw" style={`--fill:${t.fill}`}></span>
          <span class="px-die__rlabel">{t.label}{t.count ? <em class="px-die__x">×{t.count}</em> : null}{t.note && <span class="px-die__note"> · {t.note}</span>}</span>
          <span class="px-die__rval">{fmtArea(t.area)} mm² · {t.pct}%</span>
        </li>
      ))}
    </ul>
  </details>
</div>

<style>
  /* LENS §7: the pinned figure's headline number at 96 (72 on phones),
     its label 8px below it. The size also fits the number to the panel:
     --ch is its character count, the head a size container. */
  .px-die__head {
    container-type: inline-size;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    row-gap: 8px;
    align-items: center;
    margin-bottom: 20px;
  }
  .px-die__head > .px-cue-tag { grid-column: 1; grid-row: 1; margin: 0 8px 0 0; }
  .px-die__big { grid-column: 2; grid-row: 1; justify-self: start; white-space: nowrap; }
  .px-die__biglab { grid-column: 2; grid-row: 2; justify-self: start; }
  .px-die__big {
    font-family: var(--font-ui);
    font-size: min(96px, calc((100cqi - 28px) / var(--ch, 4) / 0.62));
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-deep);
    padding-bottom: 0.12em;
  }
  .px-die__biglab {
    min-width: 0;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-2);
    line-height: 1.35;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .px-die__key {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink-2);
  }
  .px-die__key li { display: inline-flex; align-items: center; gap: 6px; }
  .px-die__sw {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: var(--fill);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ink) 12%, transparent);
  }

  /* The die: a flat floorplan with an ink edge and a hard offset shadow (the
     package), every tile placed by % of the fixed 560×360 board. */
  .px-die__board {
    position: relative;
    width: 100%;
    background: var(--paper-2);
    border: 2px solid var(--ink-2);
    box-shadow: 6px 6px 0 0 var(--hair-2);
    margin-bottom: 6px;
    box-sizing: border-box;
  }
  .px-die__tile {
    position: absolute;
    box-sizing: border-box;
    border: 1px solid var(--paper-2);
    background: var(--fill);
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 5px 6px;
    color: var(--ink);
    transition: box-shadow 160ms var(--ease);
  }
  .px-die__tile.is-light { color: var(--paper-2); }
  .px-die__tile:hover { box-shadow: inset 0 0 0 2px var(--ink); }
  .px-die__tile.is-unmapped {
    background:
      repeating-linear-gradient(45deg, color-mix(in srgb, var(--ink) 20%, transparent) 0 1px, transparent 1px 6px),
      var(--paper-3);
  }

  .px-die__lab { display: flex; flex-direction: column; gap: 2px; line-height: 1.2; pointer-events: none; min-width: 0; }
  .px-die__name {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    overflow-wrap: normal;
  }
  .px-die__tx { font-style: normal; font-weight: 500; white-space: nowrap; }
  .px-die__area {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  /* a tile whose label does not fit at this width shows a dot instead */
  .px-die__dot {
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px; height: 4px; margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }
  .px-die__tile[data-fit=""] .px-die__dot { display: block; }
  /* the cue numeral sits in the tile's lower-right corner */
  .px-die__pin { position: absolute; right: 5px; bottom: 5px; line-height: 0; }
  .px-die__pin .px-cue-tag { margin: 0; }

  .px-die__more { margin-top: 12px; }
  .px-die__more > summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-deep);
  }
  .px-die__list { list-style: none; margin: 0; padding: 0; }
  .px-die__row {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 10px;
    padding: 5px 0;
    border-bottom: 1px solid var(--hair);
    font-family: var(--font-ui);
    font-size: 13px;
  }
  .px-die__row .px-die__sw { align-self: center; }
  .px-die__rlabel { color: var(--ink); min-width: 0; }
  .px-die__row.is-primary .px-die__rlabel { font-weight: 600; }
  .px-die__x { font-style: normal; color: var(--muted); margin-left: 5px; }
  .px-die__note { color: var(--muted); }
  .px-die__rval { color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* the phone tier: a label measured only for the panel's width hides */
  @media (max-width: 640px) {
    .px-die__tile[data-fit="d"] .px-die__lab { display: none; }
    .px-die__tile[data-fit="d"] .px-die__dot { display: block; }
  }
  @media (max-width: 640px) {
    .px-die__big { font-size: min(72px, calc((100cqi - 28px) / var(--ch, 4) / 0.62)); }
  }
</style>
