---
/**
 * ArchStack (tech) — a layered stack: one slab per layer, the top of the list
 * the top of the stack (what the user touches), the bottom what it all runs
 * on. Each slab carries its label and an optional sublabel, and may carry a
 * per-layer colour. Build-time HTML; zero JS of its own.
 *
 * LENS PHASE 6 (2026-09-30, the board Lib-arch-stack): the slab is drawn, not
 * put in perspective. A tinted top face and a solid edge under it (a hard,
 * offset shadow in the slab's own ink) read as thickness at any width, so the
 * stack FITS the panel with no magnification reserve, and nothing moves on
 * hover: the pointer tilt (`data-tilt`) and the hover lift are retired (LENS
 * §6.5, hover never moves layout). The label is Literata 15/600 in ink,
 * the sublabel 13px in ink-2, sentence case, and both wrap.
 *
 * Cue anchors:
 *   1..n   each slab, numbered from 1 top to bottom (data order).
 *
 * THE BUILD (LENS §6.4): the stack is the scene. 1 the slabs drop in, top to
 * bottom, 80ms apart (src/scripts/build.ts). No JS or reduced motion: the
 * stack as drawn.
 *
 * data: { layers[]{ label, sublabel?, color? }, caption?, source? }
 */
interface Layer { label: string; sublabel?: string; color?: string; }
interface Props { layers: Layer[]; caption?: string; source?: string; }
const { layers = [], caption } = Astro.props;

const slabs = layers.map((l, i) => ({ ...l, i, ink: l.color || 'var(--accent)' }));
---

<div class="px-viz">
  {caption && <div class="px-viz__cap"><span>{caption}</span><b>stack</b></div>}

  <ol class="px-arch" data-build-scene aria-label={caption ? `Stack: ${caption}` : 'Layered stack'}>
    {slabs.map((s) => (
      <li class="px-arch__slab" data-cue={s.i + 1} style={`--slab:${s.ink}`} data-build="1" data-build-kind="drop">
        <span class="px-arch__label"><span class="px-cue-tag" data-cue-tag={s.i + 1} hidden></span>{s.label}</span>
        {s.sublabel && <span class="px-arch__sub">{s.sublabel}</span>}
      </li>
    ))}
  </ol>
</div>

<style>
  .px-arch {
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* The slab: a tinted top face with a hair border, the edge under it a
     solid 6px band of the slab's ink, darkened. */
  .px-arch__slab {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 16px 13px;
    border-radius: var(--r-ctl, 4px);
    background: color-mix(in oklab, var(--slab) 16%, var(--paper-2));
    border: 1px solid color-mix(in oklab, var(--slab) 45%, var(--hair));
    box-shadow: 0 6px 0 0 color-mix(in oklab, var(--slab) 72%, var(--ink));
  }

  .px-arch__label {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.25;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .px-arch__sub {
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
</style>
