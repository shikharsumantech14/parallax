---
/**
 * BenchmarkChart — v2 horizontal comparison bars (.bc) inside the elevated
 * .px-viz card. Bars grow-in left→right on scroll, an optional dashed
 * reference line drops in over the track grid. Faithful port of the
 * publication-v2 kit <BenchmarkChart>. Build-time, zero runtime JS (reveal
 * handled by CSS; core/Reveal.astro toggles .is-in on the .px-viz shell).
 *
 * Use for: LLM benchmark scores, hardware performance, framework speed
 * comparisons, pricing tables.
 *
 * props:
 *   items[]   — { label, value, sublabel?, highlight?, color? }
 *               sublabel renders as a second line under the label, in the
 *               fixed 150px column (the track collapses on a phone; it does not)
 *   maxValue  — right-end of scale (default: auto from data × 1.05)
 *   unit      — caption unit chip (e.g. "tokens/s", "pts", "%")
 *   refValue  — optional reference line value (e.g. human baseline)
 *   refLabel  — label for the reference line
 *   sortDesc  — sort items descending by value (default true)
 *   caption
 *   source
 */
interface Item {
  label: string;
  value: number;
  sublabel?: string;
  highlight?: boolean;
  color?: string;
}
/* The annotation layer — docs/design/blueprints/_ANNOTATIONS.md. 0–3 per
   chart, optional everywhere; absent ⇒ nothing renders. `side` / `series`
   are accepted for contract parity: the bars are one series, and a callout
   always attaches to the end of its own bar. */
interface Annotation {
  at: string | number;
  text: string;
  side?: 'above' | 'below' | 'left' | 'right';
  series?: string;
}
interface Props {
  items: Item[];
  annotations?: Annotation[];
  maxValue?: number;
  unit?: string;
  refValue?: number;
  refLabel?: string;
  sortDesc?: boolean;
  caption?: string;
  source?: string;
}
const {
  items = [],
  annotations = [],
  maxValue,
  unit = '',
  refValue,
  refLabel,
  sortDesc = true,
  caption,
  source,
} = Astro.props;

const rows = sortDesc ? [...items].sort((a, b) => b.value - a.value) : items;
// Honor an explicit maxValue; otherwise derive as the kit does (data peak × 1.05).
const dataMax = Math.max(refValue ?? 0, ...items.map((i) => i.value), 1) * 1.05;
const max = maxValue ?? dataMax;

const hasRef = refValue != null;

// ── Annotations ─────────────────────────────────────────────────────────────
// `at` is the item's LABEL (string). A label not in `items` is a silent no-op
// (spec §2). The callout attaches to the end of that bar, on its own grid line
// under the row, so it never fights the 150px / 1fr / 52px row geometry.
const annotFor = new Map<string, string[]>();
for (const a of annotations ?? []) {   // `annotations:` with no items parses as null
  if (!a || !a.text) continue;
  const label = String(a.at ?? '');
  if (!rows.some((r) => r.label === label)) continue;
  annotFor.set(label, [...(annotFor.get(label) ?? []), a.text]);
}
// The track's own scale — the same expression the reference line is placed by,
// so the dot lands exactly where `--w` ends.
const TRACK = '(100% - 150px - 14px - 52px - 14px)';
const barEnd = (v: number) => `calc(150px + 14px + ${TRACK} * ${(v / max).toFixed(4)})`;
// Past half the scale the callout mirrors: right-aligned so it ENDS on the mark
// rather than running off the card (the HTML twin of text-anchor="end"). The
// min() floor keeps at least 140px of text column on a phone, where the row's
// fixed 150px label column leaves the track only a sliver.
const annotPad = (v: number) => {
  const f = v / max;
  return f > 0.5
    ? `padding-right:min(calc(52px + 14px + ${TRACK} * ${(1 - f).toFixed(4)} + 8px), calc(100% - 140px));text-align:right`
    : `padding-left:min(calc(150px + 14px + ${TRACK} * ${f.toFixed(4)} + 8px), calc(100% - 140px))`;
};
---

<div class="px-viz" data-reveal>
  <div class="px-viz__cap"><span>{caption}</span>{unit && <b>{unit}</b>}</div>

  {hasRef && (
    <div class="bc__ref">
      <div
        class="bc__refline"
        style={`left:calc(150px + 14px + (100% - 150px - 14px - 52px - 14px) * ${refValue! / max})`}
      >
        <span class="bc__reflabel" data-side={refValue / maxValue > 0.7 ? 'left' : 'center'}>{refLabel ? `${refLabel} · ${refValue}` : refValue}</span>
      </div>
    </div>
  )}

  <div
    role="img"
    aria-label={caption ? `Benchmark comparison: ${caption}` : 'Benchmark comparison chart'}
    style={`margin-top:${hasRef ? 18 : 0}px`}
  >
    {rows.map((it, i) => (
      <div class="bc__row" data-hl={it.highlight ? 'true' : 'false'}>
        <span class="bc__label">
          {it.label}
          {it.sublabel && <span class="bc__sub">{it.sublabel}</span>}
        </span>
        <span class="bc__track">
          <span
            class="bc__fill"
            style={`--w:${(it.value / max) * 100}%;transition-delay:${i * 60}ms${it.color ? `;background:${it.color}` : ''}`}
          ></span>
        </span>
        <span class="bc__val">{it.value}</span>
        {(annotFor.get(it.label) ?? []).map((t) => (
          <span class="bc__annot" style={`grid-column:1/-1;position:relative;display:block;padding-top:6px;${annotPad(it.value)}`}>
            <span class="bc__annot-d" style={`position:absolute;left:${barEnd(it.value)};top:-17px;width:6px;height:6px;margin-left:-3px;border-radius:50%;background:var(--accent)`}></span>
            <span class="bc__annot-l" style={`position:absolute;left:${barEnd(it.value)};top:-11px;width:1px;height:14px;margin-left:-0.5px;background:var(--rule)`}></span>
            <span class="bc__annot-t vz-annot" style="display:block">{t}</span>
          </span>
        ))}
      </div>
    ))}
  </div>

</div>
