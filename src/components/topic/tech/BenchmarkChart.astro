---
/**
 * BenchmarkChart — v2 horizontal comparison bars (.bc) inside the elevated
 * .px-viz card. Bars grow-in left→right on scroll, an optional dashed
 * reference line drops in over the track grid. Faithful port of the
 * publication-v2 kit <BenchmarkChart>. Build-time, zero runtime JS (reveal
 * handled by CSS; core/Reveal.astro toggles .is-in on the .px-viz shell).
 *
 * Use for: LLM benchmark scores, hardware performance, framework speed
 * comparisons, pricing tables.
 *
 * props:
 *   items[]   — { label, value, sublabel?, highlight?, color? }
 *   maxValue  — right-end of scale (default: auto from data × 1.05)
 *   unit      — caption unit chip (e.g. "tokens/s", "pts", "%")
 *   refValue  — optional reference line value (e.g. human baseline)
 *   refLabel  — label for the reference line
 *   sortDesc  — sort items descending by value (default true)
 *   caption
 *   source
 */
interface Item {
  label: string;
  value: number;
  sublabel?: string;
  highlight?: boolean;
  color?: string;
}
interface Props {
  items: Item[];
  maxValue?: number;
  unit?: string;
  refValue?: number;
  refLabel?: string;
  sortDesc?: boolean;
  caption?: string;
  source?: string;
}
const {
  items = [],
  maxValue,
  unit = '',
  refValue,
  refLabel,
  sortDesc = true,
  caption,
  source,
} = Astro.props;

const rows = sortDesc ? [...items].sort((a, b) => b.value - a.value) : items;
// Honor an explicit maxValue; otherwise derive as the kit does (data peak × 1.05).
const dataMax = Math.max(refValue ?? 0, ...items.map((i) => i.value), 1) * 1.05;
const max = maxValue ?? dataMax;

const hasRef = refValue != null;
---

<div class="px-viz" data-reveal>
  <div class="px-viz__cap"><span>{caption}</span>{unit && <b>{unit}</b>}</div>

  {hasRef && (
    <div class="bc__ref">
      <div
        class="bc__refline"
        style={`left:calc(150px + 14px + (100% - 150px - 14px - 52px - 14px) * ${refValue! / max})`}
      >
        <span class="bc__reflabel">{refLabel ? `${refLabel} · ${refValue}` : refValue}</span>
      </div>
    </div>
  )}

  <div
    role="img"
    aria-label={caption ? `Benchmark comparison: ${caption}` : 'Benchmark comparison chart'}
    style={`margin-top:${hasRef ? 18 : 0}px`}
  >
    {rows.map((it, i) => (
      <div class="bc__row" data-hl={it.highlight ? 'true' : 'false'}>
        <span class="bc__label">{it.label}</span>
        <span class="bc__track">
          <span
            class="bc__fill"
            style={`--w:${(it.value / max) * 100}%;transition-delay:${i * 60}ms${it.color ? `;background:${it.color}` : ''}`}
          ></span>
        </span>
        <span class="bc__val">{it.value}</span>
      </div>
    ))}
  </div>

  {source && <div class="px-viz__src">Source · {source}</div>}
</div>
