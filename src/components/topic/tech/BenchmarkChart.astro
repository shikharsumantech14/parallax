---
/*
  BenchmarkChart — horizontal comparison bars.
  SVG, build-time, zero runtime JS.

  Use for: LLM benchmark scores, hardware performance,
  framework speed comparisons, pricing tables.

  props:
    items[]       — { label: string, value: number, sublabel?: string,
                      highlight?: boolean, color?: string }
    maxValue      — right-end of scale (default: auto from data)
    unit          — appended to value label (e.g. "tokens/s", "pts", "%")
    refValue      — optional reference line (e.g. human baseline)
    refLabel      — label for reference line
    sortDesc      — sort items descending by value (default true)
    caption
    source
*/
interface Item {
  label: string;
  value: number;
  sublabel?: string;
  highlight?: boolean;
  color?: string;
}
interface Props {
  items: Item[];
  maxValue?: number;
  unit?: string;
  refValue?: number;
  refLabel?: string;
  sortDesc?: boolean;
  caption?: string;
  source?: string;
}
const {
  items = [],
  unit = '',
  refValue,
  refLabel,
  sortDesc = true,
  caption,
  source,
} = Astro.props;

let { maxValue } = Astro.props;

const sorted = sortDesc
  ? [...items].sort((a, b) => b.value - a.value)
  : [...items];

const dataMax = Math.max(...sorted.map(d => d.value), refValue ?? 0, 1);
const scale = maxValue ?? dataMax * 1.08;

// Layout constants
const ROW_H   = 42;
const LABEL_W = 200;
const BAR_GAP = 8;
const PAD     = { top: 8, right: 80, bottom: 12, left: 8 };
const W       = 760;
const BAR_AREA_W = W - LABEL_W - PAD.left - PAD.right;
const H       = sorted.length * ROW_H + PAD.top + PAD.bottom;

const barW = (v: number) => (v / scale) * BAR_AREA_W;
const barX  = PAD.left + LABEL_W;
const barY  = (i: number) => PAD.top + i * ROW_H + BAR_GAP;
const bH    = ROW_H - BAR_GAP * 2;

const refX = refValue != null ? barX + barW(refValue) : null;

const fmt = (v: number) =>
  (v >= 1000 ? (v / 1000).toFixed(1) + 'k' : v % 1 === 0 ? String(v) : v.toFixed(1))
  + (unit ? ' ' + unit : '');
---

<div class="px-bench">
  {caption && <div class="px-bench__caption">{caption}</div>}

  <svg viewBox={`0 0 ${W} ${H}`} class="px-bench__svg" role="img"
    aria-label="Benchmark comparison chart">

    <!-- Row backgrounds (alternating subtle) -->
    {sorted.map((_, i) => i % 2 === 1 && (
      <rect x={0} y={PAD.top + i * ROW_H} width={W} height={ROW_H}
        style="fill:var(--paper-2,var(--paper));opacity:0.4" />
    ))}

    <!-- Reference line -->
    {refX != null && (
      <>
        <line x1={refX} y1={PAD.top} x2={refX} y2={H - PAD.bottom}
          style="stroke:var(--accent);stroke-width:1;stroke-dasharray:4 3;opacity:0.6" />
        <text x={refX + 4} y={PAD.top + 8} text-anchor="start"
          style="font-family:'JetBrains Mono',monospace;font-size:9px;
                 fill:var(--accent);letter-spacing:0.08em;text-transform:uppercase">
          {refLabel ?? 'Reference'}
        </text>
      </>
    )}

    {sorted.map((item, i) => {
      const bw = barW(item.value);
      const by = barY(i);
      const barColor = item.highlight
        ? 'var(--accent)'
        : (item.color ?? 'var(--accent-deep)');
      return (
        <>
          {/* Label */}
          <text x={PAD.left + LABEL_W - 10} y={by + bH / 2 + 1}
            text-anchor="end" dominant-baseline="middle"
            style={`font-family:'JetBrains Mono',monospace;font-size:12px;
                   fill:${item.highlight ? 'var(--accent)' : 'var(--ink)'};
                   letter-spacing:0.03em;${item.highlight ? 'font-weight:600' : ''}`}>
            {item.label}
          </text>
          {item.sublabel && (
            <text x={PAD.left + LABEL_W - 10} y={by + bH / 2 + 13}
              text-anchor="end" dominant-baseline="middle"
              style="font-family:'JetBrains Mono',monospace;font-size:9px;
                     fill:var(--muted);letter-spacing:0.04em">
              {item.sublabel}
            </text>
          )}

          {/* Bar */}
          <rect x={barX} y={by} width={Math.max(0, bw)} height={bH}
            rx={2}
            style={`fill:${barColor};opacity:${item.highlight ? 1 : 0.75}`}
          />

          {/* Value label */}
          <text x={barX + bw + 6} y={by + bH / 2 + 1}
            text-anchor="start" dominant-baseline="middle"
            style={`font-family:'JetBrains Mono',monospace;font-size:11px;
                   fill:${item.highlight ? 'var(--accent)' : 'var(--ink-soft)'};
                   letter-spacing:0.04em`}>
            {fmt(item.value)}
          </text>
        </>
      );
    })}
  </svg>

  {source && <div class="px-bench__source">{source}</div>}
</div>
