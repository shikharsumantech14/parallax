---
/* CommitGrid — an activity heatmap: one column per week, one square per day,
   five intensity steps in the desk mark. Use for: release cadence, deployment
   frequency, incident timelines, model-version drops.

   LENS PHASE 6 (2026-09-30, the board Lib-commit-grid): TIGHTENED. The grid is
   the whole figure, one legend row, the named days as cues, no meta line
   (`meta` is read into the figure's accessible name, not printed).

   Drawn for the figure panel (about 472px of content at 1280, 295px on a
   375 phone). A year does not fit one row of 52 columns at a legible size,
   so a series longer than 30 weeks is set as TWO stacked halves, each with
   its own month row: the weekday label column and the week columns share one
   template, cells square by aspect-ratio, so the grid fits the panel at every
   width with no sideways scroll. Months are split between the halves by the
   week each one starts on (the data carries no dates, so an even split of
   the labels over the weeks is the honest reading).

   Cue anchors:
     1..n   the named days: every cell that carries a `label`, numbered from 1
            in data order (week by week, Monday first). Each is outlined in
            ink; its numeral prints in a lane above the grid (Mon to Thu rows)
            or below it (Fri to Sun), on a leader to the cell.
     legend the legend row.

   THE BUILD (LENS §6.4): the root is the scene. 1 the month and weekday
   labels fade in, 2 the week columns fade in left to right (80ms apart,
   compressed by the island), the named days with them, 3 the legend. The
   numeral pins do not build: an uncued pin is display:none, and a hidden
   element cannot be compared with the static page. No JS or reduced
   motion: the grid as drawn. */

interface Day {
  /* 0 = no activity, 1–4 = intensity step (low → high) */
  level: 0 | 1 | 2 | 3 | 4;
  /* optional name for the day: makes it a cue anchor */
  label?: string;
}

interface Props {
  /* Weeks of data, oldest first. Each week is exactly 7 days (Mon–Sun). */
  weeks: Day[][];
  /* Column-axis labels, spread evenly over the weeks */
  months?: string[];
  /* Row-axis labels, Mon/Wed/Fri usually */
  weekdays?: string[];
  caption?: string;
  /* e.g. "1,247 commits · 12 mo": the figure's accessible name */
  meta?: string;
  source?: string;
}
const {
  weeks = [],
  months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
  weekdays = ['Mon', '', 'Wed', '', 'Fri', '', ''],
  caption,
  meta,
} = Astro.props;

const n = Math.max(1, weeks.length);
const halves = n > 30 ? 2 : 1;
const per = Math.ceil(n / halves);

/* Month label i heads an even share of all the weeks; it belongs to the half
   its first week falls in, and its span is clipped to that half. */
const monthStarts = months.map((m, i) => ({
  m,
  a: Math.round((i * n) / months.length),
  b: Math.max(Math.round((i * n) / months.length) + 1, Math.round(((i + 1) * n) / months.length)),
}));

/* Named days, numbered in data order. */
let k = 0;
const cue = weeks.map((w) => (w ?? []).map((d) => (d && d.label ? ++k : 0)));
const named = k > 0;

const blocks = Array.from({ length: halves }, (_, h) => {
  const from = h * per;
  const to = Math.min(n, from + per);
  const cols = Math.max(1, to - from);
  return {
    cols,
    weeks: weeks.slice(from, to).map((w, j) => ({ days: w ?? [], cues: cue[from + j] ?? [] })),
    months: monthStarts
      .filter((s) => s.a >= from && s.a < to)
      .map((s) => ({ m: s.m, start: s.a - from + 2, end: Math.min(s.b, to) - from + 2 })),
  };
});
const legend = [0, 1, 2, 3, 4];
const name = meta ?? caption ?? 'Activity heatmap';
---

<div class="px-commit" data-viz-root data-build-scene role="group" aria-label={name}>
  {blocks.map((b) => (
    <div class="px-commit__half" style={`--cols:${b.cols}`}>
      <div class="px-commit__months" aria-hidden="true" data-build="1">
        {b.months.map((s) => (
          <span class="px-commit__month" style={`grid-column:${s.start} / ${s.end}`}>{s.m}</span>
        ))}
      </div>
      <div class="px-commit__body">
        <div class="px-commit__weekdays" aria-hidden="true" data-build="1">
          {weekdays.slice(0, 7).map((d) => <span class="px-commit__weekday">{d}</span>)}
        </div>
        {b.weeks.map((w) => (
          <div class="px-commit__week" data-build="2">
            {w.days.map((d, r) => {
              const c = w.cues[r];
              return c ? (
                <span
                  class="px-commit__cell px-commit__cell--named"
                  data-level={d.level}
                  data-cue={c}
                  title={d.label}
                  role="img"
                  aria-label={d.label}
                  style={`--r:${r}`}
                >
                  <span class={`px-commit__pin ${r < 4 ? 'px-commit__pin--up' : 'px-commit__pin--down'}`}>
                    <span class="px-cue-tag" data-cue-tag={c} hidden></span>
                  </span>
                </span>
              ) : (
                <span class="px-commit__cell" data-level={d.level} title={d.label}></span>
              );
            })}
          </div>
        ))}
      </div>
    </div>
  ))}

  <div class="px-commit__legend" data-cue="legend" data-build="3">
    <span class="px-commit__key">
      <span class="px-cue-tag" data-cue-tag="legend" hidden></span>
      <span class="px-commit__lab">Less</span>
      {legend.map((l) => <span class="px-commit__sw" data-level={l}></span>)}
      <span class="px-commit__lab">More</span>
    </span>
    {named && (
      <span class="px-commit__key">
        <span class="px-commit__sw px-commit__sw--named" data-level="0"></span>
        <span class="px-commit__lab">Named day</span>
      </span>
    )}
  </div>
</div>

<style>
  /* All of the kind's CSS lives here (the tech.css block was retired in Lens
     Phase 6): the panel owns the card, so the grid has no frame of its own. */
  .px-commit {
    --wd: 32px;                 /* weekday label column */
    --gap: 3px;
    --lane: 30px;               /* the numeral lane above / below a half */
    margin: 0;
    color: var(--ink);
    font-family: var(--font-ui);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .px-commit__half {
    --template: var(--wd) repeat(var(--cols), minmax(0, 1fr));
  }
  /* A lane is reserved only where a numeral actually prints. */
  .px-commit__half:has(.px-commit__pin--up .px-cue-tag:not([hidden])) { padding-top: var(--lane); }
  .px-commit__half:has(.px-commit__pin--down .px-cue-tag:not([hidden])) { padding-bottom: var(--lane); }

  .px-commit__months {
    display: grid;
    grid-template-columns: var(--template);
    column-gap: var(--gap);
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .px-commit__month { min-width: 0; white-space: nowrap; }

  .px-commit__body {
    display: grid;
    grid-template-columns: var(--template);
    column-gap: var(--gap);
  }
  .px-commit__weekdays,
  .px-commit__week {
    display: grid;
    grid-template-rows: repeat(7, auto);
    row-gap: var(--gap);
    min-width: 0;
  }
  /* the label column splits the weeks' height in seven, so each label sits on
     its row of cells whatever size the cells come to */
  .px-commit__weekdays {
    grid-template-rows: repeat(7, minmax(0, 1fr));
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    color: var(--muted);
  }
  .px-commit__weekday { display: flex; align-items: center; min-width: 0; white-space: nowrap; }

  .px-commit__cell {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 2px;
    background: var(--paper-3);
  }
  .px-commit__cell[data-level='1'],
  .px-commit__sw[data-level='1'] { background: color-mix(in oklab, var(--accent) 28%, var(--paper-2)); }
  .px-commit__cell[data-level='2'],
  .px-commit__sw[data-level='2'] { background: color-mix(in oklab, var(--accent) 55%, var(--paper-2)); }
  .px-commit__cell[data-level='3'],
  .px-commit__sw[data-level='3'] { background: var(--accent); }
  .px-commit__cell[data-level='4'],
  .px-commit__sw[data-level='4'] { background: color-mix(in oklab, var(--accent) 55%, var(--ink)); }

  /* A named day: an ink ring drawn inside the cell, so it never grows it. */
  .px-commit__cell--named { box-shadow: inset 0 0 0 2px var(--ink); z-index: 1; }

  /* The numeral's pin: the disc in the lane, a hair leader down (or up) to the
     cell. The distance is counted in cell pitches (`100%` of the cell plus
     the gap) from the cell's row to the edge of the grid, plus the month row
     above. Shown only when core/Section.astro has filled the numeral. */
  .px-commit__pin {
    position: absolute;
    left: 50%;
    width: 0;
    display: none;
    pointer-events: none;
  }
  .px-commit__pin:has(.px-cue-tag:not([hidden])) { display: block; }
  .px-commit__pin--up {
    bottom: 100%;
    height: calc((100% + var(--gap)) * var(--r) + 22px + 6px);
  }
  .px-commit__pin--down {
    top: 100%;
    height: calc((100% + var(--gap)) * (6 - var(--r)) + 6px);
  }
  .px-commit__pin::before {
    content: '';
    position: absolute;
    left: -0.5px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--ink);
  }
  .px-commit__pin .px-cue-tag {
    position: absolute;
    left: 0;
    translate: -50% 0;
    margin: 0;
  }
  .px-commit__pin--up .px-cue-tag { bottom: 100%; }
  .px-commit__pin--down .px-cue-tag { top: 100%; }

  .px-commit__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .px-commit__key { display: inline-flex; align-items: center; gap: 5px; }
  .px-commit__lab { padding: 0 4px; }
  .px-commit__sw {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: var(--paper-3);
  }
  .px-commit__sw--named { box-shadow: inset 0 0 0 2px var(--ink); }

  @media (max-width: 640px) {
    .px-commit { --wd: 30px; --gap: 2px; }
  }
</style>
