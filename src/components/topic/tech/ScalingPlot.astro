---
/**
 * ScalingPlot (tech) — a scaling scatter (e.g. params vs. performance) with a
 * LOG ⇄ LINEAR axis toggle.
 *
 * B1 retrofit (docs/REVAMP-PLAN.md §4 Phase 6.2). The props already carried
 * `logX` / `logY` at build time; the reader could not see what the log axis was
 * doing to the shape. Now they can press Linear and watch the lower points
 * collapse toward the axis — which is the whole claim a log scale makes.
 *
 * HOW IT WORKS, AND WHY THIS WAY. Both projections are computed in frontmatter
 * and both are in the DOM. No scale math ships to the client: the island swaps
 * one attribute, CSS moves the points. That keeps the component's build-time
 * character, honours the JS budget (no bundle, one tiny is:inline island), and
 * means the no-JS state is the authored projection, fully painted.
 *
 * The control renders ONLY when an axis is authored log. On a linear payload
 * this component behaves exactly as it did before — there is nothing to toggle.
 *
 * Points translate between projections (that motion IS the comprehension);
 * gridlines, ticks, fit lines and point labels are per-projection layers that
 * cross-fade, because each projection runs its own label placement and
 * de-clutter pass and can legitimately drop a different label.
 *
 * The fit line always paints fully drawn, points fully shown, axes in the
 * authored projection (static since Lens Phase 5). Reduced-motion keeps the
 * toggle working — it is comprehension, not decoration — and only drops the
 * tween.
 *
 * data: { points[]{ x, y, label? }, xLabel?, yLabel?, logX?, logY?, fit?,
 *         howToRead?, caption?, source?, annotations? }
 */
import VizCard from '../../core/VizCard.astro';

interface Point { x: number; y: number; label?: string; }
interface Annotation {
  at: string | number;
  text: string;
  side?: 'above' | 'below' | 'left' | 'right';
  series?: string;
}
interface Props {
  points: Point[];
  xLabel?: string;
  yLabel?: string;
  logX?: boolean;
  logY?: boolean;
  fit?: boolean;
  howToRead?: string;
  caption?: string;
  source?: string | { label: string; date?: string };
  annotations?: Annotation[];
}
const {
  points = [],
  xLabel,
  yLabel,
  logX = false,
  logY = false,
  fit = false,
  howToRead,
  caption,
  source,
  annotations = [],
} = Astro.props;

const W = 640, H = 340, padR = 22, padT = 22, padB = 46;
const ih = H - padT - padB;
// padL is measured from the widest y-tick label and the y title's line count
// (the gutter block below), so it is declared further down, before project().

// Domain in transformed space, padded so points don't sit on the frame.
const safeMinMax = (arr: number[]) => {
  if (!arr.length) return { lo: 0, hi: 1 };
  let lo = Math.min(...arr), hi = Math.max(...arr);
  if (lo === hi) { lo -= 0.5; hi += 0.5; }
  const pad = (hi - lo) * 0.08;
  return { lo: lo - pad, hi: hi + pad };
};

// Point labels: their size and width model. Placement is the collision pass
// inside project(): every candidate spot is a box estimated from the label's
// width, and a spot that leaves the frame is never taken, so no label can run
// past the viewBox (the 2026-09-23 failure the old anchor clamp fixed).
/* 12px since 2026-09-30 (LENS §3, the 12px floor). This chart keeps its
   640-unit coordinate width in the figure panel and on a phone (the card
   scrolls, dataviz-v2.css), so an authored 12 prints at 12px at 1280 and 375.
   It was 9, which the render gate measured as FLOOR on two issues. */
const LBL_FS = 12;           // matches .px-scale__plabel font-size
// Per-character advance of a point label, in em. Measured 2026-09-30 in
// Chrome: Instrument Sans 400 at 0.02em tracking runs 0.43 to 0.54 em a
// character ("GPT-5 Codex task (measured)" 151.7 units at 12px, "West Ham"
// the widest per character). Rounded up so the box errs wide, never narrow.
const LBL_CW = 0.55;
const lblW = (s?: string) => LBL_CW * LBL_FS * String(s ?? '').length;
const LBL_UP = 10;           // dot centre up to the baseline
const LBL_DOWN = 19;         // dot centre down to the baseline (clears the dot)
const LBL_SIDE = 10;         // dot centre out to a side label's anchor
const LBL_STACK = 15;        // one more line of offset when the first is taken
const LBL_AIR = 3;           // air kept between two labels

// A padded domain may sit below zero — harmless in log space (the values are
// exponents) but on a linear count axis it prints a negative quantity, which is
// not a thing that exists. When the raw data is non-negative, the linear floor
// is zero. Surfaced by the linear projection; the log-only render never showed it.
const floorAtZero = (
  d: { lo: number; hi: number },
  raws: number[],
  isLog: boolean,
) => (!isLog && d.lo < 0 && raws.every((v) => v >= 0) ? { lo: 0, hi: d.hi } : d);

// Gridlines — 5 ticks each axis. Tick labels show the value in the ORIGINAL
// space (un-log) so the reader sees real magnitudes; log ticks step by powers.
const TICKS = 5;
const fmtTick = (vT: number, isLog: boolean, digits = 0) => {
  const real = isLog ? Math.pow(10, vT) : vT;
  const abs = Math.abs(real);
  if (abs !== 0 && (abs >= 1e4 || abs < 1e-2)) return real.toExponential(digits).replace('e+', 'e');
  if (abs >= 1000) return Math.round(real).toLocaleString();
  return (Math.round(real * 100) / 100).toString();
};
// Format the whole tick SET, not each tick alone: one mantissa digit is plenty
// until two ticks collapse to the same string (1.07e6 and 1.47e6 both read
// "1e6"), and an axis that labels two different gridlines identically is worse
// than a noisier one. Decided per set so the clean form survives where it can.
const fmtTicks = (vTs: number[], isLog: boolean) => {
  const at = (digits: number) => vTs.map((v) => fmtTick(v, isLog, digits));
  const zero = at(0);
  return new Set(zero).size === zero.length ? zero : at(1);
};

/* ── The y gutter, measured (2026-09-30) ──────────────────────────────────
   padL used to be a fixed 60, with the y title at x=14 and the tick labels
   right-aligned at padL−8. At the 12px axis size a six-character tick
   ("114.31") starts near x=17 and touched the title's glyphs (the render
   gate's TOUCH on the squad-cost issue). So the gutter is built from what it
   holds: the title's lines from the left edge, 6 units of air, the widest
   tick label of either projection, and the 8-unit tick gap, never narrower
   than 60. Widths are Instrument Sans measured in Chrome: ticks 0.55em a
   character at 12px (0.04em tracking, tabular figures), axis titles 0.86em
   at 12px (700, capitals, 0.16em tracking). */
const TICK_CH = 12 * 0.55;               // units per tick-label character
const AXT_CHARS_PER_UNIT = 12 * 0.86;    // units per axis-title character
const AXT_LINE = 17;                     // leading between two rotated title lines (12px glyph boxes need > 15 to not touch)
const AXT_X0 = 13;                       // the outer line's baseline (cap height 8.7 + 4 air)

const yTitleLog = yLabel ? `${yLabel}${logY ? ' (log)' : ''}` : '';
const yTitleLin = yLabel ?? '';
const yTitleChars = Math.max(1, Math.floor(ih / AXT_CHARS_PER_UNIT));
const yTitleLogLines = wrapAxisTitle(yTitleLog, yTitleChars);
const yTitleLinLines = wrapAxisTitle(yTitleLin, yTitleChars);
const yTitleN = Math.max(yTitleLogLines.length, (logX || logY) ? yTitleLinLines.length : 0);

function yTickLabels(lgY: boolean): string[] {
  const txY = (v: number) => (lgY ? Math.log10(Math.max(v, 1e-9)) : v);
  const yD = floorAtZero(safeMinMax(points.map((p) => txY(p.y))), points.map((p) => p.y), lgY);
  const yAt = Array.from({ length: TICKS }, (_, i) => yD.lo + (i / (TICKS - 1)) * (yD.hi - yD.lo));
  return fmtTicks(yAt, lgY);
}
const tickLabelsAll = [...yTickLabels(logY), ...((logX || logY) ? yTickLabels(false) : [])];
const tickW = Math.max(0, ...tickLabelsAll.map((t) => t.length * TICK_CH));
const titleRight = yTitleN > 0 ? AXT_X0 + (yTitleN - 1) * AXT_LINE + 3 : 0;
const padL = Math.max(60, Math.ceil(titleRight + 6 + tickW + 8));
const iw = W - padL - padR;
// The x each rotated title line sits on: line 0 outermost, because a title
// turned −90° reads bottom to top and its next line falls to the right.
const yTitleX = (li: number) => AXT_X0 + li * AXT_LINE;

/* ── Label geometry, shared by the point labels and the annotations ───── */
interface LblBox { l: number; r: number; t: number; b: number; }
/* The box a point's own label occupies, in viewBox units, at the label's font
   size, measured advance (LBL_CW) and anchor. */
const lblBoxOf = (q: { label?: string; lx: number; ly: number; anchor: string }): LblBox => {
  const w = lblW(q.label);
  const l = q.anchor === 'start' ? q.lx : q.anchor === 'end' ? q.lx - w : q.lx - w / 2;
  return { l, r: l + w, t: q.ly - LBL_FS * 0.8, b: q.ly + LBL_FS * 0.25 };
};
const dotBox = (x: number, y: number): LblBox => ({ l: x - 6, r: x + 6, t: y - 6, b: y + 6 });
const boxesHit = (a: LblBox, b: LblBox, pad = 0) =>
  a.l < b.r + pad && a.r > b.l - pad && a.t < b.b + pad && a.b > b.t - pad;
// Where a point label may sit: right of the tick gutter, inside the viewBox,
// above the x-tick row. The empty top pad is allowed.
const L_FRAME = { l: padL + 2, r: W - 4, t: 3, b: padT + ih - 2 };
// Which label wins a collision: a lower rank places first.
const annotatedIdx = new Set<number>();
for (const a of annotations) {
  if (!a || !a.text) continue;
  const num = typeof a.at === 'number' ? a.at : Number(String(a.at).trim() || NaN);
  const i = points.findIndex(
    (p) => (p.label !== undefined && String(a.at) === p.label) || (Number.isFinite(num) && p.x === num),
  );
  if (i >= 0) annotatedIdx.add(i);
}
const yVals = points.map((p) => p.y);
const iMaxY = yVals.length ? yVals.indexOf(Math.max(...yVals)) : -1;
const iMinY = yVals.length ? yVals.indexOf(Math.min(...yVals)) : -1;
const rankOf = (i: number) =>
  (annotatedIdx.has(i) ? 0 : i === iMaxY || i === iMinY ? 1 : 2) * 10000 + i;

/* ── One projection of the data ───────────────────────────────────────────
   Everything downstream of the axis mapping — pixel positions, label
   placement, de-clutter, ticks, the least-squares fit — depends on whether an
   axis is log. So the whole pipeline is a function of (logX, logY) and we run
   it twice. Nothing is shared between the two results by reference. */
function project(lgX: boolean, lgY: boolean) {
  const txX = (v: number) => (lgX ? Math.log10(Math.max(v, 1e-9)) : v);
  const txY = (v: number) => (lgY ? Math.log10(Math.max(v, 1e-9)) : v);

  const xs = points.map((p) => txX(p.x));
  const ys = points.map((p) => txY(p.y));
  const xD = floorAtZero(safeMinMax(xs), points.map((p) => p.x), lgX);
  const yD = floorAtZero(safeMinMax(ys), points.map((p) => p.y), lgY);

  // Transformed value → pixel.
  const px = (vT: number) => padL + ((vT - xD.lo) / (xD.hi - xD.lo)) * iw;
  const py = (vT: number) => padT + (1 - (vT - yD.lo) / (yD.hi - yD.lo)) * ih;

  const plotted = points.map((p, i) => ({
    ...p, i,
    cx: px(txX(p.x)),
    cy: py(txY(p.y)),
    lx: 0, ly: 0,
    anchor: 'middle' as 'start' | 'middle' | 'end',
    showLabel: false,
  }));

  /* Collision-aware label placement (2026-09-30). Each label tries, in
     order: above the dot, below it, to its right, to its left, then hung off
     each of the dot's four corners, then one line further out above and
     below. The first spot that stays inside the frame and clears every dot
     and every label already placed wins. A label with no clean spot is
     DROPPED: its dot stays. Labels place most important first (a point an
     annotation names, then the highest and lowest values, then authored
     order), so the least important is the one that yields; its dot keeps
     the name as a <title>. Runs per projection: linear crowds points the
     log axis had spread out. The x-tick row sits 19 below the plot so its
     first label clears the lowest y tick in the corner. */
  const dots = plotted.map((q) => dotBox(q.cx, q.cy));
  const order = [...plotted].sort((a, b) => rankOf(a.i) - rankOf(b.i));
  const taken: LblBox[] = [];
  for (const q of order) {
    if (!q.label) continue;
    const up = q.cy - LBL_UP, dn = q.cy + LBL_DOWN, mid = q.cy + LBL_FS * 0.35;
    const cands: Array<[number, number, 'start' | 'middle' | 'end']> = [
      [q.cx, up, 'middle'], [q.cx, dn, 'middle'],
      [q.cx + LBL_SIDE, mid, 'start'], [q.cx - LBL_SIDE, mid, 'end'],
      [q.cx - 4, up, 'start'], [q.cx + 4, up, 'end'],
      [q.cx - 4, dn, 'start'], [q.cx + 4, dn, 'end'],
      [q.cx, up - LBL_STACK, 'middle'], [q.cx, dn + LBL_STACK, 'middle'],
    ];
    for (const [lx, ly, anchor] of cands) {
      const b = lblBoxOf({ label: q.label, lx, ly, anchor });
      if (b.l < L_FRAME.l || b.r > L_FRAME.r || b.t < L_FRAME.t || b.b > L_FRAME.b) continue;
      if (dots.some((d) => boxesHit(b, d))) continue;
      if (taken.some((t) => boxesHit(b, t, LBL_AIR))) continue;
      q.lx = lx; q.ly = ly; q.anchor = anchor; q.showLabel = true;
      taken.push(b);
      break;
    }
  }

  const xAt = Array.from({ length: TICKS }, (_, i) => xD.lo + (i / (TICKS - 1)) * (xD.hi - xD.lo));
  const yAt = Array.from({ length: TICKS }, (_, i) => yD.lo + (i / (TICKS - 1)) * (yD.hi - yD.lo));
  const xLbls = fmtTicks(xAt, lgX);
  const yLbls = fmtTicks(yAt, lgY);
  const xTicks = xAt.map((vT, i) => ({ x: px(vT), label: xLbls[i] }));
  const yTicks = yAt.map((vT, i) => ({ y: py(vT), label: yLbls[i] }));

  // Least-squares fit in transformed space → a straight line across the domain.
  let fitLine: { x1: number; y1: number; x2: number; y2: number } | null = null;
  if (fit && points.length >= 2) {
    const N = xs.length;
    const sx = xs.reduce((a, b) => a + b, 0);
    const sy = ys.reduce((a, b) => a + b, 0);
    const sxx = xs.reduce((a, b) => a + b * b, 0);
    const sxy = xs.reduce((a, b, i) => a + b * ys[i], 0);
    const denom = N * sxx - sx * sx;
    if (Math.abs(denom) > 1e-12) {
      const slope = (N * sxy - sx * sy) / denom;
      const intercept = (sy - slope * sx) / N;
      const yAt = (vT: number) => slope * vT + intercept;
      fitLine = {
        x1: px(xD.lo), y1: py(yAt(xD.lo)),
        x2: px(xD.hi), y2: py(yAt(xD.hi)),
      };
    }
  }
  const fitLen = fitLine
    ? Math.hypot(fitLine.x2 - fitLine.x1, fitLine.y2 - fitLine.y1).toFixed(0)
    : '0';

  return { plotted, xTicks, yTicks, fitLine, fitLen };
}

// A = the authored projection (what no-JS and first paint show).
// B = the all-linear alternate. Built only when there is a log axis to undo.
const isLogged = logX || logY;
const A = project(logX, logY);
const B = isLogged ? project(false, false) : null;
const layers = B ? [{ p: A, k: 'a' }, { p: B, k: 'b' }] : [{ p: A, k: 'a' }];

/* ── the annotation layer (docs/design/blueprints/_ANNOTATIONS.md) ──────────
   `at` matches a point's `label` exactly, or its raw `x` value; a non-match is
   a silent no-op. There is no `series` here — a scatter has one.

   BOTH projections get a callout, each inside the same `px-scale__lyr--a/--b`
   group the existing island cross-fades, so the note follows the active scale
   with zero new JS and zero new state. Default side is `right`: the point's own
   label already owns the space directly above the dot. Geometry only — no
   motion of its own beyond the layer cross-fade it rides. */
const A_FS = 12;     // SVG units — this chart runs at natural scale (dataviz-v2.css)
const A_LH = 15;     // leading between the two wrapped lines
const A_LEAD = 16;   // leader length (spec §3: 14–22)
const A_GAP = 5;     // clearance between the marker dot and the leader
const A_CLEAR = 3;   // air kept between a note and any label, dot or other note
// Where a note's TEXT may sit: inside the viewBox (spec §3), clear of the
// y-tick gutter on the left and of the x-tick row below the plot. The empty
// top pad is allowed, so a note beside a dot at the very top can rise above
// its own point label instead of printing on it.
const F_L = padL + 2, F_R = W - 4, F_T = 4, F_B = padT + ih - 2;
const aEst = (s: string) => 0.52 * A_FS * s.length;
// Two lines once the estimate passes 40% of the viewBox, split at the nearest
// space past the midpoint.
const aWrap = (s: string): string[] => {
  if (aEst(s) <= W * 0.4) return [s];
  const past = s.indexOf(' ', Math.floor(s.length / 2));
  const cut = past >= 0 ? past : s.lastIndexOf(' ');
  return cut < 0 ? [s] : [s.slice(0, cut), s.slice(cut + 1)];
};

type Side = 'above' | 'below' | 'left' | 'right';
interface PlacedAnnot {
  lines: string[]; cx: number; cy: number;
  x1: number; y1: number; x2: number; y2: number;
  tx: number; ty: number; anchor: 'start' | 'middle' | 'end';
}
const overlapArea = (a: LblBox, b: LblBox, pad = 0) =>
  Math.max(0, Math.min(a.r, b.r + pad) - Math.max(a.l, b.l - pad)) *
  Math.max(0, Math.min(a.b, b.b + pad) - Math.max(a.t, b.t - pad));
// Does the segment (x1,y1)→(x2,y2) cross the box? Liang–Barsky clip.
function segHits(x1: number, y1: number, x2: number, y2: number, bx: LblBox): boolean {
  const dx = x2 - x1, dy = y2 - y1;
  let t0 = 0, t1 = 1;
  const edges: Array<[number, number]> = [[-dx, x1 - bx.l], [dx, bx.r - x1], [-dy, y1 - bx.t], [dy, bx.b - y1]];
  for (const [pp, qq] of edges) {
    if (pp === 0) { if (qq < 0) return false; continue; }
    const r = qq / pp;
    if (pp < 0) { if (r > t1) return false; if (r > t0) t0 = r; }
    else { if (r < t0) return false; if (r < t1) t1 = r; }
  }
  return true;
}
const OPPOSITE: Record<Side, Side> = { above: 'below', below: 'above', left: 'right', right: 'left' };
const ACROSS: Record<Side, Side[]> = {
  left: ['below', 'above'], right: ['below', 'above'], above: ['right', 'left'], below: ['right', 'left'],
};

/* Place one note. `side` is a hint (spec §1), so every side is a candidate, in
   the order hint → its opposite → the two across it. A side note may also
   slide up or down its dot (the leader angles to follow), and an above/below
   note may hang centred, left or right of it, on a longer leader. The
   cheapest candidate — by that order, then by how far it moved — that keeps
   its text inside the frame, its text off every label, dot and earlier note,
   and its leader off every label and every other dot, wins.

   Why the search, and why the point's OWN label is an obstacle: the old
   placement asked only whether the text stayed inside the plot, then nudged
   it off OTHER points' labels. On the tech desk the one measured point sits
   high on the right edge, so its label flips below the dot, "right" mirrors
   to "left", and the note printed straight over its own point's name
   ("GPT-5 Codex task (measured)", measured 2026-09-23 at both widths).

   If nothing is clean, the in-frame candidate with the least overlap wins; a
   legible overlap beats a callout off-canvas. */
function placeAnnot(
  cx: number,
  cy: number,
  hint: Side,
  lines: string[],
  labels: LblBox[],
  dots: Array<{ x: number; y: number }>,
): PlacedAnnot & { box: LblBox } {
  const wEst = Math.max(...lines.map(aEst));
  const blockH = (lines.length - 1) * A_LH;
  const others = dots.filter((d) => Math.abs(d.x - cx) > 0.5 || Math.abs(d.y - cy) > 0.5);
  const textObstacles = [...labels, ...dots.map((d) => dotBox(d.x, d.y))];
  const leadObstacles = [...labels, ...others.map((d) => dotBox(d.x, d.y))];

  const textBox = (tx: number, ty: number, anchor: 'start' | 'middle' | 'end'): LblBox => {
    const l = anchor === 'start' ? tx : anchor === 'end' ? tx - wEst : tx - wEst / 2;
    return { l, r: l + wEst, t: ty - A_FS * 0.8, b: ty + blockH + A_FS * 0.25 };
  };

  type Cand = PlacedAnnot & { box: LblBox; cost: number };
  const cands: Cand[] = [];
  [hint, OPPOSITE[hint], ...ACROSS[hint]].forEach((side, rank) => {
    if (side === 'left' || side === 'right') {
      const dir = side === 'right' ? 1 : -1;
      const anchor = dir > 0 ? 'start' : 'end';
      for (let k = 0; k <= 30; k++) {
        const off = (k % 2 ? -1 : 1) * Math.ceil(k / 2) * 2;   // 0, −2, +2, −4, +4 … ±30
        const x2 = cx + dir * (A_GAP + A_LEAD), y2 = cy + off;
        const len = Math.hypot(x2 - cx, y2 - cy);
        const x1 = cx + ((x2 - cx) / len) * A_GAP, y1 = cy + ((y2 - cy) / len) * A_GAP;
        const tx = x2 + dir * 3;
        const ty = cy + off + A_FS * 0.34 - blockH / 2;
        cands.push({ lines, cx, cy, x1, y1, x2, y2, tx, ty, anchor, box: textBox(tx, ty, anchor), cost: rank * 30 + Math.abs(off) });
      }
    } else {
      const dir = side === 'above' ? -1 : 1;
      for (const extra of [0, 6]) {
        const y1 = cy + dir * A_GAP, y2 = cy + dir * (A_GAP + A_LEAD + extra);
        const ty = side === 'above' ? y2 - 4 - blockH : y2 + 4 + A_FS;
        (['middle', 'end', 'start'] as const).forEach((anchor, ai) => {
          cands.push({ lines, cx, cy, x1: cx, y1, x2: cx, y2, tx: cx, ty, anchor, box: textBox(cx, ty, anchor), cost: rank * 30 + extra + ai * 4 });
        });
      }
    }
  });

  const inFrame = (b: LblBox) => b.l >= F_L && b.r <= F_R && b.t >= F_T && b.b <= F_B;
  const clean = (c: Cand) =>
    inFrame(c.box) &&
    !textObstacles.some((o) => boxesHit(c.box, o, A_CLEAR)) &&
    !leadObstacles.some((o) => segHits(c.x1, c.y1, c.x2, c.y2, o));
  cands.sort((a, b) => a.cost - b.cost);
  const best =
    cands.find(clean) ??
    cands
      .filter((c) => inFrame(c.box))
      .map((c) => ({ c, o: textObstacles.reduce((s, o) => s + overlapArea(c.box, o, A_CLEAR), 0) }))
      .sort((a, b) => a.o - b.o || a.c.cost - b.c.cost)[0]?.c ??
    cands[0];
  const { cost: _cost, ...placed } = best;
  return placed;
}

const annotAt: Array<{ i: number; lines: string[]; side: Side }> = [];
for (const a of annotations) {
  if (!a || !a.text) continue;
  const num = typeof a.at === 'number' ? a.at : Number(String(a.at).trim() || NaN);
  const i = points.findIndex(
    (p) => (p.label !== undefined && String(a.at) === p.label) || (Number.isFinite(num) && p.x === num),
  );
  if (i < 0) continue;
  annotAt.push({ i, lines: aWrap(a.text), side: a.side || 'right' });
}
/* Per projection, the obstacles for each note are: every VISIBLE label in that
   projection (the annotated point's own included), every dot, and every note
   already placed. */
const annotLayers = layers.map(({ p, k }) => {
  const labels = p.plotted.filter((q) => q.label && q.showLabel).map(lblBoxOf);
  const dots = p.plotted.map((q) => ({ x: q.cx, y: q.cy }));
  const done: LblBox[] = [];
  const items = annotAt.map((a) => {
    const placed = placeAnnot(p.plotted[a.i].cx, p.plotted[a.i].cy, a.side, a.lines, [...labels, ...done], dots);
    done.push(placed.box);
    return placed;
  });
  return { k, items };
});

/* ── The readout (px-inst contract part 05) ───────────────────────────────
   Derived from the data, never authored beside the chart: a readout that can
   disagree with the marks eventually will. It states the span the log axis is
   compressing, and then how much of the axis the remaining points actually
   occupy once it is undone. Both are measurements, not adjectives. */
const nPts = points.length;
const logAxisWord = logX && logY ? 'both axes' : logX ? 'x-axis' : 'y-axis';
const logVals = logX ? points.map((p) => p.x) : points.map((p) => p.y);
const vMin = logVals.length ? Math.min(...logVals) : 0;
const vMax = logVals.length ? Math.max(...logVals) : 0;
const ratio = vMin > 0 && vMax > vMin ? vMax / vMin : null;
const fmtRatio = (r: number) =>
  r >= 100 ? Math.round(r).toLocaleString() : (Math.round(r * 10) / 10).toString();

// How much of the logged axis the non-extreme points share, in the LINEAR
// projection — i.e. the compression the reader is about to see.
function compressionPct(): number | null {
  if (!B || nPts < 3) return null;
  const coords = logX ? B.plotted.map((p) => p.cx) : B.plotted.map((p) => p.cy);
  const axisLen = logX ? iw : ih;
  const idxMax = logVals.indexOf(vMax);
  const rest = coords.filter((_, i) => i !== idxMax);
  if (rest.length < 2) return null;
  const span = Math.max(...rest) - Math.min(...rest);
  return Math.max(1, Math.round((span / axisLen) * 100));
}
const comp = compressionPct();

const readLog =
  `Log ${logAxisWord} · equal steps are equal multiples` +
  (ratio ? `. Top value is ${fmtRatio(ratio)}× the bottom.` : '.');
const readLinear = comp
  ? `Linear ${logAxisWord} · the other ${nPts - 1} points share ${comp}% of it. That compression is what the log scale was holding open.`
  : `Linear ${logAxisWord} · true proportions, no scale compression.`;

// The longest string this readout can ever show. Rendered as the hidden twin
// that `px-inst__readout--sized` stacks behind the live line, so the box
// reserves the true height and the card cannot jump when the mode changes —
// measured at 375px, the linear line runs a row longer than the log one and
// shifted the source line 17px. See the rule in src/styles/dataviz-v2.css.
const longestReadout = readLinear.length >= readLog.length ? readLinear : readLog;

// Axis titles carry the "(log)" suffix, so they change with the mode. Only the
// logged axis gets swap strings; the island falls back to the rendered text.
const xTitleLog = xLabel ? `${xLabel}${logX ? ' (log)' : ''}` : '';
const xTitleLin = xLabel ?? '';

/* ── axis-title wrapping (AGENTS.md, 2026-09-22: an outward SVG label wraps
   or is budgeted in characters against the gutter it is drawn into) ──────
   The y title runs the inner-height gutter (rotated -90°, up padT..padT+ih);
   the x title runs the inner-width gutter (padL..padL+iw). Same font both
   ways (the 12px eyebrow cut at 0.16em tracking), so the same per-character
   estimate, AXT_CHARS_PER_UNIT in the gutter block above, sizes both
   budgets against a different span. The y title's lines are wrapped up
   there, because the gutter's width depends on how many there are. */
const xTitleChars = Math.max(1, Math.floor(iw / AXT_CHARS_PER_UNIT));

// Greedy word-wrap into AT MOST TWO lines, never breaking a word (a single
// word longer than `max` is kept whole on its own line). Anything left over
// after two lines is dropped, with a single ellipsis on the second line.
function wrapAxisTitle(s: string, max: number): string[] {
  if (!s) return [];
  const words = s.split(' ').filter(Boolean);
  const lines: string[] = [];
  let cur = '';
  let i = 0;
  while (i < words.length) {
    const w = words[i];
    const next = cur ? `${cur} ${w}` : w;
    if (!cur || next.length <= max) {
      cur = next;
      i++;
    } else {
      lines.push(cur);
      cur = '';
      if (lines.length === 2) break;
    }
  }
  if (cur && lines.length < 2) lines.push(cur);
  if (i < words.length) {
    const budget = Math.max(0, max - 1);
    const last = (lines[lines.length - 1] ?? '').slice(0, budget).replace(/\s+$/, '');
    lines[lines.length - 1] = `${last}…`;
  }
  return lines;
}

// The x-axis title never wraps — one line, ellipsis-truncated if it would
// overrun the plot width.
const truncateAxisTitle = (s: string, max: number): string =>
  s.length <= max ? s : `${s.slice(0, Math.max(0, max - 1)).replace(/\s+$/, '')}…`;

const xTitleLogText = truncateAxisTitle(xTitleLog, xTitleChars);
const xTitleLinText = truncateAxisTitle(xTitleLin, xTitleChars);
---

<VizCard
  prefix="px-scale"
  howToRead={howToRead}
  caption={caption}
  source={source}
  chip={yLabel}
>
  <div
    class="px-scale__box"
    data-scale-plot
    data-scale="log"
    data-read-log={readLog}
    data-read-linear={readLinear}
  >
    <svg
      class="px-scale__svg"
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={caption ? `Scaling plot: ${caption}` : 'Scaling scatter plot'}
    >
      {/* gridlines + axis ticks — one layer per projection, cross-faded */}
      {layers.map(({ p, k }) => (
        <g class:list={['px-scale__grid', 'px-scale__lyr', `px-scale__lyr--${k}`]}>
          {p.yTicks.map((t) => (
            <g>
              <line x1={padL} y1={t.y} x2={W - padR} y2={t.y} stroke="var(--rule)" />
              <text class="px-scale__tick" x={padL - 8} y={t.y + 3} text-anchor="end">{t.label}</text>
            </g>
          ))}
          {p.xTicks.map((t) => (
            <g>
              <line x1={t.x} y1={padT} x2={t.x} y2={padT + ih} stroke="var(--rule)" opacity="0.55" />
              <text class="px-scale__tick" x={t.x} y={padT + ih + 19} text-anchor="middle">{t.label}</text>
            </g>
          ))}
        </g>
      ))}

      {/* fit line (under the points) — refitted per projection */}
      {layers.map(({ p, k }) => (
        p.fitLine && (
          <line
            class:list={['px-scale__fit', 'px-scale__lyr', `px-scale__lyr--${k}`]}
            x1={p.fitLine.x1.toFixed(1)} y1={p.fitLine.y1.toFixed(1)}
            x2={p.fitLine.x2.toFixed(1)} y2={p.fitLine.y2.toFixed(1)}
            style={`--len:${p.fitLen}`}
          />
        )
      ))}

      {/* points — ONE set, translated between projections. That motion is the
          argument the toggle exists to make, so it is never a cross-fade. */}
      <g class="px-scale__pts">
        {A.plotted.map((p) => (
          <g
            class="px-scale__pt"
            style={`--x:${p.cx.toFixed(1)}px; --y:${p.cy.toFixed(1)}px; --x2:${(B ? B.plotted[p.i].cx : p.cx).toFixed(1)}px; --y2:${(B ? B.plotted[p.i].cy : p.cy).toFixed(1)}px`}
          >
            <g class="px-scale__pop" style={`transition-delay:${600 + p.i * 60}ms`}>
              <circle cx="0" cy="0" r="5">{p.label && <title>{p.label}</title>}</circle>
            </g>
          </g>
        ))}
      </g>

      {/* point labels — own layer per projection: placement, anchor AND which
          labels survive de-clutter all differ once the axis changes */}
      {layers.map(({ p, k }) => (
        <g class:list={['px-scale__lbls', 'px-scale__lyr', `px-scale__lyr--${k}`]}>
          {p.plotted.map((q) => (
            q.label && q.showLabel && (
              <text class="px-scale__plabel" x={q.lx.toFixed(1)} y={q.ly.toFixed(1)} text-anchor={q.anchor}>{q.label}</text>
            )
          ))}
        </g>
      ))}

      {/* axis titles — budgeted in characters against their gutter (see the
          wrap block in frontmatter). The x title stays on the original
          data-axt text-swap (one line, never overruns iw); the y title
          renders as one wrapped stack per projection layer, cross-faded by
          the same .px-scale__lyr--a/--b rule the ticks/points/labels use
          above, so the log⇄linear swap needs no extra client JS. */}
      {xLabel && (
        <text
          class="px-scale__axis-title"
          x={padL + iw / 2} y={H - 6} text-anchor="middle"
          data-axt data-axt-log={xTitleLogText} data-axt-linear={xTitleLinText}
        >{xTitleLogText}</text>
      )}
      {yLabel && layers.map(({ k }) => {
        const lines = k === 'a' ? yTitleLogLines : yTitleLinLines;
        const cy = padT + ih / 2;
        return (
          <g class:list={['px-scale__ytitle', 'px-scale__lyr', `px-scale__lyr--${k}`]}>
            {lines.map((ln, li) => {
              const x = yTitleX(li);
              return (
                <text
                  class="px-scale__axis-title"
                  x={x} y={cy} text-anchor="middle"
                  transform={`rotate(-90 ${x} ${cy})`}
                >{ln}</text>
              );
            })}
          </g>
        );
      })}

      {/* annotations — one set per projection, inside the layer groups the
          toggle already cross-fades, so the callout follows the active scale */}
      {annotAt.length > 0 && annotLayers.map(({ k, items }) => (
        <g class:list={['px-scale__annots', 'px-scale__lyr', `px-scale__lyr--${k}`]}>
          {items.map((a) => (
            <g class="px-scale__annot">
              <circle class="px-scale__annot-dot" cx={a.cx.toFixed(1)} cy={a.cy.toFixed(1)} r="3" />
              <line class="px-scale__annot-lead" x1={a.x1.toFixed(1)} y1={a.y1.toFixed(1)} x2={a.x2.toFixed(1)} y2={a.y2.toFixed(1)} />
              <text
                class="px-scale__annot-t" x={a.tx.toFixed(1)} y={a.ty.toFixed(1)} text-anchor={a.anchor}
                style="font-family:'Newsreader',Georgia,'Times New Roman',serif"
              >{a.lines.map((ln, li) => <tspan x={a.tx.toFixed(1)} dy={li === 0 ? 0 : A_LH}>{ln}</tspan>)}</text>
            </g>
          ))}
        </g>
      ))}
    </svg>

    {isLogged && (
      <div class="px-scale__ctl px-inst__controls" role="group" aria-label="Axis scale">
        <button type="button" class="px-inst__chip" data-scale-set="log" aria-pressed="true">Log</button>
        <button type="button" class="px-inst__chip" data-scale-set="linear" aria-pressed="false">Linear</button>
      </div>
    )}
    {isLogged && (
      <p class="px-scale__readout px-inst__readout px-inst__readout--sized">
        <span data-scale-readout aria-live="polite">{readLog}</span>
        <span class="px-inst__sizer" aria-hidden="true">{longestReadout}</span>
      </p>
    )}
  </div>
</VizCard>

<script is:inline>
  (function () {
    if (!document.documentElement.classList.contains('js')) return;
    document.querySelectorAll('[data-scale-plot]').forEach(function (box) {
      var chips = Array.prototype.slice.call(box.querySelectorAll('[data-scale-set]'));
      if (!chips.length) return;
      var out = box.querySelector('[data-scale-readout]');
      var titles = Array.prototype.slice.call(box.querySelectorAll('[data-axt]'));

      function paint(mode) {
        box.setAttribute('data-scale', mode);
        chips.forEach(function (c) {
          c.setAttribute('aria-pressed', c.getAttribute('data-scale-set') === mode ? 'true' : 'false');
        });
        if (out) out.textContent = box.getAttribute('data-read-' + mode) || out.textContent;
        titles.forEach(function (t) {
          var v = t.getAttribute('data-axt-' + mode);
          if (v !== null) t.textContent = v;
        });
      }

      chips.forEach(function (c) {
        c.addEventListener('click', function () { paint(c.getAttribute('data-scale-set')); });
      });
    });
  })();
</script>

<style>
  .px-scale__box { width: 100%; }
  .px-scale__svg { width: 100%; height: auto; display: block; overflow: visible; }

  .px-scale__tick {
    /* axis ticks — mono muted, system axis scale + letter-spacing, tabular */
    font-family: var(--font-mono);
    font-size: var(--viz-fs-axis, 9.5px);
    letter-spacing: 0.04em;
    fill: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .px-scale__axis-title {
    /* axis title — mono uppercase, ink-soft, eyebrow letter-spacing */
    font-family: var(--font-mono);
    font-size: var(--viz-fs-eyebrow, 10px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--ink-soft);
    font-weight: 700;
  }

  /* ── projection layers ──────────────────────────────────────────────────
     --a is the authored projection and paints by default, so the no-JS state
     is the authored one. --b sits at opacity 0 until the toggle asks for it. */
  .px-scale__lyr { transition: opacity var(--t-soft) var(--ease); }
  .px-scale__lyr--b { opacity: 0; }
  .px-scale__box[data-scale='linear'] .px-scale__lyr--a { opacity: 0; }
  .px-scale__box[data-scale='linear'] .px-scale__lyr--b { opacity: 1; }

  .px-scale__fit {
    fill: none;
    stroke: var(--accent-deep, var(--accent));
    stroke-width: 2;
    stroke-dasharray: var(--len);
    stroke-dashoffset: 0;
    /* carries the layer cross-fade too: `transition` is one property, so the
       shared .px-scale__lyr rule above would otherwise be overwritten here */
    transition: stroke-dashoffset 1300ms var(--ease), opacity var(--t-soft) var(--ease);
  }

  .px-scale__pt circle {
    fill: var(--accent);
    stroke: var(--paper);
    stroke-width: 1.5;
  }
  .px-scale__plabel {
    /* point label — Instrument Sans, ink-soft, tabular (point names often
       carry magnitudes). 12px, and it must equal LBL_FS: the placement pass
       in project() sizes every label's box from it. The chart renders at its
       coordinate width everywhere (the card scrolls), so 12 is 12. */
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    fill: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    /* faint paper halo so a label crossing a gridline / dot stays legible */
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 2.5px;
    stroke-linejoin: round;
  }

  /* ── annotations (docs/design/blueprints/_ANNOTATIONS.md) ────────────────
     The literal font stack is on the element (RD-01b); everything else is
     here. No transition of its own — it rides the layer cross-fade above. */
  .px-scale__annot-dot { fill: var(--accent); }
  .px-scale__annot-lead { stroke: var(--rule); stroke-width: 1; }
  .px-scale__annot-t {
    font-size: 12px;
    font-style: italic;
    fill: var(--ink);
    /* paper halo: the note crosses gridlines and the fit line */
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 2.5px;
    stroke-linejoin: round;
  }

  /* position: the dot travels between projections (the comprehension payload) */
  .px-scale__pt {
    transform: translate(var(--x), var(--y));
    transition: transform var(--t-soft) var(--ease);
  }
  .px-scale__box[data-scale='linear'] .px-scale__pt {
    transform: translate(var(--x2), var(--y2));
  }

  /* the point group rests shown; its transition lives on an inner group so it never fights the
     positional transform above */
  .px-scale__pop {
    opacity: 1;
    transform: none;
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity var(--t-quick) var(--ease), transform var(--t-soft) var(--ease-snap);
  }

  /* controls are inert without JS, so they never render without it */
  .px-scale__ctl { display: none; }
  html.js .px-scale__ctl { display: flex; }

  /* Mobile legibility (closed 2026-09-30). This SVG no longer scales down on
     a phone: the min-width block in dataviz-v2.css keeps it at its 640-unit
     coordinate width and the card scrolls sideways, in the figure panel too.
     So the authored sizes are the rendered sizes: point labels 12, ticks and
     titles at the 12px viz scale, and the y gutter measured to hold them
     (the gutter block in frontmatter). */

  @media (prefers-reduced-motion: reduce) {
    /* the toggle still switches — it is comprehension. Only the tween goes. */
    .px-scale__lyr, .px-scale__pt { transition: none; }
  }
</style>
