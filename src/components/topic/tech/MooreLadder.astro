---
/**
 * MooreLadder (tech) — a dated count series on a base-2 log axis, where an
 * exponential law straightens into a climb, with the least-squares
 * doubling-time fit drawn through it. Every rung up the ruler is ×2, the
 * ladder of the title. Build-time SVG + regression; zero JS.
 *
 * LENS PHASE 6 (2026-09-30, the board Lib-moore-ladder): REDRAWN FOR THE
 * FIGURE PANEL, a 460-unit viewBox with 12px text (no sideways scroll at
 * 1280; on a phone it keeps 460 and scrolls in its card, the standing
 * min-width rule in dataviz-v2.css). The figure's one large number is the
 * doubling time the fit computes ("2.1 years to double"), never authored.
 * The y title sits above the plot beside the honesty chips (`log₂ scale`
 * always, `fit: start–end` when `fitRange` scopes the claim). Point labels
 * are placed off each other and off the dots, the highlighted chip's label
 * carries its count, and hover changes nothing (it used to grow the dot).
 * The legend is one disclosure, "All n chips", the table a screen reader and
 * a no-JS reader both get.
 *
 * Cue anchors:
 *   1..n   each chip (a dot and its label), numbered from 1 in data order.
 *   fit    the fitted doubling line.
 *   axis   the rungs and the tick labels.
 *   head   the large number (the doubling time).
 *
 * THE BUILD (LENS §6.4): the card is the scene. 1 the rungs fade in, 2 the
 * dots drop in data order, 3 the fit line draws, 4 the labels and the
 * callout fade in, 5 the doubling time counts up (src/scripts/build.ts). No
 * JS or reduced motion: the ladder as drawn.
 *
 * data: { points[]{ year, count, label, highlight? }, yLabel?, unit?, fit?,
 *         fitRange?, caption?, source? }  — see blueprint tech/moore-ladder.md
 */
import { renderInline } from '../../../lib/text';

interface LadderPoint {
  year: number;
  count: number;
  label: string;
  highlight?: true;
}
interface Props {
  points: LadderPoint[];
  yLabel?: string;
  unit?: string;
  fit?: boolean;
  fitRange?: [number, number];
  caption?: string;
  source?: string;
}
const {
  points = [],
  yLabel = 'transistors per chip',
  unit = '',
  fit = true,
  fitRange,
  caption,
  source, // accepted, never printed: core/Section.astro prints the source line
} = Astro.props;

// ── Build-time guard (blueprint §3: ≥6 points) ──────────────────────────────
if (points.length < 6) {
  throw new Error(
    `MooreLadder needs ≥6 points to earn a log axis (got ${points.length}). ` +
      `A log scale on a narrow range is a lie — use scaling-plot instead.`,
  );
}

const FONT = "font-family:'Instrument Sans','Helvetica Neue',Arial,sans-serif";

// ── Geometry: the panel's coordinate system ─────────────────────────────────
const VB_W = 460, VB_H = 300;
const X0 = 44, X1 = 446, W_plot = X1 - X0;
const Y0 = 12, Y1 = 262, H_plot = Y1 - Y0;

const log2 = (v: number) => Math.log(v) / Math.LN2;
const years = points.map((p) => p.year);
const counts = points.map((p) => p.count);
const yMin = Math.min(...years);
const yMax = Math.max(...years);
const Yvals = counts.map(log2);
const Ylo = Math.floor(Math.min(...Yvals)) - 1;
const Yhi = Math.ceil(Math.max(...Yvals)) + 1;

const xOf = (yr: number) => X0 + 8 + ((yr - yMin) / (yMax - yMin)) * (W_plot - 16);
const yOfY = (Y: number) => Y1 - ((Y - Ylo) / (Yhi - Ylo)) * H_plot;
const yOf = (c: number) => yOfY(log2(c));

// ── Least-squares doubling fit (blueprint §4, physics §7) ───────────────────
const fitPts = fitRange
  ? points.filter((p) => p.year >= fitRange[0] && p.year <= fitRange[1])
  : points;
let m = 0, b = 0, doubling = '';
let fitLine: { x1: number; y1: number; x2: number; y2: number } | null = null;
if (fit && fitPts.length >= 2) {
  const xs = fitPts.map((p) => p.year);
  const Ys = fitPts.map((p) => log2(p.count));
  const n = xs.length;
  const xbar = xs.reduce((a, v) => a + v, 0) / n;
  const Ybar = Ys.reduce((a, v) => a + v, 0) / n;
  let sxy = 0, sxx = 0;
  for (let i = 0; i < n; i++) {
    sxy += (xs[i] - xbar) * (Ys[i] - Ybar);
    sxx += (xs[i] - xbar) * (xs[i] - xbar);
  }
  m = sxy / sxx;
  b = Ybar - m * xbar;
  doubling = (1 / m).toFixed(1);
  const fx1 = Math.min(...xs), fx2 = Math.max(...xs);
  fitLine = { x1: xOf(fx1), y1: yOfY(m * fx1 + b), x2: xOf(fx2), y2: yOfY(m * fx2 + b) };
}

// ── Number formatting ───────────────────────────────────────────────────────
const trim = (v: number) => {
  const r = Math.round(v * 10) / 10;
  return Number.isInteger(r) ? r.toFixed(0) : r.toFixed(1);
};
const compact = (n: number) => {
  if (n >= 1e12) return `${trim(n / 1e12)}T`;
  if (n >= 1e9) return `${trim(n / 1e9)}B`;
  if (n >= 1e6) return `${trim(n / 1e6)}M`;
  if (n >= 1e3) return `${trim(n / 1e3)}K`;
  return String(Math.round(n));
};
const full = (n: number) => n.toLocaleString('en-US');
const u = unit ? ` ${unit}` : '';

// ── Rungs: labelled powers of ten, faint powers of two ─────────────────────
const tenRungs: { y: number; label: string }[] = [];
for (let e = 0; e <= 15; e++) {
  const Y = log2(Math.pow(10, e));
  if (Y >= Ylo && Y <= Yhi) tenRungs.push({ y: yOfY(Y), label: compact(Math.pow(10, e)) });
}
const twoRungs: number[] = [];
for (let Y = Ylo + 1; Y < Yhi; Y++) twoRungs.push(yOfY(Y));

// ── Year ticks at decades, thinned so labels sit ≥ 40 units apart ──────────
const yearTicks: { x: number; label: string }[] = [];
for (let d = Math.ceil(yMin / 10) * 10; d <= yMax; d += 10) {
  const x = xOf(d);
  if (!yearTicks.length || x - yearTicks[yearTicks.length - 1].x >= 40) yearTicks.push({ x, label: String(d) });
}

// ── Points + label placement (off the dots, off each other, off the fit
//    callout; the highlighted chip and the ends place first) ──────────────
interface Box { l: number; r: number; t: number; b: number; }
const hit = (a: Box, c: Box, pad = 2) => a.l < c.r + pad && a.r > c.l - pad && a.t < c.b + pad && a.b > c.t - pad;
const FS = 12;
const est = (s: string, w = 0.56) => s.length * FS * w;
const n1 = points.length - 1;
const plotted = points.map((p, i) => ({
  ...p, i,
  cx: xOf(p.year), cy: yOf(p.count),
  text: p.highlight ? `${p.label} · ${compact(p.count)}${u}` : p.label,
  lx: 0, ly: 0, anchor: 'start' as 'start' | 'end' | 'middle', show: false,
  tx: 0, ty: 0,
}));
const dots: Box[] = plotted.map((q) => ({ l: q.cx - 6, r: q.cx + 6, t: q.cy - 6, b: q.cy + 6 }));
const taken: Box[] = [];
const callout = fitLine && doubling ? `doubles every ${doubling} yr` : '';
let calloutAt: { x: number; y: number; anchor: 'end' | 'start' } | null = null;
if (fitLine && callout) {
  // under the line's far end, right-aligned to it
  const w = est(callout, 0.6);
  const x = Math.min(fitLine.x2, VB_W - 2), y = Math.min(fitLine.y2 + 30, Y1 - 6);
  calloutAt = { x, y, anchor: 'end' };
  taken.push({ l: x - w, r: x, t: y - FS * 0.8, b: y + 3 });
}
const order = [...plotted].sort((a, c) => {
  const ra = a.highlight ? 0 : a.i === 0 || a.i === n1 ? 1 : 2;
  const rc = c.highlight ? 0 : c.i === 0 || c.i === n1 ? 1 : 2;
  return ra - rc || c.i - a.i;
});
for (const q of order) {
  const w = est(q.text, q.highlight ? 0.6 : 0.56);
  const cands: Array<[number, number, 'start' | 'end' | 'middle']> = [
    [q.cx + 9, q.cy + 4, 'start'], [q.cx - 9, q.cy + 4, 'end'],
    [q.cx, q.cy - 10, 'middle'], [q.cx, q.cy + 20, 'middle'],
    [q.cx - 6, q.cy - 10, 'end'], [q.cx + 6, q.cy - 10, 'start'],
  ];
  for (const [lx, ly, anchor] of cands) {
    const l = anchor === 'start' ? lx : anchor === 'end' ? lx - w : lx - w / 2;
    const box = { l, r: l + w, t: ly - FS * 0.8, b: ly + 3 };
    if (box.l < X0 + 2 || box.r > VB_W - 2 || box.t < Y0 || box.b > Y1 - 2) continue;
    if (dots.some((d, di) => di !== q.i && hit(box, d, 1)) || hit(box, dots[q.i], 0)) continue;
    if (taken.some((t) => hit(box, t))) continue;
    q.lx = lx; q.ly = ly; q.anchor = anchor; q.show = true;
    taken.push(box);
    break;
  }
}
/* The cue numeral: a free corner of the dot. */
const tagTaken: Box[] = [];
for (const q of plotted) {
  const spots: Array<[number, number]> = [[q.cx - 14, q.cy - 14], [q.cx + 14, q.cy + 14], [q.cx - 14, q.cy + 14], [q.cx + 14, q.cy - 14]];
  const bx = ([x, y]: [number, number]): Box => ({ l: x - 11, r: x + 11, t: y - 11, b: y + 11 });
  // the spot with the least overlap (labels, other numerals, other dots),
  // among those inside the plot
  const area = (a: Box, c: Box) => Math.max(0, Math.min(a.r, c.r) - Math.max(a.l, c.l)) * Math.max(0, Math.min(a.b, c.b) - Math.max(a.t, c.t));
  const score = (sp: [number, number]) => {
    const bb = bx(sp);
    if (bb.l < X0 || bb.r > VB_W || bb.t < 0 || bb.b > Y1 + 4) return Infinity;
    return [...taken, ...tagTaken, ...dots.filter((_, di) => di !== q.i)].reduce((acc, o) => acc + area(bb, o), 0);
  };
  const ok = [...spots].sort((a, c) => score(a) - score(c))[0];
  q.tx = ok[0]; q.ty = ok[1];
  tagTaken.push(bx(ok));
}
const fitTag = fitLine ? { x: (fitLine.x1 + fitLine.x2) / 2 - 14, y: (fitLine.y1 + fitLine.y2) / 2 - 14 } : null;
const pct = (v: number, of: number) => ((v / of) * 100).toFixed(2);

const fitScopeTxt = fitRange ? ` over ${fitRange[0]}–${fitRange[1]}` : '';
const ariaSummary = doubling
  ? `Log₂ growth ladder: ${points.length} chips from ${full(points[0].count)} to ` +
    `${full(points[points.length - 1].count)} ${yLabel}, doubling every ${doubling} years${fitScopeTxt}.`
  : `Log₂ growth ladder of ${points.length} chips (${yLabel}).`;
---

<div class="px-viz px-mldr" data-build-scene>
  <div class="px-viz__cap">
    {caption && <span set:html={renderInline(caption)} />}
  </div>

  {doubling && (
    <div class="px-mldr__head" data-cue="head" style={`--ch:${doubling.length}`}>
      <span class="px-cue-tag" data-cue-tag="head" hidden></span>
      <span class="px-mldr__big"><span data-build="5" data-build-kind="counter" data-to={doubling} data-format="1dp">{doubling}</span></span>
      <span class="px-mldr__biglab">years to double{fitScopeTxt}</span>
    </div>
  )}

  <div class="px-mldr__bar">
    <span class="px-mldr__ytitle">{yLabel}</span>
    <span class="px-mldr__chips">
      <span class="px-mldr__chip">log₂ scale</span>
      {fitRange && <span class="px-mldr__chip">fit {fitRange[0]}–{fitRange[1]}</span>}
    </span>
  </div>

  <div class="px-mldr__frame">
    <svg
      class="px-mldr__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={ariaSummary}
    >
      <g class="px-mldr__rungs" data-cue="axis" data-build="1">
        <g class="px-mldr__two">
          {twoRungs.map((y) => <line x1={X0} y1={y.toFixed(1)} x2={X1} y2={y.toFixed(1)} />)}
        </g>
        <g class="px-mldr__ten">
          {tenRungs.map((r) => (
            <g>
              <line x1={X0} y1={r.y.toFixed(1)} x2={X1} y2={r.y.toFixed(1)} />
              <text class="px-mldr__tick" x={X0 - 8} y={(r.y + 4).toFixed(1)} text-anchor="end" style={FONT}>{r.label}</text>
            </g>
          ))}
        </g>
        <line class="px-mldr__axis" x1={X0} y1={Y1} x2={X1} y2={Y1} />
        {yearTicks.map((t) => (
          <text class="px-mldr__tick" x={t.x.toFixed(1)} y={Y1 + 18} text-anchor="middle" style={FONT}>{t.label}</text>
        ))}
      </g>

      {fitLine && (
        <line
          class="px-mldr__fit" data-cue="fit" data-build="3" data-build-kind="draw"
          x1={fitLine.x1.toFixed(1)} y1={fitLine.y1.toFixed(1)}
          x2={fitLine.x2.toFixed(1)} y2={fitLine.y2.toFixed(1)}
        />
      )}

      {plotted.map((p) => (
        <g class:list={['px-mldr__pt', { 'is-hl': p.highlight }]} data-cue={p.i + 1}>
          <title>{`${p.label} · ${p.year} · ${full(p.count)}${u}`}</title>
          <circle class="px-mldr__dot" cx={p.cx.toFixed(1)} cy={p.cy.toFixed(1)} r={p.highlight ? 6.5 : 4.5} data-build="2" data-build-kind="drop" />
          {p.show && (
            <text class="px-mldr__plabel" x={p.lx.toFixed(1)} y={p.ly.toFixed(1)} text-anchor={p.anchor} style={FONT} data-build="4">{p.text}</text>
          )}
        </g>
      ))}

      {calloutAt && (
        <text class="px-mldr__callout" x={calloutAt.x.toFixed(1)} y={calloutAt.y.toFixed(1)} text-anchor={calloutAt.anchor} style={FONT} data-build="4">{callout}</text>
      )}
    </svg>

    {/* The cue numerals, an HTML layer over the drawing. */}
    <div class="px-mldr__tags" aria-hidden="true">
      {plotted.map((p) => (
        <span class="px-mldr__tag" style={`left:${pct(p.tx, VB_W)}%;top:${pct(p.ty, VB_H)}%`}>
          <span class="px-cue-tag" data-cue-tag={p.i + 1} hidden></span>
        </span>
      ))}
      {fitTag && (
        <span class="px-mldr__tag" style={`left:${pct(fitTag.x, VB_W)}%;top:${pct(fitTag.y, VB_H)}%`}>
          <span class="px-cue-tag" data-cue-tag="fit" hidden></span>
        </span>
      )}
      <span class="px-mldr__tag" style={`left:${pct(X0 - 22, VB_W)}%;top:${pct(Y1 + 14, VB_H)}%`}>
        <span class="px-cue-tag" data-cue-tag="axis" hidden></span>
      </span>
    </div>
  </div>

  <details class="px-mldr__disc">
    <summary>All {points.length} chips</summary>
    <ul class="px-mldr__leg-list">
      {points.map((p) => (
        <li class:list={['px-mldr__leg-row', { 'is-hl': p.highlight }]}>
          <span class="px-mldr__leg-yr">{p.year}</span>
          <span class="px-mldr__leg-name">{p.label}</span>
          <span class="px-mldr__leg-num">{full(p.count)}{u}</span>
        </li>
      ))}
    </ul>
  </details>
</div>

<style>
  /* LENS §7: the pinned figure's headline number at 96 (72 on phones),
     its label 8px below it. The size also fits the number to the panel:
     --ch is its character count, the head a size container. */
  .px-mldr__head {
    container-type: inline-size;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    row-gap: 8px;
    align-items: center;
    margin-bottom: 20px;
  }
  .px-mldr__head > .px-cue-tag { grid-column: 1; grid-row: 1; margin: 0 8px 0 0; }
  .px-mldr__big { grid-column: 2; grid-row: 1; justify-self: start; white-space: nowrap; }
  .px-mldr__biglab { grid-column: 2; grid-row: 2; justify-self: start; }
  .px-mldr__big {
    font-family: var(--font-ui);
    font-size: min(96px, calc((100cqi - 28px) / var(--ch, 4) / 0.62));
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-deep);
  }
  .px-mldr__biglab {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .px-mldr__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    margin-bottom: 6px;
  }
  .px-mldr__ytitle {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .px-mldr__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .px-mldr__chip {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--paper-3);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-2);
  }

  .px-mldr__frame { position: relative; width: 100%; }
  .px-mldr__svg { width: 100%; height: auto; display: block; overflow: visible; }

  .px-mldr__two line { stroke: var(--hair); stroke-width: 1; opacity: 0.6; }
  .px-mldr__ten line { stroke: var(--hair-2); stroke-width: 1; }
  .px-mldr__axis { stroke: var(--hair-2); stroke-width: 1.25; }
  .px-mldr__tick { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }

  .px-mldr__dot { fill: var(--accent); stroke: var(--paper-2); stroke-width: 1.5; }
  .px-mldr__pt.is-hl .px-mldr__dot { fill: var(--accent-deep); }
  .px-mldr__plabel {
    font-size: 12px;
    fill: var(--ink-2);
    font-variant-numeric: tabular-nums;
    paint-order: stroke;
    stroke: var(--paper-2);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .px-mldr__pt.is-hl .px-mldr__plabel { fill: var(--ink); font-weight: 600; }

  .px-mldr__fit { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .px-mldr__callout {
    font-size: 12px;
    font-weight: 500;
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--paper-2);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .px-mldr__tags { position: absolute; inset: 0; pointer-events: none; }
  .px-mldr__tag { position: absolute; width: 0; height: 0; }
  .px-mldr__tag .px-cue-tag { position: absolute; left: 0; top: 0; translate: -50% -50%; margin: 0; }

  .px-mldr__disc { margin-top: 12px; }
  .px-mldr__disc summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-deep);
  }
  .px-mldr__leg-list { list-style: none; margin: 0; padding: 0; }
  .px-mldr__leg-row {
    display: grid;
    grid-template-columns: 3.4em minmax(0, 1fr) auto;
    gap: 10px;
    align-items: baseline;
    padding: 4px 0;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    border-bottom: 1px solid var(--hair);
  }
  .px-mldr__leg-name { color: var(--ink-2); min-width: 0; }
  .px-mldr__leg-row.is-hl .px-mldr__leg-name { color: var(--ink); font-weight: 600; }
  .px-mldr__leg-num { text-align: right; }
  @media (max-width: 640px) {
    .px-mldr__big { font-size: min(72px, calc((100cqi - 28px) / var(--ch, 4) / 0.62)); }
  }
  /* Phones: the drawing keeps its 460 units and the card scrolls (the
     min-width rule in dataviz-v2.css). The min-width sits on this box, not
     only on the SVG, so the HTML numeral layer, placed by % of this box,
     stays on the drawing it labels. */
  @media (max-width: 900px) {
    .px-mldr__frame { min-width: 460px; }
  }
</style>
