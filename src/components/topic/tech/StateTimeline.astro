---
/**
 * StateTimeline (`state-timeline`) — one lane per service across a single
 * window, coloured by discrete health state, with the incident timeline pinned
 * beneath it. The reader learns how long the failure was visible in the data
 * before it was visible to anyone.
 *
 * Blueprint: docs/design/blueprints/tech/state-timeline.md
 * Pure HTML/CSS + one marker-select island. Prefix `px-stl`.
 *
 * LENS PHASE 6 (2026-09-30, the board Lib-state-timeline): the figure's one
 * large number is the lag the chart exists to show, derived (the first
 * fault to the first event after it: "4h 06m"). Healthy is a pale green that
 * recedes, degraded amber, down red (the fixed encoding, redrawn for the
 * paper). Each event's hour runs as a dashed rule down through the lanes; the
 * event markers are small numbered SQUARES (a cue is a round disc). The events
 * are a compact list; the two tables moved into an "All the numbers"
 * disclosure. 12px floor throughout, Instrument Sans.
 *
 * Cue anchors:
 *   1..n     each service lane, numbered from 1 in data order.
 *   m1..mK   each event, by its own `n`: the rule, the marker and the row.
 *   legend   the state key.
 *   head     the large number.
 *
 * THE BUILD (LENS §6.4): the scene is the figure above the marker lane, NOT
 * the card (the markers become 44px controls under JS, which a scene must not
 * hold). 1 the key, the head row and the service names fade in, 2 the tracks
 * grow from the left, 80ms apart, 4 the uptimes rise, 5 the large number
 * rises (src/scripts/build.ts). The event rules do not build (they are
 * display:none on a phone, where the markers carry the hours). No JS or
 * reduced motion: the lanes as drawn, the first-alert event selected.
 */
import VizCard from '../../core/VizCard.astro';

interface StateDef { id: string; label: string; ok?: boolean }
interface Segment { from: number; to: number; state: string }
interface Lane { label: string; segments: Segment[] }
interface Mark { n: number; atHour: number; label: string; note?: string }
interface Props {
  window?: { fromHour: number; toHour: number };
  states?: StateDef[];
  lanes?: Lane[];
  marks?: Mark[];
  caption?: string;
  source?: string | { label: string; date?: string };
}

const {
  // Destructured away from `window` so the frontmatter never shadows the DOM
  // global's type in a file that also ships a browser island.
  window: win = { fromHour: 0, toHour: 24 },
  states = [],
  lanes = [],
  marks = [],
  caption,
  source,
} = Astro.props;

/* ── Build-time validation (blueprint §3) ──────────────────────────────────
   A gap or an overlap in a lane reads as "no data", and this chart has no such
   state — so a payload that does not tile must not render at all. Every throw
   names the lane (or the state, or the marker) so the build error points at the
   line of MDX that has to change. */
const EPS = 1e-6;
const span = win.toHour - win.fromHour;
if (!(span > 0)) {
  throw new Error(
    `[state-timeline] the window must run forwards: got fromHour ${win.fromHour} → toHour ${win.toHour}.`,
  );
}

// Colour here is categorical, so a legend is mandatory and there is no sensible
// default key to invent. Three is also the ceiling, because the health ramp is
// three FIXED hexes (§6) rather than a scale that can be extended.
if (states.length < 2 || states.length > 3) {
  throw new Error(
    `[state-timeline] needs 2–3 states, best first, got ${states.length}. See blueprint §3/§6.`,
  );
}
const byId = new Map<string, StateDef & { i: number }>();
states.forEach((s, i) => {
  if (byId.has(s.id)) throw new Error(`[state-timeline] duplicate state id "${s.id}".`);
  byId.set(s.id, { ...s, i });
});
if (!states.some((s) => s.ok)) {
  throw new Error(
    '[state-timeline] at least one state must carry `ok: true` — per-lane uptime is DERIVED from those flags, and without one every lane would report 0%.',
  );
}

if (lanes.length < 3 || lanes.length > 8) {
  throw new Error(`[state-timeline] needs 3–8 lanes, got ${lanes.length}. See blueprint §2/§10.`);
}

for (const lane of lanes) {
  const segs = lane.segments ?? [];
  if (segs.length < 1 || segs.length > 12) {
    throw new Error(
      `[state-timeline] lane "${lane.label}" has ${segs.length} segments; the budget is 1–12 (blueprint §10).`,
    );
  }
  segs.forEach((sg, i) => {
    if (!byId.has(sg.state)) {
      throw new Error(
        `[state-timeline] lane "${lane.label}" segment ${i + 1} uses state "${sg.state}", which is not declared in \`states\`.`,
      );
    }
    if (!(sg.to - sg.from > EPS)) {
      throw new Error(
        `[state-timeline] lane "${lane.label}" segment ${i + 1} does not move forwards (${sg.from} → ${sg.to}).`,
      );
    }
    const expected = i === 0 ? win.fromHour : segs[i - 1].to;
    if (Math.abs(sg.from - expected) > EPS) {
      const fault =
        i === 0 ? 'must start at the window' : sg.from > expected ? 'leaves a gap' : 'overlaps the segment before it';
      throw new Error(
        `[state-timeline] lane "${lane.label}" ${fault}: segment ${i + 1} starts at ${sg.from}, expected ${expected}. Segments must tile the window exactly.`,
      );
    }
  });
  const last = segs[segs.length - 1];
  if (Math.abs(last.to - win.toHour) > EPS) {
    throw new Error(
      `[state-timeline] lane "${lane.label}" ends at ${last.to}, not at the window's ${win.toHour}. Segments must tile the window exactly.`,
    );
  }
}

// 8 is where 15px circles stop fitting on a phone-width track even after the
// stagger below has used every row it can without the marker lane taking over
// the card.
if (marks.length > 8) {
  throw new Error(`[state-timeline] ${marks.length} markers; the cap is 8 (blueprint §10).`);
}
const seenN = new Set<number>();
for (const m of marks) {
  if (!Number.isInteger(m.n) || m.n < 1) {
    throw new Error(`[state-timeline] marker "${m.label}" needs a positive whole \`n\`, got ${m.n}.`);
  }
  if (seenN.has(m.n)) throw new Error(`[state-timeline] duplicate marker number ${m.n} ("${m.label}").`);
  seenN.add(m.n);
  if (m.atHour < win.fromHour - EPS || m.atHour > win.toHour + EPS) {
    throw new Error(
      `[state-timeline] marker ${m.n} ("${m.label}") sits at ${m.atHour}, outside the window ${win.fromHour}–${win.toHour}.`,
    );
  }
}

/* ── Derivation ────────────────────────────────────────────────────────────
   Uptime, the state totals, the onset and the default marker are all computed
   from the segments. Nothing here may be authored: an authored figure can
   disagree with the lane it claims to summarise, and the gap between the onset
   and the first alert IS the argument this chart exists to make. */
const okIds = new Set(states.filter((s) => s.ok).map((s) => s.id));
const okLabel = states.find((s) => s.ok)!.label;
const pos = (h: number) => ((h - win.fromHour) / span) * 100;

// 13.6 → "13:36". Fractional hours are the authoring unit; clock time is the
// reading unit, and the reader should never have to convert.
const clock = (h: number) => {
  const t = Math.round(h * 60);
  return `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;
};
const dur = (h: number) => {
  const t = Math.round(h * 60);
  const hh = Math.floor(t / 60);
  return hh ? `${hh}h ${String(t % 60).padStart(2, '0')}m` : `${t % 60}m`;
};

// Two states means healthy/down, not healthy/degraded — with a two-step ramp it
// is the amber middle that goes unused, never the red end.
const ci = (i: number) => (states.length === 2 ? [0, 2][i] : i);

const laneRows = lanes.map((lane) => {
  const perState = states.map((s) => ({
    label: s.label,
    hours: lane.segments.filter((g) => g.state === s.id).reduce((a, g) => a + (g.to - g.from), 0),
  }));
  const okHours = lane.segments.reduce((a, g) => a + (okIds.has(g.state) ? g.to - g.from : 0), 0);
  const uptime = (okHours / span) * 100;
  const firstBad = lane.segments.find((g) => !okIds.has(g.state));
  return {
    label: lane.label,
    perState,
    uptime,
    band: uptime >= 96 ? 'ok' : uptime >= 90 ? 'warn' : 'bad',
    leftOk: firstBad ? clock(firstBad.from) : null,
    segments: lane.segments.map((g, i) => ({
      width: ((g.to - g.from) / span) * 100,
      ci: ci(byId.get(g.state)!.i),
      last: i === lane.segments.length - 1,
    })),
  };
});

/* Marker stagger. Two marks closer than MIN_GAP_PCT of the window cannot both
   wear a 15px circle on the ~270px track a 375px card gives, so the later one
   drops to the next row and its stalk lengthens to keep pointing at its true
   hour. 6% ≈ 16px there — one circle plus a hair. Resolved at BUILD time, so
   the geometry is identical with and without JS, and the acceptance line "no
   label collision at 375px" holds on the static render. */
const MIN_GAP_PCT = 6;
const rowOf = new Map<number, number>();
const rowLast: number[] = [];
[...marks]
  .sort((a, b) => a.atHour - b.atHour)
  .forEach((m) => {
    const p = pos(m.atHour);
    let r = 0;
    while (r < rowLast.length && p - rowLast[r] < MIN_GAP_PCT) r++;
    rowLast[r] = p;
    rowOf.set(m.n, r);
  });
const markRows = Math.max(1, rowLast.length);

// Rendered — and therefore tabbed — in `n` order, positioned by the hour.
const markList = [...marks]
  .sort((a, b) => a.n - b.n)
  .map((m) => ({ ...m, row: rowOf.get(m.n) ?? 0, left: pos(m.atHour), time: clock(m.atHour) }));

// The earliest moment ANY lane left an ok state. Segments are ordered, so the
// first non-ok segment of a lane is that lane's onset.
let onset = Infinity;
for (const lane of lanes) {
  const bad = lane.segments.find((g) => !okIds.has(g.state));
  if (bad) onset = Math.min(onset, bad.from);
}

/* Composed still (§5) = "the first alert": the earliest event that lands AFTER
   something had already gone wrong. Derived rather than authored for the same
   reason uptime is — and because the distance between `onset` and this marker
   is the claim the caption makes. */
let defaultIdx = markList.findIndex((m) => m.atHour > onset + EPS);
if (defaultIdx < 0) defaultIdx = markList.length - 1;
if (defaultIdx < 0) defaultIdx = 0;
const d = markList[defaultIdx];

const axis = [0, 1, 2, 3, 4].map((i) => clock(win.fromHour + (span * i) / 4));

/* The figure's one large number: how long the first fault ran before the
   composed-still event (the first one after it). Derived, never authored. */
const lag = Number.isFinite(onset) && markList.length && d.atHour > onset ? d.atHour - onset : null;
const lagParts = lag != null ? { h: Math.floor(Math.round(lag * 60) / 60), m: Math.round(lag * 60) % 60 } : null;

/* DECLARED NON-THEMEABLE ENCODING (blueprint §6, a fixed data encoding).
   Lens Phase 6 re-drew the three on the one paper: healthy is a pale green
   that recedes, so the failures are what the eye finds; degraded an amber and
   down a red, both dark enough to read as marks on paper. The hexes appear
   exactly ONCE, here; every paint site downstream is a var(). The encoding
   never carries meaning by colour alone: the key names all three and the
   readout says the state in words. */
const PALETTE = '--stl-s0:#D7E2BF;--stl-s1:#C97C22;--stl-s2:#A02D18';
---

<VizCard prefix="px-stl" caption={caption} source={source} style={PALETTE}>
  <div class="px-stl__fig" data-build-scene>
    {lagParts && (
      <div class="px-stl__head1" data-cue="head" style={`--ch:${lagParts ? (lagParts.h > 0 ? String(lagParts.h).length + 3.6 : 2.6) : 4}`}>
        <span class="px-cue-tag" data-cue-tag="head" hidden></span>
        <span class="px-stl__big" data-build="5" data-build-kind="rise">{lagParts.h > 0 && <>{lagParts.h}<small>h</small> </>}{String(lagParts.m).padStart(lagParts.h > 0 ? 2 : 1, '0')}<small>m</small></span>
        <span class="px-stl__biglab">from the first fault to “{d.label}”</span>
      </div>
    )}

    <div class="px-stl__legend" data-cue="legend" data-build="1">
      {states.map((s, i) => (
        <span class="px-stl__key">
          <span class="px-stl__sw" style={`--fill:var(--stl-s${ci(i)})`} aria-hidden="true"></span>
          <span class="px-stl__keylab">{s.label}</span>
        </span>
      ))}
    </div>

    {/* The lane grid is a picture of the table in the disclosure below; the
        table is the screen reader's path (blueprint §7). */}
    <div class="px-stl__lanes" aria-hidden="true">
      <div class="px-stl__head" data-build="1">
        <span>Service</span><span></span><span>Uptime</span>
      </div>
      <div class="px-stl__body">
        {laneRows.map((r, li) => (
          <div class="px-stl__lane" data-cue={li + 1}>
            <span class="px-stl__lab" data-build="1"><span class="px-cue-tag" data-cue-tag={li + 1} hidden></span>{r.label}</span>
            <span class="px-stl__track" data-build="2" data-build-kind="grow-x">
              {r.segments.map((g) => (
                <span
                  class="px-stl__seg"
                  data-last={g.last ? 'true' : 'false'}
                  style={`width:${g.width.toFixed(4)}%;--seg:var(--stl-s${g.ci})`}
                ></span>
              ))}
            </span>
            <span class="px-stl__up" data-band={r.band} data-build="4" data-build-kind="rise">{r.uptime.toFixed(1)}%</span>
          </div>
        ))}
        {/* each event's hour, drawn down through the lanes */}
        <div class="px-stl__guides">
          {markList.map((m) => (
            <span class="px-stl__guide" data-cue={`m${m.n}`} style={`left:${m.left.toFixed(4)}%`}></span>
          ))}
        </div>
      </div>
    </div>
  </div>

  {markList.length > 0 && (
    <div class="px-stl__marks">
      <div class="px-stl__markbox" style={`--rows:${markRows}`}>
        {markList.map((m, i) => (
          <span
            class="px-stl__mark"
            data-cue={`m${m.n}`}
            data-stl-mark={i}
            data-stl-n={m.n}
            data-stl-label={m.label}
            data-stl-time={m.time}
            data-stl-note={m.note ?? ''}
            data-selected={i === defaultIdx ? 'true' : 'false'}
            style={`left:${m.left.toFixed(4)}%;--row:${m.row}`}
          >
            <span class="px-stl__stalk" aria-hidden="true"></span>
            <span class="px-stl__num">{m.n}</span>
          </span>
        ))}
      </div>
    </div>
  )}

  <div class="px-stl__axis" aria-hidden="true">
    <div class="px-stl__ticks">{axis.map((t) => <span>{t}</span>)}</div>
  </div>

  {markList.length > 0 && (
    <p class="px-stl__readout" data-stl-readout aria-live="polite">
      <span data-stl-out-label>{d.label}</span>{', '}<b
        class="px-stl__clock"
        data-stl-out-time>{d.time}</b>{'. '}<span data-stl-out-note>{d.note ?? ''}</span>
    </p>
  )}

  {/* The events, in clock time: the rows mirror the markers (44px targets). */}
  {markList.length > 0 && (
    <ol class="px-stl__events">
      {markList.map((m, i) => (
        <li class="px-stl__ev" data-cue={`m${m.n}`} data-stl-row={i} data-selected={i === defaultIdx ? 'true' : 'false'}>
          <span class="px-stl__evn">{m.n}</span>
          <span class="px-stl__evt"><span class="px-cue-tag" data-cue-tag={`m${m.n}`} hidden></span>{m.time}</span>
          <span class="px-stl__evl">{m.label}</span>
        </li>
      ))}
    </ol>
  )}

  {/* The numbers, for a screen reader and anyone who wants them: time in each
      state per service, and what happened at each event. */}
  <details class="px-stl__more">
    <summary>All the numbers</summary>
    <table class="px-stl__table">
      <caption class="px-stl__tcap">
        Time in each state, and when each service left {okLabel.toLowerCase()}
      </caption>
      <thead>
        <tr>
          <th scope="col">Service</th>
          {states.map((s) => <th scope="col">{s.label}</th>)}
          <th scope="col">Left {okLabel.toLowerCase()}</th>
          <th scope="col">Uptime</th>
        </tr>
      </thead>
      <tbody>
        {laneRows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            {r.perState.map((p) => <td>{dur(p.hours)}</td>)}
            <td>{r.leftOk ?? '—'}</td>
            <td data-band={r.band}>{r.uptime.toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
    {markList.length > 0 && (
      <table class="px-stl__table" data-ev>
        <caption class="px-stl__tcap">The incident timeline, in clock time</caption>
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Clock</th>
            <th scope="col">Event</th>
            <th scope="col">What happened</th>
          </tr>
        </thead>
        <tbody>
          {markList.map((m) => (
            <tr>
              <th scope="row">{m.n}</th>
              <td>{m.time}</td>
              <td>{m.label}</td>
              <td class="px-stl__note">{m.note ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </details>
</VizCard>

<script is:inline>
  (function () {
    if (!document.documentElement.classList.contains('js')) return;
    document.querySelectorAll('.px-stl').forEach(function (card) {
      var marks = Array.prototype.slice.call(card.querySelectorAll('[data-stl-mark]'));
      var rows = Array.prototype.slice.call(card.querySelectorAll('[data-stl-row]'));
      var out = card.querySelector('[data-stl-readout]');
      if (!marks.length || !out) return;
      var oL = out.querySelector('[data-stl-out-label]');
      var oT = out.querySelector('[data-stl-out-time]');
      var oN = out.querySelector('[data-stl-out-note]');
      var def = 0;
      marks.forEach(function (m, n) { if (m.getAttribute('data-selected') === 'true') def = n; });
      var cur = def;

      function paint(i) {
        cur = i;
        marks.forEach(function (m, n) {
          m.setAttribute('data-selected', n === i ? 'true' : 'false');
          m.setAttribute('aria-pressed', n === i ? 'true' : 'false');
        });
        rows.forEach(function (r, n) { r.setAttribute('data-selected', n === i ? 'true' : 'false'); });
        oL.textContent = marks[i].getAttribute('data-stl-label') || '';
        oT.textContent = marks[i].getAttribute('data-stl-time') || '';
        oN.textContent = marks[i].getAttribute('data-stl-note') || '';
      }

      // The markers become operable ONLY here, so a no-JS reader is never
      // shown an affordance that does nothing; everything a press reveals is
      // in the "All the numbers" disclosure.
      marks.forEach(function (m, n) {
        m.setAttribute('role', 'button');
        m.setAttribute('tabindex', '0');
        m.setAttribute('aria-pressed', n === def ? 'true' : 'false');
        m.setAttribute(
          'aria-label',
          'Event ' + m.getAttribute('data-stl-n') + ': ' + m.getAttribute('data-stl-label') +
            ', ' + m.getAttribute('data-stl-time'),
        );
        m.classList.add('is-operable');
        m.addEventListener('click', function () { paint(n); });
        m.addEventListener('keydown', function (e) {
          var k = e.key;
          if (k === 'Enter' || k === ' ' || k === 'Spacebar') { e.preventDefault(); paint(n); }
          else if (k === 'Escape') { paint(def); marks[def].focus(); }
          else if (k === 'ArrowRight' || k === 'ArrowLeft') {
            var t = n + (k === 'ArrowRight' ? 1 : -1);
            if (t >= 0 && t < marks.length) { e.preventDefault(); paint(t); marks[t].focus(); }
          }
        });
      });
      // The event rows mirror the markers for pointer users (44px targets).
      rows.forEach(function (r, n) {
        r.classList.add('is-operable');
        r.addEventListener('click', function () { if (n !== cur) paint(n); });
      });
    });
  })();
</script>

<style>
  /* LENS §7: the pinned figure's headline number at 96 (72 on phones),
     its label 8px below it. The size also fits the number to the panel:
     --ch is its character count, the head a size container. */
  .px-stl__head1 {
    container-type: inline-size;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    row-gap: 8px;
    align-items: center;
    margin-bottom: 20px;
  }
  .px-stl__head1 > .px-cue-tag { grid-column: 1; grid-row: 1; margin: 0 8px 0 0; }
  .px-stl__big { grid-column: 2; grid-row: 1; justify-self: start; white-space: nowrap; }
  .px-stl__biglab { grid-column: 2; grid-row: 2; justify-self: start; }
  .px-stl__big {
    font-family: var(--font-ui);
    font-size: min(96px, calc((100cqi - 28px) / var(--ch, 4) / 0.62));
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-deep);
  }
  .px-stl__big small { font-size: 0.5em; font-weight: 600; margin-left: 2px; }
  .px-stl__biglab { font-family: var(--font-ui); font-size: 13px; font-weight: 500; color: var(--ink-2); }

  /* ── key (mandatory: the encoding is categorical) ────────────────────── */
  .px-stl__legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0 0 14px; }
  .px-stl__key { display: inline-flex; align-items: center; gap: 6px; }
  .px-stl__sw { width: 12px; height: 12px; border-radius: 2px; background: var(--fill); }
  .px-stl__keylab { font-family: var(--font-ui); font-size: 13px; color: var(--ink-2); }

  /* ── lanes ───────────────────────────────────────────────────────────── */
  /* One template across the head, the lanes, the marker lane and the axis,
     so all four align to the same track column. */
  .px-stl__head,
  .px-stl__lane,
  .px-stl__marks,
  .px-stl__axis {
    display: grid;
    grid-template-columns: 116px 1fr 52px;
    gap: 10px;
    align-items: center;
  }
  .px-stl__body { position: relative; display: flex; flex-direction: column; gap: 6px; }
  .px-stl__head { margin-bottom: 6px; }
  .px-stl__head span {
    font-family: var(--font-ui);
    font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--muted);
  }
  .px-stl__head span:last-child { text-align: right; }

  .px-stl__lab {
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .px-stl__track { display: flex; height: 22px; background: var(--paper-3); min-width: 0; border-radius: 2px; overflow: hidden; transform-origin: left center; }
  .px-stl__seg { flex: 0 0 auto; background: var(--seg); }
  /* The last segment also grows, so sub-pixel rounding lands there instead
