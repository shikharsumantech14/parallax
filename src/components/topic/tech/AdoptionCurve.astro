---
/**
 * AdoptionCurve — a diffusion curve (.adc): share of a population over time,
 * the reported figures as dots on the line, the milestones as dashed rules
 * with their names listed under the chart. Build-time SVG, zero JS of its own.
 *
 * LENS PHASE 6 (2026-09-30, the board Lib-adoption-curve): REDRAWN FOR THE
 * FIGURE PANEL. A 460-unit viewBox with 12px text, so it prints at size in the
 * ~470px panel at 1280 and scrolls inside its card on a phone (the standing
 * min-width rule in dataviz-v2.css). The x axis is placed by VALUE, not by
 * index: three observations a day and six days apart are drawn a day and six
 * days apart. Straight segments between the reported figures, never a
 * smoothed curve (a smooth line would draw values nobody reported). A
 * milestone is a dashed rule at its x and a row in the list below, never a
 * pin at a value interpolated on the line. The large number is the point the
 * section is about: the annotated point, else the latest. The gradient area
 * went (its fixed id collided when two curves shared a page). All of the
 * kind's CSS lives here (the dataviz-v2.css block was retired in Phase 6),
 * under its own `.adc__` names; it no longer borrows ApprovalChart's `.ac__`.
 *
 * Cue anchors:
 *   1..n     each reported figure (a dot), numbered from 1 in data order.
 *   line     the curve.
 *   m1..mK   each milestone: its rule on the chart and its row below.
 *   axis     the grid and the tick labels.
 *   head     the large number.
 *
 * THE BUILD (LENS §6.4): the card is the scene. 1 the axis fades in, 2 the
 * line draws, 3 the dots drop and the milestone rules fade in, 4 the notes
 * and the milestone list, 5 the large number counts up (src/scripts/build.ts).
 * No JS or reduced motion: the chart as drawn.
 *
 * props:
 *   points[]     — { year: number, pct: number }  (0–100)
 *   milestones[] — { year: number, label: string, pct? }
 *   yLabel       — the quantity (e.g. "% of new car sales")
 *   annotations  — the callout layer (docs/design/blueprints/_ANNOTATIONS.md)
 *   caption, source
 */
interface CurvePoint { year: number; pct: number; }
interface Milestone  { year: number; label: string; pct?: number; }
/* The annotation layer — 0–3 per chart, optional; absent ⇒ nothing renders.
   `series` is accepted for contract parity; this chart draws one curve. */
interface Annotation {
  at: string | number;
  text: string;
  side?: 'above' | 'below' | 'left' | 'right';
  series?: string;
}
interface Props {
  points: CurvePoint[];
  milestones?: Milestone[];
  annotations?: Annotation[];
  yLabel?: string;
  caption?: string;
  source?: string;
}
const {
  points = [],
  milestones = [],
  annotations = [],
  yLabel = '% Adoption',
  caption,
} = Astro.props;

const FONT = "font-family:'Instrument Sans','Helvetica Neue',Arial,sans-serif";
const W = 460, H = 260, padL = 34, padR = 16, padT = 14, padB = 30;
const iw = W - padL - padR, ih = H - padT - padB;
const n = points.length;
const years = points.map((p) => p.year);
const x0 = n ? Math.min(...years, ...milestones.map((m) => m.year)) : 0;
const x1 = n ? Math.max(...years, ...milestones.map((m) => m.year)) : 1;
const xOf = (yr: number) => padL + (x1 > x0 ? (yr - x0) / (x1 - x0) : 0.5) * iw;
const y = (v: number) => padT + (1 - Math.max(0, Math.min(100, v)) / 100) * ih;

const line = points.map((p, i) => `${i ? 'L' : 'M'}${xOf(p.year).toFixed(1)} ${y(p.pct).toFixed(1)}`).join(' ');
const idxForYear = (yr: number) => points.findIndex((p) => p.year === yr);

/* X ticks: every reported x when they fit 40 units apart, else a thinned set
   that always keeps the first and the last. Four-digit years print whole. */
const tickEvery = (() => {
  for (let k = 1; k <= n; k++) {
    const idx = points.map((_, i) => i).filter((i) => i % k === 0 || i === n - 1);
    const xs = idx.map((i) => xOf(points[i].year));
    if (xs.every((v, j) => j === 0 || v - xs[j - 1] >= 40)) return idx;
    // the last may crowd its neighbour: drop the neighbour instead
    const trimmed = idx.filter((i, j) => j === idx.length - 1 || j === 0 || xOf(points[idx[idx.length - 1]].year) - xOf(points[i].year) >= 40);
    const tx = trimmed.map((i) => xOf(points[i].year));
    if (tx.every((v, j) => j === 0 || v - tx[j - 1] >= 40)) return trimmed;
  }
  return n ? [0, n - 1] : [];
})();

// ── Annotations ─────────────────────────────────────────────────────────────
// `at` is the x value: a point's `year` (number, or the numeric string a YAML
// author may quote) or a milestone's `label`, resolved to that milestone's
// year. Anything that matches no point is a silent no-op (spec §2).
const FS   = 13;   // SVG units, Newsreader italic
const LEAD = 18;   // leader length in units (spec: 14–22)
const LH   = FS + 3;
const estW = (s: string) => 0.5 * FS * s.length;
const annotIdx = (at: string | number): number => {
  if (typeof at === 'number') return idxForYear(at);
  const s = String(at ?? '').trim();
  if (!s) return -1;
  if (Number.isFinite(Number(s))) {
    const i = idxForYear(Number(s));
    if (i >= 0) return i;
  }
  const m = milestones.find((ms) => ms.label === s);
  return m ? idxForYear(m.year) : -1;
};
// Wrap to lines of at most ~46% of the width, at most three.
const wrapAnnot = (t: string): string[] => {
  const max = Math.floor((W * 0.46) / (0.5 * FS));
  const out: string[] = [];
  let cur = '';
  for (const w of t.split(' ')) {
    const next = cur ? `${cur} ${w}` : w;
    if (next.length > max && cur) { out.push(cur); cur = w; } else cur = next;
  }
  if (cur) out.push(cur);
  return out.slice(0, 3);
};
interface Box { l: number; r: number; t: number; b: number; }
const hit = (a: Box, b: Box, pad = 2) => a.l < b.r + pad && a.r > b.l - pad && a.t < b.b + pad && a.b > b.t - pad;
interface PlacedAnnot {
  px: number; py: number; lines: string[];
  lead: { x1: number; y1: number; x2: number; y2: number };
  tx: number; ty: number; anchor: 'start' | 'middle' | 'end';
}
const dotBoxes: Box[] = points.map((p) => ({ l: xOf(p.year) - 6, r: xOf(p.year) + 6, t: y(p.pct) - 6, b: y(p.pct) + 6 }));
// The curve itself is an obstacle: small boxes every 8 units along it.
const lineBoxes: Box[] = [];
for (let i = 1; i < n; i++) {
  const ax = xOf(points[i - 1].year), ay = y(points[i - 1].pct), bx = xOf(points[i].year), by = y(points[i].pct);
  const steps = Math.max(1, Math.ceil(Math.hypot(bx - ax, by - ay) / 8));
  for (let k = 0; k <= steps; k++) {
    const cx = ax + ((bx - ax) * k) / steps, cy = ay + ((by - ay) * k) / steps;
    lineBoxes.push({ l: cx - 2, r: cx + 2, t: cy - 2, b: cy + 2 });
  }
}
const placedBoxes: Box[] = [];
const clear = (b: Box) => !dotBoxes.some((d) => hit(b, d)) && !lineBoxes.some((d) => hit(b, d, 1)) && !placedBoxes.some((o) => hit(b, o));
const FLOOR = padT + ih - 2;
const annots: PlacedAnnot[] = (annotations ?? [])   // `annotations:` with no items parses as null
  .map((a): PlacedAnnot | null => {
    if (!a || !a.text) return null;
    const i = annotIdx(a.at);
    if (i < 0) return null;
    const px = xOf(points[i].year), py = y(points[i].pct);
    const lines = wrapAnnot(a.text);
    const blockH = (lines.length - 1) * LH;
    const wMax = Math.max(...lines.map(estW));
    const hint = a.side ?? 'above';
    const order = [hint, 'below', 'above', 'left', 'right'].filter((s, k, arr) => arr.indexOf(s) === k);
    let best: (PlacedAnnot & { box: Box }) | null = null;
    for (const side of order) {
      for (const extra of [0, 14, 30, 50, 70, 90, 110, 130]) {
        const L = LEAD + extra;
        const lead = side === 'above' ? { x1: px, y1: py - 5, x2: px, y2: py - L }
          : side === 'below'          ? { x1: px, y1: py + 5, x2: px, y2: py + L }
          : side === 'left'           ? { x1: px - 5, y1: py, x2: px - L, y2: py }
          :                             { x1: px + 5, y1: py, x2: px + L, y2: py };
        let anchor: 'start' | 'middle' | 'end' = 'middle';
        let tx = px, ty = py;
        if (side === 'above' || side === 'below') {
          ty = side === 'above' ? py - L - 5 - blockH : py + L + FS;
          if (px + wMax / 2 > W - 2) { anchor = 'end'; tx = Math.min(px + 4, W - 2); }
          else if (px - wMax / 2 < padL) { anchor = 'start'; tx = Math.max(px - 4, padL); }
        } else {
          anchor = side === 'left' ? 'end' : 'start';
          tx = side === 'left' ? px - L - 4 : px + L + 4;
          ty = py + FS * 0.34 - blockH / 2;
        }
        const l = anchor === 'start' ? tx : anchor === 'end' ? tx - wMax : tx - wMax / 2;
        const box = { l, r: l + wMax, t: ty - FS * 0.8, b: ty + blockH + FS * 0.25 };
        const inside = box.l >= 2 && box.r <= W - 2 && box.t >= 2 && box.b <= FLOOR;
        if (!inside) continue;
        const cand = { px, py, lines, lead, tx, ty, anchor, box };
        if (!best) best = cand;
        if (clear(box)) { best = cand; break; }
      }
      if (best && clear(best.box)) break;
    }
    if (!best) return null;
    placedBoxes.push(best.box);
    const { box: _b, ...p } = best;
    return p;
  })
  .filter((a): a is PlacedAnnot => a !== null);

/* The large number: the annotated point, else the latest. */
const headIdx = (() => {
  for (const a of annotations ?? []) {
    if (!a || !a.text) continue;
    const i = annotIdx(a.at);
    if (i >= 0) return i;
  }
  return n - 1;
})();
const head = headIdx >= 0 ? points[headIdx] : undefined;
const headWhole = head ? Number.isInteger(head.pct) : true;
const headLabel = head ? (head.year >= 1000 ? `${yLabel} · ${head.year}` : yLabel) : '';

/* Numerals over the dots: the upper-left corner, which a rising curve leaves
   empty, pulled inside the drawing at the edges. */
const tagAt = (p: CurvePoint) => {
  const cx = xOf(p.year), cy = y(p.pct);
  const tx = Math.max(padL + 11, cx - 14), ty = Math.max(12, cy - 15);
  return { left: (tx / W) * 100, top: (ty / H) * 100 };
};
const msRows = milestones.map((m, k) => ({ ...m, id: `m${k + 1}`, x: xOf(m.year) }));
const fmtYear = (yr: number) => String(yr);
---

<div class="px-viz adc" data-build-scene>
  <div class="px-viz__cap"><span>{caption}</span>{yLabel && <b>{yLabel}</b>}</div>

  {head && (
    <div class="adc__head" data-cue="head" style={`--ch:${head.pct.toLocaleString('en-US', { maximumFractionDigits: 1 }).length + 1}`}>
      <span class="px-cue-tag" data-cue-tag="head" hidden></span>
      <span class="adc__big"><span data-build="5" data-build-kind="counter" data-to={head.pct} data-format={headWhole ? 'int' : '1dp'}>{head.pct.toLocaleString('en-US', { maximumFractionDigits: 1 })}</span>%</span>
      <span class="adc__biglab">{headLabel}</span>
    </div>
  )}

  <div class="adc__plot">
    <svg class="adc__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="img"
      aria-label={caption ? `Adoption curve: ${caption}` : 'Adoption curve'}>
      <g class="adc__grid" data-cue="axis" data-build="1">
        {[0, 25, 50, 75, 100].map((v) => (
          <g>
            <line x1={padL} y1={y(v)} x2={W - padR} y2={y(v)} />
            <text class="adc__axis" x={padL - 8} y={y(v) + 4} text-anchor="end" style={FONT}>{v}</text>
          </g>
        ))}
        {tickEvery.map((i, j) => (
          <text
            class="adc__axis" x={xOf(points[i].year)} y={H - 8}
            text-anchor={j === 0 && xOf(points[i].year) - padL < 16 ? 'start' : W - xOf(points[i].year) < 22 ? 'end' : 'middle'}
            style={FONT}
          >{fmtYear(points[i].year)}</text>
        ))}
      </g>

      {msRows.map((m) => (
        <g class="adc__rule" data-cue={m.id} data-build="3">
          <line x1={m.x} y1={padT} x2={m.x} y2={padT + ih} />
        </g>
      ))}

      <path class="adc__line" d={line} data-cue="line" data-build="2" data-build-kind="draw" />

      {points.map((p, i) => (
        <circle
          class="adc__dot" data-cue={i + 1} data-hl={i === headIdx ? 'true' : undefined}
          cx={xOf(p.year)} cy={y(p.pct)} r={i === headIdx ? 5.5 : 4}
          data-build="3" data-build-kind="drop"
        />
      ))}

      {annots.map((a) => (
        <g class="adc__annot" data-build="4">
          <line x1={a.lead.x1} y1={a.lead.y1} x2={a.lead.x2} y2={a.lead.y2} />
          <text
            x={a.tx} y={a.ty} text-anchor={a.anchor}
            style={`font-family:'Newsreader',Georgia,'Times New Roman',serif;font-size:${FS}px;font-style:italic`}
          >{a.lines.map((ln, k) => <tspan x={a.tx} dy={k === 0 ? 0 : LH}>{ln}</tspan>)}</text>
        </g>
      ))}
    </svg>

    {/* The cue numerals, an HTML layer over the drawing. */}
    <div class="adc__tags" aria-hidden="true">
      {points.map((p, i) => {
        const t = tagAt(p);
        return (
          <span class="adc__tag" style={`left:${t.left.toFixed(2)}%;top:${t.top.toFixed(2)}%`}>
            <span class="px-cue-tag" data-cue-tag={i + 1} hidden></span>
          </span>
        );
      })}
      <span class="adc__tag" style={`left:${((13 / W) * 100).toFixed(2)}%;top:${(((H - 12) / H) * 100).toFixed(2)}%`}>
        <span class="px-cue-tag" data-cue-tag="axis" hidden></span>
      </span>
      {n > 1 && (() => {
        const mid = Math.floor((n - 1) / 2);
        const cx = (xOf(points[mid].year) + xOf(points[mid + 1].year)) / 2;
        const cy = (y(points[mid].pct) + y(points[mid + 1].pct)) / 2;
        return (
          <span class="adc__tag" style={`left:${((Math.min(cx + 16, W - 12) / W) * 100).toFixed(2)}%;top:${((Math.min(cy + 16, padT + ih - 12) / H) * 100).toFixed(2)}%`}>
            <span class="px-cue-tag" data-cue-tag="line" hidden></span>
          </span>
        );
      })()}
    </div>
  </div>

  {msRows.length > 0 && (
    <ol class="adc__milestones" data-build="4">
      {msRows.map((m) => (
        <li class="adc__ms" data-cue={m.id}>
          <span class="adc__ms-yr"><span class="px-cue-tag" data-cue-tag={m.id} hidden></span>{fmtYear(m.year)}</span>
          <span class="adc__ms-lbl">{m.label}</span>
        </li>
      ))}
    </ol>
  )}
</div>

<style>
  /* LENS §7: the pinned figure's headline number at 96 (72 on phones),
     its label 8px below it. The size also fits the number to the panel:
     --ch is its character count, the head a size container. */
  .adc__head {
    container-type: inline-size;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    row-gap: 8px;
    align-items: center;
    margin-bottom: 20px;
  }
  .adc__head > .px-cue-tag { grid-column: 1; grid-row: 1; margin: 0 8px 0 0; }
  .adc__big { grid-column: 2; grid-row: 1; justify-self: start; white-space: nowrap; }
  .adc__biglab { grid-column: 2; grid-row: 2; justify-self: start; }
  .adc__big {
    font-family: var(--font-ui);
    font-size: min(96px, calc((100cqi - 28px) / var(--ch, 4) / 0.62));
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-deep);
  }
  .adc__biglab {
    min-width: 0;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .adc__plot { position: relative; }
  .adc__svg { width: 100%; height: auto; display: block; overflow: visible; }
  .adc__grid line { stroke: var(--hair); stroke-width: 1; }
  .adc__axis { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .adc__rule line { stroke: var(--hair-2); stroke-width: 1; stroke-dasharray: 3 4; }
  .adc__line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .adc__dot { fill: var(--accent); stroke: var(--paper-2); stroke-width: 1.5; }
  .adc__dot[data-hl] { fill: var(--accent-deep); }
  .adc__annot line { stroke: var(--hair-2); stroke-width: 1; }
  .adc__annot text {
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper-2);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .adc__tags { position: absolute; inset: 0; pointer-events: none; }
  .adc__tag { position: absolute; width: 0; height: 0; }
  .adc__tag .px-cue-tag { position: absolute; left: 0; top: 0; translate: -50% -50%; margin: 0; }

  .adc__milestones {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .adc__ms {
    display: grid;
    grid-template-columns: minmax(44px, max-content) minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding-top: 8px;
    border-top: 1px solid var(--hair);
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 1.4;
  }
  .adc__ms-yr { color: var(--accent-deep); font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .adc__ms-lbl { min-width: 0; color: var(--ink-2); }
  @media (max-width: 640px) {
    .adc__big { font-size: min(72px, calc((100cqi - 28px) / var(--ch, 4) / 0.62)); }
  }
  /* Phones: the drawing keeps its 460 units and the card scrolls (the
     min-width rule in dataviz-v2.css). The min-width sits on this box, not
     only on the SVG, so the HTML numeral layer, placed by % of this box,
     stays on the drawing it labels. */
  @media (max-width: 900px) {
    .adc__plot { min-width: 460px; }
  }
</style>
