---
/**
 * AdoptionCurve — v2 technology S-curve (.adc) inside the elevated .px-viz
 * card. The curve stroke-draws left→right on scroll, the gradient area fades
 * in behind, milestone pins pop in sequence, and a milestone strip lists the
 * key moments below. Faithful port of the publication-v2 kit <AdoptionCurve>.
 * Build-time SVG, zero runtime JS (reveal handled by CSS; core/Reveal.astro
 * toggles .is-in on the .px-viz shell). Reuses the shared .ac__grid / .ac__axis
 * classes (defined in dataviz-v2.css).
 *
 * Shows technology diffusion over time (Rogers' curve).
 *
 * props:
 *   points[]     — { year: number, pct: number }  (0–100)
 *   milestones[] — { year: number, label: string }
 *   xLabel       — x-axis label (kept for schema parity; not rendered by kit)
 *   yLabel       — caption unit chip (e.g. "% Adoption")
 *   caption
 *   source
 */
interface CurvePoint { year: number; pct: number; }
interface Milestone  { year: number; label: string; pct?: number; }
interface Props {
  points: CurvePoint[];
  milestones?: Milestone[];
  xLabel?: string;
  yLabel?: string;
  caption?: string;
  source?: string;
}
const {
  points = [],
  milestones = [],
  yLabel = '% Adoption',
  caption,
  source,
} = Astro.props;

const W = 640, H = 300, padL = 36, padR = 16, padT = 16, padB = 30;
const iw = W - padL - padR, ih = H - padT - padB;
const n = points.length;
const x = (i: number) => padL + (n > 1 ? i / (n - 1) : 0.5) * iw;
const y = (v: number) => padT + (1 - Math.max(0, Math.min(100, v)) / 100) * ih;

const line = points.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(p.pct).toFixed(1)}`).join(' ');
const area = n > 1 ? `${line} L${x(n - 1).toFixed(1)} ${padT + ih} L${padL} ${padT + ih} Z` : '';
const idxForYear = (yr: number) => points.findIndex((p) => p.year === yr);
const xShow = points.map((_, i) => i).filter((i) => i % 3 === 0 || i === n - 1);
---

<div class="px-viz" data-reveal>
  <div class="px-viz__cap"><span>{caption}</span>{yLabel && <b>{yLabel}</b>}</div>

  <svg class="adc__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="img"
    aria-label={caption ? `Adoption curve: ${caption}` : 'Technology adoption curve'}>
    <g class="ac__grid">
      {[0, 25, 50, 75, 100].map((v) => (
        <g>
          <line x1={padL} y1={y(v)} x2={W - padR} y2={y(v)} stroke="var(--rule)" />
          <text class="ac__axis" x={padL - 8} y={y(v) + 3} text-anchor="end">{v}</text>
        </g>
      ))}
    </g>
    <defs>
      <linearGradient id="adcFill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.22" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
      </linearGradient>
    </defs>
    {area && <path class="adc__area" d={area} fill="url(#adcFill)" />}
    <path class="adc__line" d={line} style="--len:1700" />
    {milestones.map((m, k) => {
      const i = idxForYear(m.year);
      if (i < 0) return null;
      const px = x(i), py = y(points[i].pct);
      return (
        <g class="adc__pin" style={`transition-delay:${900 + k * 120}ms`}>
          <circle cx={px} cy={py} r="3.5" fill="var(--accent)" stroke="var(--paper)" stroke-width="1.5" />
        </g>
      );
    })}
    {xShow.map((i) => (
      <text class="ac__axis" x={x(i)} y={H - 8} text-anchor="middle">{String(points[i].year).slice(2)}</text>
    ))}
  </svg>

  {milestones.length > 0 && (
    <div class="adc__milestones">
      {milestones.map((m) => (
        <div class="adc__ms">
          <div class="adc__ms-yr">{m.year}</div>
          <div class="adc__ms-lbl">{m.label}</div>
        </div>
      ))}
    </div>
  )}

  {source && <div class="px-viz__src">Source · {source}</div>}
</div>
