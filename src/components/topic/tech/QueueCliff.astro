---
/**
 * QueueCliff (tech) — the interactive utilization cliff. ONE slider drives the
 * offered load ρ = λ/μ; the reader watches the exact M/M/1 latency multiplier
 * `wMult(ρ) = 1/(1−ρ)` stay flat, flat, flat — and then go vertical past ρ ≈ 0.9.
 * Not a hand-drawn swoop: the plotted curve is the real formula, sampled at 200
 * steps and baked into one SVG path at build time (so no-JS shows the full law).
 * A live marker rides the curve at the current ρ with drop-lines to both axes and
 * an "operating here" area fill; a mono readout reports wait ×, absolute latency,
 * and mean queue length. The y-axis is a clipped-linear multiplier capped at
 * yCap = wMult(maxRho) — the clip is chipped, and the mandated honesty footnote
 * (M/M/1 is the optimistic case) is baked into the card, not left to the caption.
 *
 * Fallback contract: the full static curve + axes + all annotations + the marker
 * at startRho + a companion readout table paint under no-JS / reduced-motion — the
 * whole argument reads without the slider working. A tiny is:inline island (below,
 * gated by html.js) takes over the slider under JS: marker/drop-lines/area/readout
 * update 1:1 with input, no animation, only transform/attr/text writes.
 *
 * Math mirrors physics/mechanics-and-flow.md §2 (M/M/1). Blueprint:
 * docs/design/blueprints/tech/queue-cliff.md. CSS prefix: px-qc.
 *
 * data: { muPerSec | serviceMs, startRho?, maxRho?, annotations?:[{rho,label,tone?}],
 *         caption?, source? }
 */
interface Annotation { rho: number; label: string; tone?: 'ok' | 'hot'; }
interface Props {
  muPerSec?: number;
  serviceMs?: number;
  startRho?: number;
  maxRho?: number;
  annotations?: Annotation[];
  caption?: string;
  source?: string;
}
const {
  muPerSec,
  serviceMs,
  annotations = [],
  caption,
  source,
} = Astro.props;

const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

// Service rate μ (req/s). serviceMs wins if both are given (per schema).
const hasSvcMs = typeof serviceMs === 'number' && serviceMs > 0;
const hasMu = typeof muPerSec === 'number' && muPerSec > 0;
const mu = hasSvcMs
  ? 1000 / serviceMs!
  : (hasMu ? muPerSec! : 1000);
const svcMs = 1000 / mu;                        // 1/μ in ms — the ρ→0 latency floor

// Schema §3: serviceMs wins if both, with a build warning; μ is required (>0).
if (hasSvcMs && hasMu) {
  console.warn(
    `[QueueCliff] both serviceMs (${serviceMs}ms) and muPerSec (${muPerSec}) provided — serviceMs wins (μ = ${Math.round(mu)} req/s).`,
  );
}
if (!hasSvcMs && !hasMu) {
  console.warn(
    '[QueueCliff] neither serviceMs nor muPerSec provided — defaulting to μ = 1000 req/s. Provide ONE of muPerSec | serviceMs.',
  );
}

const maxRho = clamp(Astro.props.maxRho ?? 0.98, 0.90, 0.995);
const startRho = clamp(Astro.props.startRho ?? 0.5, 0, Math.min(0.99, maxRho));

// ── M/M/1 math (physics/mechanics-and-flow.md §2) ───────────────────────────
const wMult = (rho: number) => 1 / (1 - rho);   // latency multiplier vs the ρ→0 floor
const meanL = (rho: number) => rho / (1 - rho); // mean number in system
const waitMs = (rho: number) => svcMs / (1 - rho);
const yCap = wMult(maxRho);                      // y-axis clip = multiplier at maxRho

// ── SVG plot frame (viewBox 0 0 720 420) ────────────────────────────────────
const X0 = 72, XW = 624;          // plot x: 72 → 696
const YT = 40, YB = 360, YH = 320; // plot y: 40 (top) → 360 (baseline)
const xOf = (rho: number) => X0 + (rho / maxRho) * XW;
const yOf = (m: number) => clamp(YB - ((m - 1) / (yCap - 1)) * YH, YT, YB);

// ── The curve: 1/(1−ρ) sampled at 200 steps → one build-time path ───────────
const STEPS = 200;
const pts: Array<[number, number]> = [];
for (let i = 0; i <= STEPS; i++) {
  const rho = (i / STEPS) * maxRho;
  pts.push([xOf(rho), yOf(wMult(rho))]);
}
const curveD = pts
  .map(([x, y], i) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`)
  .join(' ');
// polyline length (for the sweep stroke-dash draw)
let curveLen = 0;
for (let i = 1; i < pts.length; i++) {
  curveLen += Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);
}

// ── Area under the curve, left of the marker, baked at startRho ─────────────
const areaOf = (rho: number) => {
  const N = 100;
  let d = `M ${X0} ${YB}`;
  for (let i = 0; i <= N; i++) {
    const t = (rho * i) / N;
    d += ` L ${xOf(t).toFixed(1)} ${yOf(wMult(t)).toFixed(1)}`;
  }
  d += ` L ${xOf(rho).toFixed(1)} ${YB} Z`;
  return d;
};
const startArea = areaOf(startRho);
const mx0 = xOf(startRho), my0 = yOf(wMult(startRho));

// ── Axis ticks ──────────────────────────────────────────────────────────────
const fmtMult = (m: number) => {
  const s = (Math.round(m * 10) / 10).toFixed(1);
  return s.endsWith('.0') ? s.slice(0, -2) : s;
};
const xTickRhos = [0, 0.25, 0.5, 0.7, 0.9, maxRho];
const xTicks = xTickRhos.map((r, i) => ({
  x: xOf(r),
  label: r === 0 ? '0' : (r === maxRho ? r.toFixed(2) : String(r)),
  minor: r === 0.25 || r === 0.7,          // thinned at 375px
  key: i,
}));
const yTickMults = [1, 2, wMult(0.7), 10, yCap];
const yTicks = yTickMults.map((m, i) => ({
  y: yOf(m),
  label: `${fmtMult(m)}×`,
  minor: i === 1 || i === 2,               // 2× / 3.3× thinned at 375px
  key: i,
}));

// ── Annotations pinned to the curve ─────────────────────────────────────────
const annos = annotations.slice(0, 3).map((a, i) => {
  const rho = clamp(a.rho, 0, maxRho);
  const ax = xOf(rho), ay = yOf(wMult(rho));
  const tone: 'ok' | 'hot' = a.tone ?? (rho >= 0.85 ? 'hot' : 'ok');
  // label above-right by default; flip below-left near the right/top edge so it
  // never leaves the viewBox (collision policy, blueprint §4)
  const nearRight = ax > 696 - 60;
  const nearTop = ay < YT + 60;
  const flip = nearRight || nearTop;
  const lx = flip ? ax - 9 : ax + 9;
  const ly = flip ? ay + 15 : ay - 9;
  const anchor = flip ? 'end' : 'start';
  return {
    rho, ax, ay, tone, label: a.label, lx, ly, anchor,
    wMult: wMult(rho), waitMs: waitMs(rho), meanL: meanL(rho), key: i,
  };
});

// ── Companion readout table (fallback data source, ≤5 rows) ─────────────────
const fmtMs = (w: number) => {
  const s = (Math.round(w * 10) / 10).toFixed(1);
  return s.endsWith('.0') ? s.slice(0, -2) : s;
};
const tableRows = annos.map((a) => ({
  label: a.label,
  rho: a.rho.toFixed(2),
  mult: fmtMult(a.wMult),
  ms: fmtMs(a.waitMs),
  tone: a.tone,
}));

// live readout at startRho (also the static/no-JS value)
const start = {
  rho: startRho.toFixed(2),
  mult: fmtMult(wMult(startRho)),
  ms: fmtMs(waitMs(startRho)),
  l: String(Math.round(meanL(startRho))),
};
const yCapLabel = fmtMult(yCap);

// config for the island (snap + readout labels)
const cfg = JSON.stringify({
  mu, maxRho, yCap,
  annos: annos.map((a) => ({ rho: a.rho, label: a.label })),
});
---

<div class="px-viz px-qc" data-reveal>
  {caption && (
    <div class="px-viz__cap"><span>{caption}</span><b>M/M/1</b></div>
  )}

  <div class="px-qc__ycap" aria-hidden="true">y capped at {yCapLabel}× · M/M/1</div>

  <div class="px-qc__plot">
    <svg
      class="px-qc__svg"
      viewBox="0 0 720 420"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
    >
      <!-- operating-region fill (under the curve, left of the marker) -->
      <path class="px-qc__area" d={startArea} />

      <!-- gridlines + axis frame -->
      <g class="px-qc__grid">
        {yTicks.map((t) => (
          <line x1={X0} y1={t.y.toFixed(1)} x2={X0 + XW} y2={t.y.toFixed(1)} class="px-qc__grid-line" />
        ))}
        <line x1={X0} y1={YT} x2={X0} y2={YB} class="px-qc__axis-line" />
        <line x1={X0} y1={YB} x2={X0 + XW} y2={YB} class="px-qc__axis-line" />
      </g>

      <!-- the curve: 1/(1−ρ), baked at build time -->
      <path class="px-qc__curve" d={curveD} style={`--len:${curveLen.toFixed(0)}`} />

      <!-- live marker + drop-lines (baked at startRho) -->
      <g class="px-qc__live-g">
        <line class="px-qc__drop px-qc__drop-v" x1={mx0.toFixed(1)} y1={my0.toFixed(1)} x2={mx0.toFixed(1)} y2={YB} />
        <line class="px-qc__drop px-qc__drop-h" x1={X0} y1={my0.toFixed(1)} x2={mx0.toFixed(1)} y2={my0.toFixed(1)} />
        <g class="px-qc__marker" style={`transform:translate(${mx0.toFixed(1)}px,${my0.toFixed(1)}px)`}>
          <circle r="5" />
        </g>
      </g>

      <!-- annotations -->
      <g class="px-qc__annos">
        {annos.map((a) => (
          <g class={`px-qc__anno px-qc__anno--${a.tone}`} style={`transition-delay:${a.key * 90}ms`}>
            <line class="px-qc__anno-lead" x1={a.ax.toFixed(1)} y1={a.ay.toFixed(1)} x2={a.lx.toFixed(1)} y2={a.ly.toFixed(1)} />
            <circle class="px-qc__anno-ring" cx={a.ax.toFixed(1)} cy={a.ay.toFixed(1)} r="3.5" />
            <text class="px-qc__anno-label" x={a.lx.toFixed(1)} y={a.ly.toFixed(1)} text-anchor={a.anchor}>{a.label}</text>
          </g>
        ))}
      </g>

      <!-- axis tick labels -->
      <g>
        {xTicks.map((t) => (
          <text
            class={`px-qc__tick${t.minor ? ' px-qc__tick--minor' : ''}`}
            x={t.x.toFixed(1)} y={YB + 18} text-anchor="middle"
          >{t.label}</text>
        ))}
        {yTicks.map((t) => (
          <text
            class={`px-qc__tick${t.minor ? ' px-qc__tick--minor' : ''}`}
            x={X0 - 10} y={(t.y + 3.2).toFixed(1)} text-anchor="end"
          >{t.label}</text>
        ))}
        <text class="px-qc__axis-title" x={X0 + XW / 2} y={410} text-anchor="middle">UTILIZATION ρ</text>
        <text class="px-qc__axis-title" x={16} y={YT + YH / 2} text-anchor="middle" transform={`rotate(-90 16 ${YT + YH / 2})`}>LATENCY vs IDEAL</text>
      </g>
    </svg>
  </div>

  <!-- control + live readout -->
  <div class="px-qc__panel" data-qc={cfg}>
    <div class="px-qc__readout" aria-live="polite">
      <span class="px-qc__ro px-qc__ro-rho">ρ = {start.rho}</span>
      <span class="px-qc__sep">·</span>
      <span class="px-qc__ro">wait <b class="px-qc__ro-mult">{start.mult}</b>×</span>
      <span class="px-qc__sep">·</span>
      <span class="px-qc__ro"><b class="px-qc__ro-ms">{start.ms}</b> ms</span>
      <span class="px-qc__sep">·</span>
      <span class="px-qc__ro"><b class="px-qc__ro-l">{start.l}</b> in queue</span>
      <span class="px-qc__ro-snap"></span>
    </div>
    <label class="px-qc__control">
      <span class="px-qc__control-lbl">calm</span>
      <input
        class="px-qc__range"
        type="range"
        min="0" max={maxRho} step="0.01" value={startRho}
        aria-label="Offered load — utilization ρ"
      />
      <span class="px-qc__control-lbl">busy</span>
    </label>
    <p class="px-qc__hint" hidden>Drag to raise the load — watch the wait go vertical near full.</p>
  </div>

  <!-- honesty footnote (mandated, always rendered — never accented) -->
  <p class="px-qc__note">M/M/1 is the optimistic case — real systems, with variable service times and bursty arrivals, are worse.</p>

  <!-- companion readout table (the AT-readable data source) -->
  <table class="px-qc__table">
    <thead>
      <tr><th>operating point</th><th>ρ</th><th>wait</th><th>latency</th></tr>
    </thead>
    <tbody>
      <tr class="px-qc__table-cur">
        <td>current</td>
        <td class="px-qc__cur-rho">{start.rho}</td>
        <td><span class="px-qc__cur-mult">{start.mult}</span>×</td>
        <td><span class="px-qc__cur-ms">{start.ms}</span> ms</td>
      </tr>
      {tableRows.map((r) => (
        <tr class={`px-qc__table-anno px-qc__table-anno--${r.tone}`}>
          <td>{r.label}</td>
          <td>{r.rho}</td>
          <td>{r.mult}×</td>
          <td>{r.ms} ms</td>
        </tr>
      ))}
    </tbody>
  </table>

  {source && <div class="px-viz__src">Source · {source}</div>}
</div>

<script is:inline>
  (function () {
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var X0 = 72, XW = 624, YT = 40, YB = 360, YH = 320;

    document.querySelectorAll('.px-qc').forEach(function (root) {
      var panel = root.querySelector('.px-qc__panel');
      var input = root.querySelector('.px-qc__range');
      if (!panel || !input) return;
      var cfg;
      try { cfg = JSON.parse(panel.getAttribute('data-qc') || '{}'); } catch (e) { return; }
      var maxRho = cfg.maxRho, yCap = cfg.yCap, annos = cfg.annos || [];

      var area = root.querySelector('.px-qc__area');
      var dropV = root.querySelector('.px-qc__drop-v');
      var dropH = root.querySelector('.px-qc__drop-h');
      var marker = root.querySelector('.px-qc__marker');
      var roRho = root.querySelector('.px-qc__ro-rho');
      var roMult = root.querySelector('.px-qc__ro-mult');
      var roMs = root.querySelector('.px-qc__ro-ms');
      var roL = root.querySelector('.px-qc__ro-l');
      var roSnap = root.querySelector('.px-qc__ro-snap');
      var curMult = root.querySelector('.px-qc__cur-mult');
      var curMs = root.querySelector('.px-qc__cur-ms');
      var curRho = root.querySelector('.px-qc__cur-rho');
      var hint = root.querySelector('.px-qc__hint');
      if (hint) hint.hidden = false;

      var xOf = function (r) { return X0 + (r / maxRho) * XW; };
      var wMult = function (r) { return 1 / (1 - r); };
      var yOf = function (m) {
        var y = YB - ((m - 1) / (yCap - 1)) * YH;
        return Math.max(YT, Math.min(YB, y));
      };
      var trim = function (s) { return s.slice(-2) === '.0' ? s.slice(0, -2) : s; };
      var fmtMult = function (m) { return trim((Math.round(m * 10) / 10).toFixed(1)); };
      var svcMs = 1000 / cfg.mu;

      var areaD = function (rho) {
        var N = 100, d = 'M ' + X0 + ' ' + YB;
        for (var i = 0; i <= N; i++) {
          var t = (rho * i) / N;
          d += ' L ' + xOf(t).toFixed(1) + ' ' + yOf(wMult(t)).toFixed(1);
        }
        d += ' L ' + xOf(rho).toFixed(1) + ' ' + YB + ' Z';
        return d;
      };

      var update = function () {
        var rho = parseFloat(input.value);
        if (isNaN(rho)) rho = 0;
        // gentle snap to a nearby annotation
        var snapLabel = '';
        for (var i = 0; i < annos.length; i++) {
          if (Math.abs(rho - annos[i].rho) < 0.015) {
            rho = annos[i].rho;
            snapLabel = '← ' + annos[i].label;
            break;
          }
        }
        var m = wMult(rho), w = svcMs / (1 - rho), l = rho / (1 - rho);
        var x = xOf(rho), y = yOf(m);
        marker.style.transform = 'translate(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px)';
        dropV.setAttribute('x1', x.toFixed(1)); dropV.setAttribute('x2', x.toFixed(1));
        dropV.setAttribute('y1', y.toFixed(1));
        dropH.setAttribute('y1', y.toFixed(1)); dropH.setAttribute('y2', y.toFixed(1));
        dropH.setAttribute('x2', x.toFixed(1));
        area.setAttribute('d', areaD(rho));
        var sMult = fmtMult(m), sMs = fmtMult(w), sL = String(Math.round(l)), sRho = rho.toFixed(2);
        if (roRho) roRho.textContent = 'ρ = ' + sRho;
        if (roMult) roMult.textContent = sMult;
        if (roMs) roMs.textContent = sMs;
        if (roL) roL.textContent = sL;
        if (roSnap) roSnap.textContent = snapLabel ? '  ' + snapLabel : '';
        if (curMult) curMult.textContent = sMult;
        if (curMs) curMs.textContent = sMs;
        if (curRho) curRho.textContent = sRho;
      };

      input.addEventListener('input', update);
      root.classList.add('px-qc--live');
      update();

      if (!reduce) {
        input.addEventListener('pointerdown', function () { root.classList.add('px-qc--drag'); });
        window.addEventListener('pointerup', function () { root.classList.remove('px-qc--drag'); });
      }
    });
  })();
</script>

<style>
  .px-qc__plot { width: 100%; }
  .px-qc__svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* ── chips + honesty ──────────────────────────────────────────────────── */
  .px-qc__ycap {
    display: inline-block;
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    padding: 3px 9px;
  }
  .px-qc__note {
    max-width: var(--col-prose);
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--muted);
  }

  /* ── axes + grid ──────────────────────────────────────────────────────── */
  .px-qc__grid-line { stroke: var(--ink); stroke-opacity: 0.1; stroke-width: 1; }
  .px-qc__axis-line { stroke: var(--ink); stroke-opacity: 0.42; stroke-width: 1.25; }
  .px-qc__tick {
    font-family: var(--font-mono);
    font-size: var(--viz-fs-axis, 9.5px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .px-qc__axis-title {
    font-family: var(--font-mono);
    font-size: var(--viz-fs-eyebrow, 10px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--ink-soft);
    font-weight: 700;
  }

  /* ── the curve + fill ─────────────────────────────────────────────────── */
  .px-qc__curve {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.9;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    paint-order: stroke;
    stroke-dasharray: var(--len);
    stroke-dashoffset: 0;                 /* resting = fully drawn (no-JS safe) */
    transition: stroke-dashoffset 1200ms var(--ease);
  }
  .px-qc__area {
    fill: var(--accent);
    fill-opacity: 0.1;
    stroke: none;
  }

  /* ── live marker + drop-lines ─────────────────────────────────────────── */
  .px-qc__drop {
    stroke: var(--ink);
    stroke-opacity: 0.42;
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .px-qc__marker {
    transform-box: view-box;
  }
  .px-qc__marker circle {
    fill: var(--accent);
    stroke: var(--paper);
    stroke-width: 1.5;
  }
  .px-qc--drag .px-qc__marker circle { r: 6; }

  /* ── annotations ──────────────────────────────────────────────────────── */
  .px-qc__anno-lead { stroke: var(--ink); stroke-opacity: 0.3; stroke-width: 1; }
  .px-qc__anno-ring { fill: none; stroke-width: 2; }
  .px-qc__anno-label {
    font-family: var(--font-mono);
    font-size: var(--viz-fs-axis, 9.5px);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .px-qc__anno--ok .px-qc__anno-ring { stroke: var(--accent-deep, var(--accent)); }
  .px-qc__anno--ok .px-qc__anno-label { fill: var(--accent-deep, var(--accent)); }
  .px-qc__anno--hot .px-qc__anno-ring { stroke: var(--accent-alt); }
  .px-qc__anno--hot .px-qc__anno-label { fill: var(--accent-alt); }

  /* ── control panel + readout ──────────────────────────────────────────── */
  .px-qc__panel { margin-top: 20px; }
  .px-qc__readout {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 8px;
  }
  .px-qc__readout b { font-weight: 700; color: var(--accent-deep, var(--accent)); }
  .px-qc__ro-rho { color: var(--ink-soft); font-weight: 700; }
  .px-qc__sep { color: var(--rule); }
  .px-qc__ro-snap { color: var(--accent-alt); font-style: italic; }

  .px-qc__control {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }
  .px-qc__control-lbl {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    flex: 0 0 auto;
  }
  .px-qc__range {
    flex: 1 1 auto;
    min-width: 0;
    -webkit-appearance: none;
    appearance: none;
    height: 44px;                          /* ≥44px touch target */
    background: transparent;
    cursor: pointer;
    touch-action: pan-y;                   /* vertical scroll stays sacred */
  }
  .px-qc__range::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent-deep) 0%, var(--accent-alt) 100%);
    opacity: 0.5;
  }
  .px-qc__range::-moz-range-track {
