---
/**
 * QueueCliff (tech) — the interactive utilization cliff. ONE slider drives the
 * offered load ρ = λ/μ; the reader watches the exact M/M/1 wait multiplier
 * `wMult(ρ) = 1/(1−ρ)` stay flat, then go vertical near full. The curve is the
 * real formula, sampled at 200 steps and baked into one SVG path at build time
 * (so no-JS shows the full law). A marker rides the curve at the current ρ
 * with drop-lines to both axes; the readout reports wait ×, latency and queue
 * length. The y axis is linear in the multiplier and capped at
 * yCap = wMult(maxRho); the cap is stated in a chip, and the honesty note (M/M/1
 * is the optimistic case) is on the card.
 *
 * LENS PHASE 6 (2026-09-30, the board Lib-queue-cliff): REDRAWN FOR THE FIGURE
 * PANEL, a 460-unit viewBox with 12px text (no sideways scroll at 1280; on a
 * phone it keeps 460 and scrolls in its card, the standing min-width rule in
 * dataviz-v2.css). The load axis reads in percent, the y axis in round
 * multiples, the y title sits above the plot, the annotation labels carry
 * their multiplier ("Black Friday · 20×"). The figure's one large number is
 * the wait at the busiest named point (else at the cap). The start point
 * snaps to a named point exactly as the island does, so the static page and
 * the live one agree to the pixel.
 *
 * Cue anchors:
 *   1..K    each named point (annotation), numbered from 1 in data order.
 *   curve   the M/M/1 curve.
 *   marker  the operating point the slider sets (and its drop-lines).
 *   axis    the grid and the tick labels.
 *   head    the large number.
 *
 * THE BUILD (LENS §6.4): the scene is the number and the plot, NOT the card:
 * the slider below it is live only with JS and moves the marker, which a
 * scene must not hold (the render gate's BUILD check). 1 the axis fades in,
 * 2 the curve draws, 3 the named points and the marker drop, 4 their labels
 * fade in, 5 the large number counts up (src/scripts/build.ts). No JS or
 * reduced motion: the chart as drawn, the marker at startRho.
 *
 * Fallback contract: the full static curve, axes, annotations, the marker at
 * startRho and a companion table paint under no JS; a tiny is:inline island
 * (gated by html.js) takes over the slider and updates marker, drop-lines,
 * area and readout 1:1 with input, no animation.
 *
 * Math mirrors physics/mechanics-and-flow.md §2 (M/M/1). Blueprint:
 * docs/design/blueprints/tech/queue-cliff.md. CSS prefix: px-qc.
 *
 * data: { muPerSec | serviceMs, startRho?, maxRho?, annotations?:[{rho,label,tone?}],
 *         caption?, source? }
 */
interface Annotation { rho: number; label: string; tone?: 'ok' | 'hot'; }
interface Props {
  muPerSec?: number;
  serviceMs?: number;
  startRho?: number;
  maxRho?: number;
  annotations?: Annotation[];
  caption?: string;
  source?: string;
}
const {
  muPerSec,
  serviceMs,
  annotations = [],
  caption,
  source, // accepted, never printed: core/Section.astro prints the source line
} = Astro.props;

const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
const FONT = "font-family:'Literata',Georgia,serif";

// Service rate μ (req/s). serviceMs wins if both are given (per schema).
const hasSvcMs = typeof serviceMs === 'number' && serviceMs > 0;
const hasMu = typeof muPerSec === 'number' && muPerSec > 0;
const mu = hasSvcMs ? 1000 / serviceMs! : (hasMu ? muPerSec! : 1000);
const svcMs = 1000 / mu;                        // 1/μ in ms — the ρ→0 latency floor
if (hasSvcMs && hasMu) {
  console.warn(`[QueueCliff] both serviceMs (${serviceMs}ms) and muPerSec (${muPerSec}) provided — serviceMs wins (μ = ${Math.round(mu)} req/s).`);
}
if (!hasSvcMs && !hasMu) {
  console.warn('[QueueCliff] neither serviceMs nor muPerSec provided — defaulting to μ = 1000 req/s. Provide ONE of muPerSec | serviceMs.');
}

const maxRho = clamp(Astro.props.maxRho ?? 0.98, 0.90, 0.995);

// ── M/M/1 math (physics/mechanics-and-flow.md §2) ───────────────────────────
const wMult = (rho: number) => 1 / (1 - rho);
const meanL = (rho: number) => rho / (1 - rho);
const waitMs = (rho: number) => svcMs / (1 - rho);
const yCap = wMult(maxRho);

// ── The panel's coordinate system (viewBox 0 0 460 H) ──────────────────────
const W = 460;
const X0 = 40, XW = 404;                  // plot x: 40 → 444
const YT = 30, YB = 250, YH = YB - YT;    // plot y (the y title sits above YT)
const H = 296;
const xOf = (rho: number) => X0 + (rho / maxRho) * XW;
const yOf = (m: number) => clamp(YB - ((m - 1) / (yCap - 1)) * YH, YT, YB);

const annos0 = annotations.slice(0, 3).map((a, i) => ({ ...a, rho: clamp(a.rho, 0, maxRho), i }));
/* The start point snaps to a named point within 0.015, as the island does. */
const rawStart = clamp(Astro.props.startRho ?? 0.5, 0, Math.min(0.99, maxRho));
const startRho = annos0.find((a) => Math.abs(rawStart - a.rho) < 0.015)?.rho ?? rawStart;

// ── The curve: 1/(1−ρ) sampled at 200 steps → one build-time path ───────────
const STEPS = 200;
const pts: Array<[number, number]> = [];
for (let i = 0; i <= STEPS; i++) {
  const rho = (i / STEPS) * maxRho;
  pts.push([xOf(rho), yOf(wMult(rho))]);
}
const curveD = pts.map(([x, y], i) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');

// ── Area under the curve, left of the marker, baked at startRho ─────────────
const areaOf = (rho: number) => {
  const N = 100;
  let d = `M ${X0} ${YB}`;
  for (let i = 0; i <= N; i++) {
    const t = (rho * i) / N;
    d += ` L ${xOf(t).toFixed(1)} ${yOf(wMult(t)).toFixed(1)}`;
  }
  d += ` L ${xOf(rho).toFixed(1)} ${YB} Z`;
  return d;
};
const startArea = areaOf(startRho);
const mx0 = xOf(startRho), my0 = yOf(wMult(startRho));

// ── Axis ticks: load in percent, the multiplier in round steps ─────────────
const fmtMult = (m: number) => {
  const s = (Math.round(m * 10) / 10).toFixed(1);
  return s.endsWith('.0') ? s.slice(0, -2) : s;
};
const xTicks = [0, 0.25, 0.5, 0.75]
  .filter((r) => r < maxRho - 0.1)
  .concat([maxRho])
  .map((r) => ({ x: xOf(r), label: `${Math.round(r * 100)}%` }));
const yStep = [5, 10, 20, 25, 50, 100, 200].find((s) => yCap / s <= 5) ?? 100;
const yTicks = [1];
for (let v = yStep; v <= yCap + 1e-9; v += yStep) yTicks.push(v);
const yTickObjs = yTicks.map((m) => ({ y: yOf(m), label: `${m}×` }));

// ── Annotations pinned to the curve, labels placed off each other ──────────
interface Box { l: number; r: number; t: number; b: number; }
const hit = (a: Box, b: Box) => a.l < b.r + 3 && a.r > b.l - 3 && a.t < b.b + 3 && a.b > b.t - 3;
const est = (s: string) => s.length * 12 * 0.56;
const placed: Box[] = [];
const annos = annos0.map((a) => {
  const ax = xOf(a.rho), ay = yOf(wMult(a.rho));
  const tone: 'ok' | 'hot' = a.tone ?? (a.rho >= 0.85 ? 'hot' : 'ok');
  const text = `${a.label} · ${fmtMult(wMult(a.rho))}×`;
  const w = est(text);
  // candidates: left of the ring (the curve rises to the right, so the space
  // above-left is empty), above-left, below-right, above
  const cands: Array<{ lx: number; ly: number; anchor: 'start' | 'end' | 'middle' }> = [
    { lx: ax - 10, ly: ay + 4, anchor: 'end' },
    { lx: ax - 8, ly: ay - 10, anchor: 'end' },
    { lx: ax - 10, ly: ay - 24, anchor: 'end' },
    { lx: ax + 10, ly: ay + 16, anchor: 'start' },
    { lx: ax, ly: ay - 12, anchor: 'middle' },
  ];
  const boxOf = (c: typeof cands[number]): Box => {
    const l = c.anchor === 'start' ? c.lx : c.anchor === 'end' ? c.lx - w : c.lx - w / 2;
    return { l, r: l + w, t: c.ly - 10, b: c.ly + 3 };
  };
  const ok = cands.find((c) => {
    const b = boxOf(c);
    return b.l >= X0 + 2 && b.r <= W - 2 && b.t >= YT - 4 && b.b <= YB - 2 && !placed.some((p) => hit(b, p));
  }) ?? cands[0];
  placed.push(boxOf(ok));
  return { ...a, ax, ay, tone, text, ...ok, key: a.i, mult: wMult(a.rho) };
});

// ── The large number: the wait at the busiest named point, else at the cap ─
const busiest = annos.length ? annos.reduce((a, b) => (b.rho > a.rho ? b : a)) : undefined;
const headRho = busiest ? busiest.rho : maxRho;
const headMult = Math.round(wMult(headRho));
const headLabel = `the wait at ${Math.round(headRho * 100)}% load`;

// ── Companion table (fallback data source) + the live readout at startRho ──
const fmtMs = (w: number) => fmtMult(w);
const tableRows = annos.map((a) => ({ label: a.label, rho: a.rho.toFixed(2), mult: fmtMult(a.mult), ms: fmtMs(waitMs(a.rho)), tone: a.tone }));
const start = {
  rho: startRho.toFixed(2),
  mult: fmtMult(wMult(startRho)),
  ms: fmtMs(waitMs(startRho)),
  l: String(Math.round(meanL(startRho))),
};
const yCapLabel = fmtMult(yCap);

// config for the island (geometry, snap, readout)
const cfg = JSON.stringify({
  mu, maxRho, yCap, X0, XW, YT, YB,
  annos: annos.map((a) => ({ rho: a.rho, label: a.label })),
});
const pct = (v: number, of: number) => ((v / of) * 100).toFixed(2);
/* The curve's numeral: left of the wall, where the curve climbs through 70%
   of the cap (the space there is empty: the named points sit lower). */
const curveTag = (() => {
  const m = 1 + (yCap - 1) * 0.7;
  const rho = 1 - 1 / m;
  return { x: xOf(rho) - 16, y: yOf(m) };
})();
---

<div class="px-viz px-qc">
  {caption && <div class="px-viz__cap"><span>{caption}</span><b>M/M/1</b></div>}

  <div class="px-qc__scene" data-build-scene>
    <div class="px-qc__head" data-cue="head" style={`--ch:${String(headMult).length + 1}`}>
      <span class="px-cue-tag" data-cue-tag="head" hidden></span>
      <span class="px-qc__big"><span data-build="5" data-build-kind="counter" data-to={headMult}>{headMult}</span>×</span>
      <span class="px-qc__biglab">{headLabel}</span>
      <span class="px-qc__ycap">Capped at {yCapLabel}×</span>
    </div>

    <div class="px-qc__plot">
      <svg class="px-qc__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <g class="px-qc__grid" data-cue="axis" data-build="1">
          {yTickObjs.map((t) => (
            <g>
              <line x1={X0} y1={t.y.toFixed(1)} x2={X0 + XW} y2={t.y.toFixed(1)} class="px-qc__grid-line" />
              <text class="px-qc__tick" x={X0 - 8} y={(t.y + 4).toFixed(1)} text-anchor="end" style={FONT}>{t.label}</text>
            </g>
          ))}
          <line x1={X0} y1={YB} x2={X0 + XW} y2={YB} class="px-qc__axis-line" />
          {xTicks.map((t, i) => (
            <text class="px-qc__tick" x={t.x.toFixed(1)} y={YB + 18} text-anchor={i === 0 ? 'start' : i === xTicks.length - 1 ? 'end' : 'middle'} style={FONT}>{t.label}</text>
          ))}
          <text class="px-qc__axis-title" x={X0 + XW / 2} y={H - 4} text-anchor="middle" style={FONT}>Offered load</text>
          <text class="px-qc__axis-title" x="0" y="14" text-anchor="start" style={FONT}>Wait × ideal</text>
          <line x1={X0 + XW} y1={YT} x2={X0 + XW} y2={YB} class="px-qc__wall" />
        </g>

        <path class="px-qc__area" d={startArea} data-cue="marker" data-build="3" />

        <path class="px-qc__curve" d={curveD} data-cue="curve" data-build="2" data-build-kind="draw" />

        <g class="px-qc__live-g" data-cue="marker" data-build="3" data-build-kind="drop">
          <line class="px-qc__drop px-qc__drop-v" x1={mx0.toFixed(1)} y1={my0.toFixed(1)} x2={mx0.toFixed(1)} y2={YB} />
          <line class="px-qc__drop px-qc__drop-h" x1={X0} y1={my0.toFixed(1)} x2={mx0.toFixed(1)} y2={my0.toFixed(1)} />
          <g class="px-qc__marker" style={`transform:translate(${mx0.toFixed(1)}px,${my0.toFixed(1)}px)`}>
            <circle r="6" />
          </g>
        </g>

        {annos.map((a) => (
          <g class={`px-qc__anno px-qc__anno--${a.tone}`} data-cue={a.key + 1}>
            <circle class="px-qc__anno-ring" cx={a.ax.toFixed(1)} cy={a.ay.toFixed(1)} r="5" data-build="3" data-build-kind="drop" />
            <text class="px-qc__anno-label" x={a.lx.toFixed(1)} y={a.ly.toFixed(1)} text-anchor={a.anchor} style={FONT} data-build="4">{a.text}</text>
          </g>
        ))}
      </svg>

      {/* The cue numerals, an HTML layer over the drawing. */}
      <div class="px-qc__tags" aria-hidden="true">
        {annos.map((a) => (
          <span class="px-qc__tag" style={`left:${pct(Math.min(a.ax + 14, W - 12), W)}%;top:${pct(Math.min(a.ay + 14, YB - 10), H)}%`}>
            <span class="px-cue-tag" data-cue-tag={a.key + 1} hidden></span>
          </span>
        ))}
        <span class="px-qc__tag" style={`left:${pct(curveTag.x, W)}%;top:${pct(curveTag.y, H)}%`}>
          <span class="px-cue-tag" data-cue-tag="curve" hidden></span>
        </span>
        <span class="px-qc__tag" style={`left:${pct(Math.max(mx0 - 16, X0 + 12), W)}%;top:${pct(Math.min(my0 + 16, YB - 10), H)}%`}>
          <span class="px-cue-tag" data-cue-tag="marker" hidden></span>
        </span>
        <span class="px-qc__tag" style={`left:${pct(X0 - 22, W)}%;top:${pct(YB + 14, H)}%`}>
          <span class="px-cue-tag" data-cue-tag="axis" hidden></span>
        </span>
      </div>
    </div>
  </div>

  <!-- control + live readout -->
  <div class="px-qc__panel" data-qc={cfg}>
    <div class="px-qc__readout" aria-live="polite">
      <span class="px-qc__ro px-qc__ro-rho">ρ = {start.rho}</span>
      <span class="px-qc__sep">·</span>
      <span class="px-qc__ro">wait <b class="px-qc__ro-mult">{start.mult}</b>×</span>
      <span class="px-qc__sep">·</span>
      <span class="px-qc__ro"><b class="px-qc__ro-ms">{start.ms}</b> ms</span>
      <span class="px-qc__sep">·</span>
      <span class="px-qc__ro"><b class="px-qc__ro-l">{start.l}</b> in queue</span>
      <span class="px-qc__ro-snap"></span>
    </div>
    <label class="px-qc__control">
      <span class="px-qc__control-lbl">Calm</span>
      <input
        class="px-qc__range"
        type="range"
        min="0" max={maxRho} step="0.01" value={startRho}
        aria-label="Offered load — utilization ρ"
      />
      <span class="px-qc__control-lbl">Busy</span>
    </label>
  </div>

  <!-- honesty footnote (mandated, always rendered — never accented) -->
  <p class="px-qc__note">M/M/1 is the optimistic case. Real systems, with variable service times and bursty arrivals, are worse.</p>

  <!-- companion readout table (the AT-readable data source) -->
  <table class="px-qc__table">
    <thead>
      <tr><th>Point</th><th>Load</th><th>Wait</th><th>Latency</th></tr>
    </thead>
    <tbody>
      <tr class="px-qc__table-cur">
        <td>current</td>
        <td class="px-qc__cur-rho">{start.rho}</td>
        <td><span class="px-qc__cur-mult">{start.mult}</span>×</td>
        <td><span class="px-qc__cur-ms">{start.ms}</span> ms</td>
      </tr>
      {tableRows.map((r) => (
        <tr class={`px-qc__table-anno px-qc__table-anno--${r.tone}`}>
          <td>{r.label}</td>
          <td>{r.rho}</td>
          <td>{r.mult}×</td>
          <td>{r.ms} ms</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script is:inline>
  (function () {
    if (!document.documentElement.classList.contains('js')) return;
    document.querySelectorAll('.px-qc').forEach(function (root) {
      var panel = root.querySelector('.px-qc__panel');
      var input = root.querySelector('.px-qc__range');
      if (!panel || !input) return;
      var cfg;
      try { cfg = JSON.parse(panel.getAttribute('data-qc') || '{}'); } catch (e) { return; }
      var maxRho = cfg.maxRho, yCap = cfg.yCap, annos = cfg.annos || [];
      var X0 = cfg.X0, XW = cfg.XW, YT = cfg.YT, YB = cfg.YB, YH = YB - YT;

      var area = root.querySelector('.px-qc__area');
      var dropV = root.querySelector('.px-qc__drop-v');
      var dropH = root.querySelector('.px-qc__drop-h');
      var marker = root.querySelector('.px-qc__marker');
      var roRho = root.querySelector('.px-qc__ro-rho');
      var roMult = root.querySelector('.px-qc__ro-mult');
      var roMs = root.querySelector('.px-qc__ro-ms');
      var roL = root.querySelector('.px-qc__ro-l');
      var roSnap = root.querySelector('.px-qc__ro-snap');
      var curMult = root.querySelector('.px-qc__cur-mult');
      var curMs = root.querySelector('.px-qc__cur-ms');
      var curRho = root.querySelector('.px-qc__cur-rho');

      var xOf = function (r) { return X0 + (r / maxRho) * XW; };
      var wMult = function (r) { return 1 / (1 - r); };
      var yOf = function (m) { return Math.max(YT, Math.min(YB, YB - ((m - 1) / (yCap - 1)) * YH)); };
      var trim = function (s) { return s.slice(-2) === '.0' ? s.slice(0, -2) : s; };
      var fmtMult = function (m) { return trim((Math.round(m * 10) / 10).toFixed(1)); };
      var svcMs = 1000 / cfg.mu;

      var areaD = function (rho) {
        var N = 100, d = 'M ' + X0 + ' ' + YB;
        for (var i = 0; i <= N; i++) {
          var t = (rho * i) / N;
          d += ' L ' + xOf(t).toFixed(1) + ' ' + yOf(wMult(t)).toFixed(1);
        }
        return d + ' L ' + xOf(rho).toFixed(1) + ' ' + YB + ' Z';
      };

      var update = function () {
        var rho = parseFloat(input.value);
        if (isNaN(rho)) rho = 0;
        var snapLabel = '';
        for (var i = 0; i < annos.length; i++) {
          if (Math.abs(rho - annos[i].rho) < 0.015) { rho = annos[i].rho; snapLabel = annos[i].label; break; }
        }
        var m = wMult(rho), w = svcMs / (1 - rho), l = rho / (1 - rho);
        var x = xOf(rho), y = yOf(m);
        marker.style.transform = 'translate(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px)';
        dropV.setAttribute('x1', x.toFixed(1)); dropV.setAttribute('x2', x.toFixed(1));
        dropV.setAttribute('y1', y.toFixed(1));
        dropH.setAttribute('y1', y.toFixed(1)); dropH.setAttribute('y2', y.toFixed(1));
        dropH.setAttribute('x2', x.toFixed(1));
        area.setAttribute('d', areaD(rho));
        var sMult = fmtMult(m), sMs = fmtMult(w), sL = String(Math.round(l)), sRho = rho.toFixed(2);
        if (roRho) roRho.textContent = 'ρ = ' + sRho;
        if (roMult) roMult.textContent = sMult;
        if (roMs) roMs.textContent = sMs;
        if (roL) roL.textContent = sL;
        if (roSnap) roSnap.textContent = snapLabel;
        if (curMult) curMult.textContent = sMult;
        if (curMs) curMs.textContent = sMs;
        if (curRho) curRho.textContent = sRho;
      };

      input.addEventListener('input', update);
      root.classList.add('px-qc--live');
    });
  })();
</script>

<style>
  /* LENS §7: the pinned figure's headline number at 96 (72 on phones),
     its label 8px below it. The size also fits the number to the panel:
     --ch is its character count, the head a size container. */
  .px-qc__head {
    container-type: inline-size;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    row-gap: 8px;
    align-items: center;
    margin-bottom: 20px;
  }
  .px-qc__head > .px-cue-tag { grid-column: 1; grid-row: 1; margin: 0 8px 0 0; }
  .px-qc__big { grid-column: 2; grid-row: 1; justify-self: start; white-space: nowrap; }
  .px-qc__biglab { grid-column: 2; grid-row: 2; justify-self: start; }
  .px-qc__big {
    font-family: var(--font-ui);
    font-size: min(96px, calc((100cqi - 28px) / var(--ch, 4) / 0.62));
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-deep);
    padding-bottom: 0.12em;
  }
  .px-qc__biglab {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink-2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  /* the honesty chip for the clipped axis */
  .px-qc__ycap {
    grid-column: 2;
    grid-row: 3;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--paper-3);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .px-qc__plot { position: relative; width: 100%; }
  .px-qc__svg { width: 100%; height: auto; display: block; overflow: visible; }

  .px-qc__grid-line { stroke: var(--hair); stroke-width: 1; }
  .px-qc__axis-line { stroke: var(--hair-2); stroke-width: 1.25; }
  .px-qc__wall { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 4; }
  .px-qc__tick { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .px-qc__axis-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--ink-2);
  }

  .px-qc__curve {
    fill: none;
