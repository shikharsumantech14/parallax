---
/**
 * NeuralFlow (tech · FLAGSHIP + world signature) — "The machine, mid-thought."
 * A real (small) network's forward pass, rendered as the machine it is: every
 * unit of every layer is an instanced node at the layer's TRUE size (large
 * layers honestly sampled, and labelled so), and an activation wave sweeps the
 * columns layer by layer. The parameter count is COMPUTED from the
 * architecture, so the scale claim is earned.
 *
 * Rendered lazily by the WebGL runtime (scene 'neural-flow'); drag to inspect,
 * scroll to zoom, hover a column for its unit and weight counts.
 *
 * LENS PHASE 6 (2026-09-30, the board Lib-neural-flow): ON THE DEEP PLATE
 * (LENS §8.3). The plate re-points the inks the scene reads (`--ink`,
 * `--paper`, `--muted`, `--accent`) to the on-deep set and the desk's plate
 * mark (the lime on tech), so the live scene and the static fallback both
 * draw light on dark. The figure's one large number is the weight count, in
 * HTML above the mount; the layer names and unit counts are an HTML row under
 * it, one cell per layer at the layer's x: nothing is text inside the SVG,
 * so nothing prints small at any width, and the scene no longer projects
 * labels or mounts its own count-up (scenes/neuralFlow.ts). The legend list
 * and its "show all layers" island are retired: the row is the legend.
 *
 * Cue anchors:
 *   1..L   each layer: its column of nodes in the fallback and its cell in
 *          the label row (the numeral prints in the cell), from 1 in data order.
 *   wave   the frozen wave (the gap feeding the middle layer, in the mark).
 *   head   the weight count.
 *
 * THE BUILD (LENS §6.4): the plate is the scene, and only its HTML builds
 * (the fallback hides once the WebGL scene is live, so nothing inside the
 * mount may build): 1 the layer cells rise, 80ms apart, 2 the weight count
 * counts up (src/scripts/build.ts). The scene keeps its one idle loop, the
 * wave.
 *
 * Blueprint (the contract): docs/design/blueprints/tech/neural-flow.md.
 * Math: src/scripts/viz3d/neural.ts — the SAME functions (sampling, layouts,
 * param count, 96-edge pseudo-shuffle) compute the static fallback below.
 *
 * data: { layers: [{n, label}] (2–8), paramsNote?, wave_ms?, caption?, source? }
 */
import {
  resolveArchitecture, nodeLocal, gapEdges, middleLayer,
  formatCount, waveMs, type LayerSpec,
} from '../../../scripts/viz3d/neural';

interface Props {
  layers: LayerSpec[];
  paramsNote?: string;
  wave_ms?: number;
  caption?: string;
  source?: string;
}
const { layers: rawLayers = [], paramsNote, wave_ms, caption, source } = Astro.props;

/* schema guard: 2–8 layers (build error outside that range, blueprint §3/§11) */
const layers: LayerSpec[] = (rawLayers ?? [])
  .filter((l) => l && typeof l.n === 'number' && l.n >= 1)
  .map((l) => ({ n: l.n, label: String(l.label ?? '') }));
if (layers.length < 2 || layers.length > 8) {
  throw new Error(
    `neural-flow: needs 2–8 layers (got ${layers.length}). Each layer is { n, label }; see docs/design/blueprints/tech/neural-flow.md §3.`,
  );
}

const R = resolveArchitecture(layers);
const L = R.L;
const midL = middleLayer(L); // the frozen-wave layer in the composed still
const cyclMs = waveMs(wave_ms); // the live loop's period; the scene reads wave_ms itself

/* ── build-time fallback geometry — shallow isometric (blueprint §7) ──
   px = 360 + (x − z·0.36)·150 ; py = 168 − (y + z·0.16)·150 ; viewBox 720×330.
   Same neural.ts inputs as the live scene, so layout/sampling never diverge. */
const VW = 720, VH = 330;
const px = (x: number, z: number) => +(360 + (x - z * 0.36) * 150).toFixed(1);
const py = (y: number, z: number) => +(160 - (y + z * 0.16) * 150).toFixed(1);

const svgLayers = R.layers.map((ly) => {
  const column = ly.shown <= 16;
  const pts = [];
  for (let k = 0; k < ly.shown; k++) {
    const p = nodeLocal(k, ly.layout);
    pts.push({ x: px(ly.x, p.z), y: py(p.y, p.z) });
  }
  return { pts, r: column ? 3.2 : 2 };
});

const svgGaps = [];
for (let l = 0; l < L - 1; l++) {
  const a = R.layers[l], b = R.layers[l + 1];
  const es = gapEdges(a.shown, b.shown);
  const inbound = l + 1 === midL; // this gap feeds the frozen (middle) layer
  const segs = es.map((e) => {
    const pa = nodeLocal(e.from, a.layout);
    const pb = nodeLocal(e.to, b.layout);
    return { x1: px(a.x, pa.z), y1: py(pa.y, pa.z), x2: px(b.x, pb.z), y2: py(pb.y, pb.z) };
  });
  svgGaps.push({ segs, inbound });
}

/* The drawing is cropped to what it holds (the isometric frame leaves wide
   empty margins), so the layers span the plate and the label row can sit
   under them at a legible width. */
const allX = svgLayers.flatMap((ly) => ly.pts.map((p) => p.x));
const allY = svgLayers.flatMap((ly) => ly.pts.map((p) => p.y));
const cx0 = Math.min(...allX) - 14, cx1 = Math.max(...allX) + 14;
const cy0 = Math.min(...allY) - 12, cy1 = Math.max(...allY) + 12;
const cw = cx1 - cx0, ch = cy1 - cy0;

/* The label row: one cell per layer, centred on the layer's x (as a share of
   the viewBox), at most an equal share of the width, wrapping. */
const cells = R.layers.map((ly, l) => ({
  label: ly.label || `layer ${l}`,
  units: `${formatCount(ly.n)} units`,
  read: l === 0 ? `${formatCount(ly.n)} units · input` : `${formatCount(ly.n)} units · ${formatCount(ly.paramsIn)} params in`,
  sampled: ly.every > 1 ? `1 in ${ly.every} shown` : '',
  left: ((px(ly.x, 0) - cx0) / cw) * 100,
}));

const payload = JSON.stringify({
  layers,
  ...(paramsNote ? { paramsNote } : {}),
  ...(wave_ms ? { wave_ms } : {}),
});
const paramsStr = R.params.toLocaleString('en-US');
---

<div class="px-viz px-nflow">
  {caption && (
    <div class="px-viz__cap">
      <span>{caption}</span>
      {R.sampled && <b>sampled, 1 in {R.maxEvery}</b>}
    </div>
  )}

  <div class="px-nflow__plate" data-build-scene>
    <div class="px-nflow__top">
      <div class="px-nflow__head" data-cue="head" style={`--ch:${paramsStr.length}`}>
        <span class="px-cue-tag" data-cue-tag="head" hidden></span>
        <span class="px-nflow__big"><span data-build="2" data-build-kind="counter" data-to={R.params}>{paramsStr}</span></span>
        <span class="px-nflow__biglab">weights{paramsNote && <> · {paramsNote}</>}</span>
      </div>
      {R.sampled && <span class="px-nflow__chip">Large layers 1 in {R.maxEvery}</span>}
    </div>

    <div
      class="viz3d viz3d--nflow"
      data-viz3d="neural-flow"
      style={`aspect-ratio:${cw.toFixed(1)} / ${ch.toFixed(1)}`}
      role="img"
      aria-label={`Neural-network forward pass${caption ? `: ${caption}` : ''}. ${cells.map((c) => `${c.label}, ${c.read}`).join('; ')}.`}
    >
      <div class="viz3d__fallback">
        <svg viewBox={`${cx0.toFixed(1)} ${cy0.toFixed(1)} ${cw.toFixed(1)} ${ch.toFixed(1)}`} preserveAspectRatio="xMidYMid meet">
          {svgGaps.map((gap) => (
            <g class="px-nflow__gap" data-cue={gap.inbound ? 'wave' : undefined}>
              {gap.segs.map((s) => (
                <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2}
                  stroke={gap.inbound ? 'var(--accent)' : 'var(--ink)'}
                  stroke-width="0.9" opacity={gap.inbound ? 0.6 : 0.14} />
              ))}
            </g>
          ))}
          {svgLayers.map((ly, l) => (
            <g class="px-nflow__layer" data-cue={l + 1}>
              {ly.pts.map((p) => (
                <circle cx={p.x} cy={p.y} r={ly.r}
                  fill={l === midL ? 'var(--accent)' : 'var(--ink)'}
                  opacity={l === midL ? 1 : 0.7} />
              ))}
            </g>
          ))}
        </svg>
      </div>

      <span class="viz3d__hint" aria-hidden="true">drag · scroll to zoom</span>
      <script type="application/json" class="viz3d__data" set:html={payload}></script>
    </div>

    <ol class="px-nflow__cells" style={`--cells:${cells.length}`}>
      {cells.map((c, l) => (
        <li class="px-nflow__cell" data-cue={l + 1} style={`left:${c.left.toFixed(2)}%`} title={c.read} data-build="1" data-build-kind="rise">
          <span class="px-nflow__k"><span class="px-cue-tag" data-cue-tag={l + 1} hidden></span>{c.label}</span>
          <span class="px-nflow__v">{c.units}</span>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  /* the deep plate (LENS §8): the scene and the fallback read these inks */
  .px-nflow__plate {
    --nf-mark: var(--accent-lime, var(--accent));
    position: relative;
    background: var(--deep, #111111);
    color: var(--on-deep);
    border-radius: var(--r-card, 6px);
    padding: 18px 18px 16px;
  }
  .px-nflow__plate .viz3d {
    --ink: var(--on-deep);
    --paper: var(--deep, #111111);
    --muted: var(--on-deep-2);
    --accent: var(--nf-mark);
    background: transparent;
    border-radius: 0;
  }
  .px-nflow__plate .viz3d__hint { color: var(--on-deep-2); }

  .px-nflow__top { display: flex; flex-direction: column; align-items: stretch; gap: 10px; margin-bottom: 12px; }
  .px-nflow__top > .px-nflow__chip { align-self: flex-start; }
  /* LENS §7: the pinned figure's headline number at 96 (72 on phones),
     its label 8px below it. The size also fits the number to the panel:
     --ch is its character count, the head a size container. */
  .px-nflow__head {
    container-type: inline-size;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    row-gap: 8px;
    align-items: center;
    margin-bottom: 20px;
  }
  .px-nflow__head > .px-cue-tag { grid-column: 1; grid-row: 1; margin: 0 8px 0 0; }
  .px-nflow__big { grid-column: 2; grid-row: 1; justify-self: start; white-space: nowrap; }
  .px-nflow__biglab { grid-column: 2; grid-row: 2; justify-self: start; }
  .px-nflow__big {
    font-family: var(--font-ui);
    font-size: min(96px, calc((100cqi - 28px) / var(--ch, 4) / 0.62));
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--on-deep);
  }
  .px-nflow__biglab { font-family: var(--font-ui); font-size: 13px; font-weight: 500; color: var(--on-deep-2); }
  .px-nflow__chip {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--on-deep-hair);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    color: var(--on-deep-2);
    white-space: nowrap;
  }

  /* live-only wave-honesty chip (the scene appends .px-nflow__chip in the mount) */
  .px-nflow__plate .viz3d > .px-nflow__chip {
    position: absolute; top: 8px; right: 8px; z-index: 3;
    min-height: 24px;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }

  /* the layer row: each cell centred on its layer's x */
  .px-nflow__cells {
    position: relative;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    height: 60px;
  }
  .px-nflow__cell {
    position: absolute;
    top: 0;
    translate: -50% 0;
    width: calc(100% / var(--cells) - 20px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
  }
  .px-nflow__cell:first-child { translate: 0 0; align-items: flex-start; text-align: left; margin-left: -6px; }
  .px-nflow__cell:last-child { translate: -100% 0; align-items: flex-end; text-align: right; margin-left: 6px; }
  .px-nflow__k { font-family: var(--font-ui); font-size: 13px; font-weight: 600; line-height: 1.2; color: var(--on-deep); }
  .px-nflow__v { font-family: var(--font-ui); font-size: 12px; line-height: 1.2; color: var(--on-deep-2); font-variant-numeric: tabular-nums; }
  .px-nflow__plate .px-cue-tag { color: var(--deep, #111111); }

  @media (max-width: 640px) {
    .px-nflow__plate { padding: 14px 12px 12px; }
    .px-nflow__cells { height: 76px; }
  }
  @media (max-width: 640px) {
    .px-nflow__big { font-size: min(72px, calc((100cqi - 28px) / var(--ch, 4) / 0.62)); }
  }
</style>
