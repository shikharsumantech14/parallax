---
/**
 * AtmosphereColumn (earth) — the air overhead stood on end at true altitude
 * (Lens Phase 6, the Lib-atmosphere-column board): the layers as stacked
 * bands in a column with their names and heights, the barometric pressure
 * curve falling away beside it (0% to 100% of sea-level pressure), and the
 * heights the reader knows pinned on the curve at their real altitude, named
 * to the right. The pressure at the first authored landmark is the headline.
 *
 * Physics (geodesy §7, unchanged): isothermal P(h) = P0·exp(−h/8.4); lapse
 * (to 11 km) T = 288 − 6.5h, P = P0·(T/288)^5.256; effective O₂ = 21%·P/P0
 * (printed on each landmark when `showOxygen`). `logAlt` compresses the
 * altitude axis, and the figure says so under the column.
 *
 * Cue anchors: `troposphere` · `stratosphere` · `mesosphere` · `thermosphere`
 * (the bands the column reaches) · `curve` (the pressure curve) · `1`…`n`
 * (each landmark, authored order) · `head` (the headline number).
 * Build: the axis and the bands (1) · the curve draws (2) · landmark pins (3)
 * · landmark labels (4) · the headline number (5).
 *
 * data: { maxAlt_km?, model?, landmarks?[{ name, alt_km, note? }],
 *         showOxygen?, logAlt?, caption?, source? }
 */
import FigHead from './FigHead.astro';
import CueLayer from './CueLayer.astro';
import { SANS, wrapWords, stack, fmt } from './_fig';

interface Landmark { name: string; alt_km: number; note?: string; }
interface Props {
  maxAlt_km?: number;
  model?: 'lapse' | 'isothermal';
  landmarks?: Landmark[];
  showOxygen?: boolean;
  logAlt?: boolean;
  caption?: string;
  source?: string;
}
const { maxAlt_km, model: modelProp, landmarks = [], showOxygen = true, logAlt = false, caption, source } = Astro.props;
/* `source` is accepted and printed nowhere here: core/Section.astro prints
   it once, in the figure panel's foot (LENS §5.5). */
void source;

const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
const W = 320, FS = 13, LH = 15.5;
const AX = 26, C0 = 32, C1 = 128, K0 = 138, K1 = 196, LX = 212, LW = W - LX;
const TOP = 24, GROUND = 330;

const maxAlt = clamp(maxAlt_km ?? 100, 12, 600);
const model: 'lapse' | 'isothermal' = modelProp ?? (maxAlt <= 12 ? 'lapse' : 'isothermal');
const yAlt = (alt: number) => {
  const a = clamp(alt, 0, maxAlt);
  const f = logAlt ? Math.log10(1 + a) / Math.log10(1 + maxAlt) : a / maxAlt;
  return GROUND - f * (GROUND - TOP);
};
const P0 = 1013.25;
const pressure = (h: number) => (model === 'lapse' ? P0 * Math.pow(Math.max(288 - 6.5 * h, 1e-3) / 288, 5.256) : P0 * Math.exp(-h / 8.4));
const xP = (h: number) => K0 + (pressure(h) / P0) * (K1 - K0);

/* the bands the column reaches */
const DEFS: Array<[string, number, number]> = [['Troposphere', 0, 12], ['Stratosphere', 12, 50], ['Mesosphere', 50, 85], ['Thermosphere', 85, 600]];
const bands = DEFS.filter(([, b]) => b < maxAlt).map(([name, base, top], i) => {
  const t = Math.min(top, maxAlt);
  return { name, id: name.toLowerCase(), i, y0: yAlt(t), y1: yAlt(base), range: `${base}–${Math.min(top, maxAlt)} km` };
});
const bandFill = (i: number) => `color-mix(in oklab, var(--accent-tint) ${Math.max(20, 100 - i * 26)}%, var(--paper-2))`;

/* altitude ticks: a step that gives about five */
const aStep = [5, 10, 20, 25, 50, 100, 200].find((s) => maxAlt / s <= 5) ?? 200;
const aTicks: number[] = [];
if (!logAlt) for (let a = 0; a <= maxAlt + 1e-9; a += aStep) aTicks.push(a);
else aTicks.push(0, ...[1, 10, 100].filter((v) => v < maxAlt), maxAlt);

/* the curve */
const step = maxAlt > 200 ? 2 : 0.5;
let curveD = '';
for (let h = 0; h <= maxAlt + 1e-9; h += step) curveD += `${h ? 'L' : 'M'}${xP(h).toFixed(2)} ${yAlt(h).toFixed(2)} `;

/* the landmarks: a dot on the curve, the name and height to the right */
const pins = landmarks
  .map((l, i) => ({ ...l, i }))
  .filter((l) => Number.isFinite(l.alt_km) && l.alt_km >= 0 && l.alt_km <= maxAlt)
  .map((l) => ({ ...l, x: xP(l.alt_km), y: yAlt(l.alt_km), pct: (pressure(l.alt_km) / P0) * 100 }));
const blocks = stack(
  [...pins].sort((a, b) => a.y - b.y).map((p) => {
    const name = wrapWords(p.name, LW, FS, false, 2);
    const stat = [`${fmt(p.alt_km, 3)} km`, showOxygen ? `O₂ ${(0.21 * p.pct).toFixed(1)}%` : ''].filter(Boolean);
    return { p, name, stat, size: (name.length + stat.length) * LH, want: p.y - 9 };
  }),
  4, GROUND + 18, 6,
);
const H = Math.ceil(Math.max(GROUND + 26, ...blocks.map((b) => b.at + b.size + 4)));
const first = pins.find((p) => p.i === 0) ?? pins[0];
const aria = `The atmosphere to ${maxAlt} km${logAlt ? ' on a compressed height scale' : ' at true scale'}: ${bands.map((b) => `${b.name} ${b.range}`).join(', ')}; pressure falls with height${pins.length ? `; ${pins.map((p) => `${p.name} at ${fmt(p.alt_km, 3)} km, ${Math.round(p.pct)}% of sea-level pressure${p.note ? ` (${p.note})` : ''}`).join('; ')}` : ''}.`;
const tags = [
  ...blocks.map((b) => ({ id: b.p.i + 1, x: LX - 12, y: b.at + 5 })),
  ...bands.map((b) => ({ id: b.id, x: C1 + 5, y: Math.max(b.y0 + 12, Math.min(b.y1 - 12, (b.y0 + b.y1) / 2)) })),
  { id: 'curve', x: K0 + 16, y: yAlt(maxAlt * 0.4) },
];
---

<div class="px-viz px-atmc" data-build-scene>
  {caption && <div class="px-viz__cap"><span>{caption}</span></div>}
  {first && <FigHead value={`${Math.round(first.pct)}%`} label={`air pressure, ${first.name}`} n={5} />}

  <div class="px-atmc__plot">
    <svg class="px-atmc__fig" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
      <g class="px-atmc__axis" data-build="1">
        {aTicks.map((a) => (
          <>
            <line x1={AX + 2} y1={yAlt(a).toFixed(1)} x2={C0} y2={yAlt(a).toFixed(1)} />
            <text x={AX} y={(yAlt(a) + 4.5).toFixed(1)} text-anchor="end" style={SANS}>{fmt(a)}</text>
          </>
        ))}
        <text x={AX} y={TOP - 12} text-anchor="end" style={SANS}>km</text>
        <text x={K0} y={TOP - 12} style={SANS}>Pressure</text>
        <line class="px-atmc__guide" x1={K1} y1={TOP} x2={K1} y2={GROUND} />
      </g>
      {bands.map((b) => (
        <g class="px-atmc__band" data-cue={b.id}>
          <rect x={C0} y={b.y0.toFixed(1)} width={C1 - C0} height={Math.max(0, b.y1 - b.y0).toFixed(1)} style={`fill:${bandFill(b.i)}`} data-build="1" data-build-kind="grow-y" />
          {b.y1 - b.y0 > 34 && (
            <text class="px-atmc__bl" x={C0 + 6} y={(b.y0 + 17).toFixed(1)} style={SANS} data-build="4">
              <tspan x={C0 + 6} class="px-atmc__bn">{b.name}</tspan>
              <tspan x={C0 + 6} dy={LH}>{b.range}</tspan>
            </text>
          )}
        </g>
      ))}
      <rect class="px-atmc__edge" x={C0} y={TOP} width={C1 - C0} height={GROUND - TOP} />
      <path class="px-atmc__curve" data-cue="curve" d={curveD} data-build="2" data-build-kind="draw" />
      <line class="px-atmc__ground" x1={AX + 2} y1={GROUND} x2={K1 + 4} y2={GROUND} />
      <text class="px-atmc__pct" x={K0} y={GROUND + 18} style={SANS}>0%</text>
      <text class="px-atmc__pct" x={K1} y={GROUND + 18} text-anchor="end" style={SANS}>100%</text>
      {blocks.map((b) => (
        <g class="px-atmc__pin" data-cue={b.p.i + 1}>
          <line class="px-atmc__dot-l" x1={C1} y1={b.p.y.toFixed(1)} x2={b.p.x.toFixed(1)} y2={b.p.y.toFixed(1)} data-build="3" />
          <polyline class="px-atmc__lead" points={`${b.p.x.toFixed(1)},${b.p.y.toFixed(1)} ${LX - 30},${(b.at + 5).toFixed(1)} ${LX - 24},${(b.at + 5).toFixed(1)}`} data-build="3" />
          <circle class="px-atmc__dot" cx={b.p.x.toFixed(1)} cy={b.p.y.toFixed(1)} r="3.5" data-build="3" data-build-kind="drop" />
          <text class="px-atmc__lt" x={LX} y={(b.at + 10).toFixed(1)} style={SANS} data-build="4" data-build-kind="rise">
            {b.name.map((ln, k) => <tspan x={LX} dy={k ? LH : 0} class="px-atmc__ln">{ln}</tspan>)}
            {b.stat.map((ln) => <tspan x={LX} dy={LH}>{ln}</tspan>)}
          </text>
        </g>
      ))}
    </svg>
    <CueLayer w={W} h={H} tags={tags} />
  </div>
  {logAlt && <p class="px-atmc__note">Height log-scaled</p>}
</div>

<style>
  .px-atmc__plot { position: relative; width: 100%; max-width: 380px; margin: 0 auto; }
  .px-atmc__fig { display: block; width: 100%; height: auto; overflow: visible; }
  .px-atmc__axis line { stroke: var(--muted); stroke-width: 1; }
  .px-atmc__axis text, .px-atmc__pct { font-size: 13.5px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .px-atmc__guide { stroke: var(--hair); stroke-width: 1; }
  .px-atmc__band rect { stroke: none; transform-origin: 50% 100%; }
  .px-atmc__edge { fill: none; stroke: var(--ink-2, var(--ink-soft)); stroke-width: 1.2; }
  .px-atmc__bl { font-size: 13.5px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .px-atmc__bn { font-weight: 600; fill: var(--ink-2, var(--ink-soft)); }
  .px-atmc__curve { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linejoin: round; }
  .px-atmc__ground { stroke: var(--ink); stroke-width: 1.2; }
  .px-atmc__dot { fill: var(--ink); stroke: var(--paper-2); stroke-width: 1.5; }
  .px-atmc__dot-l { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 3; }
  .px-atmc__lead { fill: none; stroke: var(--ink-2, var(--ink-soft)); stroke-width: 1; }
  .px-atmc__lt { font-size: 13.5px; fill: var(--ink-2, var(--ink-soft)); font-variant-numeric: tabular-nums; }
  .px-atmc__ln { font-weight: 600; fill: var(--ink); }
  .px-atmc__note { margin: 10px 0 0; font-family: var(--font-ui); font-size: 12px; color: var(--muted); text-align: center; }
  /* An SVG anchor lights by opacity alone: an outline on an SVG shape draws
     its bounding box, not a ring (the CueLayer numeral takes the ring). */
  svg [data-cue] { outline: none !important; }
</style>
