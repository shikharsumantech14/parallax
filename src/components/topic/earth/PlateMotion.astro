---
/**
 * PlateMotion (earth · WebGL · extends the shared country globe) — "the tectonic
 * engine, made visible." The real country Earth with the plate-boundary network
 * inked over it and, at a scatter of in-plate points, the surface-velocity arrows
 * each plate's Euler rotation actually produces — long where the plate races,
 * vanishing at its rotation pole. Drag to spin; hover an arrow for its exact speed
 * and bearing. Lazy WebGL (scene 'plate-motion').
 *
 * Blueprint (the contract): docs/design/blueprints/earth/plate-motion.md.
 * Math: the SAME pure `buildField`/`plateVelocity`/`arrowLen` (geodesy.md §4) from
 * the scene module compute the build-time fallback below, so the no-JS /
 * reduced-motion / no-WebGL reader gets the identical velocity field as a composed
 * orthographic-hemisphere still (§7): coastlines, boundaries, per-plate arrows, a
 * velocity scale key, the coordinate margin, and a field-note legend.
 *
 * LENS (Phase 6, the Lib-plate-motion board). The figure sits on the desk's
 * deep plate: the headline (the first plate's speed range), the globe, and a
 * key under it. The plate re-points `--ink` / `--paper` to the on-deep inks,
 * so the live scene (which reads them from the mount) and the fallback draw
 * light on dark alike. In the fallback the first plate's arrows are the desk
 * mark and the others the on-deep grey; an authored `color` colours the live
 * scene. Plate names and speeds are an HTML layer over the drawing (12px at
 * any width). The pole table sits under the plate, on paper.
 *
 * Cue anchors (on the fallback and its label layer, never the canvas): `1`…`n`
 * (each plate: its arrows and its name, authored order) · `convergent` ·
 * `divergent` · `transform` (the boundaries of each kind) · `head`.
 * Build (outside the mount, which the live scene replaces): the key (1) · the
 * headline number (2). The globe does not build; the scene keeps its one
 * idle loop.
 *
 * data: { plates[{name,pole{lat,lon,omega},color?,bbox?,samples?}], boundaries?,
 *         maxVel_mmyr?, caption?, source? (REQUIRED) }
 */
import FigHead from './FigHead.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { geoOrthographic, geoPath, geoGraticule, geoDistance } from 'd3-geo';
import { feature, mesh } from 'topojson-client';
import type { Topology, Objects } from 'topojson-specification';
import { buildField, type PlateSpec } from '../../../scripts/viz3d/scenes/plateMotion';

interface Props {
  plates?: PlateSpec[];
  boundaries?: string;
  maxVel_mmyr?: number;
  caption?: string;
  source?: string;
}
const { plates = [], boundaries = '/geo/plates.json', maxVel_mmyr, caption, source } = Astro.props;

/* earth-family fallback tints if a plate omits `color` (blueprint §6 discipline) */
const EARTH_FAMILY = ['#2d6a4f', '#a04922', '#1a4a36'];
const plateColor = (p: PlateSpec, i: number) => p.color || EARTH_FAMILY[i % EARTH_FAMILY.length];

const D2R = Math.PI / 180, R2D = 180 / Math.PI;
const round = (n: number, d = 2) => Math.round(n * 10 ** d) / 10 ** d;

/* ── the velocity field — computed with the SAME code the live scene runs ── */
const { arrows, maxVel } = buildField({ plates, maxVel_mmyr, _palette: EARTH_FAMILY });

/* peak |v| per plate (for the field-note legend) */
const peakByPlate = plates.map((_, i) =>
  arrows.filter((a) => a.plate === i).reduce((m, a) => Math.max(m, a.vMag), 0));

/* ── centre the hemisphere on the field's centroid (weighted to plate 0) ── */
const centerLon = plates[0]?.bbox ? (plates[0].bbox[0] + plates[0].bbox[2]) / 2 : 60;
const centerLat = plates[0]?.bbox ? (plates[0].bbox[1] + plates[0].bbox[3]) / 2 : 25;

const VW = 720, RAD = 320, CX = 360, CY = 360;
const proj = geoOrthographic().rotate([-centerLon, -centerLat]).scale(RAD).translate([CX, CY]).clipAngle(90);
const pathGen = geoPath(proj as any);
/* raw proj() never returns null for back-hemisphere points (only geoPath clips),
   so cull explicitly: a point is visible iff it is within 90° of the centre. */
const onFront = (lon: number, lat: number) => geoDistance([lon, lat], [centerLon, centerLat]) < Math.PI / 2;
const gratPath = pathGen(geoGraticule().step([15, 15])() as any) ?? '';

/* ── coastlines (world-atlas 50m, two-pass land render; geodesy §6) ── */
let landPath = '';
let coastPath = '';
try {
  const topo = JSON.parse(
    readFileSync(join(process.cwd(), 'node_modules/world-atlas/countries-50m.json'), 'utf-8'),
  ) as Topology<Objects<{}>>;
  const land = feature(topo, topo.objects['countries'] as any);
  landPath = pathGen(land as any) ?? '';
  coastPath = pathGen(mesh(topo, topo.objects['countries'] as any) as any) ?? '';
} catch { /* no coastlines ⇒ arrows + boundaries still print */ }

/* ── plate boundaries (read the same asset the scene fetches; dash by kind) ── */
interface Bnd { d: string; kind: 'div' | 'conv' | 'trans'; }
let bnds: Bnd[] = [];
try {
  const bpath = boundaries.startsWith('/') ? join(process.cwd(), 'public', boundaries.replace(/^\//, '')) : '';
  const bj = JSON.parse(readFileSync(bpath, 'utf-8'));
  const lines: number[][][] = Array.isArray(bj.lines) ? bj.lines : [];
  const kinds: string[] = Array.isArray(bj.kinds) ? bj.kinds : [];
  bnds = lines.map((line, i) => {
    const k = (kinds[i] === 'conv' || kinds[i] === 'trans') ? kinds[i] : 'div';
    return { d: pathGen({ type: 'LineString', coordinates: line } as any) ?? '', kind: k as Bnd['kind'] };
  }).filter((b) => b.d);
} catch { /* missing asset ⇒ arrows still render (blueprint §11) */ }
const DASHARRAY: Record<Bnd['kind'], string | undefined> = { div: undefined, conv: '7 4', trans: '1.6 4' };

/* ── arrows projected onto the orthographic plane (front hemisphere only) ──
   Direction is taken by stepping a small angular distance along the arrow's
   compass bearing and projecting both ends — this respects the orthographic
   distortion and drops far-side arrows automatically. */
function destPoint(lat: number, lon: number, bearingDeg: number, angDeg: number): [number, number] {
  const φ1 = lat * D2R, λ1 = lon * D2R, θ = bearingDeg * D2R, δ = angDeg * D2R;
  const φ2 = Math.asin(Math.sin(φ1) * Math.cos(δ) + Math.cos(φ1) * Math.sin(δ) * Math.cos(θ));
  const λ2 = λ1 + Math.atan2(Math.sin(θ) * Math.sin(δ) * Math.cos(φ1), Math.cos(δ) - Math.sin(φ1) * Math.sin(φ2));
  return [λ2 * R2D, φ2 * R2D];
}
interface PlateArrow { x: number; y: number; hx: number; hy: number; h1x: number; h1y: number; h2x: number; h2y: number; color: string; plate: number; }
const svgArrows: PlateArrow[] = [];
for (const a of arrows) {
  if (!onFront(a.lon, a.lat)) continue; // far hemisphere → dropped
  const p0 = proj([a.lon, a.lat]);
  const dst = destPoint(a.lat, a.lon, a.bearing, 1.5);
  const p1 = proj(dst as any);
  if (!p0 || !p1) continue;
  let dx = p1[0] - p0[0], dy = p1[1] - p0[1];
  const m = Math.hypot(dx, dy) || 1;
  dx /= m; dy /= m;
  const L = 60 * Math.min(1, a.vMag / maxVel); // §7: length ∝ |v|/maxVel · 60px (literal spec, saturates at the key length)
  const hx = p0[0] + dx * L, hy = p0[1] + dy * L;
  // open V head: two arms at ±150° from the shaft direction, length 0.32·L
  const ang = Math.atan2(dy, dx);
  const hl = 0.32 * L;
  const a1 = ang + Math.PI * (150 / 180), a2 = ang - Math.PI * (150 / 180);
  svgArrows.push({
    x: p0[0], y: p0[1], hx, hy,
    h1x: hx + Math.cos(a1) * hl, h1y: hy + Math.sin(a1) * hl,
    h2x: hx + Math.cos(a2) * hl, h2y: hy + Math.sin(a2) * hl,
    color: plateColor(plates[a.plate], a.plate),
    plate: a.plate,
  });
}

/* ── plate name labels at bbox centroids (front only) ── */
interface PLabel { x: number; y: number; name: string; }
const pLabels: PLabel[] = [];
plates.forEach((p) => {
  if (!p.bbox) return;
  const cLat = (p.bbox[1] + p.bbox[3]) / 2, cLon = (p.bbox[0] + p.bbox[2]) / 2;
  if (!onFront(cLon, cLat)) return;
  const pt = proj([cLon, cLat]);
  if (pt) pLabels.push({ x: pt[0], y: pt[1], name: p.name });
});

/* ── field-note legend rows (motif 3) ── */
const fmtLat = (v: number) => `${Math.abs(round(v, 1))}°${v >= 0 ? 'N' : 'S'}`;
const fmtLon = (v: number) => `${Math.abs(round(v, 1))}°${v >= 0 ? 'E' : 'W'}`;
const legendRows = plates.map((p, i) => ({
  name: p.name,
  color: plateColor(p, i),
  pole: `${fmtLat(p.pole.lat)} ${fmtLon(p.pole.lon)} · ${round(p.pole.omega, 3)}°/Myr`,
  peak: peakByPlate[i] > 0 ? `${Math.round(peakByPlate[i])} mm/yr` : '—',
}));
const showAll = legendRows.length <= 5;

/* coordinate margin (motif 2) */
const centerCoord = `${fmtLat(centerLat)}  ${fmtLon(centerLon)}`;
const maxVelLabel = Math.round(maxVel);

/* honesty chip (§3): if maxVel_mmyr is authored BELOW the true peak |v|, the
   longest arrows saturate at the length cap rather than reading to-scale — say so. */
const trueMaxVel = arrows.reduce((m, a) => Math.max(m, a.vMag), 0);
const clipped = typeof maxVel_mmyr === 'number' && maxVel_mmyr > 0 && maxVel_mmyr < trueMaxVel;
const scaleChip = clipped ? `arrows clipped at ${maxVelLabel} mm/yr` : `→ = ${maxVelLabel} mm/yr`;
const scaleKeyText = clipped ? `clipped at ${maxVelLabel} mm/yr` : `= ${maxVelLabel} mm/yr`;

/* payload for the live scene — poles + samples + colours (arrows recomputed
   client-side by the SAME buildField), NOT the projected geometry (≤4 KB). */
const payload = JSON.stringify({
  plates: plates.map((p, i) => ({
    name: p.name, pole: p.pole, color: plateColor(p, i), bbox: p.bbox, samples: p.samples,
  })),
  boundaries,
  maxVel_mmyr,
  _palette: EARTH_FAMILY,
});

/* ── plate names: an HTML layer over the drawing, placed in percent of the
   720 box so they print at 12px at any width. A name steps down while it
   would sit on one already placed (the box is judged at the desktop panel,
   where one unit is about 0.6px). ── */
const shortName = (n: string) => n.replace(/\s+plate$/i, '');
const speedOf = (i: number) => {
  const v = arrows.filter((a) => a.plate === i).map((a) => a.vMag);
  if (!v.length) return '';
  const lo = Math.round(Math.min(...v)), hi = Math.round(Math.max(...v));
  return lo === hi ? `${hi}` : `${lo}–${hi}`;
};
const placedNames: { x0: number; y0: number; x1: number; y1: number }[] = [];
const nameLabels = pLabels
  .map((l) => ({ ...l, i: plates.findIndex((p) => p.name === l.name) }))
  .sort((a, b) => a.y - b.y)
  .map((l) => {
    const sp = speedOf(l.i);
    const w = Math.max(shortName(l.name).length * 0.74, (sp.length + 6) * 0.56) * 21;
    let y = l.y;
    for (let k = 0; k < 8; k++) {
      const b = { x0: l.x - w / 2, y0: y - 20, x1: l.x + w / 2, y1: y + 26 };
      if (!placedNames.some((q) => b.x0 < q.x1 + 6 && q.x0 < b.x1 + 6 && b.y0 < q.y1 + 4 && q.y0 < b.y1 + 4)) { placedNames.push(b); break; }
      y += 48;
    }
    return { ...l, y, speed: sp, short: shortName(l.name) };
  });
const head = plates.length ? speedOf(0) : '';
const KIND_ID: Record<Bnd['kind'], string> = { conv: 'convergent', div: 'divergent', trans: 'transform' };
const kindsPresent = (['conv', 'div', 'trans'] as const).filter((k) => bnds.some((b) => b.kind === k));
const pct = (v: number) => ((v / VW) * 100).toFixed(2);
---

{plates.length > 0 && (
  <div class="px-viz px-plmot">
    {caption && (
      <div class="px-viz__cap">
        <span>{caption}</span>
        <b>{scaleChip}</b>
      </div>
    )}

    <div class="px-plmot__plate" data-build-scene>
      {head && <FigHead value={head} label={`mm a year, ${shortName(plates[0].name)}`} n={2} deep />}
      <div
        class="viz3d viz3d--plmot"
        data-viz3d="plate-motion"
        style="aspect-ratio: 1 / 1"
        role="img"
        aria-label={`Plate-motion globe centred on ${centerCoord}: ${plates.map((p, i) => `${p.name} ${speedOf(i)} mm a year`).join('; ')}.`}
      >
        <div class="viz3d__fallback">
          <svg viewBox={`0 0 ${VW} ${VW}`} preserveAspectRatio="xMidYMid meet">
            <circle cx={CX} cy={CY} r={RAD} fill="var(--paper-2)" />
            <path d={gratPath} fill="none" stroke="var(--ink)" stroke-width="0.6" opacity="0.14" />
            {landPath && <path d={landPath} fill="var(--px-plmot-land)" />}
            {coastPath && <path d={coastPath} fill="none" stroke="var(--ink)" stroke-width="0.8" opacity="0.3" />}
            {kindsPresent.map((k) => (
              <g data-cue={KIND_ID[k]}>
                {bnds.filter((b) => b.kind === k).map((b) => (
                  <path d={b.d} fill="none" stroke="var(--ink)" stroke-width="3" opacity="0.85"
                    stroke-dasharray={DASHARRAY[b.kind]} stroke-linecap="round" stroke-linejoin="round" />
                ))}
              </g>
            ))}
            {plates.map((_, i) => (
              <g class:list={['px-plmot__arrows', i === 0 && 'is-first']} data-cue={i + 1}>
                {svgArrows.filter((a) => a.plate === i).map((a) => (
                  <>
                    <line x1={a.x} y1={a.y} x2={a.hx} y2={a.hy} stroke-width="3" stroke-linecap="round" />
                    <path d={`M${a.h1x.toFixed(1)} ${a.h1y.toFixed(1)} L${a.hx.toFixed(1)} ${a.hy.toFixed(1)} L${a.h2x.toFixed(1)} ${a.h2y.toFixed(1)}`}
                      fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  </>
                ))}
              </g>
            ))}
            <circle cx={CX} cy={CY} r={RAD} fill="none" stroke="var(--ink)" stroke-width="1.5" opacity="0.35" />
          </svg>
          <div class="px-plmot__names">
            {nameLabels.map((l) => (
              <span class="px-plmot__nm" data-cue={l.i + 1} style={`left:${pct(l.x)}%;top:${pct(l.y)}%`}>
                <b><span class="px-cue-tag" data-cue-tag={l.i + 1} hidden></span>{l.short}</b>
                {l.speed && <i>{l.speed} mm/yr</i>}
              </span>
            ))}
            {kindsPresent.map((k) => {
              const b = bnds.find((x) => x.kind === k)!;
              const m = /M\s*([\d.]+)[ ,]([\d.]+)/.exec(b.d);
              return m ? <span class="px-plmot__bt" data-cue={KIND_ID[k]} style={`left:${pct(+m[1])}%;top:${pct(+m[2])}%`}><span class="px-cue-tag" data-cue-tag={KIND_ID[k]} hidden></span></span> : null;
            })}
          </div>
        </div>
        <span class="viz3d__hint" aria-hidden="true">drag to spin</span>
        <script type="application/json" class="viz3d__data" set:html={payload}></script>
      </div>
      <div class="px-plmot__key" data-build="1">
        <span><svg width="28" height="10" viewBox="0 0 28 10" aria-hidden="true"><path d="M1 5 H26 M21 1 L26 5 L21 9" /></svg>{scaleKeyText.replace(/^= /, '')}</span>
        {kindsPresent.map((k) => (
          <span><svg width="28" height="10" viewBox="0 0 28 10" aria-hidden="true"><line x1="1" y1="5" x2="27" y2="5" stroke-dasharray={DASHARRAY[k]} /></svg>{KIND_ID[k][0].toUpperCase() + KIND_ID[k].slice(1)}</span>
        ))}
      </div>
    </div>

    {/* the pole table: one row per plate, on paper under the plate */}
    {legendRows.length > 0 && (
      <div class={`px-plmot__legend${showAll ? '' : ' px-plmot__legend--collapsed'}`}>
        <div class="px-plmot__legend-head">
          <span>Euler pole</span>
          <span>Peak speed</span>
        </div>
        <ul class="px-plmot__rows">
          {legendRows.map((r, i) => (
            <li class={`px-plmot__row${!showAll && i >= 5 ? ' px-plmot__row--extra' : ''}`}>
              <span class="px-plmot__pl">{r.name}</span>
              <span class="px-plmot__po">{r.pole}</span>
              <span class="px-plmot__pk">{r.peak}</span>
            </li>
          ))}
        </ul>
        {!showAll && (
          <button type="button" class="px-plmot__more" aria-expanded="false">Show all {legendRows.length}</button>
        )}
      </div>
    )}

    {/* legend show-all bridge (no-JS shows all; JS hides extras) */}
    <script is:inline>
      (function () {
        var self = document.currentScript;
        var root = self && self.closest ? self.closest('.px-plmot') : (self ? self.parentElement : null);
        if (!root) return;
        var more = root.querySelector('.px-plmot__more');
        var legend = root.querySelector('.px-plmot__legend');
        if (more && legend) {
          more.addEventListener('click', function () {
            legend.classList.remove('px-plmot__legend--collapsed');
            more.setAttribute('aria-expanded', 'true');
            more.style.display = 'none';
          });
        }
      })();
    </script>
  </div>
)}

<style>
  /* the deep plate: the on-deep inks for everything drawn on it, the live
     scene included (runtime.ts reads --ink / --paper / --muted off the mount) */
  .px-plmot__plate {
    --ink: var(--on-deep);
    --ink-2: var(--on-deep-2);
    --ink-soft: var(--on-deep-2);
    --muted: var(--on-deep-2);
    --paper: var(--deep);
    --paper-2: color-mix(in oklab, var(--deep) 86%, var(--on-deep));
    --hair: var(--on-deep-hair);
    --px-plmot-land: color-mix(in oklab, var(--deep) 72%, var(--on-deep));
    background: var(--deep);
    border-radius: var(--r-card, 6px);
    padding: 20px;
  }
  .viz3d--plmot { background: transparent; }
  .px-plmot__arrows { stroke: var(--on-deep-2); }
  .px-plmot__arrows.is-first { stroke: var(--accent-lime, var(--accent)); }
  .px-plmot__names { position: absolute; inset: 0; pointer-events: none; }
  .px-plmot__nm {
    position: absolute; translate: -50% -50%;
    display: flex; flex-direction: column; align-items: center; gap: 1px;
    font-family: var(--font-ui); text-align: center; white-space: nowrap;
    text-shadow: 0 0 3px var(--deep), 0 0 6px var(--deep);
  }
  .px-plmot__nm b { display: inline-flex; align-items: center; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-deep); }
  .px-plmot__nm i { font-style: normal; font-size: 12px; color: var(--on-deep-2); font-variant-numeric: tabular-nums; }
  .px-plmot__bt { position: absolute; translate: -50% -50%; line-height: 0; }
  .px-plmot__bt :global(.px-cue-tag), .px-plmot__nm :global(.px-cue-tag) { color: var(--on-deep); margin-right: 6px; }
  .px-plmot__bt :global(.px-cue-tag) { margin: 0; }
  .px-plmot__key { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 14px; font-family: var(--font-ui); font-size: 12px; color: var(--on-deep-2); font-variant-numeric: tabular-nums; }
  .px-plmot__key span { display: inline-flex; align-items: center; gap: 7px; }
  .px-plmot__key svg { flex: none; fill: none; stroke: var(--on-deep); stroke-width: 2; }
  .px-plmot__key span:first-child svg { stroke: var(--accent-lime, var(--accent)); }

  /* the pole table, on paper */
  .px-plmot__legend { margin-top: 16px; font-family: var(--font-ui); font-variant-numeric: tabular-nums; }
  .px-plmot__legend-head {
    display: flex; justify-content: space-between; gap: 16px; padding-bottom: 8px;
    font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted);
    border-bottom: 1px solid var(--hair);
  }
  .px-plmot__rows { list-style: none; margin: 0; padding: 0; }
  .px-plmot__row { display: grid; grid-template-columns: 1fr auto auto; gap: 14px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--hair); font-size: 13px; }
  .px-plmot__pl { font-weight: 600; color: var(--ink); }
  .px-plmot__po { color: var(--ink-2, var(--ink-soft)); text-align: right; }
  .px-plmot__pk { font-weight: 600; color: var(--accent-deep); min-width: 8ch; text-align: right; }
  html.js .px-plmot__legend--collapsed .px-plmot__row--extra { display: none; }
  .px-plmot__more { margin-top: 10px; font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--accent-deep); background: none; border: none; padding: 4px 0; min-height: 44px; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  html:not(.js) .px-plmot__more { display: none; }
  @media (max-width: 760px) {
    .px-plmot__row { grid-template-columns: 1fr auto; row-gap: 2px; }
    .px-plmot__po { grid-column: 1 / -1; text-align: left; }
  }
  @media (max-width: 640px) { .px-plmot__plate { padding: 14px; } }
  /* An SVG anchor lights by opacity alone: an outline on an SVG shape draws
     its bounding box, not a ring (the CueLayer numeral takes the ring). */
  svg [data-cue] { outline: none !important; }
</style>
