---
/**
 * CoreSample (earth) — a drilled column read top down (Lens Phase 6, the
 * Lib-core-sample board). Each `layers` entry is a mark at its depth on the
 * column, with its depth on the left and its label (and value) on the right;
 * the band below a mark is that layer, tinted from the desk tint at the top to
 * the desk deep at the bottom (an authored `color` wins). When every depth
 * reads as a number and they run downward, the marks sit at their true depth;
 * otherwise they are spaced evenly. The column always continues below the last
 * mark (a torn edge). The first layer that carries a value is the figure's
 * headline number, with `unit` as its label.
 *
 * Cue anchors: `1`…`n` (each layer: its band, mark, depth and label, in
 * authored order) · `head` (the headline number).
 * Build: bands grow down (1) · marks and depths (2) · labels (3) · the
 * headline number (4).
 *
 * data: { layers[]{ depth, label, value?, color? }, unit?, caption?, source? }
 */
import FigHead from './FigHead.astro';
import CueLayer from './CueLayer.astro';
import { SANS, wrapWords, stack, fmt } from './_fig';

interface Layer { depth: string; label: string; value?: number; color?: string; }
interface Props { layers: Layer[]; unit?: string; caption?: string; source?: string; }
const { layers = [], unit = '', caption } = Astro.props;

const n = layers.length;
const W = 320, FS = 13.5, LH = 16;
const CX0 = 64, CX1 = 136, TAG_X = 151, LX = 166, LW = W - LX;
const TOP = 10, SCALE_H = 290;

/* depth → number, when it reads as one ("0–120 m", "25 cm", "3,000 m+") */
const num = (s: string) => {
  const m = /-?\d[\d,]*(\.\d+)?/.exec(String(s ?? ''));
  return m ? parseFloat(m[0].replace(/,/g, '')) : NaN;
};
const unitOf = (s: string) => /\d\s*([a-zA-Zµ]+)/.exec(String(s ?? ''))?.[1] ?? '';
const nums = layers.map((l) => num(l.depth));
const proportional = n > 1 && nums.every((v) => Number.isFinite(v)) && nums.every((v, i) => i === 0 || v > nums[i - 1]);
const d0 = proportional ? nums[0] : 0;
const dMax = proportional ? nums[n - 1] : 1;
/* the last mark sits at 82% of the scale; the column runs on below it */
const yOf = (i: number) =>
  TOP + (proportional ? ((nums[i] - d0) / (dMax - d0 || 1)) * SCALE_H * 0.82 : n > 1 ? (i / (n - 1)) * SCALE_H * 0.82 : 0);
const COL_BOTTOM = TOP + SCALE_H;

const tint = (i: number, l: Layer) => {
  if (l.color) return l.color;
  const t = n > 1 ? i / (n - 1) : 0;
  return t < 0.5
    ? `color-mix(in oklab, var(--accent-tint) ${Math.round(100 - t * 200)}%, var(--accent))`
    : `color-mix(in oklab, var(--accent) ${Math.round(200 - t * 200)}%, var(--deep, var(--ink)))`;
};
const valueText = (v: number) => `${fmt(v, 2)}${unit ? ' ' + unit : ''}`;

/* labels on the right: the label wrapped to three lines, the value under it */
const blocks = layers.map((l, i) => {
  const lines = wrapWords(String(l.label ?? ''), LW, FS, false, 3);
  const val = l.value != null ? wrapWords(valueText(l.value), LW, FS, false, 2) : [];
  const size = (lines.length + val.length) * LH;
  return { i, lines, val, size, want: yOf(i) - 5 };
});
const placed = stack(blocks, TOP - 5, 10_000, 8);
/* the depths on the left, one line each */
const ticks = stack(layers.map((l, i) => ({ i, want: yOf(i) - LH / 2, size: LH, text: proportional ? `${fmt(nums[i])} ${unitOf(l.depth)}`.trim() : String(l.depth) })), TOP - 8, 10_000, 2);

const H = Math.ceil(Math.max(COL_BOTTOM + 14, ...placed.map((p) => p.at + p.size + 6), ...ticks.map((t) => t.at + t.size + 4)));

const head = layers.find((l) => l.value != null);
const zig = (() => {
  const pts: string[] = [];
  for (let x = CX0, k = 0; x <= CX1 + 0.1; x += 9, k++) pts.push(`${x.toFixed(1)},${COL_BOTTOM + (k % 2 ? 5 : 0)}`);
  return pts.join(' ');
})();
const aria = `A drilled column with ${n} marks, top to bottom: ${layers.map((l) => `${l.depth}, ${l.label}${l.value != null ? `, ${valueText(l.value)}` : ''}`).join('; ')}.`;
---

<div class="px-viz px-core" data-build-scene>
  {caption && <div class="px-viz__cap"><span>{caption}</span></div>}
  {head && <FigHead value={fmt(head.value!, 2)} label={unit || undefined} n={4} />}

  <div class="px-core__plot" style={`--vbw:${W}px`}>
    <svg class="px-core__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
      {layers.map((l, i) => {
        const y = yOf(i);
        const yNext = i < n - 1 ? yOf(i + 1) : COL_BOTTOM;
        const b = placed[i];
        const t = ticks[i];
        return (
          <g class="px-core__layer" data-cue={i + 1}>
            <rect class="px-core__band" x={CX0} y={y.toFixed(1)} width={CX1 - CX0} height={Math.max(0, yNext - y).toFixed(1)} style={`fill:${tint(i, l)}`} data-build="1" data-build-kind="grow-y" />
            <line class="px-core__mark" x1={CX0 - 6} y1={y.toFixed(1)} x2={CX1 + 6} y2={y.toFixed(1)} data-build="2" />
            <text class="px-core__depth" x={CX0 - 10} y={(t.at + 12).toFixed(1)} text-anchor="end" style={SANS} data-build="2">{t.text}</text>
            <g data-build="3" data-build-kind="rise">
              {Math.abs(b.at + 5 - y) > 2 && <polyline class="px-core__lead" points={`${CX1 + 6},${y.toFixed(1)} ${TAG_X - 2},${(b.at + 7).toFixed(1)} ${LX - 4},${(b.at + 7).toFixed(1)}`} />}
              <text class="px-core__lbl" x={LX} y={(b.at + 12).toFixed(1)} style={SANS}>
                {b.lines.map((ln, k) => <tspan x={LX} dy={k ? LH : 0}>{ln}</tspan>)}
                {b.val.map((ln, k) => <tspan class="px-core__val" x={LX} dy={LH}>{ln}</tspan>)}
              </text>
            </g>
          </g>
        );
      })}
      <polyline class="px-core__torn" points={zig} />
      <rect class="px-core__edge" x={CX0} y={TOP} width={CX1 - CX0} height={COL_BOTTOM - TOP} />
    </svg>
    <CueLayer w={W} h={H} tags={placed.map((b) => ({ id: b.i + 1, x: TAG_X, y: b.at + 7 }))} />
  </div>
</div>

<style>
  .px-core__plot { position: relative; width: 100%; max-width: 380px; margin: 0 auto; }
  .px-core__svg { display: block; width: 100%; height: auto; overflow: visible; }
  .px-core__band { stroke: none; transform-origin: 50% 0; }
  .px-core__edge { fill: none; stroke: var(--ink); stroke-width: 1.5; }
  .px-core__torn { fill: none; stroke: var(--paper-2); stroke-width: 4; }
  .px-core__mark { stroke: var(--ink); stroke-width: 1.5; }
  .px-core__lead { fill: none; stroke: var(--hair-2); stroke-width: 1; }
  .px-core__depth { font-size: 13.5px; font-weight: 500; fill: var(--ink-2, var(--ink-soft)); font-variant-numeric: tabular-nums; }
  .px-core__lbl { font-size: 13.5px; font-weight: 500; fill: var(--ink); }
  .px-core__val { font-weight: 600; fill: var(--accent-deep); font-variant-numeric: tabular-nums; }
  /* An SVG anchor lights by opacity alone: an outline on an SVG shape draws
     its bounding box, not a ring (the CueLayer numeral takes the ring). */
  svg [data-cue] { outline: none !important; }
</style>
