---
/*
  CarbonGauge — remaining carbon budget arc gauge.
  SVG, build-time, zero runtime JS.

  Shows how much of a carbon budget has been used and what remains.
  Arc runs from LEFT (the start of the budget) over the TOP to RIGHT (the
  full budget) — a half-speedometer. The FILLED arc is what is already used
  (catalog + EXPLAIN: "an arc filled by what's already spent; the unfilled
  remainder is the budget left"); the needle sits at the boundary.

  props:
    remaining        — fraction 0–1 of budget remaining
    remainingGt      — human-readable label for remaining (e.g. "250 Gt CO₂")
    usedGt           — human-readable label for used (e.g. "550 Gt CO₂")
    totalGt          — human-readable total (e.g. "800 Gt CO₂")
    target           — temperature target label (e.g. "1.5 °C")
    year             — data year (e.g. "2024")
    caption
    source

  2026-09-24 — geometry rebuilt. The arcs were drawn with sweep-flag 0, which
  runs UNDER the centre, so the gauge painted as a U whose bottom half hung
  below the 280-unit viewBox and was cut off, and the filled arc ran the long
  way round. The end labels sat OUTSIDE the arc ends, end-/start-anchored
  toward the viewBox edges, so any authored value longer than ~9 characters
  left the SVG and was clipped ("sed since 2020"). Now: both arcs sweep over
  the top; the only text inside the SVG is the centre readout, which the arc
  frames; the end labels and the target line are HTML under the gauge, where
  they wrap at any length and render at real pixel sizes at every width. The
  SVG text is set in Literata (the one typeface) at sizes that stay at or
  above the 9.5px floor on a 375px phone, where the gauge draws at ~0.84×.
*/
interface Props {
  remaining: number;
  remainingGt?: string;
  usedGt?: string;
  totalGt?: string;
  target?: string;
  year?: string;
  caption?: string;
  source?: string;
}
const {
  remaining = 0.31,
  remainingGt,
  usedGt,
  totalGt,
  target,
  year,
  caption,
  source,
} = Astro.props;

const W = 400;
const SW = 16;                 // arc stroke width
const R = 170;                 // arc radius (centre line of the stroke)
const cx = W / 2;              // 200
const cy = R + SW / 2 + 12;    // arc top outer edge sits 12 units under the top
const H = cy + 8;              // the arc ends are flat (butt) at cy

// Point at fraction u along the arc, left end (u = 0) → over the top → right end (u = 1).
const at = (u: number) => ({ x: cx - R * Math.cos(u * Math.PI), y: cy - R * Math.sin(u * Math.PI) });
const x0 = cx - R, x1 = cx + R;
// sweep-flag 1 = clockwise on screen = up and over the top from left to right.
const trackPath = `M ${x0},${cy} A ${R},${R} 0 0,1 ${x1},${cy}`;

const f = Math.max(0, Math.min(1, remaining));
const used = 1 - f;                         // the filled share
const n = at(used);                         // the needle: used | remaining
const usedPath = used > 0.001
  ? `M ${x0},${cy} A ${R},${R} 0 0,1 ${n.x.toFixed(2)},${n.y.toFixed(2)}`
  : '';

// Pick color based on remaining fraction
const gaugeColor = f > 0.5 ? '#2d6a4f' : f > 0.25 ? '#f4a261' : '#e63946';
const pct = Math.round(f * 100);

// Tick marks at 25%, 50%, 75% of the budget — radial, across the stroke
const ticks = [0.25, 0.5, 0.75].map((u) => {
  const p = at(u);
  const rx = (p.x - cx) / R, ry = (p.y - cy) / R;
  const h = SW * 0.6;
  return { x1: p.x - rx * h, y1: p.y - ry * h, x2: p.x + rx * h, y2: p.y + ry * h };
});

const SERIF = "font-family:Literata,Georgia,'Times New Roman',serif";

// The remaining-Gt line sits inside the arc; wrap it to the chord the arc
// leaves free at its height (inner radius R − SW/2), ~0.52em per character.
const RG_FS = 14, RG_Y = cy - 104;
const chord = 2 * Math.sqrt(Math.max(0, (R - SW / 2) ** 2 - (cy - RG_Y + RG_FS) ** 2)) - 16;
const rgMax = Math.max(8, Math.floor(chord / (RG_FS * 0.52)));
const rgLines: string[] = [];
for (const word of (remainingGt ?? '').split(/\s+/).filter(Boolean)) {
  const last = rgLines[rgLines.length - 1];
  if (last && (last + ' ' + word).length <= rgMax) rgLines[rgLines.length - 1] = last + ' ' + word;
  else rgLines.push(word);
}
// two lines at most; the first climbs so the block stays clear of the readout
const rgShown = rgLines.length > 2 ? [rgLines[0], rgLines.slice(1).join(' ')] : rgLines;
const rgTop = RG_Y - (rgShown.length - 1) * (RG_FS + 3);
const meta = [target, year].filter(Boolean).join(' · ');
---

<div class="px-cgauge" data-viz-root data-reveal>
  {caption && <div class="px-cgauge__caption">{caption}</div>}

  <svg viewBox={`0 0 ${W} ${H}`} class="px-cgauge__svg" role="img"
    aria-label={`Carbon budget gauge: ${pct}% remaining`}>

    <!-- Track (the whole budget) -->
    <path d={trackPath}
      style={`fill:none;stroke:var(--rule);stroke-width:${SW};stroke-linecap:butt;opacity:0.8`} />

    <!-- Used arc (filled, from the start of the budget to the needle) -->
    {usedPath && (
      <path d={usedPath}
        style={`fill:none;stroke:${gaugeColor};stroke-width:${SW};stroke-linecap:butt`} />
    )}

    <!-- Tick marks at 25%, 50%, 75% -->
    {ticks.map((t) => (
      <line x1={t.x1.toFixed(2)} y1={t.y1.toFixed(2)} x2={t.x2.toFixed(2)} y2={t.y2.toFixed(2)}
        style="stroke:var(--bg);stroke-width:2;opacity:0.9" />
    ))}

    <!-- Needle -->
    <circle cx={n.x.toFixed(2)} cy={n.y.toFixed(2)} r={6}
      style={`fill:${gaugeColor};stroke:var(--bg);stroke-width:2`} />

    {/* Remaining Gt label above the readout, inside the arc */}
    {rgShown.length > 0 && (
      <text x={cx} y={rgTop} text-anchor="middle"
        style={`${SERIF};font-size:${RG_FS}px;fill:var(--ink-soft);letter-spacing:0.01em`}>
        {rgShown.map((ln, i) => <tspan x={cx} dy={i === 0 ? 0 : RG_FS + 3}>{ln}</tspan>)}
      </text>
    )}

    <!-- Center readout -->
    <text x={cx} y={cy - 26} text-anchor="middle"
      style={`${SERIF};font-size:60px;font-weight:600;fill:${gaugeColor};letter-spacing:-0.02em`}>
      {pct}%
    </text>
    <text x={cx} y={cy - 4} text-anchor="middle"
      style={`${SERIF};font-size:12px;font-weight:600;fill:var(--muted);letter-spacing:0.14em;text-transform:uppercase`}>
      remaining
    </text>
  </svg>

  {(usedGt || totalGt) && (
    <div class="px-cgauge__ends">
      <p class="px-cgauge__end">
        <span class="px-cgauge__k">Used</span>
        {usedGt && <span class="px-cgauge__v">{usedGt}</span>}
      </p>
      <p class="px-cgauge__end px-cgauge__end--r">
        <span class="px-cgauge__k">Full</span>
        {totalGt && <span class="px-cgauge__v">{totalGt}</span>}
      </p>
    </div>
  )}
  {meta && <p class="px-cgauge__meta">{meta}</p>}

  {/* No source line here. `core/Section.astro` is the ONE source emitter
     since 2026-09-04; this component's was a `__source` survivor of that
     sweep, which matched `__src`, so every section with a source printed
     it twice (measured live 2026-09-22). Same shape as Comparison's. */}
</div>

<style>
  /* The end labels and the target line sit under the gauge, on the same
     480px measure as the SVG (earth.css), so each end block lines up under
     its arc end. HTML, so they wrap at any authored length. */
  .px-cgauge__ends {
    max-width: 480px;
    margin: 6px auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .px-cgauge__end { margin: 0; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .px-cgauge__end--r { text-align: right; align-items: flex-end; }
  .px-cgauge__k {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .px-cgauge__v {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    overflow-wrap: break-word;
  }
  .px-cgauge__meta {
    max-width: 480px;
    margin: 14px auto 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
