---
/*
  RegionMap (earth) — a build-time choropleth (Lens Phase 6, the
  Lib-region-map board). 50m Natural Earth, the projection FITTED to the
  authored zones and markers (2026-09-22; world framing past 150 deg of
  longitude), drawn at the figure panel's width (460 units) so every label
  prints at 12px there; a phone scrolls it inside its card at that size.

  Lens colour: the ocean a pale wash of the desk tint, land with no value in
  the paper's well, a zone shaded from the desk tint (value 0) to the desk
  mark (value 1), hair-white borders. Markers are paper dots ringed in ink
  (an `event` marker is solid ink). Zone names in 600 capitals, marker names
  in 500, both 12px Instrument Sans on a paper halo. The legend is HTML under
  the map: two swatches when the zones carry at most three values, else the
  ramp with its two ends; `legend.none` adds the no-data swatch. `palette`
  names what the fill measures when no legend title is authored (the hue is
  the desk's, LENS §2). Zone notes list under the legend.

  Cue anchors: `1`…`n` (each zone with a value, authored order: its fill and
  its name) · `m1`…`mk` (each marker, authored order: its dot and its name) ·
  `legend`.
  Build: land and ocean (1) · zone fills (2) · markers drop (3) · names rise
  (4).

  Zone IDs: ISO 3166-1 numeric strings
    India = "356"   Brazil = "076"   China = "156"   USA = "840"
    Russia = "643"  Germany = "276"  UK = "826"      Japan = "392"
    Australia = "036"  Canada = "124"  Indonesia = "360"  Pakistan = "586"
    Bangladesh = "050" Nepal = "524"   Sri Lanka = "144"  Myanmar = "104"
    Thailand = "764"   Vietnam = "704" Philippines = "608" Malaysia = "458"
    France = "250"  Spain = "724"   Italy = "380"   Poland = "616"
    Argentina = "032"  Mexico = "484"  Colombia = "170"
    South Africa = "710"  Nigeria = "566"  Ethiopia = "231"  DR Congo = "180"
    Egypt = "818"   Kenya = "404"   Tanzania = "834"  Sudan = "729"
*/
import { geoNaturalEarth1, geoMercator, geoPath, geoBounds } from 'd3-geo';
import { feature } from 'topojson-client';
import type { Topology, Objects } from 'topojson-specification';
import { readFileSync } from 'fs';
import { join } from 'path';
import CueLayer from './CueLayer.astro';

type Palette = 'earth' | 'heat' | 'flood' | 'drought' | 'conflict';
type ProjectionName = 'naturalEarth' | 'mercator';

interface Zone {
  id: string;       // ISO 3166-1 numeric string
  label?: string;
  value: number;    // 0–1 choropleth intensity
  note?: string;
}

interface Marker {
  lat: number;
  lng: number;
  label?: string;
  kind?: 'city' | 'event' | 'data-point';
}

interface Props {
  projection?: ProjectionName;
  palette?: Palette;
  zones?: Zone[];
  markers?: Marker[];
  legend?: { title?: string; low?: string; high?: string; none?: string };
  caption?: string;
  source?: string;
}

const {
  projection: projName = 'naturalEarth',
  palette = 'earth',
  zones = [],
  markers = [],
  legend,
  caption,
  source,
} = Astro.props;

// ── Canvas ──────────────────────────────────────────────────────────────────
const W = 460;
const H = 330;

// ── Topology — 50m for sharp coastlines ─────────────────────────────────────
const topo = JSON.parse(
  readFileSync(join(process.cwd(), 'node_modules/world-atlas/countries-50m.json'), 'utf-8')
) as Topology<Objects<{}>>;
const countriesFC = feature(topo, topo.objects['countries'] as any);

/* ── Projection: FRAME THE AUTHORED DATA, not the globe (2026-09-22) ─────────
   Both projections used to be pinned to world scale (140 / 128), so an issue
   about Indonesia drew the whole planet and crammed its thirteen labels into
   one corner. The projection is now FITTED to the geographic extent of the
   countries that carry a value PLUS every marker, padded by ~8% of the
   viewBox on each side.

   Two guards keep the fit honest:
     · CEILING — the scale is capped at 6x world scale. Past that one small
       country fills the card and the reader loses the surrounding coastline
       that tells them where on Earth they are looking.
     · WORLD FLOOR — if the zones span more than 150 deg of longitude (a
       genuinely global story, e.g. "where India's arrivals come from"), or if
       the fit would not zoom in past world scale at all, the map keeps its
       world framing exactly as before.

   Countries with no value are still drawn — they are the context the frame
   falls across. clipExtent trims the drawn geometry to the card rather than
   emitting path strings for continents that are entirely off-screen.
*/
const WORLD_SCALE = (projName === 'mercator' ? 128 : 140) * W / 800;
const MAX_SCALE = WORLD_SCALE * 6;   // ceiling
const PAD_X = Math.round(W * 0.06);
const PAD_Y = Math.round(H * 0.06);
const WORLD_LON_SPAN = 150;          // wider than this keeps world framing

const projFn = projName === 'mercator' ? geoMercator() : geoNaturalEarth1();

function frameWorld() {
  if (projName === 'mercator') projFn.scale(128 * W / 800).translate([W / 2, H / 1.85]);
  else projFn.scale(140 * W / 800).translate([W / 2, H / 2 + 10]);
}
frameWorld();

const zoneIds = new Set(zones.map(z => String(z.id)));
const fitFeatures: any[] = [
  ...(countriesFC.features as any[]).filter((f: any) => zoneIds.has(String(f.id))),
  ...markers.map(m => ({
    type: 'Feature',
    properties: {},
    geometry: { type: 'Point', coordinates: [m.lng, m.lat] },
  })),
];

let framed = false;   // true = fitted to the data; false = the old world framing
let lonSpan = 360;

if (fitFeatures.length > 0) {
  const fitFC = { type: 'FeatureCollection', features: fitFeatures } as any;
  const [[lon0, lat0], [lon1, lat1]] = geoBounds(fitFC);
  // geoBounds returns a wrapped range when the extent crosses the antimeridian.
  lonSpan = lon1 >= lon0 ? lon1 - lon0 : 360 - (lon0 - lon1);

  if (Number.isFinite(lonSpan) && Number.isFinite(lat0) && lonSpan <= WORLD_LON_SPAN) {
    projFn.fitExtent([[PAD_X, PAD_Y], [W - PAD_X, H - PAD_Y]], fitFC);
    const fitScale = projFn.scale();

    if (Number.isFinite(fitScale) && fitScale > WORLD_SCALE * 1.05) {
      const scale = Math.min(fitScale, MAX_SCALE);
      if (scale !== fitScale) {
        // Capped by the ceiling — re-centre the extent in the card by hand.
        let lonC = lon0 + lonSpan / 2;
        if (lonC > 180) lonC -= 360;
        const latC = (lat0 + lat1) / 2;
        projFn.scale(scale).translate([0, 0]);
        const p = projFn([lonC, latC]) ?? [0, 0];
        projFn.translate([W / 2 - p[0], H / 2 - p[1]]);
      }
      framed = true;
    } else {
      frameWorld();   // the fit wanted world scale or wider — keep the globe
    }
  }
}

if (framed) projFn.clipExtent([[0, 0], [W, H]]);

const pathGen = geoPath(projFn);

// ── Colour: the desk ramp, tint (0) to mark (1) ─────────────────────────────
/* `palette` names what the fill measures, printed as the legend title when
   none is authored; the hue is always the desk's (LENS §2). */
const PALETTE_TITLE: Record<Palette, string> = {
  earth: 'Relative intensity', heat: 'Relative pressure', flood: 'Relative exposure', drought: 'Relative dryness', conflict: 'Relative severity',
};
const noDataColor = 'var(--px-map-land)';
const valueMap = new Map(zones.map(z => [String(z.id), z.value]));
const zoneIndex = new Map(zones.map((z, i) => [String(z.id), i + 1]));
const ramp = (v: number) =>
  `color-mix(in oklab, var(--accent) ${Math.round(Math.max(0, Math.min(1, v)) * 100)}%, var(--accent-tint))`;
function fill(id: string) {
  const v = valueMap.get(id);
  return v !== undefined ? ramp(v) : noDataColor;
}

// ── Pre-render all paths at build time ──────────────────────────────────────
const paths = (countriesFC.features as any[])
  .map((f: any) => {
    const d = pathGen(f);
    if (!d) return null;
    const id = String(f.id ?? '');
    return { d, id, fill: fill(id), active: valueMap.has(id), cue: zoneIndex.get(id) };
  })
  .filter(Boolean) as { d: string; id: string; fill: string; active: boolean; cue?: number }[];

const spherePath = framed ? '' : (pathGen({ type: 'Sphere' } as any) ?? '');
const clipId = `px-map-clip-${Math.abs([...zones.map(z => z.id), ...markers.map(m => m.lat)].join('|').split('').reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7)).toString(36)}`;

// ── Legend (HTML, under the map) ─────────────────────────────────────────────
const legTitle = legend?.title ?? PALETTE_TITLE[palette] ?? '';
const vals = zones.map(z => z.value).filter(v => Number.isFinite(v));
const vLo = vals.length ? Math.min(...vals) : 0, vHi = vals.length ? Math.max(...vals) : 1;
const discrete = new Set(vals).size <= 3;
const legLow = legend?.low ?? 'Lower';
const legHigh = legend?.high ?? 'Higher';
const legNone = legend?.none ?? '';
const hasLegend = zones.length > 0;

/* ── Label placement (2026-09-22; 12px and Lens faces 2026-09-30) ────────────
   Labels are authored at 12px, LENS's floor (§3), in Instrument Sans: zone
   names in 600 capitals, marker names in 500. The SVG keeps its 800-unit
   width in the figure panel and on a phone (the card scrolls, dataviz-v2.css),
   so 12 authored is 12 rendered. They were 9.5px in Fraunces and JetBrains
   Mono, two faces Lens retired. A zone name of two or more words may also
   break onto two lines when its one-line spot is taken.

   THE OVERLAP RULE, chosen once here so it is not re-decided per map:
     · MARKERS ARE PLACED FIRST AND NEVER YIELD to a zone label. A marker names
       one exact point the section is about; a country label only names the fill
       it sits on, and the legend already explains the fill.
     · Two labels collide when their boxes overlap — each box is one label
       height (16 units) tall, so in practice: vertical centres within a label
       height of each other AND horizontal overlap of the estimated text width.
     · A colliding label is offset VERTICALLY ONLY — 0, −16, +16, −32, +32 in
       that order, then ±48 and ±64 while the name stays inside its own
       country's bounds (a marker label may also flip to the other side of its
       dot, and a zone name of two or more words may take two lines).
       Vertical-only keeps a country label over its own country.
     · If no offset in that ladder is free, the label is DROPPED. For a zone
       that means the marker sitting on it carries the name, which is the more
       specific label anyway; two labels stacked on each other read as neither.
     · The legend box, every marker dot and the card edge are pre-occupied, so
       no label can land under the legend or bleed outside the SVG.
*/
/* Width model, MEASURED off rendered SVG text in Chrome rather than guessed
   (the first pass guessed and let MADAGASCAR sit on ANGOLA). Instrument Sans
   capitals at 12px and 0.06em tracking run 0.64 to 0.74em a character, the
   mixed-case marker names 0.46 to 0.49em. The per-character figures below
   are rounded up to the worst case, and every label carries a halo stroke
   that adds ~4 to the painted box: over-reserving only moves a label that
   would just have cleared. */
const LABEL_FS = 12;
const LABEL_H = 16;                // one 12px line with its halo
const ZONE_CH = 12 * 0.76, ZONE_HALO = 4;   // 600 capitals, .06em tracking
const MARK_CH = 12 * 0.53, MARK_HALO = 4;   // 500 mixed case, .02em tracking
const EDGE = 6;
const LABEL_FONT = "font-family:'Instrument Sans','Helvetica Neue',Arial,sans-serif";

type Box = { x0: number; x1: number; y0: number; y1: number };
const occupied: Box[] = [];

function place<T extends { x0: number; x1: number; y: number; h?: number }>(options: T[]): T | null {
  for (const o of options) {
    const h = o.h ?? LABEL_H;
    const b: Box = { x0: o.x0, x1: o.x1, y0: o.y - h / 2, y1: o.y + h / 2 };
    if (b.x0 < EDGE || b.x1 > W - EDGE || b.y0 < EDGE || b.y1 > H - EDGE) continue;
    if (occupied.some(p => b.x0 < p.x1 && b.x1 > p.x0 && b.y0 < p.y1 && b.y1 > p.y0)) continue;
    occupied.push(b);
    return o;
  }
  return null;
}

// ── Project markers (placed first — they win every collision) ────────────────
const projMarkers = markers
  .map(m => {
    const pt = projFn([m.lng, m.lat]);
    if (!pt || !Number.isFinite(pt[0]) || !Number.isFinite(pt[1])) return null;
    const x = Math.round(pt[0]), y = Math.round(pt[1]);
    if (x < 0 || x > W || y < 0 || y > H) return null;
    return { ...m, src: m, x, y };
  })
  .filter(Boolean) as (Marker & { src: Marker; x: number; y: number })[];

// The dots themselves block labels before any text is placed.
projMarkers.forEach(m => occupied.push({ x0: m.x - 8, x1: m.x + 8, y0: m.y - 8, y1: m.y + 8 }));

const MARK_DY = [0, -LABEL_H, LABEL_H, -2 * LABEL_H, 2 * LABEL_H, -3 * LABEL_H, 3 * LABEL_H];
const placedMarkers = projMarkers.map(m => {
  const blank = { ...m, lx: 10, ly: 0, anchor: 'start' as 'start' | 'end', showLabel: false };
  if (!m.label) return blank;
  const w = m.label.length * MARK_CH + MARK_HALO;
  const options: { x0: number; x1: number; y: number; dx: number; anchor: 'start' | 'end' }[] = [];
  for (const dy of MARK_DY) {
    options.push({ x0: m.x + 8, x1: m.x + 12 + w, y: m.y + dy, dx: 10, anchor: 'start' });
    options.push({ x0: m.x - 12 - w, x1: m.x - 8, y: m.y + dy, dx: -10, anchor: 'end' });
  }
  const got = place(options);
  if (!got) return blank;
  return { ...m, lx: got.dx, ly: got.y - m.y, anchor: got.anchor, showLabel: true };
});

// ── Zone label centroids ─────────────────────────────────────────────────────
const labels = zones
  .filter(z => z.label)
  .map(z => {
    const feat = (countriesFC.features as any[]).find((f: any) => String(f.id) === z.id);
    if (!feat) return null;
    const c = pathGen.centroid(feat);
    if (!c || !Number.isFinite(c[0]) || !Number.isFinite(c[1])) return null;
    const text = z.label!.toUpperCase();
    const x = Math.round(c[0]), y = Math.round(c[1]);
    // A large country may move its name further, three or four lines from its
    // centroid, but only while the name's centre stays inside the country's
    // own drawn bounds: a big zone whose centroid the markers crowd (the
    // Indonesia issue) keeps its name, a small one never wanders off itself.
    const [[, by0], [, by1]] = pathGen.bounds(feat);
    const LADDER = [0, -LABEL_H, LABEL_H, -2 * LABEL_H, 2 * LABEL_H,
      ...[-3, 3, -4, 4].map(k => k * LABEL_H).filter(dy => y + dy > by0 + LABEL_H / 2 && y + dy < by1 - LABEL_H / 2)];
    // one line, then (for a name of two or more words) two balanced lines
    const words = text.split(' ');
    let split: string[] | null = null;
    if (words.length > 1) {
      let best = 1, bestW = Infinity;
      for (let k = 1; k < words.length; k++) {
        const wk = Math.max(words.slice(0, k).join(' ').length, words.slice(k).join(' ').length);
        if (wk < bestW) { bestW = wk; best = k; }
      }
      split = [words.slice(0, best).join(' '), words.slice(best).join(' ')];
    }
    const w1 = text.length * ZONE_CH + ZONE_HALO;
    const opts: { x0: number; x1: number; y: number; h?: number; lines: string[] }[] =
      LADDER.map(dy => ({ x0: x - w1 / 2 - 2, x1: x + w1 / 2 + 2, y: y + dy, lines: [text] }));
    if (split) {
      const w2 = Math.max(...split.map(l => l.length)) * ZONE_CH + ZONE_HALO;
      LADDER.forEach(dy => opts.push({ x0: x - w2 / 2 - 2, x1: x + w2 / 2 + 2, y: y + dy, h: LABEL_H * 2 - 2, lines: split! }));
    }
    const got = place(opts);
    if (!got) return null;   // dropped — a marker or the legend already owns that spot
    return { lines: got.lines, x, y: got.y, cue: zoneIndex.get(String(z.id)) };
  })
  .filter(Boolean) as { lines: string[]; x: number; y: number; cue?: number }[];

// ── Zone notes ───────────────────────────────────────────────────────────────
const notes = zones.filter(z => z.note);
const markerIdx = new Map(markers.map((m, i) => [m, i + 1]));
const tags = [
  ...labels.map(l => ({ id: l.cue, x: l.x, y: l.y - 14 })),
  ...placedMarkers.map(m => ({ id: `m${markerIdx.get(m.src) ?? 0}`, x: m.x - 11, y: m.y - 11 })),
];
---

<div class="px-map" data-viz-root data-build-scene>
  {caption && <div class="px-map__caption">{caption}</div>}

  <div class="px-map__plot">
    <svg
      class="px-map__fig"
      viewBox={`0 0 ${W} ${H}`}
      xmlns="http://www.w3.org/2000/svg"
      aria-label={caption ?? `Map: ${zones.map(z => z.label).filter(Boolean).join(', ')}`}
      role="img"
    >
      <defs>
        <clipPath id={clipId}>
          {framed ? <rect x="0" y="0" width={W} height={H} /> : <path d={spherePath} />}
        </clipPath>
      </defs>

      <g data-build="1">
        {framed
          ? <rect class="px-map__sea" x="0" y="0" width={W} height={H} />
          : <path class="px-map__sea" d={spherePath} />}
        <g clip-path={`url(#${clipId})`}>
          {paths.filter(p => !p.active).map(p => <path class="px-map__land" d={p.d} />)}
        </g>
      </g>
      <g clip-path={`url(#${clipId})`}>
        {paths.filter(p => p.active).map(p => (
          <path class="px-map__zone" d={p.d} style={`fill:${p.fill}`} data-cue={p.cue} data-build="2" />
        ))}
      </g>
      {!framed && <path class="px-map__rim" d={spherePath} />}

      {labels.map(l => (
        <text
          class="px-map__zl"
          data-cue={l.cue}
          x={l.x} y={l.y - ((l.lines.length - 1) * (LABEL_H - 2)) / 2}
          text-anchor="middle"
          dominant-baseline="central"
          style={`${LABEL_FONT};font-size:${LABEL_FS}px;`}
          data-build="4" data-build-kind="rise"
        >
          {l.lines.map((ln, li) => <tspan x={l.x} dy={li === 0 ? 0 : LABEL_H - 2}>{ln}</tspan>)}
        </text>
      ))}

      {placedMarkers.map(m => (
        <g class:list={['px-map__mk', m.kind === 'event' && 'is-event']} data-cue={`m${markerIdx.get(m.src) ?? 0}`} transform={`translate(${m.x},${m.y})`}>
          <circle r={m.kind === 'event' ? 5.5 : 4.5} data-build="3" data-build-kind="drop" />
          {m.label && m.showLabel && (
            <text
              x={m.lx} y={m.ly + 0.5}
              text-anchor={m.anchor}
              dominant-baseline="central"
              style={`${LABEL_FONT};font-size:${LABEL_FS}px;`}
              data-build="4" data-build-kind="rise"
            >{m.label}</text>
          )}
        </g>
      ))}
    </svg>
    <CueLayer w={W} h={H} tags={tags} />
  </div>

  {hasLegend && (
    <div class="px-map__key" data-cue="legend">
      {legTitle && <p class="px-map__kt"><span class="px-cue-tag" data-cue-tag="legend" hidden></span>{legTitle}</p>}
      <div class="px-map__kr">
        {discrete ? (
          <>
            <span><i style={`background:${ramp(vHi)}`}></i>{legHigh}</span>
            {vHi !== vLo && <span><i style={`background:${ramp(vLo)}`}></i>{legLow}</span>}
          </>
        ) : (
          <span class="px-map__ramp"><b>{legLow}</b><i class="px-map__grad" style={`background:linear-gradient(90deg, ${ramp(vLo)}, ${ramp(vHi)})`}></i><b>{legHigh}</b></span>
        )}
        {legNone && <span><i class="px-map__none"></i>{legNone}</span>}
      </div>
    </div>
  )}

  {notes.length > 0 && (
    <ul class="px-map__notes">
      {notes.map(z => (
        <li class="px-map__note" data-cue={zoneIndex.get(String(z.id))}>
          {z.label && <strong class="px-map__note-label">{z.label}</strong>}
          {z.note}
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .px-map { --px-map-land: #E4DFD3; }
  .px-map__plot { position: relative; width: 100%; }
  .px-map__fig { display: block; width: 100%; height: auto; border-radius: 4px; }
  .px-map__sea { fill: color-mix(in oklab, var(--accent-tint) 35%, var(--paper-2)); }
  .px-map__land { fill: var(--px-map-land); stroke: var(--paper-2); stroke-width: 0.8; stroke-linejoin: round; }
  .px-map__zone { stroke: var(--paper-2); stroke-width: 0.8; stroke-linejoin: round; }
  .px-map__rim { fill: none; stroke: var(--hair-2); stroke-width: 1; }
  .px-map__zl {
    font-weight: 600; letter-spacing: 0.06em; fill: var(--ink-2, var(--ink-soft));
    paint-order: stroke; stroke: var(--paper-2); stroke-width: 3px; stroke-linejoin: round; stroke-opacity: 0.85;
  }
  .px-map__mk circle { fill: var(--paper); stroke: var(--ink); stroke-width: 1.6; }
  .px-map__mk.is-event circle { fill: var(--ink); stroke: var(--paper); }
  .px-map__mk text {
    font-weight: 500; fill: var(--ink);
    paint-order: stroke; stroke: var(--paper-2); stroke-width: 3.5px; stroke-linejoin: round;
  }
  .px-map__key { margin-top: 12px; font-family: var(--font-ui); font-size: 12px; line-height: 1.4; color: var(--muted); }
  .px-map__kt { margin: 0 0 6px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; display: flex; align-items: center; }
  .px-map__kr { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; }
  .px-map__kr > span { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: var(--ink-2, var(--ink-soft)); }
  .px-map__kr i { display: inline-block; flex: none; width: 14px; height: 14px; border-radius: 2px; }
  .px-map__ramp { flex: 1 1 220px; }
  .px-map__ramp b { font-weight: 500; }
  .px-map__kr i.px-map__grad { flex: 1 1 auto; width: auto; min-width: 60px; height: 10px; }
  .px-map__kr i.px-map__none { background: var(--px-map-land); border: 1px solid var(--hair-2); }
  .px-map__notes { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 6px; font-family: var(--font-ui); font-size: 13px; line-height: 1.45; color: var(--ink-2, var(--ink-soft)); }
  .px-map__note-label { font-weight: 600; color: var(--ink); margin-right: 6px; }
  /* A phone scrolls the map inside its card at its drawn size (12px names). */
  @media (max-width: 900px) { .px-map__plot { min-width: 460px; } }
  /* An SVG anchor lights by opacity alone: an outline on an SVG shape draws
     its bounding box, not a ring (the CueLayer numeral takes the ring). */
  svg [data-cue] { outline: none !important; }
</style>
