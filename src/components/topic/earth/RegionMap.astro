---
/*
  RegionMap v2 — build-time choropleth world map.
  50m Natural Earth resolution. Transparent SVG — integrates with page bg.
  Legend lives inside the SVG as a cartographic box. Zero runtime JS.

  Zone IDs: ISO 3166-1 numeric strings
    India = "356"   Brazil = "076"   China = "156"   USA = "840"
    Russia = "643"  Germany = "276"  UK = "826"      Japan = "392"
    Australia = "036"  Canada = "124"  Indonesia = "360"  Pakistan = "586"
    Bangladesh = "050" Nepal = "524"   Sri Lanka = "144"  Myanmar = "104"
    Thailand = "764"   Vietnam = "704" Philippines = "608" Malaysia = "458"
    France = "250"  Spain = "724"   Italy = "380"   Poland = "616"
    Argentina = "032"  Mexico = "484"  Colombia = "170"
    South Africa = "710"  Nigeria = "566"  Ethiopia = "231"  DR Congo = "180"
    Egypt = "818"   Kenya = "404"   Tanzania = "834"  Sudan = "729"
*/
import { geoNaturalEarth1, geoMercator, geoPath, geoGraticule } from 'd3-geo';
import { feature } from 'topojson-client';
import type { Topology, Objects } from 'topojson-specification';
import { readFileSync } from 'fs';
import { join } from 'path';

type Palette = 'earth' | 'heat' | 'flood' | 'drought' | 'conflict';
type ProjectionName = 'naturalEarth' | 'mercator';

interface Zone {
  id: string;       // ISO 3166-1 numeric string
  label?: string;
  value: number;    // 0–1 choropleth intensity
  note?: string;
}

interface Marker {
  lat: number;
  lng: number;
  label?: string;
  kind?: 'city' | 'event' | 'data-point';
}

interface Props {
  projection?: ProjectionName;
  palette?: Palette;
  zones?: Zone[];
  markers?: Marker[];
  legend?: { title?: string; low?: string; high?: string; none?: string };
  caption?: string;
  source?: string;
}

const {
  projection: projName = 'naturalEarth',
  palette = 'earth',
  zones = [],
  markers = [],
  legend,
  caption,
  source,
} = Astro.props;

// ── Canvas ──────────────────────────────────────────────────────────────────
const W = 800;
const H = 452;

// ── Projection ──────────────────────────────────────────────────────────────
const projFn = projName === 'mercator'
  ? geoMercator().scale(128).translate([W / 2, H / 1.85])
  : geoNaturalEarth1().scale(140).translate([W / 2, H / 2 + 20]);

const pathGen  = geoPath(projFn);
const gratGen  = geoGraticule().step([20, 20]);

// ── Topology — 50m for sharp coastlines ─────────────────────────────────────
const topo = JSON.parse(
  readFileSync(join(process.cwd(), 'node_modules/world-atlas/countries-50m.json'), 'utf-8')
) as Topology<Objects<{}>>;
const countriesFC = feature(topo, topo.objects['countries'] as any);

// ── Colour palettes ──────────────────────────────────────────────────────────
const PALETTES: Record<Palette, [string, string, string]> = {
  earth:    ['#d8cdb4', '#cde8be', '#144e2c'],  // paper → deep forest
  heat:     ['#d8cdb4', '#fde47e', '#7a180c'],  // straw → brick red
  flood:    ['#d8cdb4', '#bcd8fc', '#163070'],  // sky → deep navy
  drought:  ['#d8cdb4', '#fef0a0', '#7e3a14'],  // pale yellow → amber brown
  conflict: ['#d8cdb4', '#f8c0ba', '#6a0f12'],  // blush → deep crimson
};

function hexToRgb(h: string): [number, number, number] {
  const n = parseInt(h.replace('#', ''), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}
function lerp(a: number, b: number, t: number) { return Math.round(a + (b - a) * t); }
function colorAt(lo: string, hi: string, t: number) {
  const [r1, g1, b1] = hexToRgb(lo);
  const [r2, g2, b2] = hexToRgb(hi);
  return `rgb(${lerp(r1,r2,t)},${lerp(g1,g2,t)},${lerp(b1,b2,t)})`;
}

const [noDataColor, minColor, maxColor] = PALETTES[palette];
const valueMap = new Map(zones.map(z => [String(z.id), z.value]));

function fill(id: string) {
  const v = valueMap.get(id);
  return v !== undefined ? colorAt(minColor, maxColor, v) : noDataColor;
}

// ── Pre-render all paths at build time ──────────────────────────────────────
const paths = (countriesFC.features as any[])
  .map((f: any) => {
    const d = pathGen(f);
    if (!d) return null;
    const id = String(f.id ?? '');
    return { d, id, fill: fill(id), active: valueMap.has(id) };
  })
  .filter(Boolean) as { d: string; id: string; fill: string; active: boolean }[];

const graticulePath = pathGen(gratGen() as any) ?? '';
const spherePath    = pathGen({ type: 'Sphere' } as any) ?? '';

// ── Project markers ──────────────────────────────────────────────────────────
const projMarkers = markers
  .map(m => {
    const pt = projFn([m.lng, m.lat]);
    if (!pt) return null;
    return { ...m, x: Math.round(pt[0]), y: Math.round(pt[1]) };
  })
  .filter(Boolean) as (Marker & { x: number; y: number })[];

// ── Zone label centroids ─────────────────────────────────────────────────────
const labels = zones
  .filter(z => z.label)
  .map(z => {
    const feat = (countriesFC.features as any[]).find((f: any) => String(f.id) === z.id);
    if (!feat) return null;
    const c = pathGen.centroid(feat);
    if (!c || isNaN(c[0])) return null;
    return { text: z.label!.toUpperCase(), x: Math.round(c[0]), y: Math.round(c[1]) };
  })
  .filter(Boolean) as { text: string; x: number; y: number }[];

// ── Legend geometry (inside SVG, lower-left) ─────────────────────────────────
const LX = 16, LY = H - 86, LW = 178, LH = 72;
const RY = LY + 30, RW = LW - 22, RH = 11;

// ── Zone notes ───────────────────────────────────────────────────────────────
const notes = zones.filter(z => z.note);
---

<div class="px-map" data-reveal>
  {caption && <div class="px-map__caption">{caption}</div>}

  <svg
    class="px-map__svg"
    viewBox={`0 0 ${W} ${H}`}
    xmlns="http://www.w3.org/2000/svg"
    aria-label={caption ?? 'Geographic region map'}
    role="img"
  >
    <defs>
      <clipPath id="px-sphere-clip">
        <path d={spherePath} />
      </clipPath>

      <!-- Ocean: radial gradient — lighter centre, deeper at the rim -->
      <radialGradient id="px-ocean" cx="44%" cy="43%" r="62%">
        <stop offset="0%"   stop-color="#cfe0da" />
        <stop offset="65%"  stop-color="#b8d0c8" />
        <stop offset="100%" stop-color="#96b2a8" />
      </radialGradient>

      <!-- Water ruling — faint horizontal engraving lines across ocean -->
      <pattern id="px-water-rule" x="0" y="0" width="1" height="5" patternUnits="userSpaceOnUse">
        <line x1="0" y1="2.5" x2={W} y2="2.5" stroke="#82aaa2" stroke-width="0.32" />
      </pattern>

      <!-- Legend ramp gradient -->
      <linearGradient id="px-ramp" x1="0%" x2="100%" y1="0%" y2="0%">
        <stop offset="0%"   stop-color={minColor} />
        <stop offset="100%" stop-color={maxColor} />
      </linearGradient>
    </defs>

    <!-- ① Ocean fill -->
    <path d={spherePath} fill="url(#px-ocean)" />

    <!-- ② Water ruling texture -->
    <path d={spherePath} fill="url(#px-water-rule)" opacity="0.22" clip-path="url(#px-sphere-clip)" />

    <!-- ③ Graticule grid -->
    <path
      d={graticulePath}
      fill="none"
      stroke="#88b0a6"
      stroke-width="0.36"
      opacity="0.55"
      clip-path="url(#px-sphere-clip)"
    />

    <!-- ④ Countries — shadow pass (creates depth / raised-land effect) -->
    <g
      clip-path="url(#px-sphere-clip)"
      style="filter: drop-shadow(0px 2px 3.5px rgba(28,20,6,0.30))"
    >
      {paths.map(p => <path d={p.d} fill={p.fill} stroke="none" />)}
    </g>

    <!-- ⑤ Countries — main pass with crisp borders -->
    <g clip-path="url(#px-sphere-clip)">
      {paths.map(p => (
        <path
          d={p.d}
          fill={p.fill}
          stroke={p.active ? '#7e6c42' : '#b8a882'}
          stroke-width={p.active ? 0.72 : 0.38}
          stroke-linejoin="round"
        />
      ))}
    </g>

    <!-- ⑥ Sphere outline — globe edge / neat line -->
    <path d={spherePath} fill="none" stroke="#6e9a8e" stroke-width="1.5" />

    <!-- ⑦ SVG border frame -->
    <rect
      x="2" y="2" width={W - 4} height={H - 4}
      fill="none" stroke="#8aaa9c" stroke-width="0.6" opacity="0.5"
    />

    <!-- ⑧ Zone labels (Cormorant Garamond, white with dark halo) -->
    {labels.map(l => (
      <text
        x={l.x} y={l.y}
        text-anchor="middle"
        dominant-baseline="central"
        style="font-family:'Fraunces',Georgia,serif;font-size:9px;font-weight:700;letter-spacing:0.12em;"
        fill="#f4ecd8"
        paint-order="stroke"
        stroke="rgba(18,12,2,0.60)"
        stroke-width="2.8"
        stroke-linejoin="round"
      >
        {l.text}
      </text>
    ))}

    <!-- ⑨ Markers -->
    {projMarkers.map(m => {
      const accent =
        m.kind === 'event'      ? '#961a10' :
        m.kind === 'data-point' ? '#165c34' : '#9a4420';
      return (
        <g transform={`translate(${m.x},${m.y})`}>
          <circle r="6.5" fill="none" stroke={accent} stroke-width="0.9" opacity="0.35" />
          <circle r="3.5"  fill={accent} stroke="#f4ead0" stroke-width="1.2" />
          {m.label && (
            <text
              x="10" y="0.5"
              dominant-baseline="central"
              style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:8.5px;letter-spacing:0.06em;"
              fill="#1c2218"
              paint-order="stroke"
              stroke="rgba(244,234,208,0.90)"
              stroke-width="3"
              stroke-linejoin="round"
            >
              {m.label}
            </text>
          )}
        </g>
      );
    })}

    <!-- ⑩ Cartographic legend box (lower-left, inside SVG) -->
    {zones.length > 0 && (
      <>
        <!-- Background with slight transparency -->
        <rect
          x={LX} y={LY} width={LW} height={LH}
          fill="#f0e9d8" fill-opacity="0.90"
          rx="2" stroke="#c0af8a" stroke-width="0.75"
        />
        <!-- Title -->
        <text
          x={LX + 10} y={LY + 17}
          style="font-family:'Fraunces',Georgia,serif;font-size:11.5px;font-style:italic;letter-spacing:0.02em;"
          fill="#3a4530"
        >
          {legend?.title ?? 'Relative intensity'}
        </text>
        <!-- Rule under title -->
        <line
          x1={LX + 10} y1={LY + 22}
          x2={LX + LW - 10} y2={LY + 22}
          stroke="#c0af8a" stroke-width="0.5"
        />
        <!-- Gradient ramp -->
        <rect x={LX + 10} y={RY} width={RW} height={RH} fill="url(#px-ramp)" rx="1.5" />
        <!-- Low label -->
        <text
          x={LX + 10} y={RY + RH + 12}
          style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:8px;letter-spacing:0.10em;"
          fill="#6a7050"
        >
          {(legend?.low ?? 'LOW').toUpperCase()}
        </text>
        <!-- High label -->
        <text
          x={LX + RW + 10} y={RY + RH + 12}
          text-anchor="end"
          style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:8px;letter-spacing:0.10em;"
          fill="#6a7050"
        >
          {(legend?.high ?? 'HIGH').toUpperCase()}
        </text>
        <!-- No-data swatch (optional) -->
        {legend?.none && (
          <>
            <rect
              x={LX + RW + 14} y={RY}
              width={11} height={RH}
              fill={noDataColor} rx="1"
              stroke="#c0af8a" stroke-width="0.5"
            />
            <text
              x={LX + RW + 27} y={RY + 7}
              dominant-baseline="central"
              style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:7.5px;letter-spacing:0.06em;"
              fill="#6a7050"
            >
              {legend.none.toUpperCase()}
            </text>
          </>
        )}
      </>
    )}
  </svg>

  <!-- Zone annotations below map -->
  {notes.length > 0 && (
    <ul class="px-map__notes">
      {notes.map(z => (
        <li class="px-map__note">
          {z.label && <strong class="px-map__note-label">{z.label}</strong>}
          {z.note}
        </li>
      ))}
    </ul>
  )}

  {source && <div class="px-map__source">{source}</div>}
</div>
