---
/**
 * CarbonLoop (earth) — the carbon cycle as it balances, and doesn't (Lens
 * Phase 6, the Lib-carbon-loop board). Reservoirs are squares whose AREA is
 * their stock, placed at their authored x / y; fluxes are straight arrows
 * whose WIDTH is their flow, a pair between the same two reservoirs drawn
 * side by side; a pair that cancels is labelled once ("each way"). The accent
 * reservoir is filled in the desk mark; an open boundary (`role: source` /
 * `sink`) is dashed, and its flux is drawn in ink. The residual the accent
 * reservoir keeps (`imbalance: 'the-point'`) is a dark chip beside it and the
 * figure's headline number.
 *
 * Conservation is checked at BUILD (blueprint §4, unchanged): every `store`
 * must balance within 1% or the build fails naming it, unless `imbalance:
 * 'the-point'` licenses the residual on an `accent: true` reservoir.
 *
 * Cue anchors: `<reservoir id>` (each box, e.g. `atmosphere`) · `1`…`n`
 * (each flux, authored order) · `residual` (the chip) · `head` (the
 * headline number).
 * Build: reservoirs (1) · fluxes draw (2) · labels (3) · the residual chip
 * (4) · the headline number (5).
 *
 * data: { unit, reservoirs[]{ id, label, stock, x, y, role?, accent? },
 *         fluxes[]{ from, to, value, note? }, imbalance?, residualLabel?,
 *         cycle?, year?, caption?, source? }
 */
import FigHead from './FigHead.astro';
import CueLayer from './CueLayer.astro';
import { SANS, textW, fmt as fmtN } from './_fig';

interface Reservoir {
  id: string; label: string; stock: number;
  x: number; y: number;
  role?: 'store' | 'source' | 'sink';
  accent?: boolean;
}
interface Flux { from: string; to: string; value: number; note?: string; }
interface Props {
  unit?: string;
  reservoirs?: Reservoir[];
  fluxes?: Flux[];
  imbalance?: 'the-point';
  residualLabel?: string;
  cycle?: string;   // header (motif 2 — the cycle is dated, grounds it in a time)
  year?: string;    // budget year, mono
  caption?: string;
  source?: string;
}
const {
  unit = 'GtC',
  reservoirs = [],
  fluxes = [],
  imbalance,
  residualLabel,
  cycle,
  year,
  caption,
  source,
} = Astro.props;

const byId = new Map(reservoirs.map((r) => [r.id, r]));
for (const fl of fluxes) {
  if (!byId.has(fl.from) || !byId.has(fl.to)) {
    throw new Error(`carbon-loop: flux ${fl.from} → ${fl.to} references an unknown reservoir id`);
  }
}

/* ── conservation check (build-time, blueprint §4 — mechanics-and-flow §4 1:1) ──
   net_R = Σin − Σout; balanced iff |net| ≤ 1% · max(Σin, Σout). Only role:'store'
   reservoirs are checked (closed pools); 'source'/'sink' are open boundaries and
   exempt. imbalance:'the-point' suppresses the throw and draws a residual — but
   ONLY on accent reservoirs; an unbalanced non-accent store STILL throws. */
const sumIn = (id: string) => fluxes.filter((f) => f.to === id).reduce((s, f) => s + f.value, 0);
const sumOut = (id: string) => fluxes.filter((f) => f.from === id).reduce((s, f) => s + f.value, 0);
const residualOf = new Map<string, number>(); // reservoir id → drawn net
for (const r of reservoirs) {
  const role = r.role ?? 'store';
  if (role !== 'store') continue; // open boundary — exempt (power-flow parity)
  const si = sumIn(r.id);
  const so = sumOut(r.id);
  const net = si - so;
  const denom = Math.max(si, so);
  const balanced = denom === 0 || Math.abs(net) <= 0.01 * denom;
  if (balanced) continue;
  if (imbalance === 'the-point' && r.accent) {
    residualOf.set(r.id, net); // the story's accumulation — drawn, not thrown
  } else {
    throw new Error(
      `carbon-loop: reservoir "${r.label}" (${r.id}) does not conserve — ` +
      `in ${si} vs out ${so}, net ${net > 0 ? '+' : ''}${net} ${unit}/yr exceeds 1%. ` +
      `Fix the fluxes, mark it role:'source'/'sink' if it is a one-way boundary, or — only if the ` +
      `accumulation IS the story — mark it accent:true and set imbalance:'the-point'.`,
    );
  }
}

/* ── layout (the board: 460 wide, area ∝ stock, width ∝ flow) ─────────── */
const W = 460, H = 384, FS = 13;
const maxStock = Math.max(1e-9, ...reservoirs.map((r) => r.stock));
const maxFlux = Math.max(1e-9, ...fluxes.map((f) => f.value));
const f1 = (n: number) => Number(n.toFixed(1));
const fmt = (v: number) => fmtN(v, 1);
interface Placed { r: Reservoir; cx: number; cy: number; hs: number }
const placed = new Map<string, Placed>();
for (const r of reservoirs) {
  const side = Math.max(34, 98 * Math.sqrt(r.stock / maxStock));
  const hs = side / 2;
  const cx = Math.max(hs + 2, Math.min(W - hs - 2, 40 + r.x * (W - 80)));
  const cy = Math.max(hs + 4, Math.min(H - hs - 30, 24 + r.y * (H - 64)));
  placed.set(r.id, { r, cx, cy, hs });
}
const midX = W / 2, midY = H / 2;

/* leave a square along (ux, uy) from its centre shifted by (ox, oy) */
function exitPt(p: Placed, ux: number, uy: number, ox: number, oy: number) {
  const s = (p.hs + 6) / Math.max(Math.abs(ux), Math.abs(uy), 1e-6);
  return { x: p.cx + ox + ux * s, y: p.cy + oy + uy * s };
}
interface Arrow { i: number; fl: Flux; line: string; headPts: string; w: number; mx: number; my: number; nx: number; ny: number; pair: boolean; balanced: boolean; first: boolean; open: boolean }
const arrows: Arrow[] = fluxes.map((fl, i) => {
  const A = placed.get(fl.from)!, B = placed.get(fl.to)!;
  const dx = B.cx - A.cx, dy = B.cy - A.cy, L = Math.hypot(dx, dy) || 1;
  const ux = dx / L, uy = dy / L;
  const back = fluxes.findIndex((g) => g.from === fl.to && g.to === fl.from);
  const pair = back >= 0;
  const w = Math.max(1.6, (8 * fl.value) / maxFlux);
  /* a pair: each arrow on its own side of the centre line, fixed by which of
     the two is authored first (the perpendicular is taken from that one's
     direction), so the two never cross */
  const first = !pair || i < back;
  const bx0 = first ? ux : -ux, by0 = first ? uy : -uy;
  const px = -by0, py = bx0;
  const off = pair ? (first ? 1 : -1) * (w / 2 + 3.5) : 0;
  const s = exitPt(A, ux, uy, px * off, py * off);
  const e = exitPt(B, -ux, -uy, px * off, py * off);
  const hl = Math.max(9, w * 1.8), hw = Math.max(5.5, w * 1.05);
  const bx = e.x - ux * hl, by = e.y - uy * hl;
  /* the outward normal, away from the figure's centre, for the label */
  const mx = (A.cx + B.cx) / 2, my = (A.cy + B.cy) / 2;
  let nx = -uy, ny = ux;
  if (nx * (mx - midX) + ny * (my - midY) < 0) { nx = -nx; ny = -ny; }
  if (Math.abs(mx - midX) < 6 && Math.abs(ux) < 0.2) { nx = 1; ny = 0; }
  const open = ['source', 'sink'].includes(A.r.role ?? '') || ['source', 'sink'].includes(B.r.role ?? '');
  return {
    i, fl, w, mx, my, nx, ny, pair, first, open,
    balanced: pair && Math.abs(fluxes[back].value - fl.value) <= 0.01 * Math.max(fl.value, fluxes[back].value),
    line: `M ${f1(s.x)} ${f1(s.y)} L ${f1(bx)} ${f1(by)}`,
    headPts: `${f1(e.x)},${f1(e.y)} ${f1(bx - uy * hw)},${f1(by + ux * hw)} ${f1(bx + uy * hw)},${f1(by - ux * hw)}`,
  };
});
/* one label per pair that cancels, one per flux otherwise */
const fluxLabels = arrows.filter((a) => !a.balanced || a.first).map((a) => {
  const sib = a.pair ? arrows.find((b) => b.fl.from === a.fl.to && b.fl.to === a.fl.from) : undefined;
  const lines = a.balanced
    ? [`${fmt(a.fl.value)} ${unit}/yr`, 'each way']
    : [`${fmt(a.fl.value)} ${unit}/yr`, a.pair ? (a.fl.note ?? '') : 'one way'].filter(Boolean);
  const gap = (sib && a.balanced ? a.w + sib.w + 7 : a.w) / 2 + 12;
  const x = a.mx + a.nx * gap, y = a.my + a.ny * gap;
  const anchor = a.nx > 0.3 ? 'start' : a.nx < -0.3 ? 'end' : 'middle';
  return { a, lines, x, y: y - (lines.length - 1) * 7 + 4, anchor };
});

/* reservoir labels: to the right of a box in the top third, else under it */
const boxLabels = [...placed.values()].map((p) => {
  const right = p.cy < H * 0.3;
  return right
    ? { p, x: p.cx + p.hs + 10, y: p.cy - 2, anchor: 'start' }
    : { p, x: p.cx, y: p.cy + p.hs + 17, anchor: 'middle' };
});

/* the residual chip: beside the accent reservoir, on its left when there is room */
const residuals = [...residualOf].map(([id, net]) => {
  const p = placed.get(id)!;
  const sub = (residualLabel ?? '').replace(/^[+\-−]?[\d.,]+\s*\S*\s*[—–-]+\s*/, '').trim();
  const l1 = `${net > 0 ? '+' : ''}${fmt(net)} ${unit}/yr`;
  const w = Math.max(textW(l1, FS, true), textW(sub, 12)) + 20;
  const left = p.cx - p.hs - 16 - w > 0;
  const x = left ? p.cx - p.hs - 16 - w : Math.min(W - w - 2, p.cx + p.hs + 16);
  const y = left ? p.cy - p.hs + 4 : p.cy + 22;
  return { id, net, l1, sub, x, y, w, h: sub ? 40 : 26 };
});
const headNet = residuals[0]?.net;
const biggest = fluxes.reduce((a, b) => (b.value > (a?.value ?? -Infinity) ? b : a), undefined as Flux | undefined);
const aria = `${reservoirs.map((r) => `${r.label} ${fmt(r.stock)} ${unit}`).join('; ')}. Flows: ${fluxes.map((f) => `${byId.get(f.from)!.label} to ${byId.get(f.to)!.label} ${fmt(f.value)} ${unit} a year${f.note ? ` (${f.note})` : ''}`).join('; ')}.`;
const tags = [
  ...[...placed.values()].map((p) => ({ id: p.r.id, x: p.cx - p.hs + 2, y: p.cy - p.hs + 2 })),
  ...arrows.map((a) => ({ id: a.i + 1, x: a.mx, y: a.my })),
  ...residuals.map((r) => ({ id: 'residual', x: r.x, y: r.y })),
];
---

<div class="px-viz px-cloop" data-build-scene>
  {caption && <div class="px-viz__cap"><span>{caption}</span></div>}
  {headNet != null
    ? <FigHead value={`${headNet > 0 ? '+' : ''}${fmt(headNet)}`} label={`${unit} a year stays`} n={5} />
    : biggest && <FigHead value={fmt(biggest.value)} label={`${unit} a year, largest`} n={5} />}
  {(cycle || year) && <p class="px-cloop__head">{[cycle, year].filter(Boolean).join(' · ')}</p>}

  <div class="px-cloop__plot">
    <svg class="px-cloop__fig" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
      {arrows.map((a) => (
        <g class:list={['px-cloop__flux', a.open && 'is-open']} data-cue={a.i + 1}>
          <title>{`${byId.get(a.fl.from)!.label} to ${byId.get(a.fl.to)!.label}: ${fmt(a.fl.value)} ${unit}/yr${a.fl.note ? `, ${a.fl.note}` : ''}`}</title>
          <path class="px-cloop__shaft" d={a.line} style={`stroke-width:${a.w.toFixed(1)}`} data-build="2" data-build-kind="draw" />
          <polygon class="px-cloop__tip" points={a.headPts} data-build="2" />
        </g>
      ))}
      {[...placed.values()].map((p) => (
        <g class:list={['px-cloop__res', p.r.accent && 'is-accent', (p.r.role === 'source' || p.r.role === 'sink') && 'is-open']} data-cue={p.r.id}>
          <rect x={f1(p.cx - p.hs)} y={f1(p.cy - p.hs)} width={f1(p.hs * 2)} height={f1(p.hs * 2)} rx="3" data-build="1" data-build-kind="drop" />
        </g>
      ))}
      {boxLabels.map((b) => (
        <text class:list={['px-cloop__bl', (b.p.r.role === 'source' || b.p.r.role === 'sink') && 'is-open']} x={f1(b.x)} y={f1(b.y)} text-anchor={b.anchor} style={SANS} data-build="3" data-build-kind="rise">
          <tspan x={f1(b.x)} class="px-cloop__bn">{b.p.r.label}</tspan>
          <tspan x={f1(b.x)} dy="16" class="px-cloop__bs">{fmt(b.p.r.stock)} {unit}</tspan>
        </text>
      ))}
      {fluxLabels.map((l) => (
        <text class="px-cloop__fl" x={f1(l.x)} y={f1(l.y)} text-anchor={l.anchor} style={SANS} data-build="3" data-build-kind="rise">
          {l.lines.map((ln, k) => <tspan x={f1(l.x)} dy={k ? 15 : 0} class={k ? 'px-cloop__fn' : 'px-cloop__fv'}>{ln}</tspan>)}
        </text>
      ))}
      {residuals.map((r) => (
        <g class="px-cloop__chip" data-cue="residual" data-build="4" data-build-kind="drop">
          <rect x={f1(r.x)} y={f1(r.y)} width={f1(r.w)} height={r.h} rx="4" />
          <text x={f1(r.x + r.w / 2)} y={f1(r.y + 17)} text-anchor="middle" style={SANS}>
            <tspan x={f1(r.x + r.w / 2)} class="px-cloop__cv">{r.l1}</tspan>
            {r.sub && <tspan x={f1(r.x + r.w / 2)} dy="15" class="px-cloop__cs">{r.sub}</tspan>}
          </text>
        </g>
      ))}
    </svg>
    <CueLayer w={W} h={H} tags={tags} />
  </div>

  <div class="px-cloop__key">
    <span><i class="px-cloop__k px-cloop__k--box"></i>Area is stock</span>
    <span><i class="px-cloop__k px-cloop__k--flow"></i>Width is flow</span>
    {reservoirs.some((r) => r.role === 'source' || r.role === 'sink') && <span><i class="px-cloop__k px-cloop__k--open"></i>Open boundary</span>}
  </div>
</div>

<style>
  .px-cloop__plot { position: relative; width: 100%; }
  .px-cloop__fig { display: block; width: 100%; height: auto; overflow: visible; }
  .px-cloop__head { margin: 0 0 8px; font-family: var(--font-ui); font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .px-cloop__shaft { fill: none; stroke: var(--accent-deep); stroke-linecap: butt; }
  .px-cloop__tip { fill: var(--accent-deep); }
  .px-cloop__flux.is-open .px-cloop__shaft { stroke: var(--ink); }
  .px-cloop__flux.is-open .px-cloop__tip { fill: var(--ink); }
  .px-cloop__res rect { fill: var(--accent-tint); stroke: var(--accent-deep); stroke-width: 1.5; }
  .px-cloop__res.is-accent rect { fill: var(--accent); }
  .px-cloop__res.is-open rect { fill: var(--paper-3); stroke: var(--ink-2, var(--ink-soft)); stroke-dasharray: 5 4; }
  .px-cloop__bl, .px-cloop__fl { font-size: 13px; font-variant-numeric: tabular-nums; }
  .px-cloop__bn { font-weight: 600; fill: var(--ink); }
  .px-cloop__bs { font-weight: 600; fill: var(--accent-deep); }
  .px-cloop__bl.is-open .px-cloop__bs { fill: var(--ink-2, var(--ink-soft)); }
  .px-cloop__fv { font-weight: 600; fill: var(--ink); }
  .px-cloop__fn { fill: var(--muted); font-size: 12px; }
  .px-cloop__chip rect { fill: var(--ink); }
  .px-cloop__cv { font-size: 13px; font-weight: 600; fill: var(--paper); font-variant-numeric: tabular-nums; }
  .px-cloop__cs { font-size: 12px; fill: var(--paper); }
  .px-cloop__key { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 12px; font-family: var(--font-ui); font-size: 12px; color: var(--muted); }
  .px-cloop__key span { display: inline-flex; align-items: center; gap: 7px; }
  .px-cloop__k { display: inline-block; flex: none; }
  .px-cloop__k--box { width: 14px; height: 14px; border-radius: 2px; background: var(--accent-tint); border: 1.5px solid var(--accent-deep); }
  .px-cloop__k--flow { width: 26px; height: 6px; background: var(--accent-deep); }
  .px-cloop__k--open { width: 14px; height: 14px; border-radius: 2px; background: var(--paper-3); border: 1.5px dashed var(--ink-2, var(--ink-soft)); }
  /* A phone scrolls the figure inside its card at its drawn size (12px labels). */
  @media (max-width: 900px) { .px-cloop__plot { min-width: 460px; } }
  /* An SVG anchor lights by opacity alone: an outline on an SVG shape draws
     its bounding box, not a ring (the CueLayer numeral takes the ring). */
  svg [data-cue] { outline: none !important; }
</style>
