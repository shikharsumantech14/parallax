---
/**
 * QuakeDepth (earth) — earthquakes on a time × depth field (Lens Phase 6, the
 * Lib-quake-depth board). x is real time (the dates, ticked every half year),
 * y is depth below the surface line, each quake a circle sized by magnitude
 * and labelled with its place and magnitude where the label finds room (it
 * tries right, left, above, below; a label that fits nowhere is dropped, the
 * circle stays). The top 10 km is a tinted band; the number of quakes inside
 * it is the headline.
 *
 * Cue anchors: `1`…`n` (each quake, authored order) · `band` (the top 10 km)
 * · `head` (the headline number).
 * Build: axes, band and surface (1) · circles drop in time order (2) · labels
 * (3) · the headline number (4).
 *
 * data: { quakes[]{ date, depthKm, mag, place? }, caption?, source? }
 */
import FigHead from './FigHead.astro';
import CueLayer from './CueLayer.astro';
import { SANS, textW, hits, fmt, type Box } from './_fig';

interface Quake { date: string; depthKm: number; mag: number; place?: string; }
interface Props { quakes: Quake[]; caption?: string; source?: string; }
const { quakes = [], caption } = Astro.props;

const W = 460, H = 332, PL = 52, PR = 12, PT = 40, PB = 14, FS = 12;
const plotW = W - PL - PR, plotH = H - PT - PB;
const SHALLOW = 10;

const qs = quakes
  .map((q, i) => ({ ...q, i, t: Date.parse(String(q.date)) }))
  .filter((q) => Number.isFinite(q.depthKm) && Number.isFinite(q.mag) && Number.isFinite(q.t));
const n = qs.length;

/* time: from the half year before the first quake to the half year after the last */
const half = (t: number, up: boolean) => {
  const d = new Date(t);
  const y = d.getUTCFullYear(), m = d.getUTCMonth();
  if (!up) return Date.UTC(y, m < 6 ? 0 : 6, 1);
  return m < 6 ? Date.UTC(y, 6, 1) : Date.UTC(y + 1, 0, 1);
};
const t0 = n ? half(Math.min(...qs.map((q) => q.t)), false) : 0;
const t1 = n ? half(Math.max(...qs.map((q) => q.t)), true) : 1;
const xOf = (t: number) => PL + ((t - t0) / (t1 - t0 || 1)) * plotW;
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const tTicks: { x: number; label: string }[] = [];
const spanYears = (t1 - t0) / (365.25 * 864e5);
const stepMonths = spanYears > 6 ? 24 : spanYears > 3 ? 12 : 6;
for (let d = new Date(t0); d.getTime() <= t1 + 1; d = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + stepMonths, 1))) {
  tTicks.push({ x: xOf(d.getTime()), label: `${MON[d.getUTCMonth()]} ${d.getUTCFullYear()}` });
}

/* depth: 0 at the surface line, a tidy 10 km step to the deepest */
const depthMax = Math.max(20, Math.ceil(Math.max(0, ...qs.map((q) => q.depthKm)) / 10) * 10);
const yOf = (d: number) => PT + (Math.max(0, d) / depthMax) * plotH;
const dStep = depthMax > 80 ? 20 : 10;
const dTicks: number[] = [];
for (let d = 0; d <= depthMax; d += dStep) dTicks.push(d);

const mags = qs.map((q) => q.mag);
const mMin = n ? Math.min(...mags) : 0, mMax = n ? Math.max(...mags) : 1;
const rOf = (m: number) => 5 + ((m - mMin) / (mMax - mMin || 1)) * 10;

const dots = qs.map((q) => ({ ...q, cx: xOf(q.t), cy: yOf(q.depthKm), r: rOf(q.mag) }));

/* labels: the place's first word(s) and the magnitude, placed where they fit */
const shortPlace = (p?: string) => {
  const head = String(p ?? '').split(',')[0].trim();
  return head.length > 12 ? head.split(/[\s-]/)[0] : head;
};
const obstacles: Box[] = dots.map((d) => ({ x0: d.cx - d.r, y0: d.cy - d.r, x1: d.cx + d.r, y1: d.cy + d.r }));
const bandLabel = 'Top 10 km';
const bandBox: Box = { x0: W - PR - textW(bandLabel, FS, true) - 8, y0: PT + 2, x1: W - PR, y1: PT + 18 };
const placed: Box[] = [bandBox];
const labels = [...dots].sort((a, b) => b.mag - a.mag).map((d) => {
  const text = [shortPlace(d.place), fmt(d.mag)].filter(Boolean).join(' ');
  const w = textW(text, FS), h = FS + 2;
  const tries = [
    { x: d.cx + d.r + 5, y: d.cy + 4, a: 'start' },
    { x: d.cx - d.r - 5, y: d.cy + 4, a: 'end' },
    { x: d.cx, y: d.cy - d.r - 5, a: 'middle' },
    { x: d.cx, y: d.cy + d.r + FS + 3, a: 'middle' },
  ];
  for (const t of tries) {
    const x0 = t.a === 'start' ? t.x : t.a === 'end' ? t.x - w : t.x - w / 2;
    const box: Box = { x0, y0: t.y - FS + 1, x1: x0 + w, y1: t.y + 3 };
    if (box.x0 < 2 || box.x1 > W - 2 || box.y0 < PT - 2 || box.y1 > H) continue;
    if (placed.some((p) => hits(box, p, 2))) continue;
    if (obstacles.some((o, k) => dots[k] !== d && hits(box, o, 1))) continue;
    placed.push(box);
    return { d, text, ...t };
  }
  return { d, text: '', x: 0, y: 0, a: 'start' };
});
const labelOf = new Map(labels.map((l) => [l.d.i, l]));

const shallow = qs.filter((q) => q.depthKm <= SHALLOW).length;
const biggest = qs.reduce((a, b) => (b.mag > (a?.mag ?? -Infinity) ? b : a), undefined as (typeof qs)[number] | undefined);
const head = shallow > 0 ? { v: String(shallow), l: `of ${n} shallow` } : biggest ? { v: fmt(biggest.mag), l: 'largest' } : undefined;

/* the legend: three round magnitudes inside the range */
const keyMags = (() => {
  const lo = Math.ceil(mMin * 2) / 2, hi = Math.floor(mMax * 2) / 2;
  const out = [lo, (lo + hi) / 2, hi].map((v) => Math.round(v * 2) / 2);
  return [...new Set(out)].filter((v) => v >= mMin - 0.01 && v <= mMax + 0.01);
})();
const aria = `${n} earthquakes by date and depth: ${qs.map((q) => `${q.place ?? ''} M${q.mag}, ${q.depthKm} km, ${q.date}`).join('; ')}.`;
const tagAt = (d: (typeof dots)[number]) => ({ id: d.i + 1, x: Math.max(10, d.cx - d.r * 0.75 - 8), y: Math.max(PT - 6, d.cy - d.r * 0.75 - 8) });
---

<div class="px-viz px-quake" data-build-scene>
  {caption && <div class="px-viz__cap"><span>{caption}</span></div>}
  {head && <FigHead value={head.v} label={head.l} n={4} />}

  <div class="px-quake__plot">
    <svg class="px-quake__fig" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
      <g class="px-quake__axis" data-build="1">
        <rect class="px-quake__band" data-cue="band" x={PL} y={PT} width={plotW} height={(yOf(SHALLOW) - PT).toFixed(1)} />
        {dTicks.map((d) => (
          <>
            {d > 0 && <line class="px-quake__grid" x1={PL} y1={yOf(d).toFixed(1)} x2={W - PR} y2={yOf(d).toFixed(1)} />}
            <text class="px-quake__tick" x={PL - 8} y={(yOf(d) + 4).toFixed(1)} text-anchor="end" style={SANS}>{d} km</text>
          </>
        ))}
        <line class="px-quake__surface" x1={PL} y1={PT} x2={W - PR} y2={PT} />
        {tTicks.map((t, k) => (
          <>
            <line class="px-quake__ttick" x1={t.x.toFixed(1)} y1={PT - 6} x2={t.x.toFixed(1)} y2={PT} />
            <text class="px-quake__tick" x={t.x.toFixed(1)} y={PT - 12} text-anchor={k === 0 ? 'start' : k === tTicks.length - 1 ? 'end' : 'middle'} style={SANS}>{t.label}</text>
          </>
        ))}
        <text class="px-quake__band-l" x={W - PR - 4} y={PT + 15} text-anchor="end" style={SANS}>{bandLabel}</text>
      </g>
      {[...dots].sort((a, b) => b.r - a.r).map((d) => {
        const l = labelOf.get(d.i);
        return (
          <g class="px-quake__q" data-cue={d.i + 1}>
            <circle class="px-quake__dot" cx={d.cx.toFixed(1)} cy={d.cy.toFixed(1)} r={d.r.toFixed(1)} data-build="2" data-build-kind="drop">
              <title>{[d.place, `M${d.mag}`, `${d.depthKm} km deep`, d.date].filter(Boolean).join(' · ')}</title>
            </circle>
            {l && l.text && <text class="px-quake__lbl" x={l.x.toFixed(1)} y={l.y.toFixed(1)} text-anchor={l.a} style={SANS} data-build="3" data-build-kind="rise">{l.text}</text>}
          </g>
        );
      })}
    </svg>
    <CueLayer w={W} h={H} tags={[...dots.map(tagAt), { id: 'band', x: PL + 12, y: (PT + yOf(SHALLOW)) / 2 }]} />
  </div>

  {keyMags.length > 0 && (
    <div class="px-quake__key">
      {keyMags.map((m) => (
        <span><svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r={rOf(m).toFixed(1)} /></svg>M{m.toFixed(1)}</span>
      ))}
    </div>
  )}
</div>

<style>
  .px-quake__plot { position: relative; width: 100%; }
  .px-quake__fig { display: block; width: 100%; height: auto; overflow: visible; }
  .px-quake__band { fill: var(--accent-tint); }
  .px-quake__grid { stroke: var(--hair); stroke-width: 1; }
  .px-quake__surface { stroke: var(--ink); stroke-width: 2; }
  .px-quake__ttick { stroke: var(--ink); stroke-width: 1; }
  .px-quake__tick { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .px-quake__band-l { font-size: 12px; font-weight: 600; fill: var(--accent-deep); }
  .px-quake__dot { fill: var(--accent); fill-opacity: 0.78; stroke: var(--paper-2); stroke-width: 1.5; }
  .px-quake__dot:hover { fill-opacity: 1; stroke: var(--accent-deep); }
  .px-quake__lbl {
    font-size: 12px; font-weight: 500; fill: var(--ink);
    paint-order: stroke; stroke: var(--paper-2); stroke-width: 4px; stroke-linejoin: round;
    font-variant-numeric: tabular-nums;
  }
  .px-quake__key { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; margin-top: 12px; font-family: var(--font-ui); font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .px-quake__key span { display: inline-flex; align-items: center; gap: 4px; }
  .px-quake__key circle { fill: var(--accent); fill-opacity: 0.78; }
  /* A phone scrolls the figure inside its card at its drawn size (the
     standing rule of dataviz-v2.css), so every label prints at 12px. */
  @media (max-width: 900px) { .px-quake__plot { min-width: 460px; } }
  /* An SVG anchor lights by opacity alone: an outline on an SVG shape draws
     its bounding box, not a ring (the CueLayer numeral takes the ring). */
  svg [data-cue] { outline: none !important; }
</style>
