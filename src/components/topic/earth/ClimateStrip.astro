---
/**
 * ClimateStrip (earth) — warming stripes (Lens Phase 6, the Lib-climate-strip
 * board): one stripe a year, shaded along the desk's ink ramp from its tint
 * (the lowest value) through its mark to its deep (the highest), a year axis
 * under the strip, a marker above each annotated year with its callout, and a
 * scale of the ramp with its two ends. The warmest year is the headline.
 *
 * `palette` picks the direction of the ramp: `warming` and `rainfall` run
 * light to dark as the value rises, `cooling` and `drought` dark to light,
 * `custom` runs from `customMin` to `customMax` (authored colours, a fixed
 * encoding). `showYears` / `showLegend` switch the axis and the scale;
 * `baseline` and `unit` print on the scale.
 *
 * Cue anchors: `<year>` (each stripe, by its year: "2016") · `1`…`3` (each
 * annotation marker, authored order) · `legend` (the scale) · `head` (the
 * headline number).
 * Build: the year axis (1) · stripes rise left to right (2) · annotation
 * markers and callouts (3) · the headline number (4).
 *
 * data: { values[]{ year, value }, palette?, baseline?, unit?, showYears?,
 *         showLegend?, customMin?, customMax?, annotations?[]{ at, text } }
 */
import FigHead from './FigHead.astro';
import CueLayer from './CueLayer.astro';
import { fmt } from './_fig';

interface DataPoint { year: number; value: number; }
type Palette = 'warming' | 'cooling' | 'rainfall' | 'drought' | 'custom';
/* The annotation layer (docs/design/blueprints/_ANNOTATIONS.md): `at` is the
   year; `side` / `series` are accepted for contract parity (one series, the
   callout always sits above the strip). */
interface Annotation { at: string | number; text: string; side?: 'above' | 'below' | 'left' | 'right'; series?: string; }
interface Props {
  values: DataPoint[];
  annotations?: Annotation[];
  palette?: Palette;
  baseline?: string;
  unit?: string;
  showYears?: boolean;
  showLegend?: boolean;
  customMin?: string;
  customMax?: string;
  caption?: string;
  source?: string;
}
const {
  values = [], annotations = [], palette = 'warming', baseline, unit = '',
  showYears = true, showLegend = true, customMin, customMax, caption,
} = Astro.props;

const vals = values.filter((d) => d && Number.isFinite(d.value));
const n = vals.length;
const vMin = n ? Math.min(...vals.map((d) => d.value)) : 0;
const vMax = n ? Math.max(...vals.map((d) => d.value)) : 1;
const norm = (v: number) => (v - vMin) / (vMax - vMin || 1);
const reverse = palette === 'cooling' || palette === 'drought';

/* the ramp: tint → mark → deep, or the two authored custom colours */
const colorAt = (t0: number) => {
  const t = reverse ? 1 - t0 : t0;
  if (palette === 'custom') {
    return `color-mix(in oklab, ${customMin ?? 'var(--accent-tint)'} ${Math.round((1 - t) * 100)}%, ${customMax ?? 'var(--deep, var(--ink))'})`;
  }
  return t < 0.5
    ? `color-mix(in oklab, var(--accent-tint) ${Math.round(100 - t * 200)}%, var(--accent))`
    : `color-mix(in oklab, var(--accent) ${Math.round(200 - t * 200)}%, var(--deep, var(--ink)))`;
};
const gradient = palette === 'custom'
  ? `linear-gradient(90deg, ${customMin ?? 'var(--accent-tint)'}, ${customMax ?? 'var(--deep)'})`
  : reverse
    ? 'linear-gradient(90deg, var(--deep), var(--accent), var(--accent-tint))'
    : 'linear-gradient(90deg, var(--accent-tint), var(--accent), var(--deep))';

/* geometry: the stripes are an SVG stretched to the plot (no text in it,
   so nothing distorts); the years and the callouts are HTML placed by
   percent, so they print at their CSS size at any width. */
const W = 1000, SH = 100;
const annots = (annotations ?? [])
  .map((a, k) => {
    if (!a || !a.text) return null;
    const i = vals.findIndex((d) => String(d.year) === String(a.at));
    return i < 0 ? null : { k, i, text: String(a.text) };
  })
  .filter((a): a is { k: number; i: number; text: string } => a !== null);
const sw = n ? W / n : W;
const xOf = (i: number) => i * sw;
const pct = (x: number) => ((x / W) * 100).toFixed(2);

/* decade ticks and the two ends, never on top of each other (in percent of
   the plot; a label is about 5% wide on a phone) */
const ticks: { x: number; label: string; a: string; odd?: boolean }[] = [];
if (showYears && n) {
  vals.forEach((d, i) => {
    if (d.year % 10 !== 0) return;
    const x = xOf(i) + sw / 2;
    if (x < 120 || x > W - 150) return;
    ticks.push({ x, label: String(d.year), a: 'middle', odd: (d.year / 10) % 2 === 1 });
  });
  ticks.unshift({ x: 0, label: String(vals[0].year), a: 'start' });
  ticks.push({ x: W, label: String(vals[n - 1].year), a: 'end' });
}

const peak = n ? vals.reduce((a, b) => (b.value > a.value ? b : a)) : undefined;
const signed = (v: number) => `${v > 0 ? '+' : ''}${fmt(v, 2)}`;
const headLabel = peak ? `${unit ? unit + ' in ' : 'in '}${peak.year}` : undefined;
const aria = n ? `${n} stripes, ${vals[0].year} to ${vals[n - 1].year}, from ${signed(vMin)} to ${signed(vMax)}${unit ? ' ' + unit : ''}; the highest is ${peak?.year}.` : 'No data';
const tags = vals.map((d, i) => ({ id: d.year, x: Math.min(W - 22, Math.max(22, xOf(i) + sw / 2)), y: 14 }));
---

<div class="px-viz px-cstrip" data-build-scene>
  {caption && <div class="px-viz__cap"><span>{caption}</span></div>}
  {peak && <FigHead value={signed(peak.value)} label={headLabel} n={4} />}

  {annots.length > 0 && (
    <div class="px-cstrip__anns">
      {annots.map((a) => {
        const x = +pct(xOf(a.i) + sw / 2);
        return (
          <p class="px-cstrip__ann" data-cue={a.k + 1} style={x > 50 ? `padding-right:${(100 - x).toFixed(2)}%;text-align:right` : `padding-left:${x.toFixed(2)}%`} data-build="3" data-build-kind="rise">
            <span class="px-cue-tag" data-cue-tag={a.k + 1} hidden></span>{a.text}
          </p>
        );
      })}
    </div>
  )}

  <div class="px-cstrip__plot">
    <svg class="px-cstrip__fig" viewBox={`0 0 ${W} ${SH}`} preserveAspectRatio="none" role="img" aria-label={aria}>
      {vals.map((d, i) => (
        <rect class="px-cstrip__bar" data-cue={d.year} x={xOf(i).toFixed(2)} y="0" width={(sw + 0.6).toFixed(2)} height={SH} style={`fill:${colorAt(norm(d.value))}`} data-build="2" data-build-kind="grow-y">
          <title>{`${d.year}: ${signed(d.value)}${unit ? ' ' + unit : ''}`}</title>
        </rect>
      ))}
      {annots.map((a) => (
        <line class="px-cstrip__ann-l" data-cue={a.k + 1} x1={(xOf(a.i) + sw / 2).toFixed(1)} y1="0" x2={(xOf(a.i) + sw / 2).toFixed(1)} y2={SH} data-build="3" />
      ))}
    </svg>
    <CueLayer w={W} h={SH} tags={tags} />
  </div>

  {showYears && n > 0 && (
    <div class="px-cstrip__axis" aria-hidden="true" data-build="1">
      {ticks.map((t) => (
        <span class:list={['px-cstrip__yr', `is-${t.a}`, t.odd && 'is-odd']} style={`left:${pct(t.x)}%`}>{t.label}</span>
      ))}
    </div>
  )}

  {showLegend && n > 0 && (
    <div class="px-cstrip__scale" data-cue="legend">
      <span class="px-cstrip__end"><span class="px-cue-tag" data-cue-tag="legend" hidden></span>{signed(vMin)}{unit ? ` ${unit}` : ''}</span>
      <span class="px-cstrip__grad" style={`background:${gradient}`}></span>
      <span class="px-cstrip__end">{signed(vMax)}{unit ? ` ${unit}` : ''}</span>
      {baseline && <span class="px-cstrip__base">Against {baseline}</span>}
    </div>
  )}
</div>

<style>
  .px-cstrip__plot { position: relative; width: 100%; }
  .px-cstrip__fig { display: block; width: 100%; height: 150px; }
  .px-cstrip__bar { stroke: none; transform-origin: 50% 100%; }
  .px-cstrip__ann-l { stroke: var(--ink); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .px-cstrip__anns { display: grid; gap: 6px; margin-bottom: 8px; }
  .px-cstrip__ann {
    margin: 0; font-family: var(--font-ui); font-size: 13px; line-height: 1.35; font-weight: 500; color: var(--ink);
    position: relative; padding-bottom: 8px; border-bottom: 0;
  }
  .px-cstrip__ann .px-cue-tag { margin: 0 6px 0 0; }
  .px-cstrip__axis { position: relative; height: 26px; border-top: 1px solid var(--hair-2); }
  .px-cstrip__yr {
    position: absolute; top: 6px; font-family: var(--font-ui); font-size: 13px; line-height: 1;
    color: var(--ink-2, var(--ink-soft)); font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .px-cstrip__yr.is-middle { translate: -50% 0; }
  .px-cstrip__yr.is-end { translate: -100% 0; }
  .px-cstrip__scale {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 12px;
    font-family: var(--font-ui); font-size: 13px; line-height: 1.4; color: var(--ink-2, var(--ink-soft));
    font-variant-numeric: tabular-nums;
  }
  .px-cstrip__end { display: inline-flex; align-items: center; }
  .px-cstrip__grad { flex: 1 1 80px; min-width: 60px; height: 10px; border-radius: 2px; }
  .px-cstrip__base { flex-basis: 100%; font-size: 12px; color: var(--muted); }
  /* on a phone every other decade, so no two years touch */
  @media (max-width: 640px) { .px-cstrip__fig { height: 120px; } .px-cstrip__yr.is-odd { display: none; } }
  /* An SVG anchor lights by opacity alone: an outline on an SVG shape draws
     its bounding box, not a ring (the CueLayer numeral takes the ring). */
  svg [data-cue] { outline: none !important; }
</style>
