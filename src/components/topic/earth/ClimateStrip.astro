---
/*
  ClimateStrip — v2 warming-stripes treatment (.cs), wrapped in the elevated
  .px-viz card. One bar per time unit, coloured along a diverging palette from
  the value range, with an anomaly line stroke-drawn over the top on scroll-in.
  Faithful port of the publication-v2 kit <ClimateStrip>. Build-time computed,
  zero runtime JS (reveal handled by CSS; core/Reveal.astro toggles .is-in on
  the .px-viz shell, gated no-JS-safe).

  PRESERVES the existing prop interface (`values`, not the kit's `series`):
    values[]     — array of { year: number, value: number }
    palette      — 'warming' | 'cooling' | 'rainfall' | 'drought' | 'custom'
    baseline     — string describing the reference period (shown in scale row)
    unit         — string appended to legend values (e.g. '°C', 'mm', 'ppm')
    showYears    — show the year axis row (default true)
    showLegend   — show the Cooler→Warmer scale row (default true)
    customMin/customMax — hex stops for the custom palette
    caption / source

  The kit operates on `series`; here `values` already carries {year, value},
  so it is used directly as the series. The kit hardcodes a blue→red
  `warmColor()` and a "1850–1900" baseline; we keep the richer existing
  palette system (a superset of the kit's warming ramp) and the real
  `baseline` / `unit` props instead of hardcoding.
*/

interface DataPoint {
  year: number;
  value: number;
}

type Palette = 'warming' | 'cooling' | 'rainfall' | 'drought' | 'custom';

/* The annotation layer — docs/design/blueprints/_ANNOTATIONS.md. 0–3 per
   chart, optional everywhere; absent ⇒ nothing renders. `side` / `series`
   are accepted for contract parity: the strip has one series, and its
   callouts always sit above the strip with a leader down to the stripe. */
interface Annotation {
  at: string | number;
  text: string;
  side?: 'above' | 'below' | 'left' | 'right';
  series?: string;
}

interface Props {
  values: DataPoint[];
  annotations?: Annotation[];
  palette?: Palette;
  baseline?: string;
  unit?: string;
  showYears?: boolean;
  showLegend?: boolean;
  customMin?: string;   // hex for custom palette cold end
  customMax?: string;   // hex for custom palette warm end
  caption?: string;
  source?: string;
}

const {
  values = [],
  annotations = [],
  palette = 'warming',
  baseline,
  unit = '',
  showYears = true,
  showLegend = true,
  customMin,
  customMax,
  caption,
  source,
} = Astro.props;

// ── Palette definitions ─────────────────────────────────────────────────────
// Each palette is an array of hex stops from cold/low → warm/high.
const PALETTES: Record<Palette, string[]> = {
  warming: [
    '#08306b', '#2171b5', '#4292c6', '#9ecae1',
    '#deebf7',   // near-neutral
    '#fee0d2', '#fc9272', '#de2d26', '#a50f15',
  ],
  cooling: [
    '#a50f15', '#de2d26', '#fc9272', '#fee0d2',
    '#deebf7',   // near-neutral
    '#9ecae1', '#4292c6', '#2171b5', '#08306b',
  ],
  rainfall: [
    '#7f3b08', '#b35806', '#e08214', '#fdb863',
    '#f7f7f7',   // near-neutral
    '#b2abd2', '#8073ac', '#542788', '#2d004b',
  ],
  drought: [
    '#003c30', '#01665e', '#35978f', '#80cdc1',
    '#f5f5f5',   // near-neutral
    '#dfc27d', '#bf812d', '#8c510a', '#543005',
  ],
  custom: [
    customMin ?? '#08306b',
    '#4292c6',
    '#9ecae1',
    '#deebf7',
    '#fee0d2',
    '#fc9272',
    '#de2d26',
    customMax ?? '#a50f15',
  ],
};

const stops = PALETTES[palette];

// ── Compute value range ──────────────────────────────────────────────────────
const rawValues = values.map((d) => d.value);
const minVal = rawValues.length ? Math.min(...rawValues) : 0;
const maxVal = rawValues.length ? Math.max(...rawValues) : 0;
const range  = maxVal - minVal || 1;

// ── Map value → hex colour via palette stops ─────────────────────────────────
function hexToRgb(h: string): [number, number, number] {
  const n = parseInt(h.replace('#', ''), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}
function lerp(a: number, b: number, t: number) { return Math.round(a + (b - a) * t); }

function valueToColor(val: number): string {
  const t = (val - minVal) / range;           // 0 = coldest, 1 = warmest
  const scaled = t * (stops.length - 1);
  const lo = Math.floor(scaled);
  const hi = Math.min(lo + 1, stops.length - 1);
  const frac = scaled - lo;
  const [r1, g1, b1] = hexToRgb(stops[lo]);
  const [r2, g2, b2] = hexToRgb(stops[hi]);
  return `rgb(${lerp(r1, r2, frac)},${lerp(g1, g2, frac)},${lerp(b1, b2, frac)})`;
}

// ── Anomaly line overlay geometry (kit constants/formulas) ───────────────────
const W = 640, H = 150, n = values.length;
const norm = (v: number) => (v - minVal) / range;
const x  = (i: number) => (n > 1 ? (i / (n - 1)) * W : W / 2);
const yv = (v: number) => H - 12 - norm(v) * (H - 28);
const line = values.map((s, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${yv(s.value).toFixed(1)}`).join(' ');
const len = 1600;

// ── Value formatting (sign + unit), reused for caption peak + nothing else ───
const fmtVal = (v: number) => `${v > 0 ? '+' : ''}${v.toFixed(2)}${unit ? ' ' + unit : ''}`;

const firstYear = values[0]?.year ?? '';
const midYear   = n ? values[Math.floor(n / 2)]?.year ?? '' : '';
const lastYear  = values[n - 1]?.year ?? '';

// ── Annotations ─────────────────────────────────────────────────────────────
// `at` is the YEAR (number, or the numeric string a YAML author may quote).
// A year not in the series is a silent no-op (spec §2).
//
// The x of a stripe is NOT the anomaly line's x(i) — that runs edge to edge.
// The stripes are `.cs__bar { flex: 1 }`, so stripe i spans [i/n, (i+1)/n] of
// the strip and its centre is (i + 0.5)/n. Percent, not SVG units, because the
// callout is HTML: the one SVG here (.cs__overlay) is stretched by
// preserveAspectRatio="none", which would distort any <text> inside it, and it
// is deliberately absent from the dataviz-v2.css natural-scale block, so SVG
// text would also shrink below the 9.5px floor on a phone. HTML text holds 13px
// at every width, and the percent mapping is exact under either.
const annots = (annotations ?? [])   // `annotations:` with no items parses as null
  .map((a) => {
    if (!a || !a.text) return null;
    const i = values.findIndex((s) => String(s.year) === String(a.at));
    if (i < 0) return null;
    return { text: a.text, pct: ((i + 0.5) / n) * 100 };
  })
  .filter((a): a is { text: string; pct: number } => a !== null);
// Past the midpoint the callout mirrors — text right-aligned so it ends ON the
// mark instead of running off the right edge (the HTML twin of text-anchor="end").
const annotPad = (pct: number) =>
  pct > 50
    ? `padding-right:${(100 - pct).toFixed(2)}%;text-align:right`
    : `padding-left:${pct.toFixed(2)}%`;
---

<div class="px-viz" data-reveal>
  <div class="px-viz__cap">
    <span>{caption}</span>
    {n > 0 && <b>{fmtVal(maxVal)} peak</b>}
  </div>

  {annots.length > 0 && (
    <div class="cs__annots" style="position:relative;padding-bottom:20px">
      {annots.map((a) => (
        <div class="cs__annot" style={annotPad(a.pct)}>
          <span class="cs__annot-t vz-annot" style="display:block">{a.text}</span>
          {/* Leader + dot hang off the CONTAINER, not the row, so every dot
              lands on the strip's top edge at its own stripe even when two
              or three callouts stack. */}
          <span class="cs__annot-l" style={`position:absolute;left:${a.pct.toFixed(2)}%;bottom:6px;width:1px;height:14px;margin-left:-0.5px;background:var(--rule)`}></span>
          <span class="cs__annot-d" style={`position:absolute;left:${a.pct.toFixed(2)}%;bottom:0;width:6px;height:6px;margin-left:-3px;border-radius:50%;background:var(--accent)`}></span>
        </div>
      ))}
    </div>
  )}

  <div class="cs__strip">
    {values.map((s, i) => (
      <div
        class="cs__bar"
        style={`background:${valueToColor(s.value)};transition-delay:${i * 14}ms`}
        title={`${s.year}: ${fmtVal(s.value)}`}
        aria-label={`${s.year}: ${fmtVal(s.value)}`}
      />
    ))}
    <svg class="cs__overlay" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img"
      aria-label={`Anomaly trend, ${firstYear}–${lastYear}`}>
      <path class="cs__path" d={line} style={`--len:${len}`} vector-effect="non-scaling-stroke" />
    </svg>
  </div>

  {showYears && n > 0 && (
    <div class="cs__axis">
      <span>{firstYear}</span>
      <span>{midYear}</span>
      <span>{lastYear}</span>
    </div>
  )}

  {showLegend && (
    <div class="cs__scale">
      <span>Cooler</span>
      <span class="cs__grad"></span>
      <span>Warmer</span>
      {baseline && <span style="margin-left:auto">Baseline · {baseline}</span>}
    </div>
  )}

</div>
