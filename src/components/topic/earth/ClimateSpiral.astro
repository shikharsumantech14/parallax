---
/**
 * ClimateSpiral (earth) — the warming spiral, with a MONTH SCRUB (Lens
 * Phase 6, the Lib-climate-spiral board).
 *
 * A build-time polar SVG: angle = month (January at the top, clockwise),
 * radius grows with the month's value across the whole series. The spiral is
 * a chain of short segments through every month in time order, each year one
 * tone of the desk ramp (the first year palest, the last the desk deep).
 * Dashed reference rings sit at round values of the unit and are labelled;
 * the months are lettered round the rim. The highest month is ringed, and its
 * value is the figure's headline number.
 *
 * THE SCRUB (an instrument; its island stays). Dragging winds the record
 * forward month by month: the future drops to a ghost, the centre reads the
 * year you stand in, the readout names that month's value and whether it was
 * the highest yet. The island owns `opacity` on the segments and nothing
 * else; the build owns `stroke-dashoffset`. The segments are flat siblings so
 * one `is-cut` class dims every later segment. The control ships `hidden` and
 * is unhidden only once the payload parses.
 *
 * THE BUILD sits on `.px-spiral__scene`, a scene INSIDE the card: the card
 * also holds the scrub, which JS shows, and a scene must not hold a control
 * that changes its size (LENS §6.4). VizCard's own scene then has no build
 * element of its own.
 *
 * Cue anchors: `<year>` (each year's winding, "2023") · `jan`…`dec` (the
 * month letters) · `ring1`, `ring2`… (the reference rings, inside out) ·
 * `peak` (the highest month) · `head` (the headline number).
 * Build: rings and months (1) · the spiral draws (2) · the peak ring and the
 * ring labels (3) · the headline number (4).
 *
 * data: { months[]{ year, month (1–12), value }, unit?, baseline?,
 *         howToRead?, caption?, source? }
 */
import VizCard from '../../core/VizCard.astro';
import FigHead from './FigHead.astro';
import CueLayer from './CueLayer.astro';
import { SANS, fmt } from './_fig';

interface MonthPt { year: number; month: number; value: number; }
interface Props {
  months: MonthPt[];
  unit?: string;
  baseline?: string;
  howToRead?: string;
  caption?: string;
  source?: string | { label: string; date?: string };
}
const { months = [], unit = '', baseline, howToRead, caption, source } = Astro.props;

/* ── geometry: drawn for a phone (340 units, 13.5 type prints 12px at 305) ── */
const SIZE = 300, PAD = 22, VB = SIZE + PAD * 2;
const cx = SIZE / 2, cy = SIZE / 2;
const rInner = 26, rOuter = 128;

const pts = [...months].sort((a, b) => (a.year - b.year) || (a.month - b.month));
const n = pts.length;
const vals = pts.map((p) => p.value);
const minVal = vals.length ? Math.min(...vals) : 0;
const maxVal = vals.length ? Math.max(...vals) : 0;
const range = maxVal - minVal || 1;
const norm = (v: number) => (v - minVal) / range;
const angleFor = (month: number) => (-90 + ((month - 1) / 12) * 360) * (Math.PI / 180);
const radiusFor = (v: number) => rInner + norm(v) * (rOuter - rInner);
const coord = (month: number, v: number) => {
  const a = angleFor(month), r = radiusFor(v);
  return { x: cx + Math.cos(a) * r, y: cy + Math.sin(a) * r };
};
const xy = pts.map((p) => coord(p.month, p.value));

/* each year one tone of the desk ramp */
const years = [...new Set(pts.map((p) => p.year))];
const tone = (year: number) => {
  const t = years.length > 1 ? years.indexOf(year) / (years.length - 1) : 1;
  return t < 0.5
    ? `color-mix(in oklab, var(--accent) ${Math.round(45 + t * 110)}%, var(--accent-tint))`
    : `color-mix(in oklab, var(--deep, var(--ink)) ${Math.round((t - 0.5) * 160)}%, var(--accent))`;
};
const segments = xy.slice(1).map((b, i) => {
  const a = xy[i];
  return { d: `M ${a.x.toFixed(1)} ${a.y.toFixed(1)} L ${b.x.toFixed(1)} ${b.y.toFixed(1)}`, year: pts[i + 1].year, i };
});

/* reference rings at round values inside the range (at most three) */
const ringStep = [0.25, 0.5, 1, 2, 5, 10, 25, 50].find((s) => range / s <= 3) ?? 100;
const rings: number[] = [];
for (let v = Math.ceil(minVal / ringStep) * ringStep; v <= maxVal + 1e-9; v += ringStep) {
  if (radiusFor(v) - rInner > 14) rings.push(+v.toFixed(2));
}

const MONTH_LBL = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthLabels = MONTH_LBL.map((m, idx) => {
  const a = angleFor(idx + 1), r = rOuter + 14;
  return { id: m.toLowerCase(), m: m[0], x: cx + Math.cos(a) * r, y: cy + Math.sin(a) * r + 4.5, lx: cx + Math.cos(a) * rOuter, ly: cy + Math.sin(a) * rOuter };
});

const peakI = vals.indexOf(maxVal);
const peak = pts[peakI];
const fmtVal = (v: number) => `${v > 0 ? '+' : ''}${v.toFixed(2)}${unit ? ' ' + unit : ''}`;
const firstYear = pts[0]?.year ?? '';
const lastYear = pts[n - 1]?.year ?? '';

/* ── the scrub payload: [markerX, markerY, year, month, value, isRecord] ── */
let runMax = -Infinity;
const monthTable = pts.map((p, i) => {
  const isRecord = p.value > runMax;
  if (isRecord) runMax = p.value;
  return [+xy[i].x.toFixed(1), +xy[i].y.toFixed(1), p.year, p.month, p.value, isRecord && i > 0 ? 1 : 0];
});
const restReadout = n ? `${firstYear}–${lastYear} · ${n} months · peak ${fmtVal(maxVal)}` : 'No data';
const readoutFor = (r: (number | string)[]) =>
  `${MONTH_LBL[(r[3] as number) - 1]} ${r[2]} · ${fmtVal(r[4] as number)}${r[5] ? ' · warmest month yet' : ''}`;
const longestReadout = monthTable.map(readoutFor).concat(restReadout).reduce((a, b) => (b.length > a.length ? b : a), '');

/* ── the cue numerals: placed clear of every month letter, ring label, the
   centre year and each other. A numeral is a 20px disc, about 12 units at
   the widest the plot is drawn (it prints at real size, the drawing
   scales). Each tries its preferred side first, then turns round its
   anchor and steps further out, and takes the first spot that touches
   nothing and stays inside the viewBox. ── */
type TBox = { x0: number; y0: number; x1: number; y1: number };
const R_TAG = 12;
const tHit = (a: TBox, b: TBox) => a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 && b.y0 < a.y1;
const ringLabel = (v: number) => `${fmt(v, 2)}${unit ? ` ${unit}` : ''}`;
const blocked: TBox[] = [
  ...monthLabels.map((l) => ({ x0: l.x - 8, y0: l.y - 15, x1: l.x + 8, y1: l.y + 3 })),
  ...rings.map((v) => {
    const x = cx + radiusFor(v) * 0.707 + 3, y = cy - radiusFor(v) * 0.707 - 4;
    return { x0: x - 2, y0: y - 14, x1: x + ringLabel(v).length * 14.5 * 0.6 + 2, y1: y + 4 };
  }),
  { x0: cx - 22, y0: cy - 12, x1: cx + 22, y1: cy + 10 },
];
const placeTag = (id: string | number, ax: number, ay: number, prefer: number) => {
  const turns = [0, 0.785, -0.785, 1.571, -1.571, 2.356, -2.356, 3.142];
  for (const d of [14, 20, 28, 36]) {
    for (const t of turns) {
      const x = ax + Math.cos(prefer + t) * d, y = ay + Math.sin(prefer + t) * d;
      const box = { x0: x - R_TAG, y0: y - R_TAG, x1: x + R_TAG, y1: y + R_TAG };
      if (box.x0 < -PAD || box.y0 < -PAD || box.x1 > SIZE + PAD || box.y1 > SIZE + PAD) continue;
      if (blocked.some((q) => tHit(box, q))) continue;
      blocked.push(box);
      return { id, x, y };
    }
  }
  return { id, x: ax, y: ay };
};
const outward = (x: number, y: number) => Math.atan2(y - cy, x - cx);
const tags = [
  ...(peak ? [placeTag('peak', xy[peakI].x, xy[peakI].y, outward(xy[peakI].x, xy[peakI].y) - Math.PI / 2)] : []),
  ...rings.map((v, k) => {
    const x = cx + radiusFor(v) * 0.707 + 3 + ringLabel(v).length * 14.5 * 0.6, y = cy - radiusFor(v) * 0.707 - 9;
    return placeTag(`ring${k + 1}`, x, y, -Math.PI / 2);
  }),
  ...monthLabels.map((l) => placeTag(l.id, l.x, l.y - 6, outward(l.x, l.y) + Math.PI / 2)),
  ...years.map((y) => {
    const last = pts.map((p, i) => ({ p, i })).filter((o) => o.p.year === y).pop()!;
    const px = xy[last.i].x, py = xy[last.i].y;
    return placeTag(y, px, py, outward(px, py) + Math.PI);
  }),
];
const headLabel = peak ? `${unit ? unit + ', ' : ''}${MONTH_LBL[peak.month - 1]} ${peak.year}` : undefined;
---

<VizCard prefix="px-spiral" howToRead={howToRead} caption={caption} source={source}>
  <div
    class="px-spiral__box"
    data-spr-box
    data-spr-unit={unit}
    data-spr-rest={restReadout}
    data-spr-last={String(lastYear)}
  >
    <div class="px-spiral__scene" data-build-scene>
      {peak && <FigHead value={peak.value.toFixed(2)} label={headLabel} n={4} />}
      <div class="px-spiral__plot">
        <svg
          class="px-spiral__fig"
          viewBox={`${-PAD} ${-PAD} ${VB} ${VB}`}
          role="img"
          aria-label={`Climate spiral, ${firstYear} to ${lastYear}: the highest month ${peak ? `${MONTH_LBL[peak.month - 1]} ${peak.year}, ${fmtVal(maxVal)}` : ''}${baseline ? `, against the ${baseline}` : ''}.`}
        >
          <g class="px-spiral__grid" data-build="1">
            {monthLabels.map((l) => <line x1={cx} y1={cy} x2={l.lx.toFixed(1)} y2={l.ly.toFixed(1)} />)}
          </g>
          {rings.map((v, k) => (
            <g class="px-spiral__ring" data-cue={`ring${k + 1}`}>
              <circle cx={cx} cy={cy} r={radiusFor(v).toFixed(1)} data-build="1" />
              <text x={(cx + radiusFor(v) * 0.707 + 3).toFixed(1)} y={(cy - radiusFor(v) * 0.707 - 4).toFixed(1)} style={SANS} data-build="3" data-build-kind="rise">{fmt(v, 2)}{unit ? ` ${unit}` : ''}</text>
            </g>
          ))}
          {monthLabels.map((l) => (
            <text class="px-spiral__m" data-cue={l.id} x={l.x.toFixed(1)} y={l.y.toFixed(1)} text-anchor="middle" style={SANS} data-build="1">{l.m}</text>
          ))}

          {/* the spiral: flat siblings, so the scrub dims the future with one class */}
          <g class="px-spiral__path">
            {segments.map((s) => (
              <path class="px-spiral__seg" data-spr-seg={s.i} data-cue={s.year} d={s.d} style={`stroke:${tone(s.year)}`} data-build="2" data-build-kind="draw" />
            ))}
          </g>

          {peak && (
            <circle class="px-spiral__peak" data-cue="peak" cx={xy[peakI].x.toFixed(1)} cy={xy[peakI].y.toFixed(1)} r="5" data-build="3" data-build-kind="drop" />
          )}
          <circle class="px-spiral__cursor" data-spr-mark cx={cx} cy={cy} r="5" />
          <text class="px-spiral__yr" data-spr-year x={cx} y={cy + 6} text-anchor="middle" style={SANS}>{lastYear}</text>
        </svg>
        <CueLayer w={VB} h={VB} x0={-PAD} y0={-PAD} tags={tags} />
      </div>

      <div class="px-spiral__key">
        {years.length <= 6
          ? years.map((y) => <span><i style={`background:${tone(y)}`}></i>{y}</span>)
          : <span class="px-spiral__ramp">{firstYear}<i style={`background:linear-gradient(90deg, ${tone(years[0])}, ${tone(years[years.length - 1])})`}></i>{lastYear}</span>}
        {baseline && <p class="px-spiral__base">Against the {baseline}</p>}
      </div>
    </div>

    {/* JS-only control. Ships hidden; the island unhides it once the payload
        has parsed, so a bad payload degrades to the static spiral. */}
    {n > 1 && (
      <div class="px-spiral__scrub px-inst__controls" hidden data-spr-scrub>
        <label class="px-spiral__scrub-lab">
          <span>Month: drag to wind the spiral</span>
          <input class="px-spiral__range px-inst__drag" type="range" min="0" max={n - 1} step="1" value={n - 1} data-spr-range />
        </label>
      </div>
    )}

    <p class="px-spiral__readout px-inst__readout px-inst__readout--sized">
      <span data-spr-readout aria-live="polite">{restReadout}</span>
      <span class="px-inst__sizer" aria-hidden="true">{longestReadout}</span>
    </p>

    <script type="application/json" class="px-spiral__data" data-spr-data set:html={JSON.stringify(monthTable)} />
  </div>
</VizCard>

<script is:inline>
  (function () {
    if (!document.documentElement.classList.contains('js')) return;
    var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    document.querySelectorAll('[data-spr-box]').forEach(function (box) {
      var raw = box.querySelector('[data-spr-data]');
      var range = box.querySelector('[data-spr-range]');
      var scrub = box.querySelector('[data-spr-scrub]');
      if (!raw || !range || !scrub) return;

      var table;
      try { table = JSON.parse(raw.textContent); } catch (e) { return; }
      if (!table || table.length < 2) return;

      var segs = box.querySelectorAll('[data-spr-seg]');
      var mark = box.querySelector('[data-spr-mark]');
      var yearEl = box.querySelector('[data-spr-year]');
      var out = box.querySelector('[data-spr-readout]');
      var unit = box.getAttribute('data-spr-unit') || '';
      var rest = box.getAttribute('data-spr-rest') || '';
      var lastYear = box.getAttribute('data-spr-last') || '';
      var last = table.length - 1;
      var cut = null;                     // the segment currently marked

      function fmt(v) { return (v > 0 ? '+' : '') + v.toFixed(2) + (unit ? ' ' + unit : ''); }

      function paint(i) {
        var row = table[Math.max(0, Math.min(last, i))];
        if (!row) return;
        var atRest = i >= last;

        // move the cut, never walk the series: one class off, one class on.
        if (cut) { cut.classList.remove('is-cut'); cut = null; }
        if (!atRest && segs[i]) { cut = segs[i]; cut.classList.add('is-cut'); }

        box.setAttribute('data-scrubbing', atRest ? 'false' : 'true');
        mark.setAttribute('cx', row[0]);
        mark.setAttribute('cy', row[1]);
        yearEl.textContent = atRest ? lastYear : row[2];
        out.textContent = atRest
          ? rest
          : MONTHS[row[3] - 1] + ' ' + row[2] + ' · ' + fmt(row[4])
            + (row[5] ? ' · warmest month yet' : '');
      }

      range.addEventListener('input', function () { paint(parseInt(range.value, 10)); });
      scrub.removeAttribute('hidden');
    });
  })();
</script>

<style>
  .px-spiral__box { width: 100%; }
  .px-spiral__plot { position: relative; width: 100%; max-width: 400px; margin: 0 auto; }
  .px-spiral__fig { display: block; width: 100%; height: auto; overflow: visible; }
  .px-spiral__grid line { stroke: var(--hair); stroke-width: 1; }
  .px-spiral__ring circle { fill: none; stroke: var(--ink-2, var(--ink-soft)); stroke-width: 1; stroke-dasharray: 3 4; }
  .px-spiral__ring text {
    font-size: 14.5px; font-weight: 600; fill: var(--ink); font-variant-numeric: tabular-nums;
    paint-order: stroke; stroke: var(--paper-2); stroke-width: 4px; stroke-linejoin: round;
  }
  .px-spiral__m { font-size: 14.5px; font-weight: 600; fill: var(--ink-2, var(--ink-soft)); }
  .px-spiral__seg { fill: none; stroke-width: 2.5; stroke-linecap: round; }
  /* the un-wound remainder of the record: one marked segment dims every
     segment after it, so the island never walks the series */
  .px-spiral__seg.is-cut,
  .px-spiral__seg.is-cut ~ .px-spiral__seg { opacity: 0.13; }
  .px-spiral__peak { fill: var(--paper-2); stroke: var(--ink); stroke-width: 2; }
  .px-spiral__cursor { display: none; fill: var(--ink); stroke: var(--paper); stroke-width: 2; }
  .px-spiral__box[data-scrubbing='true'] .px-spiral__cursor { display: block; }
  .px-spiral__yr { font-size: 16px; font-weight: 600; fill: var(--ink); font-variant-numeric: tabular-nums; }
  .px-spiral__key { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 16px; margin-top: 12px; font-family: var(--font-ui); font-size: 13px; color: var(--ink-2, var(--ink-soft)); font-variant-numeric: tabular-nums; }
  .px-spiral__key span { display: inline-flex; align-items: center; gap: 7px; }
  .px-spiral__key i { display: inline-block; width: 22px; height: 3px; border-radius: 2px; }
  .px-spiral__ramp i { width: 80px; height: 8px; }
  .px-spiral__base { flex-basis: 100%; margin: 0; text-align: center; font-size: 12px; color: var(--muted); }
  .px-spiral__scrub[hidden] { display: none; }
  .px-spiral__scrub { margin-top: 12px; }
  .px-spiral__scrub-lab {
    display: flex; flex-direction: column; gap: 8px; width: 100%;
    font-family: var(--font-ui); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted);
  }
  .px-spiral__range { width: 100%; min-height: 44px; accent-color: var(--accent-deep, var(--accent)); cursor: pointer; }
  .px-spiral__range:focus-visible { outline: 2px solid var(--accent-deep); outline-offset: 3px; }
  .px-spiral__readout { font-family: var(--font-ui); font-size: 13px; color: var(--ink-2, var(--ink-soft)); font-variant-numeric: tabular-nums; }
  /* An SVG anchor lights by opacity alone: an outline on an SVG shape draws
     its bounding box, not a ring (the CueLayer numeral takes the ring). */
  svg [data-cue] { outline: none !important; }
</style>
