---
/**
 * ClimateSpiral (earth) — the warming spiral, with a TIME SCRUB.
 *
 * A build-time polar SVG: angle = month (January at the top, advancing
 * clockwise), radius ∝ the month's value normalised across the whole series
 * (larger value → larger radius). The spiral is drawn as a chain of short
 * connected segments through every month in chronological order, each segment
 * coloured by its value (cool → warm). Faint concentric reference rings +
 * month labels ring the rim.
 *
 * B1 retrofit (docs/REVAMP-PLAN.md §4 Phase 6.2). The finished spiral shows
 * the whole record at once, which is the one view in which the shape cannot be
 * read: every winding overlaps every other. Dragging the scrub winds it
 * forward month by month — the future drops to a ghost, the centre reads the
 * year you are standing in, and the readout names that month's value and
 * whether it was a new high.
 *
 * TWO ANIMATIONS, TWO PROPERTIES — this is the load-bearing detail. The
 * scroll-in reveal owns `stroke-dashoffset` (each segment draws itself in
 * sequence, staggered by `--d`). The scrub owns `opacity` and nothing else, so
 * the two can never fight over a value, and neither has to know the other
 * exists. Opacity is deliberately NOT transitioned: a scrub must track the
 * finger, and a 200ms fade on 500 segments does not.
 *
 * The dimming is one class move, not a loop. Segments are flat siblings, so
 * marking the first future segment `is-cut` lets a sibling combinator dim
 * every segment after it in CSS. The island touches two elements per input
 * event regardless of series length — a 170-year record costs the same as this
 * 4-year one.
 *
 * No-JS / reduced-motion: every segment paints fully drawn at full opacity
 * (the dash-offset hidden rule sits behind `html.js`; reduced-motion resets
 * with !important), the scrubber never renders — it ships `hidden` and the
 * island unhides it only after the payload parses — and the centre reads the
 * full span. Reduced-motion keeps the scrub working; it is comprehension.
 *
 * data: { months[]{ year, month (1–12), value }, unit?, baseline?,
 *         howToRead?, caption?, source? }
 */
import VizCard from '../../core/VizCard.astro';

interface MonthPt { year: number; month: number; value: number; }
interface Props {
  months: MonthPt[];
  unit?: string;
  baseline?: string;
  howToRead?: string;
  caption?: string;
  source?: string | { label: string; date?: string };
}
const { months = [], unit = '', baseline, howToRead, caption, source } = Astro.props;

// ── geometry ────────────────────────────────────────────────────────────────
const SIZE = 460;
const cx = SIZE / 2, cy = SIZE / 2;
const rInner = 40;            // radius for the minimum value
const rOuter = 196;          // radius for the maximum value

// viewBox headroom: month labels sit at rOuter+20 and the 3/9-o'clock ones
// are anchored outward, so their text runs ~24px past the rim point. Pad the
// viewBox on every side (drawing stays centred on cx/cy) so no label clips.
const PAD = 30;
const VB = SIZE + PAD * 2;   // padded viewBox extent

// chronological order (year, then month) so the spiral winds forward in time
const pts = [...months].sort((a, b) => (a.year - b.year) || (a.month - b.month));
const n = pts.length;

const vals = pts.map((p) => p.value);
const minVal = vals.length ? Math.min(...vals) : 0;
const maxVal = vals.length ? Math.max(...vals) : 0;
const range = maxVal - minVal || 1;
const norm = (v: number) => (v - minVal) / range;          // 0 = coolest, 1 = warmest

// month (1–12) → angle. Jan at top (−90°), clockwise.
const angleFor = (month: number) => (-90 + ((month - 1) / 12) * 360) * (Math.PI / 180);
const radiusFor = (v: number) => rInner + norm(v) * (rOuter - rInner);

const coord = (month: number, v: number) => {
  const a = angleFor(month);
  const r = radiusFor(v);
  return { x: cx + Math.cos(a) * r, y: cy + Math.sin(a) * r };
};

const xy = pts.map((p) => coord(p.month, p.value));

// diverging cool→warm ramp (semantic blue → red, theme-neutral)
const RAMP = ['#2166ac', '#67a9cf', '#d1e5f0', '#fddbc7', '#ef8a62', '#c0392b'];
function hexToRgb(h: string): [number, number, number] {
  const x = parseInt(h.replace('#', ''), 16);
  return [(x >> 16) & 255, (x >> 8) & 255, x & 255];
}
const lerp = (a: number, b: number, t: number) => Math.round(a + (b - a) * t);
function rampColor(t: number): string {
  const s = Math.max(0, Math.min(1, t)) * (RAMP.length - 1);
  const lo = Math.floor(s), hi = Math.min(lo + 1, RAMP.length - 1), f = s - lo;
  const [r1, g1, b1] = hexToRgb(RAMP[lo]);
  const [r2, g2, b2] = hexToRgb(RAMP[hi]);
  return `rgb(${lerp(r1, r2, f)},${lerp(g1, g2, f)},${lerp(b1, b2, f)})`;
}

// one segment per consecutive pair, coloured by the segment's mean value.
// length approximated for the per-segment dash-draw (--len, generous pad).
const segments = xy.slice(1).map((p, i) => {
  const a = xy[i], b = p;
  const dx = b.x - a.x, dy = b.y - a.y;
  const len = Math.ceil(Math.hypot(dx, dy)) + 2;
  const meanT = (norm(pts[i].value) + norm(pts[i + 1].value)) / 2;
  return { d: `M ${a.x.toFixed(1)} ${a.y.toFixed(1)} L ${b.x.toFixed(1)} ${b.y.toFixed(1)}`,
    color: rampColor(meanT), len, i };
});

// per-segment draw delay so the whole spiral traces in ~1.6s regardless of n
const totalDraw = 1600;
const stepDelay = n > 1 ? totalDraw / (n - 1) : 0;

// concentric reference rings (evenly spaced between inner and outer radius)
const RINGS = 4;
const rings = Array.from({ length: RINGS }, (_, i) =>
  rInner + ((i + 1) / RINGS) * (rOuter - rInner)
);

// month labels around the rim (just outside the outer radius). Anchor +
// baseline are chosen per quadrant so a label hugs the rim point from its
// outer side instead of overrunning the spiral (or the SVG edge) — the
// 3-o'clock / 9-o'clock labels especially need horizontal anchoring.
const MONTH_LBL = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const EPS = 0.5;
const monthLabels = MONTH_LBL.map((m, idx) => {
  const a = angleFor(idx + 1);
  const r = rOuter + 20;
  const dx = Math.cos(a), dy = Math.sin(a);
  // anchor by horizontal direction; baseline by vertical direction
  const anchor = dx > EPS ? 'start' : dx < -EPS ? 'end' : 'middle';
  const base = dy > EPS ? 'hanging' : dy < -EPS ? 'auto' : 'middle';
  return { m, x: cx + dx * r, y: cy + dy * r, anchor, base };
});

const fmtVal = (v: number) => `${v > 0 ? '+' : ''}${v.toFixed(2)}${unit ? ' ' + unit : ''}`;
const firstYear = pts[0]?.year ?? '';
const lastYear = pts[n - 1]?.year ?? '';

/* ── the scrub payload ────────────────────────────────────────────────────
   One row per month: [markerX, markerY, year, month(1–12), value, isRecord].
   `isRecord` is a RUNNING max over the series up to that month — the honest
   form of "a new high", which can only ever mean "highest so far", never
   "highest in a record the reader has not been shown yet". */
let runMax = -Infinity;
const monthTable = pts.map((p, i) => {
  const isRecord = p.value > runMax;
  if (isRecord) runMax = p.value;
  return [
    +xy[i].x.toFixed(1),
    +xy[i].y.toFixed(1),
    p.year,
    p.month,
    p.value,
    isRecord && i > 0 ? 1 : 0,
  ];
});

const restReadout = n
  ? `${firstYear}–${lastYear} · ${n} months · peak ${fmtVal(maxVal)}`
  : 'No data';

/* The longest string this readout can ever show. Rendered as the hidden twin
   that `px-inst__readout--sized` stacks behind the live line, so the box
   reserves the true height and cannot reflow under a dragging finger — see the
   rule in src/styles/dataviz-v2.css for why min-height alone cannot do it. */
const readoutFor = (r: (number | string)[]) =>
  `${MONTH_LBL[(r[3] as number) - 1]} ${r[2]} · ${fmtVal(r[4] as number)}${r[5] ? ' · warmest month yet' : ''}`;
const longestReadout = monthTable
  .map(readoutFor)
  .concat(restReadout)
  .reduce((a, b) => (b.length > a.length ? b : a), '');
---

<VizCard
  prefix="px-spiral"
  howToRead={howToRead}
  caption={caption}
  source={source}
  chip={n > 0 ? `${fmtVal(maxVal)} peak` : undefined}
>
  <div
    class="px-spiral__box"
    data-spr-box
    data-spr-unit={unit}
    data-spr-rest={restReadout}
    data-spr-last={String(lastYear)}
  >
    <svg
      class="px-spiral__svg"
      viewBox={`${-PAD} ${-PAD} ${VB} ${VB}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={caption ? `Climate spiral: ${caption}, ${firstYear}–${lastYear}` : `Climate spiral, ${firstYear}–${lastYear}`}
    >
      {/* reference rings */}
      <g class="px-spiral__rings">
        {rings.map((r) => (
          <circle cx={cx} cy={cy} r={r.toFixed(1)} class="px-spiral__ring" />
        ))}
      </g>

      {/* month labels (anchored per quadrant so they hug the rim, not the spiral) */}
      <g class="px-spiral__months">
        {monthLabels.map((l) => (
          <text x={l.x.toFixed(1)} y={l.y.toFixed(1)} text-anchor={l.anchor} dominant-baseline={l.base}>{l.m}</text>
        ))}
      </g>

      {/* the spiral, coloured segment by segment. Flat siblings on purpose:
          the scrub dims the future with one sibling-combinator rule, so the
          island moves a single class instead of walking the whole series. */}
      <g class="px-spiral__path">
        {segments.map((s) => (
          <path
            class="px-spiral__seg"
            data-spr-seg={s.i}
            d={s.d}
            style={`stroke:${s.color}; --len:${s.len}; --d:${(s.i * stepDelay).toFixed(0)}ms`}
          />
        ))}
      </g>

      {/* where the scrub is standing on the spiral */}
      <circle class="px-spiral__cursor" data-spr-mark cx={cx} cy={cy} r="5" />

      {/* center span readout */}
      <text class="px-spiral__yr px-spiral__yr--lo" x={cx} y={cy - 8} text-anchor="middle">{firstYear}</text>
      <text class="px-spiral__yr px-spiral__yr--hi" data-spr-year x={cx} y={cy + 14} text-anchor="middle">{lastYear}</text>
    </svg>

    <div class="px-spiral__scale">
      <span>Cooler</span>
      <span class="px-spiral__grad"></span>
      <span>Warmer</span>
      {baseline && <span class="px-spiral__base">Baseline · {baseline}</span>}
    </div>

    {/* JS-only control. Ships hidden; the island unhides it only once the
        payload has parsed, so a bad payload degrades to the static spiral. */}
    {n > 1 && (
      <div class="px-spiral__scrub px-inst__controls" hidden data-spr-scrub>
        <label class="px-spiral__scrub-lab">
          <span>Month — drag to wind the spiral</span>
          <input
            class="px-spiral__range px-inst__drag"
            type="range"
            min="0"
            max={n - 1}
            step="1"
            value={n - 1}
            data-spr-range
          />
        </label>
      </div>
    )}

    <p class="px-spiral__readout px-inst__readout px-inst__readout--sized">
      <span data-spr-readout aria-live="polite">{restReadout}</span>
      <span class="px-inst__sizer" aria-hidden="true">{longestReadout}</span>
    </p>

    <script type="application/json" class="px-spiral__data" data-spr-data set:html={JSON.stringify(monthTable)} />
  </div>
</VizCard>

<script is:inline>
  (function () {
    if (!document.documentElement.classList.contains('js')) return;
    var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    document.querySelectorAll('[data-spr-box]').forEach(function (box) {
      var raw = box.querySelector('[data-spr-data]');
      var range = box.querySelector('[data-spr-range]');
      var scrub = box.querySelector('[data-spr-scrub]');
      if (!raw || !range || !scrub) return;

      var table;
      try { table = JSON.parse(raw.textContent); } catch (e) { return; }
      if (!table || table.length < 2) return;

      var segs = box.querySelectorAll('[data-spr-seg]');
      var mark = box.querySelector('[data-spr-mark]');
      var yearEl = box.querySelector('[data-spr-year]');
      var out = box.querySelector('[data-spr-readout]');
      var unit = box.getAttribute('data-spr-unit') || '';
      var rest = box.getAttribute('data-spr-rest') || '';
      var lastYear = box.getAttribute('data-spr-last') || '';
      var last = table.length - 1;
      var cut = null;                     // the segment currently marked

      function fmt(v) { return (v > 0 ? '+' : '') + v.toFixed(2) + (unit ? ' ' + unit : ''); }

      function paint(i) {
        var row = table[Math.max(0, Math.min(last, i))];
        if (!row) return;
        var atRest = i >= last;

        // move the cut, never walk the series: one class off, one class on.
        if (cut) { cut.classList.remove('is-cut'); cut = null; }
        if (!atRest && segs[i]) { cut = segs[i]; cut.classList.add('is-cut'); }

        box.setAttribute('data-scrubbing', atRest ? 'false' : 'true');
        mark.setAttribute('cx', row[0]);
        mark.setAttribute('cy', row[1]);
        yearEl.textContent = atRest ? lastYear : row[2];
        out.textContent = atRest
          ? rest
          : MONTHS[row[3] - 1] + ' ' + row[2] + ' · ' + fmt(row[4])
            + (row[5] ? ' · warmest month yet' : '');
      }

      range.addEventListener('input', function () { paint(parseInt(range.value, 10)); });
      scrub.removeAttribute('hidden');
    });
  })();
</script>

<style>
  .px-spiral__box { width: 100%; }
  /* max-width tracks the padded viewBox (SIZE 460 + 2×30 pad) so the spiral
     keeps its drawn size while the label headroom stays inside the box. */
  .px-spiral__svg { width: 100%; height: auto; max-width: 520px; margin: 0 auto; display: block; overflow: visible; }

  .px-spiral__ring { fill: none; stroke: var(--rule); stroke-width: 1; opacity: 0.7; }

  .px-spiral__months text {
    font-family: var(--font-mono);
    font-size: var(--viz-fs-axis, 9.5px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    fill: var(--muted);
    /* month labels sit over the reference rings — paper halo keeps them legible */
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 2.5px;
    stroke-linejoin: round;
  }

  .px-spiral__seg {
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    /* base/resting = fully drawn (no-JS safe) */
    stroke-dasharray: var(--len);
    stroke-dashoffset: 0;
    /* the reveal owns stroke-dashoffset and ONLY that. The scrub owns opacity,
       which is deliberately not transitioned — a scrub must track the finger. */
    transition: stroke-dashoffset 240ms linear var(--d);
  }

  /* the un-wound remainder of the record. One marked segment dims every
     segment after it, so the island never walks the series. */
  .px-spiral__seg.is-cut,
  .px-spiral__seg.is-cut ~ .px-spiral__seg { opacity: 0.13; }

  .px-spiral__cursor {
    display: none;
    fill: var(--ink);
    stroke: var(--paper);
    stroke-width: 2;
  }
  .px-spiral__box[data-scrubbing='true'] .px-spiral__cursor { display: block; }

  .px-spiral__yr {
    font-family: var(--issue-face, var(--font-display));
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    fill: var(--ink);
  }
  .px-spiral__yr--lo { font-size: 14px; fill: var(--muted); }
  .px-spiral__yr--hi { font-size: 20px; fill: var(--ink); }

  /* reveal: each segment draws in chronological order (gated behind html.js) */
  html.js .px-viz:not(.is-in) .px-spiral__seg { stroke-dashoffset: var(--len); }

  .px-spiral__scale {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: var(--viz-fs-legend, 10px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .px-spiral__grad {
    width: 120px; height: 12px; border-radius: 6px;
    background: linear-gradient(90deg, #2166ac, #67a9cf, #d1e5f0, #fddbc7, #ef8a62, #c0392b);
  }
  .px-spiral__base { margin-left: auto; }

  .px-spiral__scrub[hidden] { display: none; }
  .px-spiral__scrub-lab {
    display: flex; flex-direction: column; gap: 8px; width: 100%;
    font-family: var(--font-mono); font-size: var(--viz-fs-legend, 10px);
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
  .px-spiral__range {
    width: 100%;
    /* the CANON touch floor applies to the whole control, not just the thumb */
    min-height: 44px;
    accent-color: var(--accent-deep, var(--accent));
    cursor: pointer;
  }
  .px-spiral__range:focus-visible { outline: 2px solid var(--accent-deep); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .px-viz:not(.is-in) .px-spiral__seg { stroke-dashoffset: 0 !important; }
    /* the scrub still works — it is comprehension. Only the draw-in goes. */
  }
</style>
