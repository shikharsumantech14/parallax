---
/**
 * StormTrack (earth · WebGL · extends the shared country globe) — "The whole
 * storm, from a tropical wave to landfall, in one arc." A tropical cyclone's
 * best-track polyline drawn on the globe, each segment coloured by its intensity
 * at that hour on the fixed Saffir-Simpson ramp; drag to follow it across the
 * basin. Lazy WebGL (scene 'storm-track').
 *
 * Blueprint (the contract): docs/design/blueprints/earth/storm-track.md.
 * The Saffir-Simpson ramp lives once in the scene module
 * (src/scripts/viz3d/scenes/stormTrack.ts: `saffirSimpson` / `SAFFIR_RAMP`) —
 * imported here so the no-JS / reduced-motion / no-WebGL fallback plate paints
 * the IDENTICAL encoding as a composed orthographic basin still (§7): coastlines,
 * intensity-coloured track, fix markers sized by wind, landfall rings, the peak
 * halo, the declared ramp legend, and the field-note track table.
 *
 * data: { storms:[{ name, fixes:[{ t, lat, lon, wind_kt, landfall? }] }],
 *         windScale?, smooth?, caption?, source? (REQUIRED) }  — category is
 *         DERIVED from wind_kt, never authored.
 */
import { geoOrthographic, geoPath, geoGraticule } from 'd3-geo';
import { feature } from 'topojson-client';
import type { Topology, Objects } from 'topojson-specification';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { saffirSimpson, SAFFIR_RAMP, catLabel } from '../../../scripts/viz3d/scenes/stormTrack';

interface Fix { t: string; lat: number; lon: number; wind_kt: number; landfall?: boolean; }
interface Storm { name: string; fixes: Fix[]; }
interface Props {
  storms?: Storm[];
  windScale?: string;
  smooth?: boolean;
  caption?: string;
  source?: string;
}
const { storms = [], windScale = 'kt', smooth = true, caption, source } = Astro.props;

const validStorms: Storm[] = (storms || []).filter((s) => s && Array.isArray(s.fixes) && s.fixes.length > 0);
const allFixes: Fix[] = validStorms.flatMap((s) => s.fixes);

/* ── mean lat/lon (unit-vector average) → the basin the plate centres on ── */
const D2R = Math.PI / 180;
let mx = 0, my = 0, mz = 0;
for (const f of allFixes) {
  const phi = f.lat * D2R, lam = f.lon * D2R;
  mx += Math.cos(phi) * Math.cos(lam); my += Math.cos(phi) * Math.sin(lam); mz += Math.sin(phi);
}
const meanLat = allFixes.length ? Math.atan2(mz, Math.hypot(mx, my)) / D2R : 0;
const meanLon = allFixes.length ? Math.atan2(my, mx) / D2R : 0;

/* ── build-time orthographic projection (blueprint §7) ── */
const VW = 720, VH = 720, RAD = 320;
const projection = geoOrthographic()
  .rotate([-meanLon, -meanLat])
  .scale(RAD)
  .translate([VW / 2, VH / 2])
  .clipAngle(90);
const pathGen = geoPath(projection as any);
const gratGen = geoGraticule().step([15, 15]);

/* near-side test: angular distance from the projection centre < 90° */
const centreVec = [Math.cos(meanLat * D2R) * Math.cos(meanLon * D2R), Math.cos(meanLat * D2R) * Math.sin(meanLon * D2R), Math.sin(meanLat * D2R)];
const nearSide = (lat: number, lon: number) => {
  const v = [Math.cos(lat * D2R) * Math.cos(lon * D2R), Math.cos(lat * D2R) * Math.sin(lon * D2R), Math.sin(lat * D2R)];
  return centreVec[0] * v[0] + centreVec[1] * v[1] + centreVec[2] * v[2] > -0.02;
};
const project = (lat: number, lon: number): [number, number] | null => {
  const p = (projection as any)([lon, lat]);
  return p && nearSide(lat, lon) ? [p[0], p[1]] : null;
};

/* ── land coastlines (Natural Earth 50m; horizon-clipped by geoPath) ── */
let landPath = '';
try {
  const topo = JSON.parse(readFileSync(join(process.cwd(), 'node_modules/world-atlas/land-50m.json'), 'utf-8')) as Topology<Objects<{}>>;
  const land = feature(topo, topo.objects['land'] as any);
  landPath = pathGen(land as any) || '';
} catch { landPath = ''; }
const graticulePath = pathGen(gratGen() as any) || '';
const spherePath = pathGen({ type: 'Sphere' } as any) || '';

/* ── per-storm fallback geometry ── */
const markerR = (w: number) => 2.6 + 4.4 * (w / 160);
interface Seg { d: string; color: string; }
interface Mark { x: number; y: number; r: number; color: string; landfall: boolean; }
interface PlateStorm {
  name: string; nameAt: [number, number] | null;
  segs: Seg[]; marks: Mark[];
  peak: { x: number; y: number; r: number; color: string; label: string } | null;
  landfalls: { x: number; y: number; label: string }[];
}
const plateStorms: PlateStorm[] = validStorms.map((storm) => {
  const fixes = storm.fixes;
  let peakIdx = 0;
  for (let i = 1; i < fixes.length; i++) if (fixes[i].wind_kt > fixes[peakIdx].wind_kt) peakIdx = i;

  const segs: Seg[] = [];
  for (let i = 0; i < fixes.length - 1; i++) {
    const a = fixes[i], b = fixes[i + 1];
    const d = pathGen({ type: 'LineString', coordinates: [[a.lon, a.lat], [b.lon, b.lat]] } as any);
    if (d) segs.push({ d, color: saffirSimpson(a.wind_kt).color });
  }
  const marks: Mark[] = [];
  fixes.forEach((f) => {
    const p = project(f.lat, f.lon);
    if (p) marks.push({ x: p[0], y: p[1], r: markerR(f.wind_kt), color: saffirSimpson(f.wind_kt).color, landfall: !!f.landfall });
  });
  const pk = fixes[peakIdx];
  const pp = project(pk.lat, pk.lon);
  const peak = pp ? { x: pp[0], y: pp[1], r: markerR(pk.wind_kt) + 2, color: saffirSimpson(pk.wind_kt).color, label: `PEAK ${catLabel(saffirSimpson(pk.wind_kt).cat)} · ${pk.wind_kt} kt` } : null;
  const landfalls = fixes.filter((f) => f.landfall).map((f) => project(f.lat, f.lon)).filter(Boolean).map((p) => ({ x: (p as [number, number])[0], y: (p as [number, number])[1], label: 'LANDFALL' }));
  const f0 = fixes[0];
  return { name: storm.name, nameAt: project(f0.lat, f0.lon), segs, marks, peak, landfalls };
});

/* ── field-note track table (AT-readable data source, motif 3) ── */
interface Row { name: string; time: string; coord: string; wind: string; cat: string; landfall: boolean; }
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmtDate = (iso: string) => {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return iso;
  const hh = String(d.getUTCHours()).padStart(2, '0');
  const mm = String(d.getUTCMinutes()).padStart(2, '0');
  return `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${hh}:${mm}Z`;
};
const latH = (lat: number) => `${Math.abs(lat).toFixed(1)}°${lat >= 0 ? 'N' : 'S'}`;
const lonH = (lon: number) => `${Math.abs(lon).toFixed(1)}°${lon >= 0 ? 'E' : 'W'}`;
const rows: Row[] = validStorms.flatMap((s) => s.fixes.map((f) => ({
  name: s.name, time: fmtDate(f.t), coord: `${latH(f.lat)} ${lonH(f.lon)}`,
  wind: `${f.wind_kt} kt`, cat: catLabel(saffirSimpson(f.wind_kt).cat), landfall: !!f.landfall,
})));
const showAll = rows.length <= 5;
const multi = validStorms.length > 1;

/* centre label (coordinate margin, motif 2) */
const centreLabel = `${latH(meanLat)} ${lonH(meanLon)}`;

/* ── plate labels: two type tiers, one collision rule (2026-09-24) ──────────
   The plate is a 720-unit square drawn at the column width: 718px at 1280,
   335px on a 375px phone, where 9.5 units prints at 4.4px. So the plate
   carries its labels twice — a DESKTOP set at the authored sizes and a PHONE
   set sized to land at or above the 9.5px floor on a 335px plate — and CSS
   shows one (≤640px: phone). The storm's own marks do not move; only the
   type grows, so each set is placed separately against the same marks.

   Placement, per set, in priority order (PEAK, LANDFALLs, the storm name):
   each label tries eight sides of its mark, then the same eight a ring
   further out with a hairline leader back to the mark, and takes the first
   spot that clears every mark, every label already placed and the plate
   edge. Crossing the track costs a little (the paper halo keeps it legible);
   crossing a mark or a label is never chosen while a clear spot exists.
   Widths are estimated wide on purpose: too wide costs air, too narrow a
   collision. At 1280 this is what moved "Hurricane Katrina (2005)" off
   "LANDFALL" (probe, 2026-09-24). */
type Box = { x0: number; y0: number; x1: number; y1: number };
type Anchor = 'start' | 'middle' | 'end';
const hit = (a: Box, b: Box, g = 0) => a.x0 < b.x1 + g && b.x0 < a.x1 + g && a.y0 < b.y1 + g && b.y0 < a.y1 + g;
const cover = (a: Box, b: Box) => Math.max(0, Math.min(a.x1, b.x1) - Math.max(a.x0, b.x0)) * Math.max(0, Math.min(a.y1, b.y1) - Math.max(a.y0, b.y0));
interface Spec { key: string; text: string; x: number; y: number; r: number; kind: 'mono' | 'name' }
interface Placed { key: string; text: string; kind: 'mono' | 'name'; lx: number; ly: number; anchor: Anchor; leader: [number, number, number, number] | null }
const marksHard: Box[] = [];
const trackSoft: Box[] = [];
plateStorms.forEach((s) => {
  s.marks.forEach((m) => {
    const rr = (m.landfall ? m.r + 3.5 : m.r) + 1.5;
    marksHard.push({ x0: m.x - rr, y0: m.y - rr, x1: m.x + rr, y1: m.y + rr });
  });
  if (s.peak) marksHard.push({ x0: s.peak.x - s.peak.r - 1.5, y0: s.peak.y - s.peak.r - 1.5, x1: s.peak.x + s.peak.r + 1.5, y1: s.peak.y + s.peak.r + 1.5 });
  for (let i = 0; i < s.marks.length - 1; i++) {
    const a = s.marks[i], b = s.marks[i + 1];
    const n = Math.max(1, Math.ceil(Math.hypot(b.x - a.x, b.y - a.y) / 5));
    for (let k = 0; k < n; k++) {
      const x = a.x + ((b.x - a.x) * (k + 0.5)) / n, y = a.y + ((b.y - a.y) * (k + 0.5)) / n;
      trackSoft.push({ x0: x - 2, y0: y - 2, x1: x + 2, y1: y + 2 });
    }
  }
});
const specs: Spec[] = [];
plateStorms.forEach((s, si) => {
  if (s.peak) specs.push({ key: `p${si}`, text: s.peak.label, x: s.peak.x, y: s.peak.y, r: s.peak.r, kind: 'mono' });
  s.landfalls.forEach((lf, li) => {
    const m = s.marks.find((mm) => mm.landfall && Math.abs(mm.x - lf.x) < 0.01 && Math.abs(mm.y - lf.y) < 0.01);
    specs.push({ key: `l${si}-${li}`, text: lf.label, x: lf.x, y: lf.y, r: (m ? m.r : 4) + 3.5, kind: 'mono' });
  });
  if (s.nameAt) specs.push({ key: `n${si}`, text: s.name, x: s.nameAt[0], y: s.nameAt[1], r: 5, kind: 'name' });
});
const TIERS = {
  // desktop: the authored sizes
  d: { mono: 9.5, name: 16, edge: 18 },
  // phone: 9.5px ÷ (335 / 720) ≈ 20.5 units, so a 335px plate prints ≥ 9.5px
  m: { mono: 20.5, name: 24, edge: 30 },
};
const DIRS: [number, number][] = [[1, 0], [1, -1], [1, 1], [-1, 0], [-1, -1], [-1, 1], [0, -1], [0, 1]];
function placeSet(t: { mono: number; name: number; edge: number }): Placed[] {
  const placed: Box[] = [];
  const centreFs = t.mono;
  const centreW = centreLabel.length * centreFs * 0.72;
  placed.push({ x0: VW / 2 - centreW / 2, y0: VH - 6 - centreFs * 0.8, x1: VW / 2 + centreW / 2, y1: VH - 6 + centreFs * 0.25 });
  const bounds: Box = { x0: 6, y0: 6, x1: VW - 6, y1: VH - t.edge };
  return specs.map((s) => {
    const fs = s.kind === 'name' ? t.name : t.mono;
    const w = s.kind === 'name' ? s.text.length * fs * 0.52 : s.text.length * fs * 0.7;
    const h = fs * 1.05;
    let best: Placed | null = null, bestCost = Infinity;
    for (let ring = 0; ring < 5 && bestCost > 0; ring++) {
      const d = s.r + 4 + ring * fs * 1.6;
      for (const [dx, dy] of DIRS) {
        const diag = dx !== 0 && dy !== 0 ? 0.72 : 1;
        const x0 = dx > 0 ? s.x + d * diag : dx < 0 ? s.x - d * diag - w : s.x - w / 2;
        const y0 = dy < 0 ? s.y - d * diag - h : dy > 0 ? s.y + d * diag : s.y - h / 2;
        const b: Box = { x0, y0, x1: x0 + w, y1: y0 + h };
        if (b.x0 < bounds.x0 || b.x1 > bounds.x1 || b.y0 < bounds.y0 || b.y1 > bounds.y1) continue;
        let cost = ring * 4 + DIRS.findIndex(([a, c]) => a === dx && c === dy) * 0.5;
        for (const p of placed) if (hit(b, p, 3)) cost += 1000 + cover(b, p);
        for (const m of marksHard) if (hit(b, m, 1.5)) cost += 1000 + cover(b, m);
        for (const q of trackSoft) if (hit(b, q)) cost += 2;
        if (cost < bestCost) {
          bestCost = cost;
          const anchor: Anchor = dx > 0 ? 'start' : dx < 0 ? 'end' : 'middle';
          const lx = anchor === 'start' ? b.x0 : anchor === 'end' ? b.x1 : (b.x0 + b.x1) / 2;
          const ly = b.y1 - fs * 0.25;
          // a leader from the mark's edge to the nearest point of the box, for outer rings
          const nx = Math.max(b.x0, Math.min(s.x, b.x1)), ny = Math.max(b.y0, Math.min(s.y, b.y1));
          const len = Math.hypot(nx - s.x, ny - s.y) || 1;
          const leader: Placed['leader'] = ring > 0
            ? [s.x + ((nx - s.x) / len) * (s.r + 1), s.y + ((ny - s.y) / len) * (s.r + 1), nx, ny]
            : null;
          best = { key: s.key, text: s.text, kind: s.kind, lx, ly, anchor, leader };
          (best as any).box = b;
        }
      }
    }
    if (!best) best = { key: s.key, text: s.text, kind: s.kind, lx: s.x + s.r + 4, ly: s.y - s.r - 4, anchor: 'start', leader: null };
    if ((best as any).box) placed.push((best as any).box);
    return best;
  });
}
const labelSets = { d: placeSet(TIERS.d), m: placeSet(TIERS.m) };

/* live-scene payload (inline JSON — the track is data, not a fetched asset) */
const payload = JSON.stringify({ storms: validStorms, windScale, smooth });

const MONO = "font-family:'JetBrains Mono',ui-monospace,monospace";
const SERIF = "font-family:var(--font-display),Georgia,serif";
---

{validStorms.length > 0 && (
  <div class="px-viz px-storm" data-reveal>
    {caption && (
      <div class="px-viz__cap">
        <span>{caption}</span>
      </div>
    )}

    <div
      class="viz3d viz3d--storm"
      data-viz3d="storm-track"
      style={`aspect-ratio: 1 / 1`}
      role="img"
      aria-label={caption ? `Tropical-cyclone track: ${caption}` : `Tropical-cyclone best-track map`}
    >
      <div class="viz3d__fallback">
        {/* The print plate — an orthographic basin view centred on the storm
            (blueprint §7). overflow visible so labels bleed outside the disc. */}
        <svg viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="xMidYMid meet" style="overflow:visible">
          {/* ocean disc + horizon */}
          {spherePath && <path d={spherePath} fill="color-mix(in oklab, var(--accent) 6%, var(--paper))" stroke="var(--ink)" stroke-width="1" opacity="0.9" />}
          {graticulePath && <path d={graticulePath} fill="none" stroke="var(--ink)" stroke-width="0.5" opacity="0.09" />}
          {landPath && <path d={landPath} fill="color-mix(in oklab, var(--accent) 12%, var(--paper))" stroke="var(--ink)" stroke-width="0.8" opacity="0.35" />}

          {plateStorms.map((s) => (
            <>
              {/* intensity-coloured track segments (starting-fix category) */}
              {s.segs.map((seg) => (
                <path d={seg.d} fill="none" stroke={seg.color} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              ))}

              {/* peak halo — the ONE soft radial marker (§7) */}
              {s.peak && (
                <circle cx={s.peak.x} cy={s.peak.y} r={s.peak.r + 16} fill={`url(#px-storm-halo-${s.name.replace(/[^a-z0-9]/gi, '')})`} />
              )}

              {/* fix markers — category colour, sized by wind */}
              {s.marks.map((m) => (
                <>
                  <circle cx={m.x} cy={m.y} r={m.r} fill={m.color} stroke="var(--paper)" stroke-width="0.75" />
                  {m.landfall && <circle cx={m.x} cy={m.y} r={m.r + 3.5} fill="none" stroke="var(--ink)" stroke-width="1.5" opacity="0.7" />}
                </>
              ))}

              {/* peak dot on top of the halo */}
              {s.peak && <circle cx={s.peak.x} cy={s.peak.y} r={s.peak.r} fill={s.peak.color} stroke="var(--paper)" stroke-width="1" />}
            </>
          ))}

          {/* labels — storm name (Fraunces italic), PEAK + LANDFALL (mono) and the
              basin-centre coordinate (motif 2), once per type tier (see the note
              in the frontmatter); CSS shows the desktop set or the phone set */}
          {(['d', 'm'] as const).map((tier) => (
            <g class={`px-storm__lbls px-storm__lbls--${tier}`}>
              {labelSets[tier].map((l) => (
                <>
                  {l.leader && (
                    <line x1={l.leader[0].toFixed(1)} y1={l.leader[1].toFixed(1)} x2={l.leader[2].toFixed(1)} y2={l.leader[3].toFixed(1)}
                      stroke="var(--ink)" stroke-width={tier === 'm' ? 1.6 : 0.8} opacity="0.55" />
                  )}
                  {l.kind === 'name' ? (
                    <text x={l.lx.toFixed(1)} y={l.ly.toFixed(1)} text-anchor={l.anchor} style={`${SERIF};font-style:italic`}
                      font-size={TIERS[tier].name} fill="var(--ink)" paint-order="stroke" stroke="var(--paper)"
                      stroke-width={tier === 'm' ? 6 : 3.5}>{l.text}</text>
                  ) : (
                    <text x={l.lx.toFixed(1)} y={l.ly.toFixed(1)} text-anchor={l.anchor} style={MONO} font-size={TIERS[tier].mono}
                      fill="var(--ink)" letter-spacing="0.08em" paint-order="stroke" stroke="var(--paper)"
                      stroke-width={tier === 'm' ? 5 : 3}>{l.text}</text>
                  )}
                </>
              ))}
              <text x={VW / 2} y={VH - 6} text-anchor="middle" style={MONO} font-size={TIERS[tier].mono} fill="var(--muted)" letter-spacing="0.1em">{centreLabel}</text>
            </g>
          ))}

          {/* radial-gradient defs for each storm's peak halo (the ONE peak marker) */}
          <defs>
            {plateStorms.map((s) => s.peak && (
              <radialGradient id={`px-storm-halo-${s.name.replace(/[^a-z0-9]/gi, '')}`}>
                <stop offset="0%" stop-color={s.peak.color} stop-opacity="0.55" />
                <stop offset="100%" stop-color={s.peak.color} stop-opacity="0" />
              </radialGradient>
            ))}
          </defs>
        </svg>
      </div>

      <span class="viz3d__hint" aria-hidden="true">drag to follow the track</span>
      <script type="application/json" class="viz3d__data" set:html={payload}></script>
    </div>

    {/* Saffir-Simpson legend — the DECLARED fixed encoding (mandatory, §7 / CANON §6) */}
    <div class="px-storm__legend" aria-label="Saffir-Simpson intensity scale">
      <span class="px-storm__legend-k">Saffir-Simpson · max sustained wind ({windScale})</span>
      <ul class="px-storm__ramp">
        {SAFFIR_RAMP.map((b) => (
          <li class="px-storm__band">
            <span class="px-storm__sw" style={`background:${b.color}`} aria-hidden="true"></span>
            <span class="px-storm__band-cat">{b.cat}</span>
            <span class="px-storm__band-kt">{b.key === '5' ? `≥${b.minKt}` : `${b.minKt}–${b.maxKt}`}</span>
          </li>
        ))}
      </ul>
    </div>

    {/* field-note track table (AT-readable, motif 3) */}
    <div class={`px-storm__track${showAll ? '' : ' px-storm__track--collapsed'}`}>
      <div class="px-storm__track-head">
        <span>best track · {rows.length} fixes</span>
        <span>time · position · wind · category</span>
      </div>
      <ul class="px-storm__rows">
        {rows.map((r, i) => (
          <li class={`px-storm__row${!showAll && i >= 5 ? ' px-storm__row--extra' : ''}`}>
            {multi && <span class="px-storm__r-name">{r.name}</span>}
            <span class="px-storm__r-t">{r.time}</span>
            <span class="px-storm__r-co">{r.coord}</span>
            <span class="px-storm__r-w">{r.wind}</span>
            <span class="px-storm__r-cat">{r.cat}{r.landfall ? ' · landfall' : ''}</span>
          </li>
        ))}
      </ul>
      {!showAll && (
        <button type="button" class="px-storm__more" aria-expanded="false">show all {rows.length} fixes</button>
      )}
    </div>


    {/* track show-all bridge (no-JS shows all rows; JS collapses past 5) */}
    <script is:inline>
      (function () {
        var root = document.currentScript && document.currentScript.previousElementSibling;
        while (root && !(root.classList && root.classList.contains('px-storm'))) {
          root = root.previousElementSibling;
        }
        if (!root) return;
        var more = root.querySelector('.px-storm__more');
        var track = root.querySelector('.px-storm__track');
        if (more && track) {
          more.addEventListener('click', function () {
            track.classList.remove('px-storm__track--collapsed');
            more.setAttribute('aria-expanded', 'true');
            more.style.display = 'none';
          });
        }
      })();
    </script>
  </div>
)}

{/* the storm-name label (Fraunces italic) + PEAK/LANDFALL (mono) are created at
    runtime by makeLabels, so their styling must be GLOBAL (scoped styles never
    reach runtime-injected nodes). --storm = the naturalist's-hand name chip. */}
<style is:global>
  .viz3d--storm .viz3d__label--storm {
    font-family: var(--font-display), Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: 15px;
    line-height: 1;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink);
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    padding: 1px 6px;
    border-radius: 3px;
  }
  .viz3d--storm .viz3d__anchor--storm { display: none; }
</style>

<style>
  /* ocean-paper mount tint under the line-art (atlas water) */
  .viz3d--storm {
    background:
