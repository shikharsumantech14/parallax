interface Props {
  section: Section;
}

const { section } = Astro.props;

/* `caption` and `source` were promoted onto the section schema in Phase 2, but
   the ~90 dispatch arms below were written before that and read `data.caption`
   / `data.source`. Merging the promoted fields down into `data` here makes the
   new top-level form work for EVERY kind at once, instead of editing ninety
   arms and missing some. The authored `data.*` still wins where it exists, so
   no existing issue changes.

   `source` accepts `{ label, date }` per the schema; components expect a
   string, so it is flattened here — the one place that knows about both
   shapes. */
const promotedSource =
  typeof section.source === 'string'
    ? section.source
    : section.source
      ? [section.source.label, section.source.date].filter(Boolean).join(' · ')
      : undefined;

const data: any = {
  ...(section.data ?? {}),
  caption: (section.data as any)?.caption ?? section.caption,
  source: (section.data as any)?.source ?? promotedSource,
};
---

    {section.kind === 'timeline' && <Timeline events={data.events ?? []} source={data.source} />}

    {section.kind === 'bill-breakdown' && <BillBreakdown cards={data.cards ?? []} source={data.source} />}

    {section.kind === 'vote-result' && (
      <>
