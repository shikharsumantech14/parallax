---
import type { Topic } from '../../content/config';
import { renderEmphasis, formatIssueNumber, stripEmphasis } from '../../lib/text';

interface Entry {
  slug: string;
  topic: Topic;
  title: string;
  issueNumber: number;
  publishedAt: Date;
  readTimeMinutes?: number;
}

interface Props {
  items: Entry[];
  /** Section heading. `/archive` passes its own; home keeps the default. */
  heading?: string;
  /** Emit `data-topic` + `data-search` per row so a filter island can hide
   *  rows without re-implementing the row markup. Off by default. */
  filterable?: boolean;
  /** Shown when `items` is empty. `/archive` names the six desks here, per
   *  the README's empty-state rule. */
  emptyText?: string;
}
const {
  items,
  heading = 'Earlier Issues',
  filterable = false,
  emptyText = 'No earlier issues yet — the archive begins with — 01.',
} = Astro.props;

/* Same stamp as Banner and CategoryCard use — one date format on the site. */
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' }).toUpperCase();

const topicLabels: Record<string, string> = {
  politics: 'Politics',
  space: 'Space',
  earth: 'Earth',
  tech: 'Tech',
  travel: 'Travel',
  sports: 'Sports'
};
---

<section class="px-archive">
  <div class="px-archive__title">{heading}</div>
  {items.length === 0 ? (
    <div class="px-archive__empty">{emptyText}</div>
  ) : (
    <ul class="px-archive__list" data-reveal>
      {items.map((entry) => (
        <li
          class="px-archive__row"
          data-topic={filterable ? entry.topic : undefined}
          data-search={filterable
            ? `${stripEmphasis(entry.title)} ${topicLabels[entry.topic]}`.toLowerCase()
            : undefined}
        >
          <a class="px-archive__item" data-topic={entry.topic} href={`/issues/${entry.slug}/`}>
            <span class="px-archive__no">{formatIssueNumber(entry.issueNumber)}</span>
            <span class="px-archive__dot" aria-hidden="true"></span>
            <span class="px-archive__text" set:html={renderEmphasis(entry.title)} />
            <span class="px-archive__topic">{topicLabels[entry.topic]}</span>
            <span class="px-archive__meta">
              {fmtDate(entry.publishedAt)}
              {entry.readTimeMinutes ? ` · ${entry.readTimeMinutes} min` : ''}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
  {filterable && (
    <div class="px-archive__none" hidden>
      Nothing matches. Clear the search, or pick another desk.
    </div>
  )}
</section>
