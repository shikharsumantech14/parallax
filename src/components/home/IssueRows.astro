---
/**
 * IssueRows — the one list-row implementation (Lens Phase 2, 2026-09-30).
 *
 * Home's latest dispatches, the archive and every desk page list issues as
 * hairline rows: the desk dot and "No 17" in the first column; the headline
 * in Newsreader 24 (the authored `*word*` italic in the desk text colour),
 * the hook in 15 muted and "28 Sep 2026 · 4 min" in the body; the issue's
 * cover mark as a 120 x 72 thumbnail on the right (`core/CoverCard`
 * size="row", marks only). The whole row is one link. Hover lays a paper-2
 * wash behind it and underlines the headline; nothing moves (LENS §1.1).
 * Phones put the number above the headline and keep a 96px thumbnail.
 *
 * `variant` is accepted for call-site compatibility: "desk" drops the dot,
 * because on a desk page every row is that desk.
 *
 * The class names `.px-archive__list` / `.px-archive__row` / `.px-archive__none`
 * and the `data-topic` / `data-search` hooks are what the /archive filter island
 * queries, so the archive keeps working without touching its script.
 */
import { getCollection } from 'astro:content';
import CoverCard from '../core/CoverCard.astro';
import { renderEmphasis, stripEmphasis } from '../../lib/text';
import { ink } from '../../lib/desk-inks';
import { formatNo } from '../../lib/issue-number';
import type { Topic } from '../../content/config';

export interface RowItem {
  slug: string;
  topic: Topic;
  title: string;
  hook?: string;
  issueNumber: number;
  publishedAt: Date;
  readTimeMinutes?: number;
}

interface Props {
  items: RowItem[];
  variant?: 'home' | 'desk';
  /** Shown when `items` is empty. */
  emptyText?: string;
  /** Adds the search hook the /archive island reads. */
  filterable?: boolean;
}
const { items, variant = 'home', emptyText, filterable = false } = Astro.props;

/* The thumbnail draws from the issue's own sections, so each row finds its
   collection entry by slug. */
const entries = new Map((await getCollection('issues')).map((e) => [e.slug, e]));

const deskName: Record<Topic, string> = {
  politics: 'Politics', space: 'Space', earth: 'Earth', tech: 'Tech', travel: 'Travel', sports: 'Sports',
};
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<div class="px-rows px-archive__list" data-variant={variant}>
  {items.map((i) => {
    const entry = entries.get(i.slug);
    return (
      <a
        class="px-rows__row px-archive__row"
        href={`/issues/${i.slug}/`}
        data-topic={i.topic}
        data-search={filterable ? `${stripEmphasis(i.title)} ${deskName[i.topic]}`.toLowerCase() : undefined}
        style={`--rw-text: ${ink(i.topic, 'text')}; --rw-mark: ${ink(i.topic, 'mark')}`}
      >
        <span class="px-rows__no">
          {variant !== 'desk' && <span class="px-rows__dot" aria-hidden="true"></span>}
          {formatNo(i.issueNumber)}
          <span class="px-rows__desk">{deskName[i.topic]}</span>
        </span>
        <span class="px-rows__body">
          <span class="px-rows__t" set:html={renderEmphasis(i.title)} />
          {i.hook && <span class="px-rows__hook">{i.hook}</span>}
          <span class="px-rows__meta">{fmt(i.publishedAt)}{i.readTimeMinutes ? ` · ${i.readTimeMinutes} min` : ''}</span>
        </span>
        {entry && <CoverCard issue={entry} size="row" number={i.issueNumber} class="px-rows__thumb" />}
      </a>
    );
  })}
  <p class="px-rows__none px-archive__none" hidden={items.length !== 0}>{emptyText ?? 'Nothing here yet.'}</p>
</div>

<style>
  .px-rows { display: flex; flex-direction: column; border-top: 1px solid var(--hair); }
  .px-rows__row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 120px;
    grid-template-areas: "no body thumb";
    gap: 24px;
    align-items: start;
    padding: 24px 0;
    min-height: 44px;
    border-bottom: 1px solid var(--hair);
    color: var(--ink);
    text-decoration: none;
    transition: background var(--t-micro) var(--ease);
  }
  /* The wash reaches 16px past the column on each side by box-shadow, so the
     hairlines between rows stay exactly on the column. */
  .px-rows__row:hover { background: var(--paper-2); box-shadow: -16px 0 0 var(--paper-2), 16px 0 0 var(--paper-2); }
  .px-rows__row:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; }
  .px-rows__row[hidden] { display: none; }
  .px-rows__no {
    grid-area: no;
    display: inline-flex; align-items: center; gap: 8px;
    padding-top: 6px;
    font-family: var(--font-ui);
    font-size: 13px; font-weight: 600;
    line-height: 1.4;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .px-rows__dot { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 999px; background: var(--rw-mark); }
  /* The desk's name is for assistive technology and search: the dot already
     shows it to a sighted reader. */
  .px-rows__desk {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }
  .px-rows__body { grid-area: body; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .px-rows__t {
    font-family: var(--font-display);
    font-size: 24px; font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: pretty;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .px-rows__row:hover .px-rows__t { text-decoration-line: underline; }
  .px-rows__t :global(em) { font-style: italic; color: var(--rw-text); }
  .px-rows__hook {
    font-family: var(--font-ui);
    font-size: 15px; line-height: 1.5;
    color: var(--muted);
    max-width: 64ch;
  }
  .px-rows__meta {
    font-family: var(--font-ui);
    font-size: 13px; font-weight: 500;
    line-height: 1.4;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .px-rows__row > :global(.px-rows__thumb) { grid-area: thumb; }
  .px-rows__none {
    margin: 0;
    padding: 24px 0;
    font-size: 15px; line-height: 1.6;
    color: var(--muted);
    border-bottom: 1px solid var(--hair);
  }
  .px-rows__none[hidden] { display: none; }

  @media (max-width: 768px) {
    .px-rows__row {
      grid-template-columns: minmax(0, 1fr) 96px;
      grid-template-areas: "no thumb" "body thumb";
      gap: 8px 16px;
      padding: 20px 0;
    }
    .px-rows__no { padding-top: 0; }
    .px-rows__t { font-size: 22px; }
    .px-rows__row > :global(.px-rows__thumb) { width: 96px; height: 58px; flex-basis: 96px; }
    .px-rows__row > :global(.px-rows__thumb) :global(.px-cover__panel) { height: 58px; flex-basis: 58px; }
  }
</style>
