---
/**
 * HeroLens — the home hero: "The Second Angle, enacted" (HOME-SPEC §2).
 *
 * The brand's two viewpoints, drawn as EYES inside their lens rings, both
 * trained on the red focal object below (review R2-4 / operator direction
 * 2026-07-06). Under the cursor the object shifts and BOTH pupils track it —
 * two eyes holding the same object from a moving angle: parallax made
 * literal. The static default (pupils converged on the centred object) is
 * also the no-JS / reduced-motion / touch state, so the idea reads without
 * any interaction. The sanctioned CANON §11 motion exception, per HOME-SPEC.
 *
 * Story mode is the front door: the primary CTA opens the newest issue's
 * 60-second version. Prefix: px-hlens.
 */
interface Props {
  latestSlug?: string;
}
const { latestSlug } = Astro.props;
const storyHref = latestSlug ? `/s/${latestSlug}/` : '/#desks';

// Locked mark geometry (brand-logo): rings r170 offset ±96, sphere r66.
const RING_C = (2 * Math.PI * 170).toFixed(0); // stroke sweep length
---

<section class="px-hlens" id="px-hlens" aria-label="Parallax — stories from the second angle">
  <div class="px-hlens__copy">
    <p class="px-hlens__eyebrow" data-hl-reveal style="--d:0ms">Six worlds · one publication</p>
    <h1 class="px-hlens__title" data-hl-reveal style="--d:90ms">
      Stories you think you <em>already</em> understand.
    </h1>
    <p class="px-hlens__dek" data-hl-reveal style="--d:200ms">
      Familiar headlines, rebuilt from the structure up — every number
      sourced, every chart alive, every story the version you haven't heard.
    </p>
    <div class="px-hlens__ctas" data-hl-reveal style="--d:300ms">
      <a class="px-hlens__cta" href={storyHref}>Start with a story <span aria-hidden="true">→</span></a>
      <a class="px-hlens__how" href="/welcome/">How Parallax works</a>
    </div>
  </div>

  <div class="px-hlens__figure" aria-hidden="true">
    <svg viewBox="0 0 532 420" preserveAspectRatio="xMidYMid meet" id="px-hlens-svg">
      <defs>
        {/* little-earth focal object */}
        <radialGradient id="hlens-earth" cx="36%" cy="30%" r="78%">
          <stop offset="0%" stop-color="#93d072"/>
          <stop offset="42%" stop-color="#5da653"/>
          <stop offset="78%" stop-color="#3c7d40"/>
          <stop offset="100%" stop-color="#265c30"/>
        </radialGradient>
        <radialGradient id="hlens-sheen" cx="34%" cy="26%" r="60%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.42"/>
          <stop offset="55%" stop-color="#ffffff" stop-opacity="0.06"/>
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="hlens-core" cx="70%" cy="78%" r="70%">
          <stop offset="58%" stop-color="#123016" stop-opacity="0"/>
          <stop offset="100%" stop-color="#123016" stop-opacity="0.5"/>
        </radialGradient>
        <radialGradient id="hlens-tree" cx="34%" cy="28%" r="72%">
          <stop offset="0%" stop-color="#69ba5a"/>
          <stop offset="65%" stop-color="#3f8a41"/>
          <stop offset="100%" stop-color="#2b6733"/>
        </radialGradient>
        <linearGradient id="hlens-dome" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#d6543c"/>
          <stop offset="100%" stop-color="#9e2a1a"/>
        </linearGradient>
        <linearGradient id="hlens-stone" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#f0e6d2"/>
          <stop offset="62%" stop-color="#ddcbab"/>
          <stop offset="100%" stop-color="#c3ac87"/>
        </linearGradient>
        <clipPath id="hlens-planet"><circle cx="266" cy="262" r="54"/></clipPath>
        <clipPath id="hlens-eyeL"><path d="M122,165 Q168,138 214,165 Q168,192 122,165 Z"/></clipPath>
        <clipPath id="hlens-eyeR"><path d="M318,165 Q364,138 410,165 Q364,192 318,165 Z"/></clipPath>
      </defs>

      {/* two viewpoints, drawn as eyes inside their lens rings — both trained
          on the red focal object below. As the object shifts under your cursor
          the pupils track it: two eyes holding the same object from a moving
          angle. That is parallax, made literal. */}

      {/* the two lines of sight from each eye to the object */}
      <g class="px-hlens__sight">
        <line class="px-hlens__sight-l" x1="168" y1="165" x2="266" y2="262"
          stroke="var(--accent-deep, #8b2416)" stroke-width="1" stroke-opacity="0.28" stroke-dasharray="3 5"/>
        <line class="px-hlens__sight-r" x1="364" y1="165" x2="266" y2="262"
          stroke="var(--accent-deep, #8b2416)" stroke-width="1" stroke-opacity="0.28" stroke-dasharray="3 5"/>
      </g>

      {/* left eye */}
      <g class="px-hlens__eye">
        <circle cx="168" cy="165" r="86" fill="none" stroke="var(--ink)" stroke-width="1.5"
          stroke-opacity="0.28" pathLength={RING_C} class="px-hlens__stroke"/>
        <path d="M122,165 Q168,138 214,165 Q168,192 122,165 Z" fill="none"
          stroke="var(--ink)" stroke-width="2" stroke-opacity="0.6"/>
        <g clip-path="url(#hlens-eyeL)">
          <circle cx="168" cy="165" r="26" fill="var(--ink)" fill-opacity="0.08"
            stroke="var(--ink)" stroke-width="1" stroke-opacity="0.35"/>
          <circle class="px-hlens__pupil px-hlens__pupil--l" cx="176.5" cy="173.5" r="12"
            fill="var(--ink)" fill-opacity="0.92"/>
          <circle class="px-hlens__glint px-hlens__glint--l" cx="172" cy="169" r="3.2" fill="#fff" opacity="0.75"/>
        </g>
      </g>

      {/* right eye */}
      <g class="px-hlens__eye">
        <circle cx="364" cy="165" r="86" fill="none" stroke="var(--ink)" stroke-width="1.5"
          stroke-opacity="0.28" pathLength={RING_C} class="px-hlens__stroke px-hlens__stroke--late"/>
        <path d="M318,165 Q364,138 410,165 Q364,192 318,165 Z" fill="none"
          stroke="var(--ink)" stroke-width="2" stroke-opacity="0.6"/>
        <g clip-path="url(#hlens-eyeR)">
          <circle cx="364" cy="165" r="26" fill="var(--ink)" fill-opacity="0.08"
            stroke="var(--ink)" stroke-width="1" stroke-opacity="0.35"/>
          <circle class="px-hlens__pupil px-hlens__pupil--r" cx="355.5" cy="173.5" r="12"
            fill="var(--ink)" fill-opacity="0.92"/>
          <circle class="px-hlens__glint px-hlens__glint--r" cx="360" cy="169" r="3.2" fill="#fff" opacity="0.75"/>
        </g>
      </g>

      {/* the focal object both eyes hold — a little green world: greenery, a
          couple of trees and a small civic skyline (the politics nod), shaded
          for a dimensional, earthly read. Both eyes above train on it. */}
      <g class="px-hlens__sphere" id="px-hlens-obj">
        {/* atmosphere */}
        <circle cx="266" cy="262" r="61" fill="none" stroke="#8fce6e" stroke-opacity="0.13" stroke-width="7"/>
        <circle cx="266" cy="262" r="57.5" fill="none" stroke="#cdeab4" stroke-opacity="0.30" stroke-width="1"/>
        {/* focus reticle — marks the observed object */}
        <circle cx="266" cy="262" r="74" fill="none" stroke="var(--accent-deep, #8b2416)"
          stroke-width="1" stroke-opacity="0.24" stroke-dasharray="1.5 6"/>

        {/* planet surface */}
        <g clip-path="url(#hlens-planet)">
          <circle cx="266" cy="262" r="54" fill="url(#hlens-earth)"/>
          <ellipse cx="244" cy="247" rx="15" ry="9" fill="#3f8140" fill-opacity="0.5" transform="rotate(-18 244 247)"/>
          <ellipse cx="288" cy="278" rx="13" ry="8" fill="#33702f" fill-opacity="0.45" transform="rotate(12 288 278)"/>
          {/* earthy underside */}
          <path d="M212,283 Q266,306 320,283 L320,318 L212,318 Z" fill="#6b4128" fill-opacity="0.5"/>
          <path d="M214,284 Q266,305 318,284" fill="none" stroke="#93643f" stroke-opacity="0.4" stroke-width="1"/>
          {/* dimensional shading */}
          <circle cx="266" cy="262" r="54" fill="url(#hlens-core)"/>
          <circle cx="266" cy="262" r="54" fill="url(#hlens-sheen)"/>
        </g>
        <circle cx="266" cy="262" r="54" fill="none" stroke="#1f3f22" stroke-opacity="0.3" stroke-width="1"/>

        {/* cast shadows on the surface (clipped to the globe) */}
        <g clip-path="url(#hlens-planet)" fill="#21421f" fill-opacity="0.3">
          <ellipse cx="247" cy="250" rx="10" ry="2.6"/>
          <ellipse cx="270" cy="253" rx="14" ry="3"/>
          <ellipse cx="294" cy="251" rx="7.5" ry="2.4"/>
          <ellipse cx="309" cy="252" rx="6" ry="2"/>
        </g>

        {/* left tree */}
        <g>
          <rect x="241.5" y="232" width="3" height="15" rx="1.3" fill="#6f4a2c"/>
          <circle cx="243" cy="229" r="10" fill="url(#hlens-tree)"/>
          <circle cx="239" cy="225" r="3" fill="#bfe6a2" fill-opacity="0.55"/>
        </g>

        {/* civic building — a small domed capitol (the politics nod) */}
        <g>
          <rect x="252" y="248.5" width="28" height="2.5" fill="#cbb794"/>
          <rect x="255" y="229" width="22" height="20.5" fill="url(#hlens-stone)"/>
          <rect x="271" y="229" width="6" height="20.5" fill="#c3ac87" fill-opacity="0.55"/>
          <g stroke="#b59a76" stroke-opacity="0.75" stroke-width="1.5">
            <line x1="259" y1="233" x2="259" y2="248"/>
            <line x1="263" y1="233" x2="263" y2="248"/>
            <line x1="267" y1="233" x2="267" y2="248"/>
            <line x1="271" y1="233" x2="271" y2="248"/>
          </g>
          <rect x="252.5" y="226" width="27" height="3.4" fill="#ece1cb"/>
          <path d="M256,226 A10,11 0 0 1 276,226 Z" fill="url(#hlens-dome)"/>
          <path d="M258,226 A8,9 0 0 1 266,217.2" fill="none" stroke="#f0b6a6" stroke-opacity="0.5" stroke-width="1.2"/>
          <line x1="266" y1="216.5" x2="266" y2="211" stroke="#cbb794" stroke-width="1.4"/>
          <circle cx="266" cy="210" r="1.7" fill="#ece1cb"/>
        </g>

        {/* right tower */}
        <g>
          <polygon points="284,221 288,217 298,217 294,221" fill="#f0e6d2"/>
          <polygon points="294,221 298,217 298,244 294,248" fill="#bda07c"/>
          <rect x="284" y="221" width="10" height="27" fill="url(#hlens-stone)"/>
          <g fill="#6f5638" fill-opacity="0.55">
            <rect x="286.3" y="226" width="2.6" height="3"/>
            <rect x="290" y="226" width="2.6" height="3"/>
            <rect x="286.3" y="232" width="2.6" height="3"/>
            <rect x="290" y="232" width="2.6" height="3"/>
            <rect x="286.3" y="238" width="2.6" height="3"/>
            <rect x="290" y="238" width="2.6" height="3"/>
          </g>
        </g>

        {/* small right tree */}
        <g>
          <rect x="303.7" y="241" width="2.6" height="9" rx="1.1" fill="#6f4a2c"/>
          <circle cx="305" cy="237" r="7" fill="url(#hlens-tree)"/>
          <circle cx="302.5" cy="234.5" r="2.2" fill="#bfe6a2" fill-opacity="0.5"/>
        </g>
      </g>
    </svg>
    <p class="px-hlens__cap">Two eyes. One object. A second angle.</p>
  </div>
</section>

<script is:inline>
  (function () {
    var svg = document.getElementById('px-hlens-svg');
    var obj = document.getElementById('px-hlens-obj');
    if (!svg || !obj) return;
    var pupL = svg.querySelector('.px-hlens__pupil--l');
    var pupR = svg.querySelector('.px-hlens__pupil--r');
    var glL = svg.querySelector('.px-hlens__glint--l');
    var glR = svg.querySelector('.px-hlens__glint--r');
    if (!pupL || !pupR || !glL || !glR) return;

    // eye centres + default object centre (SVG viewBox coords)
    var EY = 165, LX = 168, RX = 364, OX0 = 266, OY0 = 262, REACH = 12;

    // point a pupil (+ its glint) at the object
    function look(pup, gl, ex, tx, ty) {
      var dx = tx - ex, dy = ty - EY, len = Math.hypot(dx, dy) || 1;
      pup.setAttribute('cx', (ex + dx / len * REACH).toFixed(1));
      pup.setAttribute('cy', (EY + dy / len * REACH).toFixed(1));
      gl.setAttribute('cx', (ex + dx / len * REACH - 4).toFixed(1));
      gl.setAttribute('cy', (EY + dy / len * REACH - 4).toFixed(1));
    }
    function aim(ox, oy) {
      obj.setAttribute('transform', 'translate(' + (ox - OX0).toFixed(1) + ' ' + (oy - OY0).toFixed(1) + ')');
      look(pupL, glL, LX, ox, oy);
      look(pupR, glR, RX, ox, oy);
    }
    aim(OX0, OY0); // static converged default (no-JS / touch / initial paint)

    // The eyes follow the pointer ANYWHERE on the page. We key off the viewport,
    // not the hero element, so nothing stacked above it (e.g. the first-visit
    // intro overlay) can intercept the move. This is a pointer-DRIVEN response,
    // NOT auto-playing motion, so it runs under prefers-reduced-motion too —
    // there CSS drops the glide to an instant snap (see the reduced-motion block).
    // Two eyes holding one object from a shifting angle: parallax, made literal.
    var raf = 0, tx = OX0, ty = OY0;
    function apply() { raf = 0; aim(tx, ty); }
    function onMove(e) {
      var vw = window.innerWidth || 1, vh = window.innerHeight || 1;
      var u = Math.max(0, Math.min(1, e.clientX / vw));
      var v = Math.max(0, Math.min(1, e.clientY / vh));
      tx = OX0 + (u * 2 - 1) * 40;   // ±40px horizontal
      ty = OY0 + (v * 2 - 1) * 22;   // ±22px vertical
      if (!raf) raf = requestAnimationFrame(apply);
    }
    function recenter() { tx = OX0; ty = OY0; if (!raf) raf = requestAnimationFrame(apply); }
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('blur', recenter);
    if (document.documentElement) document.documentElement.addEventListener('mouseleave', recenter);
  })();
</script>

<style>
  .px-hlens {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 32px;
    align-items: center;
    min-height: min(78vh, 720px);
    padding: 56px 0 40px;
  }

  .px-hlens__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 18px;
  }
  .px-hlens__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(44px, 6.6vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 22px;
    text-wrap: balance;
  }
  .px-hlens__title em {
    font-style: italic;
    color: var(--topic-politics-deep, #8b2416);
  }
  .px-hlens__dek {
    font-family: var(--font-display);
    font-size: 18.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0 0 30px;
    text-wrap: pretty;
  }
  .px-hlens__ctas { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .px-hlens__cta {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15.5px;
    color: var(--paper);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: var(--r-pill);
    padding: 14px 26px;
    text-decoration: none;
    transition: transform var(--t-quick) var(--ease), background var(--t-quick) var(--ease);
  }
  .px-hlens__cta:hover { transform: translateY(-1px); background: var(--topic-politics-deep, #8b2416); border-color: var(--topic-politics-deep, #8b2416); }
  .px-hlens__how {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 3px;
    transition: color var(--t-quick) var(--ease), border-color var(--t-quick) var(--ease);
  }
  .px-hlens__how:hover { color: var(--ink); border-color: var(--ink); }

  /* ── the figure ── */
  .px-hlens__figure { min-width: 0; }
  .px-hlens__figure svg { width: 100%; height: auto; display: block; overflow: visible; }
  /* the object glides as it's re-held; pupils re-aim per frame (set in JS) */
  .px-hlens__sphere { transition: transform var(--t-soft) var(--ease); }
  .px-hlens__pupil, .px-hlens__glint { transition: cx 90ms linear, cy 90ms linear; }
  .px-hlens__cap {
    text-align: center;
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 959px) { .px-hlens__cap { display: none; } }

  /* draw-in: rings sweep once on load (html.js-gated; no-JS = final state) */
  html.js .px-hlens__stroke {
    stroke-dasharray: 1068;
    animation: px-hlens-draw 1200ms var(--ease) forwards;
  }
  html.js .px-hlens__stroke--late { animation-delay: 180ms; stroke-dashoffset: 1068; }
  @keyframes px-hlens-draw { from { stroke-dashoffset: 1068; } to { stroke-dashoffset: 0; } }

  /* copy reveal stagger (html.js-gated) */
  html.js [data-hl-reveal] {
    animation: px-hlens-in 700ms var(--ease) backwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes px-hlens-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* pointer-tracking still runs (it's user-driven, not auto-motion), but the
       eyes snap instantly instead of gliding — no animated tween. */
    .px-hlens__sphere, .px-hlens__pupil, .px-hlens__glint { transition: none !important; }
    html.js .px-hlens__stroke, html.js .px-hlens__stroke--late { animation: none; stroke-dashoffset: 0; }
    html.js [data-hl-reveal] { animation: none; }
  }

  @media (max-width: 959px) {
    .px-hlens {
      grid-template-columns: 1fr;
      gap: 8px;
      min-height: 0;
      padding: 40px 0 24px;
    }
    .px-hlens__figure { max-width: 340px; margin: 8px auto 0; order: 2; }
    .px-hlens__copy { order: 1; }
  }
</style>
