---
import type { Topic } from '../../content/config';
import { renderEmphasis, formatIssueNumber } from '../../lib/text';

interface Props {
  topic: Topic;
  slug: string;
  title: string;
  hook: string;
  issueNumber?: number;
  publishedAt: Date;
}
const { topic, slug, title, hook, issueNumber = 1, publishedAt } = Astro.props;

const issueLabel = formatIssueNumber(issueNumber);
const dateLabel = publishedAt.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: '2-digit'
}).toUpperCase();
const topicLabel = topic.charAt(0).toUpperCase() + topic.slice(1);
---

<section class="px-featured" data-topic={topic}>
  <div class="px-featured__header">
    <span><strong>Latest</strong> {issueLabel}</span>
    <span>{topicLabel} &middot; {dateLabel}</span>
  </div>
  <a class="px-featured__card" href={`/issues/${slug}/`}>
    <div class="px-featured__eyebrow">The Cover Story</div>
    <h2 class="px-featured__title" set:html={renderEmphasis(title)} />
    <p class="px-featured__hook">{hook}</p>
    <span class="px-featured__cta">Read the issue</span>
  </a>
</section>

<style>
  /* Scope topic variables locally to this featured block so politics tokens
     don't leak to the rest of the home page. */
  .px-featured[data-topic="politics"] {
    --bg: #f4f1ea;
    --paper: #ffffff;
    --rule: #d8cfbf;
    --ink: #161412;
    --ink-soft: #3a332b;
    --muted: #6b5f52;
    --accent: #b8341f;
    --accent-deep: #8b2416;
    --font-display: 'Fraunces', Georgia, serif;
    --font-body: 'Inter Tight', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  .px-featured[data-topic="space"] {
    --bg: #0a1628;
    --paper: #111f36;
    --rule: #1e3352;
    --ink: #e8eef7;
    --ink-soft: #b8c4d6;
    --muted: #6b7a92;
    --accent: #00d4ff;
    --font-display: 'Space Grotesk', 'Inter Tight', sans-serif;
    --font-mono: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace;
  }
  .px-featured[data-topic="tech"] {
    --bg: #0d0d0d;
    --paper: #1a1a1a;
    --rule: #2b2b2b;
    --ink: #fafafa;
    --ink-soft: #c8c8c8;
    --muted: #7a7a7a;
    --accent: #c6f432;
    --font-display: 'JetBrains Mono', ui-monospace, monospace;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  .px-featured[data-topic="travel"] {
    --bg: #faf6ef;
    --paper: #fffdf7;
    --rule: #e5d9c4;
    --ink: #2a1f15;
    --ink-soft: #5a4a3a;
    --muted: #8a7864;
    --accent: #c85a3c;
    --font-display: 'Cormorant Garamond', 'Fraunces', serif;
  }
  .px-featured[data-topic="sports"] {
    --bg: #0f2820;
    --paper: #143328;
    --rule: #1f4434;
    --ink: #f5f5f0;
    --ink-soft: #cccca8;
    --muted: #7a8a78;
    --accent: #e8f048;
    --font-display: 'Oswald', 'Inter Tight', sans-serif;
  }
</style>
