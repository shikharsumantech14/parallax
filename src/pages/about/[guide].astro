---
import { getCollection } from 'astro:content';
import HomeLayout from '../../layouts/HomeLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { guide: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await guide.render();
const { title, eyebrow, dek, updated, summary } = guide.data;

const updatedLabel = updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<HomeLayout
  title={title}
  description={summary ?? dek ?? `${title} for Parallax Lens.`}
>
  <article class="px-guide">
    {eyebrow && <p class="px-guide__eyebrow">{eyebrow}</p>}
    <h1 class="px-guide__title">{title}</h1>
    {dek && <p class="px-guide__dek">{dek}</p>}
    <p class="px-guide__updated">Updated {updatedLabel}</p>

    <hr class="px-guide__rule" />

    <div class="px-guide__body">
      <Content />
    </div>

    <a class="px-guide__back" href="/about/">← Back to About</a>
  </article>
</HomeLayout>

<style>
  .px-guide {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 24px 24px;
  }

  .px-guide__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 16px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--ink);
  }

  .px-guide__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 44px;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0 0 16px;
  }
  .px-guide__title em { color: var(--accent); font-style: italic; font-weight: 400; }

  .px-guide__dek {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0 0 20px;
    max-width: 42ch;
  }

  .px-guide__updated {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .px-guide__rule {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 32px 0 40px;
  }

  /* ── MDX body typography ──────────────────────────────────────────── */
  .px-guide__body {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .px-guide__body :global(h1) {
    /* Skip the H1 inside body — title is rendered above */
    display: none;
  }

  .px-guide__body :global(h2) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--ink);
    margin: 48px 0 16px;
  }

  .px-guide__body :global(h3) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
    color: var(--ink);
    margin: 32px 0 10px;
  }

  .px-guide__body :global(p) {
    margin: 0 0 18px;
    max-width: 64ch;
  }

  .px-guide__body :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .px-guide__body :global(em) {
    font-style: italic;
  }

  .px-guide__body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .px-guide__body :global(a:hover) { color: var(--accent-deep, #8b2416); }

  .px-guide__body :global(ul),
  .px-guide__body :global(ol) {
    margin: 0 0 18px;
    padding-left: 24px;
    max-width: 64ch;
  }
  .px-guide__body :global(li) { margin-bottom: 8px; }

  .px-guide__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 14px;
  }
  .px-guide__body :global(th),
  .px-guide__body :global(td) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .px-guide__body :global(th) {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    border-bottom: 2px solid var(--ink);
  }

  .px-guide__body :global(hr) {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 40px 0;
  }

  .px-guide__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--paper);
    padding: 1px 5px;
    border: 1px solid var(--rule);
    color: var(--ink);
  }

  .px-guide__body :global(blockquote) {
    border-left: 3px solid var(--rule);
    padding-left: 18px;
    margin: 24px 0;
    color: var(--ink-soft);
    font-style: italic;
  }

  .px-guide__back {
    display: inline-block;
    margin-top: 56px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 3px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .px-guide__back:hover { color: var(--accent); border-bottom-color: var(--accent); }

  @media (max-width: 600px) {
    .px-guide__title { font-size: 32px; }
    .px-guide__dek { font-size: 17px; }
    .px-guide__body :global(h2) { font-size: 22px; margin: 36px 0 12px; }
  }
</style>
