---
/**
 * /archive — every published issue, filterable by desk and by a live search.
 *
 * Restyled to the launch design (2026-09-08): a head band, a filter band on
 * the same 40px gutter, then the ONE row implementation (home/IssueRows) so a
 * row on the archive and a row on the home page are the same object. The
 * class hooks the island reads (`.px-archive__list` / `__row` / `__none`) come
 * from IssueRows, which is why the script below needs no edit.
 *
 * Built against the TEN REAL ISSUES. The handoff prototype's backlist carries
 * 24 rows of which 14 are fiction; §4-v3 says explicitly that they must not
 * shape this page, so nothing here is sized or worded around a backlist we do
 * not have. The empty state names the six desks rather than apologising for a
 * thin archive.
 *
 * FALLBACK CONTRACT. Every row is server-rendered and visible. The search box
 * and the chips ship `hidden` and are revealed by the island below, so a
 * reader without JS gets the complete archive and never meets a control that
 * cannot work. Same pattern as the Phase 6.2 instruments.
 */
import { getCollection } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import Masthead from '../components/core/Masthead.astro';
import IssueRows from '../components/home/IssueRows.astro';
import { TOPICS, type Topic } from '../content/config';

const published = (await getCollection('issues', (e) => e.data.status !== 'draft'));
const oldestFirst = [...published].sort(
  (a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime()
);
const issueNumberFor = (slug: string) => oldestFirst.findIndex((i) => i.slug === slug) + 1;

const items = [...published]
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map((issue) => ({
    slug: issue.slug,
    topic: issue.data.topic,
    title: issue.data.title,
    hook: issue.data.hook,
    issueNumber: issueNumberFor(issue.slug),
    publishedAt: issue.data.publishedAt,
    readTimeMinutes: issue.data.readTimeMinutes,
  }));

const topicLabels: Record<Topic, string> = {
  politics: 'Politics',
  space: 'Space',
  earth: 'Earth',
  tech: 'Tech',
  travel: 'Travel',
  sports: 'Sports',
};

/* Desks with at least one published issue get a chip. A chip that filters to
   nothing is a dead control, and the count beside it would be a lie. */
const desksWithIssues = TOPICS.filter((t) => items.some((i) => i.topic === t));

const countLabel = `${items.length} ${items.length === 1 ? 'issue' : 'issues'} · every one still readable`;
---

<HomeLayout
  title="The archive · Parallax Lens"
  description="Every published Parallax issue, by desk and by date."
>
  <Masthead
    variant="meta"
    current="archive"
    issueNumber={String(items.length).padStart(2, '0')}
  />

  <header class="px-band px-arch__head">
    <p class="px-meta px-arch__count">{countLabel}</p>
    <h1 class="px-h1">The archive</h1>
  </header>

  <div class="px-arch__filter" id="px-arch-filter" hidden>
    <label class="px-arch__search">
      <span class="px-meta px-arch__label">Search</span>
      <input
        class="px-input px-arch__q"
        type="search"
        id="px-arch-q"
        placeholder="Title or desk…"
        autocomplete="off"
        aria-describedby="px-arch-status"
      />
    </label>
    <div class="px-arch__chips" role="group" aria-label="Filter by desk">
      <button class="px-chip px-arch-chip" type="button" data-desk="" aria-pressed="true">All</button>
      {desksWithIssues.map((t) => (
        <button class="px-chip px-arch-chip" type="button" data-desk={t} aria-pressed="false">
          <span class="px-arch__dot" style={`background: var(--topic-${t})`} aria-hidden="true"></span>
          {topicLabels[t]}
        </button>
      ))}
    </div>
    <p class="px-meta px-arch__status" id="px-arch-status" role="status" aria-live="polite"></p>
  </div>

  <IssueRows
    variant="home"
    filterable
    items={items}
    emptyText={`Nothing published yet. The desks are ${TOPICS.map((t) => topicLabels[t]).join(', ')} — the first issue will open one of them.`}
  />
</HomeLayout>

<style>
  /* The head band: the count in the meta voice, then the headline. Nothing
     follows the h1 inside the band, so its own bottom margin is dropped and
     the band's 40px does the spacing. */
  .px-arch__count { margin: 0 0 14px; }
  .px-arch__head .px-h1 { margin-bottom: 0; }

  /* The filter band sits on the same 40px gutter as every other band, at the
     tighter 16px rhythm the controls want. It ships `hidden`, so the display
     rule has to yield to the attribute — the island unhides it. */
  .px-arch__filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding: 16px 40px;
    border-bottom: 1px solid var(--rule);
  }
  .px-arch__filter[hidden] { display: none; }

  .px-arch__search { display: flex; align-items: center; gap: 10px; flex: 1 1 auto; }
  .px-arch__label { flex: 0 0 auto; }
  .px-arch__q { flex: 1 1 auto; min-width: 0; max-width: 320px; min-height: 44px; }

  .px-arch__chips { display: flex; flex-wrap: wrap; gap: 8px; }

  /* The chips are the shared .px-chip. meta.css still carries the Phase-7
     .px-arch-chip skin (paper fill, rule border, accent-tinted pressed
     state) and the class has to stay for the island's querySelector, so the
     launch look is restated here — a scoped rule outranks the global one. */
  .px-arch-chip {
    background: transparent;
    border-color: color-mix(in oklab, var(--ink) 22%, transparent);
    color: var(--ink);
  }
  .px-arch-chip:hover { border-color: var(--ink); }
  .px-arch-chip[aria-pressed='true'] {
    border-color: var(--ink);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
    color: var(--ink);
  }
  .px-arch__dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 auto; }

  .px-arch__status { margin: 0; flex: 0 0 auto; }

  @media (max-width: 768px) {
    .px-arch__filter { gap: 12px 16px; padding: 14px 20px; }
    .px-arch__search { width: 100%; }
    .px-arch__q { max-width: none; }
  }
</style>

<script is:inline>
  (function () {
    var panel = document.getElementById('px-arch-filter');
    var q = document.getElementById('px-arch-q');
    var status = document.getElementById('px-arch-status');
    var list = document.querySelector('.px-archive__list');
    if (!panel || !q || !list) return;

    var rows = Array.prototype.slice.call(list.querySelectorAll('.px-archive__row'));
    var none = document.querySelector('.px-archive__none');
    var chips = Array.prototype.slice.call(panel.querySelectorAll('.px-arch-chip'));
    var desk = '';

    /* Reveal only now: the controls were shipped hidden so a no-JS reader
       never meets a dead input. */
    panel.hidden = false;

    function apply() {
      var term = (q.value || '').trim().toLowerCase();
      var shown = 0;
      rows.forEach(function (row) {
        var okDesk = !desk || row.getAttribute('data-topic') === desk;
        var okTerm = !term || (row.getAttribute('data-search') || '').indexOf(term) !== -1;
        var show = okDesk && okTerm;           /* chip AND search, per README §353 */
        row.hidden = !show;
        if (show) shown++;
      });
      if (none) none.hidden = shown !== 0;
      if (status) {
        /* The noun agrees with the TOTAL, not the match: "1 of 10 issues". */
        status.textContent = shown === rows.length
          ? ''
          : shown + ' of ' + rows.length + (rows.length === 1 ? ' issue' : ' issues');
      }
    }

    q.addEventListener('input', apply);
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        desk = chip.getAttribute('data-desk') || '';
        chips.forEach(function (c) {
          c.setAttribute('aria-pressed', String(c === chip));
        });
        apply();
      });
    });
  })();
</script>
