---
/**
 * /archive — every published issue (Lens Phase 4; the Archive and
 * Archive-Phone boards).
 *
 * The head ("The archive", "N issues since <first month>"), seven filter
 * chips (All, then each desk with a published issue, led by its lettered
 * mark at 24px and its count), then the issues as cover cards three across,
 * grouped by month under a hairline month label with the month's count.
 * Phones: one column.
 *
 * FALLBACK. Every card is server-rendered and visible. The chips ship
 * `hidden` and the island below reveals them, so a reader without JS gets the
 * complete archive and never meets a control that cannot work. The island
 * filters by `data-topic` on each card's cell, hides a month left empty, and
 * announces the count.
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import Masthead from '../components/core/Masthead.astro';
import CoverCard from '../components/core/CoverCard.astro';
import Mark from '../components/core/Mark.astro';
import { TOPICS } from '../content/config';
import { DESK_COPY } from '../lib/desks';
import { issueNumbers } from '../lib/issue-number';

const published = await getCollection('issues', (e) => e.data.status !== 'draft');
const newestFirst = [...published].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || b.slug.localeCompare(a.slug)
);
const numbers = await issueNumbers();

const monthOf = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const monthKey = (d: Date) => `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
const groups: { key: string; label: string; issues: CollectionEntry<'issues'>[] }[] = [];
for (const i of newestFirst) {
  const key = monthKey(i.data.publishedAt);
  let g = groups.find((x) => x.key === key);
  if (!g) groups.push((g = { key, label: monthOf(i.data.publishedAt), issues: [] }));
  g.issues.push(i);
}

const plural = (n: number) => `${n} ${n === 1 ? 'issue' : 'issues'}`;
const first = newestFirst[newestFirst.length - 1];
const since = first ? ` since ${monthOf(first.data.publishedAt)}` : '';
/* Desks with at least one published issue get a chip: a chip that filters to
   nothing is a dead control. */
const chips = TOPICS.map((t) => ({ t, n: newestFirst.filter((i) => i.data.topic === t).length })).filter((c) => c.n > 0);
---

<HomeLayout title="The archive · Parallax Lens" description="Every published Parallax issue, by desk and by month." footerNewsletter={false}>
  <Masthead variant="meta" current="archive" />

  <div class="px-arch">
    <header class="px-arch__head">
      <div class="px-arch__titles">
        <h1 class="px-arch__h1">The archive</h1>
        <p class="px-arch__count">{plural(newestFirst.length)}{since}</p>
      </div>
      <div class="px-arch__chips" id="px-arch-chips" role="group" aria-label="Filter by desk" hidden>
        <button class="px-arch__chip" type="button" data-desk="" aria-pressed="true">All<span class="px-arch__n">{newestFirst.length}</span></button>
        {chips.map((c) => (
          <button class="px-arch__chip" type="button" data-desk={c.t} aria-pressed="false">
            <Mark desk={c.t} size={24} tight ground="var(--paper-2)" class="px-arch__mk" />
            {DESK_COPY[c.t].name}<span class="px-arch__n">{c.n}</span>
          </button>
        ))}
      </div>
      <p class="px-arch__status" id="px-arch-status" role="status" aria-live="polite"></p>
    </header>

    {groups.length ? groups.map((g) => (
      <section class="px-arch__month" aria-labelledby={`m-${g.key}`} data-month>
        <div class="px-arch__mhead">
          <h2 class="px-arch__mlabel" id={`m-${g.key}`}>{g.label}</h2>
          <span class="px-arch__mrule" aria-hidden="true"></span>
          <span class="px-arch__mcount" data-month-count>{plural(g.issues.length)}</span>
        </div>
        <ul class="px-arch__grid">
          {g.issues.map((i) => (
            <li class="px-arch__cell" data-topic={i.data.topic}>
              <CoverCard issue={i} size="card" number={numbers.get(i.slug)} />
            </li>
          ))}
        </ul>
      </section>
    )) : (
      <p class="px-arch__none">Nothing published yet. The desks are {TOPICS.map((t) => DESK_COPY[t].name).join(', ')}, and the first issue will open one of them.</p>
    )}
  </div>
</HomeLayout>

<style>
  .px-arch { display: flex; flex-direction: column; gap: 64px; padding: 72px 0 96px; }
  .px-arch__head { display: flex; flex-direction: column; gap: 32px; }
  .px-arch__titles { display: flex; flex-direction: column; gap: 12px; }
  .px-arch__h1 { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 64px; line-height: 1.02; letter-spacing: -0.01em; }
  .px-arch__count { margin: 0; font: 500 17px/1.5 var(--font-ui); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .px-arch__status { margin: -20px 0 0; min-height: 1.4em; font: 500 13px/1.4 var(--font-ui); color: var(--muted); }

  .px-arch__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .px-arch__chips[hidden] { display: none; }
  .px-arch__chip {
    height: 44px; flex: none; box-sizing: border-box;
    padding: 0 16px 0 10px;
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid var(--hair-2); border-radius: var(--r-chip);
    background: var(--paper-2); color: var(--ink);
    font: 500 14px/1 var(--font-ui);
    cursor: pointer;
    transition: border-color var(--t-micro, 160ms) var(--ease), background var(--t-micro, 160ms) var(--ease), color var(--t-micro, 160ms) var(--ease);
  }
  .px-arch__chip:first-child { padding: 0 18px; }
  .px-arch__chip:hover { border-color: var(--ink); }
  .px-arch__chip:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .px-arch__chip[aria-pressed='true'] { border-color: var(--ink); background: var(--ink); color: var(--paper); font-weight: 600; }
  .px-arch__n { font-weight: 500; color: var(--muted); font-variant-numeric: tabular-nums; }
  .px-arch__chip[aria-pressed='true'] .px-arch__n { color: color-mix(in srgb, var(--paper) 72%, transparent); }

  .px-arch__month { display: flex; flex-direction: column; gap: 24px; }
  .px-arch__month[hidden] { display: none; }
  .px-arch__mhead { display: flex; align-items: center; gap: 16px; }
  .px-arch__mlabel { margin: 0; flex: none; font: 500 12px/20px var(--font-ui); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); }
  .px-arch__mrule { flex: 1; height: 1px; background: var(--hair); }
  .px-arch__mcount { flex: none; font: 500 13px/1 var(--font-ui); color: var(--muted); font-variant-numeric: tabular-nums; }
  .px-arch__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .px-arch__cell { display: flex; min-width: 0; }
  .px-arch__cell[hidden] { display: none; }
  .px-arch__cell > :global(.px-cover) { flex: 1; }
  .px-arch__none { margin: 0; font-family: var(--font-display); font-size: 19px; line-height: 1.6; color: var(--ink-2); }

  @media (max-width: 1100px) and (min-width: 769px) {
    .px-arch__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .px-arch { gap: 48px; padding: 48px 0 64px; }
    .px-arch__h1 { font-size: 40px; line-height: 1.06; }
    .px-arch__head { gap: 24px; }
    .px-arch__grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById('px-arch-chips');
    var status = document.getElementById('px-arch-status');
    if (!bar) return;
    var chips = Array.prototype.slice.call(bar.querySelectorAll('[data-desk]'));
    var months = Array.prototype.slice.call(document.querySelectorAll('[data-month]'));
    var cells = Array.prototype.slice.call(document.querySelectorAll('.px-arch__cell'));
    /* Reveal only now: the chips ship hidden so a no-JS reader never meets a
       dead control. */
    bar.hidden = false;
    function apply(desk) {
      var shown = 0;
      months.forEach(function (m) {
        var n = 0;
        m.querySelectorAll('.px-arch__cell').forEach(function (c) {
          var on = !desk || c.getAttribute('data-topic') === desk;
          c.hidden = !on;
          if (on) n++;
        });
        m.hidden = n === 0;
        var mc = m.querySelector('[data-month-count]');
        if (mc) mc.textContent = n + (n === 1 ? ' issue' : ' issues');
        shown += n;
      });
      /* The noun agrees with the TOTAL: "3 of 17 issues". */
      if (status) status.textContent = shown === cells.length ? '' : shown + ' of ' + cells.length + (cells.length === 1 ? ' issue' : ' issues');
    }
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        chips.forEach(function (c) { c.setAttribute('aria-pressed', String(c === chip)); });
        apply(chip.getAttribute('data-desk') || '');
      });
    });
  })();
</script>
