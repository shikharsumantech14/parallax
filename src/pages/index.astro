---
/**
 * Home (Lens Phase 4, the Home board and Home-Phone board).
 *
 *   1. the stage   the cover issue told as a picture on its desk's plate
 *                  (core/Stage + stage/StageScene): the number at 160, the
 *                  drawn scene, the ladder, the headline, Read the issue
 *   2. six desks   a card per desk: its medallion, register, name, tagline,
 *                  dispatch count, and its latest issue's cover mark with the
 *                  one line that says what the mark shows
 *   3. latest      the six newest as cover cards, two rows of three
 *   4. the strip   Independent · Sourced · Slow
 *   5. the letter  one line and the dispatch form
 *   then the footer (HomeLayout's Colophon), and the first-visit intro.
 *
 * The cover issue is the newest published issue that carries a `cover`; with
 * none, the newest. Every count on the page is derived from the published
 * collection; the copy is DESK_COPY's and the publication's standing lines.
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import NewsletterNotice from '../components/core/NewsletterNotice.astro';
import NewsletterForm from '../components/core/NewsletterForm.astro';
import Stage from '../components/core/Stage.astro';
import StageScene from '../components/stage/StageScene.astro';
import CoverCard from '../components/core/CoverCard.astro';
import CoverMark from '../components/core/CoverMark.astro';
import Mark from '../components/core/Mark.astro';
import PromiseStrip from '../components/core/PromiseStrip.astro';
import IntroOverlay from '../components/core/IntroOverlay.astro';
import { TOPICS, type Topic } from '../content/config';
import { DESK_REGISTER, DESK_COPY } from '../lib/desks';
import { ink } from '../lib/desk-inks';
import { coverModel } from '../lib/cover';
import { formatNo, issueNumbers } from '../lib/issue-number';

const published = await getCollection('issues', (e) => e.data.status !== 'draft');
const newestFirst = [...published].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || b.slug.localeCompare(a.slug)
);
const numbers = await issueNumbers();

const cover = newestFirst.find((i) => i.data.cover) ?? newestFirst[0];
const coverNo = cover ? numbers.get(cover.slug) : undefined;

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const desks = TOPICS.map((topic) => {
  const mine = newestFirst.filter((i) => i.data.topic === topic);
  const latest: CollectionEntry<'issues'> | undefined = mine[0];
  const caption = latest
    ? coverModel(topic, latest.data.sections, latest.data.title, { cover: latest.data.cover }).caption
    : '';
  return {
    topic,
    register: DESK_REGISTER[topic],
    copy: DESK_COPY[topic],
    count: plural(mine.length, 'issue', 'issues'),
    latest,
    caption,
    inks: `--dk-text: ${ink(topic, 'text')}; --dk-mark: ${ink(topic, 'mark')}; --dk-tint: ${ink(topic, 'tint')}`,
  };
});

const latestSix = newestFirst.slice(0, 6);
---

<HomeLayout
  title="Parallax Lens: visual explainers from a different angle"
  description="Parallax Lens, a visual explainer publication. Six desks: politics, space, earth, tech, travel, sports. One topic per issue, every claim cited."
  footerNewsletter={false}
>
  <NewsletterNotice />

  {cover ? (
    <Stage desk={cover.data.topic} height={760} label="Latest issue" current="home">
      <StageScene
        issue={cover}
        variant="home"
        eyebrow={[DESK_REGISTER[cover.data.topic], coverNo ? formatNo(coverNo) : undefined, cover.data.readTimeMinutes ? `${cover.data.readTimeMinutes} min` : undefined].filter(Boolean).join(' · ')}
        cta="Read the issue"
      />
    </Stage>
  ) : null}

  <div class="px-home">
    <section class="px-home__desks" id="desks" aria-labelledby="px-home-desks">
      <h2 class="px-home__label" id="px-home-desks">Six desks</h2>
      <div class="px-home__grid">
        {desks.map((d) => (
          <a class="px-dcard" href={`/topics/${d.topic}/`} style={d.inks}>
            <span class="px-dcard__rule" aria-hidden="true"></span>
            <span class="px-dcard__head">
              <Mark desk={d.topic} size={40} tight ground="var(--paper-2)" />
              <span class="px-dcard__names">
                <span class="px-dcard__reg">{d.register}</span>
                <span class="px-dcard__name">{d.copy.name}</span>
              </span>
              <span class="px-dcard__chip">{d.count}</span>
            </span>
            <span class="px-dcard__tag">{d.copy.tag}</span>
            {d.latest && (
              <figure class="px-dcard__fig">
                <span class="px-dcard__panel"><CoverMark issue={d.latest} /></span>
                {d.caption && <figcaption class="px-dcard__cap">{d.caption}</figcaption>}
              </figure>
            )}
          </a>
        ))}
      </div>
    </section>

    {latestSix.length > 0 && (
      <section class="px-home__latest" aria-labelledby="px-home-latest">
        <div class="px-home__row">
          <h2 class="px-home__label" id="px-home-latest">Latest</h2>
          <a class="px-home__all" href="/archive/">All {plural(published.length, 'issue', 'issues')} →</a>
        </div>
        <div class="px-home__grid">
          {latestSix.map((i) => <CoverCard issue={i} size="card" number={numbers.get(i.slug)} />)}
        </div>
      </section>
    )}

    <div class="px-home__close">
      <PromiseStrip />
      <div class="px-home__letter" id="subscribe">
        <p class="px-home__letterline">One quiet letter when an issue is worth keeping</p>
        <div class="px-home__form"><NewsletterForm /></div>
      </div>
    </div>
  </div>

  {cover && <IntroOverlay issue={cover} number={coverNo} />}
</HomeLayout>

<style>
  .px-home { display: flex; flex-direction: column; gap: 96px; padding: 88px 0 96px; }
  .px-home__label {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 12px; font-weight: 500; line-height: 20px;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--muted);
  }
  .px-home__desks, .px-home__latest { display: flex; flex-direction: column; gap: 24px; }
  .px-home__latest { gap: 20px; }
  .px-home__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .px-home__row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .px-home__all {
    min-height: 44px; display: inline-flex; align-items: center;
    font: 600 14px/1 var(--font-ui); color: var(--ink); text-decoration: none;
  }
  .px-home__all:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }

  /* ── The desk card (the Home board): a 3px rule in the desk mark, the
     medallion at 40, register over name, the count chip, the tagline, and
     the latest issue's cover mark with its line. ───────────────────────── */
  .px-dcard {
    display: flex; flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--hair);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-1);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--t-micro, 160ms) var(--ease), box-shadow var(--t-micro, 160ms) var(--ease);
  }
  .px-dcard:hover { border-color: var(--ink); box-shadow: var(--shadow-2); }
  .px-dcard:hover .px-dcard__name { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .px-dcard:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .px-dcard__rule { display: block; height: 3px; flex: 0 0 3px; background: var(--dk-mark); }
  .px-dcard__head { display: flex; align-items: center; gap: 14px; padding: 22px 24px 0; }
  .px-dcard__names { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .px-dcard__reg {
    font: 500 12px/1 var(--font-ui); letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--dk-text);
  }
  .px-dcard__name {
    font-family: var(--font-display); font-weight: 500; font-size: 32px; line-height: 1.05; letter-spacing: -0.01em;
  }
  .px-dcard__chip {
    align-self: flex-start;
    height: 28px; display: inline-flex; align-items: center; padding: 0 10px;
    border-radius: var(--r-chip);
    background: var(--dk-tint); color: var(--dk-text);
    font: 500 12px/1 var(--font-ui); font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .px-dcard__tag {
    flex: 1;
    padding: 16px 24px 20px;
    font-family: var(--font-display); font-size: 17px; line-height: 1.45; color: var(--ink-2);
  }
  .px-dcard__fig { margin: 0; display: flex; flex-direction: column; }
  .px-dcard__panel {
    display: flex; align-items: center; justify-content: center;
    height: 216px;
    background: var(--dk-tint);
    container-type: inline-size;
    overflow: hidden;
  }
  .px-dcard__cap {
    padding: 14px 24px 22px;
    font: 400 14px/1.4 var(--font-ui); color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ── The close: the strip, then the letter. ─────────────────────────── */
  .px-home__close { display: flex; flex-direction: column; gap: 64px; }
  .px-home__letter { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .px-home__letterline {
    margin: 0;
    font-family: var(--font-display); font-weight: 500; font-size: 28px; line-height: 1.2; letter-spacing: -0.01em;
    color: var(--ink);
  }
  .px-home__form { flex: 0 0 440px; min-width: 0; }
  /* The form island is shared (core/NewsletterForm): here its heading and
     dek go (the line beside it says it), its label is kept for the input's
     name but clipped, and its row takes the Lens input and button. */
  .px-home__form :global(.px-newsletter) { margin: 0; padding: 0; border: 0; }
  .px-home__form :global(.px-newsletter__inner) { max-width: none; padding: 0; }
  .px-home__form :global(.px-newsletter__title),
  .px-home__form :global(.px-newsletter__dek) { display: none; }
  .px-home__form :global(.px-newsletter__label) {
    font-size: 12px;
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  .px-home__form :global(.px-newsletter__row) { max-width: none; gap: 8px; }
  .px-home__form :global(.px-newsletter__input) {
    height: 44px; box-sizing: border-box; padding: 0 14px;
    border: 1px solid var(--hair-2); border-radius: var(--r-ctl);
    background: var(--paper-2); font: 400 16px/1 var(--font-ui);
  }
  .px-home__form :global(.px-newsletter__input:focus) { border-color: var(--ink); outline: 2px solid var(--ink); outline-offset: 2px; }
  .px-home__form :global(.px-newsletter__submit) {
    height: 44px; padding: 0 20px;
    border-radius: var(--r-ctl);
    font: 600 15px/1 var(--font-ui); letter-spacing: 0; text-transform: none;
    background: var(--ink); color: var(--paper);
  }
  .px-home__form :global(.px-newsletter__submit:hover) { background: var(--ink-2); color: var(--paper); }
  .px-home__form :global(.px-newsletter__status),
  .px-home__form :global(.px-newsletter__nojs) { font: 400 13px/1.5 var(--font-ui); }

  @media (max-width: 1100px) and (min-width: 769px) {
    .px-home__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .px-home { gap: 64px; padding: 56px 0 64px; }
    .px-home__grid { grid-template-columns: 1fr; gap: 16px; }
    .px-dcard__head { padding: 20px 20px 0; }
    .px-dcard__tag { padding: 14px 20px 18px; }
    .px-dcard__cap { padding: 12px 20px 20px; }
    .px-home__letter { flex-direction: column; align-items: stretch; gap: 16px; }
    .px-home__letterline { font-size: 24px; }
    .px-home__form { flex: none; }
    .px-home__close { gap: 48px; }
  }
</style>
