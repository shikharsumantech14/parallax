---
import { getCollection } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import Masthead from '../components/core/Masthead.astro';
import NewsletterNotice from '../components/core/NewsletterNotice.astro';
import WireStrip from '../components/home/WireStrip.astro';
import FeaturedPlate from '../components/home/FeaturedPlate.astro';
import ManifestoStrip from '../components/home/ManifestoStrip.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import ArchiveList from '../components/home/ArchiveList.astro';
import SubscribeStrip from '../components/home/SubscribeStrip.astro';
import AccountLine from '../components/welcome/AccountLine.astro';
import IntroExperience from '../components/intro/IntroExperience.astro';
import { TOPICS, type Topic } from '../content/config';
import type { CollectionEntry } from 'astro:content';
import '../styles/welcome.css';

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.parallaxlens.com';

const allIssues = await getCollection('issues', (entry) => entry.data.status !== 'draft');
const issuesByDate = allIssues.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const sortedOldestFirst = [...allIssues].sort(
  (a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime()
);
const issueNumberFor = (slug: string) =>
  sortedOldestFirst.findIndex((i) => i.slug === slug) + 1;

// Latest issue per topic, for the category grid
const issuesByTopic: Partial<Record<Topic, CollectionEntry<'issues'>>> = {};
for (const topic of TOPICS) {
  const entry = issuesByDate.find((i) => i.data.topic === topic);
  if (entry) issuesByTopic[topic] = entry;
}

// Most recent issue overall — drives the chord accent and masthead number
const featured = issuesByDate[0];

// Archive list — every published issue
const archive = issuesByDate.map((issue) => ({
  slug: issue.slug,
  topic: issue.data.topic,
  title: issue.data.title,
  issueNumber: issueNumberFor(issue.slug),
  publishedAt: issue.data.publishedAt,
  readTimeMinutes: issue.data.readTimeMinutes
}));

/* The lead issue's fact rail (Phase 7). Every figure is DERIVED -- issues and
   sources are counted from the published collection, desks from TOPICS -- so
   the rail cannot drift from the archive the way a hardcoded number would.
   The prototype's own counters are 'Issues / Sources cited / Desks'; its
   values (24 issues, 1,412 sources) are its fiction, not ours. */
const sourcesCited = allIssues.reduce((n, i) => n + (i.data.sources?.length ?? 0), 0);
const homeFacts = [
  { label: 'Issues', value: String(allIssues.length) },
  { label: 'Sources cited', value: sourcesCited.toLocaleString('en-US') },
  { label: 'Desks', value: String(TOPICS.length), accent: true },
];

// The wire — 3 latest dispatches (HOME-SPEC §3)
const wireItems = issuesByDate.slice(0, 3).map((issue) => ({
  slug: issue.slug,
  title: issue.data.title,
  topic: issue.data.topic,
  issueNumber: issueNumberFor(issue.slug)
}));

// Dispatch counts per desk (HOME-SPEC §4 portal meta line)
const countsByTopic: Partial<Record<Topic, number>> = {};
for (const issue of allIssues) {
  countsByTopic[issue.data.topic] = (countsByTopic[issue.data.topic] ?? 0) + 1;
}
---

<HomeLayout
  title="Parallax Lens — Visual explainers from a different angle"
  description="Parallax Lens — a visual explainer publication. Six worlds — politics, space, earth, tech, travel, sports — one topic per issue, every claim cited."
  footerNewsletter={false}
>
  <NewsletterNotice />

  <Masthead variant="meta" issueNumber={featured ? String(issueNumberFor(featured.slug)).padStart(2, '0') : '01'} />


  {wireItems.length > 0 && featured && <WireStrip items={wireItems} latestSlug={featured.slug} />}

  {featured && <FeaturedPlate issue={featured} issueNumber={issueNumberFor(featured.slug)} facts={homeFacts} />}

  <CategoryGrid issuesByTopic={issuesByTopic} issueNumberFor={issueNumberFor} countsByTopic={countsByTopic} cols={2} />

  <ManifestoStrip />

  <ArchiveList items={archive} />

  <SubscribeStrip />
  <AccountLine appUrl={appUrl} nextPath="/" />

  <IntroExperience />
</HomeLayout>
