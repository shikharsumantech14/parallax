---
/* SSR: this route needs a request. `output: 'hybrid'` prerenders by
   default, so every app surface must opt out explicitly — miss one and it
   is baked at build time with no session. */
export const prerender = false;
import { getCollection, type CollectionEntry } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';
import Mark from '../../components/core/Mark.astro';
import CoverCard from '../../components/core/CoverCard.astro';
import CoverMark from '../../components/core/CoverMark.astro';
import { TOPICS, type Topic } from '../../content/config';
import { DESK_COPY } from '../../lib/desks';
import { ink } from '../../lib/desk-inks';
import { renderEmphasis, stripEmphasis } from '../../lib/text';
import { formatNo, issueNumbers, shortDay } from '../../lib/issue-number';
import { requireUser } from '../../lib/auth';
import { isAdmin } from '../../lib/admin';

/**
 * The Shelf — the reader's page (Lens, 2026-09-30, Phase 4b; the Shelf and
 * Shelf-Phone boards, BRIEF-3 §4).
 *
 * The publication's masthead (its account slot is the pill: initial disc,
 * name, caret, with Sign out inside) and footer, then, in order:
 *
 *   Hello, {name}.   Literata 700 56 (40 on phones)
 *   YOUR PATH        the one paper-3 field: the issues this reader has opened,
 *                    from reading_events, as small covers on a joined track,
 *                    each with a progress ring in its desk mark; the latest
 *                    one larger, with "Continue". Phones turn the track
 *                    vertical, the rings down the left.
 *   ON THE SHELF     saved issues (saved_issues) as CoverCard size="card",
 *                    each with a Remove control (DELETE /api/save/<id>).
 *   YOUR DESKS       "Follow a desk to get its issues first." Six tiles: the
 *                    medallion, the name, the tagline, the unread count (its
 *                    published issues this reader has not opened) and a
 *                    Follow / Following button. Following is
 *                    profiles.stated_interests, the set /account/welcome
 *                    writes, and the button is a plain form POST to the same
 *                    handler (/api/onboarding, intent=save, the new set as
 *                    repeated `interest`, next=/dashboard#desks). No JS needed.
 *   PREFERENCES      three role="switch" buttons bound to profiles.email_prefs
 *                    (weekly_digest, issue_publish, reengagement), posted to
 *                    /api/account/prefs as before. Without JS the switches
 *                    give way to the native checkboxes they drive.
 *
 * and below them, carried from the previous Shelf so nothing a reader could
 * reach goes missing: their margin notes (comments), the account rows, the
 * moderation link for editors, and the delete-account zone.
 *
 * Data: profiles, saved_issues, comments and reading_events (select-own RLS,
 * 20260524200000_phase_b_reading_events.sql). `stated_interests` is fetched
 * on its own so a database without the onboarding migration still renders
 * the rest. Issue metadata comes from the content collection, so a saved or
 * opened id that is no longer published falls back to a plain link.
 */
const user = requireUser(Astro);
const { supabase } = Astro.locals;
const userIsAdmin = isAdmin(user);

// Six reads, ONE round trip's worth of waiting. They used to run one after
// another (seven sequential hops to Supabase from the Vercel function, the
// middleware's getUser() included), which is why the Shelf opened slower than
// a prerendered desk page. `stated_interests` stays its own query on purpose:
// a database without the onboarding migration still renders the rest.
const [
  { data: profile, error: profileError },
  { data: interestRow, error: interestError },
  { data: savedIssues, error: savedError },
  { data: notes, error: notesError },
  { count: notesTotal },
  { data: events, error: eventsError },
] = await Promise.all([
  supabase
    .from('profiles')
    .select('display_name, email, email_prefs, created_at')
    .eq('id', user.id)
    .maybeSingle(),
  supabase
    .from('profiles')
    .select('stated_interests')
    .eq('id', user.id)
    .maybeSingle(),
  supabase
    .from('saved_issues')
    .select('issue_id, saved_at')
    .order('saved_at', { ascending: false })
    .limit(24),
  // The reader's own margin notes across issues, newest first (any status —
  // this is their private view; the same RLS that powers the annotation island
  // already allows select-own at any status).
  supabase
    .from('comments')
    .select('id, body_md, status, created_at, issue_id')
    .eq('user_id', user.id)
    .order('created_at', { ascending: false })
    .limit(6),
  supabase
    .from('comments')
    .select('id', { count: 'exact', head: true })
    .eq('user_id', user.id),
  // The path: what this reader has opened, from their own reading events.
  supabase
    .from('reading_events')
    .select('issue_id, event_kind, created_at')
    .eq('user_id', user.id)
    .order('created_at', { ascending: false })
    .limit(500),
]);
if (profileError) console.error('[shelf] profile fetch failed:', profileError.message);
if (interestError) console.error('[shelf] stated_interests fetch failed:', interestError.message);
if (savedError) console.error('[shelf] saved_issues fetch failed:', savedError.message);
if (notesError) console.error('[shelf] comments fetch failed:', notesError.message);
if (eventsError) console.error('[shelf] reading_events fetch failed:', eventsError.message);

const displayName =
  profile?.display_name ||
  (user.user_metadata?.name as string | undefined) ||
  (user.user_metadata?.full_name as string | undefined) ||
  null;
const firstName = displayName ? displayName.split(' ')[0] : null;

const memberSince = profile?.created_at ? new Date(profile.created_at) : new Date(user.created_at);
const memberSinceLabel = memberSince.toLocaleDateString('en-GB', {
  year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC',
});

const emailPrefs = (profile?.email_prefs as Record<string, boolean> | null) ?? {
  weekly_digest: true, issue_publish: true, reengagement: true,
};

const noticeParam = Astro.url.searchParams.get('notice');
const noticeKind = Astro.url.searchParams.get('kind') ?? 'info';

/* ── the published collection, the one source of titles and covers ── */
const published = await getCollection('issues', (e) => e.data.status !== 'draft');
const bySlug = new Map(published.map((e) => [e.slug, e]));
const numbers = await issueNumbers();
const metaLine = (e: CollectionEntry<'issues'>) =>
  [
    numbers.get(e.slug) ? formatNo(numbers.get(e.slug)!) : undefined,
    shortDay(e.data.publishedAt),
    e.data.readTimeMinutes ? `${e.data.readTimeMinutes} min` : undefined,
  ].filter(Boolean).join(' · ');

/** A saved or opened id that is not in the published collection: the slug
 *  carries the title (title-cased), as the Shelf always did. */
function prettify(issueId: string) {
  const m = issueId.match(/^(\d{4})-(\d{2})-(\d{2})-(.+)$/);
  const slug = m ? m[4] : issueId;
  const title = slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  return { title, href: `/issues/${issueId}/` };
}

/* ── the path ── */
const PCT: Record<string, number> = { open: 10, scroll_25: 25, scroll_75: 75, finish: 100 };
const reads = new Map<string, { pct: number; last: number }>();
for (const ev of events ?? []) {
  const pct = PCT[ev.event_kind as string];
  if (pct === undefined) continue;
  const t = new Date(ev.created_at as string).getTime();
  const cur = reads.get(ev.issue_id as string);
  if (!cur) reads.set(ev.issue_id as string, { pct, last: t });
  else reads.set(ev.issue_id as string, { pct: Math.max(cur.pct, pct), last: Math.max(cur.last, t) });
}
const opened = [...reads.entries()]
  .filter(([id]) => bySlug.has(id))
  .sort((a, b) => b[1].last - a[1].last)
  .map(([id, r]) => ({ entry: bySlug.get(id)!, pct: r.pct }));
const current = opened[0];
const trail = opened.slice(1, 4).reverse(); // oldest first, the current one last
const latestIssue = [...published].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || b.slug.localeCompare(a.slug),
)[0];

/** A progress ring in the desk mark: the full ring and a tick at 100%, an
 *  arc and the percentage below it. */
function ring(pct: number, size: 40 | 56) {
  const sw = size === 56 ? 4 : 3;
  const c = size / 2;
  const r = c - sw / 2 - (size === 56 ? 1 : 0.5);
  const len = 2 * Math.PI * r;
  return { size, c, r, sw, len: +len.toFixed(1), dash: +((len * pct) / 100).toFixed(1), done: pct >= 100, fs: size === 56 ? 14 : 12 };
}
const SANS = "font-family:'Literata',Georgia,serif";

/* ── the shelf ── */
const saved = (savedIssues ?? []).map((s) => ({ id: s.issue_id as string, entry: bySlug.get(s.issue_id as string) }));
const savedCount = saved.length;

/* ── the desks ── */
const following = new Set<string>(
  Array.isArray(interestRow?.stated_interests)
    ? (interestRow!.stated_interests as unknown[]).filter((x): x is string => typeof x === 'string')
    : [],
);
const desks = TOPICS.map((t) => {
  const inDesk = published.filter((e) => e.data.topic === t);
  const unread = inDesk.filter((e) => !reads.has(e.slug)).length;
  const on = following.has(t);
  const nextSet = TOPICS.filter((x) => (x === t ? !on : following.has(x)));
  return { t, on, unread, total: inDesk.length, nextSet };
});

const NOTE_STATUS: Record<string, string> = {
  approved: 'Published', pending: 'In review', rejected: 'Not shown',
};

const PREFS: { key: 'weekly_digest' | 'issue_publish' | 'reengagement'; label: string }[] = [
  { key: 'weekly_digest', label: 'Weekly letter' },
  { key: 'issue_publish', label: 'New-issue alerts' },
  { key: 'reengagement', label: 'Streak reminders' },
];

const deskVars = (t: Topic) =>
  `--dk-text: ${ink(t, 'text')}; --dk-mark: ${ink(t, 'mark')}; --dk-tint: ${ink(t, 'tint')}`;
---

<AppLayout title="Your Shelf" description="Your reading, on Parallax." width="shelf">
  <div class="shelf">
    {noticeParam && (
      <p class={`notice notice--${noticeKind === 'ok' ? 'ok' : noticeKind === 'err' ? 'err' : 'info'}`} role="status">
        {noticeParam}
      </p>
    )}

    {/* ── Hello, and the path ─────────────────────────────────────────── */}
    <section class="shelf__sec shelf__sec--path" aria-labelledby="path-h">
      <h1 class="shelf__h1">{firstName ? `Hello, ${firstName}.` : 'Welcome back.'}</h1>
      <div class="shelf__group">
        <h2 id="path-h" class="px-meta">Your path</h2>
        {current ? (
          <ol class="path" role="list">
            {trail.map((s, i) => {
              const rg = ring(s.pct, 40);
              const n = numbers.get(s.entry.slug);
              return (
                <li class="path__step" style={deskVars(s.entry.data.topic)}>
                  <a class="px-card path__cover" href={`/issues/${s.entry.slug}/`} aria-label={`${n ? formatNo(n) : stripEmphasis(s.entry.data.title)}, ${s.pct}% read`}>
                    <span class="path__panel"><CoverMark issue={s.entry} labels={false} /></span>
                    <span class="path__no"><span class="path__dot" aria-hidden="true"></span>{n ? formatNo(n) : stripEmphasis(s.entry.data.title)}</span>
                  </a>
                  <span class="path__track">
                    <span class:list={['path__line', { 'path__line--none': i === 0 }]} aria-hidden="true"></span>
                    <svg class="path__ring" width={rg.size} height={rg.size} viewBox={`0 0 ${rg.size} ${rg.size}`} role="img" aria-label={`${s.pct}% read`}>
                      <circle cx={rg.c} cy={rg.c} r={rg.c - 0.5} fill="var(--paper-3)" />
                      <circle cx={rg.c} cy={rg.c} r={rg.r} fill="none" stroke="var(--hair-2)" stroke-width={rg.sw} />
                      {rg.done ? (
                        <>
                          <circle cx={rg.c} cy={rg.c} r={rg.r} fill="none" stroke="var(--dk-mark)" stroke-width={rg.sw} />
                          <path d="M14 20 l4.5 4.5 l8 -9" fill="none" stroke="var(--dk-text)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                        </>
                      ) : (
                        <>
                          <circle cx={rg.c} cy={rg.c} r={rg.r} fill="none" stroke="var(--dk-mark)" stroke-width={rg.sw} stroke-linecap="round" stroke-dasharray={`${rg.dash} ${rg.len}`} transform={`rotate(-90 ${rg.c} ${rg.c})`} />
                          <text x={rg.c} y={rg.c + 4} text-anchor="middle" fill="var(--ink)" style={`${SANS};font-size:${rg.fs}px;font-weight:600;font-variant-numeric:tabular-nums`}>{s.pct}%</text>
                        </>
                      )}
                    </svg>
                    <span class="path__line" aria-hidden="true"></span>
                  </span>
                </li>
              );
            })}
            {(() => {
              const s = current;
              const rg = ring(s.pct, 56);
              const n = numbers.get(s.entry.slug);
              const href = `/issues/${s.entry.slug}/`;
              return (
                <li class="path__step path__step--now" style={deskVars(s.entry.data.topic)}>
                  <article class="px-card path__now">
                    <a class="path__now-panel" href={href} tabindex="-1" aria-hidden="true">
                      <CoverMark issue={s.entry} />
                    </a>
                    <div class="path__now-body">
                      <div class="path__now-text">
                        <span class="path__meta"><span class="path__dot" aria-hidden="true"></span>{metaLine(s.entry)}</span>
                        <h3 class="path__now-hl"><a href={href} set:html={renderEmphasis(s.entry.data.title)} /></h3>
                      </div>
                      <a class="px-btn path__go" href={href}>
                        {s.pct >= 100 ? 'Read again' : 'Continue'}
                        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </a>
                    </div>
                  </article>
                  <span class="path__track">
                    <span class:list={['path__line', { 'path__line--none': trail.length === 0 }]} aria-hidden="true"></span>
                    <svg class="path__ring" width={rg.size} height={rg.size} viewBox={`0 0 ${rg.size} ${rg.size}`} role="img" aria-label={`${s.pct}% read`}>
                      <circle cx={rg.c} cy={rg.c} r={rg.c - 0.5} fill="var(--paper-3)" />
                      <circle cx={rg.c} cy={rg.c} r={rg.r} fill="none" stroke="var(--hair-2)" stroke-width={rg.sw} />
                      {rg.done ? (
                        <>
                          <circle cx={rg.c} cy={rg.c} r={rg.r} fill="none" stroke="var(--dk-mark)" stroke-width={rg.sw} />
                          <path d="M19 28 l6.5 6.5 l11.5 -13" fill="none" stroke="var(--dk-text)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                        </>
                      ) : (
                        <>
                          <circle cx={rg.c} cy={rg.c} r={rg.r} fill="none" stroke="var(--dk-mark)" stroke-width={rg.sw} stroke-linecap="round" stroke-dasharray={`${rg.dash} ${rg.len}`} transform={`rotate(-90 ${rg.c} ${rg.c})`} />
                          <text x={rg.c} y={rg.c + 5} text-anchor="middle" fill="var(--ink)" style={`${SANS};font-size:${rg.fs}px;font-weight:600;font-variant-numeric:tabular-nums`}>{s.pct}%</text>
                        </>
                      )}
                    </svg>
                    <span class="path__line path__line--none" aria-hidden="true"></span>
                  </span>
                </li>
              );
            })()}
          </ol>
        ) : (
          <div class="path path--empty">
            <p class="shelf__empty">Your path starts with the first issue you open.</p>
            {latestIssue && <a class="px-btn" href={`/issues/${latestIssue.slug}/`}>Read the latest issue</a>}
          </div>
        )}
      </div>
    </section>

    {/* ── On the shelf ──────────────────────────────────────────────────── */}
    <section class="shelf__sec" aria-labelledby="shelf-h" data-shelf>
      <h2 id="shelf-h" class="px-meta">On the shelf <span class="shelf__count" data-shelf-count>{savedCount > 0 ? `· ${savedCount}` : ''}</span></h2>
      <div class="shelf__empty-wrap" data-shelf-empty hidden={savedCount > 0}>
        <p class="shelf__empty">Your shelf is empty. Save an issue while you read and it lands here to finish later.</p>
        <a class="px-btn px-btn--ghost" href="/archive/">Browse the archive</a>
      </div>
      {savedCount > 0 && (
        <ul class="shelf__grid" role="list">
          {saved.map((s) => {
            const title = s.entry ? stripEmphasis(s.entry.data.title) : prettify(s.id).title;
            return (
              <li class="shelf__item" data-shelf-item={s.id} style={s.entry ? deskVars(s.entry.data.topic) : undefined}>
                {s.entry ? (
                  <CoverCard issue={s.entry} size="card" number={numbers.get(s.id)} />
                ) : (
                  <a class="px-card shelf__plain" href={prettify(s.id).href}>
                    <span class="shelf__plain-hl">{title}</span>
                    <span class="px-meta">Saved</span>
                  </a>
                )}
                <button type="button" class="shelf__remove" data-remove={s.id} aria-label={`Remove ${title} from the shelf`}>
                  <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5 3h10v14l-5-3.6L5 17z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
                </button>
              </li>
            );
          })}
        </ul>
      )}
      <p class="shelf__status" role="status" aria-live="polite" data-shelf-status></p>
    </section>

    {/* ── Your desks ────────────────────────────────────────────────────── */}
    <section class="shelf__sec" id="desks" aria-labelledby="desks-h">
      <div class="shelf__group shelf__group--tight">
        <h2 id="desks-h" class="px-meta">Your desks</h2>
        <p class="shelf__lede">Follow a desk to get its issues first.</p>
      </div>
      <ul class="desks" role="list">
        {desks.map((d) => (
          <li class:list={['desk', { 'desk--on': d.on }]} style={deskVars(d.t)}>
            <a class="desk__mark" href={`/topics/${d.t}/`} aria-label={`${DESK_COPY[d.t].name} desk`}>
              <Mark desk={d.t} size={48} tight ground="var(--paper-2)" />
            </a>
            <div class="desk__body">
              <div class="desk__text">
                <div class="desk__row">
                  <h3 class="desk__name"><a href={`/topics/${d.t}/`}>{DESK_COPY[d.t].name}</a></h3>
                  {d.total > 0 && (
                    <span class="desk__count">{d.unread > 0 ? `${d.unread} unread` : 'Up to date'}</span>
                  )}
                </div>
                <p class="desk__tag">{DESK_COPY[d.t].tag}</p>
              </div>
              <form method="post" action="/api/onboarding" class="desk__form">
                <input type="hidden" name="intent" value="save" />
                <input type="hidden" name="next" value="/dashboard#desks" />
                {d.nextSet.map((x) => <input type="hidden" name="interest" value={x} />)}
                <button
                  type="submit"
                  class="desk__follow"
                  aria-pressed={d.on ? 'true' : 'false'}
                  aria-label={d.on ? `Following ${DESK_COPY[d.t].name}. Press to stop following` : `Follow ${DESK_COPY[d.t].name}`}
                >
                  {d.on ? (
                    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M3 7.2l2.6 2.6L11 4.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  ) : (
                    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M7 2.5v9M2.5 7h9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                  )}
                  <span>{d.on ? 'Following' : 'Follow'}</span>
                </button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    </section>

    {/* ── Preferences ───────────────────────────────────────────────────── */}
    <section class="shelf__sec" aria-labelledby="prefs-h">
      <h2 id="prefs-h" class="px-meta">Preferences</h2>
      <form id="prefs-form" class="prefs" method="post" action="/api/account/prefs">
        {PREFS.map((p) => (
          <div class="prefs__cell">
            <label class="prefs__label" for={`pref-${p.key}`}>{p.label}</label>
            <input class="prefs__native" type="checkbox" name={p.key} id={`native-${p.key}`} checked={emailPrefs[p.key]} aria-label={p.label} />
            <button type="button" class="prefs__switch" id={`pref-${p.key}`} role="switch" aria-checked={emailPrefs[p.key] ? 'true' : 'false'} data-for={`native-${p.key}`}>
              <span class="prefs__track" aria-hidden="true"><span class="prefs__knob"></span></span>
            </button>
          </div>
        ))}
        <div class="prefs__actions">
          <span class="prefs__status" role="status" aria-live="polite" data-prefs-status></span>
          <button class="px-btn prefs__save" type="submit">Save preferences</button>
        </div>
      </form>
    </section>

    {/* ── In the margins ────────────────────────────────────────────────── */}
    {notes && notes.length > 0 && (
      <section class="shelf__sec" aria-labelledby="margins-h">
        <h2 id="margins-h" class="px-meta">In the margins</h2>
        <ul class="margins" role="list">
          {notes.map((n) => {
            const e = bySlug.get(n.issue_id as string);
            const it = e ? { title: stripEmphasis(e.data.title), href: `/issues/${e.slug}/` } : prettify(n.issue_id as string);
            return (
              <li class="margins__row">
                <p class="margins__quote">{n.body_md}</p>
                <div class="margins__foot">
                  <span class="px-chip px-chip--neutral">{NOTE_STATUS[n.status as string] ?? n.status}</span>
                  <a class="margins__issue" href={it.href}>{it.title}</a>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {/* ── Account ───────────────────────────────────────────────────────── */}
    <section class="shelf__sec" aria-labelledby="acct-h">
      <h2 id="acct-h" class="px-meta">Account</h2>
      <div class="acct">
        <dl class="acct__rows">
          <div class="acct__row"><dt>Name</dt><dd>{displayName ?? 'Not set'}</dd></div>
          <div class="acct__row"><dt>Email</dt><dd>{user.email}</dd></div>
          <div class="acct__row"><dt>Reader since</dt><dd>{memberSinceLabel}</dd></div>
          <div class="acct__row"><dt>Notes written</dt><dd>{notesTotal ?? 0}</dd></div>
        </dl>
        <div class="acct__side">
          <form method="post" action="/api/auth/signout">
            <button type="submit" class="px-btn px-btn--ghost">Sign out</button>
          </form>
          {userIsAdmin && <a class="px-btn px-btn--ghost" href="/admin/comments">The moderation queue</a>}
        </div>
      </div>

      <details class="danger">
        <summary class="danger__summary">Delete account permanently</summary>
        <p class="danger__body">
          This removes your profile, saved issues, reactions, reading events, and
          unsubscribes any newsletter address linked to your account. Hard-deleted
          within 30 days. Some data persists briefly in encrypted backups, which
          expire automatically. This cannot be undone.
        </p>
        <form method="post" action="/api/account/delete"
          onsubmit="return confirm('Delete your Parallax account permanently? This cannot be undone.');">
          <button type="submit" class="btn btn--danger">I understand. Delete my account</button>
        </form>
      </details>
    </section>
  </div>
</AppLayout>

<script is:inline>
  (function () {
    /* Preferences: the switches drive the native checkboxes the form posts,
       and the form saves without leaving the Shelf (the native POST, which
       redirects back with a notice, is the no-JS path). */
    var form = document.getElementById('prefs-form');
    if (form) {
      Array.prototype.forEach.call(form.querySelectorAll('[role="switch"]'), function (sw) {
        var box = document.getElementById(sw.getAttribute('data-for'));
        sw.addEventListener('click', function () {
          var on = sw.getAttribute('aria-checked') !== 'true';
          sw.setAttribute('aria-checked', on ? 'true' : 'false');
          if (box) box.checked = on;
        });
      });
      var status = form.querySelector('[data-prefs-status]');
      var btn = form.querySelector('button[type="submit"]');
      form.addEventListener('submit', function (e) {
        if (!window.fetch) return; // let the native POST handle it
        e.preventDefault();
        var label = btn.textContent;
        btn.disabled = true; btn.textContent = 'Saving…';
        if (status) status.textContent = '';
        fetch(form.action, { method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.ok; })
          .then(function (ok) { if (status) status.textContent = ok ? 'Saved.' : 'Could not save. Try again.'; })
          .catch(function () { if (status) status.textContent = 'Could not save. Try again.'; })
          .then(function () { btn.disabled = false; btn.textContent = label; });
      });
    }

    /* Remove from the shelf: DELETE /api/save/<id>, then the card leaves. */
    var shelf = document.querySelector('[data-shelf]');
    if (!shelf || !window.fetch) return;
    var say = shelf.querySelector('[data-shelf-status]');
    var count = shelf.querySelector('[data-shelf-count]');
    var empty = shelf.querySelector('[data-shelf-empty]');
    Array.prototype.forEach.call(shelf.querySelectorAll('[data-remove]'), function (b) {
      b.addEventListener('click', function () {
        var id = b.getAttribute('data-remove');
        b.disabled = true;
        fetch('/api/save/' + encodeURIComponent(id), { method: 'DELETE', credentials: 'include' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (j) {
            if (!j || !j.ok) throw new Error('remove failed');
            var item = b.closest('[data-shelf-item]');
            if (item) item.remove();
            var left = shelf.querySelectorAll('[data-shelf-item]').length;
            if (count) count.textContent = left > 0 ? '· ' + left : '';
            if (left === 0 && empty) empty.hidden = false;
            if (say) say.textContent = 'Removed from the shelf.';
          })
          .catch(function () {
            b.disabled = false;
            if (say) say.textContent = 'Could not remove it. Try again.';
          });
      });
    });
  })();
