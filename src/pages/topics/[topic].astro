---
/**
 * /topics/<desk>/ — one template, six worlds (launch design, 2026-09-08).
 *
 * This route is a slim data derivation plus <DeskIndex>. The six bespoke
 * <World>Index components it used to dispatch to are retired: the worlds
 * differ by accent and register, not by structure, and HomeLayout's `topic`
 * prop puts `data-topic` on <html>, which is what paints the page in the
 * world's colours.
 */
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { TOPICS, type Topic } from '../../content/config';
import HomeLayout from '../../layouts/HomeLayout.astro';
import Masthead from '../../components/core/Masthead.astro';
import DeskIndex from '../../components/desk/DeskIndex.astro';
import { DESK_COPY } from '../../lib/desks';

export const getStaticPaths: GetStaticPaths = () =>
  TOPICS.map((topic) => ({ params: { topic } }));

const { topic } = Astro.params as { topic: Topic };

const allIssues = await getCollection('issues', (entry) => entry.data.status !== 'draft');

/* Issue numbers are publication-wide and permanent: the 1-based position in
   publishedAt order across every published issue, ties broken by slug so the
   number never depends on collection read order. */
const sortedOldestFirst = [...allIssues].sort(
  (a, b) =>
    a.data.publishedAt.getTime() - b.data.publishedAt.getTime() ||
    a.slug.localeCompare(b.slug)
);
const issueNumberFor = (slug: string) =>
  sortedOldestFirst.findIndex((i) => i.slug === slug) + 1;

const deskIssues = allIssues
  .filter((issue) => issue.data.topic === topic)
  .sort(
    (a, b) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime() ||
      b.slug.localeCompare(a.slug)
  );

const items = deskIssues.map((issue) => ({
  slug: issue.slug,
  topic,
  title: issue.data.title,
  hook: issue.data.hook,
  issueNumber: issueNumberFor(issue.slug),
  publishedAt: issue.data.publishedAt,
  readTimeMinutes: issue.data.readTimeMinutes,
}));

/* The masthead badge reads this desk's newest issue; a desk that has yet to
   file borrows the publication's newest, so the header never claims 00. */
const badgeNumber = items[0]?.issueNumber ?? sortedOldestFirst.length;
const issueNumber = String(badgeNumber || 1).padStart(2, '0');
---

<HomeLayout
  title={`${DESK_COPY[topic].name} · Parallax Lens`}
  description={DESK_COPY[topic].blurb}
  topic={topic}
>
  <Masthead variant={topic} issueNumber={issueNumber} current="desks" />

  <DeskIndex topic={topic} items={items} />
</HomeLayout>
