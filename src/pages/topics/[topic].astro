---
/**
 * /topics/<desk>/ — one template, six desks (Lens Phase 4).
 *
 * A slim data derivation plus <DeskIndex>, which draws the desk's stage (its
 * masthead included), its dispatches, the reading path and the other desks.
 * HomeLayout's `topic` prop puts `data-topic` on <html>, which picks the
 * desk's inks for anything that reads the role tokens.
 */
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { TOPICS, type Topic } from '../../content/config';
import HomeLayout from '../../layouts/HomeLayout.astro';
import DeskIndex from '../../components/desk/DeskIndex.astro';
import { DESK_COPY } from '../../lib/desks';
import { issueNumbers } from '../../lib/issue-number';

export const getStaticPaths: GetStaticPaths = () =>
  TOPICS.map((topic) => ({ params: { topic } }));

const { topic } = Astro.params as { topic: Topic };

const published = await getCollection('issues', (entry) => entry.data.status !== 'draft');
/* Newest first, ties broken by slug, so "the latest" is always the highest
   number (issue numbers are publication-wide: src/lib/issue-number.ts). */
const all = [...published].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || b.slug.localeCompare(a.slug)
);
const issues = all.filter((issue) => issue.data.topic === topic);
const numbers = await issueNumbers();
---

<HomeLayout
  title={`${DESK_COPY[topic].name} · Parallax Lens`}
  description={DESK_COPY[topic].blurb}
  topic={topic}
  footerNewsletter={false}
>
  <DeskIndex topic={topic} issues={issues} all={all} numbers={numbers} />
</HomeLayout>
