---
/**
 * /about — "How Parallax works" (launch design, 2026-09-08).
 *
 * Built to the approved artboards (About.dc.html at 1280, AboutPhone.dc.html
 * at 412): a stack of full-width hairline BANDS inside the 1280 frame, with
 * two `.px-cells` strips (the three steps, the three promises) breaking the
 * rhythm as edge-to-edge grids. Every shared value comes from the launch
 * primitives in base.css — `.px-band`, `.px-h1`, `.px-lede`, `.px-eyebrow`,
 * `.px-cells` — so this page re-declares only what is genuinely local to it.
 *
 * The two `.px-cells--open` strips drop their own `border-top`: the band above
 * already draws that hairline, and the artboards show one rule there, not two.
 *
 * No JavaScript. Everything paints in its final state on first render.
 */
import { getCollection } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import Masthead from '../components/core/Masthead.astro';
import Mark from '../components/core/Mark.astro';
import { renderEmphasis } from '../lib/text';
import { MARK_GLYPH } from '../lib/mark-glyph';
import { TOPICS, type Topic } from '../content/config';

/* The badge reads the real backlist, like /archive and /. */
const published = await getCollection('issues', (e) => e.data.status !== 'draft');
const issueNumber = String(published.length).padStart(2, '0');

/* THE EDITOR'S PORTRAIT. The band renders only when this is filled in —
   OPERATOR: supply the image (drop it in public/, then set src/alt/caption/
   date here). While it is null the whole band is omitted rather than shipping
   a placeholder frame, because an empty hairline box on a live page reads as
   a broken image, not as a promise. */
const EDITOR_PORTRAIT: { src: string; alt: string; caption: string; date: string } | null = null;

/* THE SIX DRAFTS (RD-10 step 4). Copy and shapes are the handoff's own. The art
   was authored as React.createElement calls (Web.dc.html:665-698) rather than
   as SVG files, which §3 correction 5 flagged as needing re-drawing — but the
   primitives are fully specified there, so these are TRANSCRIBED, not
   reinvented. Only the two that drew their P as live `<text>` needed a real
   decision, and they take the outlined glyph for the same reason the mark
   does: a thumbnail that falls back to Georgia misrepresents the draft it is
   illustrating. */
const LORE_INK = 'var(--ink)';
const LORE_ACC = 'var(--topic-politics)';
const LORE_BG = 'var(--bg)';

const drafts = [
  { no: '01', title: 'Two offset squares', verdict: 'Discarded',
    body: 'The first draft said displacement with two rectangles, one outlined and one filled. It was legible at any size and completely anonymous — a hundred other publications own that shape.',
    note: 'Too generic to defend. A mark has to be ours before it is anything else.',
    art: `<rect x="114" y="114" width="144" height="144" fill="${LORE_ACC}"/><rect x="42" y="42" width="144" height="144" fill="none" stroke="${LORE_INK}" stroke-width="18"/>` },
  { no: '02', title: 'The observatory seal', verdict: 'Discarded',
    body: 'A full stellar-parallax diagram inside a ring of type: an orbit, two observer positions, two sightlines crossing at the object, the six desks standing in for fixed stars.',
    note: 'Correct and unreadable. A reader should not have to be taught a diagram to recognise a publication.',
    art: `<circle cx="150" cy="150" r="132" fill="none" stroke="${LORE_INK}" stroke-width="12"/><line x1="72" y1="214" x2="228" y2="92" stroke="${LORE_INK}" stroke-width="10"/><line x1="228" y1="214" x2="72" y2="92" stroke="${LORE_INK}" stroke-width="10"/><circle cx="150" cy="150" r="26" fill="${LORE_ACC}"/>` },
  { no: '03', title: 'The lens assembly', verdict: 'Kept, reassigned',
    body: 'The name taken at its word, drawn as a plate from an optics catalogue: parallel light in, two ground elements, and two focal points on the plate because the subject was seen from two positions.',
    note: 'Kept, but not as a logo. It is the illustration on this page and the first onboarding screen.',
    art: `<path d="M 150 40 A 150 150 0 0 1 150 260 A 150 150 0 0 1 150 40 Z" fill="none" stroke="${LORE_INK}" stroke-width="16"/><circle cx="150" cy="150" r="30" fill="${LORE_ACC}"/>` },
  { no: '04', title: 'The eclipse', verdict: 'Kept, reassigned',
    body: 'Two discs of the same size, one behind the other, moved apart by a single step. What you see is the crescent — the part the front disc was hiding until something moved.',
    note: 'The idea was right and the disc was empty. It needed the name in it.',
    art: `<circle cx="132" cy="168" r="118" fill="${LORE_ACC}"/><circle cx="168" cy="132" r="118" fill="${LORE_BG}"/><circle cx="168" cy="132" r="118" fill="none" stroke="${LORE_INK}" stroke-width="14"/>` },
  { no: '05', title: 'The letter, four ways', verdict: 'Discarded',
    body: 'A P set into the disc, cut out of it, made into it, and stood in front of it. The version where the ring became the bowl of the letter was clever and unreadable at a glance.',
    note: 'Clever lost to legible. The letter belongs in the calm middle, not fused to the frame.',
    art: `<circle cx="150" cy="150" r="118" fill="${LORE_INK}"/><path d="${MARK_GLYPH.display}" fill="${LORE_BG}"/>` },
  { no: '06', title: 'The phase medallion', verdict: 'Adopted',
    body: 'The crescent moves inside the ring and becomes a band of light riding the rim, so the mark closes into a roundel and the letter sits in the calm middle. One dial position per desk, 60° apart.',
    note: 'Adopted. It survives every circular crop, and the six desks read as one family.',
    /* No transcription: row six IS the mark, so it renders the component. */
    art: null },
];

const deskLabels: Record<Topic, string> = {
  politics: 'Politics', space: 'Space', earth: 'Earth',
  tech: 'Tech', travel: 'Travel', sports: 'Sports',
};

/* The three steps an issue walks the reader through. */
const steps = [
  { no: '01', title: 'Start with what you know',
    body: 'A headline you have already scrolled past. We assume you know the summary and skip it.' },
  { no: '02', title: 'Move the viewpoint',
    body: 'The structure underneath — the procedure, the arithmetic, the incentive — rebuilt as something you can operate.' },
  { no: '03', title: 'Keep the argument',
    body: 'Sources under every number, a skim mode for the hurry, and sixty days of letters.' },
];

/* The eight rhetorical modes an issue can use (AGENTS §6; the working canon is
   research/_voice/mode-library.md). The internal canon pins each mode to a
   register by naming real broadcasters and writers; those belong in the
   stylist's brief, not on a public page, where naming them reads as a claim of
   endorsement. These are the artboard's reader-facing one-liners. */
const voices = [
  { n: 'Awe', d: 'Scale, deep time, mechanism marvel.' },
  { n: 'Conversational', d: 'Step-by-step mechanism.' },
  { n: 'Calm-structural', d: 'Naming structural cost.' },
  { n: 'Satirical exposure', d: 'Contradiction by its own data.' },
  { n: 'Dry wit', d: 'Bureaucratic precision as deadpan.' },
  { n: 'Investigation', d: 'Anomaly, then evidence.' },
  { n: 'Forensic', d: 'Mechanism with human stakes.' },
  { n: 'Lyrical compression', d: 'One emotional landing.' },
];

const promises = [
  { no: '01', title: 'Independent', body: 'Not for profit. No investors. No advertisers.' },
  { no: '02', title: 'Sourced', body: 'Every claim cites a primary source. Every dataset linked.' },
  { no: '03', title: 'Slow', body: 'Read in six minutes. Argued in sixty days.' },
];
---

<HomeLayout
  title="About · Parallax Lens"
  description="How Parallax works — the second angle, the mark, the eight voices, and what the publication refuses to do."
>
  <Masthead variant="meta" current="about" issueNumber={issueNumber} />

  <!-- 1 · Hero -->
  <section class="px-band px-abt__hero">
    <p class="px-eyebrow">How Parallax works</p>
    <h1 class="px-h1" set:html={renderEmphasis('Two eyes, one object, a *second* angle.')} />
    <p class="px-lede">
      Parallax is the shift you get when you move your viewpoint. We do it to one
      story at a time — the object stays put, the angle changes, and the depth
      appears.
    </p>
  </section>

  <!-- 2 · The mark -->
  <section class="px-band px-abt__markband">
    <div class="px-abt__markart">
      <Mark size={168} title="The Parallax medallion" />
      <div class="px-abt__dial">
        {TOPICS.map((t) => (
          <span class="px-abt__phase" title={deskLabels[t]}>
            <Mark desk={t} size={30} glyph={false} ring={13} />
          </span>
        ))}
      </div>
    </div>
    <div class="px-abt__markcopy">
      <p class="px-eyebrow">The mark</p>
      <p class="px-abt__marklead">
        A star's distance is measured by looking at it twice, six months apart,
        from opposite ends of Earth's orbit. Depth is what patience and
        displacement buy you.
      </p>
      <p class="px-abt__markbody">
        So the mark is a disc lit from one side. The crescent is the part that
        was hidden until something moved, and it sits at a different hour for
        each of the six desks — 60° apart, one full turn of the dial across the
        publication.
      </p>
    </div>
  </section>

  <!-- 3 · The three steps -->
  <div class="px-cells px-cells--open px-abt__steps">
    {steps.map((s) => (
      <div class="px-abt__step">
        <span class="px-abt__stepno">{s.no}</span>
        <p class="px-abt__stept">{s.title}</p>
        <p class="px-abt__stepb">{s.body}</p>
      </div>
    ))}
  </div>

  <!-- 4 · The editor — omitted entirely until the portrait exists -->
  {EDITOR_PORTRAIT && (
    <section class="px-band px-abt__editor">
      <p class="px-eyebrow">The editor</p>
      <p class="px-abt__edcopy">
        Parallax is written, designed and built by one person. The portrait is
        shot in the field rather than at a desk, and the caption gives the date,
        because a portrait is evidence of when someone was there.
      </p>
      <div class="px-abt__figs">
        <figure class="px-abt__fig">
          <div class="px-abt__frame">
            <img class="px-abt__img" src={EDITOR_PORTRAIT.src} alt={EDITOR_PORTRAIT.alt} />
          </div>
          <figcaption class="px-abt__figcap">
            <span>{EDITOR_PORTRAIT.caption}</span>
            <span>{EDITOR_PORTRAIT.date}</span>
          </figcaption>
        </figure>
      </div>
    </section>
  )}

  <!-- 5 · The eight voices -->
  <section class="px-band px-abt__voices">
    <p class="px-eyebrow">The eight voices an issue can use</p>
    <div class="px-cells px-abt__voicegrid">
      {voices.map((v) => (
        <div class="px-abt__voice">
          <p class="px-abt__voicen">{v.n}</p>
          <p class="px-abt__voiced">{v.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 6 · The promises -->
  <div class="px-cells px-cells--open px-abt__promises">
    {promises.map((p) => (
      <div class="px-abt__promise">
        <span class="px-abt__promno">{p.no}</span>
        <p class="px-abt__promt">{p.title}</p>
        <p class="px-abt__promb">{p.body}</p>
      </div>
    ))}
  </div>

  <!-- 7 · The making of the mark -->
  <section class="px-band px-abt__making">
    <p class="px-eyebrow">The making of the mark</p>
    <h2 class="px-abt__h2" set:html={renderEmphasis('Six drafts, and the one *survivor*.')} />
    <p class="px-abt__intro">
      The mark took six rounds to find. Every discarded draft was discarded for a
      reason, and the reasons are the argument for what survived.
    </p>

    <ol class="px-abt__lore">
      {drafts.map((d) => (
        <li class="px-abt__row">
          <span class="px-abt__rowlead">
            <span class="px-abt__no">{d.no}</span>
            <span class="px-abt__art" aria-hidden="true">
              {d.art
                ? <svg viewBox="0 0 300 300" width="46" height="46"><Fragment set:html={d.art} /></svg>
                : <Mark size={46} />}
            </span>
          </span>
          <span class="px-abt__rowtext">
            <b class="px-abt__t">{d.title}</b>
            <span class="px-abt__b">{d.body}</span>
          </span>
          <span class="px-abt__rowverdict">
            <span class="px-abt__v" data-verdict={d.verdict}>{d.verdict}</span>
            <span class="px-abt__note">{d.note}</span>
          </span>
        </li>
      ))}
    </ol>

    <p class="px-abt__close">
      What survived is four concentric circles, one dial position and one letter.
      Nothing in it is decoration, and nothing in it needs the story above in
      order to be read — which is the only test a mark has to pass.
    </p>
  </section>

  <!-- 8 · Colophon -->
  <section class="px-band px-band--last px-abt__colophon" id="colophon">
    <p class="px-eyebrow">Colophon</p>
    <p class="px-abt__cop">
      Parallax is published by <b>Parallax Lens</b>™, registered in India. Set in
      Literata. Built as a static site with no analytics, no cookies and no
      trackers.
    </p>
  </section>
</HomeLayout>

<style>
  /* ── 1 · Hero ─────────────────────────────────────────────────────────────
     The primitives carry 68→40px, the italic accent word and the 300-weight
     lede; only the two measures are the artboard's own. */
  .px-abt__hero .px-h1 { max-width: 20ch; }
  .px-abt__hero .px-lede { max-width: 54ch; line-height: 1.5; }

  /* ── 2 · The mark ──────────────────────────────────────────────────────── */
  .px-abt__markband {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 34px;
    align-items: center;
  }
  .px-abt__markband .px-eyebrow { color: var(--muted); margin-bottom: 14px; }
  .px-abt__markart {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .px-abt__dial { display: flex; gap: 9px; }
  .px-abt__phase { display: flex; }
  .px-abt__marklead {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 52ch;
  }
  .px-abt__markbody {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  /* ── 3 · The three steps ───────────────────────────────────────────────── */
  .px-abt__steps {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* The band above already draws this hairline. */
    border-top: 0;
  }
  .px-abt__step { padding: 26px 24px; }
  .px-abt__stepno {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .px-abt__stept {
    margin: 10px 0 7px;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.018em;
    color: var(--ink);
  }
  .px-abt__stepb { margin: 0; font-size: 15px; line-height: 1.62; color: var(--ink-soft); }

  /* ── 4 · The editor ────────────────────────────────────────────────────── */
  .px-abt__editor .px-eyebrow { color: var(--muted); margin-bottom: 6px; }
  .px-abt__edcopy {
    margin: 0 0 20px;
    font-size: 15px;
    line-height: 1.62;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .px-abt__figs { display: flex; flex-wrap: wrap; gap: 20px; }
  .px-abt__fig { flex: 0 1 300px; margin: 0; }
  .px-abt__frame { border: 1px solid var(--rule); padding: 7px; }
  .px-abt__img { display: block; width: 100%; height: 232px; object-fit: cover; }
  .px-abt__figcap {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 9px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── 5 · The eight voices ──────────────────────────────────────────────── */
  .px-abt__voices .px-eyebrow { color: var(--muted); margin-bottom: 18px; }
  .px-abt__voicegrid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .px-abt__voice { padding: 15px 16px; }
  .px-abt__voicen {
    margin: 0 0 5px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-deep, var(--accent));
  }
  .px-abt__voiced { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--ink-soft); }

  /* ── 6 · The promises ──────────────────────────────────────────────────── */
  .px-abt__promises {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 0;
  }
  .px-abt__promise { padding: 24px; }
  .px-abt__promno { font-size: 22px; font-weight: 700; color: var(--accent); }
  .px-abt__promt {
    margin: 8px 0 5px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .px-abt__promb { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--ink-soft); }

  /* ── 7 · The making of the mark ────────────────────────────────────────── */
  .px-abt__making .px-eyebrow { margin-bottom: 14px; }
  .px-abt__h2 {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.028em;
    color: var(--ink);
    max-width: 22ch;
  }
  /* :global — the <em> arrives through set:html, so it carries no scope. */
  .px-abt__h2 :global(em) { font-style: italic; font-weight: 400; color: var(--accent); }
  .px-abt__intro {
    margin: 0 0 26px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .px-abt__lore { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .px-abt__row {
    display: grid;
    grid-template-columns: 150px 1fr 260px;
    gap: 34px;
    align-items: start;
    padding: 22px 0;
    border-top: 1px solid var(--rule);
  }
  .px-abt__rowlead { display: flex; align-items: center; gap: 16px; }
  .px-abt__no {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--muted);
  }
  .px-abt__art {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border: 1px solid var(--rule);
    flex: 0 0 auto;
  }
  .px-abt__rowtext { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .px-abt__t { font-size: 19px; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
  .px-abt__b { font-size: 15px; line-height: 1.62; color: var(--ink-soft); max-width: 58ch; }
  .px-abt__rowverdict { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .px-abt__v {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-deep, var(--accent));
  }
  .px-abt__v[data-verdict='Discarded'] { color: var(--muted); }
  .px-abt__note { font-size: 14px; line-height: 1.58; color: var(--ink-soft); max-width: 34ch; }

  .px-abt__close {
    margin: 26px 0 0;
    padding-top: 18px;
    border-top: 2px solid var(--ink);
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  /* ── 8 · Colophon ──────────────────────────────────────────────────────── */
  .px-abt__colophon .px-eyebrow { color: var(--muted); margin-bottom: 10px; }
  .px-abt__cop {
    margin: 0;
    font-size: 15px;
    line-height: 1.62;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .px-abt__cop b { color: var(--ink); font-weight: 700; }

  /* ── Phone (the 412 artboard) ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .px-abt__markband { grid-template-columns: 1fr; gap: 22px; }
    .px-abt__steps { grid-template-columns: 1fr; }
    .px-abt__voicegrid { grid-template-columns: 1fr 1fr; }
    .px-abt__promises { grid-template-columns: 1fr; }
    .px-abt__h2 { font-size: 28px; }
    .px-abt__row { grid-template-columns: 1fr; gap: 22px; }
  }
</style>
