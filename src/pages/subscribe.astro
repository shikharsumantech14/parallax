---
/**
 * /subscribe — the join page (launch design, 2026-09-08).
 *
 * Two cells on the hairline grid, as the canvas draws it. LEFT is the free
 * dispatch: the promise, then the one real form in the codebase
 * (core/NewsletterForm.astro, which POSTs to /api/join and returns both the
 * subscription and a sign-in link). RIGHT is membership, priced honestly at
 * ₹0 for the beta with the post-beta rate struck through beside it. Under
 * them, three cells that answer the three questions the price line raises.
 *
 * The page IS the form, so it passes `footerNewsletter={false}` — the
 * colophon must not repeat it. The form's own title/dek are for its OTHER
 * mounts (colophon, home strip); here the h1 and lede already say it, so they
 * are hidden the way SubscribeStrip hides them, and the field label is
 * clipped rather than removed so the input keeps its accessible name.
 *
 * Prefix: px-subs. No JS beyond the form island itself.
 */
import { getCollection } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import Masthead from '../components/core/Masthead.astro';
import NewsletterForm from '../components/core/NewsletterForm.astro';

const published = await getCollection('issues', (e) => e.data.status !== 'draft');
const issueNumber = String(published.length).padStart(2, '0');

const perks = [
  'Every issue in full, no metering',
  'All interactive charts and instruments',
  'The complete archive, back to № 01',
  'Save issues to your shelf, pick up where you left off',
];

const notes = [
  {
    title: 'What beta means',
    body: 'Every feature is live and every issue is real. What is still moving is the shape of membership, and you get to watch it settle.',
  },
  {
    title: 'What we never do',
    body: 'No trackers, no third-party scripts, no selling the list. Your email is for the dispatch and your sign-in link, nothing else.',
  },
  {
    title: 'What happens on the 19th',
    body: 'Parallax opens to the public. Readers who joined in beta keep the free rate until we write to say otherwise.',
  },
];
---

<HomeLayout
  title="Subscribe · Parallax Lens"
  description="One issue a week, free — the dispatch when each issue ships and a sign-in link that opens your free shelf."
  footerNewsletter={false}
>
  <Masthead variant="meta" current="subscribe" issueNumber={issueNumber} />

  <div class="px-cells px-cells--open px-subs__grid">
    <div class="px-subs__cell px-subs__free">
      <p class="px-eyebrow">Free · one issue a week</p>
      <h1 class="px-h1 px-subs__h1">One issue a week. No <em>noise</em>.</h1>
      <p class="px-lede px-subs__lede">
        No investors, no advertisers, no trackers. Unsubscribe in one click,
        and we never sell the list.
      </p>

      <div class="px-subs__form">
        <NewsletterForm />
      </div>

      <p class="px-subs__note">
        One email does two things: the dispatch when each issue ships, and a
        sign-in link that opens your free shelf.
      </p>

      <p class="px-subs__signin">
        Already a reader? <a href="/login">Sign in →</a>
      </p>
    </div>

    <div class="px-subs__cell px-subs__member">
      <div class="px-subs__mhead">
        <p class="px-subs__mlabel">Membership · beta</p>
        <span class="px-subs__tag">Free while we test</span>
      </div>

      <p class="px-subs__price">
        <span class="px-subs__amt">₹0<span class="px-subs__per">/mo</span></span>
        <span class="px-subs__was">₹149/mo</span>
      </p>

      <p class="px-subs__body">
        Membership is free for the whole beta. We will say so, in writing, a
        month before that changes — and nobody who joined during the beta is
        charged without choosing to be.
      </p>

      <ul class="px-subs__perks">
        {perks.map((p) => (
          <li class="px-subs__perk">
            <span class="px-subs__arrow" aria-hidden="true">→</span>{p}
          </li>
        ))}
      </ul>

      <a class="px-btn px-btn--acc px-btn--block" href="/login?next=%2Fdashboard">
        Become a member · free in beta
      </a>

      <p class="px-subs__fine">Student rate after beta · ₹149/mo · cancel any time</p>
    </div>
  </div>

  <div class="px-cells px-cells--open px-subs__strip">
    {notes.map((n) => (
      <div class="px-subs__ncell">
        <p class="px-subs__nt">{n.title}</p>
        <p class="px-subs__nb">{n.body}</p>
      </div>
    ))}
  </div>
</HomeLayout>

<style>
  /* The two grids sit directly under the masthead's own hairline and under
     each other, so their top rule is dropped — two adjacent 1px borders read
     as a 2px line, which no band on any other page does. */
  .px-subs__grid {
    grid-template-columns: 1fr 1fr;
    border-top: 0;
  }
  .px-subs__strip {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 0;
  }

  /* Cells carry the band's own padding; the grid gap is the rule. */
  .px-subs__cell { padding: 46px 40px 40px; }

  .px-subs__h1 { max-width: 15ch; margin-bottom: 18px; }
  .px-subs__lede { max-width: 42ch; margin-bottom: 26px; }

  /* The form island is the artboard's bare row here: its standalone framing,
     its heading and its dek belong to the colophon and home mounts. The
     label is clipped, not hidden, so the field keeps its accessible name. */
  .px-subs__form :global(.px-newsletter) { margin: 0; padding: 0; border: 0; }
  .px-subs__form :global(.px-newsletter__inner) { max-width: none; margin: 0; padding: 0; }
  .px-subs__form :global(.px-newsletter__title),
  .px-subs__form :global(.px-newsletter__dek) { display: none; }
  .px-subs__form :global(.px-newsletter__label) {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .px-subs__note {
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .px-subs__signin {
    margin: 24px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    line-height: 1.9;
    color: var(--muted);
  }
  .px-subs__signin a {
    color: var(--accent-deep, var(--accent));
    text-decoration: none;
  }
  .px-subs__signin a:hover { text-decoration: underline; }

  /* ── the membership cell ─────────────────────────────────────────────── */
  .px-subs__mhead {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .px-subs__mlabel {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .px-subs__tag {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-deep, var(--accent));
    border: 1px solid var(--accent-deep, var(--accent));
    padding: 3px 7px;
  }

  .px-subs__price {
    margin: 0 0 8px;
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }
  .px-subs__amt {
    font-family: var(--font-display);
    font-size: 54px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
  }
  .px-subs__per {
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
  }
  .px-subs__was {
    font-size: 26px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--accent);
  }

  .px-subs__body {
    margin: 0 0 22px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 44ch;
  }

  .px-subs__perks {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .px-subs__perk {
    display: flex;
    align-items: baseline;
    gap: 11px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
  }
  .px-subs__arrow { color: var(--accent); flex: 0 0 auto; }

  .px-subs__fine {
    margin: 14px 0 0;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    line-height: 1.9;
    color: var(--muted);
  }

  /* ── the three notes ─────────────────────────────────────────────────── */
  .px-subs__ncell { padding: 24px; }
  .px-subs__nt {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .px-subs__nb {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  @media (max-width: 768px) {
    .px-subs__grid,
    .px-subs__strip { grid-template-columns: 1fr; }
    .px-subs__cell { padding: 24px 20px 28px; }
  }
</style>
