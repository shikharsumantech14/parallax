---
/**
 * /subscribe — the join page (Lens Phase 4; the Subscribe and Subscribe-Phone
 * boards).
 *
 * The head (eyebrow, "One quiet letter when an issue is worth keeping" in
 * Literata 700 56, one line), then two cards: THE DISPATCH, what one email does
 * and the one real form in the codebase (core/NewsletterForm, which POSTs to
 * /api/join and returns the subscription and a sign-in link); and
 * MEMBERSHIP · BETA at ₹0/mo with ₹149/mo struck through beside it (the
 * operator's ruling), the three "what beta means" rows, the desk button.
 * Under them the promise strip, and the three latest covers as "What the
 * letter carries". The page IS the form, so the footer carries none.
 *
 * Prefix: px-subs. No JS beyond the form island itself.
 */
import { getCollection } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import Masthead from '../components/core/Masthead.astro';
import NewsletterForm from '../components/core/NewsletterForm.astro';
import CoverCard from '../components/core/CoverCard.astro';
import PromiseStrip from '../components/core/PromiseStrip.astro';
import { issueNumbers } from '../lib/issue-number';

const published = await getCollection('issues', (e) => e.data.status !== 'draft');
const latest = [...published]
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || b.slug.localeCompare(a.slug))
  .slice(0, 3);
const numbers = await issueNumbers();

const rows = [
  { t: 'What beta means', b: 'What is still moving is the shape of membership, and you get to watch it settle.' },
  { t: 'What we never do', b: 'Your email is for the dispatch and your sign-in link, nothing else.' },
  { t: 'After the beta', b: 'Readers who joined in beta keep the free rate until we write to say otherwise.' },
];
---

<HomeLayout
  title="Subscribe · Parallax Lens"
  description="One quiet letter when an issue is worth keeping: the dispatch when each issue ships, and a sign-in link that opens your free shelf."
  footerNewsletter={false}
>
  <Masthead variant="meta" current="subscribe" />

  <div class="px-subs">
    <div class="px-subs__top">
      <div class="px-subs__head">
        <p class="px-subs__eyebrow">Free · one issue a week</p>
        <h1 class="px-subs__h1">One quiet letter when an issue is worth <em>keeping</em></h1>
        <p class="px-subs__lede">No investors, no advertisers, no trackers. Unsubscribe in one click, and we never sell the list.</p>
      </div>

      <div class="px-subs__cards">
        <section class="px-subs__card px-subs__dispatch" aria-labelledby="px-subs-dispatch">
          <div class="px-subs__stack">
            <div class="px-subs__cardhead">
              <h2 class="px-subs__h2" id="px-subs-dispatch">The dispatch</h2>
              <span class="px-subs__chip">Free</span>
            </div>
            <p class="px-subs__line">One email does two things.</p>
            <ol class="px-subs__two">
              <li>
                <span class="px-subs__icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 40 40" focusable="false"><rect x="6" y="10" width="28" height="20" rx="2" /><path d="M7 12 L20 22 L33 12" /></svg>
                </span>
                The dispatch, when each issue ships
              </li>
              <li>
                <span class="px-subs__icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 40 40" focusable="false"><path d="M6 32 H34" /><path d="M9 32 V12 H15 V32" /><path d="M17 32 V8 H23 V32" /><path d="M26 32 L28 14 L34 15 L32 32" /></svg>
                </span>
                A sign-in link that opens your free shelf
              </li>
            </ol>
          </div>
          <div class="px-subs__stack">
            <div class="px-subs__form"><NewsletterForm /></div>
            <p class="px-subs__signin">Already a reader?<a href="/login">Sign in
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4" /></svg></a>
            </p>
          </div>
        </section>

        <section class="px-subs__card px-subs__member" aria-labelledby="px-subs-member">
          <div class="px-subs__stack">
            <div class="px-subs__cardhead">
              <h2 class="px-subs__h2" id="px-subs-member">Membership <span class="px-subs__muted">· beta</span></h2>
              <span class="px-subs__chip">Free while we test</span>
            </div>
            <p class="px-subs__price">
              <span class="px-subs__amt">₹0<span class="px-subs__per">/mo</span></span>
              <span class="px-subs__vh">After beta,</span><s class="px-subs__was">₹149/mo</s>
            </p>
            <p class="px-subs__small">Membership is free for the whole beta.</p>
          </div>
          <dl class="px-subs__rows">
            {rows.map((r) => (
              <div class="px-subs__row">
                <dt>{r.t}</dt>
                <dd>{r.b}</dd>
              </div>
            ))}
          </dl>
          <div class="px-subs__stack px-subs__stack--sm">
            <a class="px-subs__join" href="/login?next=%2Fdashboard">Become a member · free in beta
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
            </a>
            <p class="px-subs__fine">Student rate after beta · ₹149/mo · cancel any time</p>
          </div>
        </section>
      </div>
    </div>

    <div class="px-subs__close">
      <PromiseStrip />
      {latest.length > 0 && (
        <section class="px-subs__carries" aria-labelledby="px-subs-carries">
          <div class="px-subs__carrieshead">
            <h2 class="px-subs__label" id="px-subs-carries">What the letter carries</h2>
            <a class="px-subs__all" href="/archive/">All {published.length} {published.length === 1 ? 'issue' : 'issues'} →</a>
          </div>
          <div class="px-subs__grid">
            {latest.map((i) => <CoverCard issue={i} size="card" number={numbers.get(i.slug)} />)}
          </div>
        </section>
      )}
    </div>
  </div>
</HomeLayout>

<style>
  .px-subs { display: flex; flex-direction: column; gap: 96px; padding: 80px 0 96px; }
  .px-subs__top { display: flex; flex-direction: column; gap: 48px; }
  .px-subs__head { display: flex; flex-direction: column; gap: 16px; }
  .px-subs__eyebrow, .px-subs__label {
    margin: 0; font: 600 12px/16px var(--font-ui); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .px-subs__label { line-height: 20px; }
  .px-subs__h1 {
    margin: 0; max-width: 880px;
    font-family: var(--font-display); font-weight: 700; font-size: 56px; line-height: 1.04; letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .px-subs__h1 em { font-style: italic; color: var(--pol-text); font-weight: 400; }
  .px-subs__lede { margin: 0; max-width: 840px; font: 400 19px/1.5 var(--font-ui); color: var(--ink-2); }

  .px-subs__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .px-subs__card {
    display: flex; flex-direction: column; gap: 28px; min-width: 0;
    padding: 32px;
    background: var(--paper-2); border: 1px solid var(--hair); border-radius: var(--r-card); box-shadow: var(--shadow-1);
  }
  .px-subs__dispatch { justify-content: space-between; gap: 32px; }
  .px-subs__stack { display: flex; flex-direction: column; gap: 16px; }
  .px-subs__dispatch .px-subs__stack:first-child { gap: 12px; }
  .px-subs__stack--sm { gap: 12px; }
  .px-subs__cardhead { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .px-subs__h2 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 28px; line-height: 1.15; letter-spacing: -0.02em; }
  .px-subs__muted { color: var(--muted); }
  .px-subs__chip {
    height: 28px; display: inline-flex; align-items: center; padding: 0 12px;
    border-radius: var(--r-chip); background: var(--pol-tint); color: var(--pol-text);
    font: 600 12px/1 var(--font-ui); letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap;
  }
  .px-subs__line { margin: 0; font: 400 16px/1.5 var(--font-ui); color: var(--ink-2); }
  .px-subs__two { list-style: none; margin: 12px 0 0; padding: 0; border-top: 1px solid var(--hair); }
  .px-subs__two li { display: flex; align-items: center; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--hair); font: 400 15px/1.45 var(--font-ui); }
  .px-subs__icon { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 999px; background: var(--pol-tint); display: flex; align-items: center; justify-content: center; }
  .px-subs__icon svg { display: block; fill: none; stroke: var(--pol-text); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }

  /* The shared form island, set to the board: its own heading goes (the
     card says it), the label reads "Your email", the field and the button
     stand 52px tall. */
  .px-subs__form :global(.px-newsletter) { margin: 0; padding: 0; border: 0; }
  .px-subs__form :global(.px-newsletter__inner) { max-width: none; padding: 0; }
  .px-subs__form :global(.px-newsletter__title), .px-subs__form :global(.px-newsletter__dek) { display: none; }
  .px-subs__form :global(.px-newsletter__label) { margin: 0 0 8px; font: 600 14px/1.4 var(--font-ui); letter-spacing: 0; text-transform: none; color: var(--ink); }
  .px-subs__form :global(.px-newsletter__row) { max-width: none; gap: 8px; }
  .px-subs__form :global(.px-newsletter__input) {
    height: 52px; box-sizing: border-box; padding: 0 16px;
    border: 1px solid var(--hair-2); border-radius: var(--r-ctl); background: var(--paper);
    font: 400 16px/1 var(--font-ui);
  }
  .px-subs__form :global(.px-newsletter__input:focus) { border-color: var(--ink); outline: 2px solid var(--ink); outline-offset: 2px; }
  .px-subs__form :global(.px-newsletter__submit) {
    height: 52px; padding: 0 22px; border-radius: var(--r-ctl);
    font: 600 16px/1 var(--font-ui); letter-spacing: 0; text-transform: none;
    background: var(--ink); color: var(--paper);
  }
  .px-subs__form :global(.px-newsletter__submit:hover) { background: var(--ink-2); color: var(--paper); }
  .px-subs__form :global(.px-newsletter__status), .px-subs__form :global(.px-newsletter__nojs) { font: 400 13px/1.5 var(--font-ui); }
  .px-subs__signin {
    margin: 0; padding-top: 12px; border-top: 1px solid var(--hair);
    display: flex; align-items: center; gap: 8px; font: 400 14px/1.4 var(--font-ui); color: var(--muted);
  }
  .px-subs__signin a, .px-subs__join { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; }
  .px-subs__signin a { min-height: 44px; font-weight: 600; color: var(--ink); }
  .px-subs__signin a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .px-subs__signin svg path, .px-subs__join svg path { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  .px-subs__price { margin: 0; display: flex; align-items: baseline; gap: 16px; font-variant-numeric: tabular-nums; }
  .px-subs__amt { display: flex; align-items: baseline; gap: 4px; font: 700 48px/1 var(--font-ui); letter-spacing: -0.02em; }
  .px-subs__per { font: 500 17px/1 var(--font-ui); letter-spacing: 0; color: var(--muted); }
  .px-subs__was { font: 500 20px/1 var(--font-ui); color: var(--muted); text-decoration-color: var(--pol-mark); text-decoration-thickness: 2px; }
  .px-subs__vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .px-subs__small { margin: -8px 0 0; font: 400 14px/1.5 var(--font-ui); color: var(--ink-2); }
  .px-subs__rows { margin: 0; border-top: 1px solid var(--hair); }
  .px-subs__row { display: grid; grid-template-columns: 208px minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--hair); }
  .px-subs__row dt { font: 600 12px/22px var(--font-ui); letter-spacing: 0.16em; text-transform: uppercase; color: var(--pol-text); }
  .px-subs__row dd { margin: 0; font: 400 15px/1.45 var(--font-ui); }
  .px-subs__join {
    height: 52px; justify-content: center; gap: 8px;
    border-radius: var(--r-ctl); background: var(--pol-text); color: var(--paper);
    font: 600 16px/1 var(--font-ui);
    transition: background var(--t-micro, 160ms) var(--ease);
  }
  .px-subs__join:hover { background: color-mix(in oklab, var(--pol-text) 86%, var(--ink)); color: var(--paper); }
  .px-subs__join:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .px-subs__fine { margin: 0; text-align: center; font: 400 13px/1.5 var(--font-ui); color: var(--muted); }

  .px-subs__close { display: flex; flex-direction: column; gap: 64px; }
  .px-subs__carries { display: flex; flex-direction: column; gap: 20px; }
  .px-subs__carrieshead { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .px-subs__all { min-height: 44px; display: inline-flex; align-items: center; font: 600 14px/1 var(--font-ui); color: var(--ink); text-decoration: none; }
  .px-subs__all:hover { text-decoration: underline; text-underline-offset: 4px; }
  .px-subs__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }

  @media (max-width: 1000px) {
    .px-subs__cards { grid-template-columns: 1fr; }
    .px-subs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .px-subs { gap: 64px; padding: 48px 0 64px; }
    .px-subs__h1 { font-size: 40px; line-height: 1.06; }
    .px-subs__lede { font-size: 17px; }
    .px-subs__card { padding: 20px; gap: 24px; }
    .px-subs__row { grid-template-columns: 1fr; gap: 4px; }
    .px-subs__grid { grid-template-columns: 1fr; gap: 16px; }
    .px-subs__form :global(.px-newsletter__submit) { padding: 0 16px; }
  }
</style>
