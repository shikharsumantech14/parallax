---
/**
 * /issues/<slug> — the issue page (Lens Phase 3, 2026-09-30; the Issue board,
 * docs/design/LENS.md §5).
 *
 * Block order:
 *   the head (core/IssueHead: eyebrow · headline · hook · facts, the "In this
 *   issue" card, the primer band)
 *   → the reading band: the progress rail in the left gutter beside
 *     #px-article, whose sections are the reading system (core/Section.astro:
 *     the article beside the pinned figure)
 *   → reader signal → letters → sources → desk / next-issue nav → footer,
 *   with the reading strip (fixed, JS-only) over it all.
 *
 * The rail is a SIBLING of #px-article and the article's child list stays
 * flat: ReadingGate counts `.px-section` among `#px-article.children`, so
 * anything that nests the sections one level deeper hands the whole issue
 * away for free. src/scripts/cues.ts is the page's one Lens island: the cue
 * lighting, the rail and the card's progress, the phone pin.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Topic } from '../../content/config';
import IssueLayout from '../../layouts/IssueLayout.astro';
import IssueHead from '../../components/core/IssueHead.astro';
import ReadingToolbar from '../../components/core/ReadingToolbar.astro';
import ReactionsBar from '../../components/core/ReactionsBar.astro';
import ReadingTracker from '../../components/core/ReadingTracker.astro';
import LettersBlock from '../../components/core/LettersBlock.astro';
import SectionRenderer from '../../components/SectionRenderer.astro';
import Sources from '../../components/core/Sources.astro';
import ReadingGate from '../../components/core/ReadingGate.astro';
import WelcomeBack from '../../components/core/WelcomeBack.astro';
import { DESK_REGISTER } from '../../lib/desks';
import { stripEmphasis, shortLabel } from '../../lib/text';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  return issues.map((issue) => ({
    params: { slug: issue.slug },
    props: { issue }
  }));
}

interface Props {
  issue: CollectionEntry<'issues'>;
}

const { issue } = Astro.props;
const { data } = issue;

/* Numbering runs over the PUBLISHED issues, oldest first (ties by slug, the
   order getCollection returns), which is the number the home rows, the desks
   and the archive show. A draft has no number yet and previews as 00. */
const allIssues = await getCollection('issues');
const published = allIssues
  .filter((i) => i.data.status !== 'draft')
  .sort((a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime() || a.slug.localeCompare(b.slug));
const issueIndex = published.findIndex((i) => i.slug === issue.slug);
const issueNumber = String(issueIndex + 1).padStart(2, '0');
const pad = (n: number) => String(n).padStart(2, '0');

/* The next issue on this desk (newer), else the next newer issue on any desk. */
const newerOnDesk = published.slice(issueIndex + 1).find((i) => i.data.topic === data.topic);
const newerAny = published[issueIndex + 1];
const next = issueIndex >= 0 ? (newerOnDesk ?? newerAny) : undefined;
const nextNumber = next ? pad(published.findIndex((i) => i.slug === next.slug) + 1) : undefined;

const darkTopics: Topic[] = ['space', 'tech', 'sports'];
const toolbarTheme: 'light' | 'dark' = darkTopics.includes(data.topic) ? 'dark' : 'light';

/* Section numbering: act-break dividers are air, not sections, and take no
   number. The head's card, the rail and each section's eyebrow share it. */
let numbered = 0;
const numberIndex = data.sections.map((s) => (s.kind === 'act-break' ? -1 : numbered++));
const total = numbered;
const toc = data.sections
  .map((s, i) => ({ s, n: numberIndex[i] }))
  .filter(({ n }) => n >= 0)
  .map(({ s, n }) => ({ id: `sec-${n + 1}`, no: pad(n + 1), short: shortLabel(s, `Section ${n + 1}`) }));

// OG cards are generated for non-draft issues only.
const ogSlug = data.status !== 'draft' ? issue.slug : undefined;
---

<IssueLayout
  topic={data.topic}
  title={data.title}
  description={data.hook}
  issueNumber={issueNumber}
  publishedAt={data.publishedAt}
  slug={ogSlug}
>
  <IssueHead
    topic={data.topic}
    issueNumber={issueNumber}
    publishedAt={data.publishedAt}
    title={data.title}
    hook={data.hook}
    primer={data.primer}
    readTime={data.readTimeMinutes}
    sourceCount={data.sources.length}
    toc={toc}
  />

  <div class="px-read">
    {toc.length > 1 && (
      <nav class="px-rail" aria-label="Sections">
        <div class="px-rail__in">
          <ol class="px-rail__list">
            {toc.map((t, i) => (
              <li>
                <a class="px-rail__a" href={`#${t.id}`} data-rail={i + 1} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="px-rail__name">{t.short}</span>
                  <span class="px-rail__dot" aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )}

    <article id="px-article" data-mode="full">
      {data.sections.map((section, i) => (
        <SectionRenderer section={section} index={numberIndex[i]} total={total} sources={data.sources} />
      ))}
      <span id="px-finish-sentinel" aria-hidden="true"></span>
    </article>
  </div>

  <ReadingGate freeSections={2} />

  <ReadingTracker issueId={issue.slug} />

  <ReactionsBar issueId={issue.slug} />

  <LettersBlock issueId={issue.slug} />

  <Sources sources={data.sources} />

  <nav class="px-inav" aria-label="Issue navigation">
    <a class="px-inav__back" href={`/topics/${data.topic}/`}>← {DESK_REGISTER[data.topic]}</a>
    <span class="px-inav__share">
      <button type="button" class="px-inav__copy" data-copy-link hidden>Copy link</button>
      <a href={`/s/${issue.slug}/`}>60-second version</a>
    </span>
    {next ? (
      <a class="px-inav__next" href={`/issues/${next.slug}/`}>Next · № {nextNumber} {stripEmphasis(next.data.title)} →</a>
    ) : (
      <a class="px-inav__next" href="/archive/">The archive →</a>
    )}
  </nav>

  <ReadingToolbar readTime={data.readTimeMinutes} issueId={issue.slug} theme={toolbarTheme} />

  <WelcomeBack />
</IssueLayout>

<script>
  import '../../scripts/cues';
</script>

<script is:inline>
  /* Copy link — shown only when the clipboard API exists (no-JS readers get
     the share row without a dead control). */
  (function () {
    var btn = document.querySelector('[data-copy-link]');
    if (!btn || !navigator.clipboard) return;
    btn.hidden = false;
    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(location.href).then(function () {
        var was = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = was; }, 1800);
      }).catch(function () {});
    });
  })();
</script>

<style>
  /* Desk / next-issue navigation, with the share links between them. */
  .px-inav {
    display: flex; justify-content: space-between; align-items: center; gap: 16px 24px; flex-wrap: wrap;
    padding: 24px 0 96px;
    border-top: 1px solid var(--hair);
    font-family: var(--font-ui); font-size: 12px; font-weight: 600; line-height: 1.3;
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .px-inav a { text-decoration: none; transition: color var(--t-micro, 160ms) var(--ease); }
  .px-inav__back { color: var(--ink); }
  .px-inav__back:hover { color: var(--accent-deep); }
  .px-inav__share { display: flex; align-items: center; gap: 20px; }
  .px-inav__share a { color: var(--ink-2); }
  .px-inav__share a:hover { color: var(--accent-deep); }
  .px-inav__copy {
    padding: 0; border: 0; background: transparent; cursor: pointer;
    font: inherit; letter-spacing: inherit; text-transform: inherit; color: var(--ink-2);
  }
  .px-inav__copy[hidden] { display: none; }
  .px-inav__copy:hover { color: var(--accent-deep); }
  .px-inav__next { color: var(--accent-deep); text-align: right; }
  .px-inav__next:hover { color: var(--ink); }
  .px-inav :is(a, button):focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  @media (pointer: coarse) {
    .px-inav__share a, .px-inav__copy { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
