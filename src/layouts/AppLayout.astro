---
/**
 * AppLayout — the reader-account pages (sign in, welcome, the Shelf, the
 * moderation queue). Lens (2026-09-30, Phase 4b): the account pages are the
 * same building as the publication. The same paper and ink, the same two
 * faces, the same masthead (core/Masthead.astro) and the same footer
 * (core/Colophon.astro), from the same stylesheets HomeLayout loads. The old
 * "app" shell (the glass appbar, the mono brand line, the LensMark, the dark
 * plate palette) is gone.
 *
 * Two chromes:
 *   full   the masthead and the Colophon around a 1152 column (the Shelf,
 *          the moderation queue).
 *   focus  no masthead: the page carries its own lockup, as the SignIn and
 *          CreateAccount boards draw it, and closes on the one-line promise
 *          "No analytics · No cookies · No trackers" (sign in, welcome).
 *
 * `width` survives for the admin page's call site: `narrow` (focus pages) and
 * `shelf` (the full column). `eyebrow` is accepted for compatibility and
 * printed nowhere: the lockup says Parallax.
 *
 * html.js guard in the head as on every layout: any state that only exists
 * with JavaScript (the Shelf's switches, the sign-in stack's dots) is hidden
 * until the class is present.
 */
import '../styles/tokens-v2.css';
import '../styles/base.css';
import '../styles/meta.css';
import '../styles/type-v2.css';
import '../styles/motion-v2.css';
import '../styles/app.css';
import PwaMeta from '../components/core/PwaMeta.astro';
import Masthead from '../components/core/Masthead.astro';
import Colophon from '../components/core/Colophon.astro';

interface Props {
  title: string;
  description?: string;
  /** Accepted for call-site compatibility; nothing prints it. */
  eyebrow?: string;
  /** narrow (focus pages) | shelf (the full 1152 column). */
  width?: 'narrow' | 'shelf';
  /** full = masthead + Colophon; focus = the page's own lockup, no masthead. */
  chrome?: 'full' | 'focus';
}

const {
  title,
  description = 'The reader account layer for Parallax Lens.',
  width = 'narrow',
  chrome = width === 'shelf' ? 'full' : 'focus',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Parallax Lens</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <PwaMeta />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
  </head>
  <body>
    {chrome === 'full' ? (
      <div class="px-wrap">
        <Masthead />
        <main class="app-shell" data-width={width}>
          <slot />
        </main>
        <Colophon newsletter={false} />
      </div>
    ) : (
      <div class="app-focus">
        <main class="app-focus__main">
          <slot />
        </main>
        <footer class="app-focus__foot">
          <p class="px-meta">No analytics · No cookies · No trackers</p>
        </footer>
      </div>
    )}
    {/* The one build island (Lens Phase 5, src/scripts/build.ts): a Shelf
        ring or a welcome tile builds only if it declares `data-build`. */}
    <script>import '../scripts/build';</script>
  </body>
</html>
