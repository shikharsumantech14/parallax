---
import type { Topic } from '../content/config';
import '../styles/base.css';
import '../styles/meta.css';
import '../styles/themes/politics.css';
import '../styles/themes/space.css';
import '../styles/themes/earth.css';
import '../styles/themes/tech.css';
import '../styles/themes/travel.css';
import '../styles/themes/sports.css';

import Masthead from '../components/core/Masthead.astro';
import Footer from '../components/core/Footer.astro';

interface Props {
  topic: Topic;
  title: string;
  description: string;
  issueNumber?: string;
  publishedAt?: Date;
  ogImage?: string;
}
const { topic, title, description, issueNumber, publishedAt, ogImage } = Astro.props;

const issueDate = publishedAt
  ? publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' }).toUpperCase()
  : undefined;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en" data-topic={topic}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Parallax Lens</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=IBM+Plex+Mono:wght@400;500;700&family=IBM+Plex+Sans:wght@300;400;500;600&family=Inter+Tight:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Oswald:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
    />

    <slot name="head" />
  </head>
  <body>
    <div class="px-wrap">
      <Masthead variant={topic} issueNumber={issueNumber} date={issueDate} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
