---
import type { Topic } from '../content/config';
import { stripEmphasis } from '../lib/text';
import '../styles/tokens-v2.css';
import '../styles/base.css';
import '../styles/meta.css';
import '../styles/themes/politics.css';
import '../styles/themes/space.css';
import '../styles/themes/earth.css';
import '../styles/themes/tech.css';
import '../styles/themes/travel.css';
import '../styles/themes/sports.css';
import '../styles/type-v2.css';
import '../styles/motion-v2.css';
import '../styles/dataviz-v2.css';
import '../styles/viz-type.css';
import '../styles/components-3d.css';
import '../styles/modal.css';

import Masthead from '../components/core/Masthead.astro';
import Colophon from '../components/core/Colophon.astro';
import Reveal from '../components/core/Reveal.astro';
import VizMotion from '../components/core/VizMotion.astro';
import Viz3DRuntime from '../components/core/Viz3DRuntime.astro';
import Tilt from '../components/core/Tilt.astro';
import ExpandModal from '../components/core/ExpandModal.astro';

interface Props {
  topic: Topic;
  title: string;
  description: string;
  issueNumber?: string;
  publishedAt?: Date;
}
const { topic, title, description, issueNumber, publishedAt } = Astro.props;

const issueDate = publishedAt
  ? publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' }).toUpperCase()
  : undefined;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-topic={topic}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{stripEmphasis(title)} · Parallax Lens</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={stripEmphasis(title)} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=JetBrains+Mono:wght@400;500;700&family=Schibsted+Grotesk:wght@400;500;700;800&display=swap"
    />

    <slot name="head" />
  </head>
  <body>
    <div class="px-wrap">
      <Masthead variant={topic} issueNumber={issueNumber} date={issueDate} />
      <main>
        <slot />
      </main>
      <Colophon />
    </div>
    <Reveal />
    <VizMotion />
    <Viz3DRuntime />
    <Tilt />
    <ExpandModal />
  </body>
</html>
