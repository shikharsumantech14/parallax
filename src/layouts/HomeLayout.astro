---
import type { Topic } from '../content/config';
import { stripEmphasis } from '../lib/text';
import '../styles/tokens-v2.css';
import '../styles/base.css';
import '../styles/meta.css';
// Topic themes are loaded so topic indexes + scoped FeaturedIssue cards
// can pick up per-topic variables via data-topic on <html> or on the element.
import '../styles/themes/politics.css';
import '../styles/themes/space.css';
import '../styles/themes/earth.css';
import '../styles/themes/tech.css';
import '../styles/themes/travel.css';
import '../styles/themes/sports.css';
import '../styles/type-v2.css';
import '../styles/motion-v2.css';
import '../styles/dataviz-v2.css';
import '../styles/viz-type.css';

import Colophon from '../components/core/Colophon.astro';
import Reveal from '../components/core/Reveal.astro';
import VizMotion from '../components/core/VizMotion.astro';

interface Props {
  title: string;
  description: string;
  topic?: Topic;
  /* Render the newsletter signup above the colophon. Default on; the home
     page passes false because its SubscribeStrip already carries the form. */
  footerNewsletter?: boolean;
}
const { title, description, topic, footerNewsletter = true } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-topic={topic}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{stripEmphasis(title)}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={stripEmphasis(title)} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="Parallax" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=IBM+Plex+Mono:wght@400;500;700&family=IBM+Plex+Sans:wght@300;400;500;600&family=Inter+Tight:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Oswald:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
    />
  </head>
  <body>
    <div class="px-wrap">
      <main>
        <slot />
      </main>
      <Colophon newsletter={footerNewsletter} />
    </div>
    <Reveal />
  </body>
</html>
